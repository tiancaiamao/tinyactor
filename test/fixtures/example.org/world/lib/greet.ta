// test/fixtures/example.org/world/lib/greet.ta — fixture 树
// （test/module/single-root.ta）：与 example.org/hello 那棵在**同一路径**
// lib/greet 上提供一个内容不同的 greet。两棵树的源码都在 test/fixtures/ 下，
// 由仓库根 tinyactor.deps 的两行生成 vendor/ 链接（docs/modules.md §10）。根只有一个（本仓库），但根下面可以装任意多棵树 —— 单元键
// 是写出的全名，两棵树同末段互不影响。
pub fn greet() -> string {
  "hello from example.org/world"
}
