; match 教学对照（docs/kl-format.md §2.2）：TA match 在 lower 期脱糖，
; .kl 词表里没有 match —— 本文件是 match.lisp（974703b^:test/backend）五个
; 臂的 desugar 后正例。运行输出 (20 14 99 nil 3)。
;   臂 1 字面量命中 => 20；臂 2 变量兜底 => 14；臂 3 _ 通配 => 99；
;   臂 4 无匹配 => nil；臂 5 嵌套 pair 模式 => 3。
; 脱糖规则（§2.2）：原子 scrut（变量 / 常量）直接当 subject —— 读它没有副作用，
; 不必多绑一份 let；scrut 是调用 / 构造时才先绑进 _m 槽（臂 5）。字面量臂 =
; (eq? subject lit)；pair 臂 = cons? 判定 + cdr/car 逆序绑定（尾侧先绑）；
; 无兜底臂时值为 nil。
(define mk5 (lambda (a b c d e) (cons a (cons b (cons c (cons d (cons e nil)))))))
(mk5
  (if (eq? 2 1) 10 (if (eq? 2 2) 20 (if (eq? 2 3) 30 nil)))
  (if (eq? 7 1) 10 (let (x 7) (* x 2)))
  (if (eq? 7 1) 10 99)
  (if (eq? 5 nil) 0 (if (cons? 5) (let (b (cdr 5)) (let (a (car 5)) 1)) nil))
  (let (_m (cons 1 (cons 2 nil)))
    (if (if (cons? _m) (cons? (cdr _m)) nil)
      (let (c (cdr (cdr _m)))
        (let (b (car (cdr _m))) (let (a (car _m)) (+ a b))))
      nil)))