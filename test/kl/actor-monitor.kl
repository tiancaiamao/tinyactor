; monitor + DOWN 的完整形状：spawn 除零崩溃的子 actor，monitor 拿 ref，
; recv 在阻塞站挂起，被唤醒后收到 (down.Down ref pid reason) 元组；reason
; 是 (down.Other "divzero")，符号崩溃原因在跨语言边界处转成了字符串。
(define boom (lambda nil (/ 1 0)))
(define main (lambda nil
  (let (p (spawn boom))
    (let (r (monitor p))
      (let (m (recv))
        (if (= (tuple-ref m 0) 'down.Down)
            (if (= (tuple-ref m 1) r)
                (if (= (tuple-ref m 2) p)
                    (let (reason (tuple-ref m 3))
                      (if (tuple? reason)
                          (if (= (tuple-ref reason 0) 'down.Other)
                              (if (= (tuple-ref reason 1) "divzero") "down ok" "bad reason")
                              "bad reason tag")
                          "reason not a tuple"))
                    "bad pid")
                "bad ref")
            "not down"))))))
(main)