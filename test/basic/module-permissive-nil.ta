// Test: module-permissive-nil
// Purpose: a call to an unknown function on a registered builtin module
//          compiles via the permissive unknown-call path and yields nil
//          without dying. Runs on the lisp path since 7c-1; the tavm
//          lazy-dlopen stderr warning it used to assert left with tavm.
// expect: ok

fn main() {
  let r = vm.nosuchfn(1, 2)
  let again = vm.nosuchfn(3, 4)
  if null?(r) && null?(again) {
    print("ok")
  } else {
    print("FAIL")
  }
}