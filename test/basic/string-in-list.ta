// Test: string-in-list
// Purpose: Strings stored in lists, sent between processes.
//          Verifies string deep copy works correctly when strings
//          are nested inside pairs.
// Expected output: hello world

import str

fn worker() {
  match recv() {
    cons('data, lst) -> print(str.concat(car(lst), car(cdr(lst))))
  }
}

fn main() {
      let msg = ["hello ", "world"]
  let pid = spawn(fn { worker() })
  send(pid, cons('data, msg))
  let ref = monitor(pid)
  recv()
}
