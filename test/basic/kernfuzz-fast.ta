// test/basic/kernfuzz-fast.ta — the fast ring's arithmetic: the seeds it
// derives, the counts it takes, and the judgement its ASan arm adds.
//
// tools/kernfuzz/fast.ta took over the orchestration the Python ring
// (tools/kernfuzz/fast.py) used to do, and the two must keep agreeing about
// *which* programs a day runs: a finding is reproducible only if the nightly
// ring can re-derive the seed that produced it. The seed vectors below are the
// output of `python3 tools/kernfuzz/fast.py rolling-seeds --date 2026-09-04
// --counter 0 --count 5 --git-sha abc123` verbatim, and the counts are that
// ring's `round(total * scale)`.
//
// expect: PASS

import "tinyactor:lib/str"
import "tinyactor:tools/kernfuzz/fast"
import "tinyactor:tools/kernfuzz/tafuzz_arm"
import "tinyactor:tools/kernfuzz/tafuzz_cmp"

const day = "2026-09-04"
const sha = "abc123"

fn main() {
  let bad = 0;
  let bad = bad + check("seed-0", fast.roll_seed(sha, day, 0) == 35704891778711);
  let bad = bad + check("seed-1", fast.roll_seed(sha, day, 1) == 53891641391956);
  let bad = bad + check("seed-2", fast.roll_seed(sha, day, 2) == 77216765527613);
  let bad = bad + check("seed-3", fast.roll_seed(sha, day, 3) == 59672165027993);
  let bad = bad + check("seed-4", fast.roll_seed(sha, day, 4) == 117507619088864);
  let bad = bad + check("seed-advances", (fast.roll_seed(sha, day, 0) == fast.roll_seed(sha, day, 1)) == false);
  let bad = bad + check("seed-sees-day", (fast.roll_seed(sha, "2026-09-05", 0) == fast.roll_seed(sha, day, 0)) == false);
  let bad = bad + check("seed-sees-commit", (fast.roll_seed("def456", day, 0) == fast.roll_seed(sha, day, 0)) == false);
  let bad = bad + check("seed-positive", fast.roll_seed(sha, day, 4) < 140737488355327);
  let bad = bad + check("seeds-count", length(fast.rolling_seeds(sha, day, 0, 3)) == 3);
  let bad = bad + check("seeds-start-at-counter", first(fast.rolling_seeds(sha, day, 3, 2)) == fast.roll_seed(sha, day, 3));
  let bad = bad + check("seeds-empty", null?(fast.rolling_seeds(sha, day, 0, 0)));
  let bad = bad + check("scale-permille", fast.scale_permille("0.4") == 400);
  let bad = bad + check("scale-whole", fast.scale_permille("1") == 1000);
  let bad = bad + check("scale-thousandths", fast.scale_permille("0.005") == 5);
  let bad = bad + check("scale-truncates", fast.scale_permille("0.4567") == 456);
  let bad = bad + check("counts-tc", fast.scale_count(1418, 400) == 567);
  let bad = bad + check("counts-fixed", fast.scale_count(300, 400) == 120);
  let bad = bad + check("counts-rolling", fast.scale_count(200, 400) == 80);
  let bad = bad + check("counts-zero", fast.scale_count(1418, 0) == 0);
  let bad = bad + check("compile-budget", tafuzz_arm.compile_budget(2000) == 8000);
  let bad = bad + check("asan-exit", tafuzz_arm.asan_exit() == 42);
  let bad = bad + check("asan-verdict", tafuzz_cmp.verdict(run_halves(42, 0), 10000) == 'asan);
  let bad = bad + check("asan-category", str.eq(tafuzz_cmp.category('asan), "tavm-crash"));
  let bad = bad + check("driver-verdict", tafuzz_cmp.verdict(driver_abort(), 10000) == 'bc_crash);
  let bad = bad + check("driver-category", str.eq(tafuzz_cmp.category('bc_crash), "backend-crash"));
  let bad = bad + check("clean-verdict", tafuzz_cmp.verdict(run_halves(0, 0), 10000) == 'ok);
  let bad = bad + check("asan-arm", asan_arm());
  if bad == 0 {
    print("PASS")
  } else {
    print(str.concat("FAIL - cases=", str.from_int(bad)))
  }
}

// asan_arm: the sanitizer toolchain is reported, never silently substituted.
// Present -> both run halves on ./tavm_asan with the exit protocol pinned;
// absent -> Err, so the ring says KERNFUZZ-DEGRADED instead of green-on-tavm.
fn asan_arm() {
  let there = file.exists("./tavm_asan")
  match tafuzz_arm.asan("build/kernfuzz/test-cache") {
    Err(_) -> there == 0
    Ok(tool) -> match tool {
      Tool(ta, tv, seed, cache, env) -> there == 1 && str.eq(tv, "./tavm_asan") && str.eq(car(env), "ASAN_OPTIONS=exitcode=42")
    }
  }
}

fn clean(tag) {
  Ph(0, 1, "1\n", "", tag)
}

// run_halves: two clean compile halves, run halves ending with the given codes.
fn run_halves(ar_rc, br_rc) {
  Sample(clean("ac"), Ph(ar_rc, 1, "1\n", "", "ar"), clean("bc"), Ph(br_rc, 1, "1\n", "", "br"))
}

// driver_abort: the sanitizer fires while compiling — a VM memory error, which
// is not a refusal of the program and must not be filed as one.
fn driver_abort() {
  Sample(clean("ac"), clean("ar"), Ph(42, 1, "", "** ASan: heap-buffer-overflow", "bc"), clean("br"))
}

fn length(xs) {
  if null?(xs) { 0 } else { 1 + length(cdr(xs)) }
}

fn first(xs) {
  car(xs)
}

fn check(name, ok) {
  if ok {
    0
  } else {
    print(str.concat("FAIL ", name))
    1
  }
}
