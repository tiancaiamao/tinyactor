// test/basic/pipe-basic.ta — positive runtime tests for the `|>` pipe
// operator (parse-time desugaring): the piped value becomes the FIRST
// argument of the call on the right.
// Covers: call, bare function, extra args, constructor, left-assoc chain,
// lowest precedence (wider than + and ||), and nested pipes.
// Expected output: 10, 10, 7, 4, (Pair 1 2 3), 20, 6, 5, PASS

fn double(x) { x * 2 }
fn inc(x) { x + 1 }
fn add2(a, b) { a + b }

fn main() {
  print(5 |> double())             // (double 5)        => 10
  print(5 |> double)               // bare fn: (double 5) => 10
  print(5 |> add2(2))              // (add2 5 2)        => 7
  print(1 |> inc() |> inc() |> inc())  // left assoc: (inc (inc (inc 1))) => 4
  print(1 |> Pair(2, 3))           // (Pair 1 2 3)      => (1 2 3)
  print(4 + 6 |> double())         // loosest: (double (+ 4 6)) => 20
  let w = 2
  print(w |> inc() |> double())    // (double (inc w))  => 6
  print(1 |> add2(2 |> double()))  // nested: (add2 1 (double 2)) => 5
  print("PASS")
}