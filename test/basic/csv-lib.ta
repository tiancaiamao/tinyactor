// Test: csv-lib — lib/csv.ta, the RFC 4180 core-subset parser + writer.
//
// Covers parsing (plain/quoted fields, "" escapes, embedded commas,
// newlines and quotes, CRLF and LF record ends, optional trailing
// newline, blank middle lines, empty input), the error channel (Err with
// "line L, col C: " position prefixes for unterminated quotes, stray
// quotes, lone CR and trailing garbage), and write() (minimal quoting,
// quote doubling, CRLF records) with the round-trip property
// parse(write(rows)) == rows and write idempotence.
//
// Expected: "ok - <label>" for every check, then PASS (same contract as
// dict-lib.ta: the ok flag is really accumulated across all checks).
// expect: PASS

import csv
import str
import result
import list

// deep_eq: == is pointer identity for pairs, so row structures need a
// structural comparison.
fn deep_eq(a, b) {
  if pair?(a) {
    if pair?(b) {
      deep_eq(car(a), car(b)) && deep_eq(cdr(a), cdr(b))
    } else {
      false
    }
  } else {
    if pair?(b) { false } else { a == b }
  }
}

fn check(label, got, want) {
  let pass = deep_eq(got, want)
  if pass {
    print(str.concat("ok - ", label))
  } else {
    print(str.concat("FAIL - ", str.concat(label, ": wrong value")))
  }
  if pass { 1 } else { 0 }
}

// rows of a successful parse (sentinel on Err)
fn rows_of(r, sentinel) {
  match r {
    Ok(rows) -> rows
    Err(_) -> sentinel
  }
}

// error message of a failed parse (sentinel on Ok)
fn err_of(r, sentinel) {
  match r {
    Err(msg) -> msg
    Ok(_) -> sentinel
  }
}

// parse must fail and the message must start with the given
// "line L, col C: " prefix
fn check_err_at(label, text, prefix) {
  let m = err_of(csv.parse(text), nil)
  let pass = if null?(m) {
    false
  } else {
    str.eq(str.substr(m, 0, str.length(prefix)), prefix)
  }
  if pass {
    print(str.concat("ok - ", label))
  } else {
    print(str.concat("FAIL - ", str.concat(label, str.concat(": got ", str.concat(m, "")))))
  }
  if pass { 1 } else { 0 }
}

fn main() {
  // ---------- parsing: records & fields ----------
  let ok1 = check("one record three fields", rows_of(csv.parse("a,b,c"), nil), [["a", "b", "c"]])
  let ok2 = check("two records LF", rows_of(csv.parse("a,b\nc,d"), nil), [["a", "b"], ["c", "d"]])
  let ok3 = check("two records CRLF", rows_of(csv.parse("a,b\r\nc,d"), nil), [["a", "b"], ["c", "d"]])
  let ok4 = check("trailing newline is a terminator, not a record",
    rows_of(csv.parse("a,b\r\nc,d\r\n"), nil), [["a", "b"], ["c", "d"]])
  let ok5 = check("empty unquoted fields", rows_of(csv.parse("a,,c"), nil), [["a", "", "c"]])
  let ok6 = check("empty input -> no records", rows_of(csv.parse(""), nil), nil)
  let ok7 = check("blank middle line -> one empty field",
    rows_of(csv.parse("a\n\nb"), nil), [["a"], [""], ["b"]])

  // ---------- parsing: quoted fields ----------
  let ok8 = check("quoted comma", rows_of(csv.parse("\"a,b\",c"), nil), [["a,b", "c"]])
  let ok9 = check("quoted newline", rows_of(csv.parse("\"a\nb\",c"), nil), [["a\nb", "c"]])
  let ok10 = check("quoted CRLF", rows_of(csv.parse("\"a\r\nb\",c"), nil), [["a\r\nb", "c"]])
  let ok11 = check("quoted quote (\"\" escape)", rows_of(csv.parse("\"a\"\"b\",c"), nil), [["a\"b", "c"]])
  let ok12 = check("quotes are optional", rows_of(csv.parse("\"a\",\"b\""), nil), [["a", "b"]])
  let ok13 = check("quoted empty field", rows_of(csv.parse("\"\",\"b\""), nil), [["", "b"]])
  let ok14 = check("quoted field keeps spaces", rows_of(csv.parse(" a ,\" b \""), nil), [[" a ", " b "]])

  // ---------- error channel: positions ----------
  let ok15 = check_err_at("unterminated quote", "\"abc", "line 1, col 5: ")
    let ok16 = check_err_at("stray quote after closing quote", "\"a\"b", "line 1, col 4: ")
  let ok17 = check_err_at("lone CR is an error", "a\rb", "line 1, col 2: ")
    let ok18 = check_err_at("quote not at field start", "a\"b", "line 1, col 2: ")
  let ok19 = check_err_at("error position is line-aware",
    "a,b\n\"unclosed", "line 2, col 10: ")
    let ok20 = check("parse errors are Err, not a crash", result.is_err(csv.parse("\"x")), true)

  // ---------- writing ----------
  let ok21 = check("write: plain rows", csv.write([["a", "b"], ["c", "d"]]), "a,b\r\nc,d")
  let ok22 = check("write: empty rows", csv.write(nil), "")
  let ok23 = check("write: empty field and empty record", csv.write([[""], []]), "\r\n")
  let ok24 = check("write: quotes only when needed",
    csv.write([["plain", "with,comma", "with\"quote", "with\nnl"]]),
    "plain,\"with,comma\",\"with\"\"quote\",\"with\nnl\"")
  let ok25 = check("write: leading/trailing spaces stay unquoted",
    csv.write([[" a "]]), " a ")

  // ---------- round-trip: parse -> write -> parse ----------
  let tricky = [["a", "b,c", "d\"e"], ["f\n", "", "\"g\""], [" h ", "i\r\nj"]]
  let w1 = csv.write(tricky)
  let p1 = csv.parse(w1)
  let ok26 = check("round-trip: parse(write(rows)) == rows", rows_of(p1, nil), tricky)
  let w2 = csv.write(rows_of(p1, nil))
  let ok27 = check("round-trip: write is idempotent", w2, w1)
  // normalized quoting: quoted-but-plain input loses its quotes
  let ok28 = check("write normalizes unnecessary quotes",
    csv.write(rows_of(csv.parse("\"a\",\"b\""), nil)), "a,b")
  let ok29 = check("round-trip: parse(write) is a fixed point",
    rows_of(csv.parse(csv.write(rows_of(csv.parse(w1), nil))), nil), rows_of(p1, nil))

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6 + ok7 + ok8 + ok9 + ok10 +
              ok11 + ok12 + ok13 + ok14 + ok15 + ok16 + ok17 + ok18 + ok19 +
              ok20 + ok21 + ok22 + ok23 + ok24 + ok25 + ok26 + ok27 + ok28 + ok29
  if total == 29 {
    print("PASS")
  } else {
    print(str.concat("FAIL - ", str.concat(str.from_int(29 - total), " of 29 checks failed")))
    1 / 0
  }
}