// test/basic/sha256.ta — sha256 facade (lib/sha256.ta) over the sha256 C
// primitives (OpenSSL EVP).
//
// Covers the published SHA-256 vectors (the empty string, "abc", the
// 56-byte string, the 896-bit message and the 1,000,000 x "a" case), the
// streaming API against the one-shot digest (same bytes, hashed in blocks
// and in slices), and the error channel (an out-of-range slice is rejected
// instead of hashing the wrong bytes).
//
// expect: PASS

import sha256
import option
import str

// bool_text: a bool as a string, so the checks can compare it.
fn bool_text(b : Bool) -> String {
  if b { "true" } else { "false" }
}

// check: 0 when the check passed, 1 when it failed — the checks are
// summed, so the total is the number of failures.
fn check(label, got, want) {
  if got == want {
    print(str.concat("ok - ", label))
    0
  } else {
    print(str.concat("FAIL - ", str.concat(label, ": got ")))
    print(got)
    1
  }
}

// digest_of: the one-shot digest as a plain string ("<none>" on failure).
fn digest_of(data : String) -> String {
  match sha256.digest(data) {
    None -> "<none>"
    Some(s) -> s
  }
}

// stream: hash data in blocks of `step` bytes.
fn stream(data : String, step : Int) -> String {
  match sha256.new() {
    None -> "<none>"
    Some(h) -> {
      let _ = block_loop(h, data, 0, str.length(data), step)
      match sha256.final(h) {
        None -> "<none>"
        Some(s) -> s
      }
    }
  }
}

fn block_loop(h, data : String, done : Int, total : Int, step : Int) -> Int {
  if done >= total {
    0
  } else {
    let left = total - done
    let take = if left < step { left } else { step }
    let _ = sha256.update_at(h, data, done, take)
    block_loop(h, data, done + take, total, step)
  }
}

// slice_at: hash only data[off, off+len) — the read-in-place path.
fn slice_at(data : String, off : Int, len : Int) -> String {
  match sha256.new() {
    None -> "<none>"
    Some(h) -> {
      let _ = sha256.update_at(h, data, off, len)
      match sha256.final(h) {
        None -> "<none>"
        Some(s) -> s
      }
    }
  }
}

// slice_ok: the error channel — a slice outside the string is rejected
// instead of hashing the wrong bytes.
fn slice_ok(data : String, off : Int, len : Int) -> Bool {
  match sha256.new() {
    None -> false
    Some(h) -> sha256.update_at(h, data, off, len)
  }
}

// stale_is_inert: final consumes the context, so every call on the spent
// handle must fail instead of touching freed memory.
fn stale_is_inert(data : String) -> String {
  match sha256.new() {
    None -> "<none>"
    Some(h) -> {
      let _ = sha256.update(h, data)
      let _ = sha256.final(h)
      let upd = bool_text(sha256.update(h, data))
      let fin = match sha256.final(h) {
        None -> "nil"
        Some(_) -> "some"
      }
      str.concat(upd, str.concat(" ", fin))
    }
  }
}

// many_a: a string of n "a"s, grown by doubling (the copy cost is O(n)).
fn many_a(n : Int) -> String {
  str.substr(grow_a("a", n), 0, n)
}

fn grow_a(s : String, n : Int) -> String {
  if str.length(s) >= n {
    s
  } else {
    grow_a(str.concat(s, s), n)
  }
}

fn main() {
  let mut_total = 0

  // Published vectors (FIPS 180-4 / NIST).
  let mut_total = mut_total + check("empty string", digest_of(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  let mut_total = mut_total + check("abc", digest_of("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  let mut_total = mut_total + check("56-byte string", digest_of("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
  let mut_total = mut_total + check("896-bit message", digest_of("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
    "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
  let mut_total = mut_total + check("one million a", digest_of(many_a(1000000)),
    "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")

  // Streaming must agree with the one-shot digest, block by block.
  let msg = "the quick brown fox jumps over the lazy dog"
  let mut_total = mut_total + check("stream, 1-byte blocks", stream(msg, 1), digest_of(msg))
  let mut_total = mut_total + check("stream, 7-byte blocks", stream(msg, 7), digest_of(msg))
  let mut_total = mut_total + check("stream, one block", stream(msg, str.length(msg)), digest_of(msg))
  let mut_total = mut_total + check("stream, block past the end", stream(msg, 1000), digest_of(msg))

  // Slicing: hashing a slice is hashing those bytes, not the whole string.
  let mut_total = mut_total + check("slice at 4, 3 bytes", slice_at(msg, 4, 3), digest_of("qui"))
  let mut_total = mut_total + check("slice past the end is rejected",
    bool_text(slice_ok(msg, 4, 1000)), "false")
  let mut_total = mut_total + check("negative offset is rejected",
    bool_text(slice_ok(msg, -1, 3)), "false")
    let mut_total = mut_total + check("slice inside the string is accepted",
    bool_text(slice_ok(msg, 4, 3)), "true")
  let mut_total = mut_total + check("a spent handle is inert", stale_is_inert(msg), "false nil")

  if mut_total == 0 {
    print("PASS")
  } else {
    print(str.concat("FAIL - ", str.concat(str.from_int(mut_total), " checks failed")))
  }
}