// test/basic/net-errno.ta — net.errno(): proc-local last hard-failure errno
// (batch 4 net delta ①). The C layer's -1 / 'refused / 'error returns carry
// no errno payload; net.errno() reads back the errno of this actor's most
// recent net hard failure (0 = none yet).
//
// Checks:
//   1. fresh proc            → 0 (no failure yet)
//   2. double bind           → listen -1, errno != 0 (EADDRINUSE; the
//                               numeric value is platform-specific —
//                               48 on macOS, 98 on Linux — so only != 0)
//   3. refused connect       → 'refused, errno != 0 (ECONNREFUSED);
//                               retried on fresh random ports if the port
//                               is stolen between close and connect
//   4. proc locality         → a freshly spawned actor still reads 0:
//                               last_errno lives on the Proc, not the thread
//
// Ports are picked at random (retry on bind collision) — no fixed ports,
// no CI contention. Expected: "ok - <label>" per check, then PASS.
// expect: PASS

import "tinyactor:lib/net"
import "tinyactor:lib/option"
import "tinyactor:lib/result"
import "tinyactor:lib/random"

fn check(label, ok) {
  if ok {
    print(str.concat("ok - ", label))
    0
  } else {
    print(str.concat("FAIL - ", label))
    1
  }
}

// Bound: a listening socket beside the port it is bound to. A declared
// record, not a cons pair — cons builds lists, and the pair's two fields are
// not "a port and more ports".
type Bound {
  Bound(sock, port)
}

fn bound_sock(b) {
  match b {
    Bound(sock, _) -> sock
  }
}

fn bound_port(b) {
  match b {
    Bound(_, port) -> port
  }
}

// Random loopback port in [20000, 40000). Returns Some(Bound) holding the
// LISTENING socket (kept open by the caller) and its port, or None after
// tries collisions. A rand_int Err counts as a failed try (retry) — never fed
// to net.listen.
fn bind_random_port(tries) {
  if tries == 0 {
    option.None
  } else {
    let r = random.rand_int(20000)
    let p = match r {
      result.Ok(p) -> 20000 + p
      _ -> -1
    }
    if p == -1 {
      bind_random_port(tries - 1)
    } else {
      let s = net.listen(p)
      if s == -1 {
        bind_random_port(tries - 1)
      } else {
        option.Some(Bound(s, p))
      }
    }
  }
}

// connect_retry: the C side yields (returns nil) while the non-blocking
// connect is in flight; TA retries, like the net_read EAGAIN idiom.
fn connect_retry(host, port, timeout) {
  let r = net.connect_timeout(host, port, timeout)
  match r {
    nil -> connect_retry(host, port, timeout)
    x -> x
  }
}

// refused_scenario: bind a fresh random port, release it, then connect to
// the unbound port — immediate ECONNREFUSED on loopback; expect 'refused
// + a real errno. Retried on fresh ports because between close and
// connect another process could bind the port first (connect would then
// succeed) — same CI-jitter class net-load.ta's attempt wrapper covers.
// Returns 0/1.
fn refused_scenario(tries) {
  if tries == 0 {
    check("refused connect reported", false) + check("refused leaves errno", false)
  } else {
    match bind_random_port(50) {
      option.None -> check("refused setup (no port)", false)
      option.Some(b) -> {
        let port = bound_port(b)
        net.close(bound_sock(b))
        let r = connect_retry("127.0.0.1", port, 3000)
        if r == 'refused {
          check("refused connect reported", true) + check("refused leaves errno", net.errno() != 0)
        } else {
          // Port stolen (or other jitter): close any stray connection
          // and retry on a fresh random port.
          if int?(r) {
            net.close(r)
          }
          refused_scenario(tries - 1)
        }
      }
    }
  }
}

fn main() {
  let f0 = check("fresh proc reads 0", net.errno() == 0)

  // 2. Double bind: keep the first listener open, a second listen on the
  //    same port must hard-fail with a real errno.
  let bound = bind_random_port(50)
  let f1 = f0 + check("random bind succeeded", option.is_some(bound))

  let f2 = match bound {
    option.None -> 0
    option.Some(b) -> {
      let s1 = bound_sock(b)
      let port = bound_port(b)
      let s2 = net.listen(port)
      let f = check("double bind fails", s2 == -1)
      let f = f + check("double bind leaves errno", net.errno() != 0)

      // 3. 'refused: release a second port, then connect to the unbound
      //    port — immediate ECONNREFUSED on loopback, errno must follow.
      // fr (not f): keep the outer double-bind tally visible — re-binding f
      // here would shadow and drop it, silently turning double-bind failures
      // into PASS.
      let fr = refused_scenario(3)
      let f = f + fr

      net.close(s1)

      // 4. Proc locality: errno lives on the Proc — a fresh actor reads 0
      //    even though this actor just failed twice.
      let me = self()
      spawn(fn { send(me, net.errno()) })
      let child_errno = recv()
      let f = f + check("fresh actor reads 0 (proc-local)", child_errno == 0)
      f
    }
  }

  let f = f1 + f2
  if f == 0 {
    print("PASS")
  } else {
    print(str.concat("FAILURES: ", str.from_int(f)))
  }
}