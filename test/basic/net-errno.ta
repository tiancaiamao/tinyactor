// test/basic/net-errno.ta — net.errno(): proc-local last hard-failure errno
// (batch 4 net delta ①). The C layer's -1 / 'refused / 'error returns carry
// no errno payload; net.errno() reads back the errno of this actor's most
// recent net hard failure (0 = none yet).
//
// Checks:
//   1. fresh proc            → 0 (no failure yet)
//   2. double bind           → listen -1, errno != 0 (EADDRINUSE; the
//                               numeric value is platform-specific —
//                               48 on macOS, 98 on Linux — so only != 0)
//   3. refused connect       → 'refused, errno != 0 (ECONNREFUSED)
//   4. proc locality         → a freshly spawned actor still reads 0:
//                               last_errno lives on the Proc, not the thread
//
// Ports are picked at random (retry on bind collision) — no fixed ports,
// no CI contention. Expected: "ok - <label>" per check, then PASS.
// expect: PASS

import net
import result
import random

fn check(label, ok) {
  if ok {
    print(str.concat("ok - ", label))
    0
  } else {
    print(str.concat("FAIL - ", label))
    1
  }
}

// Random loopback port in [20000, 40000). Returns the LISTENING socket
// (kept open by the caller) and its port as cons(s, p), or -1 after tries
// collisions.
fn bind_random_port(tries) {
  if tries == 0 {
    -1
  } else {
    let r = random.rand_int(20000)
    let p = match r {
      Ok(p) -> 20000 + p
      _ -> -1
    }
    let s = net.listen(p)
    if s == -1 {
      bind_random_port(tries - 1)
    } else {
      cons(s, p)
    }
  }
}

// connect_retry: the C side yields (returns nil) while the non-blocking
// connect is in flight; TA retries, like the net_read EAGAIN idiom.
fn connect_retry(host, port, timeout) {
  let r = net.connect(host, port, timeout)
  match r {
    nil -> connect_retry(host, port, timeout)
    x -> x
  }
}

fn main() {
  let f0 = check("fresh proc reads 0", net.errno() == 0)

  // 2. Double bind: keep the first listener open, a second listen on the
  //    same port must hard-fail with a real errno.
  let sp = bind_random_port(50)
  let s1 = car(sp)
  let port = cdr(sp)
  let f1 = f0 + check("random bind succeeded", s1 != -1)

  let f2 = if s1 != -1 {
    let s2 = net.listen(port)
    let f = check("double bind fails", s2 == -1)
    let f = f + check("double bind leaves errno", net.errno() != 0)

    // 3. 'refused: release a second port, then connect to the unbound
    //    port — immediate ECONNREFUSED on loopback, errno must follow.
    let sp2 = bind_random_port(50)
    let sq = car(sp2)
    let port2 = cdr(sp2)
    // fr (not f): keep the outer double-bind tally visible — re-binding f
    // here would shadow and drop it, silently turning double-bind failures
    // into PASS.
    let fr = if sq != -1 {
      net.close(sq)
      let r = connect_retry("127.0.0.1", port2, 3000)
      let rf = check("refused connect reported", r == 'refused)
      let rf = rf + check("refused leaves errno", net.errno() != 0)
      rf
    } else {
      check("refused setup (no port)", false)
    }
    let f = f + fr

    net.close(s1)

    // 4. Proc locality: errno lives on the Proc — a fresh actor reads 0
    //    even though this actor just failed twice.
    let me = self()
    spawn(fn { send(me, net.errno()) })
    let child_errno = recv()
    let f = f + check("fresh actor reads 0 (proc-local)", child_errno == 0)
    f
  } else {
    0
  }

  let f = f1 + f2
  if f == 0 {
    print("PASS")
  } else {
    print(str.concat("FAILURES: ", str.from_int(f)))
  }
}