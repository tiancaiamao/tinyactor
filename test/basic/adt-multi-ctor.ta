// test/basic/adt-multi-ctor.ta — n-ary ADT constructor patterns must match
// the constructor name strictly. A value built with one constructor must
// NOT match a pattern of another constructor — same arity or not.
//
// The legacy form of this test built the "not a constructor" values out of
// raw cons cells (`cons('Mul, cons(2, cons(5, nil)))`). cons builds lists, so
// with a declared shape such a value no longer typechecks at all — being
// unrepresentable is stronger than being unmatched. What the patterns still
// have to prove is name (Add vs Mul, same arity) and arity (Triple's 3 vs
// Add's 2) strictness, so both cases are constructors of this same type.
type Msg {
  Add(a, b)
  Mul(a, b)
  Triple(a, b, c)
}

fn main() {
  // correct constructor matches
  let m1 = Mul(2, 5)
  match m1 {
    Add(a, b) -> print(1)
    Mul(a, b) -> print(a * b)
    _ -> print(0)
  }
  // same arity, other name: an Add pattern must not catch a Mul value
  let m2 = Mul(2, 5)
  match m2 {
    Add(a, b) -> print(1)
    _ -> print(0)
  }
  // arity mismatch must NOT match: a 3-field value never matches a 2-field
  // constructor pattern. The value is assembled through a variable.
  let three = Triple(1, 2, 3)
  match three {
    Add(a, b) -> print(1)
    _ -> print(0)
  }
}