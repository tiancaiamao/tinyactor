// test/basic/adt-multi-ctor.ta — n-ary ADT constructor patterns must match
// the constructor name strictly. A message built with one constructor must
// NOT match a pattern of another constructor with the same arity.
type Msg {
  Add(a, b)
  Mul(a, b)
}

fn main() {
  // correct constructor matches
  let m1 = Mul(2, 5)
  match m1 {
    Add(a, b) -> print(1)
    Mul(a, b) -> print(a * b)
    _ -> print(0)
  }
  // A hand-built cons chain is not a constructor value (constructors are
  // tuples, see docs/ta-language-spec.md), so it matches no ctor arm.
  let m2 = cons('Mul, cons(2, cons(5, nil)))
  match m2 {
    Add(a, b) -> print(1)
    _ -> print(0)
  }
      // arity mismatch must NOT match. The raw pair is assembled through a
  // variable: (cons 'Add (cons 1 nil)) is the legacy pair encoding, which is
  // a plain pair now — never a constructor value.
  let one = cons(1, nil)
  let m3 = cons('Add, one)
  match m3 {
    Add(a, b) -> print(1)
    _ -> print(0)
  }
}