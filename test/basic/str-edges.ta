// test/basic/str-edges.ta — documented edge behavior of the str module.
//
// Each case hits a guard in src/str.c that the happy-path tests never
// touch: out-of-range chr, out-of-range substr, all-whitespace to_int,
// empty-needle index_of, invalid pad character, int-widened from_float.
//
// Acceptance: every case matches the C-side guard's documented result.
// expect: PASS

import str

fn check(label, got, want) {
  if got == want {
    print(str.concat("ok - ", label))
    0
  } else {
    print(str.concat("FAIL - ", label))
    1
  }
}

fn main() {
  let f1 = check("chr out of byte range is empty", str.chr(300), "")
  let f2 = check("chr negative is empty", str.chr(-1), "")
  let f3 = check("substr past the end is empty", str.substr("ab", 5, 1), "")
  let f4 = check("to_int of whitespace is 0", str.to_int("   "), 0)
  let f5 = check("index_of empty needle is 0", str.index_of("abc", ""), 0)
  let f6 = check("pad_start invalid char leaves string unchanged", str.pad_start("ab", 5, 300), "ab")
  let f7 = check("from_float widens an int", str.from_float(7), "7")
  if f1 + f2 + f3 + f4 + f5 + f6 + f7 == 0 {
    print("PASS")
  } else {
    print("FAIL - str-edges")
  }
}