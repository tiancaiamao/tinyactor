// test/basic/net-load.ta — reproducible multi-connection load test with an
// actor-starvation acceptance check (batch 4 net delta ②/③).
//
// Topology (all loopback, self-listen/self-connect, no external service):
//
//   main ── listen(random port, collision-retry) ──► acceptor actor
//        │   acceptor spawns one echo actor per connection (N total)
//        ├──► N client actors: connect, R request/response roundtrips each,
//        │    verifying the echo byte-for-byte (round-tagged payloads)
//        ├──► canary actor: a pure-compute spin counted over a fixed
//        │    window WHILE the load runs — asserts the scheduler keeps an
//        //   independent actor making progress (no starvation)
//        └──► message accounting (ClientDone / EchoDone / AcceptorDone /
//             Canary) so every spawned actor has exited before PASS.
//
// Acceptance (CI-stable, all loose lower bounds):
//   - zero failed roundtrips across N x R
//   - canary iterations >= 1000 in a 400ms window. One iteration is a few
//     VM instructions plus a clock read; fair round-robin scheduling
//     (1000-reduction quanta) gives orders of magnitude more even on a
//     loaded slow runner — real starvation lands far below this bound.
//   - every actor accounted for (no leaks into scheduler shutdown)
//
// The whole scenario retries up to 3 times on failure to tolerate slow-CI
// jitter (same spirit as test/lib.sh's flaky retry), each attempt on a
// fresh random port. Expected output: PASS.
// expect: PASS

import net
import str
import list
import result
import random

const N_CLIENTS = 4
const N_ROUNDS = 15
const CANARY_WINDOW_MS = 400
const CANARY_MIN_TICKS = 1000
const MAX_ATTEMPTS = 3

type LoadMsg {
  Canary(n)
  ClientDone(fails)
  EchoDone
  AcceptorDone
}

// connect_retry: the C side yields (returns nil) while the non-blocking
// connect is in flight; TA retries, like the net_read EAGAIN idiom.
fn connect_retry(host, port, timeout) {
  let r = net.connect(host, port, timeout)
  match r {
    nil -> connect_retry(host, port, timeout)
    x -> x
  }
}

// accept_retry: ditto for the listening side.
fn accept_retry(s) {
  let a = net.accept(s)
  match a {
    nil -> accept_retry(s)
    x -> x
  }
}

// Write all of data; retries on EAGAIN (already yielded) and partial
// writes. Returns -1 on hard error.
fn write_all(fd, data) {
  match net.write(fd, data) {
    -1 -> -1
    n when null?(n) -> write_all(fd, data)
    n when n < str.length(data) -> write_all(fd, str.substr(data, n, str.length(data) - n))
    n -> n
  }
}

// Read until at least want bytes accumulated (echo payloads are small;
// a single read normally delivers them whole, this only guards partial
// chunking). Returns the accumulated string.
fn read_exact(fd, acc, want) {
  if str.length(acc) >= want {
    acc
  } else {
    match net.read(fd, 4096) {
      nil -> read_exact(fd, acc, want)
      d when int?(d) -> acc // -1 hard error or 'eof: mismatch detected by caller
      d -> read_exact(fd, str.concat(acc, d), want)
    }
  }
}

// Random loopback port in [20000, 40000). Returns cons(listen fd, port),
// or -1 after tries collisions.
fn bind_random_port(tries) {
  if tries == 0 {
    -1
  } else {
    let r = random.rand_int(20000)
    let p = match r {
      Ok(p) -> 20000 + p
      _ -> -1
    }
    let s = net.listen(p)
    if s == -1 {
      bind_random_port(tries - 1)
    } else {
      cons(s, p)
    }
  }
}

// Echo actor: one per connection; bounces every chunk back until the
// peer closes ('eof) or the socket hard-errors, then reports EchoDone so
// main can account for this actor before exiting.
fn echo_loop(main, c) {
  match net.read(c, 4096) {
    nil -> echo_loop(main, c)
    d when int?(d) -> {
      net.close(c)
      send(main, EchoDone)
    }
    d -> {
      let w = write_all(c, d)
      if w == -1 {
        net.close(c)
        send(main, EchoDone)
      } else {
        echo_loop(main, c)
      }
    }
  }
}

// Acceptor: spawns one echo actor per connection until N are handed out,
// then reports AcceptorDone and closes the listener. main already holds
// the listening socket, so connects succeed before this even runs.
fn acceptor(main, s, remaining) {
  if remaining == 0 {
    net.close(s)
    send(main, AcceptorDone)
  } else {
    let c = accept_retry(s)
    if c == -1 {
      net.close(s)
      send(main, AcceptorDone)
    } else {
      spawn(fn { echo_loop(main, c) })
      acceptor(main, s, remaining - 1)
    }
  }
}

// Client: R roundtrips of a round-tagged payload, verifying the echo.
fn client_loop(main, c, i, r, fails) {
  if r == 0 {
    net.close(c)
    send(main, ClientDone(fails))
  } else {
    let payload = str.concat("ping-", str.concat(str.from_int(i), str.concat("-", str.from_int(r))))
    if write_all(c, payload) == -1 {
      client_loop(main, c, i, 0, fails + 1)
    } else {
      let got = read_exact(c, "", str.length(payload))
      if got == payload {
        client_loop(main, c, i, r - 1, fails)
      } else {
        client_loop(main, c, i, r - 1, fails + 1)
      }
    }
  }
}

fn client_run(main, port, i) {
  let c = connect_retry("127.0.0.1", port, 3000)
  if int?(c) {
    client_loop(main, c, i, N_ROUNDS, 0)
  } else {
    send(main, ClientDone(1))
  }
}

fn spawn_clients(main, port, i) {
  if i == 0 {
    0
  } else {
    spawn(fn { client_run(main, port, i) })
    spawn_clients(main, port, i - 1)
  }
}

// Canary: pure-compute spin (no I/O) — the starvation probe. Reports the
// iteration count over one CANARY_WINDOW_MS window.
fn canary_spin(main, deadline, n) {
  if vm.time_ms() >= deadline {
    send(main, Canary(n))
  } else {
    canary_spin(main, deadline, n + 1)
  }
}

// Drain exactly `remaining` LoadMsgs, accumulating the four counters as a
// list. recv_after bounds the wait so a lost message fails the round
// instead of hanging the test until the harness timeout.
fn collect(remaining, canary_n, client_fails, echoes, acceptors) {
  if remaining == 0 {
    cons(canary_n, cons(client_fails, cons(echoes, cons(acceptors, nil))))
  } else {
    match recv_after(20000) {
      nil -> {
        print("collect-timeout")
        cons(0, cons(remaining, cons(echoes, cons(acceptors, nil))))
      }
      Canary(n) -> collect(remaining - 1, canary_n + n, client_fails, echoes, acceptors)
      ClientDone(f) -> collect(remaining - 1, canary_n, client_fails + f, echoes, acceptors)
      EchoDone -> collect(remaining - 1, canary_n, client_fails, echoes + 1, acceptors)
      AcceptorDone -> collect(remaining - 1, canary_n, client_fails, echoes, acceptors + 1)
      _ -> collect(remaining - 1, canary_n, client_fails, echoes, acceptors)
    }
  }
}

// One full load scenario. Returns the failure count (0 = clean).
fn load_round(attempt) {
  let me = self()
  let sp = bind_random_port(50)
  let s = car(sp)
  if s == -1 {
    print(str.concat("attempt ", str.concat(str.from_int(attempt), ": no free port")))
    1
  } else {
    let port = cdr(sp)
    spawn(fn { acceptor(me, s, N_CLIENTS) })
    spawn(fn { canary_spin(me, vm.time_ms() + CANARY_WINDOW_MS, 0) })
    spawn_clients(me, port, N_CLIENTS)

    // 1 Canary + N ClientDone + N EchoDone + 1 AcceptorDone
    let res = collect(2 * N_CLIENTS + 2, 0, 0, 0, 0)
    let canary_n = list.nth(res, 0)
    let client_fails = list.nth(res, 1)
    let echoes = list.nth(res, 2)
    let acceptors = list.nth(res, 3)

    let f = check("canary made progress under load", canary_n >= CANARY_MIN_TICKS)
    let f = f + check("all roundtrips echoed intact", client_fails == 0)
    let f = f + check("all echo actors accounted", echoes == N_CLIENTS)
    let f = f + check("acceptor accounted", acceptors == 1)
    if f != 0 {
      print(
        str.concat(
          "attempt ",
          str.concat(
            str.from_int(attempt),
            str.concat(
              ": canary=",
              str.concat(
                str.from_int(canary_n),
                str.concat(" roundtrip-fails=", str.concat(str.from_int(client_fails), str.concat(" echoes=", str.from_int(echoes)))),
              ),
            ),
          ),
        ),
      )
    }
    f
  }
}

fn check(label, ok) {
  if ok {
    print(str.concat("ok - ", label))
    0
  } else {
    print(str.concat("FAIL - ", label))
    1
  }
}

fn attempt(n) {
  if n > MAX_ATTEMPTS {
    1
  } else {
    let f = load_round(n)
    if f == 0 {
      0
    } else {
      attempt(n + 1)
    }
  }
}

fn main() {
  let f = attempt(1)
  if f == 0 {
    print("PASS")
  } else {
    print("FAIL")
  }
}