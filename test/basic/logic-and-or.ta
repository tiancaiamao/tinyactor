// test/basic/logic-and-or.ta — and/or short-circuit logic
// Covers: infix `a and b` / `a or b`, Lisp-style (and a b) / (or a b),
// falsy semantics (nil/false are falsy, 0 is truthy), and short-circuiting
// that skips side effects in the unevaluated branch.

fn main() {
  // 0 is truthy in TA (falsy = {nil, false})
  print(0 and 2)        // 2 — 0 truthy, both evaluated
  print(0 or 2)         // 0 — or returns first truthy
  print(nil or 7)       // 7 — nil is falsy
  print(false and 9)    // false — and returns first falsy
  print(1 and 2 and 3)  // 3 — chained and
  print(nil or false or 4) // 4 — chained or
  // Lisp-style forms parse as proper lists headed by and/or
  print((and 0 2))      // 2
  print((or 0 2))       // 0 — short-circuits, returns first truthy
  print((or nil 8))     // 8
  // Short-circuit skips the right-hand side entirely (no "NO-SIDE" output)
  print(nil and print("NO-SIDE-1"))
  print(1 or print("NO-SIDE-2"))
  print((and nil (print "NO-SIDE-3")))
  print((or 1 (print "NO-SIDE-4")))
  print("PASS")
}