// test/basic/logic-and-or.ta — && / || short-circuit logic with strict Bool operands.
// Covers: && truth table, || truth table, chained expressions, comparison
// operands, short-circuiting that skips side effects, and use in if conditions.
// Expected output: truth values ending with "PASS"

fn main() {
  // && truth table
  print(true && true)    // true
  print(true && false)   // false
  print(false && true)   // false
  print(false && false)  // false

  // || truth table
  print(true || false)   // true
  print(false || true)   // true
  print(false || false)  // false
  print(true || true)    // true

  // Chained
  print(true && true && false)   // false
  print(false || false || true)  // true

  // With comparison expressions
  print((1 == 1) && (2 == 2))  // true
  print((1 > 2) || (3 < 4))    // true

  // Short-circuit: the right-hand side must NOT be evaluated,
  // so "NO-SIDE-1"/"NO-SIDE-2" must never appear in the output.
  print(false && print("NO-SIDE-1"))  // false
  print(true || print("NO-SIDE-2"))   // true

  // Result used in an if condition
  if true && true {
    print("IF-OK")
  } else {
    print("IF-BAD")
  }

  print("PASS")
}