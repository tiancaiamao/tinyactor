// Test: pattern-match-pair-destructure
// Purpose: Pattern matching on two-element lists to destructure messages.
//          Tests the pair-matching opcode with various patterns.
// Expected output: got 1 and 2\ngot symbol hello

fn test_pair() {
  let p = [1, 2]
  match p {
    [a, b] -> print("got 1 and 2")
    _ -> print("no pair")
  }
}

fn test_symbol() {
  match 'hello {
    'hello -> print("got symbol hello")
    _ -> print("no match")
  }
}

fn main() {
  test_pair()
  test_symbol()
}