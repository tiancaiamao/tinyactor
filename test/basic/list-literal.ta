// list-literal.ta — verify [a, b, c] list literal in expressions
// Expected output: (1 2 3)\n3\n(1 (2 3) 4)\nPASS\n6\n(a b)\n2\n1

fn len(l) {
  if null?(l) {
    0
  } else {
    1 + len(cdr(l))
  }
}

// Traversal via match + cons: homogeneous int list (issue #80 positive case)
fn sum_list(l) {
  match l {
    nil -> 0,
    cons(h, t) -> h + sum_list(t)
  }
}

fn main() {
  let lst = [1, 2, 3]
  print(lst)
  print(len(lst))
  print([1, [2, 3], 4])
  let empty = []
  if null?(empty) {
    print("PASS")
  } else {
    print("FAIL")
    }
  print(sum_list([1, 2, 3]))
  print(["a", "b"])
  let flags = [true, false]
  print(len(flags))
  print(len([1]))
}