// list-literal.ta — verify [a, b, c] list literal in expressions
// Expected output: (1 2 3)\n3\n(1 (2 3) 4)\nPASS

fn len(l) {
  if null?(l) {
    0
  } else {
    1 + len(cdr(l))
  }
}

fn main() {
  let lst = [1, 2, 3]
  print(lst)
  print(len(lst))
  print([1, [2, 3], 4])
  let empty = []
  if null?(empty) {
    print("PASS")
  } else {
    print("FAIL")
  }
}