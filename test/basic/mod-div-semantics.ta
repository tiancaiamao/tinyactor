// mod-div-semantics.ta — POSITIVE test for arithmetic operand guards
// (issue #158): % and / keep their defined semantics; a dynamic (mixed)
// operand must not change the pure-int results.
// Expected: runs and prints mod ok / div ok / float ok / inf ok.
fn main() {
  // remainder, sign follows dividend (C % semantics)
  if 7 % 3 == 1 {
    if 0 - 7 % 3 == 0 - 1 {
      if 7 % (0 - 3) == 1 {
        print("mod ok")
      }
    }
  }

  // integer division truncates toward zero
  if 7 / 2 == 3 {
    if (0 - 7) / 2 == 0 - 3 {
      print("div ok")
    }
  }

    // any float operand → double precision, never narrowed back
  if 3.0 / 2.0 == 1.5 {
    if 1.0 + 1.5 == 2.5 {
      print("float ok")
    }
  }

      // float division by zero yields inf (never traps)
  let inf = 1.0 / 0.0
  if inf > 1.0 {
    print("inf ok")
  }
}