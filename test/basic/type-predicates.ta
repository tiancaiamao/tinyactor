// Test: type-predicates
// Purpose: exercise every bare-name predicate — the C-side `bare_preds` list in
//          src/host.c, which compile.ta's `bare_cfunc` compiles as a by-name
//          ccall and typecheck's `make_builtin_env` promises as
//          `forall a. a -> Bool`. Missing any one of the three tables shows up
//          as [E0002] undefined function (float? / bool? were missing from
//          typecheck until this test existed; bytes? / pid? were the generation
//          before them).
// Expected output: 21 lines, all "ok".

fn p(cond) {
  if cond { print("ok") } else { print("FAIL") }
}

// pf: the predicate under test is expected to be FALSE here
fn pf(cond) {
  if cond { print("FAIL") } else { print("ok") }
}

fn main() {
  p(null?(nil))
  pf(null?(cons(1, nil)))
  p(pair?(cons(1, nil)))
  pf(pair?(nil))
  p(int?(42))
  pf(int?("hi"))
  p(string?("hi"))
  pf(string?(42))
    // bytes has no user-facing constructor yet; the predicate must answer
  // false on non-bytes values (see test/basic/bytes-basic-errors.ta)
  pf(bytes?(42))
  pf(bytes?("hi"))
  let pid = spawn(fn { })
  p(pid?(pid))
  pf(pid?(42))
  p(symbol?('a))
  pf(symbol?(42))
  pf(symbol?("hi"))
  pf(symbol?(cons(1, nil)))
  // float? / bool? — the predicates that had no type-level promise
  p(float?(1.5))
  pf(float?(1))
  p(bool?(true))
  pf(bool?(0))
}