// Test: str module extensions (split/join/trim/replace/upper/lower/pad/
// parse_float/from_float/from_base/to_base). ASCII scope: non-ASCII bytes
// pass through case mapping and count one codepoint each in pad/length.
// Semantics under test are documented in src/str.c's header comment.
//
// Every check prints "ok - <label>" or a "FAIL - <label>" detail line
// and returns 1/0. PASS is printed only when ALL checks passed (same
// contract as path-lib.ta / buffer-basic.ta): on any failure the
// harness sees the FAIL detail lines + a summary count instead of PASS.
// The harness (test/lib.sh run_test) greps the output for the
// `// expect:` pattern below, so a missing PASS turns the harness red
// even though the script itself still exits 0.
//
// Expected: "ok - <label>" for every check, then PASS.
// expect: PASS

import option
import str

fn show_list(xs) {
  let parts = str.join(xs, "|")
  str.concat("[", str.concat(parts, "]"))
}

fn check(label, got, want) {
  let pass = str.eq(got, want)
  if pass {
    print(str.concat("ok - ", label))
  } else {
    print(str.concat("FAIL - ", str.concat(label, str.concat(": got ", str.concat(got, str.concat(", want ", want))))))
  }
  if pass { 1 } else { 0 }
}

// split results go through the show_list rendering ("[a|b|c]" shape).
fn check_split(label, xs, want) {
  check(label, show_list(xs), want)
}

// int result rendered as a string so one check shape covers everything.
fn check_int(label, got, want) {
  check(label, str.from_int(got), want)
}

// \t \n \v \f \r — \v (11) and \f (12) have no TA escape, built via chr
fn ws_all() {
  str.concat(str.chr(9), str.concat(str.chr(10),
    str.concat(str.chr(11), str.concat(str.chr(12), str.concat(str.chr(13), "")))))
}

fn main() {
  // ---- split ----
  let ok1 = check_split("split simple", str.split("a,b,c", ","), "[a|b|c]")
  let ok2 = check_split("split sep absent", str.split("abc", ","), "[abc]")
  let ok3 = check_split("split empty piece", str.split("a,,b", ","), "[a||b]")
  let ok4 = check_split("split edge pieces", str.split(",a,", ","), "[|a|]")
  let ok5 = check_split("split empty sep", str.split("ab", ""), "[a|b]")
  let ok6 = check_split("split empty string", str.split("", ","), "[]")
  let ok7 = check_split("split multi-char sep", str.split("banana", "an"), "[b||a]")
  let ok8 = check_split("split non-overlapping", str.split("aaa", "aa"), "[|a]")
  let ok9 = check_int("split empty string length", str.length(car(str.split("", ","))), "0")

  // ---- join ----
  let ok10 = check("join 3 elems", str.join(cons("x", cons("y", cons("z", nil))), "-"), "x-y-z")
  let ok11 = check("join empty list", str.join(nil, "-"), "")
  let ok12 = check_int("join empty length", str.length(str.join(nil, "-")), "0")
  let ok13 = check_int("join solo length", str.length(str.join(cons("solo", nil), "-")), "4")
  let ok14 = check_int("join empty sep length", str.length(str.join(cons("a", nil), "")), "1")

  // ---- trim ----
  let ok15 = check("trim spaces", str.concat("<", str.concat(str.trim("  hi  "), ">")), "<hi>")
  let ok16 = check("trim tabs/newlines", str.concat("<", str.concat(str.trim("\t\nhi\r"), ">")), "<hi>")
  let ok17 = check("trim all ws kinds", str.concat("<", str.concat(str.trim(str.concat(ws_all(), str.concat("hi", ws_all()))), ">")), "<hi>")
  let ok18 = check_int("trim all-ws length", str.length(str.trim("   ")), "0")
  let ok19 = check_int("trim no-op length", str.length(str.trim("no-op")), "5")
  let ok20 = check("trim one side only", str.concat("<", str.concat(str.trim("x "), ">")), "<x>")

  // ---- replace ----
  let ok21 = check("replace all", str.replace("a?b?c", "?", "!"), "a!b!c")
  let ok22 = check("replace non-overlapping", str.replace("aaa", "aa", "b"), "ba")
  let ok23 = check("replace absent", str.replace("hello", "z", "q"), "hello")
  let ok24 = check("replace empty old", str.replace("ab", "", "X"), "ab")
  let ok25 = check("replace whole string", str.replace("same", "same", ""), "")

  // ---- upper / lower (ASCII only) ----
  let ok26 = check("upper", str.upper("hello World 42"), "HELLO WORLD 42")
  let ok27 = check("lower", str.lower("MiXeD Case 42"), "mixed case 42")
  let ok28 = check_int("upper non-ascii length", str.length(str.upper(str.concat("ok", str.chr(200)))), "3")
  let ok29 = check_int("upper non-ascii byte passthrough", str.char_at(str.upper(str.chr(200)), 0), "200")

  // ---- pad_start / pad_end ----
  let ok30 = check("pad_start", str.concat("'", str.concat(str.pad_start("42", 5, '0'), "'")), "'00042'")
  let ok31 = check("pad_end", str.concat("'", str.concat(str.pad_end("42", 5, '.'), "'")), "'42...'")
  let ok32 = check_int("pad_start n < len", str.length(str.pad_start("toolong", 3, '0')), "7")
  let ok33 = check_int("pad_end n == len", str.length(str.pad_end("five!", 5, '.')), "5")
  let ok34 = check("pad_start empty", str.concat("'", str.concat(str.pad_start("", 3, 'x'), "'")), "'xxx'")

  // ---- parse_float (Option): want is the from_float rendering,
  // "none" for the None cases ----
  let ok35 = check("parse_float simple", match str.parse_float("3.5") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "3.5")
  let ok36 = check("parse_float exponent", match str.parse_float("-2.5e2") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "-250")
  let ok37 = check("parse_float surrounding ws", match str.parse_float("  7.25  ") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "7.25")
  let ok38 = check("parse_float garbage", match str.parse_float("abc") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "none")
  let ok39 = check("parse_float empty", match str.parse_float("") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "none")
  let ok40 = check("parse_float trailing garbage", match str.parse_float("3.5x") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "none")
  let ok41 = check("parse_float no dot", match str.parse_float("3") {
    Some(f) -> str.from_float(f)
    None -> "none"
  }, "3")

  // ---- from_float ----
  let ok42 = check("from_float 1.5", str.from_float(1.5), "1.5")
  let ok43 = check("from_float %g trims", str.from_float(0.1 + 0.2), "0.3")
  let ok44 = check("from_float negative", str.from_float(-2.25), "-2.25")
  let ok45 = check("from_float exponent form", str.from_float(1000000.0), "1e+06")
  let ok46 = check("from_float integral", str.concat("[", str.concat(str.from_float(3.0), "]")), "[3]")

  // ---- from_base / to_base ----
  let ok47 = check_int("from_base hex", str.from_base("ff", 16), "255")
  let ok48 = check_int("from_base hex uppercase", str.from_base("FF", 16), "255")
  let ok49 = check_int("from_base binary", str.from_base("1010", 2), "10")
  let ok50 = check_int("from_base octal", str.from_base("777", 8), "511")
  let ok51 = check_int("from_base zero", str.from_base("0", 16), "0")
  let ok52 = check_int("from_base bad digit", str.from_base("xyz", 16), "-1")
  let ok53 = check_int("from_base digit out of base", str.from_base("2", 2), "-1")
  let ok54 = check_int("from_base empty", str.from_base("", 16), "-1")
  let ok55 = check_int("from_base base 10 unsupported", str.from_base("10", 10), "-1")
  let ok56 = check("to_base hex", str.to_base(255, 16), "ff")
  let ok57 = check("to_base binary", str.to_base(10, 2), "1010")
  let ok58 = check("to_base octal", str.to_base(511, 8), "777")
  let ok59 = check("to_base zero", str.to_base(0, 2), "0")
  let ok60 = check("to_base -1 unsigned 48-bit", str.to_base(-1, 16), "ffffffffffff")
  let ok61 = check("to_base bad base", str.to_base(255, 10), "")
  let ok62 = check_int("base roundtrip", str.from_base(str.to_base(123456, 16), 16), "123456")
  let ok63 = check_int("base roundtrip -1 wraps", str.from_base(str.to_base(-1, 16), 16), "-1")

  let total = ok1 + ok2 + ok3 + ok4 + ok5 + ok6 + ok7 + ok8 + ok9 + ok10 +
              ok11 + ok12 + ok13 + ok14 + ok15 + ok16 + ok17 + ok18 + ok19 +
              ok20 + ok21 + ok22 + ok23 + ok24 + ok25 + ok26 + ok27 + ok28 +
              ok29 + ok30 + ok31 + ok32 + ok33 + ok34 + ok35 + ok36 + ok37 +
              ok38 + ok39 + ok40 + ok41 + ok42 + ok43 + ok44 + ok45 + ok46 +
              ok47 + ok48 + ok49 + ok50 + ok51 + ok52 + ok53 + ok54 + ok55 +
              ok56 + ok57 + ok58 + ok59 + ok60 + ok61 + ok62 + ok63
  if total == 63 {
    print("PASS")
  } else {
    print(str.concat("FAIL - ", str.concat(str.from_int(63 - total), " of 63 checks failed")))
  }
}