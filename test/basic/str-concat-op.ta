// test/basic/str-concat-op.ta — `a <> b` is string concat (Gleam spelling).
//
// `<>` is pure parse-level sugar (docs/ta-language-spec.md「运算符」): it
// desugars to the promised builtin str.concat, so this file deliberately has
// no `import str` — the sugar must work without one. Wrong operand types are
// a compile error, covered by test/compiler/concat-op-type-errors.ta; the
// AST shape by test/compiler/parser-ast.ta.
//
// Expected output: one "ok - ..." line per check, then "PASS".
// Binding assertions below: the harness only checks exit 0 + non-empty output,
// so without them a wrong-order desugar would print FAIL lines and still pass.
// expect-not: FAIL

fn check(label, got, want) {
  if str.eq(got, want) {
    print("ok - " <> label)
  } else {
    print("FAIL - " <> label <> ": got '" <> got <> "' want '" <> want <> "'")
  }
}

fn pair_up(a, b, c) {
  a <> b <> c
}

fn main() {
  let a = "abc"
  let b = "def"

  check("single", a <> b, "abcdef")
  check("left assoc chain", pair_up(a, "-", b), "abc-def")
  check("empty partner", "" <> a, "abc")
  check("both literals", "x" <> "y", "xy")
  check("call result operand", "n=" <> str.from_int(42), "n=42")
  check("binds tighter than ==", if (a <> b) == "abcdef" { "yes" } else { "no" }, "yes")
  check("pipe binds looser", a <> b |> str.length |> str.from_int, "6")
  check("in a match arm", match 1 { 1 -> "one" <> "!" }, "one!")

  print("PASS")
}