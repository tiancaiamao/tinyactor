// test/basic/option-lib.ta — Exercise the option standard library
// (lib/option.ta): map, bind, is_some, is_none, unwrap, unwrap_or,
// values. Both the Some and the None branch of every function is covered.
// Expected output:
//   4
//   0
//   2
//   0
//   no
//   true
//   false
//   false
//   true
//   IF-SOME
//   7
//   7
//   0
//   (1 3)
//   ()
//   PASS

import option

fn main() {
  // map: Some value transformed, None untouched
  print(option.unwrap_or(0, option.map(fn(x) { x * 2 }, Some(2))))  // 4
  print(option.unwrap_or(0, option.map(fn(x) { x * 2 }, None)))     // 0

  // bind: chain an option-returning fn onto Some; None passes through
  print(option.unwrap_or(0, option.bind(fn(x) { Some(x + 1) }, Some(1)))) // 2
  print(option.unwrap_or(0, option.bind(fn(x) { Some(x + 1) }, None)))    // 0
  print(option.unwrap_or("no", option.bind(fn(x) { None }, Some("no"))))  // no

  // is_some / is_none: booleans
  print(option.is_some(Some(1))) // true
  print(option.is_some(None))    // false
  print(option.is_none(Some(1))) // false
  print(option.is_none(None))    // true

  // bool predicates are usable bare in if conditions
  if option.is_some(Some(1)) {
    print("IF-SOME")
  } else {
    print("IF-NONE")
  }

  // unwrap: the Some value
  print(option.unwrap(Some(7))) // 7

  // unwrap_or: value or default
  print(option.unwrap_or(0, Some(7))) // 7
  print(option.unwrap_or(0, None))    // 0

  // values: strip None entries, keep Some payloads, order preserved
    print(option.values([Some(1), None, Some(3)])) // (1 3)
  print(option.values([None, None]))             // nil

  print("PASS")
}