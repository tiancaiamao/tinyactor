// test/basic/option-lib.ta — Exercise the option standard library
// (lib/option.ta): map, bind, is_some, is_none, or, unwrap, unwrap_or,
// values. Both the Some and the None branch of every function is covered.
// Expected output:
//   4
//   0
//   2
//   0
//   no
//   true
//   false
//   false
//   true
//   IF-SOME
//   7
//   7
//   0
//   7
//   7
//   0
//   (1 3)
//   nil
//   PASS

import "tinyactor:lib/option"

fn main() {
  // map: Some value transformed, None untouched
  print(option.unwrap_or(0, option.map(fn(x) { x * 2 }, option.Some(2))))  // 4
  print(option.unwrap_or(0, option.map(fn(x) { x * 2 }, option.None)))     // 0

  // bind: chain an option-returning fn onto Some; None passes through
  print(option.unwrap_or(0, option.bind(fn(x) { option.Some(x + 1) }, option.Some(1)))) // 2
  print(option.unwrap_or(0, option.bind(fn(x) { option.Some(x + 1) }, option.None)))    // 0
  print(option.unwrap_or("no", option.bind(fn(x) { option.None }, option.Some("no"))))  // no

  // is_some / is_none: booleans
  print(option.is_some(option.Some(1))) // true
  print(option.is_some(option.None))    // false
  print(option.is_none(option.Some(1))) // false
  print(option.is_none(option.None))    // true

  // bool predicates are usable bare in if conditions
  if option.is_some(option.Some(1)) {
    print("IF-SOME")
  } else {
    print("IF-NONE")
  }

  // unwrap: the Some value
  print(option.unwrap(option.Some(7))) // 7

  // unwrap_or: value or default
  print(option.unwrap_or(0, option.Some(7))) // 7
  print(option.unwrap_or(0, option.None))    // 0

  // or: the first Some wins, a None falls back
  print(option.unwrap(option.or(option.Some(7), option.Some(8)))) // 7
  print(option.unwrap(option.or(option.None, option.Some(7))))    // 7
  print(option.unwrap_or(0, option.or(option.None, option.None))) // 0

  // values: strip None entries, keep Some payloads, order preserved
    print(option.values([option.Some(1), option.None, option.Some(3)])) // (1 3)
  print(option.values([option.None, option.None]))             // nil

  print("PASS")
}