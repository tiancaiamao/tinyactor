// test/basic/encoding-lib.ta — encoding lib runtime contracts.
//
// base64 decode is padding-lenient: a trailing '=' run of at most two is
// stripped, but a longer run ("x===") or an inner '=' ("TQ=Q") is an
// error. Tail groups of 2/3 chars produce 1/2 bytes. hex takes either
// case; percent decoding is strict about %XX and does not map '+' to
// space.
// expect: PASS

import encoding
import result

fn t(name, got, want) {
  if got == want {
    print(str.concat(name, " ok"))
  } else {
    print(str.concat(name, " FAIL"))
  }
}

fn terr(name, r) {
  if result.is_err(r) {
    print(str.concat(name, " ok"))
  } else {
    print(str.concat(name, " FAIL"))
  }
}

fn main() {
  // base64 round-trip and quad decode
  t("enc", encoding.encode("Mao"), "TWFv")
  t("b64-quad", result.unwrap_or("?", encoding.decode("TWFv")), "Mao")
  // padding-lenient tails: TQ== is one byte, TWE= is two, TWE (no pad)
  // decodes to the same two bytes
  t("b64-pad2", result.unwrap_or("?", encoding.decode("TQ==")), "M")
  t("b64-tail3", result.unwrap_or("?", encoding.decode("TWE=")), "Ma")
  t("b64-tail2", result.unwrap_or("?", encoding.decode("TWE")), "Ma")
    // error cases: over-padded run, inner '=', padding that does not
  // complete a quad
  terr("b64-overpad", encoding.decode("x==="))
  terr("b64-inner", encoding.decode("TQ=Q"))
  terr("b64-badpad", encoding.decode("TQ="))
  // base64url alphabet excludes '+'
  terr("url-alphabet", encoding.url_decode("TQ+="))
  // hex: either case, error on non-hex
  t("hex", result.unwrap_or("?", encoding.hex_decode("4D616F")), "Mao")
  t("hexenc", encoding.hex_encode("Mao"), "4d616f")
  terr("hex-bad", encoding.hex_decode("zz"))
  // percent: %XX decoded, '+' kept literally, strict validation
  t("pct", result.unwrap_or("?", encoding.percent_decode("a%20b%2B")), "a b+")
  t("pctenc", encoding.percent_encode("a b+"), "a%20b%2B")
    terr("pct-bad", encoding.percent_decode("a%ZZ"))
  print("PASS")
}