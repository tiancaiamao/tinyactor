// test/basic/use-basic.ta — positive runtime tests for the `use` block-level
// desugaring: `use x <- expr; rest` compiles to the plain call
// `(expr (lambda (x) rest))` — the RHS is itself the continuation consumer
// (Gleam-style; no `bind` name is involved). Covers: single binding, chained
// use, discard (use <-), use after let, and a multi-statement body after use.
// Expected output: three parser results, then "PASS"

// Minimal Maybe-style parser combinator result: ('ok v . i) or nil
fn bind(p, f) {
  fn(s, i) {
    let r = p(s, i)
    if null?(r) {
      nil
    } else {
      let v = car(cdr(r))
      let j = cdr(cdr(r))
      let fr = f(v)
      fr(s, j)
    }
  }
}

fn ret(v) {
  fn(s, i) { cons('ok, cons(v, i)) }
}

// binder: wraps a plain parser so it can be consumed by `use` —
// `use x <- seq(p); rest` desugars to seq(p)(lambda(x) rest)
fn seq(p) {
  fn(k) { bind(p, k) }
}

// parser that consumes exactly one occurrence of character c
fn take_char(c) {
  fn(s, i) {
    if i < str.length(s) {
      if str.char_at(s, i) == c { cons('ok, cons(c, i + 1)) } else { nil }
    } else {
      nil
    }
  }
}

fn parse_two() {
  use k <- seq(take_char('a'))
  use v <- seq(take_char('b'))
  ret(cons(k, cons(v, nil)))
}

fn parse_discard() {
  use <- seq(take_char('x'))
  ret(42)
}

fn parse_after_let() {
  let prefix = 1
  use k <- seq(take_char('a'))
  use v <- seq(take_char('b'))
  ret(cons(prefix, cons(k, cons(v, nil))))
}

fn parse_multi_stmt() {
  use k <- seq(take_char('a'))
  ret(cons(k, nil))
  ret(cons(k, cons(k, nil)))
}

// use(...) must stay an ordinary function call: is_use_form classifies by
// the distinct (use . use) dotted-pair head, so a call at block start is
// never desugared.
fn use(x, y) { x + y }
fn block_head_call() {
  use(1, 2)          // 2-arg call at block start
  use(10, 20)        // call in mid-block
  use(30, 12)        // last expr is the implicit return value: 42
}

// A function literally named use-bind must not be mistaken for the internal
// binding marker (whose head is a dotted pair, never a symbol).
fn use-bind(a, b) { a * b }
fn sentinel_call() {
  use-bind(3, 5)     // ordinary call, not desugared: 15
}

fn main() {
  let r1 = parse_two()
  print(r1("ab", 0))          // (ok (97 98) . 2)
  let r2 = parse_discard()
  print(r2("xy", 0))          // (ok 42 . 1)
  let r3 = parse_after_let()
  print(r3("ab", 0))          // (ok (1 97 98) . 2)
  let r4 = parse_multi_stmt()
  print(r4("a", 0))           // (ok (97 97) . 1)
        print(block_head_call())    // 42
  print(sentinel_call())      // 15
  print("PASS")
}