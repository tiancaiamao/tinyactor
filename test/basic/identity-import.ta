// identity-import.ta — identity 形态 import（E2 契约，docs/modules.md）。
//
// `import "<identity>:<path>"` 的唯一解析机制是机械拼接
// vendor/<identity>/<path>.ta。发行版自身的模块也可以用 identity 全名拼写：
// `"github.com/tiancaiamao/tinyactor:lib/json"` 经 vendor 符号链接
// （vendor/github.com/tiancaiamao/tinyactor → 仓库根）命中 lib/json.ta，
// 与裸名 `import json` 是同一个单元。
//
// 无 `as` 时别名取名字的末段（…:lib/json → json），因此正文里的引用写法
// 与裸名版完全一致（json.parse / json.write）。
//
// 本文件同时进 corpus 台（test/backend/run_corpus.sh 先经
// tools/expand_imports.py 展开 import 树再喂 lisp 管线），所以它也是
// 「展开器认得 identity 形 import」的守卫：展开器漏掉这行，输出里会残留
// import 形、dotted 调用不会被解析掉，tavm 与 tinyactor 的输出当场分叉
// （corpus 行的 status 会从 ok 变 driver-error/mismatch）。
//
// expect: PASS

import str
import "github.com/tiancaiamao/tinyactor:lib/json"

fn main() {
  // 无 `as`：别名取末段，json.* 直接可用
  let doc = json.parse("{\"b\":1,\"a\":[2,3]}")
  let text = json.write(doc)
  print(text)
  if str.eq(text, "{\"a\":[2,3],\"b\":1}") {
    print("PASS identity-import")
  } else {
    print("FAIL identity-import")
    1 / 0
  }
}