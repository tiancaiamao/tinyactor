// Phase 1 test: ping-pong actor message passing
// Expected output: ping done\npong done\nall done

// Ping: the request message. The tag is a constructor and the field carries
// the sender the reply is addressed to; the reply itself is the bare 'pong
// symbol (a message with no payload needs no shape).
type Ping {
  Ping(from)
}

fn ping(n, pong_pid) {
  if n == 0 {
    print("ping done")
    send(pong_pid, 'stop)
  } else {
    send(pong_pid, Ping(self()))
    match recv() {
      'pong -> ping(n - 1, pong_pid)
    }
  }
}

fn pong() {
  match recv() {
    'stop -> print("pong done")
    Ping(sender) -> {
      send(sender, 'pong)
      pong()
    }
  }
}

fn main() {
  let pong_pid = spawn('pong)
  let ping_pid = spawn(fn { ping(100, pong_pid) })
  let ref = monitor(ping_pid)
    match recv() {
    [DOWN, r, pid, reason] -> print("all done")
  }
}