// Test: multithread-msg
// Purpose: Verify message CONTENT survives the heap-fragment
//          send/recv roundtrip (frag_copy → val_deep_copy).
//          Exercises symbol/string/int crossing process heaps.
// Expected output: PASS

import "tinyactor:lib/str"

// Hello: the cross-heap message under test — a symbol, a string and an int in
// one declared record, so each heap class crosses the copy with its own slot.
type Hello {
  Hello(tag, text, n)
}

fn receiver() {
  match recv() {
    Hello(tag, text, n) -> {
      if tag != 'hello {
        print("FAIL: symbol")
      } else if str.eq(text, "world") {
        if n == 42 {
          print("PASS")
        } else {
          print("FAIL: int")
        }
      } else {
        print("FAIL: string")
      }
    }
    _ -> print("FAIL: pattern")
  }
}

fn main() {
  let b = spawn(fn { receiver() })
  send(b, Hello('hello, "world", 42))
}