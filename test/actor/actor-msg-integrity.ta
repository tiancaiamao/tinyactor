// Test: actor-msg-integrity
// Purpose: Regression test for #232 — a message copy that exactly fit the
//          arena consumed the boundary headroom mid-opcode, and the next
//          boundary's dead-acc spill wrote into the live heap, corrupting
//          messages or leaving main blocked on monitor DOWN. Verifies every
//          message's shape and that the drain + wakeup complete.
// Structure (seed, K/M, plens, spawn order) is the nightly multiset driver
// that reproduced the bug at ~30%/run before the fix; the checks add no
// heap allocation in the receive loop so the racing window is preserved.
// Expected output: done
// expect: done
// expect-not: BAD
// multiset harness seed=12683679422205 K=4 M=25 order=[3, 0, 1, 2] plens=[11, 20, 11, 13]
// hand-maintained: the multiset harness that generated it went with P8
// (docs/kernel-fuzzing-design.md §11); edit deliberately, keep the plens
import "tinyactor:lib/str"

// The three mailbox shapes of this test, one declaration each: the
// collector's message total, a worker's start-up config, one worker report.
// Declared records instead of hand-built cons nests — one shape, one
// declaration, so each receive matches its own shape exhaustively.
type Count {
  Count(total)
}

type Cfg {
  Cfg(cp, wid, m, plen)
}

type Report {
  Report(wid, seq, payload)
}

fn collect_loop(i, n) {
  if i == n {
    print("drained")
  } else {
    match recv() {
      Report(wid, seq, _) -> {
        print(str.concat(str.from_int(wid), str.concat(" ", str.from_int(seq))));
        if wid < 0 || wid > 3 || seq < 0 || seq > 24 {
          print("BAD")
        };
        collect_loop(i + 1, n)
      }
    }
  }
}

// Count(total): drain total messages, print one "<wid> <seq>" line each
// (no sorting in TA, §7.3), return
fn collector() {
  match recv() {
    Count(total) -> collect_loop(0, total)
  }
}

// fresh deep payload per message: send deep-copies it,
// collector drops it (§7.0 W-msg shape)
fn payload(n, acc) {
  if n == 0 {
    acc
  } else {
    payload(n - 1, cons(n, acc))
  }
}

fn wloop(cp, wid, s, m, plen) {
  if s == m {
    0
  } else {
    send(cp, Report(wid, s, payload(plen, nil)))
    wloop(cp, wid, s + 1, m, plen)
  }
}

// Cfg(cp, wid, m, plen) starts the worker (spawn is zero-arg, R3).
fn worker() {
  match recv() {
    Cfg(cp, wid, m, plen) -> wloop(cp, wid, 0, m, plen)
  }
}

fn main() {
  let cp = spawn(collector)
  send(cp, Count(100))
  let w3 = spawn(worker)
  send(w3, Cfg(cp, 3, 25, 13))
  let w0 = spawn(worker)
  send(w0, Cfg(cp, 0, 25, 11))
  let w1 = spawn(worker)
  send(w1, Cfg(cp, 1, 25, 20))
  let w2 = spawn(worker)
  send(w2, Cfg(cp, 2, 25, 11))
  let ref = monitor(cp)
  recv();
  print("done")
}
