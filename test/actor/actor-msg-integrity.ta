// Test: actor-msg-integrity
// Purpose: Regression test for #232 — a message copy that exactly fit the
//          arena consumed the boundary headroom mid-opcode, and the next
//          boundary's dead-acc spill wrote into the live heap, corrupting
//          messages or leaving main blocked on monitor DOWN. Verifies every
//          message's shape and that the drain + wakeup complete.
// Structure (seed, K/M, plens, spawn order) is the nightly multiset driver
// that reproduced the bug at ~30%/run before the fix; the checks add no
// heap allocation in the receive loop so the racing window is preserved.
// Expected output: done
// expect: done
// expect-not: BAD
// multiset harness seed=12683679422205 K=4 M=25 order=[3, 0, 1, 2] plens=[11, 20, 11, 13]
// generated by tools/kernfuzz/multiset.py — do not edit
import str

fn collect_loop(i, n) {
  if i == n {
    print("drained")
  } else {
    let msg = recv();
    let wid = car(msg);
    let seq = car(cdr(msg));
    print(str.concat(str.from_int(wid), str.concat(" ", str.from_int(seq))));
    if wid < 0 || wid > 3 || seq < 0 || seq > 24 {
      print("BAD")
    };
    collect_loop(i + 1, n)
  }
}

// first message = [total]; drain total messages, print one
// "<wid> <seq>" line each (no sorting in TA, §7.3), return
fn collector() {
  let cfg = recv()
  collect_loop(0, car(cfg))
}

// fresh deep payload per message: send deep-copies it,
// collector drops it (§7.0 W-msg shape)
fn payload(n, acc) {
  if n == 0 {
    acc
  } else {
    payload(n - 1, cons(n, acc))
  }
}

fn wloop(cp, wid, s, m, plen) {
  if s == m {
    0
  } else {
    send(cp, cons(wid, cons(s, payload(plen, nil))))
    wloop(cp, wid, s + 1, m, plen)
  }
}

// first message = [cp, wid, m, plen] (spawn is zero-arg, R3)
fn worker() {
  let cfg = recv()
  wloop(car(cfg), car(cdr(cfg)), 0, car(cdr(cdr(cfg))), car(cdr(cdr(cdr(cfg)))))
}

fn main() {
  let cp = spawn('collector)
  send(cp, cons(100, nil))
  let w3 = spawn('worker)
  send(w3, cons(cp, cons(3, cons(25, cons(13, nil)))))
  let w0 = spawn('worker)
  send(w0, cons(cp, cons(0, cons(25, cons(11, nil)))))
  let w1 = spawn('worker)
  send(w1, cons(cp, cons(1, cons(25, cons(20, nil)))))
  let w2 = spawn('worker)
  send(w2, cons(cp, cons(2, cons(25, cons(11, nil)))))
  let ref = monitor(cp)
  recv();
  print("done")
}
