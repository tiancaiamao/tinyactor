// A sha256 handle handed to other actors.
//
// The handle is a plain value (an opaque slot handle), so sending it
// copies the value — NOT the digest context. Both sides may finalise
// it; the second final must find the context already consumed and
// report "no digest" instead of freeing it twice (the old handle-a-Bytes
// design deep-copied the context pointer, so the second final was a
// double free).
//
// Two scenarios:
//   1. transfer  — the worker finalises, the sender's final is inert;
//   2. race      — eight actors finalise the same handle at once:
//                  exactly one digest, the rest nil, nothing freed twice.
//
// expect: PASS
// expect-not: FAIL

import sha256
import option
import str

// worker: take the handle, hash a block, finalise it.
fn worker() {
  let h = recv()
  match h {
    Some(x) -> {
      let _ = sha256.update(x, "abc")
      match sha256.final(x) {
        None -> print("worker: no digest")
        Some(s) -> print(str.concat("worker: ", s))
      }
    }
    None -> print("worker: no handle")
  }
}

// racer: finalise the handle, report the outcome to the collector.
fn racer() {
  let cfg = recv()
  let cp = car(cfg)
  let h = car(cdr(cfg))
  match sha256.final(h) {
    None -> send(cp, 'nil)
    Some(_) -> send(cp, 'some)
  }
}

// collector: count how many racers got a digest.
fn count_loop(n, digests) {
  if n == 0 {
    if digests == 1 {
      print("PASS")
    } else {
      print(str.concat("FAIL - digests: ", str.from_int(digests)))
    }
  } else {
    let m = recv()
    let d = if m == 'some { digests + 1 } else { digests }
    count_loop(n - 1, d)
  }
}

fn collector() {
  let n = recv()
  count_loop(n, 0)
}

// spawn_all: spawn n racers, each with its own copy of the handle.
fn spawn_all(n, cp, h) {
  if n == 0 {
    nil
  } else {
    let w = spawn('racer)
    send(w, cons(cp, cons(h, nil)))
    spawn_all(n - 1, cp, h)
  }
}

fn main() {
  // 1. transfer: the worker consumes the context, the sender must not.
  match sha256.new() {
    None -> print("FAIL - no context")
    Some(h) -> {
      let w = spawn('worker)
      send(w, Some(h))
      let ref = monitor(w)
      let _ = recv()
      match sha256.final(h) {
        None -> print("PASS")
        Some(_) -> print("FAIL - the context was finalised twice")
      }
    }
  }

  // 2. race: eight actors finalise the same handle at once.
  match sha256.new() {
    None -> print("FAIL - no context")
    Some(h) -> {
      let cp = spawn('collector)
      send(cp, 8)
      let _ = spawn_all(8, cp, h)
      let ref2 = monitor(cp)
      let _ = recv()
    }
  }
}