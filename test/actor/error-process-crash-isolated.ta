// Test: error-process-crash-isolated
// Purpose: Process crashes with division by zero. Verifies:
//          1. Crash doesn't affect other processes
//          2. Monitor delivers DOWN notification
//          3. Other process can continue normally
// Expected output: worker crashed\nsurvived

fn crash_worker(n) {
  if n == 0 {
    1 / 0
  } else {
    crash_worker(n - 1)
  }
}

// CrashNote: what the observer is told about the crashed worker. A declared
// record with named slots, not a hand-built [DOWN, ref, pid, reason] nest
// (four different types cannot live in one homogeneous list, issue #80).
type CrashNote {
  CrashNote(ref, pid, reason)
}

fn observer() {
  match recv() {
    CrashNote(ref, pid, reason) -> print("worker crashed")
    _ -> print("unexpected")
  }
}

fn main() {
  let crasher_pid = spawn(fn { crash_worker(50) })
  let obs_pid = spawn('observer)
  let ref = monitor(crasher_pid)
  send(obs_pid, CrashNote(ref, crasher_pid, 'divzero))
  send(self(), 'hello)
  recv()
  print("survived")
}