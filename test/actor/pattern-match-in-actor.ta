// Test: pattern-match-in-actor
// Purpose: Actor uses pattern matching in its main recv loop.
//          Tests match + recv integration under concurrent execution.
// Expected output: pong\nping\ndone

// Ping: the request message — the tag 'ping becomes a constructor carrying
// its sender, so the request no longer rides on a (symbol . pid) cons pair.
type Ping {
  Ping(from)
}

fn server() {
  match recv() {
    Ping(from) -> {
      print("pong")
      send(from, 'pong)
      server()
    }
    'stop -> print("done")
  }
}

fn client(server_pid) {
  send(server_pid, Ping(self()))
  match recv() {
    'pong -> {
      print("ping")
      send(server_pid, 'stop)
    }
  }
}

fn main() {
  let srv = spawn('server)
  spawn(fn { client(srv) })
  let ref = monitor(srv)
  recv()
}