// Test: multithread-basic
// Purpose: Verify heap-fragment message passing between actors
//          running on multiple worker threads. Three actors exchange
//          messages of different types (string, integer, symbol) and
//          collect results. The message envelope is a declared record,
//          proving that nested structures survive the fragment
//          deep-copy intact.
// Expected output: PASS

// Ask: main's request — who to answer, and the tagged value to echo back.
// Echo: the worker's answer — its own name beside the tag and the value.
// Declared records: the slots hold three different types (issue #80).
type Ask {
  Ask(from, tag, value)
}

type Echo {
  Echo(name, tag, value)
}

// Worker: receives Ask(from, tag, value), echoes back Echo(name, tag, value)
fn worker(my_name) {
  match recv() {
    Ask(from, tag, value) -> {
      send(from, Echo(my_name, tag, value))
      worker(my_name)
    }
    'stop -> 'ok
  }
}

fn main() {
  // Spawn 3 workers
  let w1 = spawn(fn { worker('alpha) })
  let w2 = spawn(fn { worker('beta) })
  let w3 = spawn(fn { worker('gamma) })

  // Send different value types: string, integer, symbol
  send(w1, Ask(self(), 'string, "hello"))
  send(w2, Ask(self(), 'integer, 42))
  send(w3, Ask(self(), 'symbol, 'world))

  // Collect all 3 replies (order is non-deterministic in MT)
  let r1 = recv()
  let r2 = recv()
  let r3 = recv()

  // Print all replies to prove fragment passing works
  print(r1)
  print(r2)
  print(r3)

  // Cleanup
  send(w1, 'stop)
  send(w2, 'stop)
  send(w3, 'stop)

  print("PASS")
}