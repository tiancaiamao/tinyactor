// Test: actor-selective-recv
// Purpose: Actor with selective receive — skips messages that don't
//          match, leaves them for later. Tests mailbox behavior when
//          messages are consumed non-FIFO (selective recv pattern).
//          This is an advanced Phase 2 pattern.
// Expected output: got important\nalso got 99

// Msg: what the processor's mailbox carries. A declared ADT instead of
// ['info, n] cons nests, so the selective receive matches named shapes.
type Msg {
  Info(v)
  Important(v)
  Stop
}

fn processor() {
  match recv() {
    Important(v) -> {
      print("got important")
      processor()
    }
    Info(v) -> {
      if v == 99 {
        print("also got 99")
      } else {
        processor()
      }
    }
    Stop -> 'done
  }
}

fn main() {
  let pid = spawn(processor)
  send(pid, Info(1))
  send(pid, Info(2))
  send(pid, Important(42))
  send(pid, Info(99))
  send(pid, Stop)
  let ref = monitor(pid)
  recv()
}