// test/actor/multithread-tls.ta — the tls module has no global state
// left (lib/tls.c: the SSL* lives in each handle's payload, no slot
// table / handshake list / module lock), but the module is still driven
// from many worker threads at once: concurrent SSL_connect handshakes,
// interleaved errno writes and closes must stay independent — a shared
// anything would show up as a failed handshake, a wrong echo or a
// crash.
//
// The endpoint comes from TA_TLS_TEST=host:port (the openssl s_server
// -rev harness in test/run_tls_tests.sh). Without it the test reports
// itself skipped and stays green.
//
// 8 actors on 8 workers connect, write one line, read the reversed
// echo back and close, over and over: a shared payload shows up as a
// failed handshake, a wrong echo or a crash.
//
// The race window is a few instructions wide, so a plain build rarely
// lands it — ThreadSanitizer is the detector that reports it every
// run. This test is the stress side of that pair.
//
// expect: PASS

import "tinyactor:lib/os"
import "tinyactor:lib/result"
import "tinyactor:lib/str"
import "tinyactor:lib/tls"
import "tinyactor:lib/tcp"
import "tinyactor:lib/option"

// Endpoint: the host and port TA_TLS_TEST names. A declared record: two
// fields with different jobs get their own projection.
type Endpoint {
  Endpoint(host, port)
}

fn endpoint_host(e) {
  match e {
    Endpoint(host, _) -> host
  }
}

fn endpoint_port(e) {
  match e {
    Endpoint(_, port) -> port
  }
}

// parse_host_port: split "host:port" on the colon, None when there is none.
fn parse_host_port(spec) {
  let i = str.index_of(spec, ":")
  if i < 0 {
    option.None
  } else {
    option.Some(Endpoint(str.substr(spec, 0, i), str.to_int(str.substr(spec, i + 1, str.length(spec) - i - 1))))
  }
}

// one_round: connect, write, read the reversed echo, close. Returns ""
// when the round was clean, otherwise the failure reason.
fn one_round(host : String, port : Int) -> String {
  match tls.connect(host, port, 5000) {
    result.Err(tcp.IoErr(e)) -> str.concat("connect: errno ", str.from_int(e))
    result.Err(_) -> "connect: error"
    result.Ok(c) -> {
      let reason = match tls.write(c, "hello-tls\n") {
        result.Ok(n) ->
          if n == 10 {
                        match tls.read(c, 4096) {
              result.Ok(r) -> match r {
                option.Some(s) ->
                  if str.eq(s, "slt-olleh\n") {
                    ""
                  } else {
                    str.concat("echo: got ", s)
                  }
                option.None -> "read: eof"
              }
              result.Err(tcp.IoErr(e)) -> str.concat("read: errno ", str.from_int(e))
              result.Err(_) -> "read: error"
            }
          } else {
            "write: short"
          }
        result.Err(tcp.IoErr(e)) -> str.concat("write: errno ", str.from_int(e))
        result.Err(_) -> "write: error"
      }
      tls.close(c)
      reason
    }
  }
}

// Report: a worker's final word to main — clean, or the reason it stopped.
type Report {
  Done
  Fail(reason)
}

// worker: rounds of connect/write/read/close; the first failure ends
// the run.
fn worker(main : Pid, host : String, port : Int, rounds : Int) {
  if rounds <= 0 {
    send(main, Done)
  } else {
    let reason = one_round(host, port)
    if reason == "" {
      worker(main, host, port, rounds - 1)
    } else {
      send(main, Fail(reason))
    }
  }
}

// collect: wait for one report per worker; returns the failure count.
fn collect(n : Int, fails : Int) -> Int {
  if n <= 0 {
    fails
  } else {
    match recv() {
      Done -> collect(n - 1, fails)
      Fail(reason) -> {
        print(str.concat("FAIL - ", reason))
        collect(n - 1, fails + 1)
      }
    }
  }
}

fn main() {
  match os.getenv("TA_TLS_TEST") {
    option.None -> {
      print("ok - tls concurrency scenario skipped (set TA_TLS_TEST=host:port)")
      print("PASS")
    }
    option.Some(spec) -> {
      match parse_host_port(spec) {
        option.None -> print("FAIL - TA_TLS_TEST needs host:port")
        option.Some(ep) -> {
          let me = self()
          let w1 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w2 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w3 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w4 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w5 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w6 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w7 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })
          let w8 = spawn(fn { worker(me, endpoint_host(ep), endpoint_port(ep), 20) })

          let fails = collect(8, 0)
          if fails == 0 {
            print("ok - 8 actors x 20 rounds, per-handle resources")
            print("PASS")
          } else {
            print(str.concat("FAIL - ", str.concat(str.from_int(fails), " rounds failed")))
          }
        }
      }
    }
  }
}
