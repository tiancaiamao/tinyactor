// Generic function type annotations: bare lowercase symbols in annotations
// are implicit type params (e.g. head(xs: MyList(a)) -> a is forall a.
// MyList(a) -> a). The same function must work on MyList(Int) and MyList(String).
// Both the plain (MyList(a)) and quoted (MyList('a)) forms must be accepted.
type MyList(a) { Nil; Cons(a, MyList(a)) }
type MyPair(a, b) { MkPair(a, b) }
type Color { Red; Green }

// Uppercase names are concrete user-defined types, not type params:
// to_str must stay Color -> Int (rejecting to_str(42) elsewhere).
fn to_str(c: Color) -> Int {
  match c { Red -> 1; Green -> 2 }
}

fn head(xs: MyList(a)) -> a {
  match xs {
    Cons(h, t) -> h
    // head of an empty list crashes (1 / 0, the same fail-fast contract as
    // option.unwrap): never is bottom, so the crash arm leaves `a` free and
    // head stays polymorphic over MyList(Int) / MyList(String).
    Nil -> 1 / 0
  }
}

// quoted type param form is equivalent
fn head2(xs: MyList('b)) -> 'b {
  match xs {
    Cons(h, t) -> h
    Nil -> 1 / 0
  }
}

// two type params, both implicit
fn second(p: MyPair(a, b)) -> b {
  match p {
    MkPair(x, y) -> y
  }
}

fn main() {
  let a = Cons(1, Nil)             // MyList(Int)
  let s = Cons("hi", Nil)          // MyList(String)
  print(head(a))                   // 1
  print(head(s))                   // hi
  print(head2(a))                  // 1
  print(head2(s))                  // hi
    print(second(MkPair(1, "x")))    // x
  print(second(MkPair("x", 1)))    // 1
  print(to_str(Red))               // 1
  print(to_str(Green))             // 2
  print("PASS")
}