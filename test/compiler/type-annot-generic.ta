// Generic function type annotations: bare lowercase symbols in annotations
// are implicit type params (e.g. head(xs: List(a)) -> a is forall a.
// List(a) -> a). The same function must work on List(int) and List(string).
// Both the plain (List(a)) and quoted (List('a)) forms must be accepted.
type List(a) { Nil; Cons(a, List(a)) }
type Pair(a, b) { MkPair(a, b) }

fn head(xs: List(a)) -> a {
  match xs {
    Cons(h, t) -> h
    Nil -> 0
  }
}

// quoted type param form is equivalent
fn head2(xs: List('b)) -> 'b {
  match xs {
    Cons(h, t) -> h
    Nil -> 0
  }
}

// two type params, both implicit
fn second(p: Pair(a, b)) -> b {
  match p {
    MkPair(x, y) -> y
  }
}

fn main() {
  let a = Cons(1, Nil)             // List(int)
  let s = Cons("hi", Nil)          // List(string)
  print(head(a))                   // 1
  print(head(s))                   // hi
  print(head2(a))                  // 1
  print(head2(s))                  // hi
  print(second(MkPair(1, "x")))    // x
  print(second(MkPair("x", 1)))    // 1
  print("PASS")
}