// Manual type annotations for ADT values.
// The List(int) parameter annotation is required (head's element type cannot
// be inferred from the recursive match alone), while Cons(1, Nil) is inferred
// as List(int) automatically. Nested composite annotations (List(List(int)))
// must also type-check.
type List(a) { Nil; Cons(a, List(a)) }

fn head(xs: List(int)) -> int {
  match xs {
    Cons(h, t) -> h
    Nil -> 0
  }
}

fn inner(xs: List(List(int))) -> int {
  match xs {
    Cons(h, t) -> 1
    Nil -> 0
  }
}

fn main() {
  let a = Cons(1, Nil)          // inferred: List(int)
  print(head(a))
  print(inner(Cons(Cons(1, Nil), Nil)))
  print("PASS")
}