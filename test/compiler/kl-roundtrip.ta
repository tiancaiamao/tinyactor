// Test: kl-roundtrip
// Purpose: the `.kl` writer's format gate (G-A in the .kl design doc) **and**
//          the TA reader's (C3):
//            write(read(write(T))) == write(T)   — text idempotence
//          for T = a real lowered tree, plus an explicit table of canonical
//          spellings (quote atoms, escapes, verbatim `begin`, the desugared
//          shapes `match` lowers into).
//          Text idempotence is what makes `.ta → .kl → .tabc` byte-identical
//          at this layer: the reader ignores layout, so any tree the writer
//          can spell and read back unchanged recompiles to the same bytecode
//          (the end-to-end proof is G-B — the two-process cmp gate in
//          test/run_bootstrap_tests.sh, C2 起跑在 driver 的 --emit-kl/--from-kl
//          接缝上)。
//
//          Corpus-wide `test/basic` is the design's G-B' and needs one
//          process per file for arena headroom (#308) — not this gate.
//
//          C3 起编译路径的 reader 是本仓编译器层的 kl.read/read_program
//          （编译器不再 dlopen lib/sexp.dylib）；lib/sexp.c 只留给前台工具与
//          运行期。两套 reader 并存期的纪律 = §5 的逐条等价断言：同一输入、
//          同一棵树、同一错误文本。`import sexp` 只服务这些断言。
// Expected output: "ok" only.
// expect-not: FAIL
import bytecode
import file
import kl
import lower-ast
import parser
import sexp
import str
import tokenizer

const MAX_COL = 78

fn p(cond) {
  if cond { print("ok") } else { print("FAIL") }
}

// ---------------------------------------------------------------- 1. 拼写表
// [input text, canonical text]: what write() must emit, and (second
// assertion per row) that the canonical text is a fixed point.  `input` is
// deliberately not always canonical: (quote nil) must *canonicalize* onto
// 'nil.  输入都短于 MAX_COL，所以这里只考拼写、不考断行（断行见 §2）。
fn spellings() {
  [
    // 引号原子一律写 'NAME
    ["'x", "'x"],
    ["(quote x)", "'x"],
    ["(quote foo.bar)", "'foo.bar"],
    // 裸 nil/true/false 是**值**，只有 `'` 下才是名字（C1 reader 规则），
    // 所以同一个 token 两种位置写法不同 —— 两条都必须幂等
    ["'nil", "'nil"],
    ["(quote nil)", "(quote nil)"],
    ["'true", "'true"],
    ["(quote true)", "(quote true)"],
    ["'false", "'false"],
    ["(quote false)", "(quote false)"],
    // 名字长得像数字的符号：非引号位置会被读成 int，所以必须走 'NAME
    ["'42", "'42"],
    // 非符号载荷保持显式形式：'42 读回来是**符号** 42，不是 int 42
    ["(quote 42)", "(quote 42)"],
    ["(quote -1)", "(quote -1)"],
    ["(quote \"s\")", "(quote \"s\")"],
    ["(quote (a b))", "(quote (a b))"],
    ["'(a b)", "(quote (a b))"],
    // 嵌套引号：载荷是 (quote <sym>) 这个 pair，非符号 -> 显式形式
    ["(quote 'nil)", "(quote 'nil)"],
    // 字符串转义：\n \t \r \\ \" 往返（承重：.kl 里嵌着源码字符串）
    ["(print \"a\\nb\\tc\\\\d\\\"e\")", "(print \"a\\nb\\tc\\\\d\\\"e\")"],
    ["(print \"源码 \\\"里\\\" 的引号\")", "(print \"源码 \\\"里\\\" 的引号\")"],
    // begin / receive 原样保留：折叠与 receive 脱糖都不是 writer 的事。
    // match 已在 lower 期脱糖（lower-ast.match_desugar），.kl 里不再出现
    // match 词形 —— 下两行钉的是脱糖后真实出现在 .kl 里的形态（字面量+
    // 通配臂、cons 模式臂，均由 --emit-kl 实测生成）。
    // 点对（improper list）：receive 模式仍是这个形态，writer 对点对的
    // 拼写保持通用（`cons(h, t)` 模式降成 `(h . t)`），尾是普通列表时没有点可写
    ["(pair . rest)", "(pair . rest)"],
    ["(a . (b c))", "(a b c)"],
    ["(a . nil)", "(a)"],
    ["(a . .)", "(a . .)"],
    ["'(pair . rest)", "(quote (pair . rest))"],
    ["(let (_m x) (if (eq? _m 3) 1 (if true 0 nil)))", "(let (_m x) (if (eq? _m 3) 1 (if true 0 nil)))"],
        ["(if (if (pair? x) (if true true)) (let (t (cdr x)) (let (h (car x)) h)) nil)", "(if (if (pair? x) (if true true)) (let (t (cdr x)) (let (h (car x)) h)) nil)"],
    ["(begin a b)", "(begin a b)"],
    ["(receive (('m a) (= a 1) nil))", "(receive (('m a) (= a 1) nil))"],
    ["(define f (lambda (a) a))", "(define f (lambda (a) a))"]
  ]
}

fn check_spellings(cs) {
  if pair?(cs) {
    let input = car(car(cs))
    let want = car(cdr(car(cs)))
    let parsed = sexp.parse(input)
    if int?(parsed) {
      print(str.concat("FAIL unreadable input: ", input))
    } else {
      let got = kl.write(car(parsed))
      p(got == want)
      // 逐字节不动点：写出来的文本再读再写，必须一模一样
      p(kl.write(car(sexp.parse(got))) == got)
      // 同一个输入喂 TA reader（C3 起编译路径用的那个）：同树、同拼写
      p(read_canon(input) == got)
      p(read_canon(got) == got)
      if got == want {
        nil
      } else {
        print(str.concat("  input: ", input))
        print(str.concat("  want:  ", want))
        print(str.concat("  got:   ", got))
      }
    }
    check_spellings(cdr(cs))
  } else {
    nil
  }
}

// ---------------------------------------------------------------- 2. 断行
// 超过 MAX_COL 的 form 按元素断行；断行**只是布局**，读回来必须是同一棵树，
// 再写一遍必须逐字节相同。断行文本不在此处逐字钉死（那是布局实现细节），
// 只要求：确实断了行 + 文本不动点 —— 真实语料的确定性由 §3 与 G-B 压住。
fn has_newline(s) {
  has_newline_from(s, 0, str.length(s))
}

fn has_newline_from(s, i, n) {
  if i >= n {
    false
  } else if str.char_at(s, i) == '\n' {
    true
  } else {
    has_newline_from(s, i + 1, n)
  }
}

fn long_forms() {
  [
    // match 臂里的调用把整棵树推过 MAX_COL（脱糖后的守卫臂展开形态，
    // --emit-kl 实测生成）
    "((let (_m xs) (if (if (pair? _m) (if true (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil))))) (let (g (car (cdr _m))) (let (h (car _m)) (if (> g 0) (print h) (if true (print \"other\") nil)))) (if true (print \"other\") nil))))",
    // receive 模式本身就很长
    "(receive (('http_timeout wpid nil) (= wpid w) (cons 'Err (cons 'TimedOut nil))))",
    // 深层嵌套的 lambda
    "(define length (lambda (xs) (if (null? xs) 0 (let (n (length (cdr xs))) (iadd n 1)))))",
    // 点对的尾长到装不下：`(h . tail)` 也必须能断行后读回
    "(define drop2-sum (lambda (xs) (let (_m xs) (if (eq? _m nil) 0 (if (if (pair? _m) (if true true)) (let (rest (cdr _m)) (let (a (car _m)) (sum rest))) nil)))))"
  ]
}

fn check_layout(text) {
  if str.length(text) <= MAX_COL {
    print(str.concat("FAIL layout case is not long: ", text))
  } else {
    let tree = car(sexp.parse(text))
    let once = kl.write(tree)
    p(has_newline(once))
    p(kl.write(car(sexp.parse(once))) == once)
  }
}

fn check_layouts(texts) {
  if pair?(texts) {
    check_layout(car(texts))
    check_layouts(cdr(texts))
  } else {
    nil
  }
}

// ---------------------------------------------------------------- 3. 真实树
// 每个文件压住一类承重形状（设计文档 §1.2 的样例）：
//   pattern-float-eq       match（脱糖后的 if/eq? 形态）+ (float "3.0") 调用
//   list-match-rest        cons 模式（lower 期已脱糖成 pair?/car/cdr 链）
//   sexp-basic             嵌了源码字符串的字符串（转义）
//   actor-closure-message  spawn/send/recv + 闭包 + 非 ASCII 字符串
//   use-basic              复合头调用（(seq ...) 当函数）
// 全是小文件：整轮跑在**一个** proc 里（arena 共享），大闭包留给 G-B。
fn corpus() {
  [
    "test/basic/pattern-float-eq.ta",
    "test/basic/list-match-rest.ta",
    "test/basic/sexp-basic.ta",
    "test/basic/actor-closure-message.ta",
    "test/basic/use-basic.ta"
  ]
}

// 与 driver 的前半程同路（tokenize → parse → lower）；G-A 只关心树。
fn lower_text(text) {
  lower-ast.lower_program(parser.parse(tokenizer.tokenize(text)))
}

fn check_file(path) {
  let text = file.read(path)
  if null?(text) {
    print(str.concat("FAIL no-read ", path))
  } else {
    let low = lower_text(text)
    if int?(low) {
      print(str.concat("FAIL lower ", path))
    } else {
      check_text(path, kl.write_program(low))
    }
  }
}

fn check_text(path, text) {
  let back = sexp.parse(text)
  if int?(back) {
    print(str.concat("FAIL reread ", str.concat(path, ": ")))
    print(str.concat("  ", sexp.err()))
  } else {
    let again = kl.write_program(back)
    p(again == text)
    if again == text {
      p(str.length(text) > 0)
    } else {
      print(str.concat("FAIL idempotence ", path))
    }
    // TA reader 读同一份**多行**文本（真实 lowered 树的全文）：同样逐字节重写
    match kl.read_program(text) {
      Err(msg) -> print(str.concat("FAIL ta-reread ", str.concat(path, msg)))
      Ok(forms) -> p(kl.write_program(forms) == text)
    }
  }
}

fn check_corpus(paths) {
  if pair?(paths) {
    check_file(car(paths))
    check_corpus(cdr(paths))
  } else {
    nil
  }
}

// ------------------------------------------- 4. 前奏文本（V5 的运行期半边）
// 运行期唯一经 C reader（sexp.parse）进来的前奏 = bytecode.lib_src()。它必须
// **不带引号**：引号下的 token 在 C reader 里按"读成名字"解释（'nil 是符号
// nil），哪天前奏要写"值 nil"就会静默变成符号。所以这条断言是引号规则的
// 护栏。（C1 里它在 test/kl-driver-roundtrip.ta 里，C2 随 G-B 搬家搬进这里。）
fn check_lib_src_preamble() {
  let s = bytecode.lib_src()
  p(str.length(s) > 0)
  p(str.length(str.replace(s, "'", "")) == str.length(s))
  // 同一段文本也走 TA reader（C3 起编译路径正是这么读前奏的）
  p(program_canon(s) == kl.write_program(sexp.parse(s)))
}

// ------------------------------------------------- 5. TA reader（C3/G-A）
// 编译路径的 reader 搬到编译器层后，两套 reader 的过渡期纪律是"逐条等价"：
// 同一输入 → 同一棵树（用规范文本比较）→ 同一错误文本（连 line/col 位置语义
// 都一样，因为 C reader 的 parse_fail 也是 "line L, col C: "）。

fn read_canon(text) {
  match kl.read(text) {
    Err(msg) -> str.concat("ERR ", msg)
    Ok(v) -> kl.write(v)
  }
}

fn program_canon(text) {
  match kl.read_program(text) {
    Err(msg) -> str.concat("ERR ", msg)
    Ok(forms) -> kl.write_program(forms)
  }
}

// 两套 reader 的等价表：C reader 的全部形态（空白/注释、`()` 与 `nil` 同形、
// 点对与"点进列表"、引号位置、字符串转义、int 拼法）。
fn reader_cases() {
  [
    ["(a b 42)", "(a b 42)"],
    ["  ( a   b )  ", "(a b)"],
    ["(+ 1 2) ; tail", "(+ 1 2)"],
    [";; head\n(a)", "(a)"],
    ["()", "nil"],
    ["(nil)", "(nil)"],
    ["nil", "nil"],
    ["true", "true"],
    ["false", "false"],
    ["'nil", "'nil"],
    ["-7", "-7"],
    ["+7", "7"],
    ["(42 . -1)", "(42 . -1)"],
    ["(a . (b c))", "(a b c)"],
    ["(a . nil)", "(a)"],
    ["(a . .)", "(a . .)"],
    ["(. b)", "(. b)"],
    ["(a . b)", "(a . b)"],
    ["(a . b c)", "ERR"],
    ["\"a\\nb\"", "\"a\\nb\""],
    ["\".kl\"", "\".kl\""],
    ["(quote (a b))", "(quote (a b))"],
    ["(print \"x\")", "(print \"x\")"]
  ]
}

fn check_reader_cases(cs) {
  if pair?(cs) {
    let input = car(car(cs))
    let want = car(cdr(car(cs)))
    let got = read_canon(input)
    if want == "ERR" {
      p(str.length(got) > 4)
    } else {
      p(got == want)
      // 同一输入下 C reader 必须给出**同一个**规范文本（没有第二套读法）
      p(read_canon(input) == kl.write(car(sexp.parse(input))))
    }
    check_reader_cases(cdr(cs))
  } else {
    nil
  }
}

// 响亮失败表：输入 / 期望消息。消息与 C reader 的 sexp.err() 逐字相同
//（包括 line/col），所以"严格"不是另一套语义，只是另一种失败姿势。
fn reader_errors() {
  [
    ["(a", "unbalanced '(' — missing ')'"],
    ["(a . b c)", "'.' tail must end the list"],
    ["(a .)", "unexpected ')'"],
    [")", "unexpected ')'"],
    ["'", "unexpected end of input"],
    ["\"abc", "unterminated string"],
    ["\"a\\q\"", "unknown escape in string"],
    ["140737488355328", "integer literal out of int48 range"],
    ["-140737488355329", "integer literal out of int48 range"],
    ["(a\n  (b", "unbalanced '(' — missing ')'"]
  ]
}

fn err_of(text) {
  match kl.read(text) {
    Err(msg) -> msg
    Ok(v) -> str.concat("NO-ERROR ", kl.write(v))
  }
}

fn check_reader_errors(cs) {
  if pair?(cs) {
    let input = car(car(cs))
    let want_tail = car(cdr(car(cs)))
    let got = err_of(input)
    p(str.length(got) > str.length(want_tail))
    p(ends_with(got, want_tail))
    // 同输入的 C reader 必须报同一句（对齐 lib/sexp.c 的 parse_fail）
    let bad = sexp.parse(input)
    p(int?(bad))
    p(sexp.err() == got)
    check_reader_errors(cdr(cs))
  } else {
    nil
  }
}

fn ends_with(s, tail) {
  let ns = str.length(s)
  let n = str.length(tail)
  if ns < n {
    false
  } else {
    ends_with_at(s, tail, ns - n, 0, n)
  }
}

fn ends_with_at(s, tail, off, i, n) {
  if i >= n {
    true
  } else if str.char_at(s, off + i) == str.char_at(tail, i) {
    ends_with_at(s, tail, off, i + 1, n)
  } else {
    false
  }
}

// 严格边界：read 只吃**一个** form（其后只允许空白/注释），read_program 吃整
// 份文件；空文本对前者是错、对后者是空程序。这两条 C reader 都没有对应形态
//（sexp.parse 只管"全部顶层 form"），所以单独断言，不放进等价表。
fn check_strict_edges() {
  p(str.length(read_canon("(a) (b)")) > 4)
  p(program_canon("(a) (b)") == "(a)\n\n(b)\n")
  p(program_canon("") == "")
  p(str.length(read_canon("")) > 4)
  p(read_canon("(a) ; tail\n") == "(a)")
  p(program_canon("; only a comment\n") == "")
  // int48 的上下界（+/- 同界；写得出就一定要读得回）
  p(read_canon("140737488355327") == "140737488355327")
  p(read_canon("-140737488355327") == "-140737488355327")
  // 有意的偏差（docs/kl-format.md §4）：int48 的真下界 -2^47 连绝对值都表示
  // 不出来，所以负界收在 -(2^47-1)（与 lib/json.ta 的 int_acc 同一条规则）；
  // C reader 用 strtoll 能多接受这一个值。这里把"读不回来"钉成断言。
  p(str.length(read_canon("-140737488355328")) > 4)
  // 词表上限：符号 255 / 整数字面量 31（与 lib/sexp.c 同界同消息）
  p(str.length(read_canon(repeat("a", 256))) > 4)
  p(read_canon(repeat("a", 255)) == repeat("a", 255))
  p(str.length(read_canon(repeat("9", 32))) > 4)
}

fn repeat(s, n) {
  if n <= 0 { "" } else { str.concat(s, repeat(s, n - 1)) }
}

fn main() {
  check_spellings(spellings())
  check_reader_cases(reader_cases())
  check_reader_errors(reader_errors())
  check_strict_edges()
  check_layouts(long_forms())
  check_corpus(corpus())
  check_lib_src_preamble()
  // 空程序 / 空表：writer 是 total 的
  p(kl.write_program(nil) == "")
  p(kl.write(nil) == "nil")
}