// Regression: a manual List(int) annotation must be enforced.
// Passing a List(string) value (built by inference) to head must be rejected —
// composite ADT annotations used to leak through unchecked.
type List(a) { Nil; Cons(a, List(a)) }

fn head(xs: List(int)) -> int {
  match xs {
    Cons(h, t) -> h
    Nil -> 0
  }
}

fn main() {
  let x = Cons("s", Nil)        // inferred: List(string)
  print(head(x))                // must be a type error
}