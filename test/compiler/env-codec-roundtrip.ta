// Test: env-codec-roundtrip
// Purpose: the signature cache's env codec — typecheck.env_forms /
//          typecheck.env_of_forms, the pair lib/bootstrap/modsig.ta uses to
//          carry type env entries between compiler runs as .kl text — must be
//          lossless: env_of_forms(env_forms(env)) == env, structurally.
//          env 条目是 EnvEntry 记录（Bind / Ctor / TypeDecl），所以断言要与
//          记录形状对得上：装载侧读回一条不同变体的条目同样是失败。
//
//          The assertion cannot go through kl.write: Ty lives in tuples and
//          the .kl spelling table has no tuple literal (a reader cannot invent
//          an arbitrary value — a tuple's size is a static operand). That
//          absence is exactly why this codec exists, so the check has to be a
//          deep structural comparison that also looks inside tuples.
//
//          Guarded because the codec's fallbacks hide errors on purpose
//          (ty_of_form yields t_never, env_of_form passes unknown shapes
//          through): a pattern that stops matching still compiles and runs,
//          and would only show up as silently weaker cross-module types.
// expect-not: FAIL
import "tinyactor:lib/bootstrap/typecheck" as typecheck
import "tinyactor:lib/option" as option
import "tinyactor:lib/str"

fn p(cond) {
  if cond { print("ok") } else { print("FAIL") }
}

// deep_eq: 结构相等 —— pair / tuple / int / string / symbol / nil。
// kl.write 用不上（Ty 是元组，文本层没有元组字面量），只能自己走一遍。
fn deep_eq(a, b) -> Bool {
  if pair?(a) {
    if pair?(b) { deep_eq(car(a), car(b)) && deep_eq(cdr(a), cdr(b)) } else { false }
  } else if tuple?(a) {
    if tuple?(b) && tuple-len(a) == tuple-len(b) {
      deep_eq_slots(a, b, 0, tuple-len(a))
    } else {
      false
    }
  } else if int?(a) {
    if int?(b) { a == b } else { false }
  } else if string?(a) {
    if string?(b) { a == b } else { false }
  } else if symbol?(a) {
    if symbol?(b) { a == b } else { false }
  } else {
    null?(a) && null?(b)
  }
}

fn deep_eq_slots(a, b, i, n) -> Bool {
  if i >= n {
    true
  } else {
    deep_eq(tuple-ref(a, i), tuple-ref(b, i)) && deep_eq_slots(a, b, i + 1, n)
  }
}

fn roundtrips(bindings) -> Bool {
  deep_eq(typecheck.env_of_forms(typecheck.env_forms(bindings)), bindings)
}

// 每种 Ty 一个值：codec 的 ty_of_form 是按 schema 逐字段解（Ty/Base 定 arity），
// 少覆盖一种变体就等于少一条「重新装载」的断言。
fn tys() {
  let base = tuple(typecheck.TyBase, typecheck.BInt)
  [
    base,
    tuple(typecheck.TyBase, tuple(typecheck.BName, option.Option)),
    tuple(typecheck.TyVar, 7, 1),
    tuple(typecheck.TyArrow, base, tuple(typecheck.TyVar, 2, 0)),
    tuple(typecheck.TyApp, 'List, cons(base, nil)),
    tuple(typecheck.TyApp, 'Map, cons(base, cons(tuple(typecheck.TyVar, 3, 0), nil))),
    tuple(typecheck.TyForall, cons(1, cons(2, nil)), tuple(typecheck.TyArrow, base, tuple(typecheck.TyVar, 1, 0)))
  ]
}

// 条目名字用 v0/v1/... —— EnvEntry 的 name 是符号，用 Int 当名字过不了 codec
// 的符号那一关。
fn entry_name_of(i) { str.to_sym(str.concat("v", str.from_int(i))) }

fn env_of_tys(ts, i) {
  if null?(ts) {
    nil
  } else {
    cons(typecheck.Bind(entry_name_of(i), car(ts)), env_of_tys(cdr(ts), i + 1))
  }
}

// 逐条 entry 跑一遍，失败时指出第几条 —— 整包 roundtrip 只给一个是/否，
// 定位还得靠这个
fn check_tys(ts, i) -> Bool {
  if null?(ts) {
    true
  } else {
    let ok = roundtrips(cons(typecheck.Bind(entry_name_of(i), car(ts)), nil))
    if ok {
      check_tys(cdr(ts), i + 1)
    } else {
      print(str.concat("FAIL ty ", str.from_int(i)))
      false
    }
  }
}

fn main() {
  p(check_tys(tys(), 0))
  // 所有变体一起走一趟（顺序、条数都要原样回来）
  p(roundtrips(env_of_tys(tys(), 0)))
  // 空 env
  p(roundtrips(nil))
  // Ctor 条目：与 Bind 的 ty 标签区分开（装载回来必须还是 Ctor）
  p(roundtrips(cons(typecheck.Ctor('P, tuple(typecheck.TyBase, typecheck.BInt)), nil)))
  // TypeDecl 条目：变体名表 + 变体字段表都要原样回来
  p(roundtrips(cons(typecheck.TypeDecl('Color, cons('Red, cons('Green, nil)), nil), nil)))
  // 三种 entry 混在一个 env 里
  let mixed = cons(typecheck.Bind('a, tuple(typecheck.TyBase, typecheck.BInt)),
               cons(typecheck.TypeDecl('Color, cons('Red, nil), nil),
               cons(typecheck.Ctor('P, tuple(typecheck.TyArrow, tuple(typecheck.TyBase, typecheck.BInt), tuple(typecheck.TyVar, 1, 0))), nil)))
    p(roundtrips(mixed))
  // 反例守卫：deep_eq 自己不会全 true（否则上面每条都是空断言）
  p(deep_eq(tuple(typecheck.TyBase, typecheck.BInt), tuple(typecheck.TyBase, typecheck.BFloat)) == false)
  p(deep_eq(tuple('Box, typecheck.BInt), tuple('Box, typecheck.BInt, typecheck.BInt)) == false)
  p(deep_eq(cons('a, nil), cons('b, nil)) == false)
  p(deep_eq(tuple(typecheck.TyVar, 1, 0), cons(typecheck.TyVar, cons(1, cons(0, nil)))) == false)
}