// Test: nested patterns that match whole variants are accepted by the
// exhaustiveness check (issue #396 counterpart of
// exhaustiveness-nested-errors.ta). A payload pattern covers its type when it
// is a binding/wildcard, or a constructor that is the only shape of its type
// (single-variant ADT, builtin Pair) with covering arguments.
type Opt { Some(a) None }
type Res { Ok(a) Err(b) }
type Buf { Buf(h : Int) }
type Step { Step(v : Opt, rest : Int) }

// Ok(v) / Err(e) — both payloads are bindings, so both variants are covered.
fn res_or(x : Res, d) -> Int {
  match x {
    Ok(v) -> v
    Err(e) -> d
  }
}

// Buf is the only variant of its type: Buf(h) is a whole-type match.
fn buf_len(b : Buf) -> Int {
  match b {
    Buf(h) -> h
  }
}

// Pair is a single-shape builtin, so Some(Pair(a, k)) covers Some.
fn some_pair(o : Opt) -> Int {
  match o {
    Some(Pair(a, k)) -> a
    None -> 0
  }
}

// The nesting the check can prove: bind the payload, then exhaust it one level
// down (Step is single-variant, its arguments are bindings).
fn step_opt(s : Step) -> Int {
  match s {
    Step(inner, rest) -> match inner {
      Some(v) -> v + rest
      None -> rest
    }
  }
}

fn main() {
  print(str.from_int(res_or(Ok(7), 0)))
  print(str.from_int(res_or(Err("x"), 8)))
  print(str.from_int(buf_len(Buf(9))))
  print(str.from_int(some_pair(None)))
  print(str.from_int(some_pair(Some(Pair(3, true)))))
  print(str.from_int(step_opt(Step(Some(4), 1))))
  print(str.from_int(step_opt(Step(None, 1))))
  print("PASS")
}