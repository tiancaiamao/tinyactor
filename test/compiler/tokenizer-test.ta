import "tinyactor:lib/bootstrap/tokenizer"

// 打一个 token：种类 + 便于人读的描述（定界符原样，其余带引号载荷）。
fn print_token(t) {
  print(tokenizer.tok_tag(t))
  print(tokenizer.tok_text(t))
}

fn print_tokens(toks) {
  if null?(toks) {
    print("PASS")
  } else {
    print_token(car(toks))
    print_tokens(cdr(toks))
  }
}

fn main() {
  let src = "fn add(x) { x + 1 }"
  let toks = tokenizer.tokenize(src)
  print_tokens(toks)
}
