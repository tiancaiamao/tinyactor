// Test: gc-mt-gcbench
// Purpose: Multi-process Boehm GC benchmark. Four workers each build a full
//          binary tree of depth 14 (2^14 - 1 = 16383 internal nodes) using
//          heap nodes, count the nodes, and send the count back to main.
//          Main sums the four results and verifies 4 * (2^14 - 1) = 65532.
//          Exercises per-process semispace GC under concurrent allocation.
// Expected output: all done

// Tree: a full binary tree node holding its two subtrees. A declared sum
// type (no two-slot cons pair: both slots are the same kind of thing).
type Tree {
  Leaf
  Node(left, right)
}

fn make_tree(depth) {
  if depth == 0 {
    Leaf
  } else {
    Node(make_tree(depth - 1), make_tree(depth - 1))
  }
}

fn count_nodes(tree) {
  match tree {
    Leaf -> 0
    Node(left, right) -> 1 + count_nodes(left) + count_nodes(right)
  }
}

fn worker(depth, main_pid) {
  let tree = make_tree(depth)
  let count = count_nodes(tree)
  send(main_pid, count)
}

fn main() {
  let main_pid = self()
  spawn(fn { worker(14, main_pid) })
  spawn(fn { worker(14, main_pid) })
  spawn(fn { worker(14, main_pid) })
  spawn(fn { worker(14, main_pid) })
  let a = recv()
  let b = recv()
  let c = recv()
  let d = recv()
  let total = a + b + c + d
  if total == 65532 {
    print("all done")
  } else {
    print("FAIL")
  }
}