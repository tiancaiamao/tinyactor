// Test: gc-cycle
// Purpose: GC must correctly trace complex object graphs that resemble
//          cycles. Pairs are immutable so true cycles cannot be built,
//          but closures can capture records that reference other closures,
//          creating multi-level heap graphs (closure -> node -> closure).
//          Verifies these near-cyclic structures survive GC intact.
// Expected output: done

fn build(n, acc) {
  if n == 0 {
    acc
  } else {
    build(n - 1, cons(n, acc))
  }
}

fn make_clos(v) {
  fn { v }
}

// Node: a value beside the closure that returns it — two slots with
// different roles, so a declared record rather than a cons pair.
type Node {
  Node(v, inner)
}

fn node_value(node) {
  match node {
    Node(v, _) -> v
  }
}

fn node_inner(node) {
  match node {
    Node(_, inner) -> inner
  }
}

// node = Node(v, closure-returning-v); a record that references a closure
fn make_node(v) {
  Node(v, make_clos(v))
}

// wrapper captures the node; calling it follows record -> closure
fn make_wrapper(node) {
  fn {
    node_value(node) + node_inner(node)()
  }
}

fn churn(n) {
  if n == 0 {
    nil
  } else {
    {
      [n, n + 1]
      churn(n - 1)
    }
  }
}

fn main() {
  // Long-lived list of 500 pairs
  let lst = build(500, nil)
  // Closures capturing the head and the middle of the list
  let mid = cdr(cdr(cdr(lst)))
  let f_head = fn { car(lst) }
  let f_mid = fn { car(mid) }
  // Near-cycle graph: wrapper closure -> node pair -> inner closure
  let node = make_node(21)
  let w = make_wrapper(node)

  // Churn heavily to trigger GC with all of the above live
  churn(2000)

  if f_head() == 1 {
    if f_mid() == 4 {
      if w() == 42 {
        print("done")
      } else {
        print("FAIL")
      }
    } else {
      print("FAIL")
    }
  } else {
    print("FAIL")
  }
}