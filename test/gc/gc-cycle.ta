// Test: gc-cycle
// Purpose: GC must correctly trace complex object graphs that resemble
//          cycles. Pairs are immutable so true cycles cannot be built,
//          but closures can capture pairs that reference other closures,
//          creating multi-level heap graphs (closure -> pair -> closure).
//          Verifies these near-cyclic structures survive GC intact.
// Expected output: done

fn build(n, acc) {
  if n == 0 {
    acc
  } else {
    build(n - 1, cons(n, acc))
  }
}

fn make_clos(v) {
  fn { v }
}

// node = (v . closure-returning-v); a pair that references a closure
fn make_node(v) {
  cons(v, make_clos(v))
}

// wrapper captures the node pair; calling it follows pair -> closure
fn make_wrapper(node) {
  fn {
    let inner = cdr(node)
    car(node) + inner()
  }
}

fn churn(n) {
  if n == 0 {
    nil
  } else {
    {
      cons(n, cons(n + 1, nil))
      churn(n - 1)
    }
  }
}

fn main() {
  // Long-lived list of 500 pairs
  let lst = build(500, nil)
  // Closures capturing the head and the middle of the list
  let mid = cdr(cdr(cdr(lst)))
  let f_head = fn { car(lst) }
  let f_mid = fn { car(mid) }
  // Near-cycle graph: wrapper closure -> node pair -> inner closure
  let node = make_node(21)
  let w = make_wrapper(node)

  // Churn heavily to trigger GC with all of the above live
  churn(2000)

  if f_head() == 1 {
    if f_mid() == 4 {
      if w() == 42 {
        print("done")
      } else {
        print("FAIL")
      }
    } else {
      print("FAIL")
    }
  } else {
    print("FAIL")
  }
}