// Test: gc-concurrent-stress
// Purpose: Stress concurrent GC across 4 worker processes with heavy pair allocation
//          and cross-process message passing containing heap-allocated pair data.
//          Workers send to all peers each iteration, exercising cross-process deep copy
//          interaction with per-process concurrent GC.
// Expected output: all done

fn churn(n) {
  if n == 0 {
    nil
  } else {
    cons(n, churn(n - 1))
  }
}

fn send_to_all(pids, msg) {
  match pids {
    nil -> 'done
    cons(pid, rest) -> {
      send(pid, msg)
      send_to_all(rest, msg)
    }
  }
}

fn recv_all_others(me, n, count) {
  if n == 0 {
    count
  } else {
    match recv() {
      cons('msg, inner) -> {
        if car(inner) == me {
          recv_all_others(me, n - 1, count)
        } else {
          recv_all_others(me, n - 1, count + 1)
        }
      }
      _ -> recv_all_others(me, n - 1, count)
    }
  }
}

fn worker_loop(me, all_pids, main_pid, rounds, recv_count) {
  if rounds == 0 {
    send(main_pid, cons('report, cons(me, cons(recv_count, nil))))
  } else {
    churn(50)
    send_to_all(all_pids, cons('msg, cons(me, cons(rounds, nil))))
    worker_loop(me, all_pids, main_pid, rounds - 1, recv_all_others(me, 4, recv_count))
  }
}

fn worker() {
  match recv() {
    cons('start, data) -> {
      worker_loop(car(data), car(cdr(data)), car(cdr(cdr(data))), 50, 0)
    }
    _ -> 'error
  }
}

fn main() {
  let main_pid = self()
  let p0 = spawn(fn { worker() })
  let p1 = spawn(fn { worker() })
  let p2 = spawn(fn { worker() })
  let p3 = spawn(fn { worker() })
  let all = cons(p0, cons(p1, cons(p2, cons(p3, nil))))
  send(p0, cons('start, cons(0, cons(all, cons(main_pid, nil)))))
  send(p1, cons('start, cons(1, cons(all, cons(main_pid, nil)))))
  send(p2, cons('start, cons(2, cons(all, cons(main_pid, nil)))))
  send(p3, cons('start, cons(3, cons(all, cons(main_pid, nil)))))
  recv()
  recv()
  recv()
  print("all done")
  recv()
}