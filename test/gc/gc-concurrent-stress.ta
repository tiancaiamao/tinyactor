// Test: gc-concurrent-stress
// Purpose: Stress concurrent GC across 4 worker processes with heavy list allocation
//          and cross-process message passing containing heap-allocated data.
//          Workers send to all peers each iteration, exercising cross-process deep copy
//          interaction with per-process concurrent GC.
// Expected output: all done

// Msg: the worker protocol. Start hands a worker its id, the peer list and
// main's pid; Round is the per-round broadcast; Report is the final tally.
// Declared constructors, not ('tag . payload) cons chains.
type Msg {
  Start(id, pids, main_pid)
  Round(me, rounds)
  Report(me, recv_count)
}

fn churn(n) {
  if n == 0 {
    nil
  } else {
    cons(n, churn(n - 1))
  }
}

fn send_to_all(pids, msg) {
  match pids {
    nil -> 'done
    cons(pid, rest) -> {
      send(pid, msg)
      send_to_all(rest, msg)
    }
  }
}

fn recv_all_others(me, n, count) {
  if n == 0 {
    count
  } else {
    match recv() {
      Round(from, _) -> {
        if from == me {
          recv_all_others(me, n - 1, count)
        } else {
          recv_all_others(me, n - 1, count + 1)
        }
      }
      _ -> recv_all_others(me, n - 1, count)
    }
  }
}

fn worker_loop(me, all_pids, main_pid, rounds, recv_count) {
  if rounds == 0 {
    send(main_pid, Report(me, recv_count))
  } else {
    churn(50)
    send_to_all(all_pids, Round(me, rounds))
    worker_loop(me, all_pids, main_pid, rounds - 1, recv_all_others(me, 4, recv_count))
  }
}

fn worker() {
  match recv() {
    Start(id, pids, main_pid) -> {
      worker_loop(id, pids, main_pid, 50, 0)
    }
    _ -> worker()
  }
}

fn main() {
  let main_pid = self()
  let p0 = spawn(fn { worker() })
  let p1 = spawn(fn { worker() })
  let p2 = spawn(fn { worker() })
  let p3 = spawn(fn { worker() })
  let all = cons(p0, cons(p1, cons(p2, cons(p3, nil))))
  send(p0, Start(0, all, main_pid))
  send(p1, Start(1, all, main_pid))
  send(p2, Start(2, all, main_pid))
  send(p3, Start(3, all, main_pid))
  recv()
  recv()
  recv()
  print("all done")
  recv()
}