((import "tinyactor:lib/http" "tinyactor:lib/http") (import "tinyactor:lib/tcp" "tinyactor:lib/tcp") (import "tinyactor:lib/dict" "tinyactor:lib/dict") (import "tinyactor:lib/option" "tinyactor:lib/option") (import "tinyactor:lib/result" "tinyactor:lib/result") (import "tinyactor:lib/str" "tinyactor:lib/str") (import "tinyactor:lib/random" "tinyactor:lib/random") (type Bound nil (Bound ok port lst)) (define (bind_free_port tries) (if (= tries 0) (tuple (quote Bound) 0 -1 (tuple (quote tcp.Conn) 0)) (let p (match (random.rand_int 5000) ((tuple (quote result.Ok) r) (+ 50000 r)) ((tuple (quote result.Err) _) -1)) (if (= p -1) (bind_free_port (- tries 1)) (match (tcp.listen p) ((tuple (quote result.Ok) lst) (tuple (quote Bound) 1 p lst)) ((tuple (quote result.Err) _) (bind_free_port (- tries 1)))))))) (define (check_bool label pass) (if pass (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (check_eq label got want) (check_bool label (= got want))) (define (check_status label r want_status want_body) (match r ((tuple (quote result.Err) _) (check_bool label false)) ((tuple (quote result.Ok) resp) (match resp ((tuple (quote http.MkResp) s _ b) (check_bool label (and (= s want_status) (= b want_body)))))))) (define (routes_under_test) (dict.insert (dict.insert (dict.insert (dict.insert (dict.str_new) "/hello" (lambda (_req) (http.text_response 200 "hello") nil)) "/post" (lambda (req) (match req ((tuple (quote http.MkReq) _ _ _ _ b) (http.text_response 200 b))) nil)) "/q" (lambda (req) (match req ((tuple (quote http.MkReq) _ _ q _ _) (http.text_response 200 q))) nil)) "*" (lambda (req) (match req ((tuple (quote http.MkReq) _ p _ _ _) (http.text_response 200 (str.concat "catchall " p)))) nil))) (define (routes_strict) (dict.insert (dict.str_new) "/only" (lambda (_req) (http.text_response 200 "only") nil))) (define (serve_n routes lst n me) (if (= n 0) (send me (quote server_done)) (match (http.serve_once routes lst) ((tuple (quote result.Ok) _) (begin (send me (quote served)) (serve_n routes lst (- n 1) me))) ((tuple (quote result.Err) _) (send me (quote serve_err)))))) (define (wait_served n) (if (= n 0) 0 (match (recv_after 10000) ((quote served) (wait_served (- n 1))) ((quote server_done) 0) (_ (begin (print "FAIL - unexpected message from server") 1))))) (define (main) (let me (self) (let b1 (bind_free_port 10) (let f0 (match b1 ((tuple (quote Bound) 1 port1 lst1) (let srv1 (spawn (lambda nil (serve_n (routes_under_test) lst1 4 me) nil)) (let base (str.concat "http://127.0.0.1:" (str.from_int port1)) (let f1 (check_status "exact route hit" (http.get (str.concat base "/hello")) 200 "hello") (let f2 (check_status "catch-all serves unknown path" (http.get (str.concat base "/nope")) 200 "catchall /nope") (let f3 (check_status "post body reaches handler" (http.post (str.concat base "/post") "ping") 200 "ping") (let f4 (check_status "query string reaches handler" (http.get (str.concat base "/q?x=1")) 200 "x=1") (let fw (wait_served 4) (begin (tcp.close lst1) (let _ srv1) (+ (+ (+ (+ f1 f2) f3) f4) fw)))))))))) (_ (begin (print "FAIL - bind main listener") 1))) (let f5 (match (bind_free_port 10) ((tuple (quote Bound) 1 port2 lst2) (let srv2 (spawn (lambda nil (serve_n (routes_strict) lst2 2 me) nil)) (let base (str.concat "http://127.0.0.1:" (str.from_int port2)) (let a (check_status "strict route hit" (http.get (str.concat base "/only")) 200 "only") (let b (match (http.get (str.concat base "/missing")) ((tuple (quote result.Err) _) (check_bool "missing path is 404" false)) ((tuple (quote result.Ok) resp) (match resp ((tuple (quote http.MkResp) s _ _) (check_bool "missing path is 404" (= s 404)))))) (let _ (wait_served 2) (begin (tcp.close lst2) (let _ srv2) (+ a b)))))))) (_ (begin (print "FAIL - bind strict listener") 1))) (let _ (recv_after 1000) (let _ (recv_after 1000) (let total (+ f0 f5) (begin (if (= total 0) (print "PASS") (print (str.concat "FAIL - scenarios: " (str.from_int total)))) total))))))))))
