((import "net") (define (connect_retry host port timeout) (let r (net.connect host port timeout) (match r (nil (connect_retry host port timeout)) (x x)))) (define (accept_retry s) (let a (net.accept s) (match a (nil (accept_retry s)) (x x)))) (define (test_success) (let s1 (net.listen 9876) (if (= s1 -1) (begin (print "connect-fail") false) (let c1 (connect_retry "127.0.0.1" 9876 3000) (if (int? c1) (let a1 (accept_retry s1) (begin (print "connect-ok") (net.close c1) (net.close a1) (net.close s1) true)) (begin (print "connect-fail") (net.close s1) false)))))) (define (test_refused) (let s0 (net.listen 9877) (if (= s0 -1) (begin (print "refused-fail") false) (begin (net.close s0) (let r2 (connect_retry "127.0.0.1" 9877 3000)) (match r2 ((quote refused) (begin (print "refused-ok") true)) (x (begin (print "refused-fail") false))))))) (define (test_dns) (let r3 (connect_retry "does-not-exist.invalid" 80 3000) (match r3 ((quote dns_error) (begin (print "dns-error-ok") true)) (x (begin (print "dns-error-fail") false))))) (define (test_timeout) (let r4 (connect_retry "192.0.2.1" 80 200) (match r4 ((quote timeout) (begin (print "timeout-ok") true)) (x (begin (print "timeout-fail") false))))) (define (main) (let ok1 (test_success) (let ok2 (test_refused) (let ok3 (test_dns) (let ok4 (test_timeout) (if (and ok1 (and ok2 (and ok3 ok4))) (print "PASS") (print "FAIL"))))))))
