((import "arg" "arg") (import "result" "result") (import "option" "option") (import "list" "list") (import "str" "str") (define (spec) (list (cons (quote Flag) (cons "verbose" (cons "bool" (cons false (cons "enable verbose output" nil))))) (cons (quote Flag) (cons "port" (cons "int" (cons 8080 (cons "port to listen on" nil))))) (cons (quote Flag) (cons "name" (cons "string" (cons "anon" (cons "user name" nil))))))) (define (check_str label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat got (str.concat ", want " want))))))) (if pass 0 1)))) (define (check_int label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat (str.from_int got) (str.concat ", want " (str.from_int want)))))))) (if pass 0 1)))) (define (check_bool label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label ": bool mismatch")))) (if pass 0 1)))) (define (get_int p name) (match (arg.get p name) ((Some v) v) ((quote None) -999999))) (define (get_str p name) (match (arg.get p name) ((Some v) v) ((quote None) "<missing>"))) (define (get_bool p name) (match (arg.get p name) ((Some v) v) ((quote None) false))) (define (err_of r) (match r ((Err e) e) ((Ok _) "<ok>"))) (define (check_err label r want) (if (result.is_err r) (check_str label (err_of r) want) (begin (print (str.concat "FAIL - " (str.concat label ": expected Err, got Ok"))) 1))) (define (test_defaults) (let r (arg.parse_args (spec) (list)) (let f1 (check_bool "defaults parse Ok" (result.is_ok r) true) (let p (result.unwrap r) (let f2 (check_bool "bool default" (get_bool p "verbose") false) (let f3 (check_int "int default" (get_int p "port") 8080) (let f4 (check_str "string default" (get_str p "name") "anon") (let f5 (check_int "no positionals" (list.length (arg.positionals p)) 0) (+ (+ (+ (+ f1 f2) f3) f4) f5))))))))) (define (test_forms) (let p (result.unwrap (arg.parse_args (spec) (list "--verbose=true" "--port=9090" "--name=bob"))) (let f1 (check_bool "--bool=true" (get_bool p "verbose") true) (let f2 (check_int "--int=value" (get_int p "port") 9090) (let f3 (check_str "--string=value" (get_str p "name") "bob") (let p2 (result.unwrap (arg.parse_args (spec) (list "-verbose=false" "-port=1" "-name=x"))) (let f4 (check_bool "-bool=false" (get_bool p2 "verbose") false) (let f5 (check_int "-int=value" (get_int p2 "port") 1) (let f6 (check_str "-string=value" (get_str p2 "name") "x") (let p3 (result.unwrap (arg.parse_args (spec) (list "--port" "70" "--name" "carl"))) (let f7 (check_int "--int value" (get_int p3 "port") 70) (let f8 (check_str "--string value" (get_str p3 "name") "carl") (let p4 (result.unwrap (arg.parse_args (spec) (list "--verbose" "file.txt"))) (let f9 (check_bool "bare bool is true" (get_bool p4 "verbose") true) (let f10 (check_str "bool leaves token positional" (str.join (arg.positionals p4) ",") "file.txt") (let p5 (result.unwrap (arg.parse_args (spec) (list "--verbose=false"))) (let f11 (check_bool "--bool=false" (get_bool p5 "verbose") false) (let p6 (result.unwrap (arg.parse_args (spec) (list "--name="))) (let f12 (check_str "--name= empty value" (get_str p6 "name") "") (let p7 (result.unwrap (arg.parse_args (spec) (list "--port=1" "--port=2"))) (let f13 (check_int "repeated flag last wins" (get_int p7 "port") 2) (let p8 (result.unwrap (arg.parse_args (spec) (list "--port=-5"))) (let f14 (check_int "negative via = form" (get_int p8 "port") -5) (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6) f7) f8) f9) f10) f11) f12) f13) f14)))))))))))))))))))))))) (define (test_positionals) (let p (result.unwrap (arg.parse_args (spec) (list "a" "--port=1" "b" "-" "c"))) (let f1 (check_str "positionals in order" (str.join (arg.positionals p) ",") "a,b,-,c") (let p2 (result.unwrap (arg.parse_args (spec) (list "--port=1" "--" "--verbose" "x"))) (let f2 (check_str "-- makes everything positional" (str.join (arg.positionals p2) ",") "--verbose,x") (let f3 (check_bool "-- stops flag parsing" (get_bool p2 "verbose") false) (let p3 (result.unwrap (arg.parse_args (spec) (list "in.txt" "--name=z"))) (let f4 (check_str "flag after positional" (get_str p3 "name") "z") (let f5 (check_str "positional preserved" (str.join (arg.positionals p3) ",") "in.txt") (+ (+ (+ (+ f1 f2) f3) f4) f5)))))))))) (define (test_errors) (let f1 (check_err "unknown flag" (arg.parse_args (spec) (list "--nope")) "unknown flag: --nope") (let f2 (check_err "unknown flag (single dash)" (arg.parse_args (spec) (list "-n")) "unknown flag: --n") (let f3 (check_err "missing value" (arg.parse_args (spec) (list "--port")) "missing value for --port") (let f4 (check_err "invalid int" (arg.parse_args (spec) (list "--port=abc")) "invalid int for --port: abc") (let f5 (check_err "invalid bool" (arg.parse_args (spec) (list "--verbose=maybe")) "invalid bool for --verbose: maybe") (let f6 (check_err "missing value (string)" (arg.parse_args (spec) (list "--name")) "missing value for --name") (let bad_spec (list (cons (quote Flag) (cons "x" (cons "float" (cons (float "0.0") (cons "unsupported kind" nil)))))) (let f7 (check_err "unsupported kind" (arg.parse_args bad_spec (list "--x=1")) "invalid kind for --x: float") (+ (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6) f7)))))))))) (define (test_get) (let p (result.unwrap (arg.parse_args (spec) (list))) (let f1 (check_bool "get spec'd name is Some" (option.is_some (arg.get p "port")) true) (let f2 (check_bool "get unknown name is None" (option.is_none (arg.get p "nope")) true) (+ f1 f2))))) (define (test_usage) (let want "Usage: myprog [flags] [--] <args>...\n  --verbose bool  enable verbose output (default false)\n  --port int  port to listen on (default 8080)\n  --name string  user name (default \"anon\")\n" (let f1 (check_str "usage text" (arg.usage "myprog" (spec)) want) (let f2 (check_str "usage empty spec" (arg.usage "x" (list)) "Usage: x [flags] [--] <args>...\n") (+ f1 f2))))) (define (test_parse_argv) (let r (arg.parse (spec)) (let f1 (check_bool "parse(os.args) is Ok" (result.is_ok r) true) (let p (result.unwrap r) (let f2 (check_int "parse(os.args) default" (get_int p "port") 8080) (let f3 (check_int "parse(os.args) positionals" (list.length (arg.positionals p)) 0) (+ (+ f1 f2) f3))))))) (define (main) (let failures (test_defaults) (let failures (+ failures (test_forms)) (let failures (+ failures (test_positionals)) (let failures (+ failures (test_errors)) (let failures (+ failures (test_get)) (let failures (+ failures (test_usage)) (let failures (+ failures (test_parse_argv)) (if (= failures 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int failures)))))))))))))
