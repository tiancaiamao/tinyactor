((import "tinyactor:lib/net" "tinyactor:lib/net") (import "tinyactor:lib/option" "tinyactor:lib/option") (import "tinyactor:lib/result" "tinyactor:lib/result") (import "tinyactor:lib/random" "tinyactor:lib/random") (define (check label ok) (if ok (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (type Bound nil (Bound (nil sock) (nil port))) (define (bound_sock b) (match b ((tuple (quote Bound) sock _) sock))) (define (bound_port b) (match b ((tuple (quote Bound) _ port) port))) (define (bind_random_port tries) (if (= tries 0) (quote option.None) (let r (random.rand_int 20000) (let p (match r ((tuple (quote result.Ok) p) (+ 20000 p)) (_ -1)) (if (= p -1) (bind_random_port (- tries 1)) (let s (net.listen p) (if (= s -1) (bind_random_port (- tries 1)) (tuple (quote option.Some) (tuple (quote Bound) s p))))))))) (define (connect_retry host port timeout) (let r (net.connect_timeout host port timeout) (match r (nil (connect_retry host port timeout)) (x x)))) (define (refused_scenario tries) (if (= tries 0) (+ (check "refused connect reported" false) (check "refused leaves errno" false)) (match (bind_random_port 50) ((quote option.None) (check "refused setup (no port)" false)) ((tuple (quote option.Some) b) (let port (bound_port b) (begin (net.close (bound_sock b)) (let r (connect_retry "127.0.0.1" port 3000)) (if (= r (quote refused)) (+ (check "refused connect reported" true) (check "refused leaves errno" (!= (net.errno) 0))) (begin (if (int? r) (net.close r) nil) (refused_scenario (- tries 1)))))))))) (define (main) (let f0 (check "fresh proc reads 0" (= (net.errno) 0)) (let bound (bind_random_port 50) (let f1 (+ f0 (check "random bind succeeded" (option.is_some bound))) (let f2 (match bound ((quote option.None) 0) ((tuple (quote option.Some) b) (let s1 (bound_sock b) (let port (bound_port b) (let s2 (net.listen port) (let f (check "double bind fails" (= s2 -1)) (let f (+ f (check "double bind leaves errno" (!= (net.errno) 0))) (let fr (refused_scenario 3) (let f (+ f fr) (begin (net.close s1) (let me (self)) (spawn (lambda nil (send me (net.errno)) nil)) (let child_errno (recv)) (let f (+ f (check "fresh actor reads 0 (proc-local)" (= child_errno 0)))) f)))))))))) (let f (+ f1 f2) (if (= f 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int f)))))))))))
