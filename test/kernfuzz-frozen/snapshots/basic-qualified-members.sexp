((import "tinyactor:lib/option" "tinyactor:lib/option") (import "tinyactor:lib/result" "res") (import "tinyactor:lib/strconv" "tinyactor:lib/strconv") (define (p cond) (if cond (print "ok") (print "FAIL"))) (type-sig unwrap_or ((option.Option Int) nil) Int) (define (unwrap_or o d) (match o ((tuple (quote option.Some) v) v) ((quote option.None) d))) (type-sig describe ((res.Result Int String)) String) (define (describe r) (match r ((tuple (quote res.Ok) v) "ok") ((tuple (quote res.Err) _) "err"))) (define (main) (begin (p (= (unwrap_or (tuple (quote option.Some) 7) 0) 7)) (p (= (unwrap_or (quote option.None) 42) 42)) (p (option.is_some (tuple (quote option.Some) 1))) (p (option.is_none (quote option.None))) (p (option.is_some (option.map (lambda (n) (+ n 1) nil) (tuple (quote option.Some) 1)))) (p (= (describe (tuple (quote res.Ok) 1)) "ok")) (p (= (describe (tuple (quote res.Err) "boom")) "err")) (p (= (describe (strconv.str_to_float "2.5")) "ok")) (p (= (describe (strconv.str_to_float "nope")) "err")) (p (= (option.unwrap_or 0 (tuple (quote option.Some) 3)) 3)))))
