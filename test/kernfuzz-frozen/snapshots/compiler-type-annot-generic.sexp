((type List (a) (quote Nil) (Cons a (cons (quote List) (cons a nil)))) (type Pair (a b) (MkPair a b)) (type Color nil (quote Red) (quote Green)) (type-sig to_str (Color) int) (define (to_str c) (match c ((quote Red) 1) ((quote Green) 2))) (type-sig head ((List a)) a) (define (head xs) (match xs ((Cons h t) h) ((quote Nil) 0))) (type-sig head2 ((List (quote b))) (quote b)) (define (head2 xs) (match xs ((Cons h t) h) ((quote Nil) 0))) (type-sig second ((Pair a b)) b) (define (second p) (match p ((MkPair x y) y))) (define (main) (let a (cons (quote Cons) (cons 1 (cons (quote Nil) nil))) (let s (cons (quote Cons) (cons "hi" (cons (quote Nil) nil))) (begin (print (head a)) (print (head s)) (print (head2 a)) (print (head2 s)) (print (second (cons (quote MkPair) (cons 1 (cons "x" nil))))) (print (second (cons (quote MkPair) (cons "x" (cons 1 nil))))) (print (to_str (quote Red))) (print (to_str (quote Green))) (print "PASS"))))))
