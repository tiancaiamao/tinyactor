((type MyList (a) (quote Nil) (Cons a (tuple (quote MyList) a))) (type MyPair (a b) (MkPair a b)) (type Color nil (quote Red) (quote Green)) (type-sig to_str (Color) Int) (define (to_str c) (match c ((quote Red) 1) ((quote Green) 2))) (type-sig head ((MyList a)) a) (define (head xs) (match xs ((tuple (quote Cons) h t) h) ((quote Nil) (/ 1 0)))) (type-sig head2 ((MyList (quote b))) (quote b)) (define (head2 xs) (match xs ((tuple (quote Cons) h t) h) ((quote Nil) (/ 1 0)))) (type-sig second ((MyPair a b)) b) (define (second p) (match p ((tuple (quote MkPair) x y) y))) (define (main) (let a (tuple (quote Cons) 1 (quote Nil)) (let s (tuple (quote Cons) "hi" (quote Nil)) (begin (print (head a)) (print (head s)) (print (head2 a)) (print (head2 s)) (print (second (tuple (quote MkPair) 1 "x"))) (print (second (tuple (quote MkPair) "x" 1))) (print (to_str (quote Red))) (print (to_str (quote Green))) (print "PASS"))))))
