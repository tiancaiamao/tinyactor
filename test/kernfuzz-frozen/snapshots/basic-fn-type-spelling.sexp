((type-sig add (Int Int) Int) (define (add x y) (+ x y)) (type-sig mul (Int Int) Int) (define (mul x y) (* x y)) (type-sig inc (Int) Int) (define (inc x) (+ x 1)) (type-sig apply ((arrow Int (arrow Int Int)) Int Int) Int) (define (apply f a b) (f a b)) (type-sig twice ((arrow Int Int) Int) Int) (define (twice f x) (f (f x))) (type-sig apply_twice ((arrow (arrow Int Int) (arrow Int Int)) (arrow Int Int) Int) Int) (define (apply_twice g f x) (g f x)) (type-sig map ((arrow a b) (List a)) (List b)) (define (map f xs) (match xs (nil (list)) ((cons h t) (cons (f h) (map f t))))) (type-sig pick (Bool) (arrow Int (arrow Int Int))) (define (pick use_add) (if use_add add mul)) (define (main) (begin (print (apply add 2 3)) (print (apply mul 2 3)) (print (apply_twice twice inc 10)) (print (map inc (list 1 2 3))) (print ((pick true) 4 5)) (print ((pick false) 4 5)) (print "PASS"))))
