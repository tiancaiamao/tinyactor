((type Rational nil (R (quote Int) (quote Int))) (type Bag nil (quote Empty) (Full (tuple (quote List) (quote String)))) (type-sig numerator (Rational) Int) (define (numerator m) (match m ((tuple (quote R) n d) n))) (type-sig show (String) nil) (define (show s) (print s)) (type-sig describe (Bag) nil) (define (describe b) (match b ((quote Empty) (show "empty")) ((tuple (quote Full) items) (show (car items))))) (define (main) (begin (print (numerator (tuple (quote R) 3 4))) (match (tuple (quote R) 3 4) ((tuple (quote R) n d) (print d))) (describe (quote Empty)) (describe (tuple (quote Full) (list "a" "b"))) (print "PASS"))))
