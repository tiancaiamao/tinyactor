((type Rational nil (R int int)) (type Bag nil (quote Empty) (Full (list string))) (type-sig numerator (Rational) int) (define (numerator m) (match m ((cons (quote R) (cons n (cons d nil))) n))) (type-sig show (string) nil) (define (show s) (print s)) (type-sig describe (Bag) nil) (define (describe b) (match b ((quote Empty) (show "empty")) ((cons (quote Full) (cons items nil)) (show (car items))))) (define (main) (begin (print (numerator (cons (quote R) (cons 3 (cons 4 nil))))) (match (cons (quote R) (cons 3 (cons 4 nil))) ((cons (quote R) (cons n (cons d nil))) (print d))) (describe (quote Empty)) (describe (cons (quote Full) (cons (list "a" "b") nil))) (print "PASS"))))
