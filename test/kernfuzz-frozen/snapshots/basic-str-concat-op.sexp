((define (check label got want) (if (str.eq got want) (print (str.concat "ok - " label)) (print (str.concat (str.concat (str.concat (str.concat (str.concat (str.concat "FAIL - " label) ": got '") got) "' want '") want) "'")))) (define (pair_up a b c) (str.concat (str.concat a b) c)) (define (main) (let a "abc" (let b "def" (begin (check "single" (str.concat a b) "abcdef") (check "left assoc chain" (pair_up a "-" b) "abc-def") (check "empty partner" (str.concat "" a) "abc") (check "both literals" (str.concat "x" "y") "xy") (check "call result operand" (str.concat "n=" (str.from_int 42)) "n=42") (check "binds tighter than ==" (if (= (str.concat a b) "abcdef") "yes" "no") "yes") (check "pipe binds looser" (str.from_int (str.length (str.concat a b))) "6") (check "in a match arm" (match 1 (1 (str.concat "one" "!"))) "one!") (print "PASS"))))))
