((type Bind (k v) (Bind k v)) (type-sig len (nil) Int) (define (len xs) (match xs (nil 0) ((cons h t) (+ 1 (len t))))) (type-sig sum ((List Int)) Int) (define (sum xs) (match xs (nil 0) ((cons h t) (+ h (sum t))))) (type-sig drop2_sum ((List Int)) Int) (define (drop2_sum xs) (match xs ((cons a (cons b rest)) (sum rest)) (nil 0) ((cons x t) x))) (type-sig first_value ((List (Bind String Int))) Int) (define (first_value alist) (match alist (nil -1) ((cons (cons (quote Bind) (cons k (cons v nil))) rest) v) ((cons other rest) -2))) (type-sig tag_of (nil) Int) (define (tag_of xs) (match xs (nil 0) ((cons (cons (quote Bind) (cons k (cons v nil))) rest) 1) ((cons other rest) 2))) (type-sig count_from (nil) Int) (define (count_from xs) (match xs (nil 0) ((cons a (cons b rest)) (+ 2 (count_from rest))) ((cons x rest) (+ 1 (count_from rest))))) (define (main) (begin (print (len nil)) (print (len (list 1 2 3 4))) (print (sum (list 1 2 3 4))) (print (drop2_sum nil)) (print (drop2_sum (list 5))) (print (drop2_sum (list 10 20))) (print (drop2_sum (list 10 20 30 40))) (print (first_value (list (cons (quote Bind) (cons "a" (cons 7 nil))) (cons (quote Bind) (cons "b" (cons 8 nil)))))) (print (first_value nil)) (print (tag_of (cons (cons (quote Bind) (cons "a" (cons 1 nil))) nil))) (print (tag_of (cons 8 nil))) (print (count_from (list 1 2 3 4 5))) (print "PASS"))))
