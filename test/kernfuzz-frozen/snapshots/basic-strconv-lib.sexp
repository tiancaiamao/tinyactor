((import "strconv" "strconv") (import "result" "result") (define (check_bool label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " label))) (if pass 0 1)))) (define (check_ok label r want) (if (result.is_err r) (begin (print (str.concat "FAIL - " (str.concat label ": expected Ok, got Err"))) 1) (check_bool label (result.unwrap r) want))) (define (check_err label r want_msg) (match r ((Ok _) (begin (print (str.concat "FAIL - " (str.concat label ": expected Err, got Ok"))) 1)) ((Err m) (check_bool label m want_msg)))) (define (test_int_to_str) (let ok1 (check_ok "int_to_str 255/16" (strconv.int_to_str 255 16) "ff") (let ok2 (check_ok "int_to_str 255/2" (strconv.int_to_str 255 2) "11111111") (let ok3 (check_ok "int_to_str 255/8" (strconv.int_to_str 255 8) "377") (let ok4 (check_ok "int_to_str 0/10" (strconv.int_to_str 0 10) "0") (let ok5 (check_ok "int_to_str -42/10" (strconv.int_to_str -42 10) "-42") (let ok6 (check_ok "int_to_str -1/16 unsigned48" (strconv.int_to_str -1 16) "ffffffffffff") (let ok7 (check_err "int_to_str base 12" (strconv.int_to_str 5 12) "invalid base") (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7))))))))) (define (test_str_to_int) (let ok1 (check_ok "str_to_int -42/10" (strconv.str_to_int "-42" 10) -42) (let ok2 (check_ok "str_to_int +7/10" (strconv.str_to_int "+7" 10) 7) (let ok3 (check_ok "str_to_int 007/10" (strconv.str_to_int "007" 10) 7) (let ok4 (check_ok "str_to_int ff/16" (strconv.str_to_int "ff" 16) 255) (let ok5 (check_ok "str_to_int FF/16" (strconv.str_to_int "FF" 16) 255) (let ok6 (check_ok "str_to_int 1010/2" (strconv.str_to_int "1010" 2) 10) (let ok7 (check_ok "str_to_int 17/8" (strconv.str_to_int "17" 8) 15) (let ok8 (check_err "str_to_int 12a/10" (strconv.str_to_int "12a" 10) "invalid int") (let ok9 (check_err "str_to_int +/10" (strconv.str_to_int "+" 10) "invalid int") (let ok10 (check_err "str_to_int empty/10" (strconv.str_to_int "" 10) "invalid int") (let ok11 (check_err "str_to_int -ff/16 no sign" (strconv.str_to_int "-ff" 16) "invalid int") (let ok12 (check_err "str_to_int base 12" (strconv.str_to_int "5" 12) "invalid base") (let ok13 (check_err "str_to_int 2^48-1 huge/10" (strconv.str_to_int "999999999999999999" 10) "out of range") (let ok14 (check_ok "str_to_int 2^47-1 boundary" (strconv.str_to_int "140737488355327" 10) 140737488355327) (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8) ok9) ok10) ok11) ok12) ok13) ok14)))))))))))))))) (define (test_round_trip) (let s (result.unwrap (strconv.int_to_str 123456 10)) (let ok1 (check_ok "round trip dec 123456" (strconv.str_to_int s 10) 123456) (let s (result.unwrap (strconv.int_to_str 48879 16)) (let ok2 (check_ok "round trip base 16" (strconv.str_to_int s 16) 48879) (let s (result.unwrap (strconv.int_to_str 48879 8)) (let ok3 (check_ok "round trip base 8" (strconv.str_to_int s 8) 48879) (let s (result.unwrap (strconv.int_to_str 48879 2)) (let ok4 (check_ok "round trip base 2" (strconv.str_to_int s 2) 48879) (let s (strconv.float_to_str (float "1.5")) (let ok5 (check_ok "round trip float 1.5" (strconv.str_to_float s) (float "1.5")) (let s (strconv.float_to_str (float "0.25")) (let ok6 (check_ok "round trip float 0.25" (strconv.str_to_float s) (float "0.25")) (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6)))))))))))))) (define (test_float) (let ok1 (check_ok "float_to_str 1.5" (cons (quote Ok) (cons (strconv.float_to_str (float "1.5")) nil)) "1.5") (let ok2 (check_ok "float_to_str 0.0001" (cons (quote Ok) (cons (strconv.float_to_str (float "0.0001")) nil)) "0.0001") (let ok3 (check_ok "str_to_float plain" (strconv.str_to_float "1.5") (float "1.5")) (let ok4 (check_ok "str_to_float trimmed" (strconv.str_to_float "  2.25  ") (float "2.25")) (let ok5 (check_ok "str_to_float int text" (strconv.str_to_float "42") (float "42.0")) (let ok6 (check_err "str_to_float garbage" (strconv.str_to_float "abc") "invalid float") (let ok7 (check_err "str_to_float empty" (strconv.str_to_float "") "invalid float") (let ok8 (check_err "str_to_float 1.5x" (strconv.str_to_float "1.5x") "invalid float") (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8)))))))))) (define (test_pad) (let ok1 (check_ok "pad zeros" (cons (quote Ok) (cons (strconv.pad "7" 3 48) nil)) "007") (let ok2 (check_ok "pad spaces" (cons (quote Ok) (cons (strconv.pad "x" 4 32) nil)) "   x") (let ok3 (check_ok "pad no-op" (cons (quote Ok) (cons (strconv.pad "abcd" 2 48) nil)) "abcd") (let ok4 (check_ok "pad == str.pad_start" (cons (quote Ok) (cons (strconv.pad "9" 5 48) nil)) (str.pad_start "9" 5 48)) (+ (+ (+ ok1 ok2) ok3) ok4)))))) (define (main) (let failures (test_int_to_str) (let failures (+ failures (test_str_to_int)) (let failures (+ failures (test_round_trip)) (let failures (+ failures (test_float)) (let failures (+ failures (test_pad)) (if (= failures 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int failures)))))))))))
