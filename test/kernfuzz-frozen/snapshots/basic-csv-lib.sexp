((import "csv" "csv") (import "str" "str") (import "result" "result") (import "list" "list") (define (deep_eq a b) (if (pair? a) (if (pair? b) (and (deep_eq (car a) (car b)) (deep_eq (cdr a) (cdr b))) false) (if (pair? b) false (= a b)))) (define (check label got want) (let pass (deep_eq got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label ": wrong value")))) (if pass 1 0)))) (define (rows_of r sentinel) (match r ((Ok rows) rows) ((Err _) sentinel))) (define (err_of r sentinel) (match r ((Err msg) msg) ((Ok _) sentinel))) (define (check_err_at label text prefix) (let m (err_of (csv.parse text) nil) (let pass (if (null? m) false (str.eq (str.substr m 0 (str.length prefix)) prefix)) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat m "")))))) (if pass 1 0))))) (define (main) (let ok1 (check "one record three fields" (rows_of (csv.parse "a,b,c") nil) (list (list "a" "b" "c"))) (let ok2 (check "two records LF" (rows_of (csv.parse "a,b\nc,d") nil) (list (list "a" "b") (list "c" "d"))) (let ok3 (check "two records CRLF" (rows_of (csv.parse "a,b\r\nc,d") nil) (list (list "a" "b") (list "c" "d"))) (let ok4 (check "trailing newline is a terminator, not a record" (rows_of (csv.parse "a,b\r\nc,d\r\n") nil) (list (list "a" "b") (list "c" "d"))) (let ok5 (check "empty unquoted fields" (rows_of (csv.parse "a,,c") nil) (list (list "a" "" "c"))) (let ok6 (check "empty input -> no records" (rows_of (csv.parse "") nil) nil) (let ok7 (check "blank middle line -> one empty field" (rows_of (csv.parse "a\n\nb") nil) (list (list "a") (list "") (list "b"))) (let ok8 (check "quoted comma" (rows_of (csv.parse "\"a,b\",c") nil) (list (list "a,b" "c"))) (let ok9 (check "quoted newline" (rows_of (csv.parse "\"a\nb\",c") nil) (list (list "a\nb" "c"))) (let ok10 (check "quoted CRLF" (rows_of (csv.parse "\"a\r\nb\",c") nil) (list (list "a\r\nb" "c"))) (let ok11 (check "quoted quote (\"\" escape)" (rows_of (csv.parse "\"a\"\"b\",c") nil) (list (list "a\"b" "c"))) (let ok12 (check "quotes are optional" (rows_of (csv.parse "\"a\",\"b\"") nil) (list (list "a" "b"))) (let ok13 (check "quoted empty field" (rows_of (csv.parse "\"\",\"b\"") nil) (list (list "" "b"))) (let ok14 (check "quoted field keeps spaces" (rows_of (csv.parse " a ,\" b \"") nil) (list (list " a " " b "))) (let ok15 (check_err_at "unterminated quote" "\"abc" "line 1, col 5: ") (let ok16 (check_err_at "stray quote after closing quote" "\"a\"b" "line 1, col 4: ") (let ok17 (check_err_at "lone CR is an error" "a\rb" "line 1, col 2: ") (let ok18 (check_err_at "quote not at field start" "a\"b" "line 1, col 2: ") (let ok19 (check_err_at "error position is line-aware" "a,b\n\"unclosed" "line 2, col 10: ") (let ok20 (check "parse errors are Err, not a crash" (result.is_err (csv.parse "\"x")) true) (let ok21 (check "write: plain rows" (csv.write (list (list "a" "b") (list "c" "d"))) "a,b\r\nc,d") (let ok22 (check "write: empty rows" (csv.write nil) "") (let ok23 (check "write: empty field and empty record" (csv.write (list (list "") (list))) "\r\n") (let ok24 (check "write: quotes only when needed" (csv.write (list (list "plain" "with,comma" "with\"quote" "with\nnl"))) "plain,\"with,comma\",\"with\"\"quote\",\"with\nnl\"") (let ok25 (check "write: leading/trailing spaces stay unquoted" (csv.write (list (list " a "))) " a ") (let tricky (list (list "a" "b,c" "d\"e") (list "f\n" "" "\"g\"") (list " h " "i\r\nj")) (let w1 (csv.write tricky) (let p1 (csv.parse w1) (let ok26 (check "round-trip: parse(write(rows)) == rows" (rows_of p1 nil) tricky) (let w2 (csv.write (rows_of p1 nil)) (let ok27 (check "round-trip: write is idempotent" w2 w1) (let ok28 (check "write normalizes unnecessary quotes" (csv.write (rows_of (csv.parse "\"a\",\"b\"") nil)) "a,b") (let ok29 (check "round-trip: parse(write) is a fixed point" (rows_of (csv.parse (csv.write (rows_of (csv.parse w1) nil))) nil) (rows_of p1 nil)) (let total (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8) ok9) ok10) ok11) ok12) ok13) ok14) ok15) ok16) ok17) ok18) ok19) ok20) ok21) ok22) ok23) ok24) ok25) ok26) ok27) ok28) ok29) (if (= total 29) (print "PASS") (begin (print (str.concat "FAIL - " (str.concat (str.from_int (- 29 total)) " of 29 checks failed"))) (/ 1 0)))))))))))))))))))))))))))))))))))))))
