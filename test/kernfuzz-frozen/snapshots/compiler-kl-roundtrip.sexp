((import "file" "file") (import "kl" "kl") (import "lower-ast" "lower-ast") (import "parser" "parser") (import "sexp" "sexp") (import "tokenizer" "tokenizer") (const MAX_COL 78) (define (p cond) (if cond (print "ok") (print "FAIL"))) (define (spellings) (list (list "'x" "'x") (list "(quote x)" "'x") (list "(quote foo.bar)" "'foo.bar") (list "'nil" "'nil") (list "(quote nil)" "(quote nil)") (list "'true" "'true") (list "(quote true)" "(quote true)") (list "'false" "'false") (list "(quote false)" "(quote false)") (list "'42" "'42") (list "(quote 42)" "(quote 42)") (list "(quote -1)" "(quote -1)") (list "(quote \"s\")" "(quote \"s\")") (list "(quote (a b))" "(quote (a b))") (list "'(a b)" "(quote (a b))") (list "(quote 'nil)" "(quote 'nil)") (list "(print \"a\\nb\\tc\\\\d\\\"e\")" "(print \"a\\nb\\tc\\\\d\\\"e\")") (list "(print \"源码 \\\"里\\\" 的引号\")" "(print \"源码 \\\"里\\\" 的引号\")") (list "(pair . rest)" "(pair . rest)") (list "(a . (b c))" "(a b c)") (list "(a . nil)" "(a)") (list "(a . .)" "(a . .)") (list "'(pair . rest)" "(quote (pair . rest))") (list "(let (x 1) (match x ((h . t) h)))" "(let (x 1) (match x ((h . t) h)))") (list "(match x (3 1) (_ 0))" "(match x (3 1) (_ 0))") (list "(begin a b)" "(begin a b)") (list "(receive (('m a) (= a 1) nil))" "(receive (('m a) (= a 1) nil))") (list "(def f (lambda (a) a))" "(def f (lambda (a) a))"))) (define (check_spellings cs) (if (pair? cs) (let input (car (car cs)) (let want (car (cdr (car cs))) (let parsed (sexp.parse input) (begin (if (int? parsed) (print (str.concat "FAIL unreadable input: " input)) (let got (kl.write (car parsed)) (begin (p (= got want)) (p (= (kl.write (car (sexp.parse got))) got)) (if (= got want) nil (begin (print (str.concat "  input: " input)) (print (str.concat "  want:  " want)) (print (str.concat "  got:   " got))))))) (check_spellings (cdr cs)))))) nil)) (define (has_newline s) (has_newline_from s 0 (str.length s))) (define (has_newline_from s i n) (if (>= i n) false (if (= (str.char_at s i) 10) true (has_newline_from s (+ i 1) n)))) (define (long_forms) (list "((match (f x) ((cons h t) (> h 0) (begin h nil)) (_ (begin (print \"other\") nil))))" "(receive (('http_timeout wpid nil) (= wpid w) (cons 'Err (cons 'TimedOut nil))))" "(def length (lambda (xs) (if (null? xs) 0 (let (n (length (cdr xs))) (iadd n 1)))))" "(def drop2-sum (lambda (xs) (match xs ((a . rest) (begin (sum rest) (drop2-sum rest))))))")) (define (check_layout text) (if (<= (str.length text) (quote MAX_COL)) (print (str.concat "FAIL layout case is not long: " text)) (let tree (car (sexp.parse text)) (let once (kl.write tree) (begin (p (has_newline once)) (p (= (kl.write (car (sexp.parse once))) once))))))) (define (check_layouts texts) (if (pair? texts) (begin (check_layout (car texts)) (check_layouts (cdr texts))) nil)) (define (corpus) (list "test/basic/pattern-float-eq.ta" "test/basic/list-match-rest.ta" "test/basic/sexp-basic.ta" "test/basic/actor-closure-message.ta" "test/basic/use-basic.ta")) (define (lower_text text) (lower-ast.lower_program (parser.parse (tokenizer.tokenize text)))) (define (check_file path) (let text (file.read path) (if (null? text) (print (str.concat "FAIL no-read " path)) (let low (lower_text text) (if (int? low) (print (str.concat "FAIL lower " path)) (check_text path (kl.write_program low))))))) (define (check_text path text) (let back (sexp.parse text) (if (int? back) (begin (print (str.concat "FAIL reread " (str.concat path ": "))) (print (str.concat "  " (sexp.err)))) (let again (kl.write_program back) (begin (p (= again text)) (if (= again text) (p (> (str.length text) 0)) (print (str.concat "FAIL idempotence " path)))))))) (define (check_corpus paths) (if (pair? paths) (begin (check_file (car paths)) (check_corpus (cdr paths))) nil)) (define (main) (begin (check_spellings (spellings)) (check_layouts (long_forms)) (check_corpus (corpus)) (p (= (kl.write_program nil) "")) (p (= (kl.write nil) "nil")))))
