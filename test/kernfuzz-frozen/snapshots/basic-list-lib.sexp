((import "list" "list") (define (main) (let lst (list 1 2 3 4 5) (begin (print (list.length lst)) (print (list.nth lst 0)) (print (list.nth lst 4)) (print (list.nth lst 5)) (print (list.nth 42 0)) (print (list.append lst (list 6 7))) (print (list.append (list) lst)) (print (list.reverse lst)) (print (list.map (lambda (x) (* x 2) nil) lst)) (print (list.filter (lambda (x) (= (% x 2) 1) nil) lst)) (print (list.foldl (lambda (acc x) (+ acc x) nil) 0 lst)) (print (list.take 3 lst)) (print (list.take 10 lst)) (print lst) (print "PASS")))))
