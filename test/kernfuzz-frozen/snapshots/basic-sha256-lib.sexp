((import "sha256" "sha256") (import "option" "option") (import "str" "str") (type-sig bool_text (Bool) String) (define (bool_text b) (if b "true" "false")) (define (check label got want) (if (= got want) (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " (str.concat label ": got "))) (print got) 1))) (type-sig digest_of (String) String) (define (digest_of data) (match (sha256.digest data) ((quote None) "<none>") ((cons (quote Some) (cons s nil)) s))) (type-sig stream (String Int) String) (define (stream data step) (match (sha256.new) ((quote None) "<none>") ((cons (quote Some) (cons h nil)) (let h2 (block_loop h data 0 (str.length data) step) (match (sha256.final h2) ((quote None) "<none>") ((cons (quote Some) (cons s nil)) s)))))) (type-sig block_loop (Hasher String Int Int Int) Hasher) (define (block_loop h data done total step) (if (>= done total) h (let left (- total done) (let take (if (< left step) left step) (let h2 (match (sha256.update_at h data done take) ((quote None) h) ((cons (quote Some) (cons x nil)) x)) (block_loop h2 data (+ done take) total step)))))) (type-sig slice_at (String Int Int) String) (define (slice_at data off len) (match (sha256.new) ((quote None) "<none>") ((cons (quote Some) (cons h nil)) (let h2 (match (sha256.update_at h data off len) ((quote None) h) ((cons (quote Some) (cons x nil)) x)) (match (sha256.final h2) ((quote None) "<none>") ((cons (quote Some) (cons s nil)) s)))))) (type-sig slice_ok (String Int Int) Bool) (define (slice_ok data off len) (match (sha256.new) ((quote None) false) ((cons (quote Some) (cons h nil)) (match (sha256.update_at h data off len) ((quote None) false) ((cons (quote Some) (cons _ nil)) true))))) (type-sig final_twice (String) String) (define (final_twice data) (match (sha256.new) ((quote None) "<none>") ((cons (quote Some) (cons h nil)) (let h2 (match (sha256.update h data) ((quote None) h) ((cons (quote Some) (cons x nil)) x)) (let d1 (match (sha256.final h2) ((quote No