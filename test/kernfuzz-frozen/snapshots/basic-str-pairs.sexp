((import "str" "str") (define (check label got want) (if (= got want) (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (count cells n) (match cells (nil n) ((cons _ rest) (count rest (+ n 1))))) (define (nth cells k) (match cells (nil "<none>") ((cons cell rest) (if (= k 0) (str.concat (car cell) (str.concat "=" (cdr cell))) (nth rest (- k 1)))))) (define (main) (let hs (str.pairs "Host: h\r\nContent-Length: 2" "\r\n" ":") (let f1 (check "two lines" (count hs 0) 2) (let f2 (check "first key" (nth hs 0) "Host=h") (let f3 (check "second key" (nth hs 1) "Content-Length=2") (let dup (str.pairs "k: 1\r\nj: 0\r\nk: 2" "\r\n" ":") (let f4 (check "duplicate keeps arrival order" (nth dup 2) "k=2") (let url (str.pairs "Location: http://h/p" "\r\n" ":") (let f5 (check "value keeps inner separator" (nth url 0) "Location=http://h/p") (let f6 (check "single line, no trailing sep" (nth (str.pairs "a: 1" "\r\n" ":") 0) "a=1") (let pad (str.pairs "  X-A \t:  \t v  " "\r\n" ":") (let f7 (check "both sides trimmed" (nth pad 0) "X-A=v") (let f8 (check "empty value kept" (nth (str.pairs "x:" "\r\n" ":") 0) "x=") (let skip (str.pairs "not-a-header\r\n: v\r\nX-B: 1" "\r\n" ":") (let f9 (check "separatorless and nameless lines skipped" (count skip 0) 1) (let f10 (check "surviving line" (nth skip 0) "X-B=1") (let f11 (check "empty input is nil" (str.pairs "" "\r\n" ":") nil) (let f12 (check "empty separator is nil" (str.pairs "a: 1" "" ":") nil) (if (= (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6) f7) f8) f9) f10) f11) f12) 0) (print "PASS") (print "FAIL - str-pairs")))))))))))))))))))))
