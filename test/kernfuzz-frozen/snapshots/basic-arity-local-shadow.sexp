((import "tinyactor:lib/option" "tinyactor:lib/option") (define (f a b) (+ a b)) (define (apply_to f x) (f x)) (define (via_let x) (let f (lambda (y) (* y 10) nil) (f x))) (define (main) (let direct (f 1 2) (let through_param (apply_to (lambda (x) (+ x 1) nil) 1) (let through_let (via_let 4) (let imported (option.map (lambda (x) (+ x 1) nil) (tuple (quote option.Some) 1)) (if (and (= direct 3) (and (= through_param 2) (and (= through_let 40) (= (option.unwrap_or 0 imported) 2)))) (print "PASS") (print "FAIL"))))))))
