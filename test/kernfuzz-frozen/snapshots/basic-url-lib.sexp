((import "url" "url") (import "result" "result") (define (check_bool label pass) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " label))) (if pass 0 1))) (define (check_str label got want) (check_bool label (= got want))) (define (deep_eq a b) (if (pair? a) (if (pair? b) (and (deep_eq (car a) (car b)) (deep_eq (cdr a) (cdr b))) false) (if (pair? b) false (= a b)))) (define (check_ok label r want) (if (result.is_err r) (begin (print (str.concat "FAIL - " (str.concat label ": expected Ok, got Err"))) 1) (check_str label (result.unwrap r) want))) (define (check_deep_ok label r want) (if (result.is_err r) (begin (print (str.concat "FAIL - " (str.concat label ": expected Ok, got Err"))) 1) (check_deep label (result.unwrap r) want))) (define (check_err label r want_msg) (match r ((Ok _) (begin (print (str.concat "FAIL - " (str.concat label ": expected Err, got Ok"))) 1)) ((Err m) (check_str label m want_msg)))) (define (check_deep label got want) (check_bool label (deep_eq got want))) (define (fields u) (match u ((MkUrl sc ui h p pa q f) (cons sc (cons ui (cons h (cons p (cons pa (cons q (cons f nil)))))))))) (define (check_fields_ok label r want) (if (result.is_err r) (begin (print (str.concat "FAIL - " (str.concat label ": expected Ok, got Err"))) 1) (check_deep label (fields (result.unwrap r)) want))) (define (test_parse) (let ok1 (check_fields_ok "parse full fields" (url.parse "https://u:p@h:8080/a/b?x=1&y=2#frag") (cons "https" (cons "u:p" (cons "h" (cons "8080" (cons "/a/b" (cons "x=1&y=2" (cons "frag" nil)))))))) (let ok2 (check_fields_ok "parse path only" (url.parse "path only") (cons "" (cons "" (cons "" (cons "" (cons "path only" (cons "" (cons "" nil)))))))) (let ok3 (check_fields_ok "parse bare authority" (url.parse "https://h") (cons "https" (cons "" (cons "h" (cons "" (cons "" (cons "" (cons "" nil)))))))) (let ok4 (check_fields_ok "parse host+path+query" (url.parse "http://example.com/a?x=1") (cons "http" (cons "" (cons "example.com" (cons "" (cons "/a" (cons "x=1" (cons "" nil)))))))) (let ok5 (check_fields_ok "parse userinfo unsplit" (url.parse "ftp://alice:secret@f.org/pub") (cons "ftp" (cons "alice:secret" (cons "f.org" (cons "" (cons "/pub" (cons "" (cons "" nil)))))))) (let ok6 (check_err "parse ://x" (url.parse "://x") "empty scheme") (let ok7 (check_err "parse a://" (url.parse "a://") "empty host") (let ok8 (check_fields_ok "parse fragment only" (url.parse "/p#a?b") (cons "" (cons "" (cons "" (cons "" (cons "/p" (cons "" (cons "a?b" nil)))))))) (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8)))))))))) (define (test_query_decode) (let ok1 (check_deep_ok "query_decode two pairs" (url.query_decode "x=1&y=2") (cons (cons "x" "1") (cons (cons "y" "2") nil))) (let ok2 (check_deep_ok "query_decode repeated keys" (url.query_decode "a=1&a=2") (cons (cons "a" "1") (cons (cons "a" "2") nil))) (let ok3 (check_deep_ok "query_decode k= and bare key" (url.query_decode "k=&flag") (cons (cons "k" "") (cons (cons "flag" "") nil))) (let ok4 (check_deep_ok "query_decode empty segments" (url.query_decode "a=1&&b=2&") (cons (cons "a" "1") (cons (cons "b" "2") nil))) (let ok5 (check_deep_ok "query_decode percent" (url.query_decode "a%20b=c%26d") (cons (cons "a b" "c&d") nil)) (let ok6 (check_err "query_decode bad escape" (url.query_decode "bad=%zz") "invalid percent") (let ok7 (check_err "query_decode bad escape in key" (url.query_decode "%zz=1") "invalid percent") (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7))))))))) (define (test_query_encode) (let pairs (cons (cons "a b" "c&d") (cons (cons "k" "v") nil)) (let ok1 (check_ok "query_encode percent" (cons (quote Ok) (cons (url.query_encode pairs) nil)) "a%20b=c%26d&k=v") (let ok2 (check_ok "query_encode empty" (cons (quote Ok) (cons (url.query_encode nil) nil)) "") (let ok3 (check_deep_ok "encode/decode round trip" (url.query_decode (url.query_encode pairs)) pairs) (let qs "x=1&y=a%20b&k=" (let ok4 (check_str "decode/encode round trip" (url.query_encode (result.unwrap (url.query_decode qs))) qs) (+ (+ (+ ok1 ok2) ok3) ok4)))))))) (define (main) (let failures (test_parse) (let failures (+ failures (test_query_decode)) (let failures (+ failures (test_query_encode)) (if (= failures 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int failures)))))))))
