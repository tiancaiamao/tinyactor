((import "tls" "tls") (import "tcp" "tcp") (import "net" "net") (import "os" "os") (import "option" "option") (import "result" "result") (import "str" "str") (import "random" "random") (const GARBAGE "NOT-TLS just plaintext bytes to break the handshake xx") (type Bound nil (Bound ok port lst)) (define (bind_free_port tries) (if (= tries 0) (cons (quote Bound) (cons 0 (cons -1 (cons (cons (quote Conn) (cons 0 nil)) nil)))) (let p (match (random.rand_int 20000) ((Ok r) (+ 20000 r)) ((Err _) -1)) (if (= p -1) (bind_free_port (- tries 1)) (match (tcp.listen p) ((Ok lst) (cons (quote Bound) (cons 1 (cons p (cons lst nil))))) ((Err _) (bind_free_port (- tries 1)))))))) (define (check label ok) (if ok (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (scenario_wrap_garbage) (let bound (bind_free_port 50) (match bound ((Bound 0 _ _) (begin (print "FAIL - bind (wrap scenario)") 1)) ((Bound 1 port lst) (match (tcp.connect "127.0.0.1" port 3000) ((Err _) (begin (print "FAIL - connect (wrap scenario)") (tcp.close lst) 1)) ((Ok cli) (let srv (match (tcp.accept lst) ((Ok s) s) (_ (cons (quote Conn) (cons -1 nil)))) (let w (match (tcp.write srv (quote GARBAGE)) ((Ok _) 0) (_ 1)) (let f (match (tls.wrap cli "") ((Err _) (check "plaintext peer fails the handshake" true)) ((Ok _) (check "plaintext peer fails the handshake" false))) (let f2 (check "write to server ok" (= w 0)) (let f3 (check "close client after failed wrap" (= (unwrap1 (tcp.close cli)) 1)) (let f4 (check "close server" (= (unwrap1 (tcp.close srv)) 1)) (let f5 (check "close listener" (= (unwrap1 (tcp.close lst)) 1)) (+ (+ (+ (+ f f2) f3) f4) f5)))))))))))))) (define (unwrap1 r) (match r ((Ok v) v) ((Err _) 0))) (define (garbage_client main port) (let r (tls.connect "127.0.0.1" port 3000) (match r ((Err _) (send main 1)) ((Ok _) (send main 0))))) (define (scenario_connect_garbage) (let me (self) (let bound (bind_free_port 50) (match bound ((Bound 0 _ _) (begin (print "FAIL - bind (connect scenario)") 1)) ((Bound 1 port lst) (begin (spawn (lambda nil (garbage_client me port) nil)) (let srv (match (tcp.accept lst) ((Ok s) s) (_ (cons (quote Conn) (cons -1 nil))))) (let _ (tcp.write srv (quote GARBAGE))) (let got_err (match (recv_after 10000) (1 true) (_ false))) (let f (check "connect against plaintext peer is Err" got_err)) (let _ (tcp.close srv)) (let _ (tcp.close lst)) f)))))) (define (scenario_stale) (let f1 (match (tls.read (cons (quote Tls) (cons 1048576 nil)) 64) ((Err (cons (quote IoErr) (cons e nil))) (check "stale read is Err(IoErr(EBADF))" (> e 0))) (_ (check "stale read is Err(IoErr(EBADF))" false))) (let f2 (match (tls.write (cons (quote Tls) (cons 1048576 nil)) "x") ((Err (cons (quote IoErr) (cons e nil))) (check "stale write is Err(IoErr(EBADF))" (> e 0))) (_ (check "stale write is Err(IoErr(EBADF))" false))) (let f3 (match (tls.close (cons (quote Tls) (cons 1048576 nil))) ((Err _) (check "stale close is Err" true)) (_ (check "stale close is Err" false))) (+ (+ f1 f2) f3))))) (define (parse_host_port spec) (let i (str.index_of spec ":") (if (< i 0) (cons (quote Pair) (cons "" (cons -1 nil))) (let port (str.to_int (str.substr spec (+ i 1) (- (- (str.length spec) i) 1))) (cons (quote Pair) (cons (str.substr spec 0 i) (cons port nil))))))) (define (scenario_handshake) (match (os.getenv "TA_TLS_TEST") ((quote None) (begin (print "ok - handshake scenario skipped (set TA_TLS_TEST=host:port)") 0)) ((Some spec) (let hp (parse_host_port spec) (match hp ((Pair host port) (if (< port 0) (begin (print "FAIL - TA_TLS_TEST needs host:port") 1) (handshake_round host port)))))))) (define (handshake_round host port) (match (tls.connect host port 5000) ((Err e) (begin (print (str.concat "FAIL - real handshake: " (str.sym_to_str (err_sym e)))) 1)) ((Ok c) (let f1 (match (tls.write c "hello-tls\n") ((Ok 10) 0) (_ (begin (print "FAIL - real handshake write") 1))) (let f2 (match (tls.read c 4096) ((Ok (cons (quote Some) (cons "slt-olleh\n" nil))) (begin (print "ok - real handshake echo") 0)) (_ (begin (print "FAIL - real handshake echo") 1))) (let cc (unwrap1 (tls.close_keep_fd c)) (let f3 (check "real handshake close_keep_fd returns the fd" (> cc 0)) (let f4 (check "raw close of the kept fd" (= (unwrap1 (tcp.close (cons (quote Conn) (cons cc nil)))) 1)) (let f5 (check "double close is Ok(1)" (= (unwrap1 (tls.close c)) 1)) (+ (+ (+ (+ f1 f2) f3) f4) f5)))))))))) (define (err_sym e) (match e ((ConnErr s) s) (_ (quote io)))) (define (main) (let total (+ (+ (+ (scenario_stale) (scenario_wrap_garbage)) (scenario_connect_garbage)) (scenario_handshake)) (if (= total 0) (print "PASS") (print (str.concat "FAIL - scenarios: " (str.from_int total)))))))
