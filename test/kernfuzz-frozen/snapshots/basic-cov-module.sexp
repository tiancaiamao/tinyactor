((define (p cond) (if cond (print "ok") (print "FAIL"))) (define (contains s sub) (>= (str.index_of s sub) 0)) (define (main) (begin (p (= (cov.hit 0) 1)) (p (= (cov.hit 0) 1)) (p (= (cov.hit 3) 1)) (p (= (cov.hit -1) 0)) (p (= (cov.reset) 1)) (cov.hit 2) (let dump_path "/tmp/tinyactor-cov-module-test.txt") (p (= (cov.dump dump_path) 1)) (let dump (file.read dump_path)) (p (> (str.length dump) 0)) (p (contains dump "2 1\n")) (p (contains dump "0 0\n")) (p (contains dump "3 0\n")))))
