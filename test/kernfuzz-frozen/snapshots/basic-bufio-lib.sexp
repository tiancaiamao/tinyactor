((import "net") (import "str") (import "bufio") (define (write_all fd data) (match (net.write fd data) (-1 -1) (n (null? n) (write_all fd data)) (n (< n (str.length data)) (write_all fd (str.substr data n (- (str.length data) n)))) (n n))) (define (repeat s n acc) (if (= n 0) acc (repeat s (- n 1) (str.concat acc s)))) (define (test_read_line) (let s (net.listen 8192) (if (= s -1) (print "FAIL: listen 8192") (let c1 (net.connect "127.0.0.1" 8192) (let a1 (net.accept s) (begin (write_all c1 "alpha\nbeta\ngamma") (net.close c1) (let r1 (bufio.reader_new a1)) (let g1 (bufio.read_line r1)) (print (car g1)) (let g2 (bufio.read_line (cdr g1))) (print (car g2)) (let g3 (bufio.read_line (cdr g2))) (print (car g3)) (let g4 (bufio.read_line (cdr g3))) (print (car g4)) (net.close a1) (let c2 (net.connect "127.0.0.1" 8192)) (let a2 (net.accept s)) (write_all c2 "one\n\nthree") (net.close c2) (let r2 (bufio.reader_new a2)) (let h1 (bufio.read_line r2)) (print (car h1)) (let h2 (bufio.read_line (cdr h1))) (print (str.from_int (str.length (car h2)))) (let h3 (bufio.read_line (cdr h2))) (print (car h3)) (let h4 (bufio.read_line (cdr h3))) (print (car h4)) (net.close a2) (net.close s))))))) (define (test_read_until) (let s (net.listen 8193) (if (= s -1) (print "FAIL: listen 8193") (let c1 (net.connect "127.0.0.1" 8193) (let a1 (net.accept s) (begin (write_all c1 "aa|bb|cc") (net.close c1) (let r1 (bufio.reader_new a1)) (let g1 (bufio.read_until r1 "|")) (print (car g1)) (let g2 (bufio.read_until (cdr g1) "|")) (print (car g2)) (let g3 (bufio.read_until (cdr g2) "|")) (print (car g3)) (let g4 (bufio.read_until (cdr g3) "|")) (print (car g4)) (net.close a1) (let c2 (net.connect "127.0.0.1" 8193)) (let a2 (net.accept s)) (write_all c2 "x,,z") (net.close c2) (let r2 (bufio.reader_new a2)) (let h1 (bufio.read_until r2 ",")) (print (car h1)) (let h2 (bufio.read_until (cdr h1) ",")) (print (str.from_int (str.length (car h2)))) (let h3 (bufio.read_until (cdr h2) ",")) (print (car h3)) (let h4 (bufio.read_until (cdr h3) ",")) (print (car h4)) (net.close a2) (let c3 (net.connect "127.0.0.1" 8193)) (let a3 (net.accept s)) (write_all c3 "p,q,") (net.close c3) (let r3 (bufio.reader_new a3)) (let k1 (bufio.read_until r3 ",")) (print (car k1)) (let k2 (bufio.read_until (cdr k1) ",")) (print (car k2)) (let k3 (bufio.read_until (cdr k2) ",")) (print (car k3)) (net.close a3) (net.close s))))))) (define (test_read_exact) (let s (net.listen 8194) (if (= s -1) (print "FAIL: listen 8194") (let c1 (net.connect "127.0.0.1" 8194) (let a1 (net.accept s) (begin (write_all c1 "abcdefghij") (net.close c1) (let r1 (bufio.reader_new a1)) (let g1 (bufio.read_exact r1 4)) (print (car g1)) (let g2 (bufio.read_exact (cdr g1) 6)) (print (car g2)) (net.close a1) (let c2 (net.connect "127.0.0.1" 8194)) (let a2 (net.accept s)) (write_all c2 (repeat "0123456789" 1000 "")) (net.close c2) (let r2 (bufio.reader_new a2)) (let h1 (bufio.read_exact r2 5000)) (let d1 (car h1)) (print (str.from_int (str.length d1))) (print (str.from_int (str.char_at d1 0))) (print (str.from_int (str.char_at d1 4999))) (let h2 (bufio.read_exact (cdr h1) 5000)) (let d2 (car h2)) (print (str.from_int (str.length d2))) (print (str.from_int (str.char_at d2 0))) (net.close a2) (let c3 (net.connect "127.0.0.1" 8194)) (let a3 (net.accept s)) (write_all c3 "short") (net.close c3) (let r3 (bufio.reader_new a3)) (let k1 (bufio.read_exact r3 10)) (print (car k1)) (net.close a3) (net.close s))))))) (define (test_read_available) (let s (net.listen 8195) (if (= s -1) (print "FAIL: listen 8195") (let c1 (net.connect "127.0.0.1" 8195) (let a1 (net.accept s) (begin (write_all c1 "buffered") (net.close c1) (let r1 (bufio.reader_new a1)) (let g1 (bufio.read_available r1)) (print (car g1)) (let g2 (bufio.read_available (cdr g1))) (print (car g2)) (net.close a1) (let c2 (net.connect "127.0.0.1" 8195)) (let a2 (net.accept s)) (write_all c2 "part1\npart2") (let r2 (bufio.reader_new a2)) (let h1 (bufio.read_line r2)) (print (car h1)) (write_all c2 "part3") (let h2 (bufio.read_available (cdr h1))) (print (car h2)) (net.close c2) (let h3 (bufio.read_available (cdr h2))) (print (car h3)) (net.close a2) (net.close s))))))) (define (main) (begin (test_read_line) (test_read_until) (test_read_exact) (test_read_available) (print "PASS"))))
