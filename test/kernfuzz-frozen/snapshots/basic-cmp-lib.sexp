((import "cmp" "cmp") (import "str" "str") (define (check label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat (str.from_int got) (str.concat ", want " (str.from_int want)))))))) (if pass 1 0)))) (define (sign n) (if (< n 0) -1 (if (> n 0) 1 0))) (define (main) (let ok1 (check "int_cmp lt" (sign (cmp.int_cmp 1 2)) -1) (let ok2 (check "int_cmp eq" (sign (cmp.int_cmp 2 2)) 0) (let ok3 (check "int_cmp gt" (sign (cmp.int_cmp 3 2)) 1) (let ok4 (check "float_cmp lt" (sign (cmp.float_cmp (float "1.5") (float "2.5"))) -1) (let ok5 (check "float_cmp eq" (sign (cmp.float_cmp (float "2.5") (float "2.5"))) 0) (let ok6 (check "float_cmp gt" (sign (cmp.float_cmp (float "3.5") (float "2.5"))) 1) (let ok7 (check "str_cmp lt" (sign (cmp.str_cmp "apple" "banana")) -1) (let ok8 (check "str_cmp eq" (sign (cmp.str_cmp "apple" "apple")) 0) (let ok9 (check "str_cmp gt" (sign (cmp.str_cmp "banana" "apple")) 1) (let ok10 (check "str_cmp prefix" (sign (cmp.str_cmp "app" "apple")) -1) (let ok11 (check "str_cmp first char" (sign (cmp.str_cmp "b" "ab")) 1) (let ok12 (check "str_cmp both empty" (sign (cmp.str_cmp "" "")) 0) (let total (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8) ok9) ok10) ok11) ok12) (if (= total 12) (print "PASS") (print (str.concat "FAIL - " (str.concat (str.from_int (- 12 total)) " of 12 checks failed")))))))))))))))))))
