((import "tinyactor:lib/option" "tinyactor:lib/option") (define (main) (begin (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (tuple (quote option.Some) 2)))) (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (quote option.None)))) (print (option.unwrap_or 0 (option.bind (lambda (x) (tuple (quote option.Some) (+ x 1)) nil) (tuple (quote option.Some) 1)))) (print (option.unwrap_or 0 (option.bind (lambda (x) (tuple (quote option.Some) (+ x 1)) nil) (quote option.None)))) (print (option.unwrap_or "no" (option.bind (lambda (x) (quote option.None) nil) (tuple (quote option.Some) "no")))) (print (option.is_some (tuple (quote option.Some) 1))) (print (option.is_some (quote option.None))) (print (option.is_none (tuple (quote option.Some) 1))) (print (option.is_none (quote option.None))) (if (option.is_some (tuple (quote option.Some) 1)) (print "IF-SOME") (print "IF-NONE")) (print (option.unwrap (tuple (quote option.Some) 7))) (print (option.unwrap_or 0 (tuple (quote option.Some) 7))) (print (option.unwrap_or 0 (quote option.None))) (print (option.unwrap (option.or (tuple (quote option.Some) 7) (tuple (quote option.Some) 8)))) (print (option.unwrap (option.or (quote option.None) (tuple (quote option.Some) 7)))) (print (option.unwrap_or 0 (option.or (quote option.None) (quote option.None)))) (print (option.values (list (tuple (quote option.Some) 1) (quote option.None) (tuple (quote option.Some) 3)))) (print (option.values (list (quote option.None) (quote option.None)))) (print "PASS"))))
