((import "option" "option") (define (main) (begin (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (cons (quote Some) (cons 2 nil))))) (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (quote None)))) (print (option.unwrap_or 0 (option.bind (lambda (x) (cons (quote Some) (cons (+ x 1) nil)) nil) (cons (quote Some) (cons 1 nil))))) (print (option.unwrap_or 0 (option.bind (lambda (x) (cons (quote Some) (cons (+ x 1) nil)) nil) (quote None)))) (print (option.unwrap_or "no" (option.bind (lambda (x) (quote None) nil) (cons (quote Some) (cons "no" nil))))) (print (option.is_some (cons (quote Some) (cons 1 nil)))) (print (option.is_some (quote None))) (print (option.is_none (cons (quote Some) (cons 1 nil)))) (print (option.is_none (quote None))) (if (option.is_some (cons (quote Some) (cons 1 nil))) (print "IF-SOME") (print "IF-NONE")) (print (option.unwrap (cons (quote Some) (cons 7 nil)))) (print (option.unwrap_or 0 (cons (quote Some) (cons 7 nil)))) (print (option.unwrap_or 0 (quote None))) (print (option.unwrap (option.or (cons (quote Some) (cons 7 nil)) (cons (quote Some) (cons 8 nil))))) (print (option.unwrap (option.or (quote None) (cons (quote Some) (cons 7 nil))))) (print (option.unwrap_or 0 (option.or (quote None) (quote None)))) (print (option.values (list (cons (quote Some) (cons 1 nil)) (quote None) (cons (quote Some) (cons 3 nil))))) (print (option.values (list (quote None) (quote None)))) (print "PASS"))))
