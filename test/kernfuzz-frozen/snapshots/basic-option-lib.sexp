((import "tinyactor:lib/option" "tinyactor:lib/option") (define (main) (begin (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (tuple (quote Some) 2)))) (print (option.unwrap_or 0 (option.map (lambda (x) (* x 2) nil) (quote None)))) (print (option.unwrap_or 0 (option.bind (lambda (x) (tuple (quote Some) (+ x 1)) nil) (tuple (quote Some) 1)))) (print (option.unwrap_or 0 (option.bind (lambda (x) (tuple (quote Some) (+ x 1)) nil) (quote None)))) (print (option.unwrap_or "no" (option.bind (lambda (x) (quote None) nil) (tuple (quote Some) "no")))) (print (option.is_some (tuple (quote Some) 1))) (print (option.is_some (quote None))) (print (option.is_none (tuple (quote Some) 1))) (print (option.is_none (quote None))) (if (option.is_some (tuple (quote Some) 1)) (print "IF-SOME") (print "IF-NONE")) (print (option.unwrap (tuple (quote Some) 7))) (print (option.unwrap_or 0 (tuple (quote Some) 7))) (print (option.unwrap_or 0 (quote None))) (print (option.unwrap (option.or (tuple (quote Some) 7) (tuple (quote Some) 8)))) (print (option.unwrap (option.or (quote None) (tuple (quote Some) 7)))) (print (option.unwrap_or 0 (option.or (quote None) (quote None)))) (print (option.values (list (tuple (quote Some) 1) (quote None) (tuple (quote Some) 3)))) (print (option.values (list (quote None) (quote None)))) (print "PASS"))))
