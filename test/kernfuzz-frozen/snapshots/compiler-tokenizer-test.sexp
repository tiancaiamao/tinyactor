((import "tinyactor:lib/bootstrap/tokenizer" "tinyactor:lib/bootstrap/tokenizer") (define (print_token t) (begin (print (tokenizer.tok_tag t)) (print (tokenizer.tok_text t)))) (define (print_tokens toks) (if (null? toks) (print "PASS") (begin (print_token (car toks)) (print_tokens (cdr toks))))) (define (main) (let src "fn add(x) { x + 1 }" (let toks (tokenizer.tokenize src) (print_tokens toks)))))
