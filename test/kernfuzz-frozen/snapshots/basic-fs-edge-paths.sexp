((import "fs" "fs") (import "result" "result") (import "str" "str") (define (check label ok) (if ok (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (main) (let sandbox "/tmp/tinyactor-fs-edge" (let stale (fs.remove sandbox) (begin (check "stale sandbox gone" (match stale ((cons (quote Ok) (cons _ nil)) true) ((cons (quote Err) (cons _ nil)) true))) (let mk (fs.mkdir_p sandbox)) (check "mkdir_p sandbox" (= mk 1)) (let target (str.concat sandbox "/edge-file.txt")) (let st_missing (fs.stat (str.concat sandbox "/missing.txt"))) (check "stat nonexistent is Err" (match st_missing ((cons (quote Err) (cons _ nil)) true) (_ false))) (let ld_missing (fs.list_dir (str.concat sandbox "/missing-dir"))) (check "list_dir nonexistent is Err" (match ld_missing ((cons (quote Err) (cons _ nil)) true) (_ false))) (let rm_missing (fs.remove (str.concat sandbox "/missing.txt"))) (check "remove nonexistent is Err" (match rm_missing ((cons (quote Err) (cons _ nil)) true) (_ false))) (let w (buf.new)) (buf.push_string w "edge") (check "write_to sandbox" (= (buf.write_to w target) 1)) (let back (buf.from_file target)) (check "write_to wrote the bytes" (= (buf.length back) 4)) (let st (fs.stat target)) (check "stat existing is Ok" (match st ((cons (quote Ok) (cons _ nil)) true) (_ false))) (let ld (fs.list_dir sandbox)) (check "list_dir existing is Ok" (match ld ((cons (quote Ok) (cons _ nil)) true) (_ false))) (let rm (fs.remove target)) (check "remove existing is Ok" (match rm ((cons (quote Ok) (cons _ nil)) true) (_ false))) (let rm2 (fs.remove target)) (check "remove again is Err" (match rm2 ((cons (quote Err) (cons _ nil)) true) (_ false))) (print "PASS"))))))
