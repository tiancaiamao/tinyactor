((import "tinyactor:lib/result" "tinyactor:lib/result") (define (main) (begin (print (result.unwrap_or 0 (result.map (lambda (x) (* x 2) nil) (tuple (quote result.Ok) 2)))) (print (result.unwrap_or 0 (result.map (lambda (x) (* x 2) nil) (tuple (quote result.Err) -1)))) (let me (result.map_err (lambda (e) (- e 1) nil) (tuple (quote result.Err) 0))) (match me ((tuple (quote result.Ok) v) (print (str.concat "ok:" (str.from_int v)))) ((tuple (quote result.Err) e) (print (str.from_int e)))) (print (result.unwrap_or 99 (result.map_err (lambda (e) (- e 1) nil) (tuple (quote result.Ok) 99)))) (print (result.unwrap_or 0 (result.bind (lambda (x) (tuple (quote result.Ok) (+ x 1)) nil) (tuple (quote result.Ok) 1)))) (print (result.unwrap_or 0 (result.bind (lambda (x) (tuple (quote result.Ok) (+ x 1)) nil) (tuple (quote result.Err) 5)))) (print (result.unwrap_or "no" (result.bind (lambda (x) (tuple (quote result.Err) "fixed") nil) (tuple (quote result.Ok) "no")))) (print (result.unwrap_or 0 (result.try (lambda (x) (tuple (quote result.Ok) (+ x 1)) nil) (tuple (quote result.Ok) 1)))) (print (result.unwrap_or 0 (result.try (lambda (x) (tuple (quote result.Ok) (+ x 1)) nil) (tuple (quote result.Err) 5)))) (print (result.unwrap_or "no" (result.try (lambda (x) (tuple (quote result.Err) "fixed") nil) (tuple (quote result.Ok) "no")))) (print (result.is_ok (tuple (quote result.Ok) 1))) (print (result.is_ok (tuple (quote result.Err) "e"))) (print (result.is_err (tuple (quote result.Ok) 1))) (print (result.is_err (tuple (quote result.Err) "e"))) (if (result.is_ok (tuple (quote result.Ok) 1)) (print "IF-OK") (print "IF-BAD")) (print (result.unwrap (result.or (tuple (quote result.Ok) 1) (tuple (quote result.Ok) 2)))) (print (result.unwrap (result.or (tuple (quote result.Err) "a") (tuple (quote result.Ok) 2)))) (print (result.unwrap_or 0 (result.or (tuple (quote result.Err) "a") (tuple (quote result.Err) 2)))) (print (result.unwrap (tuple (quote result.Ok) 7))) (print (result.unwrap_or 0 (tuple (quote result.Ok) 7))) (print (result.unwrap_or 0 (tuple (quote result.Err) "e"))) (print "PASS"))))
