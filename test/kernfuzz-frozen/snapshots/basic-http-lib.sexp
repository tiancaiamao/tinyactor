((import "http" "http") (import "tcp" "tcp") (import "net" "net") (import "dict" "dict") (import "option" "option") (import "result" "result") (import "str" "str") (import "os" "os") (import "random" "random") (type Bound nil (Bound ok port lst)) (define (bind_free_port tries) (if (= tries 0) (cons (quote Bound) (cons 0 (cons -1 (cons (cons (quote Conn) (cons 0 nil)) nil)))) (let p (match (random.rand_int 20000) ((Ok r) (+ 20000 r)) ((Err _) -1)) (if (= p -1) (bind_free_port (- tries 1)) (match (tcp.listen p) ((Ok lst) (cons (quote Bound) (cons 1 (cons p (cons lst nil))))) ((Err _) (bind_free_port (- tries 1)))))))) (define (check_bool label pass) (if pass (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (check_eq label got want) (check_bool label (= got want))) (define (read_raw_head fd acc) (let at (str.index_of acc "\r\n\r\n") (if (>= at 0) (let split (+ at 4) (cons (str.substr acc 0 split) (str.substr acc split (- (str.length acc) split)))) (match (net.read fd 4096) ((quote eof) (cons acc "")) (-1 (cons acc "")) (d (null? d) (read_raw_head fd acc)) (d (read_raw_head fd (str.concat acc d))))))) (define (read_raw_body fd acc n) (if (>= (str.length acc) n) acc (match (net.read fd 4096) ((quote eof) acc) (-1 acc) (d (null? d) (read_raw_body fd acc n)) (d (read_raw_body fd (str.concat acc d) n))))) (define (canned_resp status_txt extra body) (str.concat (str.concat "HTTP/1.1 " (str.concat status_txt "\r\n")) (str.concat extra (str.concat "Content-Length: " (str.concat (str.from_int (str.length body)) (str.concat "\r\n\r\n" body)))))) (define (req_path head) (let line (str.substr head 0 (str.index_of head " HTTP/")) (let sp (str.index_of line " ") (str.substr line (+ sp 1) (- (- (str.length line) sp) 1))))) (define (req_line head) (str.substr head 0 (str.index_of head "\r\n"))) (define (hdr head name) (let at (str.index_of head (str.concat "\r\n" (str.concat name ": "))) (if (< at 0) "" (let vstart (+ (+ at 4) (str.