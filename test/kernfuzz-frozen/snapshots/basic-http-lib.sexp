1) (- (- (str.length line) sp) 1))))) (define (req_line head) (str.substr head 0 (str.index_of head "\r\n"))) (define (hdr head name) (let at (str.index_of head (str.concat "\r\n" (str.concat name ": "))) (if (< at 0) "" (let vstart (+ (+ at 4) (str.length name)) (let vend (str.index_of (str.substr head vstart (str.length head)) "\r\n") (str.substr (str.substr head vstart (str.length head)) 0 vend)))))) (define (raw_cl head) (str.to_int (hdr head "Content-Length"))) (define (canned_server lst left) (if (= left 0) 0 (match (tcp.accept lst) ((tuple (quote Err) _) 0) ((tuple (quote Ok) c) (match c ((tuple (quote Conn) fd) (let got (read_raw_head fd "") (let head (car got) (let rest (cdr got) (let path (req_path head) (match path ("/hop" (let _ (read_raw_body fd rest (raw_cl head)) (let _ (net.write fd (canned_resp "302 Found" "Location: /final\r\n" "")) (begin (tcp.close c) (canned_server lst (- left 1)))))) ("/loop" (let _ (net.write fd (canned_resp "302 Found" "Location: /loop\r\n" "")) (begin (tcp.close c) (canned_server lst (- left 1))))) ("/echo" (let body (read_raw_body fd rest 7) (let _ (net.write fd (canned_resp "200 OK" "" body)) (begin (tcp.close c) (canned_server lst (- left 1)))))) ("/status" (let _ (net.write fd "XYZ/1.1 abc\r\nContent-Length: 0\r\n\r\n") (begin (tcp.close c) (canned_server lst (- left 1))))) ("/nohdr" (let _ (net.write fd "HTTP/1.1 204 No Content\r\n\r\n") (begin (tcp.close c) (canned_server lst (- left 1))))) ("/silent" (receive ((quote die) (begin (tcp.close c) 0)))) (_ (let body (str.concat (req_line head) (str.concat "\n" (hdr head "Host"))) (let _ (net.write fd (canned_resp "200 OK" "Content-Type: text/plain\r\n" body)) (begin (tcp.close c) (canned_server lst (- left 1))))))))))))))))) (define (err_kind e) (match e ((tuple (quote Transport) _) "transport") ((tuple (quote BadUrl) _) "badurl") ((tuple (quote BadResponse) _) "badresponse") ((quote TooManyRedirects) "toomanyredirects") ((quote TimedOut) "timedout"))) (define (scenario_parse) (let f1 (match (http.parse_request "POST /a/b?x=1 HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nhi") ((quote None) (begin (print "FAIL - parse full request") 1)) ((tuple (quote Some) req) (match req ((tuple (quote MkReq) m p q hs b) (let f1 (check_eq "parse method" m "POST") (let f2 (check_eq "parse path" p "/a/b") (let f3 (check_eq "parse query" q "x=1") (let f4 (check_eq "parse body" b "hi") (let f5 (match (dict.get hs "Host") ((tuple (quote Some) v) (check_eq "parse header host" v "h")) ((quote None) (check_bool "parse header host" false))) (+ (+ (+ (+ f1 f2) f3) f4) f5)))))))))) (let f2 (match (http.parse_request "GET\r\n\r\n") ((quote None) (check_bool "malformed request line is None" true)) ((tuple (quote Some) _) (check_bool "malformed request line is None" false))) (let f3 (match (http.parse_request "GET /x HTTP/1.1\r\nHost: h\r\n") ((quote None) (check_bool "missing blank line is None" true)) ((tuple (quote Some) _) (check_bool "missing blank line is None" false))) (let f4 (match (http.parse_request "GET /x HTTP/1.1\r\nnot-a-header\r\nX-A: 1\r\n\r\n") ((quote None) (begin (print "FAIL - colon-less header line rejected the request") 1)) ((tuple (quote Some) req) (match req ((tuple (quote MkReq) _ _ _ hs _) (match (dict.get hs "X-A") ((tuple (quote Some) "1") (check_bool "colon-less header line skipped" true)) (_ (check_bool "colon-less header line skipped" false))))))) (let f5 (match (http.parse_request "GET /x HTTP/1.1\r\n\r\n") ((quote None) (begin (print "FAIL - request line without headers") 1)) ((tuple (quote Some) req) (match req ((tuple (quote MkReq) _ _ _ hs _) (check_bool "no header lines -> empty dict" (= (dict.size hs) 0)))))) (let f6 (match (http.parse_request "GET /x HTTP/1.1\r\nX-D: 1\r\nLoc: http://h/p\r\nX-D: 2\r\n\r\n") ((quote None) (begin (print "FAIL - duplicate header request") 1)) ((tuple (quote Some) req) (match req ((tuple (quote MkReq) _ _ _ hs _) (match (dict.get hs "X-D") ((tuple (quote Some) v) (let a (check_eq "repeated header last wins" v "2") (let b (match (dict.get hs "Loc") ((tuple (quote Some) l) (check_eq "header value keeps its colons" l "http://h/p")) ((quote None) (check_bool "header value keeps its colons" false))) (+ a b)))) ((quote None) (check_bool "repeated header last wins" false))))))) (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6)))))))) (define (scenario_render) (let hs (dict.insert (dict.insert (dict.str_new) "X-B" "2") "X-A" "1") (let f1 (check_eq "render exact bytes (dict-ordered headers)" (http.response 200 hs "hi") "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nX-A: 1\r\nX-B: 2\r\n\r\nhi") (let f2 (check_eq "caller Content-Length kept" (http.response 404 (dict.insert (dict.str_new) "Content-Length" "99") "") "HTTP/1.1 404 Not Found\r\nContent-Length: 99\r\n\r\n") (+ f1 f2))))) (define (run_client bound body) (match bound ((tuple (quote Bound) ok port lst) (if (= ok 0) (begin (print "FAIL - bind") 1) (let me (self) (let srv (spawn (lambda nil (begin (canned_server lst 14) (send me (quote server_done))) nil)) (let f1 (body port) (begin (send srv (quote die)) (let f2 (match (recv_after 15000) ((quote server_done) 0) (_ (begin (print "FAIL - canned server did not finish") 1)))) (let _ (tcp.close lst)) (+ f1 f2))))))))) (define (scenario_get port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/hello"))) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - get round trip: " (err_kind e))) 1)) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) s hs b) (let f1 (check_eq "get status" s 200) (let want (str.concat "GET /hello HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port)))) (let f2 (check_eq "get body" b want) (let f3 (match (dict.get hs "Content-Type") ((tuple (quote Some) v) (check_eq "get header content-type" v "text/plain")) ((quote None) (check_bool "get header content-type" false))) (+ (+ f1 f2) f3)))))))))) (define (scenario_url_dispatch port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/dispatch?q=1"))) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - url dispatch: " (err_kind e))) 1)) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) _ _ b) (check_eq "request rendering (target, query, Host)" b (str.concat "GET /dispatch?q=1 HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port)))))))))) (define (scenario_redirect port) (match (http.post (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/hop")) "payload") ((tuple (quote Err) e) (begin (print (str.concat "FAIL - redirect: " (err_kind e))) 1)) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) s _ b) (let f1 (check_eq "redirect final status" s 200) (let f2 (check_eq "redirect rewrote to GET, body dropped" b (str.concat "GET /final HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port))))) (+ f1 f2)))))))) (define (scenario_redirect_loop port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/loop"))) ((tuple (quote Err) (quote TooManyRedirects)) (check_bool "redirect loop is TooManyRedirects" true)) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - redirect loop got: " (err_kind e))) 1)) ((tuple (quote Ok) _) (check_bool "redirect loop is TooManyRedirects" false)))) (define (scenario_post port) (match (http.post (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/echo")) "a=1&b=2") ((tuple (quote Err) e) (begin (print (str.concat "FAIL - post: " (err_kind e))) 1)) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) s _ b) (let f1 (check_eq "post status" s 200) (let f2 (check_eq "post body framed by Content-Length" b "a=1&b=2") (+ f1 f2)))))))) (define (scenario_nohdr port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/nohdr"))) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - header-less response got: " (err_kind e))) 1)) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) s hs b) (let f1 (check_eq "header-less response status" s 204) (let f2 (check_bool "header-less response has no headers" (= (dict.size hs) 0)) (let f3 (check_eq "header-less response body empty" b "") (+ (+ f1 f2) f3))))))))) (define (scenario_garbage port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/status"))) ((tuple (quote Err) (tuple (quote BadResponse) _)) (check_bool "garbage status line is BadResponse" true)) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - garbage got: " (err_kind e))) 1)) ((tuple (quote Ok) _) (check_bool "garbage status line is BadResponse" false)))) (define (scenario_timeout port) (match (http.request "GET" (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/silent")) (dict.str_new) "" 300) ((tuple (quote Err) (quote TimedOut)) (check_bool "unanswered server is TimedOut" true)) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - timeout got: " (err_kind e))) 1)) ((tuple (quote Ok) _) (check_bool "unanswered server is TimedOut" false)))) (define (scenario_https) (match (os.getenv "TA_HTTPS_TEST") ((quote None) (begin (print "ok - https scenario skipped (set TA_HTTPS_TEST=host:port)") 0)) ((tuple (quote Some) _) (https_round)))) (define (https_round) (match (os.getenv "TA_HTTPS_TEST") ((quote None) 0) ((tuple (quote Some) spec) (let target (if (< (str.index_of spec ":") 0) (str.concat "https://" (str.concat spec "/")) (str.concat "https://" spec)) (match (http.get target) ((tuple (quote Ok) resp) (match resp ((tuple (quote MkResp) s _ _) (check_bool "https GET reaches 200/3xx" (and (>= s 200) (< s 400)))))) ((tuple (quote Err) e) (begin (print (str.concat "FAIL - https GET: " (err_kind e))) 1))))))) (define (main) (let f1 (scenario_parse) (let f2 (scenario_render) (let f3 (run_client (bind_free_port 50) (lambda (port) (+ (+ (+ (+ (+ (+ (+ (scenario_get port) (scenario_url_dispatch port)) (scenario_redirect port)) (scenario_redirect_loop port)) (scenario_post port)) (scenario_garbage port)) (scenario_nohdr port)) (scenario_timeout port)) nil)) (let f4 (scenario_https) (let total (+ (+ (+ f1 f2) f3) f4) (if (= total 0) (print "PASS") (print (str.concat "FAIL - scenarios: " (str.from_int total)))))))))))
