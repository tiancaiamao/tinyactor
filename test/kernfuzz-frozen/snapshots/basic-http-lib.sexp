h")) ((quote None) (check_bool "parse header host" false))) (+ (+ (+ (+ f1 f2) f3) f4) f5)))))))))) (let f2 (match (http.parse_request "GET\r\n\r\n") ((quote None) (check_bool "malformed request line is None" true)) ((Some _) (check_bool "malformed request line is None" false))) (let f3 (match (http.parse_request "GET /x HTTP/1.1\r\nHost: h\r\n") ((quote None) (check_bool "missing blank line is None" true)) ((Some _) (check_bool "missing blank line is None" false))) (let f4 (match (http.parse_request "GET /x HTTP/1.1\r\nnot-a-header\r\nX-A: 1\r\n\r\n") ((quote None) (begin (print "FAIL - colon-less header line rejected the request") 1)) ((Some req) (match req ((MkReq _ _ _ hs _) (match (dict.get hs "X-A") ((Some "1") (check_bool "colon-less header line skipped" true)) (_ (check_bool "colon-less header line skipped" false))))))) (+ (+ (+ f1 f2) f3) f4)))))) (define (scenario_render) (let hs (dict.insert (dict.insert (dict.str_new) "X-B" "2") "X-A" "1") (let f1 (check_eq "render exact bytes (dict-ordered headers)" (http.response 200 hs "hi") "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nX-A: 1\r\nX-B: 2\r\n\r\nhi") (let f2 (check_eq "caller Content-Length kept" (http.response 404 (dict.insert (dict.str_new) "Content-Length" "99") "") "HTTP/1.1 404 Not Found\r\nContent-Length: 99\r\n\r\n") (+ f1 f2))))) (define (run_client bound body) (match bound ((Bound 0 _ _) (begin (print "FAIL - bind") 1)) ((Bound 1 port lst) (let me (self) (let srv (spawn (lambda nil (begin (canned_server lst 13) (send me (quote server_done))) nil)) (let f1 (body port) (begin (send srv (quote die)) (let f2 (match (recv_after 15000) ((quote server_done) 0) (_ (begin (print "FAIL - canned server did not finish") 1)))) (let _ (tcp.close lst)) (+ f1 f2)))))))) (define (scenario_get port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/hello"))) ((Err e) (begin (print (str.concat "FAIL - get round trip: " (err_kind e))) 1)) ((Ok resp) (match resp ((MkResp s hs b) (let f1 (check_eq "get status" s 200) (let want (str.concat "GET /hello HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port)))) (let f2 (check_eq "get body" b want) (let f3 (match (dict.get hs "Content-Type") ((Some v) (check_eq "get header content-type" v "text/plain")) ((quote None) (check_bool "get header content-type" false))) (+ (+ f1 f2) f3)))))))))) (define (scenario_url_dispatch port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/dispatch?q=1"))) ((Err e) (begin (print (str.concat "FAIL - url dispatch: " (err_kind e))) 1)) ((Ok resp) (match resp ((MkResp _ _ b) (check_eq "request rendering (target, query, Host)" b (str.concat "GET /dispatch?q=1 HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port)))))))))) (define (scenario_redirect port) (match (http.post (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/hop")) "payload") ((Err e) (begin (print (str.concat "FAIL - redirect: " (err_kind e))) 1)) ((Ok resp) (match resp ((MkResp s _ b) (let f1 (check_eq "redirect final status" s 200) (let f2 (check_eq "redirect rewrote to GET, body dropped" b (str.concat "GET /final HTTP/1.1" (str.concat "\n" (str.concat "127.0.0.1:" (str.from_int port))))) (+ f1 f2)))))))) (define (scenario_redirect_loop port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/loop"))) ((Err (quote TooManyRedirects)) (check_bool "redirect loop is TooManyRedirects" true)) ((Err e) (begin (print (str.concat "FAIL - redirect loop got: " (err_kind e))) 1)) ((Ok _) (check_bool "redirect loop is TooManyRedirects" false)))) (define (scenario_post port) (match (http.post (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/echo")) "a=1&b=2") ((Err e) (begin (print (str.concat "FAIL - post: " (err_kind e))) 1)) ((Ok resp) (match resp ((MkResp s _ b) (let f1 (check_eq "post status" s 200) (let f2 (check_eq "post body framed by Content-Length" b "a=1&b=2") (+ f1 f2)))))))) (define (scenario_garbage port) (match (http.get (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/status"))) ((Err (cons (quote BadResponse) (cons _ nil))) (check_bool "garbage status line is BadResponse" true)) ((Err e) (begin (print (str.concat "FAIL - garbage got: " (err_kind e))) 1)) ((Ok _) (check_bool "garbage status line is BadResponse" false)))) (define (scenario_timeout port) (match (http.request "GET" (str.concat "http://127.0.0.1:" (str.concat (str.from_int port) "/silent")) (dict.str_new) "" 300) ((Err (quote TimedOut)) (check_bool "unanswered server is TimedOut" true)) ((Err e) (begin (print (str.concat "FAIL - timeout got: " (err_kind e))) 1)) ((Ok _) (check_bool "unanswered server is TimedOut" false)))) (define (scenario_https) (match (os.getenv "TA_HTTPS_TEST") ((quote None) (begin (print "ok - https scenario skipped (set TA_HTTPS_TEST=host:port)") 0)) ((Some _) (https_round)))) (define (https_round) (match (os.getenv "TA_HTTPS_TEST") ((quote None) 0) ((Some spec) (let target (if (< (str.index_of spec ":") 0) (str.concat "https://" (str.concat spec "/")) (str.concat "https://" spec)) (match (http.get target) ((Ok resp) (match resp ((MkResp s _ _) (check_bool "https GET reaches 200/3xx" (and (>= s 200) (< s 400)))))) ((Err e) (begin (print (str.concat "FAIL - https GET: " (err_kind e))) 1))))))) (define (main) (let f1 (scenario_parse) (let f2 (scenario_render) (let f3 (run_client (bind_free_port 50) (lambda (port) (+ (+ (+ (+ (+ (+ (scenario_get port) (scenario_url_dispatch port)) (scenario_redirect port)) (scenario_redirect_loop port)) (scenario_post port)) (scenario_garbage port)) (scenario_timeout port)) nil)) (let f4 (scenario_https) (let total (+ (+ (+ f1 f2) f3) f4) (if (= total 0) (print "PASS") (print (str.concat "FAIL - scenarios: " (str.from_int total)))))))))))
