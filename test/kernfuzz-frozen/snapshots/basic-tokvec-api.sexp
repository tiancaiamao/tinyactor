((import "tinyactor:lib/vm" "tinyactor:lib/vm") (import "tinyactor:lib/bootstrap/tokenizer" "tokenizer") (define (main) (let toks (cons (tuple (quote tokenizer.TInt) 42 0) (cons (tuple (quote tokenizer.TString) "hi" 5) (cons (tuple (quote tokenizer.TInt) 0 9) nil))) (let id (vm.make_tok_vec toks) (let c0 (if (null? id) 0 1) (let c1 (if (= (vm.tok_type id 0) (quote int)) 1 0) (let c2 (if (= (vm.tok_type id 1) (quote string)) 1 0) (let c3 (if (= (vm.tok_val id 0) 42) 1 0) (let c4 (if (= (vm.tok_val id 1) "hi") 1 0) (let c5 (if (= (vm.tok_at id 1) 5) 1 0) (let c6 (if (= (vm.tok_type id 99) (quote eof)) 1 0) (let c7 (if (null? (vm.tok_val id 99)) 1 0) (let c8 (if (= (vm.tok_at id 99) 0) 1 0) (begin (vm.free_tok_vec id) (let c9 (if (null? (vm.tok_val id 0)) 1 0)) (let c11 (if (= (vm.tok_type id 0) (quote eof)) 1 0)) (let me (self)) (let n (spawn (lambda nil (let t (vm.make_tok_vec (cons (tuple (quote tokenizer.TInt) 7 0) nil)) (if (null? t) (send me 0) (send me (vm.tok_val t 0)))) nil))) (let got (recv)) (let c10 (if (= got 7) 1 0)) (let total (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ c0 c1) c2) c3) c4) c5) c6) c7) c8) c9) c10) c11)) (if (= total 12) (print "PASS tokvec-api") (print "FAIL tokvec-api"))))))))))))))))
