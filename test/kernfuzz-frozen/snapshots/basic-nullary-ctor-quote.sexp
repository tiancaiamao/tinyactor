((import "str" "str") (type Flag nil (quote Flag)) (type Mode nil (quote Read) (quote Write)) (type-sig use (Flag) Int) (define (use f) (match f ((quote Flag) 1))) (type-sig mode_int (Mode) Int) (define (mode_int m) (match m ((quote Read) 10) ((quote Write) 20))) (define (id x) x) (type-sig sym_eq (Symbol) Int) (define (sym_eq s) (if (= s (quote id)) 1 0)) (define (main) (begin (print (str.from_int (use (quote Flag)))) (print (str.from_int (mode_int (quote Read)))) (print (str.from_int (mode_int (quote Write)))) (print (str.from_int (sym_eq (quote id)))) (print "PASS"))))
