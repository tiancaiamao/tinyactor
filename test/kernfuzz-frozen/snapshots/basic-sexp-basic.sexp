((import "sexp" "sexp") (define (p cond) (if cond (print "ok") (print "FAIL"))) (define (main) (let r (sexp.parse "(a b 42)") (begin (p (pair? r)) (p (= (car (car r)) (quote a))) (p (= (car (cdr (car r))) (quote b))) (p (= (car (cdr (cdr (car r)))) 42)) (p (null? (cdr (cdr (cdr (car r)))))) (let rq (sexp.parse "'x")) (p (pair? rq)) (p (= (car (car rq)) (quote quote))) (p (= (car (cdr (car rq))) (quote x))) (p (null? (cdr (cdr (car rq))))) (let rl (sexp.parse "() (nil) (true) (false)")) (p (null? (car rl))) (p (null? (car (car (cdr rl))))) (p (= (car (car (cdr (cdr rl)))) true)) (p (= (car (car (cdr (cdr (cdr rl))))) false)) (let rn (sexp.parse "-1")) (p (= (car rn) -1)) (let rs (sexp.parse "(print \"hi\\n\")")) (p (= (car (cdr (car rs))) "hi\n")) (let rc (sexp.parse "; head comment\n(+ 1 2) ; tail")) (p (= (car (car rc)) (quote +))) (p (= (car (cdr (cdr (car rc)))) 2)) (p (null? (cdr rc))) (let rm (sexp.parse "(def f 1) (def g 2)")) (p (pair? (cdr rm))) (p (= (sexp.parse "(a") -1)) (p (!= (sexp.err) "")) (p (= (sexp.parse "\"abc") -1)) (p (= (sexp.parse ")") -1)) (p (= (sexp.parse "99999999999999999999") -1)) (p (= (sexp.parse 42) -1)) (p (= (car (sexp.parse "140737488355327")) 140737488355327)) (p (null? (sexp.parse "")))))))
