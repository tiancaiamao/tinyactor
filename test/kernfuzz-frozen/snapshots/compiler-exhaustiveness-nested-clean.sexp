((type Opt nil (Some a) (quote None)) (type Res nil (Ok a) (Err b)) (type Buf nil (Buf (quote Int))) (type Step nil (Step (quote Opt) (quote Int))) (type-sig res_or (Res nil) Int) (define (res_or x d) (match x ((tuple (quote Ok) v) v) ((tuple (quote Err) e) d))) (type-sig buf_len (Buf) Int) (define (buf_len b) (match b ((tuple (quote Buf) h) h))) (type-sig some_pair (Opt) Int) (define (some_pair o) (match o ((tuple (quote Some) (tuple (quote Pair) a k)) a) ((quote None) 0))) (type-sig step_opt (Step) Int) (define (step_opt s) (match s ((tuple (quote Step) inner rest) (match inner ((tuple (quote Some) v) (+ v rest)) ((quote None) rest))))) (define (main) (begin (print (str.from_int (res_or (tuple (quote Ok) 7) 0))) (print (str.from_int (res_or (tuple (quote Err) "x") 8))) (print (str.from_int (buf_len (tuple (quote Buf) 9)))) (print (str.from_int (some_pair (quote None)))) (print (str.from_int (some_pair (tuple (quote Some) (tuple (quote Pair) 3 true))))) (print (str.from_int (step_opt (tuple (quote Step) (tuple (quote Some) 4) 1)))) (print (str.from_int (step_opt (tuple (quote Step) (quote None) 1)))) (print "PASS"))))
