((type Opt nil (Some a) (quote None)) (type Res nil (Ok a) (Err b)) (type Buf nil (Buf (quote Int))) (type Step nil (Step (quote Opt) (quote Int))) (type-sig res_or (Res nil) Int) (define (res_or x d) (match x ((cons (quote Ok) (cons v nil)) v) ((cons (quote Err) (cons e nil)) d))) (type-sig buf_len (Buf) Int) (define (buf_len b) (match b ((cons (quote Buf) (cons h nil)) h))) (type-sig some_pair (Opt) Int) (define (some_pair o) (match o ((cons (quote Some) (cons (cons (quote Pair) (cons a (cons k nil))) nil)) a) ((quote None) 0))) (type-sig step_opt (Step) Int) (define (step_opt s) (match s ((cons (quote Step) (cons inner (cons rest nil))) (match inner ((cons (quote Some) (cons v nil)) (+ v rest)) ((quote None) rest))))) (define (main) (begin (print (str.from_int (res_or (cons (quote Ok) (cons 7 nil)) 0))) (print (str.from_int (res_or (cons (quote Err) (cons "x" nil)) 8))) (print (str.from_int (buf_len (cons (quote Buf) (cons 9 nil))))) (print (str.from_int (some_pair (quote None)))) (print (str.from_int (some_pair (cons (quote Some) (cons (cons (quote Pair) (cons 3 (cons true nil))) nil))))) (print (str.from_int (step_opt (cons (quote Step) (cons (cons (quote Some) (cons 4 nil)) (cons 1 nil)))))) (print (str.from_int (step_opt (cons (quote Step) (cons (quote None) (cons 1 nil)))))) (print "PASS"))))
