((import "tinyactor:lib/net" "tinyactor:lib/net") (import "tinyactor:lib/option" "tinyactor:lib/option") (import "tinyactor:lib/str" "tinyactor:lib/str") (import "tinyactor:lib/list" "tinyactor:lib/list") (import "tinyactor:lib/random" "tinyactor:lib/random") (import "tinyactor:lib/result" "tinyactor:lib/result") (define (connect_retry host port timeout) (let r (net.connect_timeout host port timeout) (match r (nil (connect_retry host port timeout)) (x x)))) (define (accept_retry s) (let a (net.accept s) (match a (nil (accept_retry s)) (x x)))) (define (read_retry fd) (let d (net.read fd 4096) (match d (nil (read_retry fd)) (x x)))) (type Bound nil (Bound (nil sock) (nil port))) (define (bound_sock b) (match b ((tuple (quote Bound) sock _) sock))) (define (bound_port b) (match b ((tuple (quote Bound) _ port) port))) (define (bind_random_port tries) (if (= tries 0) (quote option.None) (let r (random.rand_int 20000) (let p (match r ((tuple (quote result.Ok) p) (+ 20000 p)) (_ -1)) (if (= p -1) (bind_random_port (- tries 1)) (let s (net.listen p) (if (= s -1) (bind_random_port (- tries 1)) (tuple (quote option.Some) (tuple (quote Bound) s p))))))))) (define (main) (match (bind_random_port 50) ((quote option.None) (print "FAIL - listen")) ((tuple (quote option.Some) b) (let lst (bound_sock b) (let port (bound_port b) (match (connect_retry "localhost" port 5000) (cli (and (int? cli) (> cli 0)) (let srv (accept_retry lst) (let payload "hello-hostname" (let w (net.write cli payload) (let got (read_retry srv) (begin (if (and (= w (str.length payload)) (= got payload)) (print "PASS") (print "FAIL - echo roundtrip")) (net.close cli) (net.close srv) (net.close lst))))))) (_ (begin (print "FAIL - localhost connect") (net.close lst))))))))))
