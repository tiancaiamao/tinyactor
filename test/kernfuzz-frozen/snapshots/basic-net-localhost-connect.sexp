((import "net" "net") (import "str" "str") (import "list" "list") (import "random" "random") (define (connect_retry host port timeout) (let r (net.connect host port timeout) (match r (nil (connect_retry host port timeout)) (x x)))) (define (accept_retry s) (let a (net.accept s) (match a (nil (accept_retry s)) (x x)))) (define (read_retry fd) (let d (net.read fd 4096) (match d (nil (read_retry fd)) (x x)))) (define (bind_random_port tries) (if (= tries 0) -1 (let r (random.rand_int 20000) (let p (match r ((cons (quote Ok) (cons p nil)) (+ 20000 p)) (_ -1)) (if (= p -1) (bind_random_port (- tries 1)) (let s (net.listen p) (if (= s -1) (bind_random_port (- tries 1)) (cons s p)))))))) (define (main) (match (bind_random_port 50) (-1 (print "FAIL - listen")) (bound (let lst (car bound) (let port (cdr bound) (match (connect_retry "localhost" port 5000) (cli (and (int? cli) (> cli 0)) (let srv (accept_retry lst) (let payload "hello-hostname" (let w (net.write cli payload) (let got (read_retry srv) (begin (if (and (= w (str.length payload)) (= got payload)) (print "PASS") (print "FAIL - echo roundtrip")) (net.close cli) (net.close srv) (net.close lst))))))) (_ (begin (print "FAIL - localhost connect") (net.close lst))))))))))
