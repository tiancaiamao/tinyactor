((import "tinyactor:lib/bootstrap/typecheck" "typecheck") (import "tinyactor:lib/option" "option") (import "tinyactor:lib/str" "tinyactor:lib/str") (define (p cond) (if cond (print "ok") (print "FAIL"))) (type-sig deep_eq (nil nil) Bool) (define (deep_eq a b) (if (pair? a) (if (pair? b) (and (deep_eq (car a) (car b)) (deep_eq (cdr a) (cdr b))) false) (if (tuple? a) (if (and (tuple? b) (= (tuple-len a) (tuple-len b))) (deep_eq_slots a b 0 (tuple-len a)) false) (if (int? a) (if (int? b) (= a b) false) (if (string? a) (if (string? b) (= a b) false) (if (symbol? a) (if (symbol? b) (= a b) false) (and (null? a) (null? b)))))))) (type-sig deep_eq_slots (nil nil nil nil) Bool) (define (deep_eq_slots a b i n) (if (>= i n) true (and (deep_eq (tuple-ref a i) (tuple-ref b i)) (deep_eq_slots a b (+ i 1) n)))) (type-sig roundtrips (nil) Bool) (define (roundtrips bindings) (deep_eq (typecheck.env_of_forms (typecheck.env_forms bindings)) bindings)) (define (tys) (let base (tuple (quote typecheck.TyBase) (quote typecheck.BInt)) (list base (tuple (quote typecheck.TyBase) (tuple (quote typecheck.BName) (quote option.Option))) (tuple (quote typecheck.TyVar) 7 1) (tuple (quote typecheck.TyArrow) base (tuple (quote typecheck.TyVar) 2 0)) (tuple (quote typecheck.TyApp) (quote List) (cons base nil)) (tuple (quote typecheck.TyApp) (quote Map) (cons base (cons (tuple (quote typecheck.TyVar) 3 0) nil))) (tuple (quote typecheck.TyForall) (cons 1 (cons 2 nil)) (tuple (quote typecheck.TyArrow) base (tuple (quote typecheck.TyVar) 1 0)))))) (define (env_of_tys ts i) (if (null? ts) nil (cons (cons i (car ts)) (env_of_tys (cdr ts) (+ i 1))))) (type-sig check_tys (nil nil) Bool) (define (check_tys ts i) (if (null? ts) true (let ok (roundtrips (cons (cons i (car ts)) nil)) (if ok (check_tys (cdr ts) (+ i 1)) (begin (print (str.concat "FAIL ty " (str.from_int i))) false))))) (define (main) (begin (p (check_tys (tys) 0)) (p (roundtrips (env_of_tys (tys) 0))) (p (roundtrips nil)) (p (roundtrips (cons (cons (quote P) (cons (quote ctor) (tuple (quote typecheck.TyBase) (quote typecheck.BInt)))) nil))) (p (roundtrips (cons (cons (quote Color) (cons (quote typedecl) (cons (quote Red) (cons (quote Green) nil)))) nil))) (let mixed (cons (cons (quote a) (tuple (quote typecheck.TyBase) (quote typecheck.BInt))) (cons (cons (quote Color) (cons (quote typedecl) (cons (quote Red) nil))) (cons (cons (quote P) (cons (quote ctor) (tuple (quote typecheck.TyArrow) (tuple (quote typecheck.TyBase) (quote typecheck.BInt)) (tuple (quote typecheck.TyVar) 1 0)))) nil)))) (p (roundtrips mixed)) (p (= (deep_eq (tuple (quote typecheck.TyBase) (quote typecheck.BInt)) (tuple (quote typecheck.TyBase) (quote typecheck.BFloat))) false)) (p (= (deep_eq (tuple (quote Box) (quote typecheck.BInt)) (tuple (quote Box) (quote typecheck.BInt) (quote typecheck.BInt))) false)) (p (= (deep_eq (cons (quote a) nil) (cons (quote b) nil)) false)) (p (= (deep_eq (tuple (quote typecheck.TyVar) 1 0) (cons (quote typecheck.TyVar) (cons 1 (cons 0 nil)))) false)))))
