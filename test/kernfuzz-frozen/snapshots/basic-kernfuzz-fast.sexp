((import "tinyactor:lib/str" "tinyactor:lib/str") (import "tinyactor:tools/kernfuzz/fast" "tinyactor:tools/kernfuzz/fast") (import "tinyactor:tools/kernfuzz/tafuzz_arm" "tinyactor:tools/kernfuzz/tafuzz_arm") (import "tinyactor:tools/kernfuzz/tafuzz_cmp" "tinyactor:tools/kernfuzz/tafuzz_cmp") (const day "2026-09-04") (const sha "abc123") (define (main) (let bad 0 (let bad (+ bad (check "seed-0" (= (fast.roll_seed sha day 0) 35704891778711))) (let bad (+ bad (check "seed-1" (= (fast.roll_seed sha day 1) 53891641391956))) (let bad (+ bad (check "seed-2" (= (fast.roll_seed sha day 2) 77216765527613))) (let bad (+ bad (check "seed-3" (= (fast.roll_seed sha day 3) 59672165027993))) (let bad (+ bad (check "seed-4" (= (fast.roll_seed sha day 4) 117507619088864))) (let bad (+ bad (check "seed-advances" (= (= (fast.roll_seed sha day 0) (fast.roll_seed sha day 1)) false))) (let bad (+ bad (check "seed-sees-day" (= (= (fast.roll_seed sha "2026-09-05" 0) (fast.roll_seed sha day 0)) false))) (let bad (+ bad (check "seed-sees-commit" (= (= (fast.roll_seed "def456" day 0) (fast.roll_seed sha day 0)) false))) (let bad (+ bad (check "seed-positive" (< (fast.roll_seed sha day 4) 140737488355327))) (let bad (+ bad (check "seeds-count" (= (length (fast.rolling_seeds sha day 0 3)) 3))) (let bad (+ bad (check "seeds-start-at-counter" (= (first (fast.rolling_seeds sha day 3 2)) (fast.roll_seed sha day 3)))) (let bad (+ bad (check "seeds-empty" (null? (fast.rolling_seeds sha day 0 0)))) (let bad (+ bad (check "scale-permille" (= (fast.scale_permille "0.4") 400))) (let bad (+ bad (check "scale-whole" (= (fast.scale_permille "1") 1000))) (let bad (+ bad (check "scale-thousandths" (= (fast.scale_permille "0.005") 5))) (let bad (+ bad (check "scale-truncates" (= (fast.scale_permille "0.4567") 456))) (let bad (+ bad (check "counts-tc" (= (fast.scale_count 1418 400) 567))) (let bad (+ bad (check "counts-fixed" (= (fast.scale_count 300 400) 120))) (let bad (+ bad (check "counts-rolling" (= (fast.scale_count 200 400) 80))) (let bad (+ bad (check "counts-zero" (= (fast.scale_count 1418 0) 0))) (let bad (+ bad (check "compile-budget" (= (tafuzz_arm.compile_budget 2000) 8000))) (let bad (+ bad (check "asan-exit" (= (tafuzz_arm.asan_exit) 42))) (let bad (+ bad (check "asan-verdict" (= (tafuzz_cmp.verdict (run_halves 42 0) 10000) (quote asan)))) (let bad (+ bad (check "asan-category" (str.eq (tafuzz_cmp.category (quote asan)) "tavm-crash"))) (let bad (+ bad (check "driver-verdict" (= (tafuzz_cmp.verdict (driver_abort) 10000) (quote bc_crash)))) (let bad (+ bad (check "driver-category" (str.eq (tafuzz_cmp.category (quote bc_crash)) "backend-crash"))) (let bad (+ bad (check "clean-verdict" (= (tafuzz_cmp.verdict (run_halves 0 0) 10000) (quote ok)))) (let bad (+ bad (check "asan-arm" (asan_arm))) (if (= bad 0) (print "PASS") (print (str.concat "FAIL - cases=" (str.from_int bad)))))))))))))))))))))))))))))))))) (define (asan_arm) (let there (file.exists "./tavm_asan") (match (tafuzz_arm.asan "build/kernfuzz/test-cache") ((cons (quote Err) (cons _ nil)) (= there 0)) ((cons (quote Ok) (cons tool nil)) (match tool ((cons (quote Tool) (cons ta (cons tv (cons seed (cons cache (cons env nil)))))) (and (= there 1) (and (str.eq tv "./tavm_asan") (str.eq (car env) "ASAN_OPTIONS=exitcode=42"))))))))) (define (clean tag) (cons (quote Ph) (cons 0 (cons 1 (cons "1\n" (cons "" (cons tag nil))))))) (define (run_halves ar_rc br_rc) (cons (quote Sample) (cons (clean "ac") (cons (cons (quote Ph) (cons ar_rc (cons 1 (cons "1\n" (cons "" (cons "ar" nil)))))) (cons (clean "bc") (cons (cons (quote Ph) (cons br_rc (cons 1 (cons "1\n" (cons "" (cons "br" nil)))))) nil)))))) (define (driver_abort) (cons (quote Sample) (cons (clean "ac") (cons (clean "ar") (cons (cons (quote Ph) (cons 42 (cons 1 (cons "" (cons "** ASan: heap-buffer-overflow" (cons "bc" nil)))))) (cons (clean "br") nil)))))) (define (length xs) (if (null? xs) 0 (+ 1 (length (cdr xs))))) (define (first xs) (car xs)) (define (check name ok) (if ok 0 (begin (print (str.concat "FAIL " name)) 1))))
