((define (len l) (if (null? l) 0 (+ 1 (len (cdr l))))) (define (sum_list l) (match l (nil 0) ((cons h t) (+ h (sum_list t))))) (define (main) (let lst (list 1 2 3) (begin (print lst) (print (len lst)) (print (list (list 1 2) (list 3 4))) (let empty (list)) (if (null? empty) (print "PASS") (print "FAIL")) (print (sum_list (list 1 2 3))) (print (list "a" "b")) (let flags (list true false)) (print (len flags)) (print (len (list 1)))))))
