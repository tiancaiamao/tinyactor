((import "log" "log") (import "buffer" "buffer") (import "result" "result") (import "str" "str") (define (check_str label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat got (str.concat ", want " want))))))) (if pass 0 1)))) (define (check_int label got want) (let pass (= got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat (str.from_int got) (str.concat ", want " (str.from_int want)))))))) (if pass 0 1)))) (define (contains label hay needle) (let pass (>= (str.index_of hay needle) 0) (begin (if pass (print (str.concat "ok - " label)) (begin (print (str.concat "FAIL - " (str.concat label ": missing "))) (print needle))) (if pass 0 1)))) (define (avoids label hay needle) (let pass (< (str.index_of hay needle) 0) (begin (if pass (print (str.concat "ok - " label)) (begin (print (str.concat "FAIL - " (str.concat label ": unexpected "))) (print needle))) (if pass 0 1)))) (define (buffer_sink b) (lambda (line) (begin (buffer.push_str b line) 1) nil)) (define (captured b) (result.unwrap (buffer.to_string b))) (define (test_line) (let f1 (check_str "line info" (log.line 1 0 "hello") "[0] [INFO] hello\n") (let f2 (check_str "line debug" (log.line 0 42 "d") "[42] [DEBUG] d\n") (let f3 (check_str "line warn" (log.line 2 7 "w") "[7] [WARN] w\n") (let f4 (check_str "line error" (log.line 3 7 "e") "[7] [ERROR] e\n") (let f5 (check_str "line unknown level" (log.line 9 1 "x") "[1] [LOG] x\n") (let f6 (check_str "line spaces" (log.line 1 5 "a b  c") "[5] [INFO] a b  c\n") (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6)))))))) (define (test_levels) (let b (result.unwrap (buffer.new)) (let lg (log.set_sink (log.new) (buffer_sink b)) (let f1 (check_int "debug filtered below INFO" (log.debug lg "hush") 0) (let f2 (avoids "hush never rendered" (captured b) "hush") (let f3 (check_int "info passes threshold" (log.info lg "hello") 1) (let f4 (contains "info line in sink" (captured b) "[INFO] hello") (let f5 (check_int "warn and error pass" (+ (log.warn lg "w") (log.error lg "e")) 2) (let lg2 (log.set_level lg log.DEBUG) (let f6 (check_int "raised logger passes debug" (log.debug lg2 "loud") 1) (let f7 (contains "debug line in sink" (captured b) "[DEBUG] loud") (let f8 (check_int "original logger still filters" (log.debug lg "still-hush") 0) (let lg3 (log.set_level lg2 (+ log.ERROR 1)) (let f9 (check_int "above-error threshold filters error" (log.error lg3 "quiet") 0) (+ (+ (+ (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6) f7) f8) f9))))))))))))))) (define (test_sink) (let lg (log.set_sink (log.new) (lambda (l) 42 nil)) (let f1 (check_int "sink return value is forwarded" (log.warn lg "m") 42) (let f2 (check_int "set_sink keeps level" (log.debug lg "hush") 0) (let b (result.unwrap (buffer.new)) (let lg2 (log.set_sink (log.new) (buffer_sink b)) (begin (log.info lg2 "tail") (let f3 (check_str "sink gets full line with newline" (str.substr (captured b) (- (str.length (captured b)) 1) (str.length (captured b))) "\n")) (+ (+ f1 f2) f3)))))))) (define (test_stderr_smoke) (let f1 (check_int "stderr sink reports success" (log.info (log.new) "log-lib: stderr smoke line") 1) f1)) (define (main) (let failures (test_line) (let failures (+ failures (test_levels)) (let failures (+ failures (test_sink)) (let failures (+ failures (test_stderr_smoke)) (if (= failures 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int failures))))))))))
