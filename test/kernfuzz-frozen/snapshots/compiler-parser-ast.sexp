((import "str" "str") (import "tokenizer" "tokenizer") (import "parser" "parser") (define (parse_src src) (let toks (tokenizer.tokenize src) (parser.parse toks))) (define (list_ref lst n) (if (<= n 0) (car lst) (list_ref (cdr lst) (- n 1)))) (define (list_len lst) (if (null? lst) 0 (+ 1 (list_len (cdr lst))))) (define (render v) (if (int? v) (str.from_int v) (if (null? v) "nil" (if (= v true) "true" (if (= v false) "false" (if (string? v) (render_string v) (if (pair? v) (let inner (render_rest (cdr v) (render (car v))) (str.concat "(" (str.concat inner ")"))) (str.sym_to_str v)))))))) (define (render_rest v acc) (if (null? v) acc (if (pair? v) (render_rest (cdr v) (str.concat acc (str.concat " " (render (car v))))) (str.concat acc (str.concat " . " (render v)))))) (define (render_string s) (str.concat "\"" (str.concat (escape_str s) "\""))) (define (escape_str s) (escape_range s 0 (str.length s) "")) (define (escape_range s i n acc) (if (>= i n) acc (let c (str.char_at s i) (let next (match c (10 "\\n") (13 "\\r") (9 "\\t") (92 "\\\\") (34 "\\\"") (_ (str.chr c))) (escape_range s (+ i 1) n (str.concat acc next)))))) (define (run_cases cases fails) (if (null? cases) fails (let c (car cases) (let actual (render (parse_src (list_ref c 1))) (if (str.eq actual (list_ref c 2)) (run_cases (cdr cases) fails) (run_cases (cdr cases) (cons c fails))))))) (define (print_fails fails) (if (null? fails) (print "") (let c (car fails) (begin (print (str.concat "  FAIL: " (list_ref c 0))) (print (str.concat "    src     : " (list_ref c 1))) (print (str.concat "    expected: " (list_ref c 2))) (print (str.concat "    actual  : " (render (parse_src (list_ref c 1))))) (print_fails (cdr fails)))))) (define (main) (let total (list_len (cases)) (let fails (run_cases (cases) nil) (if (null? fails) (print (str.concat "PASS " (str.concat (str.from_int total) " cases"))) (begin (print (str.concat (str.concat (str.concat "FAIL " (str.from_int (list_len fails))) " of ") (str.from_int total))) (print_fails fails)))))) (define (cases) (list (list "int literal" "42" "(42)") (list "negative int literal" "-42" "(-42)") (list "float literal" "3.14" "((float \"3.14\"))") (list "negative float literal" "-3.14" "((float \"-3.14\"))") (list "float literal zero frac" "1.0" "((float \"1.0\"))") (list "float in arithmetic" "1.5 * 2" "((* (float \"1.5\") 2))") (list "float in comparison" "2.5 < 3" "((< (float \"2.5\") 3))") (list "char literal is an int" "'A'" "(65)") (list "char escape newline" "'\\n'" "(10)") (list "char escape tab" "'\\t'" "(9)") (list "char escape backslash" "'\\\\'" "(92)") (list "char escape quote" "'\\''" "(39)") (list "char escape hex" "'\\x41'" "(65)") (list "char literal double-quote" "'\"'" "(34)") (list "string literal" "\"hi\"" "(\"hi\")") (list "string escapes decoded" "\"a\\nb\"" "(\"a\\nb\")") (list "nil literal" "nil" "(nil)") (list "true literal" "true" "(true)") (list "false literal" "false" "(false)") (list "identifier" "x" "(x)") (list "dotted identifier" "foo.bar" "(foo.bar)") (list "call" "f(x, y)" "((f x y))") (list "call commas are optional" "f(x y)" "((f x y))") (list "empty call" "f()" "((f))") (list "nested call" "f(g(x))" "((f (g x)))") (list "call arg is infix expr" "f(a + b, c)" "((f (+ a b) c))") (list "dotted callee" "mod.fn(1)" "((mod.fn 1))") (list "chained call" "f(x)(y)" "(((f x) y))") (list "triple chained call" "f(x)(y)(z)" "((((f x) y) z))") (list "nested + chained call" "g(h(1))(2)" "(((g (h 1)) 2))") (list "add" "a + b" "((+ a b))") (list "sub" "a - b" "((- a b))") (list "mul" "a * b" "((* a b))") (list "div" "a / b" "((/ a b))") (list "mod" "a % b" "((% a b))") (list "additive left assoc" "a + b - c" "((- (+ a b) c))") (list "mult left assoc" "a * b / c" "((/ (* a b) c))") (list "mult binds tighter" "a + b * c" "((+ a (* b c)))") (list "parens override precedence" "(a + b) * c" "((* (+ a b) c))") (list "no unary minus" "-a" "(- a)") (list "less" "a < b" "((< a b))") (list "greater" "a > b" "((> a b))") (list "less-equal" "a <= b" "((<= a b))") (list "greater-equal" "a >= b" "((>= a b))") (list "== is renamed to =" "a == b" "((= a b))") (list "== left assoc" "a == b == c" "((= (= a b) c))") (list "mixed chain" "a < b == c" "((= (< a b) c))") (list "chain continues after ==" "a == b < c" "((< (= a b) c))") (list "!= is a comparison op" "a != b" "((!= a b))") (list "!= left assoc" "a != b != c" "((!= (!= a b) c))") (list "mixed chain with !=" "a < b != c" "((!= (< a b) c))") (list "chain continues after !=" "a != b < c" "((< (!= a b) c))") (list "arith binds tighter" "a + b < c" "((< (+ a b) c))") (list "and" "a && b" "((and a b))") (list "or" "a || b" "((or a b))") (list "&& chain is right assoc" "a && b && c" "((and a (and b c)))") (list "|| chain is left assoc" "a || b || c" "((or (or a b) c))") (list "&& binds tighter than ||" "a || b && c" "((or a (and b c)))") (list "|| is loosest" "a && b || c" "((or (and a b) c))") (list "comparison tighter than &&" "a == b && c" "((and (= a b) c))") (list "&& operand is comparison" "a && b == c" "((and a (= b c)))") (list "comparison tighter than &&" "1 < 2 && 3" "((and (< 1 2) 3))") (list "use simple" "fn f() { use k <- pa(); ret(k) }" "((define (f) ((pa) (lambda (k) (ret k)))))") (list "use with args" "fn f() { use k <- pa(1); ret(k) }" "((define (f) ((pa 1) (lambda (k) (ret k)))))") (list "use chain" "fn f() { use a <- pa(); use b <- pb(); ret(cons(a, b)) }" "((define (f) ((pa) (lambda (a) ((pb) (lambda (b) (ret (cons a b))))))))") (list "use discard" "fn f() { use <- pa(); ret(5) }" "((define (f) ((pa) (lambda (_) (ret 5)))))") (list "use discard underscore" "fn f() { use _ <- pa(); ret(5) }" "((define (f) ((pa) (lambda (_) (ret 5)))))") (list "use in lambda" "fn f() { fn() { use k <- pa(); ret(k) } }" "((define (f) (lambda nil ((pa) (lambda (k) (ret k))) nil)))") (list "use multi-stmt body" "fn f() { use k <- pa(); ret(k); ret(k) }" "((define (f) ((pa) (lambda (k) (begin (ret k) (ret k))))))") (list "use after let" "fn f() { let x = 1; use k <- pa(); ret(cons(x, k)) }" "((define (f) (let x 1 ((pa) (lambda (k) (ret (cons x k)))))))") (list "use is not a keyword" "use(x)" "((use x))") (list "use call 2 args" "fn f() { use(1, 2); ret(3) }" "((define (f) (begin (use 1 2) (ret 3))))") (list "use-bind name not desugared" "fn f() { use-bind(1, 2) }" "((define (f) (use-bind 1 2)))") (list "chained call not desugared" "fn f() { f(1)(2, 3) }" "((define (f) ((f 1) 2 3)))") (list "use neg literal glued" "fn f() { use x <-5; ret(x) }" "((define (f) (-5 (lambda (x) (ret x)))))") (list "use neg literal spaced" "fn f() { use x <- -5; ret(x) }" "((define (f) (-5 (lambda (x) (ret x)))))") (list "use neg float glued" "fn f() { use x <-1.5; ret(x) }" "((define (f) ((float \"-1.5\") (lambda (x) (ret x)))))") (list "pipe call" "5 |> double()" "((double 5))") (list "pipe bare fn" "x |> double" "((double x))") (list "pipe with args" "5 |> add(3)" "((add 5 3))") (list "pipe chain" "5 |> double() |> add(1)" "((add (double 5) 1))") (list "pipe is left assoc" "5 |> f() |> g()" "((g (f 5)))") (list "pipe constructor" "1 |> Pair(2)" "((cons (quote Pair) (cons 1 (cons 2 nil))))") (list "pipe is loosest" "a + b |> f()" "((f (+ a b)))") (list "single element unwraps" "(a)" "(a)") (list "infix inside parens" "(a + b)" "((+ a b))") (list "quote inside parens" "('x)" "((quote x))") (list "quote a symbol" "'x" "((quote x))") (list "quote dotted symbol" "'foo.bar" "((quote foo.bar))") (list "lambda with params" "(fn(x) { x })" "((lambda (x) x nil))") (list "lambda multi-form body" "(fn(x, y) { a; b })" "((lambda (x y) (begin a b) nil))") (list "lambda no parens" "(fn { 42 })" "((lambda nil 42 nil))") (list "lambda empty parens" "(fn() { x })" "((lambda nil x nil))") (list "lambda empty body" "(fn(x) { })" "((lambda (x) nil nil))") (list "lambda with ret type" "{ let f = fn(x) -> int { x } }" "((let f (lambda (x) x int) nil))") (list "lambda ret type compound" "{ let f = fn(x) -> List(int) { x } }" "((let f (lambda (x) x (List int)) nil))") (list "fn at top level is a def" "fn inc(x) { x + 1 }" "((define (inc x) (+ x 1)))") (list "single element list" "[a]" "((list a))") (list "list" "[a, b]" "((list a b))") (list "list commas are optional" "[a b]" "((list a b))") (list "empty list" "[]" "((list))") (list "list elements are exprs" "[1 + 2, a * b]" "((list (+ 1 2) (* a b)))") (list "nested list" "[a, [b, c]]" "((list a (list b c)))") (list "nullary ctor" "Point" "((quote Point))") (list "ctor with empty call" "Point()" "((cons (quote Point) nil))") (list "ctor one arg" "P(x)" "((cons (quote P) (cons x nil)))") (list "ctor multiple args" "Point(1, 2)" "((cons (quote Point) (cons 1 (cons 2 nil))))") (list "lowercase name is a call" "point(1)" "((point 1))") (list "single form, no begin" "{ x }" "(x)") (list "multiple forms -> begin" "{ x; y }" "((begin x y))") (list "begin chains" "{ a; b; c }" "((begin a b c))") (list "trailing semicolon" "{ x; }" "(x)") (list "empty block" "{}" "(nil)") (list "nested block is one form" "{ { x; y } }" "((begin x y))") (list "leading semicolon" "{ ; x }" "(x)") (list "comma inserts a nil form" "{ x, y }" "((begin x nil y))") (list "let scopes over rest" "{ let x = 1; x + 1 }" "((let x 1 (+ x 1)))") (list "let chains right" "{ let x = 1; let y = 2; x + y }" "((let x 1 (let y 2 (+ x y))))") (list "trailing let -> nil body" "{ let x = 1 }" "((let x 1 nil))") (list "non-leading let unthreaded" "{ 1; let x = 2; x }" "((begin 1 (let x 2) x))") (list "let value is full expr" "{ let x = 1 + 2; x }" "((let x (+ 1 2) x))") (list "typed let unsupported" "{ let x: int = 1; x }" "((let x nil (begin int = 1 x)))") (list "if with else" "{ if c { a } else { b } }" "((if c a b))") (list "if without else -> nil" "{ if c { a } }" "((if c a nil))") (list "else-if chain" "{ if a { 1 } else if b { 2 } else { 3 } }" "((if a 1 (if b 2 3)))") (list "if cond is full expr" "{ if a && b { c } }" "((if (and a b) c nil))") (list "unbraced else" "{ if c { a } else b }" "((if c a b))") (list "match basic" "{ match x { 1 -> a; _ -> b } }" "((match x (1 a) (_ b)))") (list "arm body multiple forms" "{ match x { _ -> { a; b } } }" "((match x (_ (begin a b))))") (list "arm guard" "{ match x { y when g -> y } }" "((match x (y g y)))") (list "arm guard compound" "{ match x { y when g1 && g2 -> y } }" "((match x (y (and g1 g2) y)))") (list "arm guard with pattern" "{ match x { A(y) when y > 0 -> y } }" "((match x ((A y) (> y 0) y)))") (list "empty match" "{ match x {} }" "((match x))") (list "scrutinee is expression" "{ match f(x) { _ -> 1 } }" "((match (f x) (_ 1)))") (list "negative int pattern" "{ match x { -1 -> a } }" "((match x (-1 a)))") (list "string pattern" "{ match x { \"s\" -> a } }" "((match x (\"s\" a)))") (list "nil pattern" "{ match x { nil -> a } }" "((match x (nil a)))") (list "true pattern is a symbol" "{ match x { true -> a } }" "((match x (true a)))") (list "binding pattern" "{ match x { x -> x } }" "((match x (x x)))") (list "wildcard pattern" "{ match x { _ -> 1 } }" "((match x (_ 1)))") (list "quoted pattern double quote" "{ match x { 'A -> 1 } }" "((match x ((quote (quote A)) 1)))") (list "nullary ctor pattern" "{ match x { A -> 1 } }" "((match x ((quote A) 1)))") (list "ctor pattern" "{ match x { A(y, z) -> y } }" "((match x ((A y z) y)))") (list "pair pattern" "{ match x { cons(a, b) -> a } }" "((match x ((cons a b) a)))") (list "inner cons is an expression" "{ match x { cons(a, cons(b, c)) -> a } }" "((match x ((cons a (cons b c)) a)))") (list "bracket pattern" "{ match x { [a, b] -> a } }" "((match x ((cons a (cons b nil)) a)))") (list "nested bracket pattern" "{ match x { [a, [b, c]] -> a } }" "((match x ((cons a (cons (cons b (cons c nil)) nil)) a)))") (list "nested ctor arg is an expr" "{ match x { A(B(x)) -> 1 } }" "((match x ((A (cons (quote B) (cons x nil))) 1)))") (list "receive" "{ receive { A(x) -> x } }" "((receive ((A x) x)))") (list "receive guard" "{ receive { x when g -> x } }" "((receive (x g x)))") (list "receive multiple arms" "{ receive { 1 -> a; _ -> b } }" "((receive (1 a) (_ b)))") (list "empty receive" "{ receive {} }" "((receive))") (list "fn definition" "fn add(x, y) { x + y }" "((define (add x y) (+ x y)))") (list "fn no params" "fn f() { 1 }" "((define (f) 1))") (list "fn empty body" "fn f() {}" "((define (f) nil))") (list "fn body multi-form" "fn f() { a; b }" "((define (f) (begin a b)))") (list "pub fn" "pub fn f(x) { x }" "((define_pub (f x) x))") (list "fn body if is expression" "fn f() { if c { a } else { b } }" "((define (f) (if c a b)))") (list "multiple top-level forms" "fn a() {} fn b() {}" "((define (a) nil) (define (b) nil))") (list "top-level expressions" "42 nil" "(42 nil)") (list "param type" "fn f(x: int) { x }" "((type-sig f (int) nil) (define (f x) x))") (list "multiple param types" "fn f(x: int, y: string) { x }" "((type-sig f (int string) nil) (define (f x y) x))") (list "return type" "fn f(x) -> bool { x }" "((type-sig f (nil) bool) (define (f x) x))") (list "param and return type" "fn f(x: int) -> bool { true }" "((type-sig f (int) bool) (define (f x) true))") (list "compound type" "fn f(x: List(int)) { x }" "((type-sig f ((List int)) nil) (define (f x) x))") (list "function type" "fn f(g: a -> b) { g }" "((type-sig f ((arrow a b)) nil) (define (f g) g))") (list "arrow is right assoc" "fn f(g: a -> b -> c) { g }" "((type-sig f ((arrow a (arrow b c))) nil) (define (f g) g))") (list "quoted type variable" "fn f(x: 'a) { x }" "((type-sig f ((quote a)) nil) (define (f x) x))") (list "untyped fn has no type-sig" "fn f(x) { x }" "((define (f x) x))") (list "type single nullary" "type Foo { A }" "((type Foo nil (quote A)))") (list "type mixed variants" "type Foo { A; B(x) }" "((type Foo nil (quote A) (B x)))") (list "type n-ary variant" "type Foo { B(x, y) }" "((type Foo nil (B x y)))") (list "type with params" "type List(a) { Nil; Cons(a, List(a)) }" "((type List (a) (quote Nil) (Cons a (cons (quote List) (cons a nil)))))") (list "pub type" "pub type Foo { A }" "((type Foo nil (quote A)))") (list "const int" "const X = 42" "((const X 42))") (list "const string" "const MSG = \"hi\"" "((const MSG \"hi\"))") (list "const expression" "const D = COUNT * 2" "((const D (* (quote COUNT) 2)))") (list "import" "import foo" "((import \"foo\" \"foo\"))") (list "import as alias" "import foo as f" "((import \"foo\" \"f\"))") (list "external fn" "external fn foo.bar(int) -> int" "((external_fn foo.bar (int) int))") (list "external no return type" "external fn foo.bar(int)" "((external_fn foo.bar (int) nil))") (list "external no params" "external fn foo.bar()" "((external_fn foo.bar nil nil))") (list "external function type" "external fn foo.bar(int, string) -> a -> b" "((external_fn foo.bar (int string) (arrow a b)))") (list "comments are skipped" "// hi\n42" "(42)") (list "keyword as identifier" "spawn(f, 1)" "((spawn f 1))") (list "top-level semicolon -> nil" "42; 43" "(42 nil 43)"))))
