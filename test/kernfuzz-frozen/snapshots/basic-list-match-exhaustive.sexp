((type-sig sum ((list int)) int) (define (sum xs) (match xs (nil 0) ((cons h t) (+ h (sum t))))) (type-sig head_else ((list int) int) int) (define (head_else xs d) (match xs (_ d) ((cons h _) h))) (type Bind nil (Bind name val)) (type-sig find (string (list Bind)) int) (define (find key binds) (match binds (nil -1) ((cons (cons (quote Bind) (cons k (cons v nil))) rest) (= k key) v) ((cons _ rest) (find key rest)))) (type-sig one_or ((list string)) string) (define (one_or xs) (match xs ((cons h nil) h) (_ "other"))) (define (main) (begin (print (sum nil)) (print (sum (cons 10 (cons 20 nil)))) (print (head_else nil 9)) (print (head_else (cons 7 nil) 9)) (print (find "a" nil)) (print (find "b" (cons (cons (quote Bind) (cons "a" (cons 1 nil))) (cons (cons (quote Bind) (cons "b" (cons 2 nil))) (cons (cons (quote Bind) (cons "c" (cons 3 nil))) nil))))) (print (one_or (cons "only" nil))) (print (one_or nil)) (print "PASS"))))
