((type-sig sum ((List Int)) Int) (define (sum xs) (match xs (nil 0) ((cons h t) (+ h (sum t))))) (type-sig head_else ((List Int) Int) Int) (define (head_else xs d) (match xs (_ d) ((cons h _) h))) (type Bind nil (Bind name val)) (type-sig find (String (List Bind)) Int) (define (find key binds) (match binds (nil -1) ((cons (tuple (quote Bind) k v) rest) (= k key) v) ((cons _ rest) (find key rest)))) (type-sig one_or ((List String)) String) (define (one_or xs) (match xs ((cons h nil) h) (_ "other"))) (define (main) (begin (print (sum nil)) (print (sum (cons 10 (cons 20 nil)))) (print (head_else nil 9)) (print (head_else (cons 7 nil) 9)) (print (find "a" nil)) (print (find "b" (cons (tuple (quote Bind) "a" 1) (cons (tuple (quote Bind) "b" 2) (cons (tuple (quote Bind) "c" 3) nil))))) (print (one_or (cons "only" nil))) (print (one_or nil)) (print "PASS"))))
