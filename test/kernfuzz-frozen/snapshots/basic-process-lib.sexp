((import "net" "net") (import "process" "process") (import "result" "result") (import "str" "str") (define (drain fd acc) (match (net.read fd 4096) (d (null? d) (drain fd acc)) ((quote eof) acc) (-1 acc) (d (drain fd (str.concat acc d))))) (define (check label pass) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " label))) (if pass 1 0))) (define (case_sh) (match (process.run "/bin/sh" (list "-c" "echo hello-process")) ((Ok p) (let w (process.stdin_w p) (let rd (process.stdout_r p) (let c1 (check "run sh: stdin_w/stdout_r are fds" (and (>= w 0) (>= rd 0))) (begin (if (>= w 0) (net.close w) nil) (let c2 (check "run sh: stdout to eof" (str.eq (drain rd "") "hello-process\n"))) (let c3 (check "run sh: wait exit code 0" (= (process.wait p) 0))) (let c4 (check "run sh: stdin_w after wait is -1" (= (process.stdin_w p) -1))) (let c5 (check "run sh: close after wait is 1" (= (process.close p) 1))) (if (= (+ (+ (+ (+ c1 c2) c3) c4) c5) 5) 1 0)))))) ((Err e) (begin (print (str.concat "FAIL - run sh: unexpected Err " e)) 0)))) (define (case_exit3) (match (process.run "/bin/sh" (list "-c" "exit 3")) ((Ok p) (begin (net.close (process.stdin_w p)) (let out (drain (process.stdout_r p) "")) (let code (process.wait p)) (check "exit 3: eof + wait sees 3" (and (str.eq out "") (= code 3))))) ((Err e) (begin (print (str.concat "FAIL - exit 3: unexpected Err " e)) 0)))) (define (case_false) (match (process.run "/bin/sh" (list "-c" "false")) ((Ok p) (begin (net.close (process.stdin_w p)) (drain (process.stdout_r p) "") (check "false: wait sees 1" (= (process.wait p) 1)))) ((Err e) (begin (print (str.concat "FAIL - false: unexpected Err " e)) 0)))) (define (case_bad_cmd) (match (process.run "/nonexistent-cmd-xyz" nil) ((Ok p) (begin (process.close p) (print "FAIL - bad cmd: unexpected Ok") 0)) ((Err e) (check "bad cmd: Err spawn failed" (str.eq e "spawn failed"))))) (define (case_argv) (match (process.run "/bin/sh" (list "-c" "echo $1 $2" "sh" "b3" "libs")) ((Ok p) (begin (net.close (process.stdin_w p)) (let out (drain (process.stdout_r p) "")) (let c1 (check "argv: echo $1 $2" (str.eq out "b3 libs\n"))) (let c2 (check "argv: wait exit code 0" (= (process.wait p) 0))) (if (= (+ c1 c2) 2) 1 0))) ((Err e) (begin (print (str.concat "FAIL - argv: unexpected Err " e)) 0)))) (define (main) (let c1 (case_sh) (let c2 (case_exit3) (let c3 (case_false) (let c4 (case_bad_cmd) (let c5 (case_argv) (let c6 (case_stale) (let total (+ (+ (+ (+ (+ c1 c2) c3) c4) c5) c6) (if (= total 6) (print "PASS") (print (str.concat "FAIL - " (str.concat (str.from_int (- 6 total)) " of 6 cases failed")))))))))))) (define (case_stale) (match (process.run "/bin/sh" (list "-c" "exit 0")) ((Ok a) (let c0 (check "stale: close a frees the slot" (= (process.close a) 1)) (match (process.run "/bin/sh" (list "-c" "echo recycled")) ((Ok b) (let c1 (check "stale: stdin_w on stale handle is -1" (= (process.stdin_w a) -1)) (let c2 (check "stale: close on stale handle is -1" (= (process.close a) -1)) (begin (net.close (process.stdin_w b)) (let out (drain (process.stdout_r b) "")) (let c3 (check "stale: new process unaffected" (str.eq out "recycled\n"))) (let c4 (check "stale: wait new process 0" (= (process.wait b) 0))) (if (= (+ (+ (+ (+ c0 c1) c2) c3) c4) 5) 1 0))))) ((Err e) (begin (print (str.concat "FAIL - stale: unexpected Err " e)) 0))))) ((Err e) (begin (print (str.concat "FAIL - stale: unexpected Err " e)) 0)))))
