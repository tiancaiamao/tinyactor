((define (p cond) (if cond (print "ok") (print "FAIL"))) (define (sleeper collector) (send collector (recv))) (define (main) (let me (self) (let pid1 (spawn (lambda nil (sleeper me) nil)) (let id1 (timer.send_after pid1 -1 (quote fired)) (begin (p (> id1 0)) (p (= (recv) (quote fired))) (p (= (timer.cancel 0) 0)) (p (= (timer.cancel -3) 0)) (let id2 (timer.send_interval me 50 (quote tick))) (p (> id2 0)) (p (= (timer.cancel id2) 1)) (p (= (timer.cancel id2) 0))))))))
