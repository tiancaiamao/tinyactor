((type Msg nil (Add a b) (Mul a b)) (define (main) (let m1 (tuple (quote Mul) 2 5) (begin (match m1 ((tuple (quote Add) a b) (print 1)) ((tuple (quote Mul) a b) (print (* a b))) (_ (print 0))) (let m2 (cons (quote Mul) (cons 2 (cons 5 nil)))) (match m2 ((tuple (quote Add) a b) (print 1)) (_ (print 0))) (let one (cons 1 nil)) (let m3 (cons (quote Add) one)) (match m3 ((tuple (quote Add) a b) (print 1)) (_ (print 0)))))))
