((import "tokenizer") (import "parser") (define (try_parse src) (let toks (tokenizer.tokenize src) (let r (parser.parse toks) 1))) (define (check_all cases) (if (null? cases) 1 (if (= (try_parse (car cases)) 1) (check_all (cdr cases)) 0))) (define (main) (let cases (cons "f(" (cons "f(x" (cons "f(x," (cons "f(x,y" (cons "fn f(" (cons "fn f(x" (cons "Foo(" (cons "Foo(1,2" (cons "[1, 2" (cons "type X {" (cons "type X(A" (cons "List<Int" (cons "match x { A(1" (cons "receive { msg(" (cons "(fn x { x }" (cons "if x { 1 +" (cons "x + " (cons "list_length(cd" (cons "// unclosed comment" (cons "import typ" nil)))))))))))))))))))) (let ok (check_all cases) (if (= ok 1) (print "PASS") (print "FAIL"))))))
