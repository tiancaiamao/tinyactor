((import "tokenizer" "tokenizer") (import "parser" "parser") (define (try_parse src) (let toks (tokenizer.tokenize src) (let r (parser.parse toks) 1))) (define (check_all cases) (if (null? cases) 1 (if (= (try_parse (car cases)) 1) (check_all (cdr cases)) 0))) (define (main) (let cases (list "f(" "f(x" "f(x," "f(x,y" "fn f(" "fn f(x" "Foo(" "Foo(1,2" "[1, 2" "type X {" "type X(A" "List<Int" "match x { A(1" "receive { msg(" "(fn x { x }" "if x { 1 +" "x + " "list_length(cd" "// unclosed comment" "import typ") (let ok (check_all cases) (if (= ok 1) (print "PASS") (print "FAIL"))))))
