((import "set" "set") (import "cmp" "cmp") (define (deep_eq a b) (if (pair? a) (if (pair? b) (and (deep_eq (car a) (car b)) (deep_eq (cdr a) (cdr b))) false) (if (pair? b) false (= a b)))) (define (check label got want) (let pass (deep_eq got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label ": wrong value")))) (if pass 1 0)))) (define (main) (let e (set.int_new) (let ok1 (check "empty size" (set.size e) 0) (let ok2 (check "empty to_list" (set.to_list e) nil) (let ok3 (check "empty member" (set.member e 1) false) (let s (set.add (set.add (set.add e 3) 1) 2) (let ok4 (check "add member 1" (set.member s 1) true) (let ok5 (check "add member 3" (set.member s 3) true) (let ok6 (check "add member miss" (set.member s 9) false) (let ok7 (check "add size" (set.size s) 3) (let s2 (set.add s 1) (let ok8 (check "duplicate add size" (set.size s2) 3) (let ok9 (check "duplicate add member" (set.member s2 1) true) (let ok10 (check "to_list ordered" (set.to_list s) (list 1 2 3)) (let ss (set.add (set.add (set.str_new) "pear") "apple") (let ok11 (check "str to_list ordered" (set.to_list ss) (list "apple" "pear")) (let r1 (set.remove s 2) (let ok12 (check "remove member" (set.member r1 2) false) (let ok13 (check "remove size" (set.size r1) 2) (let ok14 (check "remove to_list" (set.to_list r1) (list 1 3)) (let r2 (set.remove s 42) (let ok15 (check "remove absent size" (set.size r2) 3) (let ok16 (check "remove absent member" (set.member r2 42) false) (let r3 (set.remove (set.remove (set.remove s 1) 2) 3) (let ok17 (check "drain size" (set.size r3) 0) (let ok18 (check "drain to_list" (set.to_list r3) nil) (let ok19 (check "persist after add" (and (= (set.member s 4) false) (= (set.size s) 3)) true) (let s4 (set.add s 4) (let ok20 (check "persist old lacks 4" (set.member s 4) false) (let ok21 (check "persist new has 4" (set.member s4 4) true) (let ok22 (check "persist new size" (set.size s4) 4) (let a (set.add (set.add (set.add e 1) 2) 3) (let b (set.add (set.add (set.add e 2) 3) 4) (let u (set.union a b) (let ok23 (check "union" (set.to_list u) (list 1 2 3 4)) (let ok24 (check "union size" (set.size u) 4) (let i (set.intersect a b) (let ok25 (check "intersect" (set.to_list i) (list 2 3)) (let df (set.difference a b) (let ok26 (check "difference" (set.to_list df) (list 1)) (let ok27 (check "union originals a" (set.size a) 3) (let ok28 (check "union originals b" (set.size b) 3) (let ok29 (check "intersect member check" (and (= (set.member i 1) false) (set.member i 3)) true) (let ok30 (check "difference disjoint" (set.to_list (set.difference a a)) nil) (let dsc (set.new (lambda (x y) (cmp.int_cmp y x) nil)) (let ds (set.add (set.add (set.add dsc 1) 3) 2) (let ok31 (check "custom cmp order" (set.to_list ds) (list 3 2 1)) (let ok32 (check "custom cmp member" (set.member ds 2) true) (let ok33 (check "str_new member" (set.member ss "apple") true) (let ok34 (check "str_new size" (set.size ss) 2) (let total (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ ok1 ok2) ok3) ok4) ok5) ok6) ok7) ok8) ok9) ok10) ok11) ok12) ok13) ok14) ok15) ok16) ok17) ok18) ok19) ok20) ok21) ok22) ok23) ok24) ok25) ok26) ok27) ok28) ok29) ok30) ok31) ok32) ok33) ok34) (if (= total 34) (print "PASS") (print (str.concat "FAIL - " (str.concat (str.from_int (- 34 total)) " of 34 checks failed"))))))))))))))))))))))))))))))))))))))))))))))))))))))))
