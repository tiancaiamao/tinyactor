((import "net" "net") (import "str" "str") (import "list" "list") (import "result" "result") (import "random" "random") (const N_CLIENTS 8) (const N_ROUNDS 200) (const CANARY_WINDOW_MS 400) (const CANARY_MIN_TICKS 1000) (const MAX_ATTEMPTS 3) (type LoadMsg nil (Canary n) (ClientDone fails) (quote EchoDone) (quote AcceptorDone)) (define (connect_retry host port timeout) (let r (net.connect host port timeout) (match r (nil (connect_retry host port timeout)) (x x)))) (define (accept_retry s) (let a (net.accept s) (match a (nil (accept_retry s)) (x x)))) (define (write_all fd data) (match (net.write fd data) (-1 -1) (n (null? n) (write_all fd data)) (n (< n (str.length data)) (write_all fd (str.substr data n (- (str.length data) n)))) (n n))) (define (read_exact fd acc want) (if (>= (str.length acc) want) acc (match (net.read fd 4096) (nil (read_exact fd acc want)) (d (int? d) acc) (d (read_exact fd (str.concat acc d) want))))) (define (bind_random_port tries) (if (= tries 0) -1 (let r (random.rand_int 20000) (let p (match r ((Ok p) (+ 20000 p)) (_ -1)) (if (= p -1) (bind_random_port (- tries 1)) (let s (net.listen p) (if (= s -1) (bind_random_port (- tries 1)) (cons s p)))))))) (define (echo_loop main c) (match (net.read c 4096) (nil (echo_loop main c)) (d (int? d) (begin (net.close c) (send main (quote EchoDone)))) (d (let w (write_all c d) (if (= w -1) (begin (net.close c) (send main (quote EchoDone))) (echo_loop main c)))))) (define (acceptor main s remaining) (if (= remaining 0) (begin (net.close s) (send main (quote AcceptorDone))) (let c (accept_retry s) (if (= c -1) (begin (net.close s) (send main (quote AcceptorDone))) (begin (spawn (lambda nil (echo_loop main c) nil)) (acceptor main s (- remaining 1))))))) (define (client_loop main c i r fails) (if (= r 0) (begin (net.close c) (send main (cons (quote ClientDone) (cons fails nil)))) (let payload (str.concat "ping-" (str.concat (str.from_int i) (str.concat "-" (str.from_int r)))) (if (= (write_all c payload) -1) (client_loop main c i 0 (+ fails 1)) (let got (read_exact c "" (str.length payload)) (if (= got payload) (client_loop main c i (- r 1) fails) (client_loop main c i (- r 1) (+ fails 1)))))))) (define (client_run main port i) (let c (connect_retry "127.0.0.1" port 3000) (if (int? c) (client_loop main c i (quote N_ROUNDS) 0) (send main (cons (quote ClientDone) (cons 1 nil)))))) (define (spawn_clients main port i) (if (= i 0) 0 (begin (spawn (lambda nil (client_run main port i) nil)) (spawn_clients main port (- i 1))))) (define (canary_spin main deadline n) (if (>= (vm.time_ms) deadline) (send main (cons (quote Canary) (cons n nil))) (canary_spin main deadline (+ n 1)))) (define (collect remaining canary_n client_fails echoes acceptors) (if (= remaining 0) (cons canary_n (cons client_fails (cons echoes (cons acceptors nil)))) (match (recv_after 20000) (nil (begin (print "collect-timeout") (cons 0 (cons remaining (cons echoes (cons acceptors nil)))))) ((Canary n) (collect (- remaining 1) (+ canary_n n) client_fails echoes acceptors)) ((ClientDone f) (collect (- remaining 1) canary_n (+ client_fails f) echoes acceptors)) ((quote EchoDone) (collect (- remaining 1) canary_n client_fails (+ echoes 1) acceptors)) ((quote AcceptorDone) (collect (- remaining 1) canary_n client_fails echoes (+ acceptors 1))) (_ (collect (- remaining 1) canary_n client_fails echoes acceptors))))) (define (load_round attempt) (let me (self) (let sp (bind_random_port 50) (let s (car sp) (if (= s -1) (begin (print (str.concat "attempt " (str.concat (str.from_int attempt) ": no free port"))) 1) (let port (cdr sp) (begin (spawn (lambda nil (acceptor me s (quote N_CLIENTS)) nil)) (spawn (lambda nil (canary_spin me (+ (vm.time_ms) (quote CANARY_WINDOW_MS)) 0) nil)) (spawn_clients me port (quote N_CLIENTS)) (let res (collect (+ (* 2 (quote N_CLIENTS)) 2) 0 0 0 0)) (let canary_n (list.nth res 0)) (let client_fails (list.nth res 1)) (let echoes (list.nth res 2)) (let acceptors (list.nth res 3)) (let f (check "canary made progress under load" (>= canary_n (quote CANARY_MIN_TICKS)))) (let f (+ f (check "all roundtrips echoed intact" (= client_fails 0)))) (let f (+ f (check "all echo actors accounted" (= echoes (quote N_CLIENTS))))) (let f (+ f (check "acceptor accounted" (= acceptors 1)))) (if (!= f 0) (print (str.concat "attempt " (str.concat (str.from_int attempt) (str.concat ": canary=" (str.concat (str.from_int canary_n) (str.concat " roundtrip-fails=" (str.concat (str.from_int client_fails) (str.concat " echoes=" (str.from_int echoes))))))))) nil) f))))))) (define (check label ok) (if ok (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (attempt n) (if (> n (quote MAX_ATTEMPTS)) 1 (let f (load_round n) (if (= f 0) 0 (attempt (+ n 1)))))) (define (main) (let f (attempt 1) (if (= f 0) (print "PASS") (print "FAIL")))))
