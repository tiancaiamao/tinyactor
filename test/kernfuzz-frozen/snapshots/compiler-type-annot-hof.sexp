((type MyList (a) (quote Nil) (Cons a (tuple (quote MyList) a))) (type-sig map ((arrow a b) (MyList a)) (MyList b)) (define (map f xs) (match xs ((quote Nil) (quote Nil)) ((tuple (quote Cons) h t) (tuple (quote Cons) (f h) (map f t))))) (type-sig foldl ((arrow b (arrow a b)) b (MyList a)) b) (define (foldl f acc xs) (match xs ((quote Nil) acc) ((tuple (quote Cons) h t) (foldl f (f acc h) t)))) (type-sig filter ((arrow a Bool) (MyList a)) (MyList a)) (define (filter p xs) (match xs ((quote Nil) (quote Nil)) ((tuple (quote Cons) h t) (if (p h) (tuple (quote Cons) h (filter p t)) (filter p t))))) (type-sig inc (Int) Int) (define (inc x) (+ x 1)) (type-sig shout (String) String) (define (shout x) (str.concat x "!")) (type-sig is_even (Int) Bool) (define (is_even x) (= (% x 2) 0)) (type-sig add (Int Int) Int) (define (add acc x) (+ acc x)) (define (main) (let ys (map inc (tuple (quote Cons) 1 (tuple (quote Cons) 2 (tuple (quote Cons) 3 (quote Nil))))) (begin (print ys) (let ss (map shout (tuple (quote Cons) "a" (tuple (quote Cons) "b" (quote Nil))))) (print ss) (let sum (foldl add 0 (tuple (quote Cons) 1 (tuple (quote Cons) 2 (tuple (quote Cons) 3 (quote Nil)))))) (print sum) (let evens (filter is_even (tuple (quote Cons) 1 (tuple (quote Cons) 2 (tuple (quote Cons) 3 (tuple (quote Cons) 4 (quote Nil))))))) (print evens) (print "PASS")))))
