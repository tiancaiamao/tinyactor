((type List (a) (quote Nil) (Cons a (cons (quote List) (cons a nil)))) (type-sig map ((arrow a b) (List a)) (List b)) (define (map f xs) (match xs ((quote Nil) (quote Nil)) ((Cons h t) (cons (quote Cons) (cons (f h) (cons (map f t) nil)))))) (type-sig foldl ((arrow b (arrow a b)) b (List a)) b) (define (foldl f acc xs) (match xs ((quote Nil) acc) ((Cons h t) (foldl f (f acc h) t)))) (type-sig filter ((arrow a bool) (List a)) (List a)) (define (filter p xs) (match xs ((quote Nil) (quote Nil)) ((Cons h t) (if (p h) (cons (quote Cons) (cons h (cons (filter p t) nil))) (filter p t))))) (type-sig inc (int) int) (define (inc x) (+ x 1)) (type-sig shout (string) string) (define (shout x) (str.concat x "!")) (type-sig is_even (int) bool) (define (is_even x) (= (% x 2) 0)) (type-sig add (int int) int) (define (add acc x) (+ acc x)) (define (main) (let ys (map inc (cons (quote Cons) (cons 1 (cons (cons (quote Cons) (cons 2 (cons (cons (quote Cons) (cons 3 (cons (quote Nil) nil))) nil))) nil)))) (begin (print ys) (let ss (map shout (cons (quote Cons) (cons "a" (cons (cons (quote Cons) (cons "b" (cons (quote Nil) nil))) nil))))) (print ss) (let sum (foldl add 0 (cons (quote Cons) (cons 1 (cons (cons (quote Cons) (cons 2 (cons (cons (quote Cons) (cons 3 (cons (quote Nil) nil))) nil))) nil))))) (print sum) (let evens (filter is_even (cons (quote Cons) (cons 1 (cons (cons (quote Cons) (cons 2 (cons (cons (quote Cons) (cons 3 (cons (cons (quote Cons) (cons 4 (cons (quote Nil) nil))) nil))) nil))) nil))))) (print evens) (print "PASS")))))
