((import "net" "net") (import "str" "str") (import "time" "time") (define (accept_retry s) (let a (net.accept s) (match a (nil (accept_retry s)) (x x)))) (define (read_retry fd) (let d (net.read fd 4096) (match d (nil (read_retry fd)) (x x)))) (define (write_until_epipe fd i) (if (>= i 1000) false (let rv (net.write fd "x") (if (= rv -1) (= (net.errno) 32) (begin (time.sleep 1) (write_until_epipe fd (+ i 1))))))) (define (main) (let s (net.listen 9891) (if (= s -1) (begin (print "epipe-fail: listen") (print "FAIL")) (let c (net.connect "127.0.0.1" 9891 3000) (if (int? c) (let a (accept_retry s) (begin (net.write a "ping") (let got (read_retry c)) (net.close c) (let ok (write_until_epipe a 0)) (net.close a) (net.close s) (if (and ok (= (str.length got) 4)) (begin (print "epipe-ok") (print "PASS")) (begin (print "epipe-fail") (print "FAIL"))))) (begin (print "epipe-fail: connect") (net.close s) (print "FAIL"))))))))
