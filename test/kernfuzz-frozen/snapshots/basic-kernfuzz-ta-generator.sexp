((import "tinyactor:lib/str" "tinyactor:lib/str") (import "tinyactor:tools/kernfuzz/tafuzz_finding" "tinyactor:tools/kernfuzz/tafuzz_finding") (import "tinyactor:tools/kernfuzz/tafuzz_gen" "tinyactor:tools/kernfuzz/tafuzz_gen") (define (main) (let src (tafuzz_gen.program 10007) (let known (cons "mismatch:0000000000000000" (cons "hang:1111111111111111" nil)) (let bad (sum (list (check "deterministic" (str.eq src (tafuzz_gen.program 10007))) (check "distinct-seeds" (= (str.eq src (tafuzz_gen.program 10008)) false)) (check "neighbors-distinct" (distinct_run "" 12 10000)) (check "is-a-program" (>= (str.index_of src "fn main() {") 0)) (check "signature-stable" (str.eq (tafuzz_finding.signature "mismatch" src) (tafuzz_finding.signature "mismatch" (tafuzz_gen.program 10007)))) (check "signature-ignores-blank-lines" (str.eq (tafuzz_finding.signature "mismatch" src) (tafuzz_finding.signature "mismatch" (str.concat src "\n\n")))) (check "signature-ignores-indent" (str.eq (tafuzz_finding.signature "mismatch" src) (tafuzz_finding.signature "mismatch" (reindent src)))) (check "signature-sees-content" (= (str.eq (tafuzz_finding.signature "mismatch" src) (tafuzz_finding.signature "mismatch" (str.concat src "x"))) false)) (check "signature-length" (= (str.length (tafuzz_finding.sig_of src)) 16)) (check "signature-prefix" (= (str.index_of (tafuzz_finding.signature "hang" src) "hang:") 0)) (check "dedup-hit" (tafuzz_finding.known "hang:1111111111111111" known)) (check "dedup-across-categories" (tafuzz_finding.known "mismatch:1111111111111111" known)) (check "dedup-miss" (= (tafuzz_finding.known "hang:2222222222222222" known) false)))) (if (= bad 0) (print "PASS") (print (str.concat "FAIL - cases=" (str.from_int bad)))))))) (define (distinct_run prev n seed) (if (= n 0) true (let src (tafuzz_gen.program seed) (if (and (!= prev "") (str.eq prev src)) false (distinct_run src (- n 1) (+ seed 1)))))) (define (reindent src) (str.join (str.split src "\n") "\n\t  ")) (define (check name ok) (if ok 0 (begin (print (str.concat "FAIL " name)) 1))) (define (sum results) (if (null? results) 0 (+ (car results) (sum (cdr results))))))
