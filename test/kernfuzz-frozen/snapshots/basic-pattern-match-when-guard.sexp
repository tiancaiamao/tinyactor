((define (test_guard) (let x 5 (match x (n (> n 0) (print "positive")) (_ (print "zero_or_neg"))))) (define (test_guard_false) (let x -3 (match x (n (> n 0) (print "positive")) (_ (print "zero_or_neg"))))) (define (test_guard_var) (let x 42 (match x (n (= n 42) (print "is 42")) (_ (print "not 42"))))) (define (test_guard_false_literal) (let x 42 (match x (n false (print "never")) (_ (print "fallback"))))) (define (main) (begin (test_guard) (test_guard_false) (test_guard_var) (test_guard_false_literal))))
