((import "option" "option") (import "str" "str") (define (show_list xs) (let parts (str.join xs "|") (str.concat "[" (str.concat parts "]")))) (define (check label got want) (let pass (str.eq got want) (begin (if pass (print (str.concat "ok - " label)) (print (str.concat "FAIL - " (str.concat label (str.concat ": got " (str.concat got (str.concat ", want " want))))))) (if pass 1 0)))) (define (check_split label xs want) (check label (show_list xs) want)) (define (check_int label got want) (check label (str.from_int got) want)) (define (ws_all) (str.concat (str.chr 9) (str.concat (str.chr 10) (str.concat (str.chr 11) (str.concat (str.chr 12) (str.concat (str.chr 13) "")))))) (define (main) (let ok1 (check_split "split simple" (str.split "a,b,c" ",") "[a|b|c]") (let ok2 (check_split "split sep absent" (str.split "abc" ",") "[abc]") (let ok3 (check_split "split empty piece" (str.split "a,,b" ",") "[a||b]") (let ok4 (check_split "split edge pieces" (str.split ",a," ",") "[|a|]") (let ok5 (check_split "split empty sep" (str.split "ab" "") "[a|b]") (let ok6 (check_split "split empty string" (str.split "" ",") "[]") (let ok7 (check_split "split multi-char sep" (str.split "banana" "an") "[b||a]") (let ok8 (check_split "split non-overlapping" (str.split "aaa" "aa") "[|a]") (let ok9 (check_int "split empty string length" (str.length (car (str.split "" ","))) "0") (let ok10 (check "join 3 elems" (str.join (cons "x" (cons "y" (cons "z" nil))) "-") "x-y-z") (let ok11 (check "join empty list" (str.join nil "-") "") (let ok12 (check_int "join empty length" (str.length (str.join nil "-")) "0") (let ok13 (check_int "join solo length" (str.length (str.join (cons "solo" nil) "-")) "4") (let ok14 (check_int "join empty sep length" (str.length (str.join (cons "a" nil) "")) "1") (let ok15 (check "trim spaces" (str.concat "<" (str.concat (str.trim "  hi  ") ">")) "<hi>") (let ok16 (check "trim tabs/newlines" (str.concat "<" (str.concat (str.trim "\t\nhi\r") ">")) "<hi>") (let ok17 (check 