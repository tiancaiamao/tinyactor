at garbage" (match (str.parse_float "abc") ((Some f) (str.from_float f)) ((quote None) "none")) "none") (let ok39 (check "parse_float empty" (match (str.parse_float "") ((Some f) (str.from_float f)) ((quote None) "none")) "none") (let ok40 (check "parse_float trailing garbage" (match (str.parse_float "3.5x") ((Some f) (str.from_float f)) ((quote None) "none")) "none") (let ok41 (check "parse_float no dot" (match (str.parse_float "3") ((Some f) (str.from_float f)) ((quote None) "none")) "3") (let ok42 (check "from_float 1.5" (str.from_float (float "1.5")) "1.5") (let ok43 (check "from_float %g trims" (str.from_float (+ (float "0.1") (float "0.2"))) "0.3") (let ok44 (check "from_float negative" (str.from_float (float "-2.25")) "-2.25") (let ok45 (check "from_float exponent form" (str.from_float (float "1000000.0")) "1e+06") (let ok46 (check "from_float integral" (str.concat "[" (str.concat (str.from_float (float "3.0")) "]")) "[3]") (let ok47 (check_int "from_base hex" (str.from_base "ff" 16) "255") (let ok48 (check_int "from_base hex uppercase" (str.from_base "FF" 16) "255") (let ok49 (check_int "from_base binary" (str.from_base "1010" 2) "10") (let ok50 (check_int "from_base octal" (str.from_base "777" 8) "511") (let ok51 (check_int "from_base zero" (str.from_base "0" 16) "0") (let ok52 (check_int "from_base bad digit" (str.from_base "xyz" 16) "-1") (let ok53 (check_int "from_base digit out of base" (str.from_base "2" 2) "-1") (let ok54 (check_int "from_base empty" (str.from_base "" 16) "-1") (let ok55 (check_int "from_base base 10 unsupported" (str.from_base "10" 10) "-1") (let ok56 (check "to_base hex" (str.to_base 255 16) "ff") (let ok57 (check "to_base binary" (str.to_base 10 2) "1010") (let ok58 (check "to_base octal" (str.to_base 511 8) "777") (let ok59 (check "to_base zero" (str.to_base 0 2) "0") (let ok60 (check "to_base -1 unsigned 48-bit" (str.to_base -1 16) "ffffffffffff") (let ok61 (check "to_base bad base" (str.to_base 255 10) "") (let ok62 (check_int "