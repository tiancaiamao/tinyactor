((import "tinyactor:lib/str" "tinyactor:lib/str") (type PPair (a b) (MkPPair a b)) (type-sig second ((PPair Int String)) String) (define (second p) (match p ((cons (quote MkPPair) (cons n (cons s nil))) s))) (type-sig swap ((PPair Int String)) (PPair String Int)) (define (swap p) (match p ((cons (quote MkPPair) (cons n (cons s nil))) (cons (quote MkPPair) (cons s (cons n nil)))))) (type-sig wrap (Int) nil) (define (wrap x) x) (type PList (a) (quote PNil) (PCons a (cons (quote PList) (cons a nil)))) (type-sig single (a) (PList a)) (define (single x) (cons (quote PCons) (cons x (cons (quote PNil) nil)))) (type-sig plen ((PList Int)) Int) (define (plen lst) (match lst ((quote PNil) 0) ((cons (quote PCons) (cons h (cons t nil))) (+ 1 (plen t))))) (type MResult (a b) (MOk a) (MErr b)) (type-sig unwrap ((MResult Int String)) Int) (define (unwrap r) (match r ((cons (quote MOk) (cons v nil)) v) ((cons (quote MErr) (cons e nil)) 0))) (type-sig self_pid nil Pid) (define (self_pid) (self)) (type-sig worker_pid nil Pid) (define (worker_pid) (spawn count_to_one)) (define (count_to_one) (let me (recv) (send me 1))) (define (main) (begin (print (second (cons (quote MkPPair) (cons 1 (cons "s" nil))))) (match (swap (cons (quote MkPPair) (cons 1 (cons "s" nil)))) ((cons (quote MkPPair) (cons s (cons n nil))) (print (str.concat s (str.from_int n))))) (print (+ (wrap 41) 1)) (print (plen (single 7))) (match (single "s") ((quote PNil) (print "FAIL PNil")) ((cons (quote PCons) (cons h (cons t nil))) (print h))) (print (+ (unwrap (cons (quote MOk) (cons 9 nil))) (unwrap (cons (quote MErr) (cons "no" nil))))) (send (self_pid) 7) (print (recv)) (send (worker_pid) (self)) (print (recv)) (print "PASS"))))
