((import "tinyactor:lib/str" "tinyactor:lib/str") (type PPair (a b) (MkPPair a b)) (type-sig second ((PPair Int String)) String) (define (second p) (match p ((tuple (quote MkPPair) n s) s))) (type-sig swap ((PPair Int String)) (PPair String Int)) (define (swap p) (match p ((tuple (quote MkPPair) n s) (tuple (quote MkPPair) s n)))) (type-sig wrap (Int) nil) (define (wrap x) x) (type PList (a) (quote PNil) (PCons a (tuple (quote PList) a))) (type-sig single (a) (PList a)) (define (single x) (tuple (quote PCons) x (quote PNil))) (type-sig plen ((PList Int)) Int) (define (plen lst) (match lst ((quote PNil) 0) ((tuple (quote PCons) h t) (+ 1 (plen t))))) (type MResult (a b) (MOk a) (MErr b)) (type-sig unwrap ((MResult Int String)) Int) (define (unwrap r) (match r ((tuple (quote MOk) v) v) ((tuple (quote MErr) e) 0))) (type-sig self_pid nil Pid) (define (self_pid) (self)) (type-sig worker_pid nil Pid) (define (worker_pid) (spawn count_to_one)) (define (count_to_one) (let me (recv) (send me 1))) (define (main) (begin (print (second (tuple (quote MkPPair) 1 "s"))) (match (swap (tuple (quote MkPPair) 1 "s")) ((tuple (quote MkPPair) s n) (print (str.concat s (str.from_int n))))) (print (+ (wrap 41) 1)) (print (plen (single 7))) (match (single "s") ((quote PNil) (print "FAIL PNil")) ((tuple (quote PCons) h t) (print h))) (print (+ (unwrap (tuple (quote MOk) 9)) (unwrap (tuple (quote MErr) "no")))) (send (self_pid) 7) (print (recv)) (send (worker_pid) (self)) (print (recv)) (print "PASS"))))
