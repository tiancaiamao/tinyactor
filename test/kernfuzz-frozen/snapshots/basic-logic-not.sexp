((import "bool") (define (main) (begin (print (bool.not false)) (print (bool.not true)) (print (bool.not (= 1 2))) (print (bool.not (> 2 1))) (print (bool.not (null? nil))) (print (bool.not (null? (cons 1 nil)))) (print (bool.not (bool.not true))) (let b false) (print (bool.not b)) (if (bool.not false) (print "IF-OK") (print "IF-BAD")) (let w (wrap (make))) (let r2 (w (cons 2 nil))) (print (bool.not (null? r2))) (print "PASS"))) (define (make) (lambda (toks) toks nil)) (define (wrap p) (lambda (toks) (p toks) nil)))
