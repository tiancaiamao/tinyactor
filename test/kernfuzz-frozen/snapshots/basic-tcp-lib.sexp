((import "tcp" "tcp") (import "option" "option") (import "result" "result") (import "str" "str") (import "random" "random") (type Bound nil (Bound ok port lst)) (define (bind_free_port tries) (if (= tries 0) (cons (quote Bound) (cons 0 (cons -1 (cons (cons (quote Conn) (cons 0 nil)) nil)))) (let p (match (random.rand_int 20000) ((cons (quote Ok) (cons r nil)) (+ 20000 r)) ((cons (quote Err) (cons _ nil)) -1)) (if (= p -1) (bind_free_port (- tries 1)) (match (tcp.listen p) ((cons (quote Ok) (cons lst nil)) (cons (quote Bound) (cons 1 (cons p (cons lst nil))))) ((cons (quote Err) (cons _ nil)) (bind_free_port (- tries 1)))))))) (define (unwrap_ok r) (match r ((cons (quote Ok) (cons v nil)) v) ((cons (quote Err) (cons _ nil)) (/ 1 0)))) (define (check_eq label got want) (if (= got want) (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (scenario_echo) (let bound (bind_free_port 50) (match bound ((cons (quote Bound) (cons 0 (cons _ (cons _ nil)))) (begin (print "FAIL - bind") 1)) ((cons (quote Bound) (cons 1 (cons port (cons lst nil)))) (match (tcp.connect "127.0.0.1" port 3000) ((cons (quote Err) (cons _ nil)) (begin (print "FAIL - connect") (tcp.close lst) 1)) ((cons (quote Ok) (cons cli nil)) (let srv (unwrap_ok (tcp.accept lst)) (let f1 (check_eq "write returns total" (unwrap_ok (tcp.write cli "hello-tcp")) 9) (let f2 (match (tcp.read srv 4096) ((cons (quote Ok) (cons (cons (quote Some) (cons d nil)) nil)) (check_eq "server reads payload" d "hello-tcp")) (_ (begin (print "FAIL - server reads payload") 1))) (let f3 (check_eq "echo write returns total" (unwrap_ok (tcp.write srv "HELLO-TCP")) 9) (let f4 (match (tcp.read cli 4096) ((cons (quote Ok) (cons (cons (quote Some) (cons d nil)) nil)) (check_eq "client reads echo" d "HELLO-TCP")) (_ (begin (print "FAIL - client reads echo") 1))) (let f5 (check_eq "close server" (unwrap_ok (tcp.close srv)) 1) (let f6 (match (tcp.read cli 4096) ((cons (quote Ok) (cons (quote None) nil)) (begin (print "ok - read to eof") 0)) (_ (begin (print "FAIL - read to eof") 1))) (let f7 (check_eq "close client" (unwrap_ok (tcp.close cli)) 1) (let f8 (check_eq "close listener" (unwrap_ok (tcp.close lst)) 1) (let f9 (match (tcp.read cli 64) ((cons (quote Err) (cons (cons (quote IoErr) (cons e nil)) nil)) (check_eq "stale read carries errno" (> e 0) true)) (_ (begin (print "FAIL - stale read is Err(IoErr)") 1))) (let f10 (check_eq "double close is ok" (unwrap_ok (tcp.close cli)) 1) (+ (+ (+ (+ (+ (+ (+ (+ (+ f1 f2) f3) f4) f5) f6) f7) f8) f9) f10)))))))))))))))))) (define (scenario_refused) (let bound (bind_free_port 50) (match bound ((cons (quote Bound) (cons 0 (cons _ (cons _ nil)))) (begin (print "FAIL - bind (refused scenario)") 1)) ((cons (quote Bound) (cons 1 (cons port (cons lst nil)))) (begin (tcp.close lst) (match (tcp.connect "127.0.0.1" port 3000) ((cons (quote Err) (cons (cons (quote ConnErr) (cons (quote refused) nil)) nil)) (begin (print "ok - refused is ConnErr('refused)") 0)) ((cons (quote Err) (cons (cons (quote ConnErr) (cons _ nil)) nil)) (begin (print "FAIL - refused got other symbol") 1)) ((cons (quote Err) (cons (cons (quote IoErr) (cons _ nil)) nil)) (begin (print "FAIL - refused got IoErr") 1)) ((cons (quote Ok) (cons _ nil)) (begin (print "FAIL - refused port connected (port was stolen)") 1)))))))) (define (main) (let total (+ (scenario_echo) (scenario_refused)) (if (= total 0) (print "PASS") (print (str.concat "FAIL - scenarios: " (str.from_int total)))))))
