((import "timer" "timer") (import "time" "time") (import "str" "str") (define (check label ok) (if ok (begin (print (str.concat "ok - " label)) 0) (begin (print (str.concat "FAIL - " label)) 1))) (define (got_msg) (match (recv_after 150) (nil 0) (_ 1))) (define (test_send_after me) (let t0 (time.monotonic_ms) (let _ (timer.send_after me 60 (quote ping)) (let got (recv) (let dt (- (time.monotonic_ms) t0) (let f (check "send_after delivers the message" (= got (quote ping))) (let f (+ f (check "send_after lower bound" (>= dt 60))) f))))))) (define (test_cancel me) (let id (timer.send_after me 60 (quote cancelled)) (let c (timer.cancel id) (let s (time.sleep 150) (let f (check "cancel reports a cancelled timer" (= c 1)) (let f (+ f (check "cancel prevented delivery" (= (got_msg) 0))) (let f (+ f (check "cancel of fired id reports 0" (= (timer.cancel id) 0))) (let f (+ f (check "cancel of id 0 reports 0" (= (timer.cancel 0) 0))) (let f (+ f (check "sleep returned 0 during cancel wait" (= s 0))) f))))))))) (define (test_interval me) (let iid (timer.send_interval me 40 (quote tick)) (let t1 (recv) (let t2 (recv) (let t3 (recv) (let stopped (timer.cancel iid) (let extra (got_msg) (let f (check "interval fired 3 times" (and (= t1 (quote tick)) (and (= t2 (quote tick)) (= t3 (quote tick))))) (let f (+ f (check "interval cancel reports a cancelled timer" (= stopped 1))) (let f (+ f (check "interval stopped after cancel" (= extra 0))) f)))))))))) (define (test_sleep_mailbox me) (begin (send me (quote queued)) (let s (time.sleep 120)) (let f (check "sleep returns 0" (= s 0))) (let f (+ f (check "sleep does not consume the mailbox" (= (recv) (quote queued))))) f)) (define (drain_ticks max_n wait_ms count) (if (>= count max_n) count (match (recv_after wait_ms) (nil count) ((quote stresstick) (drain_ticks max_n wait_ms (+ count 1))) (_ (drain_ticks max_n wait_ms count))))) (define (cancel_stress_cycles n me) (if (= n 0) 0 (let id (timer.send_interval me 1 (quote stresstick)) (let c (timer.cancel id) (let rest (cancel_stress_cycles (- n 1) me) (+ c rest)))))) (define (test_cancel_in_flight_race me) (let cycles 40 (let cancels_ok (cancel_stress_cycles cycles me) (let f (check "in-flight-race: all cancels acknowledged" (= cancels_ok cycles)) (let got1 (drain_ticks 200 100 0) (let f (+ f (check "in-flight-race: no leaked interval flooding" (<= got1 cycles))) (let got2 (drain_ticks 200 100 0) (let f (+ f (check "in-flight-race: zero fires after cancel" (= got2 0))) f)))))))) (define (test_dead_target_interval) (let doomed (spawn (lambda nil 0 nil)) (let id (timer.send_interval doomed 20 (quote ghost)) (let s (time.sleep 120) (let f (check "dead-target: sleep returned 0" (= s 0)) (let f (+ f (check "dead-target: interval self-removed" (= (timer.cancel id) 0))) f)))))) (define (main) (let me (self) (let failures (test_send_after me) (let failures (+ failures (test_cancel me)) (let failures (+ failures (test_interval me)) (let failures (+ failures (test_sleep_mailbox me)) (let failures (+ failures (test_cancel_in_flight_race me)) (let failures (+ failures (test_dead_target_interval)) (if (= failures 0) (print "PASS") (print (str.concat "FAILURES: " (str.from_int failures)))))))))))))
