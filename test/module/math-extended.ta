// math-extended.ta — POSITIVE test: C-backed math functions (lib/math.c)
// plus the pure-TA helpers min/clamp. Float comparisons use a 1e-9
// tolerance (print formatting of floats is not contractual, so no exact
// string matching); the NaN contract is checked with the `x != x` idiom
// (NaN is the only value unequal to itself).
// Expected: prints PASS (harness checks exit 0 + output).
import math

fn approx(a, b) {
  let d = a - b;
  if d < 0.0 {
    0.0 - d
  } else {
    d
  }
}

fn main() {
  let f0 = 0;
  // floor / ceil: float -> int, toward -inf / +inf
  let f1 = if math.floor(2.7) == 2 { f0 } else { f0 + 1 };
  let f2 = if math.floor(-2.1) == 0 - 3 { f1 } else { f1 + 1 };
  let f3 = if math.floor(2.0) == 2 { f2 } else { f2 + 1 };
  let f4 = if math.ceil(2.1) == 3 { f3 } else { f3 + 1 };
  let f5 = if math.ceil(-2.9) == 0 - 2 { f4 } else { f4 + 1 };
  let f6 = if math.ceil(3.0) == 3 { f5 } else { f5 + 1 };

  // sqrt: exact + tolerance cases, then the negative-input NaN contract
  let f7 = if math.sqrt(0.0) == 0.0 { f6 } else { f6 + 1 };
  let f8 = if math.sqrt(9.0) == 3.0 { f7 } else { f7 + 1 };
  let f9 = if approx(math.sqrt(2.0), 1.4142135623730951) < 0.000000001 { f8 } else { f8 + 1 };
  let neg1 = math.sqrt(-1.0);
  let f10 = if neg1 != neg1 { f9 } else { f9 + 1 };

  // log / exp
  let f11 = if math.log(1.0) == 0.0 { f10 } else { f10 + 1 };
  let f12 = if approx(math.log(math.exp(1.0)), 1.0) < 0.000000001 { f11 } else { f11 + 1 };
  let neg2 = math.log(-1.0);
  let f13 = if neg2 != neg2 { f12 } else { f12 + 1 };

  // pow
  let f14 = if math.pow(2.0, 10.0) == 1024.0 { f13 } else { f13 + 1 };
  let f15 = if approx(math.pow(2.0, 0.5), math.sqrt(2.0)) < 0.000000001 { f14 } else { f14 + 1 };

  // trig + atan
  let f16 = if math.sin(0.0) == 0.0 { f15 } else { f15 + 1 };
  let f17 = if math.cos(0.0) == 1.0 { f16 } else { f16 + 1 };
  let f18 = if math.tan(0.0) == 0.0 { f17 } else { f17 + 1 };
  let f19 = if approx(math.atan(1.0), 0.7853981633974483) < 0.000000001 { f18 } else { f18 + 1 };

      // pure-TA helpers: abs/min/max kept (int helpers — comparison-based
  // bodies pin untyped params to int), min added; clamp is C-backed float
  // (see lib/math.ta), boundaries: pass-through, low, high.
  let f20 = if math.abs(-5) == 5 { f19 } else { f19 + 1 };
  let f21 = if math.min(3, 7) == 3 { f20 } else { f20 + 1 };
  let f22 = if math.min(-2, -9) == 0 - 9 { f21 } else { f21 + 1 };
  let f23 = if math.max(3, 7) == 7 { f22 } else { f22 + 1 };
  let f24 = if math.clamp(1.0, 5.0, 3.0) == 3.0 { f23 } else { f23 + 1 };
  let f25 = if math.clamp(1.0, 5.0, -2.0) == 1.0 { f24 } else { f24 + 1 };
  let f26 = if math.clamp(1.0, 5.0, 9.0) == 5.0 { f25 } else { f25 + 1 };
    let f27 = if math.clamp(0.5, 2.5, 9.0) == 2.5 { f26 } else { f26 + 1 };

  // runtime arg guard (params are untyped at the type layer by design):
  // a non-float arg must yield NaN, not a crash
  let bad = math.sqrt("x");
  let f28 = if bad != bad { f27 } else { f27 + 1 };

  if f28 == 0 {
    print("PASS")
  } else {
    print("FAIL")
  }
}