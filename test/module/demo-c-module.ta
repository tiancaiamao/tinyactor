// Test: demo-c-module
// Purpose: E3 — minimal C module (lib/demo.dylib) loads on first call.
//          Verifies the three template patterns:
//            demo.double : pure int ops
//            demo.greet  : string construction
//            demo.pair   : pair construction
//          The import below is REQUIRED, not decorative: lib/demo.ta carries
//          the external fn declarations, so calls are type-checked. Calling
//          demo.* with no import is a hard [E0004] (the permissive
//          dotted-call path only covers modules already in env at compile
//          time: vm/int/float/net/timer/cov plus the hardcoded str.* sigs).

import "tinyactor:lib/demo"

fn main() {
  print(demo.double(21))                    // 42
  print(demo.greet("ta"))                   // hello ta
  let p = demo.pair(1, 2)
  print(p)                                  // (1 . 2)
  // Error convention (bad arg -> nil) tested at runtime only; typecheck now
  // prevents mismatched args
  print("PASS")
}