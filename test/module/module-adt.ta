import "tinyactor:lib/msg"
fn server() {
    match recv() {
    msg.Ping(from) -> { send(from, msg.Pong); server() }
    msg.Stop -> print("done")
    _ -> server()
  }
}
fn main() {
  let pid = spawn(fn { server() })
  send(pid, msg.Ping(self()))
  match recv() {
    msg.Pong -> print("got-pong")
    _ -> print("fail")
  }
  send(pid, msg.Stop)
  print("PASS")
}
