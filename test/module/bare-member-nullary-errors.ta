// bare-member-nullary-errors.ta — NEGATIVE test (issue #462 P4): 无参构造子
// 当值时也是一个 symbols（`(quote None)`），裸写同样要报错并给出限定写法。
// 这条和 bare-member-ctor-errors.ta（带参构造子的调用形态）走的是 typecheck
// 里两条不同的路径，所以各留一个负例。
import "tinyactor:lib/option"

fn main() {
  let o = None
  print(option.is_none(o))
}

// expect: 'None' is not in scope; did you mean 'option.None'?