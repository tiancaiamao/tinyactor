// test/module/file-mkdir-p.ta — regression tests for fs.mkdir_p.
//
// fs.mkdir_p(path) recursively creates missing parent directories, is
// idempotent for existing directories, and returns 1 on success / 0 on
// failure (mirroring file.write's integer status convention).
//
// Covered: nested path creation (none of the parents exist), a repeated
// call on the same path, an already-existing directory, and two failure
// cases — a parent component that is a regular file, and a final path
// component that is a regular file.
//
// Scratch isolation: the test only ever touches its own root under /tmp,
// keyed by vm.time_us() so separate runs never collide with each other or
// with any repository path. TA exposes no file-deletion primitive, so a
// leftover scratch root from a crashed run is inert (every run uses a
// fresh, unique root) and disposable; the test never touches repo paths.
//
// Expected output: ok - <label> for every check, then PASS.

import file
import fs

fn join(a, b) {
  str.concat(str.concat(a, "/"), b)
}

fn check(label, got, want) {
  if got == want {
    print(str.concat("ok - ", label))
  } else {
    print(str.concat("FAIL - ", str.concat(label,
      str.concat(": got ", str.concat(str.from_int(got),
        str.concat(" want ", str.from_int(want)))))))
  }
}

fn main() {
  let root = str.concat("/tmp/ta_mkdir_p_", str.from_int(vm.time_us()))

  // 1) Nested path creation: none of the parent directories exist yet.
  let nested = join(join(join(root, "deep"), "nested"), "path")
    check("nested create", fs.mkdir_p(nested), 1)
  check("nested exists", file.exists(nested), 1)
  check("parent exists", file.exists(join(join(root, "deep"), "nested")), 1)

  // 2) Repeated call on the same (now existing) path is idempotent.
    check("repeated call", fs.mkdir_p(nested), 1)


  // 3) Already-existing directory: created first, then called again.
  let existing = join(root, "existing")
  check("create existing", fs.mkdir_p(existing), 1)
  check("existing again", fs.mkdir_p(existing), 1)
  check("existing is dir", file.exists(existing), 1)

  // 4) Failure: a regular file blocks a parent component -> 0.
  let blocker = join(root, "blocker")
  check("write blocker", file.write(blocker, "x"), 1)
  check("mkdir through file", fs.mkdir_p(join(blocker, "sub")), 0)

  // 5) Failure: the final path component is an existing regular file -> 0.
  let ffile = join(root, "notadir")
  check("write notadir", file.write(ffile, "x"), 1)
  check("mkdir on file", fs.mkdir_p(ffile), 0)

  print("PASS")
}