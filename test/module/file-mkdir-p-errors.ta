// test/module/file-mkdir-p-errors.ta — negative type checks for fs.mkdir_p.
//
// fs.mkdir_p is declared string -> int by the standard-library fs module.
// A non-string argument must be a compile-time type error, and an extra
// argument must be an arity error.
import fs

fn main() {
  let bad = fs.mkdir_p(42)
  let extra = fs.mkdir_p("a", "b")
  print("PASS")
}