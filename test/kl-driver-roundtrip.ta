// Test: kl-driver-roundtrip — 管线级等价门 G-B（test 侧单进程版）
//
//   compile(lower(driver.ta))  ==  compile(read(write(lower(driver.ta))))   （.tabc 逐字节）
//
// 用的是 driver 的公开半程（parse_module_content / resolve_imports /
// typecheck_cached），与 driver.compile_main 同序同参 —— 所以这条门在
// C1 阶段就能红/绿，不必等 C2 的真实接缝（--emit-kl / --from-kl）；C2 会把
// 它搬成 run_bootstrap_tests.sh 里的两进程 + cmp 形态。
//
// V1（verbatim：match **不**脱糖）：kl.write 是纯序列化器，不做任何 pass，
// 所以本测试跑的就是 verbatim 形态 —— 断言 lower 产物里 match 节点数 > 0
// 直接把"未脱糖"钉住（旧 harness 是先脱糖再写，那才是没验的那一半）。
//
// 位置：本文件在 test/ 根目录（不在 test/compiler/ 里），所以 run_category
// 不会自动发现它 —— 它是**管线门**而不是单元测试，由 run_compiler_tests.sh
// 用 TEST_TIMEOUT=300 显式调用（本地 ~10s，CI ~3x）。
// 内存：driver 全闭包 + 两张 bytecode 镜像同进程，实测 floor ≈ 47 MiB，默认
// 64 MiB arena 够（见 docs/kl-format.md §arena），所以不需要 TA_ACTOR_HEAP。
// Expected output: "ok" only.
// expect-not: FAIL
import bytecode
import compile
import driver
import file
import kl
import list
import lower-ast
import sexp
import typecheck

const SRC = "lib/bootstrap/driver.ta"
const OUT_A = "/tmp/kl-gb-a.tabc"
const OUT_B = "/tmp/kl-gb-b.tabc"

fn p(cond) {
  if cond { print("ok") } else { print("FAIL") }
}

// count_match: 树里 head 是 match 的列表个数（V1 证据）。深层遍历，因为
// driver 的顶层 form 全是 def，match 都在 lambda 体里。
fn count_match(v) {
  if pair?(v) {
    (if car(v) == 'match { 1 } else { 0 }) + count_match(car(v)) + count_match(cdr(v))
  } else {
    0
  }
}

// contains: s 里是否有字符 c
fn contains(s, i, n, c) {
  if i >= n {
    false
  } else if str.char_at(s, i) == c {
    true
  } else {
    contains(s, i + 1, n, c)
  }
}

// compile_to: 编译一个（已 lower 的）程序，写 .tabc 并把文本读回来做比较。
fn compile_to(prog, out) {
  match compile.compile(prog) {
    Fail(msg) -> {
      print(str.concat("FAIL compile: ", msg))
      ""
    }
    Out(fns, consts) -> {
      bytecode.write_bc(out, fns, consts)
      file.read(out)
    }
  }
}

fn run_compare(forms, seq) {
  let tc = driver.typecheck_cached(forms, seq, "", 0)
  if typecheck.count_errors(tc) > 0 {
    print("FAIL typecheck errors")
  } else {
    let low = lower-ast.lower_program(forms)
    if int?(low) {
      print("FAIL lower")
    } else {
      let n = count_match(low)
      p(n > 0)
      print(str.concat("match forms: ", str.from_int(n)))
      let text = kl.write_program(low)
      print(str.concat(".kl bytes: ", str.from_int(str.length(text))))
      // V1：match **不**脱糖 —— 读回来的树里 match 节点数不变（writer 是
      // 纯序列化器，脱糖是 compile.match_desugar 的事）
      p(count_match(sexp.parse(text)) == n)
      // lib_src 是两条路径共享的前置（文本 -> forms，driver 同款）；
      // V5：真实管线的 reader 输入里没有一个 `'` —— 引号规则改的是 4 种
      // 拼写的读法，而前奏文本完全不用引号（用到的调用点只有 .kl 自己的
      // 测试，见 run_compiler_tests.sh 的 grep 断言）
      let lib = sexp.parse(bytecode.lib_src())
      p(contains(bytecode.lib_src(), 0, str.length(bytecode.lib_src()), '\'') == false)
      let a = compile_to(list.append(lib, low), OUT_A)
      let b = compile_to(list.append(lib, sexp.parse(text)), OUT_B)
      p(str.length(a) > 0)
      p(a == b)
      if a == b {
        print(str.concat(".tabc header: ", str.substr(a, 0, 20)))
      } else {
        print("FAIL .tabc differs")
        print(str.concat("  a: ", str.substr(a, 0, 20)))
        print(str.concat("  b: ", str.substr(b, 0, 20)))
      }
    }
  }
}

fn main() {
  let text = file.read(SRC)
  if null?(text) {
    print(str.concat("FAIL no-read ", SRC))
  } else {
    let pr = driver.parse_module_content(text, SRC, 1, 0)
    if null?(cdr(pr)) == false {
      print(str.concat("FAIL parse: ", cdr(pr)))
    } else {
      let rr = driver.resolve_imports(car(pr), driver.dirname(SRC), 1, 0)
      let rerr = cdr(cdr(rr))
      if null?(rerr) == false {
        print(str.concat("FAIL module: ", rerr))
      } else {
                run_compare(car(rr), car(cdr(rr)))
      }
    }
  }
}