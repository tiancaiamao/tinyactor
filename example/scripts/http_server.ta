// http_server.ta — HTTP Server for TinyActor VM (lib/http.ta demo)
//
// Route table is a Dict(path -> handler); http.serve binds and runs the
// accept loop. This is a persistent server: it runs forever (excluded
// from the automated example tests).
import http
import dict
import str

fn json_response(body) {
  MkResp(
    200,
    dict.insert(dict.str_new(), "Content-Type", "application/json"),
    body
  )
}

fn routes() {
  dict.insert(
    dict.insert(
      dict.insert(dict.str_new(), "/", fn(_req) {
        MkResp(
          200,
          dict.insert(dict.str_new(), "Content-Type", "text/html"),
          "<h1>Hello from TinyActor!</h1>"
        )
      }),
      "/api",
      fn(_req) {
        json_response("{\"status\":\"ok\"}")
      }
    ),
    "/time",
    fn(_req) {
      http.text_response(200, str.from_int(vm.time_ms()))
    }
  )
}

fn main() {
  // Port: first CLI arg, default 8080. Print BEFORE serve: serve_loop
  // only returns when the listener is gone, so anything after it runs
  // at shutdown, not at startup.
  let p = str.to_int(vm.get_arg(0))
  let port = if p > 0 { p } else { 8080 }
  match http.listen_routes(routes(), port) {
    Err(_) -> print(str.concat("failed to listen on port ", str.from_int(port)))
    Ok(lst) -> {
      print(str.concat("HTTP server listening on port ", str.from_int(port)))
      http.serve_loop(routes(), lst)
      0
    }
  }
}