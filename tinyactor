#!/bin/bash
#
# tinyactor — user-facing CLI for the TinyActor runtime.
# Orchestrates tavm + bootstrap.tabc for building and running TA code.
#
# The bootstrap.tabc uses backward compat mode: when invoked with a source
# .ta path and an output .tabc path, it compiles the source to bytecode.
# When invoked with just a source .ta path, it compiles and runs.

set -euo pipefail

CALLER_DIR="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Build dirs are removed at the end of build_ta; this trap catches the
# killed-mid-build case (timeout / Ctrl-C) so a stale build dir (and its
# lib/ symlinks) is not left behind in $TMPDIR.
TA_BUILD_DIR=""
cleanup_build_dir() {
    if [ -n "$TA_BUILD_DIR" ]; then
        rm -rf "$TA_BUILD_DIR"
        TA_BUILD_DIR=""
    fi
}
trap cleanup_build_dir EXIT

absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$CALLER_DIR" "$1" ;;
    esac
}

TAVM="${TAVM:-$SCRIPT_DIR/tavm}"
TAVM="$(absolute_path "$TAVM")"
BOOTSTRAP="${TA_BOOTSTRAP:-$SCRIPT_DIR/lib/bootstrap.tabc}"
if [ ! -x "$TAVM" ]; then
    echo "error: TinyActor runtime not found or not executable: $TAVM" >&2
    echo "build it with 'make tavm' or set TAVM=/path/to/tavm" >&2
    exit 1
fi
if [ ! -s "$BOOTSTRAP" ]; then
    echo "error: TinyActor bootstrap compiler not found: $BOOTSTRAP" >&2
    echo "build it with 'make bootstrap'" >&2
    exit 1
fi
# The http C module is loaded by tavm itself at startup (see tavm.c main),
# so no -L flag is needed. tavm picks the module matching its own build
# (plain / _asan / _tsan), and `import http` compiles because "http" is a
# registered builtin module name.

usage() {
    cat >&2 <<EOF
usage: tinyactor <command> [args...]

Commands:
    build [--verbose] [--no-cache] [--cov] <src>.ta [<out>.tabc]
                                Compile .ta to .tabc (default: <src>.tabc).
                                Module signatures cache in .build/modules/;
                                --verbose prints per-module hit/miss + timing,
                                --no-cache disables the signature cache.
                                --cov instruments fn entries with cov.hit(k)
                                and writes <out>.covmap (k -> fn name).
    run   [--vm=tavm] [--verbose] [--no-cache] <src>.ta [args...]
                                Compile and run. Default VM is lisp (lisp
                                backend compile + lispvm). --vm=tavm falls
                                back to the legacy tavm path.
  fmt   <file>.ta               Format .ta in place (token-level, gofmt-style)
  fmt   --check <file>.ta       Check formatting; exits 1 if file differs
  help                          Show this help
EOF
            exit 1
}

# build_ta: compile src.ta to out.tabc with the bootstrap compiler.
# Typecheck errors abort the build without producing output; surface
# that as a non-zero exit (tavm itself always exits 0).
# The target is removed BEFORE compiling so a failed build can never leave
# a stale pre-existing artifact behind that passes the -s check below
# (that silently shipped an outdated bootstrap.tabc; A3).
require_source() {
    local src="$1"
    if [ ! -f "$src" ]; then
        echo "error: TinyActor source file not found: $src" >&2
        return 1
    fi
}

# cache_dir_arg <nocache_flag> — the signature cache dir passed to the
# compiler (last build arg). Empty string disables caching.
#   --no-cache or TINYACTOR_NO_CACHE=1  -> no cache
#   TA_SIG_CACHE_DIR=<dir>              -> explicit location
#   default                             -> <project>/.build/modules
cache_dir_arg() {
    if [ -n "${1:-}" ] || [ -n "${TINYACTOR_NO_CACHE:-}" ]; then
        printf ''
    elif [ -n "${TA_SIG_CACHE_DIR:-}" ]; then
        printf '%s\n' "$TA_SIG_CACHE_DIR"
    else
        printf '%s\n' "$CALLER_DIR/.build/modules"
    fi
}

# parse_build_flags: consume leading --verbose / --no-cache from the
# command args; sets VFLAG (compiler verbose flag, may be empty), NOCACHE=1
# when caching is disabled, and NFLAGS = number of flags consumed, so the
# caller can shift past them. (Globals, not echo: the assignments must
# survive the call.)
VFLAG=""
NOCACHE=""
COVFLAG=""
NFLAGS=0
parse_build_flags() {
    VFLAG=""
    NOCACHE=""
    COVFLAG=""
    NFLAGS=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose) VFLAG="--verbose" ;;
            --no-cache) NOCACHE=1 ;;
            --cov) COVFLAG="--cov" ;;
            *) break ;;
        esac
        NFLAGS=$((NFLAGS + 1))
        shift
    done
}

build_ta() {
    local src="$1" out="$2" vflag="${3:-}" cache_dir="${4:-}" covflag="${5:-}"
    require_source "$src"
    # Build in $TMPDIR (mktemp: unique, no PID-reuse concerns), NOT under
    # $SCRIPT_DIR: a here-and-gone dir in the working tree races every
    # recursive walk over it (fmt-check's find: GNU find lstat's each entry
    # BEFORE evaluating -path/-prune, so a dir deleted mid-walk is ENOENT →
    # exit 1 → false "FORMAT VIOLATIONS" / make fmt Error 1 under make -j8).
    local build_dir
    build_dir="$(mktemp -d "${TMPDIR:-/tmp}/ta-build.XXXXXX")"
    rm -f "$out"
    mkdir -p "$build_dir/lib"
    TA_BUILD_DIR="$build_dir"
        for module in "$CALLER_DIR"/lib/* "$SCRIPT_DIR"/lib/*; do
        [ -e "$module" ] || continue
        local name="${module##*/}"
        # lib/bootstrap/ (compiler sources) is symlinked as a directory so
        # the driver's lib/ + lib/bootstrap/ fallbacks both resolve inside
        # the build dir.
        [ "$name" = "bootstrap" ] && continue
        [ -e "$build_dir/lib/$name" ] || ln -s "$module" "$build_dir/lib/$name"
    done
    for src_bs in "$CALLER_DIR"/lib/bootstrap "$SCRIPT_DIR"/lib/bootstrap; do
        [ -d "$src_bs" ] || continue
        [ -e "$build_dir/lib/bootstrap" ] || ln -s "$src_bs" "$build_dir/lib/bootstrap"
        break
    done
                local rc=0
    (
        cd "$build_dir"
        # last two args: signature cache dir ("" = whole-program
        # typecheck), then the --cov flag ("" = none)
        # $vflag/$covflag unquoted: empty expands to no arg, set expands to one
        if [ -n "${TA_COV_DUMP_DIR:-}" ]; then
            "$TAVM" "--cov-dump-dir=$TA_COV_DUMP_DIR" "$BOOTSTRAP" $vflag $covflag "$src" "$out" "$cache_dir"
        else
            "$TAVM" "$BOOTSTRAP" $vflag $covflag "$src" "$out" "$cache_dir"
        fi
    ) || rc=$?
    rm -f "$build_dir/lib"/*
    rmdir "$build_dir/lib" "$build_dir"
    TA_BUILD_DIR=""
    if [ "$rc" -ne 0 ]; then
        return "$rc"
    fi
    if [ ! -s "$out" ]; then
        echo "error: build failed - no output produced ($out)" >&2
        return 1
    fi
}

# ensure_lisp_driver — run_lisp 与 fmt 共享的编译半程保障（7b-3 抽出）：
# 检查 lispvm 可执行、boot/backend_driver.bc 缺失/比 .ta 旧时重建。成功后
# 全局 LISPVM、LISP_DRIVER_BC 为可用路径（调用方直接消费）。
# 产物 .bc 与 tavm 路径的 .tabc 是两种格式。backend_driver.bc 为 gitignore
# 产物（非 checked-in）：全新缺失时走旧链补种子（build_ta 出 .tabc → tavm
# 自编译出 .bc）；比 driver 自身 .ta 旧时用现有 .bc 自重建（lispvm 编自己，
# 自举固定点 byte-identical 已实测）；import 的内核（compile.ta 等）变了需
# 手动 `make boot-backend-driver`。
ensure_lisp_driver() {
    LISP_DRIVER_BC="$SCRIPT_DIR/vm-demo/lisp/boot/backend_driver.bc"
    local driver_src="$SCRIPT_DIR/vm-demo/lisp/backend_driver.ta"
    LISPVM="$SCRIPT_DIR/lispvm"
    # 种子分支的 build_ta 一律用仓库 plain bootstrap：BOOTSTRAP 全局在脚本
    # 顶部就从 TA_BOOTSTRAP 捕获（coverage-ta 把它指到 --cov 插桩版），此时改
    # env 前缀 TA_BOOTSTRAP=... 已经无效——build_ta 读的是 $BOOTSTRAP 全局，
    # 不是 env。必须 local shadow（bash 动态作用域，build_ta 看到的就是这个值）。
    # 插桩版编 driver 慢 ~2x，CI 2 核上超 180s 测试超时 → 重建被杀 → driver
    # 永远缺失 → 每个测试都重触发慢重建（coverage-ta 全军覆没的根因）。driver
    # 在 lisp 路径不产出覆盖数据（重建跑在 --cov-dump-dir 缺省下），插桩毫无收益。
    local BOOTSTRAP="$SCRIPT_DIR/lib/bootstrap.tabc"
    if [ ! -x "$LISPVM" ]; then
        echo "error: lispvm not found: $LISPVM" >&2
        echo "build it with 'make lispvm'" >&2
        return 1
    fi
    if [ ! -s "$LISP_DRIVER_BC" ] || [ "$LISP_DRIVER_BC" -ot "$driver_src" ]; then
        echo "boot-backend-driver: (re)building lisp backend driver" >&2
        # 先建临时文件再原子 mv：`make -j8 test` 时多个测试脚本会同时发现
        # driver 缺失/过期，直接写目标路径可能让并发读者拿到半个文件。
        local tmpdrv
        tmpdrv=$(mktemp "$SCRIPT_DIR/vm-demo/lisp/boot/.backend_driver.XXXXXX") || return 1
        if [ -s "$LISP_DRIVER_BC" ]; then
            # 自重建（路线图 7b-2 自举）：现有 .bc 编自己——同输入同输出，
            # 产物 byte-identical 已实测；旧编译器编新源码是 bootstrap 常规。
            # 不碰旧链：tavm 从此不出现在编译半程。
            "$LISPVM" -q "$LISP_DRIVER_BC" "$driver_src" "$tmpdrv" "" || { rm -f "$tmpdrv"; return 1; }
        else
            # 首种子（.bc 全新缺失）：旧链 build_ta 出临时 .tabc → tavm 跑它
            # 自编译出 .bc。BOOTSTRAP 已在 run_lisp 入口 local 成 plain（见上）；
            # TA_COV_DUMP_DIR 清空是动态读的，防止 build_ta 给 tavm 传
            # --cov-dump-dir。7c 删旧链时此分支改走入库种子。
            local tmptabc
            tmptabc=$(mktemp "$SCRIPT_DIR/vm-demo/lisp/boot/.backend_driver.XXXXXX") || { rm -f "$tmpdrv"; return 1; }
            TA_COV_DUMP_DIR= build_ta "$driver_src" "$tmptabc" "" "" "" || { rm -f "$tmptabc" "$tmpdrv"; return 1; }
            TA_COV_DUMP_DIR= "$TAVM" "$tmptabc" "$driver_src" "$tmpdrv" "" || { rm -f "$tmptabc" "$tmpdrv"; return 1; }
            rm -f "$tmptabc"
        fi
        mv -f "$tmpdrv" "$LISP_DRIVER_BC"
    fi
}

# run_lisp <src> [args...]: lisp 双轨运行路径。
# 编译半程 = lispvm 跑 boot/backend_driver.bc（lisp 管线：tokenize/parse/
# lower/compile -> .bc，无 TA typecheck），运行半程 = lispvm（路线图 7b-2 起
# 同宿主；此前编译半程是 tavm 跑 .tabc——已切走，lisp-gate 静态门看守）。
# 喂管线前必须 expand_imports.py 展开 import：lisp 管线是单命名空间，
# 不展开的话 lib 调用（bool.not…）运行期宿主 miss 返回 nil（同 corpus
# 的既有约定，见 run_corpus.sh）。
run_lisp() {
    local src="$1"; shift
    require_source "$src" || return 1
    ensure_lisp_driver || return 1
    # mktemp -d 一次建目录：直接 mktemp file 再拼 .bc 后缀会每次泄漏一个
    # 无后缀空文件；临时目录也顺手解决 exec 无法清理的问题——不再 exec，
    # 走正常 return（调用方 exit $?），rc 语义与 lispvm 一致（含 128+sig）。
    local tmpdir tmpbc rc
    tmpdir=$(mktemp -d /tmp/tinyactor-lisp-XXXXXX) || return 1
    tmpbc="$tmpdir/run.tabc"
    local abs_src
    abs_src=$(absolute_path "$src")
    # typecheck sig cache：项目级目录跨调用共享（lib 模块签名只算一次），
    # TA_SIG_CACHE_DIR 可覆盖。没有它每次 run 都全量 typecheck 全部依赖。
    local CACHE_DIR="${TA_SIG_CACHE_DIR:-$SCRIPT_DIR/.build/modules}"
    # 编译半程在项目根跑：driver 的模块解析按项目根做 lib/ 回退（路径全是
    # 绝对路径，换 CWD 无副作用）；.bc 自包含、无 .tabc 的 CWD 链接约束，这里
    # 保 root 是模块回退的既有语义。运行半程（lispvm）留在调用方 CWD——
    # 用户程序的相对路径语义不变。
    if ! (cd "$SCRIPT_DIR" && "$LISPVM" -q "$LISP_DRIVER_BC" "$abs_src" "$tmpbc" "$CACHE_DIR"); then
        rm -rf "$tmpdir"
        return 1
    fi
        # -q：只打程序输出（与 tavm 路径语义一致：main 返回值不打印）
    # `|| rc=$?` 而非裸跑再取 $?：set -e 下子进程被信号杀（如测试脚本
    # cleanup 的 TERM）会让外壳直接退出，跳过 rm -rf —— 每次异常终止
    # 泄漏一个 /tmp/tinyactor-lisp-XXX 目录。
    rc=0
    "$LISPVM" -q "$tmpbc" "$@" || rc=$?
    rm -rf "$tmpdir"
    return $rc
}

if [ $# -lt 1 ]; then usage; fi

CMD="$1"
shift

case "$CMD" in
            build)
        if [ $# -lt 1 ]; then usage; fi
        parse_build_flags "$@"
        shift "$NFLAGS"
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        OUT="$(absolute_path "${2:-${1%.*}.tabc}")"
                build_ta "$SRC" "$OUT" "$VFLAG" "$(cache_dir_arg "$NOCACHE")" "$COVFLAG"
        ;;
                        run)
        if [ $# -lt 1 ]; then usage; fi
        # 默认 VM = lisp（替换落地）：lisp 后端编译 + lispvm 运行。
        # --vm=tavm 显式回退旧路径（对照/排查用）。build 路径不受影响——
        # 自举链仍走 tavm 编译器（lisp 管线无 TA typecheck，不参与自举）。
        VM=lisp
        while [ $# -gt 0 ]; do
            case "$1" in
                --vm=lisp) VM=lisp ;;
                --vm=tavm) VM=tavm ;;
                --verbose|--no-cache|--cov) ;;
                *) break ;;
            esac
            shift
        done
        if [ $# -lt 1 ]; then usage; fi
        parse_build_flags "$@"
        shift "$NFLAGS"
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
                if [ "$VM" = "lisp" ]; then
            # lisp 路径独立终止：run_lisp 的 rc（含失败 1 / lispvm 128+sig）
            # 原样透传，不 fall through 到 tavm 路径
            run_lisp "$SRC" "$@"
            exit $?
        fi
        if [ -n "${TA_COV_MAP_DIR:-}" ]; then COVFLAG="--cov"; fi
        TMP=$(mktemp /tmp/tinyactor-XXXXXX)
        TMPTABC="$TMP.tabc"
        if ! build_ta "$SRC" "$TMPTABC" "$VFLAG" "$(cache_dir_arg "$NOCACHE")" "${COVFLAG:-}"; then
            rm -f "$TMPTABC"
            exit 1
        fi
        # Replace the wrapper so terminal signals reach tavm directly.
        if [ -n "${TA_COV_MAP_DIR:-}" ]; then
            map_name="$(basename "$TMPTABC").covmap"
            mkdir -p "$TA_COV_MAP_DIR/maps/$map_name" "$TA_COV_MAP_DIR/dumps/$map_name"
            cp "$TMPTABC.covmap" "$TA_COV_MAP_DIR/maps/$map_name/map.covmap"
            exec "$TAVM" "--cov-dump-dir=$TA_COV_MAP_DIR/dumps/$map_name" "$TMPTABC" "$@"
        else
            exec "$TAVM" "$TMPTABC" "$@"
        fi
        ;;
        fmt)
        if [ $# -lt 1 ]; then usage; fi
                if [ "$1" = "--check" ]; then
            if [ $# -lt 2 ]; then usage; fi
            require_source "$(absolute_path "$2")"
            # 路线图 7b-3 fmt 再宿主：执行体 = backend_driver 的 fmt dispatch
            # （lispvm 跑 driver.bc，与旧链 tavm 跑 bootstrap.tabc 同参布局）。
            # lisp 路径不产出覆盖数据（同 run_lisp 的 driver 约定），
            # TA_COV_DUMP_DIR 不再传给宿主。
            ensure_lisp_driver || exit 1
            OUT=$("$LISPVM" -q "$LISP_DRIVER_BC" fmt --check "$(absolute_path "$2")")
            echo "$OUT"
            case "$OUT" in
                *"diff:"*) exit 1 ;;
            esac
                                                else
            require_source "$(absolute_path "$1")"
            ensure_lisp_driver || exit 1
            "$LISPVM" -q "$LISP_DRIVER_BC" fmt "$(absolute_path "$1")"
        fi
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage
        ;;
esac