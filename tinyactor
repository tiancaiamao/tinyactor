#!/bin/bash
#
# tinyactor — user-facing CLI for the TinyActor runtime.
# Orchestrates tavm + bootstrap.tabc for building and running TA code.
#
# The bootstrap.tabc uses backward compat mode: when invoked with a source
# .ta path and an output .tabc path, it compiles the source to bytecode.
# When invoked with just a source .ta path, it compiles and runs.

set -euo pipefail

CALLER_DIR="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Build dirs are removed at the end of build_ta; this trap catches the
# killed-mid-build case (timeout / Ctrl-C) so PID reuse cannot collide with
# a leftover dir on the next run.
TA_BUILD_DIR=""
cleanup_build_dir() {
    if [ -n "$TA_BUILD_DIR" ]; then
        rm -rf "$TA_BUILD_DIR"
        TA_BUILD_DIR=""
    fi
}
trap cleanup_build_dir EXIT

absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$CALLER_DIR" "$1" ;;
    esac
}

TAVM="${TAVM:-$SCRIPT_DIR/tavm}"
TAVM="$(absolute_path "$TAVM")"
BOOTSTRAP="${TA_BOOTSTRAP:-$SCRIPT_DIR/lib/bootstrap.tabc}"
if [ ! -x "$TAVM" ]; then
    echo "error: TinyActor runtime not found or not executable: $TAVM" >&2
    echo "build it with 'make tavm' or set TAVM=/path/to/tavm" >&2
    exit 1
fi
if [ ! -s "$BOOTSTRAP" ]; then
    echo "error: TinyActor bootstrap compiler not found: $BOOTSTRAP" >&2
    echo "build it with 'make bootstrap'" >&2
    exit 1
fi
# The http C module is loaded by tavm itself at startup (see tavm.c main),
# so no -L flag is needed. tavm picks the module matching its own build
# (plain / _asan / _tsan), and `import http` compiles because "http" is a
# registered builtin module name.

usage() {
    cat >&2 <<EOF
usage: tinyactor <command> [args...]

Commands:
    build [--verbose] [--no-cache] [--cov] <src>.ta [<out>.tabc]
                                Compile .ta to .tabc (default: <src>.tabc).
                                Module signatures cache in .build/modules/;
                                --verbose prints per-module hit/miss + timing,
                                --no-cache disables the signature cache.
                                --cov instruments fn entries with cov.hit(k)
                                and writes <out>.covmap (k -> fn name).
    run   [--vm=lisp] [--verbose] [--no-cache] <src>.ta [args...]
                                Compile and run (build to /tmp, then tavm).
                                --vm=lisp: compile via the lisp backend
                                (backend_driver, no TA typecheck) and run
                                lispvm. Default VM is tavm.
  fmt   <file>.ta               Format .ta in place (token-level, gofmt-style)
  fmt   --check <file>.ta       Check formatting; exits 1 if file differs
  help                          Show this help
EOF
            exit 1
}

# build_ta: compile src.ta to out.tabc with the bootstrap compiler.
# Typecheck errors abort the build without producing output; surface
# that as a non-zero exit (tavm itself always exits 0).
# The target is removed BEFORE compiling so a failed build can never leave
# a stale pre-existing artifact behind that passes the -s check below
# (that silently shipped an outdated bootstrap.tabc; A3).
require_source() {
    local src="$1"
    if [ ! -f "$src" ]; then
        echo "error: TinyActor source file not found: $src" >&2
        return 1
    fi
}

# cache_dir_arg <nocache_flag> — the signature cache dir passed to the
# compiler (last build arg). Empty string disables caching.
#   --no-cache or TINYACTOR_NO_CACHE=1  -> no cache
#   TA_SIG_CACHE_DIR=<dir>              -> explicit location
#   default                             -> <project>/.build/modules
cache_dir_arg() {
    if [ -n "${1:-}" ] || [ -n "${TINYACTOR_NO_CACHE:-}" ]; then
        printf ''
    elif [ -n "${TA_SIG_CACHE_DIR:-}" ]; then
        printf '%s\n' "$TA_SIG_CACHE_DIR"
    else
        printf '%s\n' "$CALLER_DIR/.build/modules"
    fi
}

# parse_build_flags: consume leading --verbose / --no-cache from the
# command args; sets VFLAG (compiler verbose flag, may be empty), NOCACHE=1
# when caching is disabled, and NFLAGS = number of flags consumed, so the
# caller can shift past them. (Globals, not echo: the assignments must
# survive the call.)
VFLAG=""
NOCACHE=""
COVFLAG=""
NFLAGS=0
parse_build_flags() {
    VFLAG=""
    NOCACHE=""
    COVFLAG=""
    NFLAGS=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose) VFLAG="--verbose" ;;
            --no-cache) NOCACHE=1 ;;
            --cov) COVFLAG="--cov" ;;
            *) break ;;
        esac
        NFLAGS=$((NFLAGS + 1))
        shift
    done
}

build_ta() {
    local src="$1" out="$2" vflag="${3:-}" cache_dir="${4:-}" covflag="${5:-}"
    require_source "$src"
    local build_dir="$SCRIPT_DIR/.tinyactor-build-$$"
    rm -f "$out"
    # -p: a leftover dir from a previously killed build (same PID reused)
    # must not abort the build with "File exists" (kernfuzz nightly 2026-09-04
    # produced 4 false findings this way). The trap below removes it on exit.
    mkdir -p "$build_dir/lib"
    TA_BUILD_DIR="$build_dir"
        for module in "$CALLER_DIR"/lib/* "$SCRIPT_DIR"/lib/*; do
        [ -e "$module" ] || continue
        local name="${module##*/}"
        # lib/bootstrap/ (compiler sources) is symlinked as a directory so
        # the driver's lib/ + lib/bootstrap/ fallbacks both resolve inside
        # the build dir.
        [ "$name" = "bootstrap" ] && continue
        [ -e "$build_dir/lib/$name" ] || ln -s "$module" "$build_dir/lib/$name"
    done
    for src_bs in "$CALLER_DIR"/lib/bootstrap "$SCRIPT_DIR"/lib/bootstrap; do
        [ -d "$src_bs" ] || continue
        [ -e "$build_dir/lib/bootstrap" ] || ln -s "$src_bs" "$build_dir/lib/bootstrap"
        break
    done
                local rc=0
    (
        cd "$build_dir"
        # last two args: signature cache dir ("" = whole-program
        # typecheck), then the --cov flag ("" = none)
        # $vflag/$covflag unquoted: empty expands to no arg, set expands to one
        if [ -n "${TA_COV_DUMP_DIR:-}" ]; then
            "$TAVM" "--cov-dump-dir=$TA_COV_DUMP_DIR" "$BOOTSTRAP" $vflag $covflag "$src" "$out" "$cache_dir"
        else
            "$TAVM" "$BOOTSTRAP" $vflag $covflag "$src" "$out" "$cache_dir"
        fi
    ) || rc=$?
    rm -f "$build_dir/lib"/*
    rmdir "$build_dir/lib" "$build_dir"
    TA_BUILD_DIR=""
    if [ "$rc" -ne 0 ]; then
        return "$rc"
    fi
    if [ ! -s "$out" ]; then
        echo "error: build failed - no output produced ($out)" >&2
        return 1
    fi
}

# run_lisp <src> [args...]: lisp 双轨运行路径。
# 编译半程 = tavm 跑 boot/backend_driver.tabc（lisp 管线：tokenize/parse/
# lower/compile -> .bc，无 TA typecheck），运行半程 = lispvm。
# 喂管线前必须 expand_imports.py 展开 import：lisp 管线是单命名空间，
# 不展开的话 lib 调用（bool.not…）运行期宿主 miss 返回 nil（同 corpus
# 的既有约定，见 run_corpus.sh）。
# 产物 .bc 与 tavm 路径的 .tabc 是两种格式。backend_driver.tabc 为
# gitignore 产物（非 checked-in）：缺失或比 driver 自身 .ta 旧时按需重建；
# import 的内核（compile.ta 等）变了需手动 `make boot-backend-driver`
# （同 driver-all.ta.bc 的约定）。
run_lisp() {
    local src="$1"; shift
    require_source "$src" || return 1
    local driver="$SCRIPT_DIR/vm-demo/lisp/boot/backend_driver.tabc"
    local driver_src="$SCRIPT_DIR/vm-demo/lisp/backend_driver.ta"
    local lispvm="$SCRIPT_DIR/lispvm"
    if [ ! -s "$driver" ] || [ "$driver" -ot "$driver_src" ]; then
        echo "boot-backend-driver: (re)building lisp backend driver" >&2
        build_ta "$driver_src" "$driver" "" "" "" || return 1
    fi
    if [ ! -x "$lispvm" ]; then
        echo "error: lispvm not found: $lispvm" >&2
        echo "build it with 'make lispvm'" >&2
        return 1
    fi
    # mktemp -d 一次建目录：直接 mktemp file 再拼 .bc 后缀会每次泄漏一个
    # 无后缀空文件；临时目录也顺手解决 exec 无法清理的问题——不再 exec，
    # 走正常 return（调用方 exit $?），rc 语义与 lispvm 一致（含 128+sig）。
    local tmpdir tmpbc tmpexp rc
    tmpdir=$(mktemp -d /tmp/tinyactor-lisp-XXXXXX) || return 1
    tmpbc="$tmpdir/run.bc"
    tmpexp="$tmpdir/run.ta"
        # stdout 的进度行按 corpus 惯例丢弃；失败走 stderr + rc
    if ! python3 "$SCRIPT_DIR/vm-demo/lisp/expand_imports.py" "$src" "$tmpexp" > /dev/null; then
        rm -rf "$tmpdir"
        return 1
    fi
    if ! "$TAVM" "$driver" "$tmpexp" "$tmpbc"; then
        rm -rf "$tmpdir"
        return 1
    fi
    # -q：只打程序输出（与 tavm 路径语义一致：main 返回值不打印）
    "$lispvm" -q "$tmpbc" "$@"
    rc=$?
    rm -rf "$tmpdir"
    return $rc
}

if [ $# -lt 1 ]; then usage; fi

CMD="$1"
shift

case "$CMD" in
            build)
        if [ $# -lt 1 ]; then usage; fi
        parse_build_flags "$@"
        shift "$NFLAGS"
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        OUT="$(absolute_path "${2:-${1%.*}.tabc}")"
                build_ta "$SRC" "$OUT" "$VFLAG" "$(cache_dir_arg "$NOCACHE")" "$COVFLAG"
        ;;
                        run)
        if [ $# -lt 1 ]; then usage; fi
        # --vm=lisp：编译半程走 lisp 后端（backend_driver），运行走 lispvm。
        # 默认 tavm 不变；gate 见 make lisp-gate。
        # flag 顺序自由：--vm 与 parse_build_flags 的 flag 交错均可，
        # 与 build 路径的「leading flags 任意顺序」语义一致。
        VM=tavm
        while [ $# -gt 0 ]; do
            case "$1" in
                --vm=lisp) VM=lisp ;;
                --vm=tavm) ;;
                --verbose|--no-cache|--cov) ;;
                *) break ;;
            esac
            shift
        done
        if [ $# -lt 1 ]; then usage; fi
        parse_build_flags "$@"
        shift "$NFLAGS"
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
                if [ "$VM" = "lisp" ]; then
            # lisp 路径独立终止：run_lisp 的 rc（含失败 1 / lispvm 128+sig）
            # 原样透传，不 fall through 到 tavm 路径
            run_lisp "$SRC" "$@"
            exit $?
        fi
        if [ -n "${TA_COV_MAP_DIR:-}" ]; then COVFLAG="--cov"; fi
        TMP=$(mktemp /tmp/tinyactor-XXXXXX)
        TMPTABC="$TMP.tabc"
        if ! build_ta "$SRC" "$TMPTABC" "$VFLAG" "$(cache_dir_arg "$NOCACHE")" "${COVFLAG:-}"; then
            rm -f "$TMPTABC"
            exit 1
        fi
        # Replace the wrapper so terminal signals reach tavm directly.
        if [ -n "${TA_COV_MAP_DIR:-}" ]; then
            map_name="$(basename "$TMPTABC").covmap"
            mkdir -p "$TA_COV_MAP_DIR/maps/$map_name" "$TA_COV_MAP_DIR/dumps/$map_name"
            cp "$TMPTABC.covmap" "$TA_COV_MAP_DIR/maps/$map_name/map.covmap"
            exec "$TAVM" "--cov-dump-dir=$TA_COV_MAP_DIR/dumps/$map_name" "$TMPTABC" "$@"
        else
            exec "$TAVM" "$TMPTABC" "$@"
        fi
        ;;
        fmt)
        if [ $# -lt 1 ]; then usage; fi
                if [ "$1" = "--check" ]; then
            if [ $# -lt 2 ]; then usage; fi
            require_source "$(absolute_path "$2")"
            if [ -n "${TA_COV_DUMP_DIR:-}" ]; then
                OUT=$("$TAVM" "--cov-dump-dir=$TA_COV_DUMP_DIR" "$BOOTSTRAP" fmt --check "$(absolute_path "$2")")
            else
                OUT=$("$TAVM" "$BOOTSTRAP" fmt --check "$(absolute_path "$2")")
            fi
            echo "$OUT"
            case "$OUT" in
                *"diff:"*) exit 1 ;;
            esac
                                                else
            require_source "$(absolute_path "$1")"
            if [ -n "${TA_COV_DUMP_DIR:-}" ]; then
                "$TAVM" "--cov-dump-dir=$TA_COV_DUMP_DIR" "$BOOTSTRAP" fmt "$(absolute_path "$1")"
            else
                "$TAVM" "$BOOTSTRAP" fmt "$(absolute_path "$1")"
            fi
        fi
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage
        ;;
esac