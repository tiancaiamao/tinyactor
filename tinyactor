#!/bin/bash
#
# tinyactor — user-facing CLI for the TinyActor runtime.
# Compile + run TA programs via the lisp pipeline: the compile half is
# tavm driving lib/bootstrap.tabc, the run half is tavm (7b-2 起
# 同宿主)；fmt 再宿主到 lib/bootstrap.tabc（7b-3）。

set -euo pipefail

CALLER_DIR="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$CALLER_DIR" "$1" ;;
    esac
}

usage() {
    cat >&2 <<EOF
usage: tinyactor <command> [args...]

Commands:
  run   <src> [args...]        Run <src>; <src> is .ta, .kl or .tabc
                               (extension dispatch; sig cache in
                               .build/modules). .tabc = a prebuilt image:
                               handed to tavm as-is, no compile
  build [--emit-kl] <src> [out]
                               Compile <src> to a bytecode image (default
                               <base>.tabc beside <src>). .ta runs the full
                               pipeline; .kl skips typecheck (the format
                               dropped type info; see docs/kl-format.md
                               §1.1)
  build --emit-kl <src.ta> [out.kl]
                               Emit the .kl text only (default <base>.kl
                               beside <src>); no bytecode image
  fmt   <file>.ta              Format .ta in place (token-level, gofmt-style)
  fmt   --check <file>.ta      Check formatting; exits 1 if file differs
  help                         Show this help

Module resolution is anchored at the directory you invoke tinyactor in
(no upward search — no walking up to a parent): imports look in ./vendor/
of that directory first, and bare names fall back to the installed stdlib.
Run tinyactor from your project root (issue #368).
EOF
            exit 1
}

require_source() {
    local src="$1"
    if [ ! -f "$src" ]; then
        echo "error: TinyActor source file not found: $src" >&2
        return 1
    fi
}

# require_tavm — tavm 可执行探测（ensure_tavm_driver 与 run_image 共享：
# 前者是编译半程的保障，后者只要宿主本身）。成功后全局 TAVM 可用。
require_tavm() {
    TAVM="$SCRIPT_DIR/tavm"
    if [ ! -x "$TAVM" ]; then
        echo "error: tavm not found: $TAVM" >&2
        echo "build it with 'make tavm'" >&2
        return 1
    fi
}

# ensure_tavm_driver — run_tavm 与 fmt 共享的编译半程保障（7b-3 抽出）：
# 检查 tavm 可执行、lib/bootstrap.tabc 缺失/比 .ta 旧时重建。成功后
# 全局 TAVM、TAVM_DRIVER_BC 为可用路径（调用方直接消费）。
# 种子 bootstrap.tabc 已入库（7c-1）：fresh clone 直接可用，缺失 = 工作区
# 被破坏（报错提示 git checkout 恢复）；比 driver 自身 .ta 旧时用现有 .tabc
# 自重建（tavm 编自己，自举固定点 byte-identical 已实测）；import 的内核
# （compile.ta 等）变了需手动 `make bootstrap`。
ensure_tavm_driver() {
    TAVM_DRIVER_BC="$SCRIPT_DIR/lib/bootstrap.tabc"
    local driver_src="$SCRIPT_DIR/lib/bootstrap/driver.ta"
    require_tavm || return 1
    if [ ! -s "$TAVM_DRIVER_BC" ]; then
        echo "error: 编译半程种子缺失: $TAVM_DRIVER_BC（入库产物）" >&2
        echo "restore it: git checkout -- lib/bootstrap.tabc" >&2
        return 1
    fi
    if [ "$TAVM_DRIVER_BC" -ot "$driver_src" ]; then
        echo "ensure_tavm_driver: (re)building driver seed" >&2
        # 先建临时文件再原子 mv：`make -j8 test` 时多个测试脚本会同时发现
        # driver 过期，直接写目标路径可能让并发读者拿到半个文件。
        local tmpdrv
        tmpdrv=$(mktemp "$SCRIPT_DIR/lib/.bootstrap.XXXXXX") || return 1
        # 自重建（路线图 7b-2 自举）：现有 .tabc 编自己——同源码同输出
        # byte-identical；改过源码时产出新源码的编译物（旧编译器编新源码
        # 是 bootstrap 常规）。
        # driver 镜像宿主在安装树里跑（link 期 dlopen lib/ 相对 CWD，同
        # build_tavm 约定；参数已是绝对路径，换 CWD 无副作用），并显式丢掉
        # TA_PROJECT_ROOT：编 driver 自己是**安装树内**的构建，调用方项目根
        # 不参与——否则用户 shell 里导出的 TA_PROJECT_ROOT 会把它自己的
        # bootstrap/* 指到消费项目去，自重建必失败。
        (cd "$SCRIPT_DIR" && env -u TA_PROJECT_ROOT "$TAVM" -q "$TAVM_DRIVER_BC" "$driver_src" "$tmpdrv" "") || {
            rm -f "$tmpdrv"
            return 1
        }
        mv -f "$tmpdrv" "$TAVM_DRIVER_BC"
    fi
}

# build_tavm <src> <out> [emit_kl]: 编译半程独立出口（build 子命令；run_tavm
# 也走这里保证两条路径同一实现）。模块解析基准 = **调用方项目根**
# （TA_PROJECT_ROOT=$CALLER_DIR，driver.ta 的 vendor_roots）：vendor/ 是项目
# 的树，消费项目自带的 vendor 才被看见（issue #368），没 vendor 的裸名由
# driver 回退到 cwd 相对的 vendor/ = 安装树。cwd 仍是 $SCRIPT_DIR —— 编译期
# dlopen("lib/<mod>.dylib") 是 cwd 相对的，换 CWD 会让编译器自己的 stdlib
# dylib 不可达；运行半程的 cwd 留在调用方（程序自己的 dylib 语义不变）。
# emit_kl 非空时多写一份 .kl 文本（不参与编译，<out> 逐字节不变）。
# env -u TA_ACTOR_HEAP：程序级 arena knob 只约束运行半程；编译宿主（driver）
# 跑在默认 heap 下，与旧链 build 同语义。
build_tavm() {
    local src="$1" out="$2" emit_kl="${3:-}"
    require_source "$src" || return 1
    ensure_tavm_driver || return 1
    # typecheck sig cache：项目级目录跨调用共享（lib 模块签名只算一次），
    # TA_SIG_CACHE_DIR 可覆盖。没有它每次编译都全量 typecheck 全部依赖。
    local CACHE_DIR="${TA_SIG_CACHE_DIR:-$SCRIPT_DIR/.build/modules}"
    if [ -n "$emit_kl" ]; then
        # --emit-kl 必须排在 <src> **之前**：driver 按 argv[0] dispatch，源码
        # 路径顶到 argv[0] 就落进 .ta 路、flag 被当文件名（docs/kl-format.md
        # 「已知怪癖」）。用户面 flag 统一前置（本脚本 case 分发），这里按
        # driver 约定原样传递。
        (cd "$SCRIPT_DIR" && env -u TA_ACTOR_HEAP TA_PROJECT_ROOT="$CALLER_DIR" "$TAVM" -q "$TAVM_DRIVER_BC" \
            --emit-kl "$emit_kl" "$src" "$out" "$CACHE_DIR")
    else
        (cd "$SCRIPT_DIR" && env -u TA_ACTOR_HEAP TA_PROJECT_ROOT="$CALLER_DIR" "$TAVM" -q "$TAVM_DRIVER_BC" "$src" "$out" "$CACHE_DIR")
    fi
}

# build_from_kl <kl> <out>：.kl 路编译（不读源码、不跑 typecheck —— lower 丢
# 掉 type/type-sig/const，见 docs/kl-format.md §1.1）。driver 的 --from-kl
# 分支没有 <src> 位置参数，故 flag 只能在最前。
build_from_kl() {
    local kl="$1" out="$2"
    if [ ! -f "$kl" ]; then
        echo "error: .kl file not found: $kl" >&2
        return 1
    fi
    ensure_tavm_driver || return 1
    (cd "$SCRIPT_DIR" && env -u TA_ACTOR_HEAP "$TAVM" -q "$TAVM_DRIVER_BC" --from-kl "$kl" "$out")
}

# emit_kl_only <src.ta> <out.kl>：只写 .kl 文本（gcc -S 语义），不出字节码。
# driver 的 --emit-kl 形态是"编译 + 附赠 .kl"，字节码落到临时文件后删掉。
emit_kl_only() {
    local src="$1" kl="$2" tmpbc rc=0
    require_source "$src" || return 1
    ensure_tavm_driver || return 1
    tmpbc=$(mktemp /tmp/tinyactor-kl-XXXXXX) || return 1
    build_tavm "$src" "$tmpbc" "$kl" || rc=$?
    rm -f "$tmpbc"
    return "$rc"
}

# run_tavm <src> [args...]: lisp 双轨运行路径。
# 编译半程 = tavm 跑 lib/bootstrap.tabc（driver.typecheck_cached 模块
# 级签名缓存在 .build/modules，miss 才全量 typecheck；再走 lisp 管线
# tokenize/parse/lower/compile -> .tabc），运行半程 = 同一二进制（7b-2 起
# 同宿主；backend-gate 静态门看守编译半程必须走种子宿主）。
# import 由 driver resolve_imports 命名空间化解析（issue #256），源文件直接
# 喂即可；run_corpus.sh 仍用 expand_imports.py 展开，是 corpus 测试的既有
# 约定，与本函数无关。
run_tavm() {
    local src="$1"; shift
    require_source "$src" || return 1
    # mktemp -d 一次建目录：直接 mktemp file 再拼 .tabc 后缀会每次泄漏一个
    # 无后缀空文件；临时目录也顺手解决 exec 无法清理的问题——不再 exec，
    # 走正常 return（调用方 exit $?），rc 语义与 tavm 一致（含 128+sig）。
    local tmpdir tmpbc rc
    tmpdir=$(mktemp -d /tmp/tinyactor-tavm-XXXXXX) || return 1
    tmpbc="$tmpdir/run.tabc"
    local abs_src
    abs_src=$(absolute_path "$src")
    if ! build_tavm "$abs_src" "$tmpbc"; then
        rm -rf "$tmpdir"
        return 1
    fi
        # -q：只打程序输出（与 tavm 路径语义一致：main 返回值不打印）
    # `|| rc=$?` 而非裸跑再取 $?：set -e 下子进程被信号杀（如测试脚本
    # cleanup 的 TERM）会让外壳直接退出，跳过 rm -rf —— 每次异常终止
    # 泄漏一个 /tmp/tinyactor-tavm-XXX 目录。
    rc=0
    "$TAVM" -q "$tmpbc" "$@" || rc=$?
    rm -rf "$tmpdir"
    return $rc
}

# run_kl <kl> [args...]: .kl 路运行 = build_from_kl 到临时 .tabc 再 tavm。
# rc 语义与 run_tavm 一致（含 128+sig）。
run_kl() {
    local kl="$1"; shift
    local tmpdir tmpbc rc
    tmpdir=$(mktemp -d /tmp/tinyactor-tavm-XXXXXX) || return 1
    tmpbc="$tmpdir/run.tabc"
    if ! build_from_kl "$kl" "$tmpbc"; then
        rm -rf "$tmpdir"
        return 1
    fi
    rc=0
    "$TAVM" -q "$tmpbc" "$@" || rc=$?
    rm -rf "$tmpdir"
    return $rc
}

# require_image <img.tabc>：镜像存在性检查（.tabc 直跑路）。这里只判存在；
# 空/截断/版本不符由 tavm 装载时报错，rc 照样透传。两条都**不**回落去编译
# 同名源文件：回落会把"跑镜像"静默变成"编源跑"，恰是本路要避免的。
require_image() {
    local img="$1"
    if [ ! -f "$img" ]; then
        echo "error: bytecode image not found: $img" >&2
        return 1
    fi
}

# run_image <img.tabc> [args...]: .tabc 直跑路 = 等价 `tavm -q <img> args…`，
# **不编译** —— 不碰 driver 种子、不读源码、不写 .build/modules 签名缓存。
# 故不用 ensure_tavm_driver（那是编译半程的保障，driver 陈旧会触发自重建），
# 只要宿主可执行（require_tavm）。exec 而非子进程：无临时文件可清理，
# tavm 的 rc（含 128+sig）原样成为 CLI 的 rc。
run_image() {
    local img="$1"; shift
    require_image "$img" || return 1
    require_tavm || return 1
    exec "$TAVM" -q "$img" "$@"
}

# src_kind <path>: 按扩展名分发 .ta / .kl / .tabc，其余报错并 exit 1。
src_kind() {
    case "$1" in
        *.ta) printf 'ta' ;;
        *.kl) printf 'kl' ;;
        *.tabc) printf 'tabc' ;;
        *)
            echo "error: unsupported source extension (expected .ta, .kl or .tabc): $1" >&2
            exit 1
            ;;
    esac
}

if [ $# -lt 1 ]; then usage; fi

CMD="$1"
shift

case "$CMD" in
                        run)
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
                # run_tavm / run_kl / run_image 的 rc（含失败 1 / tavm 128+sig）原样透传
        KIND="$(src_kind "$SRC")"
        case "$KIND" in
            ta) run_tavm "$SRC" "$@" ;;
            kl) run_kl "$SRC" "$@" ;;
            tabc) run_image "$SRC" "$@" ;;
        esac
        exit $?
        ;;
        build)
        # flag 统一前置：--emit-kl 之后是 <src> [out]。out 省略时按扩展名
        # 取默认：.ta/.kl → 旁边 <base>.tabc；--emit-kl → 旁边 <base>.kl。
        EMIT_KL=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --emit-kl) EMIT_KL=1 ;;
                *) break ;;
            esac
            shift
        done
        if [ $# -lt 1 ] || [ "${1#-}" != "$1" ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
        KIND="$(src_kind "$SRC")"
        if [ "$EMIT_KL" = 1 ]; then
            if [ "$KIND" != ta ]; then
                echo "error: --emit-kl takes a .ta source, got: $SRC" >&2
                exit 1
            fi
            if [ $# -gt 1 ]; then usage; fi
            if [ $# -eq 1 ]; then
                emit_kl_only "$SRC" "$(absolute_path "$1")"
            else
                emit_kl_only "$SRC" "${SRC%.ta}.kl"
            fi
            exit $?
        fi
        if [ $# -gt 1 ]; then usage; fi
        if [ $# -eq 1 ]; then
            OUT="$(absolute_path "$1")"
        else
            OUT="${SRC%.*}.tabc"
        fi
        case "$KIND" in
            ta) require_source "$SRC" && build_tavm "$SRC" "$OUT" ;;
            kl) build_from_kl "$SRC" "$OUT" ;;
            # .tabc 是 build 的产物、不是它的输入：镜像已经在那儿了，
            # 认了扩展名却不报错会让这条命令静默成功（什么都不做）。
            tabc)
                echo "error: build takes a .ta or .kl source, got: $SRC" >&2
                exit 1
                ;;
        esac
        exit $?
        ;;
        fmt)
        if [ $# -lt 1 ]; then usage; fi
                if [ "$1" = "--check" ]; then
            if [ $# -lt 2 ]; then usage; fi
            require_source "$(absolute_path "$2")"
            # fmt 再宿主（7b-3）：执行体 = driver 的 fmt 分发（tavm -q 种子，
            # 与 run/build 同参布局）。
            # lisp 路径不产出覆盖数据（同 run_tavm 的 driver 约定），
            # TA_COV_DUMP_DIR 不再传给宿主。
            ensure_tavm_driver || exit 1
            OUT=$(cd "$SCRIPT_DIR" && "$TAVM" -q "$TAVM_DRIVER_BC" fmt --check "$(absolute_path "$2")")
            echo "$OUT"
            case "$OUT" in
                *"diff:"*) exit 1 ;;
            esac
                                                else
            require_source "$(absolute_path "$1")"
            ensure_tavm_driver || exit 1
            (cd "$SCRIPT_DIR" && "$TAVM" -q "$TAVM_DRIVER_BC" fmt "$(absolute_path "$1")")
        fi
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage
        ;;
esac