#!/bin/bash
#
# tinyactor — user-facing CLI for the TinyActor runtime.
# Compile + run TA programs via the lisp pipeline: the compile half is
# tavm driving lib/bootstrap.tabc, the run half is tavm (7b-2 起
# 同宿主)；fmt 再宿主到 lib/bootstrap.tabc（7b-3）。

set -euo pipefail

CALLER_DIR="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# 本安装树的树名：一个项目 `tinyactor init` 时用它建 vendor/<树名> -> 安装根。
# 必须与 driver.ta 的 SELF_IDENTITY 逐字一致（改名 = 改身份：两处 + 全语料）。
SELF_TREE="tinyactor"

absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$CALLER_DIR" "$1" ;;
    esac
}

usage() {
    # 引号固定 heredoc：正文里有反引号（`tinyactor init`）和 $PWD 字面量，
    # 不加引号会让 bash 把反引号当命令替换去执行（曾经静默跑错命令）。
    cat >&2 <<'EOF'
usage: tinyactor <command> [args...]

Commands:
  run   <src> [args...]        Run <src>; <src> is .ta, .kl or .tabc
                               (extension dispatch; sig cache in
                               .build/modules). .tabc = a prebuilt image:
                               handed to tavm as-is, no compile
  build [--emit-kl] <src> [out]
                               Compile <src> to a bytecode image (default
                               <base>.tabc beside <src>). .ta runs the full
                               pipeline; .kl skips typecheck (the format
                               dropped type info; see docs/kl-format.md
                               §1.1)
  build --emit-kl <src.ta> [out.kl]
                               Emit the .kl text only (default <base>.kl
                               beside <src>); no bytecode image
  build --cov <src.ta> [out.tabc]
                               Compile with coverage instrumentation:
                               every function entry and statement gets a
                               counter, and <out>.covmap maps counter ids
                               to file:line (docs/coverage-design.md).
                               Counters are dumped at exit when
                               TA_COV_DUMP_DIR is set
  fmt   <file>.ta              Format .ta in place (token-level, gofmt-style)
  fmt   --check <file>.ta      Check formatting; exits 1 if file differs
  vendor                       Generate ./vendor/ from ./tinyactor.deps
                               (one line per tree: <tree> <source> [ref];
                               source is a local directory, `.` for the
                               project itself, or `git+<url>` for a clone;
                               a bare `host/path` line means
                               `git+https://host/path`). vendor/ is
                               generated, never committed
  init                         Scaffold ./tinyactor.deps with this
                               installation as a tree (then run `vendor`)
  help                         Show this help

Module resolution: an import name is written "<tree>:<path>" and resolves
to exactly one file, <root>/vendor/<tree>/<path>.ta, where <root> is the
first ancestor directory of the entry source that contains a vendor/
directory. One root per build, one candidate per name: no bare names, no
relative paths, no search, no stdlib fallback. Computed from the entry
file, never from $PWD. Run `tinyactor init` once in a new project (it writes
tinyactor.deps); `tinyactor vendor` re-materialises ./vendor/ from that file.
EOF
            exit 1
}

require_source() {
    local src="$1"
    if [ ! -f "$src" ]; then
        echo "error: TinyActor source file not found: $src" >&2
        return 1
    fi
}

# ============================================================
# 依赖描述文件 tinyactor.deps → 生成 vendor/
# ============================================================
#
# 两件事分得很开（docs/modules.md §4）：**解析**不读任何文件，`import
# "<树名>:<路径>"` 机械拼成 `<根>/vendor/<树名>/<路径>.ta`；**生成**读
# `tinyactor.deps`，把「vendor/ 里该有哪几棵树、各自从哪来」落成链接。
# vendor/ 因此是生成物，不入 git；入 git 的只有这份描述文件。

# under <路径> <祖先> — $1 是不是 $2/... （纯字符串判断，不碰文件系统）
under() {
    case "$1" in
        "$2"/*) return 0 ;;
    esac
    return 1
}

# deps_root — 打印 `tinyactor.deps` 所在的目录，它就是这个项目的根。
# 根标记刻意选 deps 文件而**不是** vendor/：`tinyactor vendor` 的活儿正是把
# vendor/ 造出来，拿它当标记是先有鸡先有蛋。
deps_root() {
    local d="$PWD"
    while :; do
        if [ -f "$d/tinyactor.deps" ]; then
            printf '%s\n' "$d"
            return 0
        fi
        [ "$d" = "/" ] && return 1
        d="$(dirname "$d")"
    done
}

# relpath <起点目录> <目标> — 尽量给相对路径：项目整体搬移后链接仍然有效。
# 没有 python3 时退回绝对路径（链接照样能用，只是搬移后失效）。
relpath() {
    if command -v python3 >/dev/null 2>&1; then
        ( cd "$1" && python3 -c 'import os,sys; print(os.path.relpath(os.path.realpath(sys.argv[1]), os.path.realpath(".")))' "$2" )
    else
        printf '%s\n' "$2"
    fi
}

# link_tree <项目根> <树名> <目标目录> — 建 <根>/vendor/<树名> -> 目标的链接。
# 已指对就**什么都不做**：`ln -sfn` 会改目录 mtime，而下游项目的增量判定把
# vendor/** 的目录条目当输入（无谓重链 = 每次 make 都重编）。变化时打一行，
# 没变化时一个字都不打，调用方据此区分。
link_tree() {
    local root="$1" tree="$2" target="$3"
    local link="$root/vendor/$tree" want
    # 先建好父目录：relpath 要在链接的父目录里算（相对路径从那里起算）。
    mkdir -p "$(dirname "$link")" || return 1
    want="$(relpath "$(dirname "$link")" "$target")" || return 1
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$want" ]; then
        return 0
    fi
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "error: $link 已存在且不是符号链接（不覆盖真实目录/文件）" >&2
        return 1
    fi
    ln -sfn "$want" "$link" || return 1
    printf '  vendor/%s -> %s\n' "$tree" "$want"
}

# 远端 clone 的标记文件：clone 出来的目录里有它，prune 才认「这棵是我造的」。
# 里面三行 = url / ref / commit，幂等判定只看前两行（同 url 同 ref 就复用，连
# git 都不跑 —— `tinyactor vendor` 在已就绪的项目里不联网）。
CLONE_MARK=".tinyactor-clone"

# prune_empty_parents <项目根> <被删掉的相对路径> — 删掉一条链接/一棵 clone 后，
# 把**因此**空掉的上级目录逐层收掉，收到 vendor/ 为止。
# 只收自己造的孤儿壳，不做全局清扫：clone 出来的树内部有 `.git` 的一堆空目录
# （`refs/heads`、`objects/info`…），全局 `find -type d -empty -delete` 会把它们
# 一并吞掉 —— 那不是本工具的盘。
prune_empty_parents() {
    local root="$1" d
    d="$(dirname "$root/vendor/$2")"
    while [ "$d" != "$root/vendor" ] && under "$d" "$root/vendor"; do
        rmdir "$d" 2>/dev/null || return 0
        printf '  - vendor/%s（空了）\n' "${d#"$root/vendor/"}"
        pruned_dirs=$((pruned_dirs + 1))
        d="$(dirname "$d")"
    done
}

# clone_tree <项目根> <树名> <url> <ref> — 把远端取成 <根>/vendor/<树名> 的真实
# 目录。先在 vendor/ 里的临时目录取好再整体换上去：取不到（断网、ref 不存在）
# 时旧的那棵原样留着，跟「描述文件写错 = vendor/ 一个字节都不动」同一个态度。
clone_tree() {
    local root="$1" tree="$2" url="$3" ref="$4"
    local dir="$root/vendor/$tree" tmp commit
    if [ -f "$dir/$CLONE_MARK" ] && [ -d "$dir/.git" ] \
        && [ "$(sed -n '1p' "$dir/$CLONE_MARK")" = "$url" ] \
        && [ "$(sed -n '2p' "$dir/$CLONE_MARK")" = "$ref" ]; then
        return 0
    fi
    # sha 当 ref 要完整 clone 再 checkout，v1 不做：说清楚比让 git 报一句
    # 「Remote branch ... not found」强。
    if [ "${#ref}" -eq 40 ]; then
        case "$ref" in
            *[!0-9a-f]*) ;;
            *) echo "error: $tree: v1 只支持分支/tag 当版本，还认不了 commit sha '$ref'" >&2; return 1 ;;
        esac
    fi
    mkdir -p "$(dirname "$dir")" || return 1
    tmp="$(mktemp -d "$root/vendor/.tinyactor-tmp.XXXXXX")" || return 1
    if [ -n "$ref" ]; then
        git clone --quiet --depth 1 --single-branch --branch "$ref" "$url" "$tmp/repo" || {
            rm -rf "$tmp"
            echo "error: $tree: 取不到 ${url}（ref '${ref}'）" >&2
            return 1
        }
    else
        git clone --quiet --depth 1 --single-branch "$url" "$tmp/repo" || {
            rm -rf "$tmp"
            echo "error: $tree: 取不到 ${url}" >&2
            return 1
        }
    fi
    commit="$(git -C "$tmp/repo" rev-parse HEAD)" || { rm -rf "$tmp"; return 1; }
    printf '%s\n%s\n%s\n' "$url" "$ref" "$commit" > "$tmp/repo/$CLONE_MARK" || { rm -rf "$tmp"; return 1; }
    if [ -L "$dir" ]; then
        rm -f "$dir" || { rm -rf "$tmp"; return 1; }
    elif [ -e "$dir" ]; then
        if [ -f "$dir/$CLONE_MARK" ]; then
            rm -rf "$dir" || { rm -rf "$tmp"; return 1; }
        else
            echo "error: $dir 已存在且不是本工具 clone 的（不覆盖真实目录）" >&2
            rm -rf "$tmp"
            return 1
        fi
    fi
    mv "$tmp/repo" "$dir" || { rm -rf "$tmp"; return 1; }
    rmdir "$tmp" 2>/dev/null || true
    printf '  vendor/%s <- %s%s（%s）\n' "$tree" "$url" "${ref:+ @$ref}" "${commit%"${commit#???????}"}"
}

# deps_entries <项目根> — 校验 tinyactor.deps，把每棵树规范化成
# `<树名>\t<dir|git>\t<目录|url>\t<ref>` 打出来。写错就报错返回非零、一行都不打：调用方据此做到
# 「描述文件写错 = vendor/ 一个字节都不动」，不留半套。
deps_entries() {
    local root="$1" deps="$1/tinyactor.deps" line tree src extra target ref="" seen="" prev
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"                        # CRLF 容忍
        case "$line" in ''|'#'*) continue ;; esac   # 整行注释
        line="$(printf '%s' "$line" | sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue                  # 只有尾注释的行
        read -r tree src extra <<<"$line"
        ref=""
        # 树名必须已经规范化：它就是 vendor/ 下的目录名，而 prune 拿**原文**和
        # 盘上路径比对（`./mylib` 建出来落在 `vendor/mylib`，比对必然失配，
        # 于是自己刚建的链接被当旧链接删掉）。
        case "$tree" in
            ''|.|..|/*|*/|*//*|./*|*/.|*/./*|*..*)
                echo "error: $deps: 非法树名 '$tree'" >&2
                return 1
                ;;
        esac
        case " $seen " in
            *" $tree "*)
                echo "error: $deps: 树名重复 '$tree'" >&2
                return 1
                ;;
        esac
        # 每棵树在 vendor/ 下就是**一条**链接，所以 `a` 和 `a/b` 不能并存：盘上
        # 落不下（`a` 是链接还是目录？）。放任的话 `mkdir -p` 会顺着 `a` 那条
        # 链接走进来源仓库，在别人的仓库里建链接。
        for prev in $seen; do
            under "$tree" "$prev" || under "$prev" "$tree" || continue
            echo "error: $deps: 树名 '$tree' 与 '$prev' 互为前缀 —— vendor/ 下每棵树是一条链接，不能套在一起" >&2
            return 1
        done
        seen="$seen $tree"
        # 来源三种形态，落成 vendor/ 下的两种东西：
        #   本地目录 / `.`      → 软链（联调：改源码立刻生效）
        #   `git+<url>` / 单列  → clone 成真实目录（取一份副本，钉在某个 ref 上）
        # 单列是糖：树名本身就是仓库路径（`github.com/x/y` → `git+https://...`）。
        if [ -z "${src:-}" ]; then
            case "$tree" in
                *.*/*) ;;
                *)
                    echo "error: $deps: 一行只有在树名形如 host/path 时才表示远端（'$tree'）" >&2
                    return 1
                    ;;
            esac
            src="git+https://$tree"
        fi
        if [ -n "${extra:-}" ]; then
            if [ "${#extra}" -eq 40 ]; then
                case "$extra" in
                    *[!0-9a-f]*) ;;
                    *) echo "error: $deps: '$tree': v1 只支持分支/tag 当版本，还认不了 commit sha '$extra'" >&2; return 1 ;;
                esac
            fi
            case "$extra" in
                *[[:space:]]*) echo "error: $deps: '$tree' 的版本 '$extra' 里不能有空白" >&2; return 1 ;;
            esac
        fi
        case "$src" in
            git+*)
                [ -z "${extra:-}" ] || ref="$extra"
                printf '%s\tgit\t%s\t%s\n' "$tree" "${src#git+}" "${ref:-}"
                continue
                ;;
        esac
        if [ -n "${extra:-}" ]; then
            echo "error: $deps: '$tree' 的来源是本机目录，不能带版本 '$extra'（版本只对 git+ 远端有意义）" >&2
            return 1
        fi
        case "$src" in
            .) target="$root" ;;
            /*) target="$src" ;;
            *) target="$root/$src" ;;
        esac
        if [ ! -d "$target" ]; then
            echo "error: $deps: '$tree' 的来源不是目录：$src" >&2
            return 1
        fi
        printf '%s\tdir\t%s\t\n' "$tree" "$target"
    done < "$deps"
}

# cmd_vendor — 读 tinyactor.deps，一行一棵树：`<树名> <来源> [版本]`。
# 来源 = 本地目录（联调：软链，改源码立刻生效）、`.` 表示项目自己（项目自己的
# 模块要能被自己 import 就得有这一行：`myproj  .`）、或 `git+<url>` 远端（clone
# 成真实目录）。整行只有树名时，树名本身就是仓库路径（`github.com/x/y`），
# 等价于 `git+https://github.com/x/y`。第三列是分支/tag，只对 git+ 有意义。
#
# vendor/ 是生成物，所以工具全权拥有它：除了「造缺的」还要「清多的」，删掉一行
# 之后旧链接若还留着，`import` 会继续命中一个你已经不要的库。清理只动本工具
# 造的两种形态 —— 软链、带 `.tinyactor-clone` 标记的 clone 目录 —— 和清空后的
# 目录；真实文件/目录是别人塞进来的，不删。
cmd_vendor() {
    local root entries tree kind target ref stray rel n=0 changed=0 pruned=0
    pruned_dirs=0
    local expect="" out=""
    if ! root="$(deps_root)"; then
        echo "error: no tinyactor.deps above $PWD" >&2
        echo "  在项目根写一份，一行一棵树：" >&2
        printf '    myproj\t.\n    %s\t%s\n' "$SELF_TREE" "$SCRIPT_DIR" >&2
        echo '  （`tinyactor init` 会替你把工具链那一行写上）' >&2
        return 1
    fi
    entries="$(deps_entries "$root")" || return 1
    # $expect = 期望的 `<路径>|<形态>` 集合（树名就是 vendor/ 下的相对路径）。
    # 带形态是因为同一棵树换来源（软链 ↔ clone）也得重建：光比路径会留下
    # 上一版的形态，链接和 clone 目录混在一个位置。
    while IFS=$'\t' read -r tree kind target ref; do
        [ -n "$tree" ] || continue
        expect="$expect $tree|$kind"
    done <<EOF
$entries
EOF
    # 先清后建：先让 vendor/ 只剩「描述文件里有的」，再按描述文件造链接。次序
    # 不能反 —— 新树名若是某个旧链接的子路径（`a` 改成 `a/b`），先建会让
    # `mkdir -p` 顺着旧软链走进来源仓库（在别人的仓库里留链接），反向改名则被
    # 旧目录挡住报「已存在」。先清掉就没有这两条路。
    if [ -d "$root/vendor" ]; then
        while IFS= read -r stray; do
            [ -n "$stray" ] || continue
            rel="${stray#"$root/vendor/"}"
            case " $expect " in
                *" $rel|dir "*) continue ;;
            esac
            rm -f "$stray" || return 1
            printf '  - vendor/%s（描述文件里没有这棵树了）\n' "$rel"
            pruned=$((pruned + 1))
            prune_empty_parents "$root" "$rel"
        done <<EOF
$(find "$root/vendor" -mindepth 1 -type l 2>/dev/null)
EOF
        # clone 出来的目录：只有带标记的才认（没标记 = 别人塞进来的真实目录，
        # 不碰）。`find` 不下钻软链，所以上面那趟删掉的链接里即便套着标记也
        # 到不了这里。
        while IFS= read -r stray; do
            [ -n "$stray" ] || continue
            rel="${stray#"$root/vendor/"}"
            rel="${rel%/$CLONE_MARK}"
            [ -n "$rel" ] || continue
            case " $expect " in
                *" $rel|git "*) continue ;;
            esac
            rm -rf "${stray%/$CLONE_MARK}" || return 1
            printf '  - vendor/%s（描述文件里没有这棵树了）\n' "$rel"
            pruned=$((pruned + 1))
            prune_empty_parents "$root" "$rel"
        done <<EOF
$(find "$root/vendor" -mindepth 2 -name "$CLONE_MARK" -type f 2>/dev/null)
EOF
    fi
    while IFS=$'\t' read -r tree kind target ref; do
        [ -n "$tree" ] || continue
        if [ "$kind" = git ]; then
            out="$(clone_tree "$root" "$tree" "$target" "$ref")" || return 1
        else
            out="$(link_tree "$root" "$tree" "$target")" || return 1
        fi
        if [ -n "$out" ]; then
            printf '%s\n' "$out"
            changed=$((changed + 1))
        fi
        n=$((n + 1))
    done <<EOF
$entries
EOF
    if [ "$changed" -eq 0 ] && [ "$pruned" -eq 0 ] && [ "$pruned_dirs" -eq 0 ]; then
        echo "ok: vendor/ 已是最新（$n 棵树，未改动）"
    else
        printf 'vendor: %d 棵树（新建/改指 %d，删旧链接 %d，删空目录 %d）\n' \
            "$n" "$changed" "$pruned" "$pruned_dirs"
    fi
}

# cmd_init：给当前目录写一份 tinyactor.deps（没有则新建、有则补工具链那一行）
# 并生成 vendor/。只补工具链那一行 —— 项目自己的树名工具链猜不出来
# （arch/OS 恒定的发行树名是能猜的，`myproj  .` 这行得作者自己写）。
cmd_init() {
    local deps="$CALLER_DIR/tinyactor.deps" target
    target="$(relpath "$CALLER_DIR" "$SCRIPT_DIR")" || return 1
    if [ ! -f "$deps" ]; then
        {
            printf '# tinyactor 依赖：一行一棵树，<树名> <来源>。\n'
            printf '# 来源 = 本地目录，或 . 表示项目自己。vendor/ 是生成物，不入 git。\n'
            printf '%s\t%s\n' "$SELF_TREE" "$target"
        } > "$deps" || return 1
        echo "created tinyactor.deps"
    elif ! grep -qE "^[[:space:]]*${SELF_TREE}[[:space:]]" "$deps"; then
        printf '%s\t%s\n' "$SELF_TREE" "$target" >> "$deps" || return 1
        echo "appended tinyactor.deps: $SELF_TREE"
    fi
    cmd_vendor
}


# require_tavm — tavm 可执行探测（ensure_tavm_driver 与 run_image 共享：
# 前者是编译半程的保障，后者只要宿主本身）。成功后全局 TAVM 可用。
require_tavm() {
    TAVM="$SCRIPT_DIR/tavm"
    if [ ! -x "$TAVM" ]; then
        echo "error: tavm not found: $TAVM" >&2
        echo "build it with 'make tavm'" >&2
        return 1
    fi
}

# ensure_tavm_driver — run_tavm 与 fmt 共享的编译半程保障（7b-3 抽出）：
# 检查 tavm 可执行、lib/bootstrap.tabc 缺失/比 .ta 旧时重建。成功后
# 全局 TAVM、TAVM_DRIVER_BC 为可用路径（调用方直接消费）。
# 种子 bootstrap.tabc 已入库（7c-1）：fresh clone 直接可用，缺失 = 工作区
# 被破坏（报错提示 git checkout 恢复）；比 driver 自身 .ta 旧时用现有 .tabc
# 自重建（tavm 编自己，自举固定点 byte-identical 已实测）；import 的内核
# （compile.ta 等）变了需手动 `make bootstrap`。
ensure_tavm_driver() {
    require_tavm || return 1
    # TA_DRIVER_BC：显式指定编译半程镜像（make coverage-ta 用它跑插桩版
    # driver）。自定义镜像的新鲜度由调用方负责，不做自重建。
    if [ -n "${TA_DRIVER_BC:-}" ]; then
        TAVM_DRIVER_BC="$TA_DRIVER_BC"
        if [ ! -s "$TAVM_DRIVER_BC" ]; then
            echo "error: TA_DRIVER_BC 指向的镜像不存在: $TAVM_DRIVER_BC" >&2
            return 1
        fi
        return 0
    fi
    TAVM_DRIVER_BC="$SCRIPT_DIR/lib/bootstrap.tabc"
    local driver_src="$SCRIPT_DIR/lib/bootstrap/driver.ta"
    if [ ! -s "$TAVM_DRIVER_BC" ]; then
        echo "error: 编译半程种子缺失: $TAVM_DRIVER_BC（入库产物）" >&2
        echo "restore it: git checkout -- lib/bootstrap.tabc" >&2
        return 1
    fi
    if [ "$TAVM_DRIVER_BC" -ot "$driver_src" ]; then
        echo "ensure_tavm_driver: (re)building driver seed" >&2
        # 先建临时文件再原子 mv：`make -j8 test` 时多个测试脚本会同时发现
        # driver 过期，直接写目标路径可能让并发读者拿到半个文件。
        local tmpdrv
        tmpdrv=$(mktemp "$SCRIPT_DIR/lib/.bootstrap.XXXXXX") || return 1
        # 自重建（路线图 7b-2 自举）：现有 .tabc 编自己——同源码同输出
        # byte-identical；改过源码时产出新源码的编译物（旧编译器编新源码
        # 是 bootstrap 常规）。
        # driver 镜像宿主在安装树里跑（link 期 dlopen lib/ 相对 CWD，同
        # build_tavm 约定；参数已是绝对路径，换 CWD 无副作用）。模块解析的
        # 根由 driver 从入口文件位置推出来，与 cwd / 环境变量无关，所以这里
        # 不需要再钉住任何基准（TA_PROJECT_ROOT 已退役）。
        (cd "$SCRIPT_DIR" && "$TAVM" -q "$TAVM_DRIVER_BC" "$driver_src" "$tmpdrv" "") || {
            rm -f "$tmpdrv"
            return 1
        }
        mv -f "$tmpdrv" "$TAVM_DRIVER_BC"
    fi
}

# build_tavm <src> <out> [emit_kl]: 编译半程独立出口（build 子命令；run_tavm
# 也走这里保证两条路径同一实现）。模块解析的根由 driver 从**入口源文件**
# 的位置推出来（向上第一个含 vendor/ 的祖先），所以这里既不传
# TA_PROJECT_ROOT 也不依赖 cwd：同一个入口文件从任何目录调用都解析到同一棵
# 树。cwd 仍是 $SCRIPT_DIR —— 编译期 dlopen("lib/<mod>.dylib") 是 cwd 相对
# 的，换 CWD 会让编译器自己的 stdlib dylib 不可达；运行半程的 cwd 留在调用
# 方（程序自己的 dylib 语义不变）。
# emit_kl 非空时多写一份 .kl 文本（不参与编译，<out> 逐字节不变）。
# env -u TA_ACTOR_HEAP：程序级 arena knob 只约束运行半程；编译宿主（driver）
# 跑在默认 heap 下，与旧链 build 同语义。
build_tavm() {
    local src="$1" out="$2" emit_kl="${3:-}" cov="${4:-}"
    require_source "$src" || return 1
    ensure_tavm_driver || return 1
    # typecheck sig cache：项目级目录跨调用共享（lib 模块签名只算一次），
    # TA_SIG_CACHE_DIR 可覆盖。没有它每次编译都全量 typecheck 全部依赖。
    local CACHE_DIR="${TA_SIG_CACHE_DIR:-$SCRIPT_DIR/.build/modules}"
    # 收集模式：编译半程 = driver 进程，它自己的计数器（lib/bootstrap/*.ta
    # 的覆盖）落 compiler-dumps。这里 export 是安全的：收集模式下本脚本唯一
    # 还会跑的程序是 run_tavm 的运行半程，它显式覆盖 TA_COV_DUMP_DIR
    # （per-image 目录）。反过来，这个 env 绝不下发给**直接跑 tavm 的**
    # 进程（run_image / 脚本里的裸 tavm）：coverage id 是镜像局部的，落进
    # compiler 的 id 空间会静默算错。
    if cov_mode; then
        mkdir -p "$TA_COV_MAP_DIR/compiler-dumps"
        export TA_COV_DUMP_DIR="$TA_COV_MAP_DIR/compiler-dumps"
    fi
    # 模式 flag（--emit-kl / --cov）必须排在 <src> **之前**：driver 按
    # argv[0] dispatch，源码路径顶到 argv[0] 就落进 .ta 路、flag 被当文件名
    # （docs/kl-format.md「已知怪癖」）。set -- 拼前置前缀，三条路共一次调用。
    if [ -n "$emit_kl" ]; then
        set -- --emit-kl "$emit_kl"
    elif [ "$cov" = 1 ]; then
        set -- --cov
    else
        set --
    fi
    (cd "$SCRIPT_DIR" && env -u TA_ACTOR_HEAP "$TAVM" -q "$TAVM_DRIVER_BC" \
        "$@" "$src" "$out" "$CACHE_DIR")
}

# build_from_kl <kl> <out>：.kl 路编译（不读源码、不跑 typecheck —— lower 丢
# 掉 type/type-sig/const，见 docs/kl-format.md §1.1）。driver 的 --from-kl
# 分支没有 <src> 位置参数，故 flag 只能在最前。
build_from_kl() {
    local kl="$1" out="$2"
    if [ ! -f "$kl" ]; then
        echo "error: .kl file not found: $kl" >&2
        return 1
    fi
    ensure_tavm_driver || return 1
    (cd "$SCRIPT_DIR" && env -u TA_ACTOR_HEAP "$TAVM" -q "$TAVM_DRIVER_BC" --from-kl "$kl" "$out")
}

# emit_kl_only <src.ta> <out.kl>：只写 .kl 文本（gcc -S 语义），不出字节码。
# driver 的 --emit-kl 形态是"编译 + 附赠 .kl"，字节码落到临时文件后删掉。
emit_kl_only() {
    local src="$1" kl="$2" tmpbc rc=0
    require_source "$src" || return 1
    ensure_tavm_driver || return 1
    tmpbc=$(mktemp /tmp/tinyactor-kl-XXXXXX) || return 1
    build_tavm "$src" "$tmpbc" "$kl" || rc=$?
    rm -f "$tmpbc"
    return "$rc"
}

# cov_mode：是否走 --cov 插桩编译。TA_COV_MAP_DIR 是收集模式的总开关
# （make coverage-ta 给整套测试挂上）：它同时告诉调用方 covmap/dump 往哪
# 收，所以不能再多一个旗标 —— 一个开关、一处真相。收集模式要配插桩版
# driver（TA_DRIVER_BC）才有 compiler 组的数：program 组是每个测试程序自己
# 的镜像，compiler 组是 driver 自己。
cov_mode() { [ -n "${TA_COV_MAP_DIR:-}" ]; }

# run_tavm <src> [args...]: lisp 双轨运行路径。
# 编译半程 = tavm 跑 lib/bootstrap.tabc（driver.typecheck_cached 模块
# 级签名缓存在 .build/modules，miss 才全量 typecheck；再走 lisp 管线
# tokenize/parse/lower/compile -> .tabc），运行半程 = 同一二进制（7b-2 起
# 同宿主；backend-gate 静态门看守编译半程必须走种子宿主）。
# import 由 driver resolve_imports 命名空间化解析（issue #256），源文件直接
# 喂即可；run_corpus.sh 仍用 expand_imports.py 展开，是 corpus 测试的既有
# 约定，与本函数无关。
run_tavm() {
    local src="$1"; shift
    require_source "$src" || return 1
    # mktemp -d 一次建目录：直接 mktemp file 再拼 .tabc 后缀会每次泄漏一个
    # 无后缀空文件；临时目录也顺手解决 exec 无法清理的问题——不再 exec，
    # 走正常 return（调用方 exit $?），rc 语义与 tavm 一致（含 128+sig）。
    local tmpdir tmpbc rc
    tmpdir=$(mktemp -d /tmp/tinyactor-tavm-XXXXXX) || return 1
    tmpbc="$tmpdir/run.tabc"
    local abs_src
    abs_src=$(absolute_path "$src")
    local cov=0
    if cov_mode; then cov=1; fi
    if ! build_tavm "$abs_src" "$tmpbc" "" "$cov"; then
        rm -rf "$tmpdir"
        return 1
    fi
    # 收集模式（--cov + TA_COV_MAP_DIR）：covmap 与 dump 都按镜像分离 ——
    # coverage id 是镜像局部的，混进一个目录无法归属；
    # tools/merge_coverage_ta.py 就认 maps/<tag>/map.covmap + dumps/<tag>/。
    # tag 取 mktemp -d 的目录名（每个程序唯一，tmpbc 的 basename 恒为
    # run.tabc，不能当 tag）。
    local cov_dump=""
    if [ "$cov" = 1 ] && cov_mode; then
        local tag
        tag="$(basename "$tmpdir")"
        mkdir -p "$TA_COV_MAP_DIR/maps/$tag" "$TA_COV_MAP_DIR/dumps/$tag"
        cp "$tmpbc.covmap" "$TA_COV_MAP_DIR/maps/$tag/map.covmap"
        cov_dump="$TA_COV_MAP_DIR/dumps/$tag"
    fi
    # -q：只打程序输出（与 tavm 路径语义一致：main 返回值不打印）
    # `|| rc=$?` 而非裸跑再取 $?：set -e 下子进程被信号杀（如测试脚本
    # cleanup 的 TERM）会让外壳直接退出，跳过 rm -rf —— 每次异常终止
    # 泄漏一个 /tmp/tinyactor-tavm-XXX 目录。
    rc=0
    if [ -n "$cov_dump" ]; then
        # 程序自己的计数器落到该程序的 dump 目录；编译半程是另一个进程
        # （driver），它继承外层 TA_COV_DUMP_DIR = compiler 的 dump 目录。
        TA_COV_DUMP_DIR="$cov_dump" "$TAVM" -q "$tmpbc" "$@" || rc=$?
    else
        "$TAVM" -q "$tmpbc" "$@" || rc=$?
    fi
    rm -rf "$tmpdir"
    return $rc
}

# run_kl <kl> [args...]: .kl 路运行 = build_from_kl 到临时 .tabc 再 tavm。
# rc 语义与 run_tavm 一致（含 128+sig）。
run_kl() {
    local kl="$1"; shift
    local tmpdir tmpbc rc
    tmpdir=$(mktemp -d /tmp/tinyactor-tavm-XXXXXX) || return 1
    tmpbc="$tmpdir/run.tabc"
    if ! build_from_kl "$kl" "$tmpbc"; then
        rm -rf "$tmpdir"
        return 1
    fi
    rc=0
    "$TAVM" -q "$tmpbc" "$@" || rc=$?
    rm -rf "$tmpdir"
    return $rc
}

# require_image <img.tabc>：镜像存在性检查（.tabc 直跑路）。这里只判存在；
# 空/截断/版本不符由 tavm 装载时报错，rc 照样透传。两条都**不**回落去编译
# 同名源文件：回落会把"跑镜像"静默变成"编源跑"，恰是本路要避免的。
require_image() {
    local img="$1"
    if [ ! -f "$img" ]; then
        echo "error: bytecode image not found: $img" >&2
        return 1
    fi
}

# run_image <img.tabc> [args...]: .tabc 直跑路 = 等价 `tavm -q <img> args…`，
# **不编译** —— 不碰 driver 种子、不读源码、不写 .build/modules 签名缓存。
# 故不用 ensure_tavm_driver（那是编译半程的保障，driver 陈旧会触发自重建），
# 只要宿主可执行（require_tavm）。exec 而非子进程：无临时文件可清理，
# tavm 的 rc（含 128+sig）原样成为 CLI 的 rc。
run_image() {
    local img="$1"; shift
    require_image "$img" || return 1
    require_tavm || return 1
    exec "$TAVM" -q "$img" "$@"
}

# src_kind <path>: 按扩展名分发 .ta / .kl / .tabc，其余报错并 exit 1。
src_kind() {
    case "$1" in
        *.ta) printf 'ta' ;;
        *.kl) printf 'kl' ;;
        *.tabc) printf 'tabc' ;;
        *)
            echo "error: unsupported source extension (expected .ta, .kl or .tabc): $1" >&2
            exit 1
            ;;
    esac
}

if [ $# -lt 1 ]; then usage; fi

CMD="$1"
shift

case "$CMD" in
                        run)
        if [ $# -lt 1 ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
                # run_tavm / run_kl / run_image 的 rc（含失败 1 / tavm 128+sig）原样透传
        KIND="$(src_kind "$SRC")"
        case "$KIND" in
            ta) run_tavm "$SRC" "$@" ;;
            kl) run_kl "$SRC" "$@" ;;
            tabc) run_image "$SRC" "$@" ;;
        esac
        exit $?
        ;;
        build)
        # flag 统一前置：--emit-kl / --cov 之后是 <src> [out]。out 省略时按扩展名
        # 取默认：.ta/.kl → 旁边 <base>.tabc；--emit-kl → 旁边 <base>.kl。
        EMIT_KL=0
        COV=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --emit-kl) EMIT_KL=1 ;;
                --cov) COV=1 ;;
                *) break ;;
            esac
            shift
        done
        if [ $# -lt 1 ] || [ "${1#-}" != "$1" ]; then usage; fi
        SRC="$(absolute_path "$1")"
        shift
        KIND="$(src_kind "$SRC")"
        if [ "$EMIT_KL" = 1 ] && [ "$COV" = 1 ]; then
            echo "error: --emit-kl and --cov are mutually exclusive" >&2
            exit 1
        fi
        if [ "$EMIT_KL" = 1 ]; then
            if [ "$KIND" != ta ]; then
                echo "error: --emit-kl takes a .ta source, got: $SRC" >&2
                exit 1
            fi
            if [ $# -gt 1 ]; then usage; fi
            if [ $# -eq 1 ]; then
                emit_kl_only "$SRC" "$(absolute_path "$1")"
            else
                emit_kl_only "$SRC" "${SRC%.ta}.kl"
            fi
            exit $?
        fi
        if [ $# -gt 1 ]; then usage; fi
        if [ $# -eq 1 ]; then
            OUT="$(absolute_path "$1")"
        else
            OUT="${SRC%.*}.tabc"
        fi
        case "$KIND" in
            ta) require_source "$SRC" && build_tavm "$SRC" "$OUT" "" "$COV" ;;
            kl) build_from_kl "$SRC" "$OUT" ;;
            # .tabc 是 build 的产物、不是它的输入：镜像已经在那儿了，
            # 认了扩展名却不报错会让这条命令静默成功（什么都不做）。
            tabc)
                echo "error: build takes a .ta or .kl source, got: $SRC" >&2
                exit 1
                ;;
        esac
        exit $?
        ;;
        fmt)
        if [ $# -lt 1 ]; then usage; fi
                if [ "$1" = "--check" ]; then
            if [ $# -lt 2 ]; then usage; fi
            require_source "$(absolute_path "$2")"
            # fmt 再宿主（7b-3）：执行体 = driver 的 fmt 分发（tavm -q 种子，
            # 与 run/build 同参布局）。
            # lisp 路径不产出覆盖数据（同 run_tavm 的 driver 约定），
            # TA_COV_DUMP_DIR 不再传给宿主。
            ensure_tavm_driver || exit 1
            OUT=$(cd "$SCRIPT_DIR" && "$TAVM" -q "$TAVM_DRIVER_BC" fmt --check "$(absolute_path "$2")")
            echo "$OUT"
            case "$OUT" in
                *"diff:"*) exit 1 ;;
            esac
                                                else
            require_source "$(absolute_path "$1")"
            ensure_tavm_driver || exit 1
            (cd "$SCRIPT_DIR" && "$TAVM" -q "$TAVM_DRIVER_BC" fmt "$(absolute_path "$1")")
        fi
        ;;
    vendor)
        if [ $# -gt 0 ]; then usage; fi
        cmd_vendor
        exit $?
        ;;
    init)
        if [ $# -gt 0 ]; then usage; fi
        cmd_init
        exit $?
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage
        ;;
esac