#!/bin/bash
#
# tinyactor — user-facing CLI for the TinyActor runtime.
# Orchestrates tavm + bootstrap.tabc for building and running TA code.
#
# The bootstrap.tabc uses backward compat mode: when invoked with a source
# .ta path and an output .tabc path, it compiles the source to bytecode.
# When invoked with just a source .ta path, it compiles and runs.

set -euo pipefail

TAVM="${TAVM:-./tavm}"
BOOTSTRAP="lib/bootstrap.tabc"
# Pre-load http.so so the compiler can resolve http module functions
HTTP_MOD="lib/http.so"

usage() {
    cat >&2 <<EOF
usage: tinyactor <command> [args...]

Commands:
  build <src>.ta [<out>.tabc]   Compile .ta to .tabc (default: <src>.tabc)
  run   <src>.ta [args...]      Compile and run (two-step: build to /tmp, then tavm)
  help                          Show this help
EOF
            exit 1
}

if [ $# -lt 1 ]; then usage; fi

CMD="$1"
shift

case "$CMD" in
    build)
        if [ $# -lt 1 ]; then usage; fi
        SRC="$1"
        OUT="${2:-${SRC%.*}.tabc}"
        exec "$TAVM" -L "$HTTP_MOD" "$BOOTSTRAP" "$SRC" "$OUT"
        ;;
    run)
        if [ $# -lt 1 ]; then usage; fi
        SRC="$1"
        shift
        TMP=$(mktemp /tmp/tinyactor-XXXXXX)
        TMPTABC="$TMP.tabc"
        # Build to temp (with http module loaded for compilation)
        "$TAVM" -L "$HTTP_MOD" "$BOOTSTRAP" "$SRC" "$TMPTABC"
        # Run with remaining args (http module loaded for runtime)
        "$TAVM" -L "$HTTP_MOD" "$TMPTABC" "$@"
        rm -f "$TMPTABC"
        ;;
            help|--help|-h)
        usage
        ;;
    *)
        usage
        ;;
esac