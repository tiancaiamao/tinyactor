// lib/serve.ta — Static file HTTP server (demo)
//
// Usage:  tavm lib/serve.ta <port> <root-dir>
// Example: tavm lib/serve.ta 8080 /Users/genius/project/tiancaiamao.github.io
//
// Built on the TA http layer (lib/http.ta): the route table is a plain
// Dict(path -> handler) with "*" as the catch-all — every request is a
// file lookup, so the whole server is one catch-all handler plus
// http.listen_routes / http.serve_loop. One handler actor per connection
// is spawned by the serve loop.
//
// Depends on C modules (dotted calls):
//   file.*  — file.read / file.exists (built into tavm, src/file.c)
//   vm.*    — get_arg / time_ms

import http
import dict
import str

// Index of the last '.' in s, or -1. (str has no rindex; scan from the end.)
fn rindex_dot(s, i) {
  if i < 0 {
    -1
  } else {
    match str.char_at(s, i) {
      '.' -> i
      _ -> rindex_dot(s, i - 1)
    }
  }
}

// Content type by file extension (last dot in the path).
fn mime_of(path) {
  match rindex_dot(path, str.length(path) - 1) {
    -1 -> "text/plain"
    idx -> {
      match str.substr(path, idx, str.length(path) - idx) {
        ".html" -> "text/html"
        ".htm" -> "text/html"
        ".css" -> "text/css"
        ".js" -> "application/javascript"
        ".png" -> "image/png"
        ".jpg" -> "image/jpeg"
        ".jpeg" -> "image/jpeg"
        ".gif" -> "image/gif"
        ".svg" -> "image/svg+xml"
        ".ico" -> "image/x-icon"
        ".woff2" -> "font/woff2"
        ".woff" -> "font/woff2"
        ".txt" -> "text/plain"
        ".md" -> "text/plain"
        ".xml" -> "text/plain"
        ".atom" -> "application/atom+xml"
        ".rss" -> "application/atom+xml"
        _ -> "application/octet-stream"
      }
    }
  }
}

// Strip a trailing '/' (except the root path itself).
fn trim_slash(path) {
  let len = str.length(path)
  if len > 1 && str.char_at(path, len - 1) == '/' {
    str.substr(path, 0, len - 1)
  } else {
    path
  }
}

// Resolve a URL path under root; returns a filesystem path or nil.
// Order: dir index.html, exact file, extensionless -> .html (this blog's
// nav links are /index /project /about mapping to index/project/about.html).
fn resolve_path(root, path) {
  match path {
    "/" -> str.concat(root, "/index.html")
    _ -> {
      let full = trim_slash(str.concat(root, path))
      let index = str.concat(full, "/index.html")
      if file.exists(index) == 1 {
        index
      } else {
        if file.exists(full) == 1 {
          full
        } else {
          let html = str.concat(full, ".html")
          if file.exists(html) == 1 {
            html
          } else {
            nil
          }
        }
      }
    }
  }
}

// The single catch-all handler: GET-only, no path traversal, file lookup.
fn file_handler(root) {
  fn(req) {
    match req {
      MkReq(method, path, _, _, _) -> {
        if method == "GET" {
          if str.index_of(path, "..") >= 0 {
            http.text_response(403, "403 Forbidden")
          } else {
            match resolve_path(root, path) {
              nil -> http.text_response(404, "404 Not Found")
              full ->
              match file.read(full) {
                nil -> http.text_response(404, "404 Not Found")
                data ->
                // MkResp directly: http.response renders a wire STRING,
                // handlers return Response values (rendered by the serve
                // loop).
                MkResp(
                200,
                dict.insert(dict.str_new(), "Content-Type", mime_of(full)),
                data
                )
              }
            }
          }
        } else {
          http.text_response(405, "405 Method Not Allowed")
        }
      }
    }
  }
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let root = vm.get_arg(1)
  let routes = dict.insert(dict.str_new(), "*", file_handler(root))
  match http.listen_routes(routes, port) {
    Err(_) -> print("listen failed")
    Ok(lst) -> {
      print(str.concat(str.concat("serving ", root), str.concat(" on port ", str.from_int(port))))
      http.serve_loop(routes, lst)
    }
  }
}
