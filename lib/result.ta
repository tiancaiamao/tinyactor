// result module: Ok/Err error handling helpers.
// API follows Gleam's result module (function first, result last).
// unwrap on an Err crashes (1 / 0) — there is no runtime error-reporting
// mechanism yet; use unwrap_or when a fallback is available.
//
// The type params are explicit (`Result(t, e)`, not bare `Result`) so the
// constructors unify with applied annotations. Verified repro (nullary
// `type Res { Ok(value) Err(err) }` + `fn f() -> Res(int, string) { Ok(1) }`):
//
//   [E0001] in function 'f' (line 7): cannot unify Res with Res(int, string)
//
// The same file with `type Res(t, e)` typechecks and runs. Note:
// lib/registry.ta's `-> Result(symbol, symbol)` is not a counterexample —
// registry.ta does not import this module, so its `Result` is an unbound
// (opaque) annotation name, never unified against this type.

pub type Result(t, e) {
  Ok(value)
  Err(err)
}

// map: apply f to the Ok value; an Err passes through untouched.
pub fn map(f, r) {
  match r {
    Ok(v) -> Ok(f(v))
    Err(e) -> Err(e)
  }
}

// map_err: apply f to the Err value; an Ok passes through untouched.
pub fn map_err(f, r) {
  match r {
    Ok(v) -> Ok(v)
    Err(e) -> Err(f(e))
  }
}

// bind: chain a result-returning f onto an Ok; an Err passes through.
pub fn bind(f, r) {
  match r {
    Ok(v) -> f(v)
    Err(e) -> Err(e)
  }
}

// try: Gleam's monadic chain. Same shape as bind — an Err short-circuits
// untouched; the Ok value feeds the result-returning f.
pub fn try(f, res) {
  match res {
    Ok(v) -> f(v)
    Err(e) -> Err(e)
  }
}

// is_ok: true when r is an Ok (bare use in if conditions, not == 1).
pub fn is_ok(r) {
  match r {
    Ok(_) -> true
    Err(_) -> false
  }
}

// is_err: true when r is an Err.
pub fn is_err(r) {
  match r {
    Ok(_) -> false
    Err(_) -> true
  }
}

// or: the first Ok wins; an Err falls back to b (b is always evaluated).
pub fn or(a, b) {
  if is_ok(a) {
    a
  } else {
    b
  }
}

// unwrap: the Ok value. An Err crashes the process (1 / 0, the same
// fail-fast contract as json.parse_or_fail).
pub fn unwrap(r) {
  match r {
    Ok(v) -> v
    Err(_) -> 1 / 0
  }
}

// unwrap_or: the Ok value, or default on Err.
pub fn unwrap_or(default, r) {
  match r {
    Ok(v) -> v
    Err(_) -> default
  }
}
