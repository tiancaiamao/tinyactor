pub fn is_digit(c) {
  match c {
    48 -> true
    49 -> true
    50 -> true
    51 -> true
    52 -> true
    53 -> true
    54 -> true
    55 -> true
    56 -> true
    57 -> true
    _ -> false
  }
}

pub fn is_alpha(c) {
  match c {
    65 -> true
    66 -> true
    67 -> true
    68 -> true
    69 -> true
    70 -> true
    71 -> true
    72 -> true
    73 -> true
    74 -> true
    75 -> true
    76 -> true
    77 -> true
    78 -> true
    79 -> true
    80 -> true
    81 -> true
    82 -> true
    83 -> true
    84 -> true
    85 -> true
    86 -> true
    87 -> true
    88 -> true
    89 -> true
    90 -> true
    97 -> true
    98 -> true
    99 -> true
    100 -> true
    101 -> true
    102 -> true
    103 -> true
    104 -> true
    105 -> true
    106 -> true
    107 -> true
    108 -> true
    109 -> true
    110 -> true
    111 -> true
    112 -> true
    113 -> true
    114 -> true
    115 -> true
    116 -> true
    117 -> true
    118 -> true
    119 -> true
    120 -> true
    121 -> true
    122 -> true
    95 -> true
    _ -> false
  }
}

pub fn is_ident_char(c) {
  if is_alpha(c) {
    true
  } else {
    if is_digit(c) {
      true
    } else {
      match c {
        46 -> true
        43 -> true
        45 -> true
        60 -> true
        62 -> true
        61 -> true
        33 -> true
        63 -> true
        42 -> true
        47 -> true
        _ -> false
      }
    }
  }
}

fn reverse_helper(lst, acc) {
  if null?(lst) {
    acc
  } else {
    reverse_helper(cdr(lst), cons(car(lst), acc))
  }
}

fn reverse(lst) {
  reverse_helper(lst, nil)
}

fn is_kw(s) {
  if str.eq(s, "fn") { true }
  else {
    if str.eq(s, "let") { true }
    else {
      if str.eq(s, "match") { true }
      else {
        if str.eq(s, "if") { true }
        else {
          if str.eq(s, "else") { true }
          else {
            if str.eq(s, "spawn") { true }
            else {
              if str.eq(s, "send") { true }
              else {
                if str.eq(s, "import") { true }
                else {
                  if str.eq(s, "receive") { true }
                  else {
                    if str.eq(s, "pub") { true }
                    else {
                      if str.eq(s, "type") { true }
                      else {
                        if str.eq(s, "external") { true }
                        else {
                          if str.eq(s, "nil") { true }
                          else {
                            if str.eq(s, "true") { true }
                            else {
                              if str.eq(s, "false") { true }
                              else { false }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn skip_ws(src, i) {
  let len = str.length(src)
  if i >= len {
    i
  } else {
    let c = str.char_at(src, i)
    match c {
      32 -> skip_ws(src, i + 1)
      9 -> skip_ws(src, i + 1)
      10 -> skip_ws(src, i + 1)
      13 -> skip_ws(src, i + 1)
      47 -> {
        if i + 1 < len {
          if str.char_at(src, i + 1) == 47 {
            skip_comment(src, i + 2)
          } else {
            i
          }
        } else {
          i
        }
      }
      _ -> i
    }
  }
}

fn skip_comment(src, i) {
  let len = str.length(src)
  if i >= len {
    i
  } else {
    if str.char_at(src, i) == 10 {
      skip_ws(src, i + 1)
    } else {
      skip_comment(src, i + 1)
    }
  }
}

// read_string_lit: scan the content of a string literal from `i` (first
// content char) and DECODE backslash escapes into the token value.
//   \n \r \t \\ \" \'  — single-char escapes
//   \xNN               — hex byte escape (e.g. \x0d for CR)
// Unknown escapes keep backslash + char literally. An escaped quote does NOT
// terminate the string. Unterminated strings emit an 'unterminated token with
// the raw content (escapes not decoded) for error reporting.
fn read_string_lit(src, i, start, acc) {
  let len = str.length(src)
  if i >= len {
    cons(cons('unterminated, str.substr(src, start, i - start)), i)
  } else {
    let c = str.char_at(src, i)
    if c == 34 {
      cons(cons('string, acc), i + 1)
    } else {
      if c == 92 {
        // Backslash: decode the escape sequence
        if i + 1 >= len {
          cons(cons('unterminated, str.substr(src, start, i - start)), i)
        } else {
          let e = str.char_at(src, i + 1)
          if e == 120 {
            // \xNN hex byte escape
            let hi = hex_digit(str.char_at(src, i + 2))
            let lo = hex_digit(str.char_at(src, i + 3))
            if hi < 0 {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              } else {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              }
            } else {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              } else {
                read_string_lit(src, i + 4, start, str.concat(acc, str.chr(hi * 16 + lo)))
              }
            }
          } else {
            let v = escape_value(e)
            if v < 0 {
              // Unknown escape — keep both characters literally
              read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(e))))
            } else {
              read_string_lit(src, i + 2, start, str.concat(acc, str.chr(v)))
            }
          }
        }
      } else {
        read_string_lit(src, i + 1, start, str.concat(acc, str.chr(c)))
      }
    }
  }
}

// escape_value(c) -> int byte value, or -1 for unknown escapes
fn escape_value(c) {
  if c == 110 { 10 }
  else {
    if c == 114 { 13 }
    else {
      if c == 116 { 9 }
      else {
        if c == 92 { 92 }
        else {
          if c == 34 { 34 }
          else {
            if c == 39 { 39 }
            else { -1 }
          }
        }
      }
    }
  }
}

// hex_digit(c) -> 0..15, or -1 when c is not a hex digit
fn hex_digit(c) {
  if c >= 48 {
    if c <= 57 { c - 48 }
    else {
      if c >= 97 {
        if c <= 102 { c - 97 + 10 }
        else {
          if c >= 65 {
            if c <= 70 { c - 65 + 10 }
            else { -1 }
          } else { -1 }
        }
      } else { -1 }
    }
  } else { -1 }
}

fn read_int_lit(src, i, start) {
  let len = str.length(src)
  if i >= len {
    let s = str.substr(src, start, len - start)
    cons(cons('int, str.to_int(s)), len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_int_lit(src, i + 1, start)
    } else {
      let s = str.substr(src, start, i - start)
      cons(cons('int, str.to_int(s)), i)
    }
  }
}

fn read_ident(src, i, start) {
  let len = str.length(src)
  if i >= len {
    make_ident_tok(src, start, len)
  } else {
    if is_ident_char(str.char_at(src, i)) {
      read_ident(src, i + 1, start)
    } else {
      make_ident_tok(src, start, i)
    }
  }
}

fn make_ident_tok(src, start, end) {
  let s = str.substr(src, start, end - start)
  if is_kw(s) {
    cons(cons('kw, s), end)
  } else {
    cons(cons('ident, s), end)
  }
}

// read_char_lit: try to parse a char literal at src[i] (i is at a quote).
// Supports plain 'X' and the same backslash escapes as strings:
// \n \r \t \\ \" \' \xNN. Returns cons(token, next_index) on success,
// or nil when this quote is NOT a char literal (i.e. it is a quote form).
fn read_char_lit(src, i, len) {
  if i + 1 < len {
    if str.char_at(src, i + 1) == 92 {
      // backslash escape: '\X' is 4 chars, '\xNN' is 6 chars
      if i + 2 < len {
        let e = str.char_at(src, i + 2)
        if e == 120 {
          // \xNN hex escape: '\xNN' closing quote at i + 5
          if i + 5 < len {
            if str.char_at(src, i + 5) == 39 {
              let hi = hex_digit(str.char_at(src, i + 3))
              let lo = hex_digit(str.char_at(src, i + 4))
              if hi >= 0 {
                if lo >= 0 { cons(cons('int, hi * 16 + lo), i + 6) }
                else { nil }
              } else { nil }
            } else { nil }
          } else { nil }
        } else {
          // single-char escape: '\X' closing quote at i + 3
          if i + 3 < len {
            if str.char_at(src, i + 3) == 39 {
              let v = escape_value(e)
              if v < 0 { nil } else { cons(cons('int, v), i + 4) }
            } else { nil }
          } else { nil }
        }
      } else { nil }
    } else {
      // plain 'X': closing quote at i + 2
      if i + 2 < len {
        if str.char_at(src, i + 2) == 39 {
          cons(cons('int, str.char_at(src, i + 1)), i + 3)
        } else { nil }
      } else { nil }
    }
  } else { nil }
}

fn read_token(src, i) {
  let len = str.length(src)
  let c = str.char_at(src, i)
  match c {
    40 -> cons(cons('lparen, nil), i + 1)
    41 -> cons(cons('rparen, nil), i + 1)
    123 -> cons(cons('lbrace, nil), i + 1)
    125 -> cons(cons('rbrace, nil), i + 1)
    44 -> cons(cons('comma, nil), i + 1)
    58 -> cons(cons('colon, nil), i + 1)
        59 -> cons(cons('semicol, nil), i + 1)
    91 -> cons(cons('lbracket, nil), i + 1)
    93 -> cons(cons('rbracket, nil), i + 1)
            39 -> {
      // Disambiguation (D6): 'X' (quote-char-quote) is a char literal whose
      // token value is the Unicode codepoint of X; escapes like '\n' decode
      // the same as strings. Any other use of ' is the quote form
      // ('symbol -> (quote symbol) in the parser).
      let r = read_char_lit(src, i, len)
      if null?(r) {
        cons(cons('quote, nil), i + 1)
      } else {
        r
      }
    }
        34 -> read_string_lit(src, i + 1, i + 1, "")
        45 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 62 {
          cons(cons('arrow, nil), i + 2)
        } else {
          if is_digit(str.char_at(src, i + 1)) {
            let r = read_int_lit(src, i + 1, i + 1)
            let tok = car(r)
            let val = cdr(tok)
            let next_i = cdr(r)
            cons(cons('int, 0 - val), next_i)
          } else {
            cons(cons('op, "-"), i + 1)
          }
        }
      } else {
        cons(cons('op, "-"), i + 1)
      }
    }
    61 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 61 {
          cons(cons('op, "=="), i + 2)
        } else {
          cons(cons('op, "="), i + 1)
        }
      } else {
        cons(cons('op, "="), i + 1)
      }
    }
    60 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 61 {
          cons(cons('op, "<="), i + 2)
        } else {
          cons(cons('op, "<"), i + 1)
        }
      } else {
        cons(cons('op, "<"), i + 1)
      }
    }
    62 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 61 {
          cons(cons('op, ">="), i + 2)
        } else {
          cons(cons('op, ">"), i + 1)
        }
      } else {
        cons(cons('op, ">"), i + 1)
      }
    }
    43 -> cons(cons('op, "+"), i + 1)
    42 -> cons(cons('op, "*"), i + 1)
    47 -> cons(cons('op, "/"), i + 1)
    37 -> cons(cons('op, "%"), i + 1)
    38 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 38 {
          cons(cons('op, "&&"), i + 2)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      } else {
        cons(cons('unknown, nil), i + 1)
      }
    }
    124 -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == 124 {
          cons(cons('op, "||"), i + 2)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      } else {
        cons(cons('unknown, nil), i + 1)
      }
    }
    _ -> {
      if is_digit(c) {
        read_int_lit(src, i, i)
      } else {
        if is_alpha(c) {
          read_ident(src, i, i)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      }
    }
  }
}

fn tokenize_loop(src, i, acc) {
  let i2 = skip_ws(src, i)
  let len = str.length(src)
  if i2 >= len {
    cons(cons('eof, nil), acc)
  } else {
    let result = read_token(src, i2)
    let tok = car(result)
    let next_i = cdr(result)
    tokenize_loop(src, next_i, cons(tok, acc))
  }
}

pub fn tokenize(src) {
  let rev_toks = tokenize_loop(src, 0, nil)
  reverse(rev_toks)
}
