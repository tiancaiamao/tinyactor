// cmp module: shared comparison primitives.
//
// Comparator convention (the whole stdlib agrees on this, see
// docs/stdlib-port-plan.md "比较语义"): a comparator cmp(a, b) returns an
// int that is < 0 when a < b, == 0 when a == b, > 0 when a > b — the same
// shape as C qsort's compare function. v1 has no universal compare / deep
// equality: sort/min/max/uniq (list) and dict.new all take an explicit
// comparator, and this module supplies the standard ones.

// int_cmp: compare two ints.
pub fn int_cmp(a, b) {
  if a < b {
    -1
  } else {
    if a == b {
      0
    } else {
      1
    }
  }
}

// float_cmp: compare two floats. Written as `0.0 < a - b` on purpose:
// the typechecker's `<` binds an unconstrained tvar to int (int-first
// fallback), so anchoring the comparison on the float literal is what
// pins a/b to the float type.
pub fn float_cmp(a, b) {
  if 0.0 < a - b {
    1
  } else {
    if 0.0 < b - a {
      -1
    } else {
      0
    }
  }
}

// str_cmp: compare two strings codepoint by codepoint (str.char_at
// semantics, matching the codepoint-counting convention of the str
// builtins). A string that is a prefix of the other compares less.
pub fn str_cmp(a, b) {
  str_cmp_at(a, b, 0)
}

fn str_cmp_at(a, b, i) {
  let ca = str.char_at(a, i)
  let cb = str.char_at(b, i)
  if ca == cb {
    // -1 == -1 means both exhausted: equal.
    if ca == -1 {
      0
    } else {
      str_cmp_at(a, b, i + 1)
    }
  } else {
    if ca < cb {
      -1
    } else {
      1
    }
  }
}
