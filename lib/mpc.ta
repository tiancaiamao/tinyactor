// mpc module: monadic parser combinator library.
// A parser is fn(s, i) -> Reply (source string + index).
// Compose parsers sequentially with the `use x <- then(p); rest` block-level
// bind desugaring (Gleam-style do-notation); bind/ret are the underlying
// primitives and stay ordinary library functions.
// NOTE: no left recursion (recursive descent, like PEG). Rewrite
// left-recursive rules as `term ('op' term)*` with star()/plus().
//
// Reply protocol (a declared ADT, one variant per outcome):
//   Ok(value, pos)  matched: the value, and the index just past the match
//   Err(msg, pos)   failed at char offset pos into s; msg = expectation
//                   description
// Hand-written fn(s, i) parsers raise their failures with err_at() so they
// merge into the same channel (line/col come from the offset).

pub type Reply(t) {
  Ok(value, pos : Int)
  Err(msg : String, pos : Int)
}

// ---------- error channel ----------

// Build a failure result carrying the failure offset and an expectation
// description (e.g. "expecting digit"). Public so hand-written parsers
// can raise errors that merge correctly with combinator-raised ones.
pub fn err_at(msg, pos) {
  Err(msg, pos)
}

// r succeeded?
pub fn ok?(r) {
  match r {
    Ok(_, _) -> true
    Err(_, _) -> false
  }
}

// r failed?
pub fn fail?(r) {
  match r {
    Ok(_, _) -> false
    Err(_, _) -> true
  }
}

// offset of the failure point, or nil if r is not a failure
pub fn fail_pos(r) {
  match r {
    Ok(_, _) -> nil
    Err(_, pos) -> pos
  }
}

// expectation description of the failure, or nil if r is not a failure
pub fn fail_msg(r) {
  match r {
    Ok(_, _) -> nil
    Err(msg, _) -> msg
  }
}

// keep the failure that got FURTHEST into the input (largest offset);
// on a tie the first (leftmost alternative) wins. Both args are failures:
// choice only asks once both sides came back Err.
fn err_max(e1, e2) {
  if fail_pos(e2) > fail_pos(e1) {
    e2
  } else {
    e1
  }
}

// 1-based line number of char offset pos in s (counts '\n')
pub fn line_of(s, pos) {
  line_count(s, 0, pos, 1)
}

fn line_count(s, i, stop, n) {
  if i >= stop {
    n
  } else {
    if str.char_at(s, i) == '\n' {
      line_count(s, i + 1, stop, n + 1)
    } else {
      line_count(s, i + 1, stop, n)
    }
  }
}

// 1-based column number of char offset pos in s
// (chars since the last '\n' at or before pos)
pub fn col_of(s, pos) {
  let nl = last_nl(s, 0, pos, -1)
  if nl < 0 {
    pos + 1
  } else {
    pos - nl
  }
}

fn last_nl(s, i, stop, acc) {
  if i >= stop {
    acc
  } else {
    if str.char_at(s, i) == '\n' {
      last_nl(s, i + 1, stop, i)
    } else {
      last_nl(s, i + 1, stop, acc)
    }
  }
}

// human-readable one-liner: "line L, col C: <msg>".
// A Reply that is an Ok (a parser result passed here by mistake) has no
// position and no message: it formats as "unknown position" instead of
// recursing into line_count with a nil offset.
pub fn fmt_err(s, r) {
  match r {
    Ok(_, _) -> "unknown position"
    Err(msg, pos) -> {
      let line = str.concat("line ", str.concat(str.from_int(line_of(s, pos)), str.concat(", col ", str.from_int(col_of(s, pos)))))
      str.concat(line, str.concat(": ", msg))
    }
  }
}

// ---------- monad ----------

pub fn ret(v) {
  fn(s, i) { Ok(v, i) }
}

pub fn bind(p, f) {
  fn(s, i) {
    match p(s, i) {
      Err(msg, pos) -> Err(msg, pos)
      Ok(v, j) -> f(v)(s, j)
    }
  }
}

// binder wrapper for the `use` syntax: `use v <- then(p); rest` desugars to
// the plain call then(p)(lambda(v) rest), and then(p) consumes the
// continuation by delegating to bind. Combinators that want to be consumed
// by `use` are wrapped in then at the use site (mpc.bind keeps its
// data-first shape for direct composition).
pub fn then(p) {
  fn(k) { bind(p, k) }
}

pub fn choice(p1, p2) {
  choice_list(cons(p1, cons(p2, nil)))
}

pub fn choice_list(ps) {
  fn(s, i) {
    match ps {
      nil -> err_at("no alternatives to match", i)
      cons(p, rest) -> choice_list_try(rest, s, i, p(s, i))
    }
  }
}

// try the remaining parsers; first success wins, otherwise report the
// failure that got furthest into the input
fn choice_list_try(ps, s, i, best) {
  match best {
    Ok(_, _) -> best
    Err(_, _) ->
    if null?(ps) {
      best
    } else {
      let r = car(ps)(s, i)
      if ok?(r) {
        r
      } else {
        choice_list_try(cdr(ps), s, i, err_max(best, r))
      }
    }
  }
}

pub fn pmap(f, p) {
  fn(s, i) {
    match p(s, i) {
      Err(msg, pos) -> Err(msg, pos)
      Ok(v, j) -> Ok(f(v), j)
    }
  }
}

pub fn lazy(pf) {
  fn(s, i) {
    let p = pf()
    p(s, i)
  }
}

// ---------- char-level primitives ----------

// one char satisfying predicate f; yields the char
pub fn satisfy(f) {
  satisfy_l(f, "expecting char satisfying predicate")
}

fn satisfy_l(f, msg) {
  fn(s, i) {
    if i < str.length(s) {
      let c = str.char_at(s, i)
      if f(c) {
        Ok(c, i + 1)
      } else {
        err_at(msg, i)
      }
    } else {
      err_at(msg, i)
    }
  }
}

// any single char; yields the char
pub fn any() {
  satisfy_l(fn(c) { true }, "expecting any char")
}

// one char in [lo, hi] (inclusive, by codepoint); yields the char
pub fn range(lo, hi) {
  let msg = str.concat("expecting ", str.concat(str.chr(lo), str.concat("-", str.chr(hi))))
  satisfy_l(fn(c) { and(c >= lo, c <= hi) }, msg)
}

// one ASCII digit; yields the char
pub fn digit() {
  satisfy_l(fn(c) { and(c >= '0', c <= '9') }, "expecting digit")
}

// exact literal string t; yields t
pub fn lit(t) {
  fn(s, i) {
    let n = str.length(t)
    let slen = str.length(s)
    if and(i + n <= slen, str.eq(str.substr(s, i, n), t)) {
      Ok(t, i + n)
    } else {
      err_at(str.concat("expecting ", t), i)
    }
  }
}

// match zero+ chars satisfying f, yields the matched substring
pub fn take_while(f) {
  fn(s, i) {
    let j = take_while_pos(s, i, str.length(s), f)
    Ok(str.substr(s, i, j - i), j)
  }
}

// match one+ chars satisfying f (empty match is a failure)
pub fn take_while1(f) {
  fn(s, i) {
    let j = take_while_pos(s, i, str.length(s), f)
    if j > i {
      Ok(str.substr(s, i, j - i), j)
    } else {
      err_at("expecting at least one matching char", i)
    }
  }
}

fn take_while_pos(s, i, len, f) {
  if i < len {
    let c = str.char_at(s, i)
    if f(c) {
      take_while_pos(s, i + 1, len, f)
    } else {
      i
    }
  } else {
    i
  }
}

// ---------- lookahead / termination ----------

// positive lookahead: p must match but nothing is consumed; yields p's value
pub fn peek(p) {
  fn(s, i) {
    match p(s, i) {
      Err(msg, pos) -> Err(msg, pos)
      Ok(v, _) -> Ok(v, i)
    }
  }
}

// negative lookahead: p must NOT match; consumes nothing, yields nil
pub fn not(p) {
  fn(s, i) {
    if ok?(p(s, i)) {
      err_at("expecting no match", i)
    } else {
      Ok(nil, i)
    }
  }
}

// end of input; consumes nothing, yields nil
pub fn eof() {
  fn(s, i) {
    if i == str.length(s) {
      Ok(nil, i)
    } else {
      err_at("expecting end of input", i)
    }
  }
}

// ---------- repetition ----------

// p or nothing; never fails — yields p's value or nil on absence
pub fn opt(p) {
  fn(s, i) {
    let r = p(s, i)
    if fail?(r) {
      Ok(nil, i)
    } else {
      r
    }
  }
}

// alias of opt (parsec naming)
pub fn optional(p) {
  opt(p)
}

// zero+ p; yields the list of values. Empty-match guarded: an iteration
// that succeeds without consuming input stops the loop (its value is
// NOT collected), so p may match empty without looping forever.
pub fn star(p) {
  fn(s, i) { star_loop(p, s, i, nil) }
}

fn star_loop(p, s, i, acc) {
  match p(s, i) {
    Err(_, _) -> Ok(rev(acc, nil), i)
    Ok(v, j) ->
    if j == i {
      // empty-match guard: p succeeded but consumed nothing — stop
      Ok(rev(acc, nil), i)
    } else {
      star_loop(p, s, j, cons(v, acc))
    }
  }
}

// one+ p; yields the list of values (fails iff the first p fails)
pub fn plus(p) {
  use v < - then(p)
  use rest < - then(star(p))
  ret(cons(v, rest))
}

// alias of plus (parsec naming)
pub fn many1(p) {
  plus(p)
}

// zero+ p separated by sep; yields the list of values. Never fails;
// a trailing sep is NOT consumed (the sep+item attempt simply fails).
pub fn sep_by(p, sep) {
  choice(sep_by1(p, sep), ret(nil))
}

// one+ p separated by sep; fails iff the first p fails
pub fn sep_by1(p, sep) {
  use v < - then(p)
  use rest < - then(star(sep_then(p, sep)))
  ret(cons(v, rest))
}

fn sep_then(p, sep) {
  use _ < - then(sep)
  use v < - then(p)
  ret(v)
}

fn rev(l, acc) {
  if null?(l) {
    acc
  } else {
    rev(cdr(l), cons(car(l), acc))
  }
}
