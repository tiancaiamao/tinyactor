// lib/bench.ta — Concurrent HTTP benchmark tool (demo)
//
// Usage: tavm lib/bench.ta <port> <path> <count> <concurrency>
// Example: tavm lib/bench.ta 8123 / 1000 16
//
// Spawns `concurrency` client actors; each runs count/concurrency sequential
// GET requests (one connection each) and reports (ok . (err . bytes)) back
// to the main actor via send/recv. The main actor tallies results and
// prints QPS / avg latency / throughput.
//
// The VM is single-threaded cooperative scheduling: actors overlap while
// suspended on socket I/O (net.read/net.write yield via poll), so
// concurrency hides network latency, not CPU-bound server work.
//
// Uses the VM's built-in net module (src/net.c): non-blocking sockets with
// actor suspension — net.read/net.write return nil on EAGAIN after the VM
// has already yielded this actor, so callers simply retry.

import net

// Write all of data; retries on EAGAIN (already yielded) and partial writes.
fn write_all(fd, data) {
  let n = net.write(fd, data)
  if n == -1 {
    nil
  } else {
    if null?(n) {
      write_all(fd, data)
    } else {
      if n < str.length(data) {
        write_all(fd, str.substr(data, n, str.length(data) - n))
      } else {
        n
      }
    }
  }
}

// Read until "\r\n\r\n" (HTTP head). Empty string means peer closed/errored.
fn read_head(fd, acc) {
  if str.index_of(acc, "\r\n\r\n") >= 0 {
    acc
  } else {
    let data = net.read(fd, 4096)
    match data {
      'eof -> acc
      _ -> {
        if data == -1 {
          acc
        } else {
          if null?(data) {
            read_head(fd, acc)
          } else {
            read_head(fd, str.concat(acc, data))
          }
        }
      }
    }
  }
}

// Read exactly n body bytes (or until peer closes).
fn read_n(fd, n, acc) {
  if str.length(acc) >= n {
    acc
  } else {
    let data = net.read(fd, 65536)
    match data {
      'eof -> acc
      _ -> {
        if data == -1 {
          acc
        } else {
          if null?(data) {
            read_n(fd, n, acc)
          } else {
            read_n(fd, n, str.concat(acc, data))
          }
        }
      }
    }
  }
}

// Content-Length from a response head, or 0 if absent.
fn content_length(head) {
  let idx = str.index_of(head, "Content-Length: ")
  if idx == -1 {
    0
  } else {
    let start = idx + 16
    let rest = str.substr(head, start, str.length(head) - start)
    let end = str.index_of(rest, "\r")
    if end == -1 {
      str.to_int(rest)
    } else {
      str.to_int(str.substr(rest, 0, end))
    }
  }
}

// HTTP status code from "HTTP/1.1 200 OK\r\n".
fn status_code(head) {
  str.to_int(str.substr(head, 9, 3))
}

// One GET request; returns (status . body-bytes), (-1 . 0) on failure.
fn http_get(port, path) {
  let c = net.connect("127.0.0.1", port)
  if c == -1 {
    cons(-1, 0)
  } else {
    let req = str.concat("GET ", str.concat(path, " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"))
    write_all(c, req)
    let head = read_head(c, "")
    if str.length(head) == 0 {
      net.close(c)
      cons(-1, 0)
    } else {
      let body = read_n(c, content_length(head), "")
      let status = status_code(head)
      net.close(c)
      cons(status, str.length(body))
    }
  }
}

// Tail-recursive loop: n requests, accumulate (ok . (err . bytes)).
fn bench_loop(port, path, n, ok, err, bytes) {
  if n <= 0 {
    cons(ok, cons(err, bytes))
  } else {
    let r = http_get(port, path)
    if car(r) == 200 {
      bench_loop(port, path, n - 1, ok + 1, err, bytes + cdr(r))
    } else {
      bench_loop(port, path, n - 1, ok, err + 1, bytes)
    }
  }
}

// One client actor: run its share of requests, report (ok . (err . bytes)).
fn run_worker(port, path, n, collector) {
  let r = bench_loop(port, path, n, 0, 0, 0)
  send(collector, r)
}

// Spawn `c` workers; the last one also gets the remainder of count % c.
fn spawn_workers(c, port, path, per, extra, collector) {
  if c <= 0 {
    nil
  } else {
    let share = if c == 1 { per + extra } else { per }
    spawn(fn { run_worker(port, path, share, collector) })
    spawn_workers(c - 1, port, path, per, extra, collector)
  }
}

// Collect `remaining` worker reports, tallying (ok . (err . bytes)).
fn collect(remaining, ok, err, bytes) {
  if remaining == 0 {
    cons(ok, cons(err, bytes))
  } else {
    let r = recv()
    let wok = car(r)
    let werr = car(cdr(r))
    let wbytes = cdr(cdr(r))
    collect(remaining - 1, ok + wok, err + werr, bytes + wbytes)
  }
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let path = vm.get_arg(1)
  let n = str.to_int(vm.get_arg(2))
  let c0 = str.to_int(vm.get_arg(3))
  let c = if c0 > 0 { c0 } else { 1 }
  let per = n / c
  let extra = n - per * c
  let me = self()
  let t0 = vm.time_ms()
  spawn_workers(c, port, path, per, extra, me)
  let r = collect(c, 0, 0, 0)
  let t1 = vm.time_ms()
  let ok = car(r)
  let err = car(cdr(r))
  let bytes = cdr(cdr(r))
  let dt = t1 - t0
  let dt1 = if dt > 0 { dt } else { 1 }
  let qps = ok * 1000 / dt1
  let avg = if ok > 0 { dt / ok } else { 0 }
  let mbs = bytes * 1000 / dt1 / 1024 / 1024
  print(str.concat("requests: ", str.concat(str.from_int(n), str.concat("  concurrency: ", str.from_int(c)))))
  print(str.concat("ok: ", str.concat(str.from_int(ok), str.concat("  err: ", str.from_int(err)))))
  print(str.concat("total time: ", str.concat(str.from_int(dt), " ms")))
  print(str.concat("qps: ", str.concat(str.from_int(qps), str.concat("  avg latency: ", str.concat(str.from_int(avg), " ms")))))
  print(str.concat("throughput: ", str.concat(str.from_int(mbs), " MB/s")))
}