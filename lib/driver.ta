// driver.ta — Bootstrap driver with TA import resolution

import tokenizer
import parser
import codegen
import typecheck
import fmt
import buf
import file
import str

fn path_join(dir, name) {
  str.concat(str.concat(dir, "/"), str.concat(name, ".ta"))
}

fn find_last_slash(path, i) {
  if i < 0 { -1 }
  else {
    if str.char_at(path, i) == 47 { i }
    else { find_last_slash(path, i - 1) }
  }
}

fn dirname(path) {
  let idx = find_last_slash(path, str.length(path) - 1)
  if idx < 0 { "." }
  else { str.substr(path, 0, idx) }
}

// === Efficient list operations ===

fn rev_app(lst, acc) {
  if null?(lst) { acc }
  else { rev_app(cdr(lst), cons(car(lst), acc)) }
}

fn reverse(lst) { rev_app(lst, nil) }

// Parse source content using either C reader (vm.parse_source) or TA parser.
// Returns (forms . err): err is nil on success, or an error message string.
fn parse_module_content(content, path, use_ta) {
  let pr = if use_ta == 1 {
    let toks = tokenizer.tokenize(content)
    let err = check_syntax(toks)
    if null?(err) {
      let result = parser.parse(toks)
      let perr = find_parse_error(result)
      if null?(perr) {
        cons(result, nil)
      } else {
        cons(nil, str.concat(str.concat(path, ": "), str.concat("parse error: ", perr)))
      }
    } else {
      cons(nil, str.concat(str.concat(path, ": "), err))
    }
  } else {
    let result = vm.parse_source(content)
    cons(result, nil)
  }
  // Unified top-level form check for both C-reader and TA-parser paths:
  // bare expressions are silently ignored by the typechecker, which used
  // to turn garbage input into an empty no-op program.
  if null?(cdr(pr)) {
    let ferr = check_toplevel_forms(car(pr))
    if null?(ferr) { pr }
    else { cons(nil, str.concat(str.concat(path, ": "), ferr)) }
  } else {
    pr
  }
}

// find_parse_error(forms) -> message string, or nil if the tree is clean.
// The parser embeds a ('parse_error . "msg") marker in the AST when it
// rejects a user-written form (e.g. prefix (and ...) / (or ...)). The
// marker can land at any depth — top-level, a function body, a let value,
// a match arm — so scan the whole tree for it.
fn find_parse_error(forms) {
  if pair?(forms) == false {
    nil
  } else if car(forms) == 'parse_error {
    let msg = cdr(forms)
    if string?(msg) { msg } else { nil }
  } else {
    let fa = find_parse_error(car(forms))
    if null?(fa) { find_parse_error(cdr(forms)) }
    else { fa }
  }
}

// Every top-level form must be a declaration (define/define_pub/type/
// type-sig/import). Anything else — a bare symbol, int, or an expression
// such as `x = 1` or `1 2 3` — parses fine but is silently dropped by the
// typechecker, producing an empty no-op program with exit code 0.
// Returns nil if OK, or an error message string.
fn check_toplevel_forms(forms) {
  match forms {
    nil -> nil
    cons(form, rest) -> {
      if pair?(form) == false {
        "parse error: unexpected top-level expression"
      } else {
        let head = car(form)
        if head == 'define {
          check_define_name(form, rest)
        } else {
          if head == 'define_pub {
            check_define_name(form, rest)
          } else {
            if head == 'import {
              // import requires a module name; `import` alone parses as
              // (import nil) and used to fail silently at resolve time.
              if null?(car(cdr(form))) {
                "parse error: import requires a module name"
              } else {
                check_toplevel_forms(rest)
              }
            } else {
              if head == 'type {
                check_toplevel_forms(rest)
              } else {
                if head == 'type-sig {
                  check_toplevel_forms(rest)
                } else {
                  if head == 'external_fn {
                    // external C module signature declaration (lib/<mod>.ta)
                    check_toplevel_forms(rest)
                  } else {
                    "parse error: unexpected top-level expression"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// A function name must not be a keyword: `fn fn fn` parses the keyword
// `fn` as the function name, producing (define (fn) nil).
fn check_define_name(form, rest) {
  // form = (define (name args) body ...)
  let name_pair = car(cdr(form))
  if pair?(name_pair) {
    let name = car(name_pair)
    if tokenizer.is_kw(str.sym_to_str(name)) == true {
      str.concat("parse error: invalid function name '", str.concat(str.sym_to_str(name), "'"))
    } else {
      check_toplevel_forms(rest)
    }
  } else {
    check_toplevel_forms(rest)
  }
}

// Scan token list for syntax errors before parsing.
// Returns nil if OK, or an error message string.
// Catches: unterminated string literals, unknown characters, and
// unbalanced delimiters — previously these compiled silently into
// garbage bytecode that only failed at runtime (or not at all).
fn check_syntax(toks) {
  scan_tokens(toks, 0, 0, 0, 0)
}

fn scan_tokens(toks, n, paren, brack, brace) {
  if null?(toks) { nil }
  else {
    let tok = car(toks)
    let typ = car(tok)
    let rest = cdr(toks)
    if typ == 'eof {
      // End of input: everything must be balanced.
      if paren > 0 { "parse error: unbalanced '(' — missing ')' at end of file" }
      else {
        if brack > 0 { "parse error: unbalanced '[' — missing ']' at end of file" }
        else {
          if brace > 0 { "parse error: unbalanced '{' — missing '}' at end of file" }
          else { nil }
        }
      }
    } else {
      if typ == 'unterminated {
        str.concat("parse error: unterminated string literal (token ", str.concat(str.from_int(n), ")"))
      } else {
        if typ == 'unknown {
          str.concat("parse error: unexpected character (token ", str.concat(str.from_int(n), ")"))
        } else {
          if typ == 'lparen {
            scan_tokens(rest, n + 1, paren + 1, brack, brace)
          } else {
            if typ == 'rparen {
              if paren > 0 {
                scan_tokens(rest, n + 1, paren - 1, brack, brace)
              } else {
                str.concat("parse error: unbalanced ')' (token ", str.concat(str.from_int(n), ")"))
              }
            } else {
              if typ == 'lbracket {
                scan_tokens(rest, n + 1, paren, brack + 1, brace)
              } else {
                if typ == 'rbracket {
                  if brack > 0 {
                    scan_tokens(rest, n + 1, paren, brack - 1, brace)
                  } else {
                    str.concat("parse error: unbalanced ']' (token ", str.concat(str.from_int(n), ")"))
                  }
                } else {
                  if typ == 'lbrace {
                    scan_tokens(rest, n + 1, paren, brack, brace + 1)
                  } else {
                    if typ == 'rbrace {
                      if brace > 0 {
                        scan_tokens(rest, n + 1, paren, brack, brace - 1)
                      } else {
                        str.concat("parse error: unbalanced '}' (token ", str.concat(str.from_int(n), ")"))
                      }
                    } else {
                      scan_tokens(rest, n + 1, paren, brack, brace)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Build result list in correct order using accumulator (reverse at end).
// Process forms left-to-right, emit to 'acc' in reverse order,
// then reverse at the end.
// Returns (forms . err): err is nil on success, or an error message string
// propagated from a failing module load / parse.
fn resolve_imports(forms, dir, depth, use_ta) {
  if depth > 16 {
    cons(nil, "error: import depth exceeded (circular import?)")
  } else {
    let r = resolve_loop(forms, dir, depth, nil, use_ta)
    let err = cdr(r)
    if null?(err) {
      cons(reverse(car(r)), nil)
    } else {
      cons(nil, err)
    }
  }
}

// resolve_loop processes forms left-to-right, accumulating into 'acc'
// in REVERSE order. Each processed form/group is cons'd onto acc.
// Returns (forms . err): err propagates the first failure, aborting
// the whole resolve (nothing useful can compile after a bad import).
fn resolve_loop(forms, dir, depth, acc, use_ta) {
  if null?(forms) { cons(acc, nil) }
  else {
    let f = car(forms)
    let rest = cdr(forms)
    if pair?(f) {
      let head = car(f)
      if head == 'import {
        let mod_name = car(cdr(f))
        if vm.is_builtin_module(mod_name) {
          // Builtin import: keep as-is
          resolve_loop(rest, dir, depth, cons(f, acc), use_ta)
        } else {
          // Non-builtin: load module, resolve, prepend its forms
          let mr = load_module_ta(mod_name, dir, depth + 1, use_ta)
          let merr = cdr(mr)
          if null?(merr) {
            let new_acc = prepend_rev(car(mr), acc)
            resolve_loop(rest, dir, depth, new_acc, use_ta)
          } else {
            cons(nil, merr)
          }
        }
      } else {
        // Non-import form: keep as-is
        resolve_loop(rest, dir, depth, cons(f, acc), use_ta)
      }
    } else {
      // Non-pair form: keep as-is
      resolve_loop(rest, dir, depth, cons(f, acc), use_ta)
    }
  }
}

// Prepend lst's elements (forward order) onto acc (reverse order accumulator).
// Conses each element of lst from HEAD to TAIL onto acc.
// This puts lst's elements in correct order after final reverse.
fn prepend_rev(lst, acc) {
  if null?(lst) { acc }
  else { prepend_rev(cdr(lst), cons(car(lst), acc)) }
}

// Parse + resolve a module file, converting define_pub to define.
// Returns (forms . err).
fn load_and_resolve(path, content, dir, depth, use_ta) {
  let pr = parse_module_content(content, path, use_ta)
  let err = cdr(pr)
  if null?(err) {
    let rr = resolve_imports(car(pr), dir, depth, use_ta)
    let rerr = cdr(rr)
    if null?(rerr) {
      cons(convert_module_forms(car(rr)), nil)
    } else {
      cons(nil, rerr)
    }
  } else {
    cons(nil, err)
  }
}

// Load a module file, parse it, resolve its imports, and return
// resolved forms with define_pub converted to define.
// Returns (forms . err); module-not-found is reported as an error
// instead of silently yielding nothing.
fn load_module_ta(name, dir, depth, use_ta) {
  let mod_path = path_join(dir, name)
  let content = file.read(mod_path)
  if null?(content) {
    let lib_path = str.concat("lib/", str.concat(name, ".ta"))
    let content2 = file.read(lib_path)
    if null?(content2) {
      cons(nil, str.concat("error: module not found: ", str.concat(name, ".ta")))
    } else {
      load_and_resolve(lib_path, content2, dirname(lib_path), depth, use_ta)
    }
  } else {
    load_and_resolve(mod_path, content, dir, depth, use_ta)
  }
}

// For module-level forms, convert define_pub to define.
fn convert_module_forms(forms) {
  if null?(forms) { nil }
  else {
    let f = car(forms)
    let rest = cdr(forms)
    if pair?(f) {
      let head = car(f)
      if head == 'define_pub {
        cons(cons('define, cdr(f)), convert_module_forms(rest))
      } else {
        cons(f, convert_module_forms(rest))
      }
    } else {
      cons(f, convert_module_forms(rest))
    }
  }
}

// === Compilation pipeline ===

// Type error reporting with source line numbers for the main file.
// Errors inside imported modules fall back to function-name-only messages.
fn report_type_errors(tc, src) {
  let errors = typecheck.get_errors(tc)
  if null?(errors) {
    nil
  } else {
    print(str.concat("typecheck: ", str.concat(str.from_int(typecheck.count_errors(tc)), " type error(s) found")))
    print_tc_errors(errors, src)
  }
}

fn print_tc_errors(errors, src) {
  match errors {
    nil -> nil
    cons(err, rest) -> {
      // err = (kind . (ctx . payload)); kind is 'mismatch or 'undefined
      let kind = car(err)
      let ctx = car(cdr(err))
      // ctx is a symbol (fn name) or nested (ctx . detail) pairs: the chain
      // root is the function name; each cdr is a detail symbol like
      // "arg 2 of helper" describing the failing site, innermost last.
      let name = str.sym_to_str(ctx_root_name(ctx))
      let details = ctx_detail_list(ctx, nil)
      let detail = if null?(details) { nil } else { str.sym_to_str(list_last(details)) }
      let line = find_fn_line(src, name)
      let loc = if line > 0 {
        str.concat("in function '", str.concat(name, str.concat("' (line ", str.concat(str.from_int(line), "): "))))
      } else {
        str.concat("in function '", str.concat(name, "': "))
      }
      if kind == 'mismatch {
        let t1 = car(cdr(cdr(err)))
        let t2 = car(cdr(cdr(cdr(err))))
        let msg = str.concat("cannot unify ", str.concat(typecheck.type_format(t1, nil), str.concat(" with ", typecheck.type_format(t2, nil))))
        let full = if null?(detail) { msg } else { str.concat(detail, str.concat(": ", msg)) }
        print(str.concat("  [E0001] ", str.concat(loc, full)))
        // Locate the failing call line inside the function body (heuristic:
        // last occurrence of the called name) and print the source snippet.
        if null?(detail) {
          nil
        } else {
          let site = find_call_site(src, name, detail_head(detail))
          if null?(site) {
            nil
          } else {
            print(str.concat("           line ", str.concat(str.from_int(car(site)), str.concat(": >>> ", cdr(site)))))
          }
        }
      } else {
        let uname = str.sym_to_str(car(cdr(cdr(err))))
        print(str.concat("  [E0002] ", str.concat(loc, str.concat("undefined function '", str.concat(uname, "'")))))
      }
      print_tc_errors(rest, src)
    }
  }
}

// Walk the (ctx . detail) pair chain to the root function-name symbol.
fn ctx_root_name(ctx) {
  if pair?(ctx) { ctx_root_name(car(ctx)) } else { ctx }
}

// Collect detail symbols from the ctx chain, outermost first.
fn ctx_detail_list(ctx, acc) {
  if pair?(ctx) { ctx_detail_list(car(ctx), cons(cdr(ctx), acc)) } else { acc }
}

fn list_last(lst) {
  if null?(cdr(lst)) { car(lst) } else { list_last(cdr(lst)) }
}

// Extract the called name from a detail like "arg 2 of helper".
fn detail_head(detail) {
  let idx = str.index_of(detail, " of ")
  if idx < 0 { detail }
  else { str.substr(detail, idx + 4, str.length(detail) - idx - 4) }
}

// Locate the line of the failing call within `fn name`'s body. Heuristic:
// the last occurrence of "<head>(" in the body is usually the violating
// call (earlier uses establish the type, later ones break it). Returns
// (line_no . line_text) or nil when not found (e.g. imported module).
fn find_call_site(src, name, head) {
  let fn_off = str.index_of(src, str.concat("fn ", name))
  if fn_off < 0 {
    nil
  } else {
    let tail = str.substr(src, fn_off, str.length(src) - fn_off)
    let open = str.index_of(tail, "{")
    if open < 0 {
      nil
    } else {
      let body_start = fn_off + open
      let body_end = match_brace(src, body_start + 1, 1)
      let body = str.substr(src, body_start, body_end - body_start)
      let pat = str.concat(head, "(")
      let hit = last_index_of(body, pat, str.length(body) - 1)
      if hit < 0 {
        nil
      } else {
        let abs = body_start + hit
        cons(1 + count_newlines(src, 0, abs), line_at(src, abs))
      }
    }
  }
}

// Last occurrence of `needle` in `s` at or before position `i`.
fn last_index_of(s, needle, i) {
  if i < 0 {
    -1
  } else {
    let idx = str.index_of(str.substr(s, i, str.length(s) - i), needle)
    if idx == 0 {
      i
    } else {
      if idx > 0 {
        i + idx
      } else {
        last_index_of(s, needle, i - 1)
      }
    }
  }
}

// Match braces from an open brace; returns offset just past the closing.
fn match_brace(src, i, depth) {
  if depth == 0 {
    i
  } else {
    if i >= str.length(src) {
      i
    } else {
      let c = str.char_at(src, i)
      if c == 123 {
        match_brace(src, i + 1, depth + 1)
      } else {
        if c == 125 {
          match_brace(src, i + 1, depth - 1)
        } else {
          match_brace(src, i + 1, depth)
        }
      }
    }
  }
}

// Extract the line of text containing offset `i`.
fn line_at(src, i) {
  let start = line_start(src, i)
  let end = line_end(src, i)
  str.substr(src, start, end - start)
}

fn line_start(src, i) {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == 10 {
      i
    } else {
      line_start(src, i - 1)
    }
  }
}

fn line_end(src, i) {
  if i >= str.length(src) {
    str.length(src)
  } else {
    if str.char_at(src, i) == 10 {
      i
    } else {
      line_end(src, i + 1)
    }
  }
}

// Find the source line where `fn <name>` is defined; 0 when not found
// (e.g. the function lives in an imported module).
fn find_fn_line(src, name) {
  let idx = str.index_of(src, str.concat("fn ", name))
  if idx < 0 { 0 }
  else { 1 + count_newlines(src, 0, idx) }
}

fn count_newlines(src, i, limit) {
  if i >= limit { 0 }
  else {
    if str.char_at(src, i) == 10 { 1 + count_newlines(src, i + 1, limit) }
    else { count_newlines(src, i + 1, limit) }
  }
}

// Returns (forms . err): err is nil on success, or an error message string
// (parse error / module error / unreadable file).
fn load_source_ta(path, use_ta) {
  let src = file.read(path)
  if null?(src) {
    cons(nil, str.concat("error: cannot read file: ", path))
  } else {
    let pr = parse_module_content(src, path, use_ta)
    let err = cdr(pr)
    if null?(err) {
      resolve_imports(car(pr), dirname(path), 0, use_ta)
    } else {
      cons(nil, err)
    }
  }
}

fn compile_and_run(bc) {
  let top_fn = vm.load_bytecode(bc)
  if top_fn < 0 {
    print("ERROR: load_bytecode failed")
  } else {
    let pid = vm.spawn(top_fn)
    let ref = monitor(pid)
    let msg = recv()
    match msg {
      [DOWN, r, p, reason] -> 'ok
    }
  }
}

pub fn compile_file(path, use_ta) {
  let lr = load_source_ta(path, use_ta)
  let err = cdr(lr)
  if null?(err) {
    let ast = car(lr)
    let tc = typecheck.infer_program(ast)
    report_type_errors(tc, file.read(path))
    let bc = codegen.compile(ast)
    compile_and_run(bc)
  } else {
    print(err)
  }
}

pub fn compile_file_skip_check(path, use_ta) {
  let lr = load_source_ta(path, use_ta)
  let err = cdr(lr)
  if null?(err) {
    let ast = car(lr)
    let bc = codegen.compile(ast)
    let top_fn = vm.load_bytecode(bc)
    if top_fn < 0 {
      print("ERROR: load_bytecode failed")
    } else {
      let pid = vm.spawn(top_fn)
      let ref = monitor(pid)
      let msg = recv()
      match msg {
        [DOWN, r, p, reason] -> 'ok
      }
    }
  } else {
    print(err)
  }
}

pub fn compile_file_to_tabc(source_path, out_path, use_ta) {
  let lr = load_source_ta(source_path, use_ta)
  let err = cdr(lr)
  if null?(err) {
    let ast = car(lr)
    let tc = typecheck.infer_program(ast)
    report_type_errors(tc, file.read(source_path))
    let n = typecheck.count_errors(tc)
    if n > 0 {
      print(str.concat("compile aborted: ", str.concat(str.from_int(n), " type error(s)")))
    } else {
      codegen.compile_and_write(ast, out_path)
    }
  } else {
    print(err)
  }
}

// fmt subcommand: `tinyactor fmt <file.ta>` formats in place,
// `tinyactor fmt --check <file.ta>` reports files that differ.
fn fmt_file(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  file.write(path, out)
}

fn fmt_check(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  if out == src {
    print(str.concat("ok: ", path))
  } else {
    print(str.concat("diff: ", path))
  }
}

fn main() {
  let arg0 = vm.get_arg(0)
  let arg1 = vm.get_arg(1)
  if arg0 == "fmt" {
    if arg1 == "--check" {
      fmt_check(vm.get_arg(2))
    } else {
      fmt_file(arg1)
    }
  } else {
    let path = arg0
    let arg2 = arg1
    if arg2 == "--no-check" {
      compile_file_skip_check(path, 1)
    } else {
      if str.length(arg2) > 0 {
        compile_file_to_tabc(path, arg2, 1)
      } else {
        compile_file(path, 1)
      }
    }
  }

}
