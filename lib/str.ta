// str module: string utilities — signature layer over the C dylib.
//
// C implementation: lib/str.c — a lazy dylib (lib/str.dylib), loaded on
// first reference to a str.* symbol (buffer-module convention, see
// lib/encoding.c). vm_load_self registers the primitives under the full
// dotted names (str.char_at, str.split, ...), NOT eagerly at startup:
// because the dylib loads lazily — after compile-time import resolution
// — `import str` loads this TA layer.
//
// Two tiers, deliberately split:
//   * Low-level primitives (char_at, chr, length, substr, concat, to_int,
//     from_int, eq, index_of, to_sym, sym_to_str): compiler-promised
//     builtins (typecheck.ta seeds precise types for them), so they are
//     always available WITHOUT `import str` and are deliberately NOT
//     redeclared here — an external-fn signature would shadow the precise
//     promise type with a permissive one.
//   * Upper functions (the list below): declared here via `external fn`.
//     They require `import str`. Parameter/return types follow the C
//     implementation (lib/str.c header + bodies) and the existing test
//     corpus — stdlib is the type-sample users copy, so these are as
//     precise as a bare HM signature can be. Where a value has no TA
//     type (C opaque handles, pair cells) or a parameter is legitimately
//     multi-typed (from_float widens Int|Float), that slot stays a tvar.

external fn str.split(s : String, sep : String) -> List(String)
// pairs returns a list of (key . value) pair cells; TA has no Pair type
// (D15), and the cell is consumed positionally via car/cdr. Inputs typed.
external fn str.pairs(s : String, line_sep : String, kv_sep : String) -> a
external fn str.join(lst : List(String), sep : String) -> String
external fn str.trim(s : String) -> String
external fn str.replace(s : String, old : String, new : String) -> String
external fn str.upper(s : String) -> String
external fn str.lower(s : String) -> String
external fn str.pad_start(s : String, n : Int, ch : Int) -> String
external fn str.pad_end(s : String, n : Int, ch : Int) -> String
external fn str.parse_float(s : String) -> option.Option(Float)
// from_float accepts Int (widened) as well as Float; no TA union type.
external fn str.from_float(f) -> String
external fn str.from_base(s : String, base : Int) -> Int
external fn str.to_base(n : Int, base : Int) -> String
external fn str.index_of_char(s : String, i : Int, c : Int) -> Int
external fn str.index_of_ctrl(s : String, i : Int) -> Int
external fn str.cmp(a : String, b : String) -> Int
