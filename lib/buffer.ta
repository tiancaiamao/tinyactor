// buffer module: mutable byte buffer.
//
// C implementation: lib/buffer.c (lazily dlopen'd on first call) — the
// first module on the opaque Resource value (docs/c-resource-design.md):
// the payload is the buffer state, the per-holder heap header carries
// ownership, and release has four paths (close / GC / actor death / VM
// teardown) so a forgotten close never leaks.
//
// The constructor wraps the C-owned payload in a value the typechecker
// treats as a capability: forging a raw value is a type error, so the C
// side never validates tags, only liveness and ownership. Every
// operation lifts the C signals:
//   -1 -> Err("closed")   (released, or not a resource)
//   -2 -> Err("not owner") (the buffer was sent to another actor; this
//                           copy is stale — ownership moved with it)
// push_byte/slice additionally lift out-of-range arguments to
// Err("range") before the C call, so -1 from the C side always really
// means "closed".
//
//   new()                -> Ok(Buffer); infallible (a resource is just a
//                           malloc — OOM aborts like every heap
//                           constructor), kept as Result so the API
//                           shape is unchanged
//   push_str(b, s)       -> Ok(new length)
//   push_byte(b, n)      -> Ok(new length); n must be 0..255
//   to_string(b)         -> Ok(snapshot); the buffer is NOT consumed
//   slice(b, start, end) -> Ok(substring [start, end)); indices are
//                           codepoints — v1 strings are byte arrays and
//                           codepoint == byte (ASCII scope, same
//                           convention as lib/str.c); start == end is
//                           Ok("")
//   close(b)             -> Ok(1); idempotent (double close is Ok(1))
//   length(b)            -> Ok(length)
//
// Sharing: a Buffer crosses actors only by send, which transfers
// ownership — the sender's copy then reports Err("not owner") and the
// receiver's works (test/actor/resource-handoff covers the handoff).
//
import result

type Buffer {
  Buf(Resource)
}

external fn buffer.raw_new() -> Resource
external fn buffer.raw_push_str(h, s) -> Int
external fn buffer.raw_push_byte(h, n) -> Int
external fn buffer.raw_to_string(h) -> a
external fn buffer.raw_slice(h, start, end) -> a
external fn buffer.raw_close(h) -> Int
external fn buffer.raw_length(h) -> Int

// lift_int: C int-status -> Result. -1 = closed (released or invalid),
// -2 = not owner (sent away; this copy is stale).
fn lift_int(r) {
  if r == -2 {
    Err("not owner")
  } else {
    if r < 0 {
      Err("closed")
    } else {
      Ok(r)
    }
  }
}

// lift_str: for the dual-return externals (String on success, negative
// Int signal on failure; the `a` return type keeps that honest).
fn lift_str(r) {
  if string?(r) {
    Ok(r)
  } else {
    if r == -2 {
      Err("not owner")
    } else {
      Err("closed")
    }
  }
}

// new: allocate a buffer. Resources are unbounded (no table), so this
// cannot fail; the Result shape stays for API stability.
pub fn new() {
  Ok(Buf(buffer.raw_new()))
}

pub fn push_str(b : Buffer, s : String) {
  match b {
    Buf(h) -> lift_int(buffer.raw_push_str(h, s))
  }
}

pub fn push_byte(b : Buffer, n : Int) {
  match b {
    Buf(h) ->
    if n < 0 || n > 255 {
      Err("range")
    } else {
      lift_int(buffer.raw_push_byte(h, n))
    }
  }
}

pub fn to_string(b : Buffer) {
  match b {
    Buf(h) -> lift_str(buffer.raw_to_string(h))
  }
}

// Bounds are checked here (against a lifted length) so Err from the C
// side is unambiguous; a bad range never reaches C.
pub fn slice(b : Buffer, start : Int, end : Int) {
  match b {
    Buf(h) ->
    match lift_int(buffer.raw_length(h)) {
      Ok(len) ->
      if start < 0 || end > len || start > end {
        Err("range")
      } else {
        lift_str(buffer.raw_slice(h, start, end))
      }
      Err(e) -> Err(e)
    }
  }
}

pub fn close(b : Buffer) {
  match b {
    Buf(h) -> lift_int(buffer.raw_close(h))
  }
}

pub fn length(b : Buffer) {
  match b {
    Buf(h) -> lift_int(buffer.raw_length(h))
  }
}
