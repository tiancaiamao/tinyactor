// typecheck.ta — Self-hosted Hindley-Milner type checker for TinyActor
//
// Inspired by Cora's infer.cora. Pure functional, no mutable state.
//
// Type representation — two ADTs, destructured only by exhaustive match:
//   type Base { BInt BFloat BBool BString BNil BNever BSymbol BPair BPid
//               BName(name) }  — base types; BName holds every other
//                                named type (user ADTs such as Option)
//   type Ty {
//     TyBase(b)         — base type
//     TyVar(id, level)  — type variable (id is an integer; level is the
//                         let-generalization level — see generalize_l)
//     TyArrow(from, to) — function type from -> to (curried)
//     TyApp(name, args) — type application, e.g. List(int), Option('a)
//     TyForall(ids, body) — universally quantified type
//   }
//
// Type scheme (for polymorphism):
//   TyForall(ids, body) — universally quantified type
//
// Substitution: 32 buckets of TvBind(id, ty) + 已收集的诊断（type Subst）
// Environment: a list of EnvEntry — Bind / Ctor / TypeDecl / ArityTable
//
// Every intermediate value this file passes around is a declared record
// (§ each section), never a bare pair: a pair's slots carry no name and no
// type, so `car`/`cdr` at the use site is a guess, and two unrelated
// meanings (`(name . ty)` vs `(ty . counter)`) end up sharing one shape.
// A homogeneous list of a declared type stays a plain cons list.
//
// All state (counter, subst, env) is threaded through function parameters.
//
// Source tree: every function that reads a node takes `form.Form` (a list
// takes `List(form.Form)`) and destructures it with an exhaustive match —
// no `pair?`/`int?`/`symbol?` guessing left on this side (M4).

import "tinyactor:lib/bootstrap/ast" as ast
import "tinyactor:lib/bootstrap/form"
import "tinyactor:lib/list" as list
import "tinyactor:lib/option"

// ============================================================
// List utilities
// ============================================================

// list_union(a, b) — a's elements that are absent from b, in a's order,
// followed by b. This is the *type-variable set* union used by
// free_vars_env / find_generalizable: b's duplicates are not re-filtered
// and the tail is shared, so it is a set policy for that job rather than
// a general list operation (lib/list.ta deliberately has no such fn).
fn list_union(a, b) {
  match a {
    nil -> b
    cons(h, rest) -> {
      if list.member(h, b) {
        list_union(rest, b)
      } else {
        cons(h, list_union(rest, b))
      }
    }
  }
}

// ============================================================
// Type representation (ADT declarations) and constructors
// ============================================================

type Base {
  BInt BFloat BBool BString BNil BNever BSymbol BPair BPid
  BName(name : Symbol) // user ADT names (Option/P2...), unknown named types
}

type Ty {
  TyBase(b : Base)
  TyVar(id : Int, level : Int)
  TyArrow(from : Ty, to : Ty)
  TyApp(name : Symbol, args : List(Ty))
  TyForall(ids : List(Int), body : Ty)
}

fn t_int() -> Ty { TyBase(BInt) }
fn t_float() -> Ty { TyBase(BFloat) }
fn t_bool() -> Ty { TyBase(BBool) }
fn t_string() -> Ty { TyBase(BString) }
// t_never(): the bottom type of a divergent expression (x / 0). It unifies
// with every type and never constrains it — see unify_resolved.
fn t_never() -> Ty { TyBase(BNever) }
fn t_symbol() -> Ty { TyBase(BSymbol) }
fn t_nil() -> Ty { TyBase(BNil) }
fn t_pair() -> Ty { TyBase(BPair) }

// base_of_sym(name : Symbol) -> Base: symbol -> Base. The 9 builtins get
// dedicated variants; anything else (user ADT names, malformed input)
// falls to BName — the only place the builtin symbol table survives.
fn base_of_sym(name : Symbol) -> Base {
  if name == 'Int { BInt }
  else if name == 'Float { BFloat }
  else if name == 'Bool { BBool }
  else if name == 'String { BString }
  else if name == 'Nil { BNil }
  else if name == 'Never { BNever }
  else if name == 'Symbol { BSymbol }
  else if name == 'Pair { BPair }
  else if name == 'Pid { BPid }
  else { BName(name) }
}

// base_name(b : Base) -> Symbol: inverse of base_of_sym, for printing and
// error messages. Total (issue #208): BName may hold a garbage name.
fn base_name(b : Base) -> Symbol {
  match b {
    BInt -> 'Int
    BFloat -> 'Float
    BBool -> 'Bool
    BString -> 'String
    BNil -> 'Nil
    BNever -> 'Never
    BSymbol -> 'Symbol
    BPair -> 'Pair
    BPid -> 'Pid
    BName(name) -> name
  }
}

// ty_name(t : Ty) -> Symbol: the type's "name" — TyBase -> base name,
// TyApp -> application name, anything else -> nil. Single source of truth
// for the head-name chain, used by ctor_result_name_walk and
// check_exhaustive (it used to be copied in both).
fn ty_name(t : Ty) -> Symbol {
  match t {
    TyBase(b) -> base_name(b)
    TyApp(name, _) -> name
    _ -> nil
  }
}

fn t_base(name : Symbol) -> Ty { TyBase(base_of_sym(name)) }

fn t_var(id : Int, level : Int) -> Ty { TyVar(id, level) }

// tvar_id(t) -> Int: the id of a type variable. Only meaningful for the
// TyVar values this file builds (fresh / t_var); any other shape is a bug,
// so it answers -1 rather than fabricating an id.
fn tvar_id(t : Ty) -> Int {
  match t {
    TyVar(id, _) -> id
    _ -> -1
  }
}

fn t_arrow(from : Ty, to : Ty) -> Ty { TyArrow(from, to) }

// Type application: TyApp(name, args) — e.g. List(int), Option('a)
fn t_app(name : Symbol, args : List(Ty)) -> Ty { TyApp(name, args) }

// Type scheme: TyForall(ids, body)
fn t_forall(ids : List(Int), t : Ty) -> Ty { TyForall(ids, t) }

// ============================================================
// 推断状态：Subst = 替换表 + 到目前为止的诊断
//
// 替换表是 32 个桶的链，每桶一条 TvBind 的 assoc 表 —— 查找代价
// O(32 + S/32) 而不是平表的 O(S)。替换表只增不减，长推断里线性扫描是主要
// 开销，所以桶这一层保留。
//
// 诊断不再挤进同一张表（旧实现让 'tc_error 这类**符号键**混进 int 键的绑定
// 表，靠 key 的类型区分两种含义）。两者的生命期相同、永远同路传，于是装进
// 同一个 record：表里只有 int 键，诊断只走 errors 那条链，最新的在前。
// ============================================================

// TvBind — 一个类型变量的绑定（inst_walk 的 old_id → new_ty 映射也是它）。
type TvBind { TvBind(id : Int, ty : Ty) }

// TcError — 一条待渲染的类型诊断。每个变体自带渲染所需的全部字段，报告侧
// 按变体取值，不再从嵌套点对里数 car/cdr。
//
// ctx 是「出错位置的上下文链」：链首是函数名，其后逐层追加失败点的说明
// （`arg 2 of foo`、`field num of R`…），报告侧取 car 作函数名、取最后一层
// 说明作明细。
type TcError {
  TcMismatch(ctx : List(Symbol), t1 : Ty, t2 : Ty)
  TcUndefinedVar(name : Symbol, ctx : List(Symbol))
  TcUndefinedFn(name : Symbol, ctx : List(Symbol))
  TcArity(ctx : List(Symbol), name : Symbol, got : Int, want : Int)
  TcNotExported(ctx : List(Symbol), name : Symbol, mod : Symbol)
  TcNoExport(ctx : List(Symbol), name : Symbol, mod : Symbol)
  TcBareMember(ctx : List(Symbol), name : Symbol, mod : Symbol)
  TcDuplicate(name : Symbol)
  TcLabelUnknown(ctx : List(Symbol), ctor : Symbol, label : Symbol)
  TcLabelDuplicate(ctx : List(Symbol), ctor : Symbol, label : Symbol)
  TcLabelMissing(ctx : List(Symbol), ctor : Symbol, label : Symbol)
  TcLabelNoFields(ctx : List(Symbol), ctor : Symbol)
  TcNonExh(ctx : List(Symbol), tname : Symbol, missing : List(Symbol))
  TcNonExhPartial(ctx : List(Symbol), tname : Symbol, partial : List(Symbol))
  TcUnknownCtor(ctx : List(Symbol), tname : Symbol, name : Symbol)
}

type Subst { Subst(buckets : List(List(TvBind)), errors : List(TcError)) }

fn subst_buckets(s : Subst) -> List(List(TvBind)) {
  match s {
    Subst(buckets, _) -> buckets
  }
}

fn subst_errors(s : Subst) -> List(TcError) {
  match s {
    Subst(_, errors) -> errors
  }
}

// ctx_push(ctx, detail) — 上下文链末尾追加一层说明（链首是函数名）。
fn ctx_push(ctx : List(Symbol), detail : Symbol) -> List(Symbol) {
  if null?(ctx) {
    cons(detail, nil)
  } else {
    cons(car(ctx), ctx_push(cdr(ctx), detail))
  }
}

// add_error(s, e) — 记下一条诊断（最新的在前，报告顺序即构造顺序的逆序）。
fn add_error(s : Subst, e : TcError) -> Subst {
  Subst(subst_buckets(s), cons(e, subst_errors(s)))
}

// empty_subst() — 空替换（32 桶）。唯一的「从零开始」入口。
pub fn empty_subst() -> Subst { Subst(make_buckets(32), nil) }

fn make_buckets(n : Int) -> List(List(TvBind)) {
  if n == 0 { nil }
  else { cons(nil, make_buckets(n - 1)) }
}

// bucket_index(id) — 一个 tvar id 落在哪个桶。
fn bucket_index(id : Int) -> Int { id % 32 }

fn bucket_ref(buckets : List(List(TvBind)), i : Int) -> List(TvBind) {
  match buckets {
    nil -> nil
    cons(b, rest) -> if i == 0 { b } else { bucket_ref(rest, i - 1) }
  }
}

fn bucket_set(buckets : List(List(TvBind)), i : Int, b : List(TvBind)) -> List(List(TvBind)) {
  match buckets {
    nil -> nil
    cons(h, rest) -> cons(if i == 0 { b } else { h }, bucket_set(rest, i - 1, b))
  }
}

// tv_find(binds, id) — 平坦绑定表里的查找（桶内、inst_walk 的映射都用它）。
fn tv_find(binds : List(TvBind), id : Int) -> option.Option(Ty) {
  match binds {
    nil -> option.None
    cons(b, rest) -> {
      match b {
        TvBind(k, v) -> if k == id { option.Some(v) } else { tv_find(rest, id) }
      }
    }
  }
}

// tv_get(s, id) — 该 tvar 的绑定，未绑定为 None。
fn tv_get(s : Subst, id : Int) -> option.Option(Ty) {
  tv_find(bucket_ref(subst_buckets(s), bucket_index(id)), id)
}

// tv_put(s, id, t) — 绑定一个 tvar。
fn tv_put(s : Subst, id : Int, t : Ty) -> Subst {
  let buckets = subst_buckets(s)
  let i = bucket_index(id)
  Subst(bucket_set(buckets, i, cons(TvBind(id, t), bucket_ref(buckets, i))), subst_errors(s))
}

// Fresh — 「一个新的类型变量 + 下一个计数器」：fresh / instantiate 的产出。
type Fresh { Fresh(ty : Ty, counter : Int) }

fn fresh_ty(f : Fresh) -> Ty { match f { Fresh(t, _) -> t } }

fn fresh_counter(f : Fresh) -> Int { match f { Fresh(_, counter) -> counter } }

// fresh(counter, level) -> Fresh
fn fresh(counter : Int, level : Int) -> Fresh {
  Fresh(t_var(counter, level), counter + 1)
}

// ============================================================
// 环境：EnvEntry
//
// env 是一层压一层的表：局部绑定压在上面，`ArityTable` 标出全局区那一层的
// 起点，下面是顶层定义与内建。一条条目是哪种东西由变体说清楚 —— 构造函数
// 条目不必再包一层 ('ctor . scheme)，类型名条目也不必和变体表混在同一个
// 4 元素表里。
// ============================================================

// LabelSlot — 一个字段标签在构造子里的槽位（1 基；tuple 的 slot 0 是构造子
// 标签本身，所以标签从 1 开始）。
type LabelSlot { LabelSlot(label : Symbol, slot : Int) }

// VariantTable — 一个变体的标签形状：名字、字段数、有名字的字段。
// 字段数与标签表不冗余：声明可以只给部分字段起名（`P(int, y : int)`）。
type VariantTable { VariantTable(name : Symbol, arity : Int, labels : List(LabelSlot)) }

pub fn vt_name(t : VariantTable) -> Symbol { match t { VariantTable(name, _, _) -> name } }
pub fn vt_arity(t : VariantTable) -> Int { match t { VariantTable(_, arity, _) -> arity } }
pub fn vt_labels(t : VariantTable) -> List(LabelSlot) { match t { VariantTable(_, _, labels) -> labels } }

// vt_find(name, tables) — 按构造器名在 ctor_label_tables 的平列表里反查它那一行。
pub fn vt_find(name : Symbol, tables : List(VariantTable)) -> option.Option(VariantTable) {
  match tables {
    nil -> option.None
    cons(t, rest) -> if vt_name(t) == name { option.Some(t) } else { vt_find(name, rest) }
  }
}

// Arity — 顶层函数/构造子的元数（局部元数表里的一条）。
type Arity { Arity(name : Symbol, nargs : Int) }

// EnvEntry — 环境里的一条。
type EnvEntry {
  Bind(name : Symbol, scheme : Ty)
  Ctor(name : Symbol, scheme : Ty)
  TypeDecl(name : Symbol, variants : List(Symbol), fields : List(VariantTable))
  ArityTable(entries : List(Arity))
}

fn entry_name(e : EnvEntry) -> Symbol {
  match e {
    Bind(name, _) -> name
    Ctor(name, _) -> name
    TypeDecl(name, _, _) -> name
    ArityTable(_) -> nil
  }
}

// entry_scheme(e) — 名字位置取到的 scheme。只有 Bind / Ctor 有 scheme；类型
// 名出现在表达式位置时既不是值也不是函数，给底部类型（与任何期望类型相容且
// 不绑定任何一边，与 Atom/bottom 同一条规则）。
fn entry_scheme(e : EnvEntry) -> Ty {
  match e {
    Bind(_, scheme) -> scheme
    Ctor(_, scheme) -> scheme
    TypeDecl(_, _, _) -> t_never()
    ArityTable(_) -> t_never()
  }
}

// entry_variants(e) — TypeDecl 条目声明的变体名；其它条目形态没有变体表。
fn entry_variants(e : EnvEntry) -> List(Symbol) {
  match e {
    TypeDecl(_, variants, _) -> variants
    _ -> nil
  }
}

// entry_fields(e) — TypeDecl 条目的变体字段表；其它条目形态给 nil。
fn entry_fields(e : EnvEntry) -> List(VariantTable) {
  match e {
    TypeDecl(_, _, fields) -> fields
    _ -> nil
  }
}

// env_find(env, name) — 该名字对应的条目（最近的绑定优先），未绑定为 None。
pub fn env_find(env : List(EnvEntry), name : Symbol) -> option.Option(EnvEntry) {
  match env {
    nil -> option.None
    cons(e, rest) -> if entry_name(e) == name { option.Some(e) }
    else { env_find(rest, name) }
  }
}

fn extend(env : List(EnvEntry), name : Symbol, typ : Ty) -> List(EnvEntry) {
  cons(Bind(name, typ), env)
}

// extend_global(env, name, typ) — add a top-level (non-local) binding while
// keeping the local arity table at the head, so the env keeps the shape
//
//   [locals...] [arity table] [globals...] [builtins...]
//
// locally_bound reads that shape: a binding met above the table is a param /
// let / match binder, one below it is a top-level define or builtin. Globals
// are added while walking the top-level forms, i.e. after the table was
// planted, so they must go *under* it — plain extend would put them above and
// every same-named local would then look global.
fn extend_global(env : List(EnvEntry), e : EnvEntry) -> List(EnvEntry) {
  match env {
    cons(ArityTable(_), rest) -> cons(car(env), cons(e, rest))
    _ -> cons(e, env)
  }
}

// arity_of(entries, name) — 元数表里查一个名字的元数，未登记为 None。
fn arity_of(entries : List(Arity), name : Symbol) -> option.Option(Int) {
  match entries {
    nil -> option.None
    cons(a, rest) -> {
      match a {
        Arity(n, nargs) -> if n == name { option.Some(nargs) } else { arity_of(rest, name) }
      }
    }
  }
}

// ============================================================
// apply_subst: resolve type variables through substitution
// ============================================================

fn apply_subst(t : Ty, s : Subst) -> Ty {
  match t {
    TyVar(id, _) -> {
      match tv_get(s, id) {
        option.Some(bound) -> apply_subst(bound, s)
        option.None -> t
      }
    }
    TyArrow(from, to) -> t_arrow(apply_subst(from, s), apply_subst(to, s))
    TyApp(name, args) -> t_app(name, apply_subst_list(args, s))
    _ -> t // base, forall or unknown — leave as-is
  }
}

fn apply_subst_list(ts : List(Ty), s : Subst) -> List(Ty) {
  match ts {
    nil -> nil
    cons(h, rest) -> cons(apply_subst(h, s), apply_subst_list(rest, s))
  }
}

// resolve_head: resolve a type's head through the substitution chain without
// rebuilding the whole tree. Used by unify/occur_check for lazy resolution —
// only the head matters for pattern-matching on the type tag; subtrees get
// resolved on demand when recursing. This avoids O(tree-size) apply_subst
// on every unification (the main typecheck bottleneck).
fn resolve_head(t : Ty, s : Subst) -> Ty {
  match t {
    TyVar(id, _) -> {
      match tv_get(s, id) {
        option.Some(bound) -> resolve_head(bound, s)
        option.None -> t
      }
    }
    _ -> t
  }
}

// ============================================================
// occur_check: prevent infinite types
// ============================================================

fn occur_check(vid : Int, t : Ty, s : Subst) -> Bool {
  match resolve_head(t, s) {
    TyVar(id, _) -> id == vid
    TyArrow(from, to) -> {
      // arrow
      if occur_check(vid, from, s) {
        true
      } else {
        occur_check(vid, to, s)
      }
    }
    TyApp(_, args) -> occur_check_list(vid, args, s)
    _ -> false // base, forall or unknown
  }
}

fn occur_check_list(vid : Int, ts : List(Ty), s : Subst) -> Bool {
  match ts {
    nil -> false
    cons(h, rest) -> {
      if occur_check(vid, h, s) { true }
      else { occur_check_list(vid, rest, s) }
    }
  }
}

// ============================================================
// unify: Robinson unification
// ============================================================

// Unified — 一次合一的结果。成功带新替换；失败带原因（'mismatch / 'arity /
// 'occur）与**未变的**替换：调用方一律只要替换，原因只用来成诊断。
type Unified {
  UnifiedOk(s : Subst)
  UnifiedFail(reason : Symbol, s : Subst)
}

fn unified_ok(u : Unified) -> Bool {
  match u {
    UnifiedOk(_) -> true
    UnifiedFail(_, _) -> false
  }
}

fn unified_s(u : Unified) -> Subst {
  match u {
    UnifiedOk(s) -> s
    UnifiedFail(_, s) -> s
  }
}

// unify(t1, t2, s) -> Unified
fn unify(x : Ty, y : Ty, s : Subst) -> Unified {
  let xr = resolve_head(x, s)
  let yr = resolve_head(y, s)
  unify_resolved(xr, yr, s)
}

// is_never(t) — true for the bottom type (TyBase(BNever)).
fn is_never(t : Ty) -> Bool {
  match t {
    TyBase(BNever) -> true
    _ -> false
  }
}

// is_atom_ty(t) -> 1 for the dynamic type `Atom`.
// Atom 是语言里唯一的「我不知道类型」标注（docs/ta-language-spec.md
// 「动态逃逸」）：它和一切类型相容且**不绑定**任何一边，所以通过了 Atom 的
// 值既不会把自己的类型传给对方，也就不会在别处被当成那个类型用。它是给
// 「同一位置本来就装多种东西」的形状用的 —— 全仓唯一必需的站点是 form 层
// 的裸原子桥（ast.const_atom：nil/bool/int/symbol/string/('float text) 六
// 种并存，见该函数注释）。#442 把 match binder 接到构造子字段类型上之后，
// 这类函数不再能靠「binder 不承重」蒙混过去，必须把类型如实写出来。
fn is_atom_ty(t : Ty) -> Int {
  match t {
    TyBase(BName(name)) -> if name == 'Atom { 1 } else { 0 }
    _ -> 0
  }
}

fn unify_resolved(x : Ty, y : Ty, s : Subst) -> Unified {
  if is_never(x) || is_never(y) {
    // Bottom is a subtype of everything: unifying it binds nothing, so a
    // divergent expression (x / 0) fits any expected type while leaving
    // the other side untouched — a crash arm must not pin down the type
    // of the match/function around it (#219).
    UnifiedOk(s)
  } else if is_atom_ty(x) == 1 || is_atom_ty(y) == 1 {
    // Atom: same "binds nothing" rule as bottom, but from the other end —
    // it accepts any value without claiming to be that type.
    UnifiedOk(s)
  } else {
    unify_resolved_non_bottom(x, y, s)
  }
}

// unify_resolved_non_bottom: the ordinary structural cases, with bottom
// already handled by the caller.
fn unify_resolved_non_bottom(x : Ty, y : Ty, s : Subst) -> Unified {
  match x {
    TyVar(xid, _) -> {
      match y {
        TyVar(yid, _) -> {
          if xid == yid {
            UnifiedOk(s)
          } else {
            UnifiedOk(tv_put(s, xid, y))
          }
        }
        _ -> {
          if occur_check(xid, y, s) {
            UnifiedFail('occur, s)
          } else {
            UnifiedOk(tv_put(s, xid, y))
          }
        }
      }
    }
    _ -> {
      match y {
        TyVar(yid, _) -> {
          if occur_check(yid, x, s) {
            UnifiedFail('occur, s)
          } else {
            UnifiedOk(tv_put(s, yid, x))
          }
        }
        _ -> {
          match x {
            TyBase(bx) -> {
              match y {
                TyBase(by) -> {
                  if base_name(bx) == base_name(by) {
                    UnifiedOk(s)
                  } else {
                    UnifiedFail('mismatch, s)
                  }
                }
                _ -> UnifiedFail('mismatch, s)
              }
            }
            TyArrow(xa, xb) -> {
              match y {
                TyArrow(ya, yb) -> {
                  let r1 = unify(xa, ya, s)
                  if unified_ok(r1) {
                    unify(xb, yb, unified_s(r1))
                  } else {
                    r1
                  }
                }
                _ -> UnifiedFail('mismatch, s)
              }
            }
            TyApp(xname, xargs) -> {
              match y {
                TyApp(yname, yargs) -> {
                  // same name? unify args
                  if xname == yname {
                    unify_list(xargs, yargs, s)
                  } else {
                    UnifiedFail('mismatch, s)
                  }
                }
                _ -> UnifiedFail('mismatch, s)
              }
            }
            _ -> UnifiedFail('mismatch, s) // unknown tree
          }
        }
      }
    }
  }
}

fn unify_list(xs : List(Ty), ys : List(Ty), s : Subst) -> Unified {
  match xs {
    nil -> {
      if null?(ys) { UnifiedOk(s) }
      else { UnifiedFail('arity, s) }
    }
    cons(xh, xrest) -> {
      if null?(ys) { UnifiedFail('arity, s) }
      else {
        let r = unify(xh, car(ys), s)
        if unified_ok(r) {
          unify_list(xrest, cdr(ys), unified_s(r))
        } else {
          r
        }
      }
    }
  }
}

// ============================================================
// unify_check: like unify, but records failures as a TcMismatch diagnostic
// ctx is the failing-site path (见 TcError)。
// ============================================================

fn unify_check(t1 : Ty, t2 : Ty, s : Subst, ctx : List(Symbol)) -> Subst {
  match unify(t1, t2, s) {
    UnifiedOk(s2) -> s2
    UnifiedFail(_, _) -> {
      // Record the resolved types so error messages show concrete types
      // (e.g. List(string) vs List(int)) instead of unbound tvars.
      add_error(s, TcMismatch(ctx, apply_subst(t1, s), apply_subst(t2, s)))
    }
  }
}

// ============================================================
// Generalize and Instantiate
// ============================================================

// generalize_l(t, level, s) -> scheme
// Level-based generalization: generalize tvars whose level > current level.
// O(T) where T is type size — replaces O(N^3) generalize.
fn generalize_l(t : Ty, level : Int, s : Subst) -> Ty {
  let resolved = apply_subst(t, s)
  let quantified = find_generalizable(resolved, level)
  if null?(quantified) {
    resolved
  } else {
    t_forall(quantified, resolved)
  }
}

// find_generalizable(t, level) -> list of tvar ids with level > current level
fn find_generalizable(t : Ty, level : Int) -> List(Int) {
  match t {
    TyVar(id, tv_level) -> {
      if tv_level > level {
        cons(id, nil)
      } else {
        nil
      }
    }
    TyArrow(from, to) -> list_union(
    find_generalizable(from, level),
    find_generalizable(to, level)
    )
    TyApp(_, args) -> find_generalizable_list(args, level)
    _ -> nil // base, forall or unknown
  }
}

fn find_generalizable_list(ts : List(Ty), level : Int) -> List(Int) {
  match ts {
    nil -> nil
    cons(h, rest) -> list_union(find_generalizable(h, level), find_generalizable_list(rest, level))
  }
}

// InstWalk — inst_walk 走完一个类型后的三样：换好的类型、下一个计数器、
// old_id → new_ty 的映射（同一个量化变量在这一次实例化里只换一次）。
type InstWalk { InstWalk(t : Ty, counter : Int, map : List(TvBind)) }

fn iw_t(r : InstWalk) -> Ty { match r { InstWalk(t, _, _) -> t } }
fn iw_c(r : InstWalk) -> Int { match r { InstWalk(_, counter, _) -> counter } }
fn iw_map(r : InstWalk) -> List(TvBind) { match r { InstWalk(_, _, map) -> map } }

// InstLists — 同上，走完一个**类型表**。
type InstLists { InstLists(ts : List(Ty), counter : Int, map : List(TvBind)) }

fn ils_ts(r : InstLists) -> List(Ty) { match r { InstLists(ts, _, _) -> ts } }
fn ils_c(r : InstLists) -> Int { match r { InstLists(_, counter, _) -> counter } }
fn ils_map(r : InstLists) -> List(TvBind) { match r { InstLists(_, _, map) -> map } }

// instantiate(scheme, counter, level) -> Fresh
// Replaces quantified vars with fresh vars stamped at current level.
fn instantiate(scheme : Ty, counter : Int, level : Int) -> Fresh {
  match scheme {
    TyForall(quantified, body) -> {
      let r = inst_walk(body, quantified, nil, counter, level)
      Fresh(iw_t(r), iw_c(r))
    }
    _ -> {
      // monomorphic — return as-is
      Fresh(scheme, counter)
    }
  }
}

// inst_walk(t, quantified, mapping, counter, level) -> InstWalk
fn inst_walk(t : Ty, quantified : List(Int), map : List(TvBind), counter : Int, level : Int) -> InstWalk {
  match t {
    TyVar(vid, _) -> {
      if list.member(vid, quantified) {
        // Look up in the mapping or create fresh
        match tv_find(map, vid) {
          option.Some(seen) -> InstWalk(seen, counter, map)
          option.None -> {
            let fv = fresh(counter, level)
            let new_t = fresh_ty(fv)
            InstWalk(new_t, fresh_counter(fv), cons(TvBind(vid, new_t), map))
          }
        }
      } else {
        InstWalk(t, counter, map)
      }
    }
    TyArrow(from, to) -> {
      let r1 = inst_walk(from, quantified, map, counter, level)
      let r2 = inst_walk(to, quantified, iw_map(r1), iw_c(r1), level)
      InstWalk(t_arrow(iw_t(r1), iw_t(r2)), iw_c(r2), iw_map(r2))
    }
    TyApp(name, args) -> {
      let r = inst_walk_list(args, quantified, map, counter, level)
      InstWalk(t_app(name, ils_ts(r)), ils_c(r), ils_map(r))
    }
    _ -> InstWalk(t, counter, map) // base, forall or unknown
  }
}

fn inst_walk_list(ts : List(Ty), quantified : List(Int), map : List(TvBind), counter : Int, level : Int) -> InstLists {
  match ts {
    nil -> InstLists(nil, counter, map)
    cons(h, rest) -> {
      let r1 = inst_walk(h, quantified, map, counter, level)
      let r2 = inst_walk_list(rest, quantified, iw_map(r1), iw_c(r1), level)
      InstLists(cons(iw_t(r1), ils_ts(r2)), ils_c(r2), ils_map(r2))
    }
  }
}

// ============================================================
// infer_expr: core type inference
// ============================================================

// Inferred — 一次推断的产出：类型、替换、下一个 tvar 计数器。
type Inferred { Inferred(ty : Ty, s : Subst, counter : Int) }

fn inf_ty(r : Inferred) -> Ty { match r { Inferred(t, _, _) -> t } }
fn inf_s(r : Inferred) -> Subst { match r { Inferred(_, s, _) -> s } }
fn inf_c(r : Inferred) -> Int { match r { Inferred(_, _, counter) -> counter } }

// TypedList — 「一串子表达式 + 替换 + 计数器」：折叠一个参数表时的产出。
type TypedList { TypedList(types : List(Ty), s : Subst, counter : Int) }

fn tlist_types(r : TypedList) -> List(Ty) { match r { TypedList(types, _, _) -> types } }
fn tlist_s(r : TypedList) -> Subst { match r { TypedList(_, s, _) -> s } }
fn tlist_c(r : TypedList) -> Int { match r { TypedList(_, _, counter) -> counter } }

// ArmsRef — match/receive 折叠完所有臂后的产出：共同类型（一个臂都没有时
// None）、替换、计数器。
type ArmsRef { ArmsRef(ty : option.Option(Ty), s : Subst, counter : Int) }

fn arms_ref_ty(r : ArmsRef) -> option.Option(Ty) { match r { ArmsRef(ty, _, _) -> ty } }
fn arms_ref_s(r : ArmsRef) -> Subst { match r { ArmsRef(_, s, _) -> s } }
fn arms_ref_c(r : ArmsRef) -> Int { match r { ArmsRef(_, _, counter) -> counter } }

fn is_arith_op(name : Symbol) -> Bool {
  if name == '+ { true }
  else {
    if name == '- { true }
    else {
      if name == '* { true }
      else {
        if name == '/ { true }
        else {
          name == '%
        }
      }
    }
  }
}

fn is_cmp_op(name : Symbol) -> Bool {
  if name == '< { true }
  else {
    if name == '<= { true }
    else {
      if name == '> { true }
      else {
        name == '>=
      }
    }
  }
}

// == and != share one operand-unification rule (see infer_eq).
fn is_eq_op(name : Symbol) -> Bool {
  name == '= || name == '!=
}

fn infer_expr(expr : form.Form, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  match expr {
    form.FAtom(c) -> {
      match c {
        // --- Integer literal ---
        ast.CInt(_) -> Inferred(t_int(), s, counter)
        // --- nil ---
        ast.CNil -> {
          let fv = fresh(counter, level)
          Inferred(fresh_ty(fv), s, fresh_counter(fv))
        }
        // --- String literal ---
        ast.CStr(_) -> Inferred(t_string(), s, counter)
        // --- Symbol (variable reference) ---
        ast.CSym(name) -> {
          match env_find(env, name) {
            option.None -> {
              // Unbound — undefined variable (issue #81). Every let-bound
              // name in the enclosing body is pre-registered in env by
              // collect_let_bindings before inference, so a name missing
              // here has no binding at all (not a param, not a let, not a
              // builtin/outer define). Record a TcUndefinedVar and keep
              // inferring with a fresh tvar so multiple errors surface in
              // one pass.
              let fv = fresh(counter, level)
              Inferred(fresh_ty(fv), add_error(s, TcUndefinedVar(name, ctx)), fresh_counter(fv))
            }
            option.Some(entry) -> {
              let inst = instantiate(entry_scheme(entry), counter, level)
              Inferred(fresh_ty(inst), s, fresh_counter(inst))
            }
          }
        }
        // --- true / false ---
        // (Dispatched AFTER the string?/symbol? predicates: == now unifies
        // operand types, and a string literal would poison the substitution
        // with a bogus string-vs-bool diagnostic here. bool is disjoint from
        // int/string/symbol/pair/nil, so reordering is equivalent. false
        // gets its own branch: leaving it to the fallback would type it as
        // a fresh tvar, letting 1 == false slip through the tower.)
        ast.CTrue -> Inferred(t_bool(), s, counter)
        ast.CFalse -> Inferred(t_bool(), s, counter)
        // 浮点在 form 树上不是原子：`('float "1.5")` 是两元素表（parser 的
        // 拼法，见 form.float_text），故这里到不了 —— 那一支在下面的 FList。
        ast.CFloat(_) -> Inferred(t_float(), s, counter)
      }
    }
    // --- Compound form ---
    form.FList(items) -> {
      // --- Float literal: ('float "1.5") ---
      // A proper list headed by 'float whose single element is the
      // literal string. The bootstrap language has no float values,
      // so the string travels end-to-end and the VM parses it with
      // strtod. Type: float.
      match form.float_text(items) {
        option.Some(_) -> Inferred(t_float(), s, counter)
        option.None -> infer_compound(expr, env, s, counter, level, ctx)
      }
    }
  }
}

// narrow_var(cond : form.Form) -> option.Option(Symbol)
// If cond is a type predicate (int? v) / (string? v) / (symbol? v) with v a
// symbol, return v so the if-inference can narrow each branch independently.
fn narrow_var(cond : form.Form) -> option.Option(Symbol) {
  match cond {
    form.FList(items) -> {
      let h = form.nth(items, 0)
      // A zero-arg call condition parses as the 1-element form (f), so
      // the predicate's argument slot may be absent entirely.
      match form.nth(items, 1) {
        form.FAtom(ast.CSym(name)) -> {
          if form.is_sym(h, 'int?) {
            option.Some(name)
          } else {
            if form.is_sym(h, 'string?) {
              option.Some(name)
            } else {
              if form.is_sym(h, 'symbol?) {
                option.Some(name)
              } else {
                option.None
              }
            }
          }
        }
        _ -> option.None
      }
    }
    form.FAtom(_) -> option.None
  }
}

// === Compound-form dispatch ===
//
// Each language keyword gets a dedicated inference helper. infer_compound is
// a flat else-if dispatch over the head symbol; every helper returns Inferred.

// EnvC — 「环境 + 下一个计数器」：扩一层变量（if 分支、let、模式）时带出去
// 的两样。
type EnvC { EnvC(env : List(EnvEntry), counter : Int) }

fn envc_env(c : EnvC) -> List(EnvEntry) { match c { EnvC(env, _) -> env } }
fn envc_counter(c : EnvC) -> Int { match c { EnvC(_, counter) -> counter } }

// (match scrut (pat body)...) — language keyword. Handled FIRST so
// pattern positions (constructors, _ wildcards, bindings) never fall
// through to the general function-call path.
fn infer_match(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let scrut = form.nth(rest, 0)
  let arms = cdr(rest)
  let r0 = infer_expr(scrut, env, s, counter, level, ctx)
  let scrut_t = inf_ty(r0)
  let s0 = inf_s(r0)
  let c0 = inf_c(r0)
  // Name the scrutinee type from what the expression itself says, read before
  // the arms run: an arm may unify the scrutinee with a shape it describes
  // (`match recv()` with a `cons('data, lst)` arm says which messages are
  // handled, not that the value is a list), and a type invented that way is no
  // ground for demanding every variant of it (issue #208).
  let scrut_name = ty_name(apply_subst(scrut_t, s0))
  let ra = infer_match_arms(arms, option.Some(scrut_t), option.None, env, s0, c0, level, ctx)
  let arm_t = arms_ref_ty(ra)
  let s_a = arms_ref_s(ra)
  let c_a = arms_ref_c(ra)
  // Exhaustiveness check (issue #118): record a compile error when the arms
  // miss an ADT variant.
  let s_w = check_exhaustive(scrut_name, arms, env, ctx, s_a)
  // All arms agree on a type (infer_match_arms unified them); report it
  // instead of a fresh tvar, so the match's result type survives (#219).
  // No arms at all: nothing to report — fall back to a fresh tvar.
  match arm_t {
    option.None -> {
      let fv = fresh(c_a, level)
      Inferred(fresh_ty(fv), s_w, fresh_counter(fv))
    }
    option.Some(t) -> Inferred(apply_subst(t, s_w), s_w, c_a)
  }
}

// (receive arm1 arm2 ...)
fn infer_receive(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let arms = rest
  // scrut_t = nil: a mailbox holds many message types, so there is no
  // single scrutinee type to constrain patterns against (issue #102).
  let ra = infer_match_arms(arms, option.None, option.None, env, s, counter, level, ctx)
  let arm_t = arms_ref_ty(ra)
  let s_a = arms_ref_s(ra)
  let c_a = arms_ref_c(ra)
  match arm_t {
    option.None -> {
      let fv = fresh(c_a, level)
      Inferred(fresh_ty(fv), s_a, fresh_counter(fv))
    }
    option.Some(t) -> Inferred(apply_subst(t, s_a), s_a, c_a)
  }
}

// (quote x)
fn infer_quote(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let quoted = form.nth(rest, 0)
  match quoted {
    form.FAtom(ast.CSym(name)) -> {
      // ctor_binding walks past the same-named typedecl entry that
      // `type X { X }` registers in front of the ctor (#406 family): a bare
      // nullary constructor reference resolves to the variant type instead of
      // falling into the Symbol branch (issue #409). A name with no 'ctor
      // entry anywhere (quoted function/variable used as data) answers None →
      // Symbol, preserving the strict-== semantics below.
      match ctor_binding(name, env) {
        option.Some(entry) -> {
          // Const / nullary ADT constructor reference: uppercase names parse
          // as (quote Name), so the quoted name resolves to the binding's
          // real type (e.g. const MSG = "hi" makes MSG : string, and a nullary
          // variant V : its variant type).
          let inst = instantiate(entry_scheme(entry), counter, level)
          Inferred(fresh_ty(inst), s, fresh_counter(inst))
        }
        option.None -> {
          // Quoted function/variable name used as data: a symbol value.
          // (The old lookup returned the function's type for any bound name,
          // e.g. 'car : pair -> int, which strict == now rejects when the
          // quote is compared with a symbol.)
          // 大写引号名还有一种来源：本模块以外的零参构造子（`None`）—— 它没有
          // ctor 条目，写裸名只会得到一个普通 symbol，和构造子的标签对不上（issue
          // #462 P4）。小写引号名是数据，不查。
          let s1 = if is_uppercase_sym(name) == 1 {
            bare_member_error(name, env, ctx, s)
          } else {
            s
          }
          Inferred(t_symbol(), s1, counter)
        }
      }
    }
    // (quote (a b)) and other atoms: a symbol value, no lookup.
    _ -> Inferred(t_symbol(), s, counter)
  }
}

// (if cond then else?)
fn infer_if(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let cond_e = form.nth(rest, 0)
  let then_e = form.nth(rest, 1)
  let else_e = form.nth(rest, 2)
  // Infer cond
  let rc = infer_expr(cond_e, env, s, counter, level, ctx)
  let cond_t = inf_ty(rc)
  let s1 = inf_s(rc)
  let c1 = inf_c(rc)
  // Unify cond with bool
  let s2 = unify_check(cond_t, t_bool(), s1, ctx)
  // Type-predicate narrowing: if cond is (int? v) / (string? v) / (symbol? v),
  // give each branch its own fresh tvar for v. This keeps branch-specific
  // constraints (e.g. int ops in the then-branch, string ops in the else)
  // from leaking across branches, supporting dynamic type dispatch.
  let nv = narrow_var(cond_e)
  let tn = narrow_var_env(nv, env, c1, level)
  let then_env = envc_env(tn)
  let c_then = envc_counter(tn)
  // Infer then
  let rt = infer_expr(then_e, then_env, s2, c_then, level, ctx)
  let then_t = inf_ty(rt)
  let s3 = inf_s(rt)
  let c2 = inf_c(rt)
  // Infer else (fresh tvar for v too, from the current counter)
  let en = narrow_var_env(nv, env, c2, level)
  let else_env = envc_env(en)
  let c_else = envc_counter(en)
  let re = infer_expr(else_e, else_env, s3, c_else, level, ctx)
  let else_t = inf_ty(re)
  let s4 = inf_s(re)
  let c3 = inf_c(re)
  // Unify then with else
  let s5 = unify_check(then_t, else_t, s4, ctx)
  Inferred(apply_subst(then_t, s5), s5, c3)
}

// narrow_var_env(nv, env, counter, level) — the branch env for a narrowed
// type predicate: the narrowed name gets a fresh tvar of its own, everything
// else is untouched.
fn narrow_var_env(nv : option.Option(Symbol), env : List(EnvEntry), counter : Int, level : Int) -> EnvC {
  match nv {
    option.None -> EnvC(env, counter)
    option.Some(name) -> {
      let fv = fresh(counter, level)
      EnvC(extend(env, name, fresh_ty(fv)), fresh_counter(fv))
    }
  }
}

// (let var expr body...)
fn infer_let(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let var_sym = form.sym_at(form.nth(rest, 0))
  let val_expr = form.nth(rest, 1)
  let body = cdr(cdr(rest))
  // Infer value at level + 1
  let rv = infer_expr(val_expr, env, s, counter, level + 1, ctx)
  let val_t = inf_ty(rv)
  let s1 = inf_s(rv)
  let c1 = inf_c(rv)
  // Generalize at current level
  let scheme = generalize_l(val_t, level, s1)
  let new_env = extend(env, var_sym, scheme)
  // Infer body at level + 1
  infer_body(body, new_env, s1, c1, level + 1, ctx)
}

// (let var expr) — a braced-block `let` statement (flat form, no nested
// body). collect_let_bindings pre-registered `var` with a fresh tvar, so
// the rest of the block resolves `var` to that tvar; without binding it
// here the let's real type never reaches later statements, and a misuse
// of `var` unifies the tvar silently — the error site is lost (issue #90).
// Bind the pre-registered tvar to the RHS type through the subst. A var
// already bound (param / outer scope) was skipped by extend_let_env and
// keeps its binding, so there is nothing to bind for it. Plain unify, not
// unify_check: a forward reference before the let may have constrained the
// tvar already, and that case stays type-loose as before.
fn infer_let_stmt(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let var_sym = form.sym_at(form.nth(rest, 0))
  let rv = infer_expr(form.nth(rest, 1), env, s, counter, level, ctx)
  let val_t = inf_ty(rv)
  let s1 = inf_s(rv)
  let c1 = inf_c(rv)
  match env_find(env, var_sym) {
    option.None -> Inferred(val_t, s1, c1)
    option.Some(entry) -> {
      match entry_scheme(entry) {
        TyVar(_, _) -> {
          let u = unify(entry_scheme(entry), val_t, s1)
          Inferred(val_t, unified_s(u), c1)
        }
        _ -> Inferred(val_t, s1, c1)
      }
    }
  }
}

// (tuple (quote Name) args...): parser emits this for constructor calls.
// Route to the constructor's registered scheme when Name is a known ADT
// constructor (Ctor); a tag with no constructor behind it is still a
// tagged tuple at run time, so it takes the type its own shape spells.
fn infer_ctor_call(expr : form.Form, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let items = form.items(expr)
  match ctor_form(expr) {
    // 没有 (quote Name) tag 的 (tuple x args...) 就是一次普通的 tuple 调用。
    option.None -> infer_call(form.sym_at(form.nth(items, 0)), cdr(items), env, s, counter, level, ctx)
    option.Some(cf) -> {
      let name = form.sym_at(car(cf))
      match ctor_binding(name, env) {
        option.Some(entry) -> ctor_arity_check(name, cdr(cf), entry_scheme(entry), env, s, counter, level, ctx)
        option.None -> infer_untagged_ctor(name, cdr(cf), env, s, counter, level, ctx)
      }
    }
  }
}

// infer_untagged_ctor(name, args, env, s, counter, level, ctx)
//   -> (type . (s . counter))
// A constructor call whose name has no 'ctor entry. The parser already turned
// it into the tagged tuple every constructor builds, so the value is
// `#(Name args...)`. A builtin type name (`Pair(a, k)`) is a real type, and the
// application the annotation spells is its type. Any other undecorated name is
// *not* a type — typing it `Name(t1, ..., tn)` would invent a type no
// annotation can mention, and it could then only ever clash with itself:
// `Ok(1)` / `Err("x")` would stop being two arms of one match. So such a value
// is unconstrained (bottom), the same verdict an undeclared shape deserves.
fn infer_untagged_ctor(name : Symbol, args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let ra = infer_args_for_unknown(args, env, s, counter, level, ctx)
  let s1 = tlist_s(ra)
  let c1 = tlist_c(ra)
  if is_builtin_type_name(name) == 1 {
    Inferred(t_app(name, tlist_types(ra)), s1, c1)
  } else {
    // 跨模块裸构造子（issue #462 P4）：`Some(1)` 而 Some 是 option 的成员 —
    // 建议写 `option.Some`。给不出建议的名字仍然是 unconstrained bottom。
    Inferred(t_never(), bare_member_error(name, env, ctx, s1), c1)
  }
}

// ctor_binding(name, env) -> ('ctor . scheme) or nil
// The type-name entry (('typedecl . variant-names), registered for match
// exhaustiveness, #118) sits in front of the constructor of the same name,
// so a plain assq on `type Point { Point(x, y, z) }` answers "typedecl".
// Constructor routing asks "is there a constructor named name?" — pick by
// tag, not by shadowing order. nil also covers a name that is only a type.
fn ctor_binding(name : Symbol, env : List(EnvEntry)) -> option.Option(EnvEntry) {
  match env {
    nil -> option.None
    cons(e, rest) -> {
      if entry_name(e) == name {
        // A same-named type-name entry may sit in front; keep walking.
        match e {
          Ctor(_, _) -> option.Some(e)
          _ -> ctor_binding(name, rest)
        }
      } else {
        ctor_binding(name, rest)
      }
    }
  }
}

// ctor_arity_check(name, args, scheme, env, s, counter, level, ctx)
//   -> (type . (s . counter))
// A constructor's shape is fixed where it is declared, so its argument count
// is checkable even in unannotated code. Without this the fields silently
// shift: Point(x, y, z) built with two arguments yields a value that a
// three-field pattern never matches, so the arm returns nil and the mistake
// only surfaces far away (issue #229). Records E0003 and keeps inferring the
// arguments (unconstrained result) so several errors surface in one pass —
// same shape as arity_error for builtins.
fn ctor_arity_check(name : Symbol, args : List(form.Form), scheme : Ty, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let inst = instantiate(scheme, counter, level)
  let want = list.length(arrow_params(fresh_ty(inst)))
  let got = list.length(args)
  if got == want {
    infer_apply(fresh_ty(inst), args, env, s, fresh_counter(inst), level, ctx, name, 1)
  } else {
    let ret_fv = fresh(fresh_counter(inst), level)
    let s1 = add_error(s, TcArity(ctx, name, got, want))
    let ra = infer_args_for_unknown(args, env, s1, fresh_counter(ret_fv), level, ctx)
    Inferred(fresh_ty(ret_fv), tlist_s(ra), tlist_c(ra))
  }
}

// ('ctor.labels (quote R) base assigns) — labelled construction and record update
// (parser: build_ctor_call). Arguments are keyed by label, so their source
// order says nothing about which slot they fill — the declaration does. That
// is why the resolution lives here and not in the driver: an imported type's
// label table rides the same env entry its constructors do.
//
//   R(num: 1, den: 2)   every field named, any order
//   R(..r, num: 3)      r's fields, then the named ones replaced
//
// Either way the value is the tagged tuple a positional R(1, 2) builds; the
// driver expands the form against the same (ctor, arity, labels) entries
// typecheck checks it with.
fn infer_record(rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let name = form.sym_at(form.nth(form.items(form.nth(rest, 0)), 1))
  let base = form.nth(rest, 1)
  let assigns = form.items(form.nth(rest, 2))
  match ctor_binding(name, env) {
    option.None -> {
      // Nothing declares the name. The parser only builds this form for a
      // constructor-shaped name, so this is a typo'd (or unimported)
      // constructor: same verdict as an undefined call, bottom type so one
      // error does not cascade.
      Inferred(t_never(), add_error(s, TcUndefinedFn(name, ctx)), counter)
    }
    option.Some(entry) -> {
      let table = ctor_table(name, env)
      let labels = vt_labels(table)
      let inst = instantiate(entry_scheme(entry), counter, level)
      let fn_t = fresh_ty(inst)
      let sr = record_slots(name, assigns, labels, s, ctx, nil)
      let slotted = rslots_slotted(sr)
      let s1 = record_coverage(name, slotted, vt_arity(table), base, labels, rslots_s(sr), ctx)
      let rf = infer_record_fields(name, slotted, labels, arrow_params(fn_t), env, s1, fresh_counter(inst), level, ctx)
      let s2 = step_s(rf)
      if form.is_nil_form(base) {
        Inferred(apply_subst(arrow_result(fn_t), s2), s2, step_c(rf))
      } else {
        // The base is an R like any other: unifying its type with this
        // constructor's result pins the update to one instantiation, so a
        // base of the wrong type is a plain E0001 and `..r` on a polymorphic
        // constructor ties the fields to r's type arguments.
        let rb = infer_expr(base, env, s2, step_c(rf), level, ctx)
        let s3 = unify_check(inf_ty(rb), arrow_result(fn_t), inf_s(rb), ctx)
        // inf_c(rb) — the counter the base's own inference advanced. Dropping
        // it hands the next instantiation the ids this call already used, and
        // two unrelated types end up sharing one variable.
        Inferred(apply_subst(arrow_result(fn_t), s3), s3, inf_c(rb))
      }
    }
  }
}

// ctor_table(cname, env) -> 该构造子的字段表；表不存在时给一张零字段、无标签
// 的空表 —— 于是写下的每个标签都按「声明里没有这个字段」报错，而不是把这次
// 构造当成功。
fn ctor_table(cname : Symbol, env : List(EnvEntry)) -> VariantTable {
  match ctor_field_table(cname, env) {
    option.None -> VariantTable(cname, 0, nil)
    option.Some(table) -> table
  }
}

// SlotBox — 一个已对好槽位的字段赋值：槽号 + 值表达式。
type SlotBox { SlotBox(slot : Int, expr : form.Form) }

fn slotbox_slot(b : SlotBox) -> Int { match b { SlotBox(slot, _) -> slot } }
fn slotbox_expr(b : SlotBox) -> form.Form { match b { SlotBox(_, expr) -> expr } }

// RecordSlots — record_slots 的产出：对好槽位的赋值、替换。
type RecordSlots { RecordSlots(slotted : List(SlotBox), s : Subst) }

fn rslots_slotted(r : RecordSlots) -> List(SlotBox) { match r { RecordSlots(slotted, _) -> slotted } }
fn rslots_s(r : RecordSlots) -> Subst { match r { RecordSlots(_, s) -> s } }

// SubstStep — 「替换 + 计数器」：只推进状态、不产出类型的折叠。
type SubstStep { SubstStep(s : Subst, counter : Int) }

fn step_s(r : SubstStep) -> Subst { match r { SubstStep(s, _) -> s } }
fn step_c(r : SubstStep) -> Int { match r { SubstStep(_, counter) -> counter } }

// slot_of_label(labels, label) -> 该标签的槽号，声明里没有这个字段为 None。
fn slot_of_label(labels : List(LabelSlot), label : Symbol) -> option.Option(Int) {
  match labels {
    nil -> option.None
    cons(ls, rest) -> {
      match ls {
        LabelSlot(l, slot) -> if l == label { option.Some(slot) } else { slot_of_label(rest, label) }
      }
    }
  }
}

// label_of_slot(slot, labels) -> 该槽声明的标签，声明没给这个槽起名为 None。
fn label_of_slot(slot : Int, labels : List(LabelSlot)) -> option.Option(Symbol) {
  match labels {
    nil -> option.None
    cons(ls, rest) -> {
      match ls {
        LabelSlot(label, s) -> if s == slot { option.Some(label) } else { label_of_slot(slot, rest) }
      }
    }
  }
}

// record_slots(name, assigns, labels, s, ctx, seen) -> RecordSlots
// slotted = 源序的 SlotBox 表。An assign is a proper 2-list (label expr) —
// dotted would put an expression in a cdr, which every generic form walker
// tries to iterate. A label the declaration does not name, or a repeated one,
// is dropped with its own error: keeping it would type it against the wrong
// field and report a second, misleading mismatch.
fn record_slots(name : Symbol, assigns : List(form.Form), labels : List(LabelSlot), s : Subst, ctx : List(Symbol), seen : List(Symbol)) -> RecordSlots {
  if null?(assigns) {
    RecordSlots(nil, s)
  } else {
    let items = form.items(car(assigns))
    let label = form.sym_at(form.nth(items, 0))
    let hit = slot_of_label(labels, label)
    let ok = option.is_some(hit) && sym_in_list(label, seen) == 0
    let rest = record_slots(name, cdr(assigns), labels, s, ctx, if ok { cons(label, seen) } else { seen })
    if ok {
      RecordSlots(cons(SlotBox(option.unwrap_or(0, hit), form.nth(items, 1)), rslots_slotted(rest)), rslots_s(rest))
    } else {
      RecordSlots(rslots_slotted(rest), label_error(s, name, label, hit, ctx))
    }
  }
}

// label_error(s, name, label, hit, ctx) — 一个用不了的标签：声明里没有它
// （unknown），或者同一字段给了两次（duplicate）。
fn label_error(s : Subst, name : Symbol, label : Symbol, hit : option.Option(Int), ctx : List(Symbol)) -> Subst {
  match hit {
    option.None -> add_error(s, TcLabelUnknown(ctx, name, label))
    option.Some(_) -> add_error(s, TcLabelDuplicate(ctx, name, label))
  }
}

// record_coverage(name, slotted, arity, base, labels, s, ctx) -> s
// A base carries every slot, so an update never leaves one empty — unless the
// constructor has no fields at all, where `A(..b)` copies nothing and asks to
// update something that is not there.
// Without a base every slot has to be written: a field left empty would make
// the value's arity differ from the pattern's, and a match would silently
// fall through (the failure #229 fixed for positional calls). The gap is
// named when the declaration names it ("missing field 'y'", E0007); a
// declaration that labels only some fields (`P(int, y : int)`) cannot be
// built by label at all, and that unnamed slot keeps the E0003 field count a
// wrong positional call gets.
fn record_coverage(name : Symbol, slotted : List(SlotBox), arity : Int, base : form.Form, labels : List(LabelSlot), s : Subst, ctx : List(Symbol)) -> Subst {
  if form.is_nil_form(base) {
    let miss = first_uncovered(slotted, arity, 1)
    if miss == 0 {
      s
    } else {
      match label_of_slot(miss, labels) {
        option.None -> add_error(s, TcArity(ctx, name, list.length(slotted), arity))
        option.Some(label) -> add_error(s, TcLabelMissing(ctx, name, label))
      }
    }
  } else {
    if arity == 0 {
      add_error(s, TcLabelNoFields(ctx, name))
    } else {
      s
    }
  }
}

// first_uncovered(slotted, arity, i) -> the first slot with no assignment, 0
// when every slot is filled.
fn first_uncovered(slotted : List(SlotBox), arity : Int, i : Int) -> Int {
  if i > arity { 0 }
  else if slot_filled(slotted, i) { first_uncovered(slotted, arity, i + 1) }
  else { i }
}

fn slot_filled(slotted : List(SlotBox), i : Int) -> Bool {
  if null?(slotted) {
    false
  } else if slotbox_slot(car(slotted)) == i {
    true
  } else {
    slot_filled(cdr(slotted), i)
  }
}

// infer_record_fields(name, slotted, labels, params, env, s, counter, level,
//                     ctx) -> SubstStep
// Each value is typed against the parameter of the slot its label names. The
// source order never matters: `R(den: 4, num: 3)` checks 4 against den.
fn infer_record_fields(name : Symbol, slotted : List(SlotBox), labels : List(LabelSlot), params : List(Ty), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  if null?(slotted) {
    SubstStep(s, counter)
  } else {
    let slot = slotbox_slot(car(slotted))
    let ctx2 = ctx_push(ctx, field_ctx(name, slot, labels))
    let ra = infer_expr(slotbox_expr(car(slotted)), env, s, counter, level, ctx2)
    let s1 = unify_check(inf_ty(ra), list.nth(params, slot - 1), inf_s(ra), ctx2)
    infer_record_fields(name, cdr(slotted), labels, params, env, s1, inf_c(ra), level, ctx)
  }
}

// field_ctx(name, slot, labels) -> symbol like "field num of R" for the error
// context (mismatch reports read it), falling back to the slot number for a
// field the declaration does not name.
fn field_ctx(name : Symbol, slot : Int, labels : List(LabelSlot)) -> Symbol {
  let what = match label_of_slot(slot, labels) {
    option.None -> str.concat("field ", str.from_int(slot))
    option.Some(label) -> str.concat("field ", str.sym_to_str(label))
  }
  str.to_sym(str.concat(what, str.concat(" of ", str.sym_to_str(name))))
}

// builtin_arity(sym) -> int: exact argument count for opcodes and C
// builtins, or -1 for symbols with no fixed arity (variadic builtins like
// net.read, TA functions, special forms like if/match/let).
//
// Direction B: the typechecker enforces this at compile time. Without it,
// car (forall a b. a -> b) unifies a second argument through a fresh type
// variable — over-application then compiles and corrupts the VM stack at
// runtime (e.g. car(x, x), print(x, y) — print's cfunc takes exactly one
// value).
// Arity here must match the C runtime (src/vm.c opcodes, api.c cfuncs).
fn builtin_arity(sym : Symbol) -> Int {
  if sym == 'car { 1 }
  else if sym == 'cdr { 1 }
  else if sym == 'cons { 2 }
  else if sym == 'print { 1 }
  else if sym == 'null? { 1 }
  else if sym == 'pair? { 1 }
  else if sym == 'int? { 1 }
  else if sym == 'string? { 1 }
  else if sym == 'bytes? { 1 }
  else if sym == 'symbol? { 1 }
  else if sym == 'pid? { 1 }
  else if sym == 'float? { 1 }
  else if sym == 'bool? { 1 }
  else if sym == 'tuple? { 1 }
  else if sym == 'tuple-len { 1 }
  else if sym == 'tuple-ref { 2 }
  else if sym == '+ { 2 }
  else if sym == '- { 2 }
  else if sym == '* { 2 }
  else if sym == '/ { 2 }
  else if sym == '% { 2 }
  else if sym == '= { 2 }
  else if sym == '!= { 2 }
  else if sym == '< { 2 }
  else if sym == '<= { 2 }
  else if sym == '> { 2 }
  else if sym == '>= { 2 }
  else if sym == '== { 2 }
  else if sym == 'spawn { 1 }
  else if sym == 'send { 2 }
  else if sym == 'recv { 0 }
  else if sym == 'recv_after { 1 }
  else if sym == 'self { 0 }
  else if sym == 'monitor { 1 }
  else if sym == 'str_concat { 2 }
  else if sym == 'str.eq { 2 }
  else if sym == 'str.concat { 2 }
  else if sym == 'int.to_float { 1 }
  else if sym == 'float.to_int { 1 }
  else if sym == 'str.length { 1 }
  else if sym == 'str.char_at { 2 }
  else if sym == 'str.substr { 3 }
  else if sym == 'str.to_int { 1 }
  else if sym == 'str.from_int { 1 }
  else if sym == 'str.index_of { 2 }
  else if sym == 'str.to_sym { 1 }
  else if sym == 'str.sym_to_str { 1 }
  else if sym == 'str.chr { 1 }
  else if sym == 'vm.parse_source { 1 }
  else if sym == 'vm.is_builtin_module { 1 }
  else if sym == 'vm.get_arg { 1 }
  else if sym == 'vm.time_ms { 0 }
  else if sym == 'vm.time_us { 0 }
  else if sym == 'vm.cfunc_index { 1 }
  else if sym == 'net.listen { 1 }
  else if sym == 'net.accept { 1 }
  // connect 的可选 timeout 拆成两个固定元数的名字（S4），返回值多态所以
  // 箭头管不住元数 —— 元数由这里和 C 注册表共同保证。
  else if sym == 'net.connect { 2 }
  else if sym == 'net.connect_timeout { 3 }
  else if sym == 'net.write { 2 }
  else if sym == 'net.close { 1 }
  else if sym == 'file.read { 1 }
  else if sym == 'file.write { 2 }
  else if sym == 'file.exists { 1 }
  else { -1 }
}

// arity_table(env) -> 全局区那张局部元数表（defn_arity_key 的替代：表就是
// env 里一条 ArityTable 条目，不再借一个 `$` 前缀名占位）。
fn arity_table(env : List(EnvEntry)) -> option.Option(List(Arity)) {
  match env {
    nil -> option.None
    cons(e, rest) -> {
      match e {
        ArityTable(entries) -> option.Some(entries)
        _ -> arity_table(rest)
      }
    }
  }
}

// user_arity(head, env) -> declared arity of a local top-level define, or
// -1 when head is not one. The call-site arity of a user define is not
// recoverable from its type: TA has no partial application, yet `A -> B -> R`
// cannot say "must consume two arguments" — f(1) is a legitimate `Int -> Int`
// value, indistinguishable from handing f itself to a higher-order function.
// So the param count comes from an explicit symbol -> arity table, exactly
// like builtin_arity (issue #376). Only *local* defines are listed; a param
// or let shadowing a define name is absent and its call falls back to the
// type-driven path with no check.
fn user_arity(head : Symbol, env : List(EnvEntry)) -> Int {
  match arity_table(env) {
    option.None -> -1
    option.Some(entries) -> option.unwrap_or(-1, arity_of(entries, head))
  }
}

// locally_bound(head, env) -> true when head is bound by a param / let /
// match binder at this point. The env is prepend-ordered, and the local
// top-level arity table sits below every runtime binding, so walking down and
// meeting a binding for head before reaching the table means head is a local
// here. Such a name shadows any same-named define or builtin, and its calls
// must not be arity-checked: a program defining `fn f(a, b)` otherwise
// arity-checks the `f` param inside every imported module's higher-order
// helper (issue #449).
fn locally_bound(head : Symbol, env : List(EnvEntry)) -> Bool {
  match env {
    nil -> false
    cons(e, rest) -> {
      match e {
        ArityTable(_) -> false
        Bind(name, _) -> if name == head { true } else { locally_bound(head, rest) }
        _ -> locally_bound(head, rest)
      }
    }
  }
}

// arity_error(head, args, env, s, counter, level, ctx) -> Option(Inferred)
// The arity-check verdict for a call: None when the name has no fixed arity or
// the count matches, Some(Inferred) when it does not.
fn arity_error(head : Symbol, args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> option.Option(Inferred) {
  // builtin_arity knows opcodes/C cfuncs; user_arity knows local defines.
  // builtin wins when both match (a define may reuse a builtin name — same
  // precedence as name resolution). A name bound locally (param / let /
  // match binder) is neither: it shadows both, so no arity check.
  let want = if locally_bound(head, env) {
    -1
  } else {
    let bw = builtin_arity(head)
    if bw >= 0 { bw } else { user_arity(head, env) }
  }
  if want < 0 {
    option.None
  } else {
    let got = list.length(args)
    if got == want {
      option.None
    } else {
      let ret_fv = fresh(counter, level)
      let s1 = add_error(s, TcArity(ctx, head, got, want))
      let ra = infer_args_for_unknown(args, env, s1, fresh_counter(ret_fv), level, ctx)
      option.Some(Inferred(fresh_ty(ret_fv), tlist_s(ra), tlist_c(ra)))
    }
  }
}

// infer_compound(expr, env, s, counter, level, ctx) -> Inferred
// Flat else-if dispatch over the head symbol. `hs` is that head as a symbol
// (a non-symbol head falls back to 'nil, which matches no keyword and no
// builtin name, so it reaches the expression-headed branch below).
fn infer_compound(expr : form.Form, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let items = form.items(expr)
  let head = form.nth(items, 0)
  let rest = cdr(items)
  let hs = form.sym_at(head)

  // Direction B: builtin arity is checked before any dispatch so every
  // builtin call — whether it reaches infer_call or an inline-op branch —
  // is guarded. rest is the argument list for every entry in the table
  // (ctor ASTs are (cons (quote P) args): exactly 2; special forms are
  // not in the table).
  match arity_error(hs, rest, env, s, counter, level, ctx) {
    option.Some(bad) -> bad
    option.None -> {
      if hs == 'tuple {
        // (tuple (quote C) args...) — the constructor call the parser emits.
        // 构造子名在 tag 里，不在 head 上：这个分支拿到的是整条形式。
        infer_ctor_call(expr, env, s, counter, level, ctx)
      } else {
        infer_compound_at(head, hs, rest, env, s, counter, level, ctx)
      }
    }
  }
}

// infer_compound_at(head, hs, rest, env, s, counter, level, ctx) -> Inferred
// The dispatch proper: keyword, inline operator, or function call.
fn infer_compound_at(head : form.Form, hs : Symbol, rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if hs == 'match {
    infer_match(rest, env, s, counter, level, ctx)
  } else if hs == 'receive {
    infer_receive(rest, env, s, counter, level, ctx)
  } else if hs == 'quote {
    infer_quote(rest, env, s, counter, level, ctx)
  } else if hs == 'if {
    infer_if(rest, env, s, counter, level, ctx)
  } else if hs == 'lambda {
    // (lambda (params...) body ret_type?) — 4th slot is an optional
    // return-type annotation (nil when absent). The raw annotation from
    // the parser (bare symbol or (Name args)) is converted to the
    // checker's internal type representation before unification.
    // The result annotation is optional (the `use` desugar builds a
    // 3-element (lambda (x) rest)) — parse_type_annot(nil) = no annotation.
    let params = form.parse_params(form.nth(rest, 0))
    let body = cons(form.nth(rest, 1), nil)
    let ret_t = if form.is_nil_form(form.nth(rest, 2)) {
      option.None
    } else {
      option.Some(parse_type_annot(form.nth(rest, 2), nil))
    }
    infer_lambda(params, body, env, s, counter, level, ctx, nil, ret_t)
  } else if hs == 'let {
    // (let var expr body...) — Lisp-nested form. A braced-block `let`
    // statement parses FLAT ((let x val), body = nil); that shape routes
    // to infer_let_stmt, which binds the pre-registered tvar so the rest
    // of the block sees the let's real type (issue #90).
    if null?(cdr(cdr(rest))) {
      infer_let_stmt(rest, env, s, counter, level, ctx)
    } else {
      infer_let(rest, env, s, counter, level, ctx)
    }
  } else if hs == 'begin {
    // (begin e1 e2 ...)
    infer_body(rest, env, s, counter, level, ctx)
  } else if hs == 'and {
    // (and e1 e2 ...) / (or e1 e2 ...) — short-circuit logic.
    // Strict Bool: each operand must be Bool and the result is Bool.
    infer_bool_args(rest, env, s, counter, level, ctx)
  } else if hs == 'or {
    infer_bool_args(rest, env, s, counter, level, ctx)
  } else if hs == 'ctor.labels {
    // ('ctor.labels (quote R) base assigns) — labelled constructor call /
    // record update (parser: build_ctor_call). Only here does the
    // declaration decide which slot a label names.
    infer_record(rest, env, s, counter, level, ctx)
  } else {
    infer_op_call(head, hs, rest, env, s, counter, level, ctx)
  }
}

// infer_op_call(head, hs, rest, env, s, counter, level, ctx) -> Inferred
// Inline operators and the general call paths.
fn infer_op_call(head : form.Form, hs : Symbol, rest : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if form.is_sym_form(head) {
    if hs == 'list {
      // List literal [a, b, c] (parser emits the 'list form).
      // All element types must unify with each other — heterogeneous
      // literals like ["kernfuzz", true] are a compile error (issue
      // #80). Hand-written cons keeps its heterogeneous a -> b -> b
      // pair semantics; only the literal syntax is strict.
      infer_list_literal(rest, env, s, counter, level, ctx)
    } else if is_crash_div(hs, rest) {
      // x / 0, x % 0 — the death protocol (docs/ta-language-spec.md
      // §除零 / 模零): the expression never produces a value, so it
      // types as bottom (a free variable that unifies with anything)
      // instead of int.
      infer_crash_div(rest, env, s, counter, level, ctx)
    } else if hs == '% {
      // Modulo is int-only (float % is out of scope).
      infer_arith(rest, env, s, counter, level, ctx)
    } else if is_arith_op(hs) {
      // + - * / — int or float (mixed OK), result float if any float.
      infer_num(rest, env, s, counter, level, ctx, false)
    } else if is_cmp_op(hs) {
      infer_cmp(rest, env, s, counter, level, ctx)
    } else if is_eq_op(hs) {
      infer_eq(rest, env, s, counter, level, ctx)
    } else {
      // General function call
      infer_call(hs, rest, env, s, counter, level, ctx)
    }
  } else {
    // Expression-headed call ((f x) y ...) — the callee is itself an
    // expression (chained call, or the use-desugaring output
    // `use x <- e; rest` → (e (lambda (x) rest))): infer the callee's
    // type and unify it against the arrow implied by the argument
    // list, so an int RHS (`use x <- 42`) is rejected at compile time
    // ("cannot unify int with ...") instead of crashing at runtime
    // with cannot-call-non-function.
    let rh = infer_expr(head, env, s, counter, level, ctx)
    infer_apply_expr(inf_ty(rh), rest, env, inf_s(rh), inf_c(rh), level, ctx)
  }
}

// infer_apply_expr(fn_t, args, env, s, counter, level, ctx) -> Inferred
// Like infer_apply, but the callee is an arbitrary expression (no symbol
// to name in the error context), so each unification failure is reported
// as a plain cannot-unify at the call site.
fn infer_apply_expr(fn_t : Ty, args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if null?(args) {
    Inferred(apply_subst(fn_t, s), s, counter)
  } else {
    let ret_fv = fresh(counter, level)
    let arg_fv = fresh(fresh_counter(ret_fv), level)
    let arrow = t_arrow(fresh_ty(arg_fv), fresh_ty(ret_fv))
    let s1 = unify_check(fn_t, arrow, s, ctx)
    let ra = infer_expr(car(args), env, s1, fresh_counter(arg_fv), level, ctx)
    let s2 = unify_check(inf_ty(ra), fresh_ty(arg_fv), inf_s(ra), ctx)
    infer_apply_expr(fresh_ty(ret_fv), cdr(args), env, s2, inf_c(ra), level, ctx)
  }
}

// collect_let_bindings(forms : List(form.Form)) -> list of let-bound symbols
// Collects every (let name val ...) binding name in a body. In braced blocks
// `let` is a statement whose binding extends to the rest of the block, but
// the typechecker's let form assumes Lisp-style nesting (body = remaining
// forms) — pre-registering the names with fresh tvars keeps block-scoped
// let-bound closures (e.g. f1/f2 in gc-closure-churn) from being flagged as
// undefined while staying type-loose, matching the runtime scoping.
//
// 参数是「表单表」：一个 body 就是表单表，而一个复合形式（`(let x v)`）在
// 单形式入口 collect_let_binding 里进来。旧版把两者混在一个未标注参数上
// （靠 pair? 猜），M4 拆成「表 / 单形式」两格。
fn collect_let_bindings(forms : List(form.Form)) -> List(Symbol) {
  if null?(forms) { nil }
  else {
    list.append(collect_let_binding(car(forms)), collect_let_bindings(cdr(forms)))
  }
}

// collect_let_binding(form : form.Form) -> list of let-bound symbols
// 「这个形式绑定谁」：(let name val rest...) 给出 name 与 rest 里的绑定；
// 其它复合形式扫它自己的元素（每个元素都当一个形式看）。
fn collect_let_binding(form : form.Form) -> List(Symbol) {
  match form {
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'let) {
        cons(form.sym_at(form.nth(items, 1)), collect_let_bindings(cdr(cdr(items))))
      } else {
        collect_let_bindings(items)
      }
    }
    form.FAtom(_) -> nil
  }
}

// extend_let_env(env, names, counter, level) -> EnvC
fn extend_let_env(env : List(EnvEntry), names : List(Symbol), counter : Int, level : Int) -> EnvC {
  if null?(names) { EnvC(env, counter) }
  else {
    // Skip names already bound (params, outer scope, builtins): pre-registering
    // them with a fresh tvar would shadow the real type in the let's own value
    // expression (e.g. fn f(x: string) { let x = x + 1 } must still fail).
    match env_find(env, car(names)) {
      option.Some(_) -> extend_let_env(env, cdr(names), counter, level)
      option.None -> {
        let fv = fresh(counter, level)
        let r = extend_let_env(extend(env, car(names), fresh_ty(fv)), cdr(names), fresh_counter(fv), level)
        EnvC(envc_env(r), envc_counter(r))
      }
    }
  }
}

// infer_lambda(params, body, env, s, counter, level, ctx, sig_types, ret_type)
//   -> Inferred
// ret_type is the optional return-type annotation (nil when absent); it is
// unified against the inferred body type when present.
fn infer_lambda(params : List(Symbol), body : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol), sig_types : List(Ty), ret_type : option.Option(Ty)) -> Inferred {
  if null?(params) {
    // No params — infer body; the closure type is the body type itself
    // (matches no-arg builtins like self/recv). A no-arg call f() then
    // yields the body type instead of an arrow.
    let lb = extend_let_env(env, collect_let_bindings(body), counter, level)
    let rb = infer_body(body, envc_env(lb), s, envc_counter(lb), level, ctx)
    let s2 = check_lambda_ret(inf_ty(rb), ret_type, inf_s(rb), ctx)
    Inferred(inf_ty(rb), s2, inf_c(rb))
  } else {
    let pname = car(params)
    let pnames = cdr(params)
    // Use the annotated param type when a type-sig is available, otherwise
    // create a fresh var for this param
    let fv = if null?(sig_types) {
      fresh(counter, level)
    } else {
      Fresh(car(sig_types), counter)
    }
    let ptype = fresh_ty(fv)
    let c1 = fresh_counter(fv)
    let new_env = extend(env, pname, ptype)
    // Recurse for remaining params
    if null?(pnames) {
      // Last param — infer body
      let lb = extend_let_env(new_env, collect_let_bindings(body), c1, level)
      let rb = infer_body(body, envc_env(lb), s, envc_counter(lb), level, ctx)
      let s2 = check_lambda_ret(inf_ty(rb), ret_type, inf_s(rb), ctx)
      Inferred(t_arrow(ptype, inf_ty(rb)), s2, inf_c(rb))
    } else {
      // More params — recurse. Params may outnumber the annotated
      // types (the extra params stay unconstrained), so the type-sig
      // list can run out before the params do — take its tail only
      // when it still has one.
      let sig_rest = if null?(sig_types) { nil } else { cdr(sig_types) }
      let inner = infer_lambda(pnames, body, new_env, s, c1, level, ctx, sig_rest, ret_type)
      Inferred(t_arrow(ptype, inf_ty(inner)), inf_s(inner), inf_c(inner))
    }
  }
}

// check_lambda_ret(body_t, ret_type, s, ctx) -> s
// Unify the inferred body type against an explicit return-type annotation
// (ret_type is None when the lambda has none). A mismatch is recorded in the
// subst, like other unification failures. ctx 是上下文路径（见 TcError）：
// 空表就是「没有函数上下文」。
fn check_lambda_ret(body_t : Ty, ret_type : option.Option(Ty), s : Subst, ctx : List(Symbol)) -> Subst {
  match ret_type {
    option.None -> s
    option.Some(t) -> unify_check(body_t, t, s, ctx)
  }
}

// infer_body(body, env, s, counter, level, ctx) -> Inferred
fn infer_body(body : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if null?(body) {
    let fv = fresh(counter, level)
    Inferred(fresh_ty(fv), s, fresh_counter(fv))
  } else {
    if null?(cdr(body)) {
      infer_expr(car(body), env, s, counter, level, ctx)
    } else {
      let r1 = infer_expr(car(body), env, s, counter, level, ctx)
      infer_body(cdr(body), env, inf_s(r1), inf_c(r1), level, ctx)
    }
  }
}

// infer_bool_args -> bool: 'and / 'or operands must be Bool.
fn infer_bool_args(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let r = fold_operands(args, t_bool(), StrictMismatch, env, s, counter, level, ctx)
  Inferred(t_bool(), step_s(r), step_c(r))
}

// infer_arith -> int: % is int-only (float % out of scope); the float-capable
// ops (+ - * /) use infer_num.
fn infer_arith(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let r = fold_operands(args, t_int(), StrictMismatch, env, s, counter, level, ctx)
  Inferred(t_int(), step_s(r), step_c(r))
}

// NumTy — 一个数值操作数收敛后的类型 + 替换。
type NumTy { NumTy(ty : Ty, s : Subst) }

fn numty_ty(r : NumTy) -> Ty { match r { NumTy(ty, _) -> ty } }
fn numty_s(r : NumTy) -> Subst { match r { NumTy(_, s) -> s } }

fn infer_num_operand(t : Ty, s : Subst, ctx : List(Symbol)) -> NumTy {
  let resolved = apply_subst(t, s)
  match resolved {
    TyBase(b) -> {
      match b {
        BInt -> NumTy(t, s)
        BFloat -> NumTy(t, s)
        _ -> NumTy(t_int(), unify_check(t, t_int(), s, ctx))
      }
    }
    _ -> NumTy(t, s)
  }
}

fn is_crash_div(head : Symbol, args : List(form.Form)) -> Bool {
  if head == '/ || head == '% {
    if null?(cdr(args)) {
      false
    } else {
      match form.nth(args, 1) {
        form.FAtom(ast.CInt(0)) -> true
        _ -> false
      }
    }
  } else {
    false
  }
}

fn infer_crash_div(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  let r = infer_num(args, env, s, counter, level, ctx, false)
  Inferred(t_never(), inf_s(r), inf_c(r))
}

fn infer_num(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol), any_float : Bool) -> Inferred {
  if null?(args) {
    if any_float { Inferred(t_float(), s, counter) }
    else { Inferred(t_int(), s, counter) }
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let operand = infer_num_operand(inf_ty(r1), inf_s(r1), ctx)
    let r2 = fold_operands(cdr(args), numty_ty(operand), StrictMismatch, env, numty_s(operand), inf_c(r1), level, ctx)
    Inferred(numty_ty(operand), step_s(r2), step_c(r2))
  }
}

// OperandMismatch: failure policy when an operand won't meet acc_t.
type OperandMismatch { StrictMismatch NilExemptMismatch }

// fold_operands -> SubstStep: meet each operand with acc_t, threading
// subst/counter. The caller wraps the value type (bool / int / the reference).
fn fold_operands(args : List(form.Form), acc_t : Ty, on_mismatch : OperandMismatch, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  if null?(args) {
    SubstStep(s, counter)
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let s2 = meet_operand(inf_ty(r1), acc_t, inf_s(r1), on_mismatch, ctx)
    fold_operands(cdr(args), acc_t, on_mismatch, env, s2, inf_c(r1), level, ctx)
  }
}

// meet_operand: unify operand with acc_t; on failure apply on_mismatch.
// The nil exemption runs only AFTER unify fails — checking it first would
// skip the `'a := Nil` binding on a free-tvar reference (behaviour contract, #92).
fn meet_operand(arg_t : Ty, acc_t : Ty, s : Subst, on_mismatch : OperandMismatch, ctx : List(Symbol)) -> Subst {
  let u = unify(arg_t, acc_t, s)
  if unified_ok(u) {
    unified_s(u)
  } else {
    match on_mismatch {
      StrictMismatch -> unify_check(arg_t, acc_t, s, ctx)
      NilExemptMismatch ->
      if t_is_nil(arg_t, s) == 1 || t_is_nil(acc_t, s) == 1 { s }
      else { unify_check(arg_t, acc_t, s, ctx) }
    }
  }
}

fn infer_cmp(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if null?(args) {
    Inferred(t_bool(), s, counter)
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = inf_ty(r1)
    let r2 = fold_operands(cdr(args), arg_t, StrictMismatch, env, inf_s(r1), inf_c(r1), level, ctx)
    let s2 = step_s(r2)
    let c2 = step_c(r2)
    // The reference operand must be numeric: int first, then float, else
    // report the error against int (old message).
    let ui = unify(arg_t, t_int(), s2)
    if unified_ok(ui) {
      Inferred(t_bool(), unified_s(ui), c2)
    } else {
      let uf = unify(arg_t, t_float(), s2)
      if unified_ok(uf) {
        Inferred(t_bool(), unified_s(uf), c2)
      } else {
        Inferred(t_bool(), unify_check(arg_t, t_int(), s2, ctx), c2)
      }
    }
  }
}

// t_is_nil(t, s) -> int (0/1): 1 when t resolves to the nil base type.
// Used by the == / != nil-exemption rule (issue #92 keeps nil == nil and
// x == nil legal across all operand types).
fn t_is_nil(t : Ty, s : Subst) -> Int {
  let rt = apply_subst(t, s)
  match rt {
    TyBase(BNil) -> 1
    _ -> 0
  }
}

fn infer_eq(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  if null?(args) {
    Inferred(t_bool(), s, counter)
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let r2 = fold_operands(cdr(args), inf_ty(r1), NilExemptMismatch, env, inf_s(r1), inf_c(r1), level, ctx)
    Inferred(t_bool(), step_s(r2), step_c(r2))
  }
}

fn infer_list_literal(elems : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  // The literal's type is list(E) where E unifies with every element
  // (issue #102: a bare fresh tvar orphaned the element constraints, so
  // list(list(string)) could slip through a call expecting list(int)).
  let elem_fv = fresh(counter, level)
  let ru = infer_list_elems(elems, fresh_ty(elem_fv), env, s, fresh_counter(elem_fv), level, ctx)
  Inferred(t_app('List, cons(fresh_ty(elem_fv), nil)), step_s(ru), step_c(ru))
}

fn infer_list_elems(elems : List(form.Form), elem_t : Ty, env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  if null?(elems) {
    SubstStep(s, counter)
  } else {
    let r1 = infer_expr(car(elems), env, s, counter, level, ctx)
    let s1 = unify_check(inf_ty(r1), elem_t, inf_s(r1), ctx)
    infer_list_elems(cdr(elems), elem_t, env, s1, inf_c(r1), level, ctx)
  }
}

fn infer_call(head : Symbol, args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> Inferred {
  // Look up function type in env
  match env_find(env, head) {
    option.Some(binding) -> {
      let inst = instantiate(entry_scheme(binding), counter, level)
      // Apply args one by one
      infer_apply(fresh_ty(inst), args, env, s, fresh_counter(inst), level, ctx, head, 1)
    }
    option.None -> {
      // Not found directly in env. Qualified references (mod.fn) resolve
      // through the module export namespace built at resolve time (issue #96
      // Phase B): pub members are registered under mod.fn, non-pub members
      // under mod$fn — invisible to qualified syntax. The old "strip the
      // module prefix and look up the bare base name" fallback is deleted:
      // a bare name from another module is now undefined, and a qualified
      // miss is reported as an export error.
      let ret_fv = fresh(counter, level)
      let c1 = fresh_counter(ret_fv)
      let s_name = str.sym_to_str(head)
      let dot = str.index_of(s_name, ".")
      if dot > 0 {
        let mod_name = str.substr(s_name, 0, dot)
        let xname = str.substr(s_name, dot + 1, str.length(s_name) - (dot + 1))
        // 一条规则：有声明才认。宿主模块（net/timer/cov…）不再豁免 —— 它们的
        // 名字要么来自 import 的 external fn 声明，要么来自本函数的 builtin
        // env 承诺表（见下方 net.*/file.*/cov.line）。删掉原「宿主前缀 ⇒ 未知
        // 调用按任意元数通过」的分支：那条路让 net.read 这类没声明的调用静默
        // 通过，把「名字打错」变成运行期错误。
        // TA 模块：区分「存在但不是 pub」（登记在 mod$xname）与「没有这个导出」。
        let priv_key = str.to_sym(str.concat(mod_name, str.concat("$", xname)))
        let name_sym = str.to_sym(xname)
        let mod_sym = str.to_sym(mod_name)
        let s_err = match env_find(env, priv_key) {
          option.None -> add_error(s, TcNoExport(ctx, name_sym, mod_sym))
          option.Some(_) -> add_error(s, TcNotExported(ctx, name_sym, mod_sym))
        }
        let ra = infer_args_for_unknown(args, env, s_err, c1, level, ctx)
        Inferred(fresh_ty(ret_fv), tlist_s(ra), tlist_c(ra))
      } else {
        let s_err = add_error(s, TcUndefinedFn(head, ctx))
        let ra = infer_args_for_unknown(args, env, s_err, c1, level, ctx)
        Inferred(fresh_ty(ret_fv), tlist_s(ra), tlist_c(ra))
      }
    }
  }
}

// infer_args_for_unknown(args, env, s, counter, level, ctx) -> TypedList
// Type the arguments of a call whose callee is unknown: no parameter type to
// meet, every argument stands on its own (errors inside them still surface).
fn infer_args_for_unknown(args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> TypedList {
  if null?(args) {
    TypedList(nil, s, counter)
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let rest = infer_args_for_unknown(cdr(args), env, inf_s(r1), inf_c(r1), level, ctx)
    TypedList(cons(inf_ty(r1), tlist_types(rest)), tlist_s(rest), tlist_c(rest))
  }
}

// extend_pat_env(env, names, counter, level) -> EnvC
// extend_let_env 的 pattern 专用版：无条件为每个 binder 预注册 fresh tvar，
// 不做「env 已有同名则跳过」。extend_let_env 的 skip 是给 let 的——RHS
// 必须看到外层 binding（`let x = x + 1` 语义）；但 match binder 是新
// binding，必须 shadow。整程序 typecheck 的 env 是全单元共享的平名字
// 空间：skip 会让本单元的 match binder 撞上其它单元（或导入方）的顶层
// define——dict.ta 的 binder `root` 曾因此继承导入方 `fn root` 的占位
// tvar，被上游 unify 成 Tree，导入方自己的 `fn root` 反被拒（issue #436）。
fn extend_pat_env(env : List(EnvEntry), names : List(Symbol), counter : Int, level : Int) -> EnvC {
  if null?(names) { EnvC(env, counter) }
  else {
    let fv = fresh(counter, level)
    let r = extend_pat_env(extend(env, car(names), fresh_ty(fv)), cdr(names), fresh_counter(fv), level)
    EnvC(envc_env(r), envc_counter(r))
  }
}

// collect_pat_vars(pat) -> list of binding symbols in a match/receive pattern
// Literals (int, string, nil/true/false atoms), the wildcard _, and quoted
// patterns bind nothing; a bare symbol is a binding; a constructor pattern
// (Ctor p1 p2 ...) recurses into its subpatterns.
//
// A pair pattern's HEAD symbol (bare `cons` of a list pattern, or the
// desugared (cons (quote Ctor) ...) tag) names the constructor — it is
// never a binder. Collecting it used to be masked by extend_let_env's
// skip (cons/Ctor names always exist in the whole-program env), but with
// extend_pat_env's unconditional shadowing it would shadow the builtin
// cons inside the arm and every cons(...) call in the body would unify
// against the scrutinee's element type (issue #436).
//
// Same for the leaf cases: an Uppercase bare symbol is a nullary
// constructor (Leaf, Ok, ...) — it names a binding that already exists in
// the whole-program env. A lowercase bare symbol is a catch-all binder and
// the only leaf that binds.
fn collect_pat_vars(pat : form.Form) -> List(Symbol) {
  match pat {
    form.FAtom(ast.CSym(name)) -> {
      if name == '_ {
        nil
      } else if is_uppercase_sym(name) == 1 {
        nil
      } else {
        cons(name, nil)
      }
    }
    form.FAtom(_) -> nil
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'quote) {
        nil
      } else {
        collect_pat_vars_list(cdr(items))
      }
    }
  }
}

fn collect_pat_vars_list(pats : List(form.Form)) -> List(Symbol) {
  if null?(pats) {
    nil
  } else {
    list.append(collect_pat_vars(car(pats)), collect_pat_vars_list(cdr(pats)))
  }
}

// infer_match_arms(arms, scrut_t, acc_t, env, s, counter, level, ctx) -> ArmsRef
// scrut_t / acc_t are Option(Ty): None means "nothing to constrain against"
// (receive, first arm), Some(t) carries the type to unify with.
fn infer_match_arms(arms : List(form.Form), scrut_t : option.Option(Ty), acc_t : option.Option(Ty), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> ArmsRef {
  if null?(arms) {
    ArmsRef(acc_t, s, counter)
  } else {
    // arm = (pat body) or (pat guard body)
    let items = form.items(car(arms))
    let pat = form.nth(items, 0)
    let has_guard = if null?(cdr(cdr(items))) { 0 } else { 1 }
    let body = if has_guard == 1 { form.nth(items, 2) } else { form.nth(items, 1) }
    let pe = extend_pat_env(env, collect_pat_vars(pat), counter, level)
    let penv = envc_env(pe)
    let pc = envc_counter(pe)
    // Pattern typing (issue #102): nil and (cons h t) patterns assert the
    // scrutinee is a list. cons ties the scrutinee to list(E) with E also
    // bound to h and list(E) bound to t, so element constraints (e.g.
    // h + 1 forcing int) flow into the scrutinee. receive passes
    // scrut_t = None and stays type-loose (a mailbox holds many types).
    let rp = infer_list_pat(pat, scrut_t, penv, s, pc, level, ctx)
    // 模式里的跨模块裸构造子（issue #462 P4）：`Some(v)` 而 Some 属于 option。
    // 走 pat_ctor_names 的递归遍历，match 与 receive 共用这一处。
    let s_p = bare_member_pat(pat, env, ctx, step_s(rp))
    let c_p = step_c(rp)
    let r = if has_guard == 1 {
      let rg = infer_expr(form.nth(items, 1), penv, s_p, c_p, level, ctx)
      infer_expr(body, penv, inf_s(rg), inf_c(rg), level, ctx)
    } else {
      infer_expr(body, penv, s_p, c_p, level, ctx)
    }
    match acc_t {
      // First arm: its body type is the reference all later arms unify with.
      option.None -> infer_match_arms(cdr(arms), scrut_t, option.Some(inf_ty(r)), env, inf_s(r), inf_c(r), level, ctx)
      option.Some(t) -> {
        let s_u = unify_check(inf_ty(r), t, inf_s(r), ctx)
        infer_match_arms(cdr(arms), scrut_t, acc_t, env, s_u, inf_c(r), level, ctx)
      }
    }
  }
}

fn infer_list_pat(pat : form.Form, scrut_t : option.Option(Ty), penv : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  match scrut_t {
    option.None -> SubstStep(s, counter)
    option.Some(st) -> {
      if is_ctor_pat(pat) == 1 {
        // ADT constructor pattern, routed out before the shape gate: that gate
        // only speaks about list(E) and a concrete ADT scrutinee is exactly the
        // case it rejects — which used to turn the whole arm loose (#442).
        infer_ctor_pat(pat, scrut_t, penv, s, counter, level, ctx)
      } else if pat_list_shape_ok(st, s) {
        if form.is_nil_form(pat) {
          let e = fresh(counter, level)
          let s1 = unify_check(st, t_app('List, cons(fresh_ty(e), nil)), s, ctx)
          SubstStep(s1, fresh_counter(e))
        } else if form.is_sym(form.nth(form.items(pat), 0), 'cons) {
          let ef = fresh(counter, level)
          let elem_t = fresh_ty(ef)
          let s1 = unify_check(st, t_app('List, cons(elem_t, nil)), s, ctx)
          let tail_t = t_app('List, cons(elem_t, nil))
          let s2 = bind_cons_chain(pat, elem_t, tail_t, penv, s1)
          SubstStep(s2, fresh_counter(ef))
        } else {
          SubstStep(s, counter)
        }
      } else {
        SubstStep(s, counter)
      }
    }
  }
}

// is_ctor_pat(pat) -> 1 when pat is the parser's constructor encoding
// (tuple (quote Name) p1 ... pN): a quoted tag in slot 0 marks an ADT
// constructor pattern, not a builtin tuple destructure.
fn is_ctor_pat(pat : form.Form) -> Int {
  match pat {
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'tuple) {
        match form.nth(items, 1) {
          form.FList(tag) -> if form.is_sym(form.nth(tag, 0), 'quote) { 1 } else { 0 }
          form.FAtom(_) -> 0
        }
      } else {
        0
      }
    }
    form.FAtom(_) -> 0
  }
}

fn infer_ctor_pat(pat : form.Form, scrut_t : option.Option(Ty), penv : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  match ctor_form(pat) {
    option.None -> SubstStep(s, counter)
    option.Some(cf) -> {
      match ctor_binding(form.sym_at(car(cf)), penv) {
        option.None -> SubstStep(s, counter)
        option.Some(binding) -> {
          let inst = instantiate(entry_scheme(binding), counter, level)
          let s1 = unify_loose_opt(scrut_t, arrow_result(fresh_ty(inst)), s)
          bind_ctor_fields(cdr(cf), arrow_params(fresh_ty(inst)), penv, s1, fresh_counter(inst), level, ctx)
        }
      }
    }
  }
}

// unify_loose_opt(scrut_t, t, s) -> s：只在有 scrutinee 类型时才约束它。
fn unify_loose_opt(scrut_t : option.Option(Ty), t : Ty, s : Subst) -> Subst {
  match scrut_t {
    option.None -> s
    option.Some(st) -> unify_loose(st, t, s)
  }
}

// bind_ctor_fields(pats, ftypes, penv, s, counter, level, ctx) -> SubstStep
fn bind_ctor_fields(pats : List(form.Form), ftypes : List(Ty), penv : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  if null?(pats) {
    SubstStep(s, counter)
  } else if null?(ftypes) {
    SubstStep(s, counter)
  } else {
    let r = bind_ctor_field(car(pats), car(ftypes), penv, s, counter, level, ctx)
    bind_ctor_fields(cdr(pats), cdr(ftypes), penv, step_s(r), step_c(r), level, ctx)
  }
}

fn bind_ctor_field(pat : form.Form, ft : Ty, penv : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol)) -> SubstStep {
  match pat {
    form.FList(_) -> {
      if is_ctor_pat(pat) == 1 {
        infer_ctor_pat(pat, option.Some(ft), penv, s, counter, level, ctx)
      } else if form.is_sym(form.nth(form.items(pat), 0), 'cons) {
        infer_list_pat(pat, option.Some(ft), penv, s, counter, level, ctx)
      } else {
        SubstStep(s, counter)
      }
    }
    // A lowercase name is the binder and takes ft; `_`, an Uppercase name (a
    // nullary constructor) and any literal atom bind nothing here.
    form.FAtom(ast.CSym(name)) -> {
      if name == wildcard() {
        SubstStep(s, counter)
      } else if is_uppercase_sym(name) == 1 {
        SubstStep(s, counter)
      } else {
        SubstStep(bind_pat_var(pat, ft, penv, s), counter)
      }
    }
    form.FAtom(_) -> SubstStep(s, counter)
  }
}

fn bind_cons_chain(pat : form.Form, elem_t : Ty, tail_t : Ty, penv : List(EnvEntry), s : Subst) -> Subst {
  match pat {
    form.FList(_) -> {
      let items = form.items(pat)
      if form.is_sym(form.nth(items, 0), 'cons) {
        let s1 = bind_pat_var(form.nth(items, 1), elem_t, penv, s)
        bind_cons_chain(form.nth(items, 2), elem_t, tail_t, penv, s1)
      } else {
        bind_pat_var(pat, tail_t, penv, s)
      }
    }
    form.FAtom(_) -> bind_pat_var(pat, tail_t, penv, s)
  }
}

// pat_list_shape_ok(t): the pattern constraint applies when t is an
// unresolved tvar (refine it to list(E)) or already a list type. Anything
// else (int/string/bool/pid/symbol/arrow from the loose cons semantics) is
// left alone — see the weak-typing note above.
fn pat_list_shape_ok(t : Ty, s : Subst) -> Bool {
  let t2 = apply_subst(t, s)
  match t2 {
    TyVar(_, _) -> true
    TyApp(name, _) -> name == 'List
    _ -> false
  }
}

// wildcard() — 模式里的 `_` 符号。写成 `'_'` 是**字符字面量**（一个 Int），
// 符号得从文本造；符号按名字 intern，与 parser 造出来的 `_` 相等。
fn wildcard() -> Symbol { str.to_sym("_") }

// bind_pat_var(pat, t, penv, s) -> s
// Constrain a pattern-bound name's pre-registered tvar to type t. Only a
// symbol that penv pre-registered is a binder: a literal, a nested pattern or
// `_` binds nothing. Plain unify: an unbound tvar binds (the normal case); a
// name that shadows an already-typed binding stays type-loose.
fn bind_pat_var(pat : form.Form, t : Ty, penv : List(EnvEntry), s : Subst) -> Subst {
  match pat {
    form.FAtom(ast.CSym(name)) -> {
      if name == wildcard() {
        s
      } else {
        match env_find(penv, name) {
          option.None -> s
          option.Some(entry) -> unify_loose(entry_scheme(entry), t, s)
        }
      }
    }
    _ -> s
  }
}

// unify_loose(x, y, s) -> s, or s unchanged when x and y cannot unify.
// The forgiving half of pattern typing: a pattern may legitimately be looser
// than the declaration it destructures (weak-typing artifacts, a binder that
// shadows a typed name), and a refusal there must not become a diagnostic.
fn unify_loose(x : Ty, y : Ty, s : Subst) -> Subst {
  let u = unify(x, y, s)
  if unified_ok(u) { unified_s(u) } else { s }
}

fn check_pair_arg(head : Symbol, arg : form.Form, arg_t : Ty, s : Subst, ctx : List(Symbol)) -> Subst {
  if head == 'car {
    check_nil_pair_arg(arg, arg_t, s, ctx)
  } else if head == 'cdr {
    check_nil_pair_arg(arg, arg_t, s, ctx)
  } else {
    s
  }
}

fn check_nil_pair_arg(arg : form.Form, arg_t : Ty, s : Subst, ctx : List(Symbol)) -> Subst {
  if form.is_nil_form(arg) {
    nil_pair_mismatch(s, ctx)
  } else if t_is_nil(arg_t, s) == 1 {
    nil_pair_mismatch(s, ctx)
  } else {
    s
  }
}

// Recorded as a plain type mismatch so E0001 renders where it belongs:
// "in function 'f': arg 1 of car: cannot unify nil with pair".
fn nil_pair_mismatch(s : Subst, ctx : List(Symbol)) -> Subst {
  add_error(s, TcMismatch(ctx, t_nil(), t_pair()))
}

// infer_apply(fn_t, args, env, s, counter, level, ctx, head, idx) -> Inferred
// Unifies fn_t with arrow types for each argument. Failures are tagged with
// the argument position (ctx grows an "arg N of name" step) so the driver can
// report which argument of which call was wrong.
fn infer_apply(fn_t : Ty, args : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int, ctx : List(Symbol), head : Symbol, idx : Int) -> Inferred {
  if null?(args) {
    Inferred(apply_subst(fn_t, s), s, counter)
  } else {
    // Fresh var for result
    let ret_fv = fresh(counter, level)
    // Create arrow type: arg_type -> ret_t
    let arg_fv = fresh(fresh_counter(ret_fv), level)
    let arrow = t_arrow(fresh_ty(arg_fv), fresh_ty(ret_fv))
    // Tag this failure with the argument position
    let detail = str.concat("arg ", str.concat(str.from_int(idx), str.concat(" of ", str.sym_to_str(head))))
    let ctx2 = ctx_push(ctx, str.to_sym(detail))
    // Unify fn_t with arrow
    let s1 = unify_check(fn_t, arrow, s, ctx2)
    // Infer actual argument, unify with arg_t
    let ra = infer_expr(car(args), env, s1, fresh_counter(arg_fv), level, ctx2)
    let s2b = check_pair_arg(head, car(args), inf_ty(ra), inf_s(ra), ctx2)
    let s3 = unify_check(inf_ty(ra), fresh_ty(arg_fv), s2b, ctx2)
    // Recurse with remaining args
    infer_apply(fresh_ty(ret_fv), cdr(args), env, s3, inf_c(ra), level, ctx, head, idx + 1)
  }
}

// ============================================================
// Program-level inference
// ============================================================

// Tvars — 一串新造的 tvar + 下一个计数器。
type Tvars { Tvars(types : List(Ty), counter : Int) }

fn tvars_types(r : Tvars) -> List(Ty) { match r { Tvars(types, _) -> types } }
fn tvars_counter(r : Tvars) -> Int { match r { Tvars(_, counter) -> counter } }

// make_fresh_tvars(fields, counter) -> Tvars
fn make_fresh_tvars(fields : List(Ty), counter : Int) -> Tvars {
  match fields {
    nil -> Tvars(nil, counter)
    cons(_, rest) -> {
      let fv = fresh(counter, 0)
      let rp = make_fresh_tvars(rest, fresh_counter(fv))
      Tvars(cons(fresh_ty(fv), tvars_types(rp)), tvars_counter(rp))
    }
  }
}

// tvar_ids(tvars) -> list of ids
fn tvar_ids(tvars : List(Ty)) -> List(Int) {
  match tvars {
    nil -> nil
    cons(tv, rest) -> cons(tvar_id(tv), tvar_ids(rest))
  }
}

// build_ctor_arrow(fields, result) -> curried arrow type ending in result
fn build_ctor_arrow(fields : List(Ty), result : Ty) -> Ty {
  match fields {
    nil -> result
    cons(f, rest) -> t_arrow(f, build_ctor_arrow(rest, result))
  }
}

// ParamBind — 一个类型参数在其声明里的代表 tvar（`type Option(a) { ... }`
// 里的 a）。
type ParamBind { ParamBind(name : Symbol, ty : Ty) }

fn pb_name(b : ParamBind) -> Symbol { match b { ParamBind(name, _) -> name } }
fn pb_ty(b : ParamBind) -> Ty { match b { ParamBind(_, ty) -> ty } }

// Params — 参数表 + 下一个计数器。
type Params { Params(binds : List(ParamBind), counter : Int) }

fn params_binds(r : Params) -> List(ParamBind) { match r { Params(binds, _) -> binds } }
fn params_counter(r : Params) -> Int { match r { Params(_, counter) -> counter } }

// build_param_map(params, counter) -> Params
// binds 与 params 同序：每个名字配一个 tvar。
fn build_param_map(params : List(Symbol), counter : Int) -> Params {
  match params {
    nil -> Params(nil, counter)
    cons(p, rest) -> {
      let fv = fresh(counter, 0)
      let rp = build_param_map(rest, fresh_counter(fv))
      Params(cons(ParamBind(p, fresh_ty(fv)), params_binds(rp)), params_counter(rp))
    }
  }
}

// param_map_tvars(param_map) -> list of tvar types
fn param_map_tvars(param_map : List(ParamBind)) -> List(Ty) {
  match param_map {
    nil -> nil
    cons(binding, rest) -> cons(pb_ty(binding), param_map_tvars(rest))
  }
}

// param_map_ids(param_map) -> list of tvar ids
fn param_map_ids(param_map : List(ParamBind)) -> List(Int) {
  match param_map {
    nil -> nil
    cons(binding, rest) -> cons(tvar_id(pb_ty(binding)), param_map_ids(rest))
  }
}

// resolve_field_list(fields : List(form.Form), param_map) -> list of types
fn resolve_field_list(fields : List(form.Form), param_map : List(ParamBind)) -> List(Ty) {
  if null?(fields) {
    nil
  } else {
    cons(resolve_field_type(car(fields), param_map), resolve_field_list(cdr(fields), param_map))
  }
}

// ctor_form(expr : form.Form) -> option.Option(List(form.Form))
// `(tuple (quote Name) args...)` → `(Name args...)`（头是名字的符号节点，
// 尾是实参表）；其它形状 → None。名字与实参一起给出，省得调用方再嗅一遍形状。
fn ctor_form(expr : form.Form) -> option.Option(List(form.Form)) {
  match expr {
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'tuple) {
        let tag = form.items(form.nth(items, 1))
        if form.is_sym(form.nth(tag, 0), 'quote) {
          option.Some(cons(form.nth(tag, 1), cdr(cdr(items))))
        } else {
          option.None
        }
      } else {
        option.None
      }
    }
    form.FAtom(_) -> option.None
  }
}

// === 签名运输：env 条目 ⇄ form ===
//
// 签名缓存（lib/bootstrap/modsig.ta）把 env 条目跨进程搬走，走的是 `.kl` 文本。
// 文本两端都是 form.Form —— 一棵**同质**树：条目里的每个元素都是同一个类型，
// 于是整份编码是 `List(form.Form)`，不再是「按位置堆异构点对」。Ty 在 form 上
// 是逐层展开的定长形状（Ty / Base 的 arity 由声明固定），装载按同一张 schema
// 收回 record —— 写和读是同一个 codec 的两面，modsig 的 TASIG 版本号一起管它们。
//
//   (name ty <form>)                     普通条目，form = ty_form(scheme)
//   (name ctor <form>)                   构造子条目，同一份 form（scheme 即该类型）
//   (name typedecl (<v>...) <fields>)     类型名条目：变体名 + 变体表
//
// 文本形状与迁移前逐字节一致（`.sig` 哈希按字节取，改一个空格缓存就全失效）。
pub fn env_forms(env : List(EnvEntry)) -> List(form.Form) {
  match env {
    nil -> nil
    cons(e, rest) -> {
      match e {
        // 元数表是本地推断出来的索引，不是签名的一部分。
        ArityTable(_) -> env_forms(rest)
        _ -> cons(env_form(e), env_forms(rest))
      }
    }
  }
}

// exports_form(bindings) — 缓存文件里的整段导出：`(exports <entry>...)`。
// 一棵同质 form 树，modsig 直接 kl.write_flat 就行。
pub fn exports_form(bindings : List(EnvEntry)) -> form.Form {
  form.FList(cons(form.sym('exports), env_forms(bindings)))
}

fn env_form(e : EnvEntry) -> form.Form {
  match e {
    Bind(name, scheme) -> form.FList([form.sym(name), form.sym('ty), ty_form(scheme)])
    Ctor(name, scheme) -> form.FList([form.sym(name), form.sym('ctor), ty_form(scheme)])
    TypeDecl(name, variants, fields) -> form.FList([form.sym(name), form.sym('typedecl),
    form.lst(form.syms_form(variants)), form.lst(variant_forms(fields))])
    ArityTable(_) -> form.lst(nil)
  }
}

// env_of_forms(forms) -> env 条目（与 env_forms 写出的顺序一致）。词表之外的
// 形状读不出条目：它不可能出自本编译器（modsig 的版本标签先拦住了别家写的
// 缓存），与其猜一个，不如不给条目。
pub fn env_of_forms(forms : List(form.Form)) -> List(EnvEntry) {
  match forms {
    nil -> nil
    cons(f, rest) -> {
      match env_of_form(f) {
        option.None -> env_of_forms(rest)
        option.Some(e) -> cons(e, env_of_forms(rest))
      }
    }
  }
}

fn env_of_form(f : form.Form) -> option.Option(EnvEntry) {
  let items = form.items(f)
  let name = form.sym_at(form.nth(items, 0))
  let tag = form.nth(items, 1)
  if form.is_sym(tag, 'ty) {
    option.Some(Bind(name, ty_of_form(form.nth(items, 2))))
  } else if form.is_sym(tag, 'ctor) {
    option.Some(Ctor(name, ty_of_form(form.nth(items, 2))))
  } else if form.is_sym(tag, 'typedecl) {
    option.Some(TypeDecl(name, form.syms(form.items(form.nth(items, 2))),
    variant_tables_of_form(form.items(form.nth(items, 3)))))
  } else {
    option.None
  }
}

// ---------- Ty ⇄ form ----------

// tag_form(spelling) — 一个标签的 form 拼写：`.kl` 文本里的字面量就是这个
// 名字（装载侧 ty_of_form / base_of_form 按同一张 schema 收回 record）。符号
// 从字符串造：`'TyBase` 在这份源码里被解析成构造子引用，不是符号。
fn tag_form(spelling : String) -> form.Form { form.FAtom(ast.CSym(str.to_sym(spelling))) }

// is_tag(f, spelling) -> f 是不是标签 spelling。
fn is_tag(f : form.Form, spelling : String) -> Bool {
  form.is_sym(f, str.to_sym(spelling))
}

fn ty_form(t : Ty) -> form.Form {
  match t {
    TyBase(b) -> form.FList([tag_form("TyBase"), base_form(b)])
    TyVar(id, level) -> form.FList([tag_form("TyVar"), int_form(id), int_form(level)])
    TyArrow(from, to) -> form.FList([tag_form("TyArrow"), ty_form(from), ty_form(to)])
    TyApp(name, args) -> form.FList([tag_form("TyApp"), form.sym(name), form.lst(ty_forms(args))])
    TyForall(ids, body) -> form.FList([tag_form("TyForall"), form.lst(int_forms(ids)), ty_form(body)])
  }
}

fn ty_forms(ts : List(Ty)) -> List(form.Form) {
  match ts {
    nil -> nil
    cons(t, rest) -> cons(ty_form(t), ty_forms(rest))
  }
}

fn int_forms(is : List(Int)) -> List(form.Form) {
  match is {
    nil -> nil
    cons(i, rest) -> cons(int_form(i), int_forms(rest))
  }
}

fn int_form(i : Int) -> form.Form { form.FAtom(ast.CInt(i)) }

// base_form(b) — 无载荷 base 就写成它的标签本身（`BInt`），BName 带名字载荷。
fn base_form(b : Base) -> form.Form {
  match b {
    BName(name) -> form.FList([tag_form("BName"), form.sym(name)])
    BInt -> tag_form("BInt")
    BFloat -> tag_form("BFloat")
    BBool -> tag_form("BBool")
    BString -> tag_form("BString")
    BNil -> tag_form("BNil")
    BNever -> tag_form("BNever")
    BSymbol -> tag_form("BSymbol")
    BPair -> tag_form("BPair")
    BPid -> tag_form("BPid")
  }
}

// ty_of_form(form) -> Ty。装载只按 schema 逐字段收，不做动态构造。读坏了不会
// 崩：落到底部类型上（与一切相容且不绑定任何一边，ty_of_form 的旧约定）。
fn ty_of_form(f : form.Form) -> Ty {
  let items = form.items(f)
  let tag_f = form.nth(items, 0)
  if is_tag(tag_f, "TyBase") {
    TyBase(base_of_form(form.nth(items, 1)))
  } else if is_tag(tag_f, "TyVar") {
    TyVar(form_int(form.nth(items, 1)), form_int(form.nth(items, 2)))
  } else if is_tag(tag_f, "TyArrow") {
    TyArrow(ty_of_form(form.nth(items, 1)), ty_of_form(form.nth(items, 2)))
  } else if is_tag(tag_f, "TyApp") {
    TyApp(form.sym_at(form.nth(items, 1)), ty_args_of_form(form.items(form.nth(items, 2))))
  } else if is_tag(tag_f, "TyForall") {
    TyForall(int_args_of_form(form.items(form.nth(items, 1))), ty_of_form(form.nth(items, 2)))
  } else {
    t_never()
  }
}

fn ty_args_of_form(items : List(form.Form)) -> List(Ty) {
  match items {
    nil -> nil
    cons(f, rest) -> cons(ty_of_form(f), ty_args_of_form(rest))
  }
}

fn int_args_of_form(items : List(form.Form)) -> List(Int) {
  match items {
    nil -> nil
    cons(f, rest) -> cons(form_int(f), int_args_of_form(rest))
  }
}

// form_int(f) -> 原子里的整数，非整数为 0（本文件写出的形状里恒为整数）。
fn form_int(f : form.Form) -> Int {
  match f {
    form.FAtom(ast.CInt(n)) -> n
    _ -> 0
  }
}

fn base_of_form(f : form.Form) -> Base {
  match f {
    form.FAtom(_) -> base_of_named(form.sym_at(f))
    form.FList([tag, name]) -> if is_tag(tag, "BName") { BName(form.sym_at(name)) } else { BNever }
    form.FList(_) -> BNever
  }
}

// base_of_named(name) — 无载荷的 base 就写成它的名字本身。
// base_of_named(name) — 无载荷 base 就写成它的名字本身，按同一张 schema 比较
// （名字是 form 层里的符号，比对用文本，避免依赖符号在 lowered 后怎么拼）。
fn base_of_named(name : Symbol) -> Base {
  let s = str.sym_to_str(name)
  if s == "BInt" { BInt }
  else if s == "BFloat" { BFloat }
  else if s == "BBool" { BBool }
  else if s == "BString" { BString }
  else if s == "BNil" { BNil }
  else if s == "BNever" { BNever }
  else if s == "BSymbol" { BSymbol }
  else if s == "BPair" { BPair }
  else if s == "BPid" { BPid }
  else { BNever }
}

// ---------- 变体字段表 ⇄ form ----------

fn variant_forms(tables : List(VariantTable)) -> List(form.Form) {
  match tables {
    nil -> nil
    cons(t, rest) -> cons(variant_form(t), variant_forms(rest))
  }
}

fn variant_form(t : VariantTable) -> form.Form {
  form.FList([form.sym(vt_name(t)), int_form(vt_arity(t)), form.lst(label_forms(vt_labels(t)))])
}

fn label_forms(slots : List(LabelSlot)) -> List(form.Form) {
  match slots {
    nil -> nil
    cons(s, rest) -> {
      match s {
        LabelSlot(label, slot) -> cons(form.FList([form.sym(label), int_form(slot)]), label_forms(rest))
      }
    }
  }
}

fn variant_tables_of_form(items : List(form.Form)) -> List(VariantTable) {
  match items {
    nil -> nil
    cons(f, rest) -> cons(variant_of_form(f), variant_tables_of_form(rest))
  }
}

fn variant_of_form(f : form.Form) -> VariantTable {
  let items = form.items(f)
  VariantTable(form.sym_at(form.nth(items, 0)), form_int(form.nth(items, 1)),
  label_slots_of_form(form.items(form.nth(items, 2))))
}

fn label_slots_of_form(items : List(form.Form)) -> List(LabelSlot) {
  match items {
    nil -> nil
    cons(f, rest) -> cons(label_slot_of_form(f), label_slots_of_form(rest))
  }
}

fn label_slot_of_form(f : form.Form) -> LabelSlot {
  let items = form.items(f)
  LabelSlot(form.sym_at(form.nth(items, 0)), form_int(form.nth(items, 1)))
}

// param_find(binds, name) — 类型参数表里按名字找它的代表 tvar。
fn param_find(binds : List(ParamBind), name : Symbol) -> option.Option(ParamBind) {
  match binds {
    nil -> option.None
    cons(b, rest) -> match b {
      ParamBind(n, _) -> if n == name { option.Some(b) } else { param_find(rest, name) }
    }
  }
}

// PolyMap — 隐式泛型参数的收集结果：名字→tvar 表、下一个计数器、新分配的
// tvar id 表（量化的顺序）。
type PolyMap { PolyMap(binds : List(ParamBind), counter : Int, ids : List(Int)) }

fn pmap_binds(r : PolyMap) -> List(ParamBind) { match r { PolyMap(binds, _, _) -> binds } }
fn pmap_counter(r : PolyMap) -> Int { match r { PolyMap(_, counter, _) -> counter } }
fn pmap_ids(r : PolyMap) -> List(Int) { match r { PolyMap(_, _, ids) -> ids } }

// poly_field_map(fields, param_map, counter, acc_map, acc_ids) -> PolyMap
// 把字段里出现的裸小写类型名抬成隐式类型参数（如 Add(a, b) 的 a/b），每个
// 新名字配一个 tvar，得到的映射接在 acc_map（初值是声明里的参数表）后面。
fn poly_field_map(fields : List(form.Form), param_map : List(ParamBind), counter : Int, acc_map : List(ParamBind), acc_ids : List(Int)) -> PolyMap {
  if null?(fields) {
    PolyMap(acc_map, counter, acc_ids)
  } else {
    let field = car(fields)
    if form.is_sym_form(field) {
      let name = form.sym_at(field)
      if option.is_some(param_find(param_map, name)) {
        // 声明里已给的参数：用它，不再新建。
        poly_field_map(cdr(fields), param_map, counter, acc_map, acc_ids)
      } else if is_uppercase_sym(name) == 1 {
        // 大写裸名是具体类型（BInt/Pid/…），不是参数。
        poly_field_map(cdr(fields), param_map, counter, acc_map, acc_ids)
      } else if option.is_some(param_find(acc_map, name)) {
        poly_field_map(cdr(fields), param_map, counter, acc_map, acc_ids)
      } else {
        let fv = fresh(counter, 0)
        poly_field_map(cdr(fields), param_map, fresh_counter(fv),
        cons(ParamBind(name, fresh_ty(fv)), acc_map),
        cons(tvar_id(fresh_ty(fv)), acc_ids))
      }
    } else {
      poly_field_map(cdr(fields), param_map, counter, acc_map, acc_ids)
    }
  }
}

// resolve_field_type(field : form.Form, param_map : List(ParamBind)) -> Ty
// field is a symbol (type param or concrete type name) or a pair
// (Name args...) -> t_app. Uppercase bare symbols are concrete base types.
fn resolve_field_type(field : form.Form, param_map : List(ParamBind)) -> Ty {
  if form.is_sym_form(field) {
    let sym = form.sym_at(field)
    match param_find(param_map, sym) {
      option.Some(b) -> pb_ty(b)
      option.None -> t_base(sym)
    }
  } else {
    // Field is either a plain type application (Name arg1 ...), a
    // parser-built cons chain (cons (quote Name) (cons arg1 ...)), or a
    // by-name reference to a non-generic ADT ((quote Name)).
    match ctor_form(field) {
      option.Some(cf) -> {
        t_app(form.sym_at(car(cf)), resolve_field_list(cdr(cf), param_map))
      }
      option.None -> {
        let items = form.items(field)
        if form.is_sym(form.nth(items, 0), 'quote) {
          t_base(form.sym_at(form.nth(items, 1)))
        } else {
          t_app(form.sym_at(form.nth(items, 0)), resolve_field_list(cdr(items), param_map))
        }
      }
    }
  }
}

// collect_variants(variants, type_name, type_params, env, counter) -> EnvC
fn collect_variants(variants : List(form.Form), type_name : Symbol, type_params : List(Symbol), env : List(EnvEntry), counter : Int) -> EnvC {
  let pmr = build_param_map(type_params, counter)
  let param_map = params_binds(pmr)
  let result_t = if null?(type_params) {
    t_base(type_name)
  } else {
    t_app(type_name, param_map_tvars(param_map))
  }
  collect_variants_loop(variants, type_name, result_t, param_map_ids(param_map), param_map, env, params_counter(pmr))
}

fn collect_variants_loop(variants : List(form.Form), type_name : Symbol, result_t : Ty, quantified_ids : List(Int), param_map : List(ParamBind), env : List(EnvEntry), counter : Int) -> EnvC {
  if null?(variants) {
    EnvC(env, counter)
  } else {
    let variant = car(variants)
    let vitems = form.items(variant)
    if form.is_sym(form.nth(vitems, 0), 'quote) {
      // nullary: (quote V)
      let vname = form.sym_at(form.nth(vitems, 1))
      let scheme = if null?(quantified_ids) { result_t } else { t_forall(quantified_ids, result_t) }
      collect_variants_loop(cdr(variants), type_name, result_t, quantified_ids, param_map, cons(Ctor(vname, scheme), env), counter)
    } else {
      // n-ary: (Ctor f1 f2 ...), each field a (label type) pair.
      let ctor_name = form.sym_at(form.nth(vitems, 0))
      let fields = field_types(cdr(vitems))
      // Lift bare lowercase fields to implicit polymorphic params
      // (e.g. Add(a, b)), quantified per construction. Start from the
      // declared param_map so type params stay resolvable.
      let pr = poly_field_map(fields, param_map, counter, param_map, nil)
      let resolved_fields = resolve_field_list(fields, pmap_binds(pr))
      let arrow_t = build_ctor_arrow(resolved_fields, result_t)
      let scheme_ids = list.append(quantified_ids, pmap_ids(pr))
      let scheme = if null?(scheme_ids) { arrow_t } else { t_forall(scheme_ids, arrow_t) }
      collect_variants_loop(cdr(variants), type_name, result_t, quantified_ids, param_map, cons(Ctor(ctor_name, scheme), env), pmap_counter(pr))
    }
  }
}

// DeclRef — 声明扫描 pass 带下去的四样：env、subst、计数器、已见顶层名。
type DeclRef { DeclRef(env : List(EnvEntry), s : Subst, counter : Int, seen : List(Symbol)) }

fn declr_env(r : DeclRef) -> List(EnvEntry) { match r { DeclRef(env, _, _, _) -> env } }
fn declr_s(r : DeclRef) -> Subst { match r { DeclRef(_, s, _, _) -> s } }
fn declr_counter(r : DeclRef) -> Int { match r { DeclRef(_, _, counter, _) -> counter } }
fn declr_seen(r : DeclRef) -> List(Symbol) { match r { DeclRef(_, _, _, seen) -> seen } }

// collect_type_decls(forms, env, s, counter, seen) -> DeclRef
// Pass 0: register ADT constructors so they can be used before definition order.
// 声明期撞名（#289）在这里也做一遍：类型名和它的构造器名与 define/const 共用
// 同一张顶层符号表（pass 1 接着用这套 seen），于是「两个类型声明同一个构造器」
// 或「构造器与函数同名」在声明处就报 E0006，而不是后注册的静默盖掉前一个。
fn collect_type_decls(forms : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, seen : List(Symbol)) -> DeclRef {
  if null?(forms) {
    DeclRef(env, s, counter, seen)
  } else {
    let items = form.items(car(forms))
    if form.is_sym(form.nth(items, 0), 'type) {
      let type_name = form.sym_at(form.nth(items, 1))
      let type_params = form.syms(form.items(form.nth(items, 2)))
      let variants = cdr(cdr(cdr(items)))
      let ds = dup_scan_decl(type_name, variant_names(variants), s, seen)
      let pr = collect_variants(variants, type_name, type_params, env, counter)
      // Also register the type name → variant list so match
      // exhaustiveness checking (issue #118) can find the variants of
      // a scrutinee's ADT, and the per-variant label tables beside it so
      // field access / record update can resolve a label to a slot.
      let env_types = cons(TypeDecl(type_name, variant_names(variants), variant_label_tables(variants)), envc_env(pr))
      collect_type_decls(cdr(forms), env_types, dup_s(ds), envc_counter(pr), dup_seen(ds))
    } else {
      collect_type_decls(cdr(forms), env, s, counter, seen)
    }
  }
}

// === Exhaustiveness checking (issue #118) ===
//
// A match over a known ADT must cover every variant, or contain a
// wildcard/binding arm. Missing variants are recorded as 'tc_nonexh error
// entries in the subst — compilation is rejected (Gleam semantics, #118).

// field_types(fields : List(form.Form)) -> list of field types, labels dropped.
// A variant field is (label type); the label is nil when the declaration
// did not name it (parser: parse_variant_fields). Type-level consumers (ctor
// scheme, arity) only ever see types.
fn field_types(fields : List(form.Form)) -> List(form.Form) {
  if null?(fields) {
    nil
  } else {
    cons(form.nth(form.items(car(fields)), 1), field_types(cdr(fields)))
  }
}

// variant_field_labels(fields : List(form.Form), slot) -> List(LabelSlot)
// Only the labelled fields appear; slot is 1-based in declaration order,
// which is what (tuple-ref t slot) reads (slot 0 is the constructor tag).
fn variant_field_labels(fields : List(form.Form), slot : Int) -> List(LabelSlot) {
  if null?(fields) {
    nil
  } else {
    let label = form.nth(form.items(car(fields)), 0)
    if form.is_nil_form(label) {
      variant_field_labels(cdr(fields), slot + 1)
    } else {
      cons(LabelSlot(form.sym_at(label), slot), variant_field_labels(cdr(fields), slot + 1))
    }
  }
}

// variant_field_table(variant : form.Form) -> VariantTable
// One variant's whole shape as far as labels are concerned: how many fields
// the constructor takes, and which slot each label names. Arity is not
// redundant with the label list — a declaration may label only some fields
// (`P(int, y : int)`), and `P(..p, y: 3)` still has to copy every slot.
fn variant_field_table(variant : form.Form) -> VariantTable {
  let items = form.items(variant)
  if form.is_sym(form.nth(items, 0), 'quote) {
    VariantTable(form.sym_at(form.nth(items, 1)), 0, nil)
  } else {
    let fields = cdr(items)
    VariantTable(form.sym_at(form.nth(items, 0)), list.length(fields), variant_field_labels(fields, 1))
  }
}

// variant_label_tables(variants : List(form.Form)) -> List(VariantTable)
// Every variant's field table in declaration order — the one place where
// "where does `.f` / `..r` point" is decided, derived from the declaration
// and never stored twice.
fn variant_label_tables(variants : List(form.Form)) -> List(VariantTable) {
  if null?(variants) {
    nil
  } else {
    cons(variant_field_table(car(variants)), variant_label_tables(cdr(variants)))
  }
}

// ctor_label_tables(forms : List(form.Form)) -> List(VariantTable) for every
// type declared in forms, flat and in declaration order.
// typecheck builds the same tables into the env for its own use
// (variant_label_tables); the driver needs them again after inference, to
// expand ('ctor.labels ...) forms into tuples. It cannot borrow the env's copy:
// a module whose body came from the signature cache was never inferred, and
// the declaration is the authority anyway — it is right there in forms.
pub fn ctor_label_tables(forms : List(form.Form)) -> List(VariantTable) {
  if null?(forms) {
    nil
  } else {
    let items = form.items(car(forms))
    if form.is_sym(form.nth(items, 0), 'type) {
      list.append(variant_label_tables(cdr(cdr(cdr(items)))), ctor_label_tables(cdr(forms)))
    } else {
      ctor_label_tables(cdr(forms))
    }
  }
}

// label_slot(label, slots) — 字段名 -> 槽位号（driver 位置化记录构造用）。
pub fn label_slot(label : Symbol, slots : List(LabelSlot)) -> option.Option(Int) {
  match slots {
    nil -> option.None
    cons(s, rest) -> {
      match s {
        LabelSlot(l, slot) -> if l == label { option.Some(slot) } else { label_slot(label, rest) }
      }
    }
  }
}

// record_table(name, tables) — 按构造子名查字段表（driver 位置化记录构造用）。
pub fn record_table(name : Symbol, tables : List(VariantTable)) -> option.Option(VariantTable) {
  match tables {
    nil -> option.None
    cons(t, rest) -> if vt_name(t) == name { option.Some(t) } else { record_table(name, rest) }
  }
}

// variant_names(variants : List(form.Form)) -> list of constructor name symbols
// Each variant is (quote V) for nullary or (Ctor f1 f2 ...) for n-ary.
fn variant_names(variants : List(form.Form)) -> List(Symbol) {
  if null?(variants) {
    nil
  } else {
    let vitems = form.items(car(variants))
    let name = if form.is_sym(form.nth(vitems, 0), 'quote) {
      form.sym_at(form.nth(vitems, 1))
    } else {
      form.sym_at(form.nth(vitems, 0))
    }
    cons(name, variant_names(cdr(variants)))
  }
}

// last_dot(s, i) — 最后一个 '.' 的下标，没有则 -1。
fn last_dot(s, i) {
  if i < 0 {
    -1
  } else {
    if str.char_at(s, i) == 46 { i } else { last_dot(s, i - 1) }
  }
}

// is_uppercase_sym(s) -> 1 if the LAST dot-separated segment starts with an
// uppercase letter (ASCII 65..90). 段的划分与 parser 的 is_ctor_ident 同一条
// 规则（issue #462）：`Some`、`option.Some`、`option.Option` 都是构造器/具体
// 类型名，`list.map`、`str.concat` 是函数——前缀是模块名，身份在最后一段。
fn is_uppercase_sym(s) {
  let name = str.sym_to_str(s)
  let c = str.char_at(name, last_dot(name, str.length(name) - 1) + 1)
  if c >= 65 { if c <= 90 { 1 } else { 0 } } else { 0 }
}

// match_arm_ctor(pat : form.Form) -> 'covered | 'none | ctor-name-symbol
//   'covered: wildcard `_` or lowercase binding — the match is exhaustive
//   'none:    pattern covering no ADT variant (literal, nil, list/cons)
//   symbol:   the arm pattern's top-level ADT constructor
fn match_arm_ctor(pat : form.Form) -> Symbol {
  match pat {
    form.FAtom(ast.CSym(name)) -> {
      // A bare symbol arm: an uppercase name is a constructor, a lowercase
      // one is a binding and covers everything.
      if is_uppercase_sym(name) == 1 { name } else { 'covered }
    }
    form.FAtom(_) -> {
      // The empty bracket pattern [] desugars to nil, so nil is a shape of
      // list, not a miss.
      if form.is_nil_form(pat) { 'nil } else { 'none }
    }
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'quote) {
        form.sym_at(form.nth(items, 1))
      } else if is_ctor_pat(pat) == 1 {
        // (tuple (quote Name) p1 ... pN) — slot 0 is the tag.
        let tag = form.items(form.nth(items, 1))
        form.sym_at(form.nth(tag, 1))
      } else if form.is_sym(form.nth(items, 0), 'cons) {
        bare_cons_shape(pat)
      } else {
        let head = form.nth(items, 0)
        if form.is_sym_form(head) {
          let h = form.sym_at(head)
          if is_uppercase_sym(h) == 1 { h } else { 'covered }
        } else {
          'none
        }
      }
    }
  }
}

// bare_cons_shape(pat : form.Form) -> the list shape a non-constructor cons
// chain covers. cons(h, t) keeps a live tail, so it traverses the spine and
// covers 'cons. A chain ending in the arity-pin nil — that is what [a, b]
// and [Bind(k, v), _] desugar to — pins an exact length instead, so it
// matches neither of list's shapes and returns 'none.
fn bare_cons_shape(pat : form.Form) -> Symbol {
  if cons_chain_pinned(pat) == 1 { 'none } else { 'cons }
}

// cons_chain_pinned(pat : form.Form) -> 1 if the innermost cdr of a cons
// chain is the arity-pin nil.
fn cons_chain_pinned(pat : form.Form) -> Int {
  match pat {
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'cons) {
        cons_chain_pinned(form.nth(items, 2))
      } else {
        0
      }
    }
    form.FAtom(_) -> if form.is_nil_form(pat) { 1 } else { 0 }
  }
}

// === What a pattern covers ===
//
// A variant is covered by an arm when the arm's pattern matches *every* value
// of that variant: `Err(msg)` and `Some(_)` do, `Some(Some(y))` and `Some(1)`
// do not — their argument selects a sub-case. That sub-case is invisible to a
// top-level constructor set, which is how an uncovered `Some(None)` used to
// reach runtime silently (issue #396).
//
// The prong is a *sufficient* cover test along the irrefutable axis, not the
// full usefulness check (Maranget): `Some(Some(y)) / Some(None) / None` is
// genuinely exhaustive yet unprovable here, so it asks for an explicit `_ ->`
// arm — the Gleam convention for deliberately partial matches.

// variant_is_covered(pat : form.Form, env) -> 1 if a constructor arm matches
// its whole variant. pat is (tuple (quote Name) p1 ... pN) — the field
// patterns sit flat after the tag.
fn variant_is_covered(pat : form.Form, env) -> Int {
  payload_covers(cdr(cdr(form.items(pat))), env)
}

// payload_covers(pats : List(form.Form), env) -> 1 if every field pattern
// covers its own field type.
fn payload_covers(pats : List(form.Form), env) -> Int {
  if null?(pats) {
    1
  } else if arg_covers_type(car(pats), env) == 1 {
    payload_covers(cdr(pats), env)
  } else {
    0
  }
}

// arg_covers_type(pat : form.Form, env) -> 1 if the pattern matches every
// value of its type: a binding/wildcard, or a constructor that is the only
// shape of its type with covering arguments. A constructor that shares its
// type with other variants (`Some` over Some/None) pins a sub-case, and a
// shape pattern (nil, list spine, literal) pins one shape of many.
fn arg_covers_type(pat : form.Form, env) -> Int {
  match pat {
    form.FAtom(ast.CSym(name)) -> {
      if is_uppercase_sym(name) == 1 { 0 } else { 1 }
    }
    form.FAtom(_) -> 0
    form.FList(items) -> {
      if is_ctor_pat(pat) == 1 {
        let c = match_arm_ctor(pat)
        if ctor_is_only_shape(c, env) == 1 {
          payload_covers(cdr(cdr(items)), env)
        } else {
          0
        }
      } else {
        0
      }
    }
  }
}

// ctor_is_only_shape(c, env) -> 1 when every value of c's type is c, so the
// pattern pins nothing beyond the shape: `Buf(h)` and `CompRes(code, ctx)` are
// whole-type matches. Builtin `Pair` is single-shape for the same reason.
fn ctor_is_only_shape(c, env) {
  if c == 'Pair {
    // Builtin pairs have exactly one shape. A user type may declare a
    // variant that reuses the name (`type S { Pair(a) Other }`), so the
    // shortcut is only safe while nothing in env binds `Pair` — otherwise
    // fall through to that type's own variant list.
    match ctor_binding('Pair, env) {
      option.None -> 1
      option.Some(_) -> ctor_type_is_single(c, env)
    }
  } else {
    ctor_type_is_single(c, env)
  }
}

fn ctor_type_is_single(c, env) {
  if list.length(ctor_type_variants(c, env)) == 1 { 1 } else { 0 }
}

// ctor_type_variants(c, env) -> 该构造子所属类型的变体表（未知为空）。
fn ctor_type_variants(c : Symbol, env : List(EnvEntry)) -> List(Symbol) {
  match ctor_binding(c, env) {
    option.None -> nil
    option.Some(binding) -> {
      let tname = ctor_result_name(entry_scheme(binding))
      if null?(tname) { nil } else { type_variants(tname, env) }
    }
  }
}

// type_variants(tname, env) -> the variant list declared for a type, or nil
// when the type is unknown (nothing to prove then).
fn type_variants(tname : Symbol, env : List(EnvEntry)) -> List(Symbol) {
  match typedecl_binding(tname, env) {
    option.None -> builtin_variants(tname)
    option.Some(e) -> entry_variants(e)
  }
}

// type_field_tables(tname, env) -> 该类型声明的变体字段表，未声明为 None。
fn type_field_tables(tname : Symbol, env : List(EnvEntry)) -> option.Option(List(VariantTable)) {
  match typedecl_binding(tname, env) {
    option.None -> option.None
    option.Some(e) -> option.Some(entry_fields(e))
  }
}

// ctor_field_table(cname, env) -> 该构造子的字段表（arity + 标签）。
// The entry of the variant `cname`, whichever type declares it: ctor → its
// result type → that type's tables → the entry named cname. None means the
// name has no declaration behind it (or one with no fields table).
fn ctor_field_table(cname : Symbol, env : List(EnvEntry)) -> option.Option(VariantTable) {
  match ctor_binding(cname, env) {
    option.None -> option.None
    option.Some(binding) -> {
      let tname = ctor_result_name(entry_scheme(binding))
      if null?(tname) { option.None } else { variant_named(tname, cname, env) }
    }
  }
}

// variant_named(tname, cname, env) -> 类型 tname 的字段表里名字为 cname 的那条。
fn variant_named(tname : Symbol, cname : Symbol, env : List(EnvEntry)) -> option.Option(VariantTable) {
  match type_field_tables(tname, env) {
    option.None -> option.None
    option.Some(tables) -> table_named(tables, cname)
  }
}

fn table_named(tables : List(VariantTable), cname : Symbol) -> option.Option(VariantTable) {
  match tables {
    nil -> option.None
    cons(t, rest) -> if vt_name(t) == cname { option.Some(t) } else { table_named(rest, cname) }
  }
}

// typedecl_binding(name, env) -> 该类型名对应的 TypeDecl 条目，未声明为 None。
// Mirror of ctor_binding: `type Ctx { Ctx(...) }` puts a constructor of the
// same name in the env too, and a plain lookup may hit that Ctor entry first
// — keep walking for the typedecl instead of giving up (issue #406).
fn typedecl_binding(name : Symbol, env : List(EnvEntry)) -> option.Option(EnvEntry) {
  match env {
    nil -> option.None
    cons(e, rest) -> {
      if entry_name(e) == name {
        match e {
          TypeDecl(_, _, _) -> option.Some(e)
          _ -> typedecl_binding(name, rest)
        }
      } else {
        typedecl_binding(name, rest)
      }
    }
  }
}

// Cov — 一组 arm 覆盖到的东西：
//   CovAll:  某个 arm 是 wildcard/绑定 —— 这个 match 直接就是穷尽的
//   CovSome: full = 整个变体都被某条 arm 盖住的变体名，
//            partial = 只有子形状（嵌套实参）被盖住的变体名
type Cov { CovAll CovSome(full : List(Symbol), partial : List(Symbol)) }

fn cov_full(c : Cov) -> List(Symbol) { match c { CovAll -> nil CovSome(full, _) -> full } }
fn cov_partial(c : Cov) -> List(Symbol) { match c { CovAll -> nil CovSome(_, partial) -> partial } }

// arm_ctor_coverage(arms : List(form.Form), env) -> Cov
// Shapes that are not constructor applications (nil literal, list spine) are
// whole covers of the shape they name — bare_cons_shape decided which.
fn arm_ctor_coverage(arms : List(form.Form), env : List(EnvEntry)) -> Cov {
  if null?(arms) {
    CovSome(nil, nil)
  } else {
    let pat = form.nth(form.items(car(arms)), 0)
    let c = match_arm_ctor(pat)
    if c == 'covered {
      CovAll
    } else if c == 'none {
      arm_ctor_coverage(cdr(arms), env)
    } else {
      add_arm_cover(arm_ctor_coverage(cdr(arms), env), c, arm_covers_whole(pat, env))
    }
  }
}

// arm_covers_whole(pat, env) -> 这条 arm 是否盖住了它点名的整个变体。
// 只有构造子应用 ((tuple (quote C) f...)) 能「只钉住子形状」；绑定、字面量、
// nil / list spine 都按整体盖住算。
fn arm_covers_whole(pat : form.Form, env : List(EnvEntry)) -> Bool {
  if is_ctor_pat(pat) == 1 { variant_is_covered(pat, env) == 1 } else { true }
}

// add_arm_cover(rest, c, whole) — 把一条 arm 盖住的变体 c 记进累积结果：
// whole 表示这条 arm 匹配整个变体，否则它只钉住了子形状。
fn add_arm_cover(rest : Cov, c : Symbol, whole : Bool) -> Cov {
  match rest {
    CovAll -> CovAll
    CovSome(full, partial) -> if whole { CovSome(cons(c, full), partial) } else { CovSome(full, cons(c, partial)) }
  }
}

// minus_syms(lst, drop) -> lst without the symbols occurring in drop
fn minus_syms(lst, drop) {
  if null?(lst) {
    nil
  } else {
    if sym_in_list(car(lst), drop) == 1 {
      minus_syms(cdr(lst), drop)
    } else {
      cons(car(lst), minus_syms(cdr(lst), drop))
    }
  }
}

// ctor_result_name(scheme) -> the result type's name symbol from a
// constructor binding scheme (unwrap forall / arrow), or nil.
fn ctor_result_name(scheme) {
  match scheme {
    TyForall(_, body) -> ctor_result_name_walk(body)
    _ -> ctor_result_name_walk(scheme)
  }
}

fn ctor_result_name_walk(t) {
  match t {
    TyArrow(_, to) -> ctor_result_name_walk(to)
    _ -> ty_name(t)
  }
}

// adt_name_from_arms(arms : List(form.Form), env) -> ADT type name symbol or
// nil. Fallback for an unresolved-tvar scrutinee: an uppercase constructor
// pattern still identifies the ADT — look up its registered scheme.
//
// Only an uppercase arm names a type. Every other arm shape (a binding, nil, a
// cons spine, an arity-pinned [a, b]) says what the value looks like, not what
// it is, and an untyped scrutinee is usually a message: `match recv()` with a
// `cons('data, lst)` arm means "one of the messages I handle", not "these are
// all the list shapes there are" — reading List out of that shape arm would
// reject the match as non-exhaustive. The annotated case still checks: there
// the scrutinee's own type names the ADT, no arm reading needed.
fn adt_name_from_arms(arms : List(form.Form), env) {
  if null?(arms) {
    nil
  } else {
    let c = match_arm_ctor(form.nth(form.items(car(arms)), 0))
    if c == 'covered {
      nil
    } else if is_uppercase_sym(c) == 1 {
      let nm = ctor_adt_name(c, env)
      if null?(nm) { adt_name_from_arms(cdr(arms), env) } else { nm }
    } else {
      adt_name_from_arms(cdr(arms), env)
    }
  }
}

// ctor_adt_name(name, env) -> the ADT the constructor belongs to, or nil.
fn ctor_adt_name(name : Symbol, env : List(EnvEntry)) -> Symbol {
  match ctor_binding(name, env) {
    option.None -> nil
    option.Some(entry) -> ctor_result_name(entry_scheme(entry))
  }
}

// sym_in_list(x, lst) -> 1 if x occurs in lst
fn sym_in_list(x, lst) {
  if null?(lst) {
    0
  } else {
    if car(lst) == x { 1 } else { sym_in_list(x, cdr(lst)) }
  }
}

// missing_variants(variants, used) -> declared variants absent from used
fn missing_variants(variants, used) {
  if null?(variants) {
    nil
  } else {
    if sym_in_list(car(variants), used) == 1 {
      missing_variants(cdr(variants), used)
    } else {
      cons(car(variants), missing_variants(cdr(variants), used))
    }
  }
}

// === Unknown constructor in a pattern (issue #443) ===
//
// A constructor pattern is not type-directed: infer_list_pat leaves ctor
// chains unconstrained, so a misspelled variant (`Grn` for `Green`) reaches
// no lookup at all and its arm silently never matches — `Green` falls
// through to the wildcard, changing runtime behaviour with zero diagnostics.
// The names are therefore checked here, where the scrutinee's variant list
// is already in hand.
//
// Not covered on purpose: a constructor borrowed from another ADT
// (`match (c : Color2) { Blue -> ... }`) still passes, because `Blue` is
// declared somewhere. That is issue #442's ground (pattern binders are not
// unified with the scrutinee's field types).

// pat_ctor_names(pat : form.Form) -> List(Symbol): every constructor-shaped
// name the pattern mentions, at any depth.
fn pat_ctor_names(pat : form.Form) -> List(Symbol) {
  match pat {
    form.FAtom(ast.CSym(name)) -> cons(name, nil)
    form.FAtom(_) -> nil
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'quote) {
        // (quote Ref) heads a constructor reference only when Ref is the name
        // symbol. A quoted pattern keeps its payload: 'Red reads as
        // (quote (quote Red)), '[Red, Green] and 'Red(Green) as
        // (quote <chain>) — legal symbol-literal patterns whose payload is not
        // a name. Only names are returned, so this function keeps its
        // List(Symbol) contract and no Pair reaches the symbol-only helpers.
        let ref = form.nth(items, 1)
        if form.is_sym_form(ref) { cons(form.sym_at(ref), nil) } else { nil }
      } else if form.is_sym(form.nth(items, 0), 'cons) {
        // A chain node [cons elem rest]: elem is a pattern (a nested ctor
        // application may sit there) and rest is the next chain node — or
        // the cdr pattern of `cons(h, t)`. Walking both sides as sub-patterns
        // covers the two readings without telling them apart.
        list.append(pat_ctor_names(form.nth(items, 1)), pat_ctor_names(form.nth(items, 2)))
      } else if form.is_sym(form.nth(items, 0), 'tuple) {
        // Constructor application: the (quote Name) tag in slot 0 yields the
        // name through the quote branch, the fields follow as sub-patterns.
        pat_ctor_names_list(cdr(items))
      } else {
        nil
      }
    }
  }
}

fn pat_ctor_names_list(pats : List(form.Form)) -> List(Symbol) {
  if null?(pats) {
    nil
  } else {
    list.append(pat_ctor_names(car(pats)), pat_ctor_names_list(cdr(pats)))
  }
}

// is_builtin_type_name(name) -> 1 for the nine builtin type names. They are
// legitimate pattern heads (`Pair(a, k) ->`) yet own no typedecl variant
// list and no 'ctor entry, so the unknown-constructor test needs them as a
// third source of legitimacy (issue #443).
fn is_builtin_type_name(name : Symbol) -> Int {
  match base_of_sym(name) {
    BName(_) -> 0
    _ -> 1
  }
}

// === 跨模块裸名（issue #462 P4） ===
//
// 类型与构造子是模块成员：跨模块引用写 `<import 引用名>.<成员>`。P1..P3 的
// 兼容窗口（driver 的 compat_seq）在编译期把裸名补成限定名，P4 删掉窗口后
// 裸名落到这里。此时名字在 env 里没有任何条目，但某个单元有 `<前缀>.<名字>`
// —— 用户想写的是别处的成员，只是没带前缀。报 tc_bare_member 并给出建议
// （建议里的模块名由 driver 用 disp 反 mangle，内部前缀不进给人看的输出）。

// bare_member_error(name, env, ctx, s) -> s
// 只在能给出建议时登记：给不出说明这个名字哪儿都没有，留给 E0002 / E0005。
fn bare_member_error(name : Symbol, env : List(EnvEntry), ctx : List(Symbol), s : Subst) -> Subst {
  match bare_member_hint(name, env) {
    option.None -> s
    option.Some(hit) -> add_error(s, TcBareMember(ctx, name, hit))
  }
}

// bare_member_hint(name, env) -> 某个单元里 `<前缀>.<name>` 的前缀，没有为 None
fn bare_member_hint(name : Symbol, env : List(EnvEntry)) -> option.Option(Symbol) {
  match env {
    nil -> option.None
    cons(e, rest) -> {
      match member_prefix_of(entry_name(e), name) {
        option.None -> bare_member_hint(name, rest)
        option.Some(hit) -> option.Some(hit)
      }
    }
  }
}

// member_prefix_of(key, name) -> 前缀符号，key 不是一层限定的 `<前缀>.<name>` 时 None
// key 必须是「一层限定」的 `<前缀>.<name>`：前缀自己不含 '.'，否则 key 是别的
// 结构（`defn_arity` 之类的表键、或者更深的名字），不是成员引用。
fn member_prefix_of(key : Symbol, name : Symbol) -> option.Option(Symbol) {
  if symbol?(key) {
    let k = str.sym_to_str(key)
    let suf = str.concat(".", str.sym_to_str(name))
    let cut = str.length(k) - str.length(suf)
    if cut > 0 && str.substr(k, cut, str.length(suf)) == suf {
      let prefix = str.substr(k, 0, cut)
      if str.index_of(prefix, ".") >= 0 { option.None } else { option.Some(str.to_sym(prefix)) }
    } else { option.None }
  } else { option.None }
}

// bare_member_pat(pat : form.Form, env, ctx, s) -> s
// 模式里的裸构造子名（任意深度）。已知的构造子、内建类型名、以及绑不到任何
// 声明上的名字都不归这里管（后者是 E0005 unknown-ctor 的事）。
fn bare_member_pat(pat : form.Form, env : List(EnvEntry), ctx : List(Symbol), s : Subst) -> Subst {
  bare_member_names(pat_ctor_names(pat), env, ctx, s)
}

fn bare_member_names(names : List(Symbol), env : List(EnvEntry), ctx : List(Symbol), s : Subst) -> Subst {
  if null?(names) { s } else {
    let n = car(names)
    if is_uppercase_sym(n) == 1 && ctor_declared(n, env) == 0 && is_builtin_type_name(n) == 0 {
      bare_member_names(cdr(names), env, ctx, bare_member_error(n, env, ctx, s))
    } else {
      bare_member_names(cdr(names), env, ctx, s)
    }
  }
}

// ctor_declared(name, env) -> 1 when env has a constructor entry for name.
fn ctor_declared(name : Symbol, env : List(EnvEntry)) -> Int {
  match ctor_binding(name, env) {
    option.None -> 0
    option.Some(_) -> 1
  }
}

// known_ctor_name(name, variants, env) -> 1 when some declaration explains
// the name: a variant of the scrutinee type, a builtin type name, or a
// constructor declared anywhere in env (a nested position names its own
// type's constructors, not the scrutinee's). A bare cross-module member also
// counts as explained: its own diagnostic (E0004 + fix-it, issue #462 P4) is
// more precise than "unknown constructor", so E0005 stays quiet for it.
fn known_ctor_name(name : Symbol, variants : List(Symbol), env : List(EnvEntry)) -> Int {
  if sym_in_list(name, variants) == 1 { 1 }
  else if is_builtin_type_name(name) == 1 { 1 }
  else if ctor_declared(name, env) == 1 { 1 }
  else { has_bare_hint(name, env) }
}

// has_bare_hint(name, env) -> 1 when env holds `<prefix>.<name>`, i.e. the name
// is a cross-module member written bare (its own E0004 covers it).
fn has_bare_hint(name : Symbol, env : List(EnvEntry)) -> Int {
  match bare_member_hint(name, env) {
    option.None -> 0
    option.Some(_) -> 1
  }
}

// unknown_ctor(arms : List(form.Form), variants, env) -> the first
// constructor-shaped name no declaration explains, or nil. Lowercase names
// are bindings, never constructors, so they cannot qualify. One report per
// match: the first unknown name is the whole diagnostic, which is also why a
// mistyped arm does not additionally read as non-exhaustive.
fn unknown_ctor(arms : List(form.Form), variants : List(Symbol), env : List(EnvEntry)) -> Symbol {
  if null?(arms) {
    nil
  } else {
    let u = unknown_ctor_name(pat_ctor_names(form.nth(form.items(car(arms)), 0)), variants, env)
    if null?(u) { unknown_ctor(cdr(arms), variants, env) } else { u }
  }
}

fn unknown_ctor_name(names : List(Symbol), variants : List(Symbol), env : List(EnvEntry)) -> Symbol {
  if null?(names) {
    nil
  } else if is_uppercase_sym(car(names)) == 0 {
    unknown_ctor_name(cdr(names), variants, env)
  } else if known_ctor_name(car(names), variants, env) == 1 {
    unknown_ctor_name(cdr(names), variants, env)
  } else {
    car(names)
  }
}

// check_exhaustive(scrut_name, arms : List(form.Form), env, ctx, s) -> s
// scrut_name is the scrutinee's type name as the expression itself declared it
// (nil when it declares none). If a type is known — that name, or the one an
// uppercase constructor pattern names — and the arms are not wildcard-covered,
// record the variants no arm reaches ('tc_nonexh) or that only a nested pattern
// reaches ('tc_nonexh_partial) as an error entry in the subst. A pattern name
// that no declaration explains is recorded as ('tc_unknown_ctor) instead, and
// takes precedence: the missing variants are a consequence of the typo.
fn check_exhaustive(scrut_name : Symbol, arms : List(form.Form), env : List(EnvEntry), ctx : List(Symbol), s : Subst) -> Subst {
  let tname = if null?(scrut_name) { adt_name_from_arms(arms, env) } else { scrut_name }
  let variants = if null?(tname) { nil } else { type_variants(tname, env) }
  if null?(variants) {
    s
  } else {
    let unk = unknown_ctor(arms, variants, env)
    if null?(unk) == false {
      add_error(s, TcUnknownCtor(ctx, tname, unk))
    } else {
      check_variants_covered(arm_ctor_coverage(arms, env), variants, tname, ctx, s)
    }
  }
}

// check_variants_covered(cov, variants, tname, ctx, s) -> s
// 覆盖结果对声明变体表的两种缺口：一个变体没有任何 arm（non-exhaustive），
// 或者每个变体都有 arm、但只有嵌套形状被盖住（无法证明穷尽，issue #396）。
fn check_variants_covered(cov : Cov, variants : List(Symbol), tname : Symbol, ctx : List(Symbol), s : Subst) -> Subst {
  match cov {
    CovAll -> s
    CovSome(full, partial) -> {
      let reached = list.append(full, minus_syms(partial, full))
      let absent = missing_variants(variants, reached)
      if null?(absent) == false {
        add_error(s, TcNonExh(ctx, tname, absent))
      } else {
        let unproven = missing_variants(variants, full)
        if null?(unproven) { s } else { add_error(s, TcNonExhPartial(ctx, tname, unproven)) }
      }
    }
  }
}

// builtin_variants(tname) -> the variant list of a builtin type that has
// ADT shape, or nil for anything else. list(E) has no typedecl entry in
// the env, but its two shapes are as checkable as a user ADT's variants:
// 'nil (the [] pattern / a bare nil) and 'cons (cons(h, t) or any bracket
// pattern with cons at the head). Without this, a match over a list that
// covers neither shape silently yields nil at runtime: the arms just fall
// through.
fn builtin_variants(tname) {
  if tname == 'List { cons('nil, cons('cons, nil)) } else { nil }
}

// arrow_params(t) -> list of parameter types of an arrow type
fn arrow_params(t : Ty) -> List(Ty) {
  match t {
    TyArrow(from, to) -> cons(from, arrow_params(to))
    _ -> nil
  }
}

// arrow_result(t) -> the type an arrow chain ends in (t itself if not an arrow)
fn arrow_result(t : Ty) -> Ty {
  match t {
    TyArrow(_, to) -> arrow_result(to)
    _ -> t
  }
}

// SplitArrow — arrow_split 的产出：前 n 个形参类型 + 声明里的返回类型。
type SplitArrow { SplitArrow(params : List(Ty), ret : Ty) }

fn split_params(r : SplitArrow) -> List(Ty) { match r { SplitArrow(params, _) -> params } }
fn split_ret(r : SplitArrow) -> Ty { match r { SplitArrow(_, ret) -> ret } }

// arrow_split(t, n) -> SplitArrow
// Split a curried annotation into its first n parameter types and the
// declared return type (the remainder). annot_to_type wraps exactly one
// arrow per annotated parameter, so walking n arrows recovers the split the
// parser recorded in the type-sig — the whole arrow alone cannot tell
// `fn f() -> Int -> Int` (a returned function) from two parameters. n comes
// from the define's own parameter list, so it matches by construction; if
// it ever doesn't, the remainder answer degrades to "no param types".
fn arrow_split(t : Ty, n : Int) -> SplitArrow {
  if n == 0 {
    SplitArrow(nil, t)
  } else {
    match t {
      TyArrow(from, to) -> {
        let inner = arrow_split(to, n - 1)
        SplitArrow(cons(from, split_params(inner)), split_ret(inner))
      }
      _ -> SplitArrow(nil, t)
    }
  }
}

// collect_annot_params(types : List(form.Form), acc_map, acc_ids, counter)
//   -> PolyMap
// A bare lowercase symbol in a type annotation is an implicit type parameter
// (e.g. head(xs: List(a)) -> a). Each unique name gets a fresh tvar (level 1,
// so the function-level generalize at level 0 captures it), like a declared
// type param. A bare UPPERCASE symbol is a concrete type name (Int, List, a
// user ADT) and never a type param — the one uniform rule.
//
// 无注解的形参在 type-sig 里占一个 nil 原子位（parser 的既有拼法），原子一律
// 跳过：它们既不声明类型参数，也没有可递归的子标注。
fn collect_annot_params(types : List(form.Form), acc_map : List(ParamBind), acc_ids : List(Int), counter : Int) -> PolyMap {
  if null?(types) {
    PolyMap(acc_map, counter, acc_ids)
  } else {
    match car(types) {
      form.FAtom(ast.CSym(name)) -> {
        if is_uppercase_sym(name) == 1 {
          // uppercase symbol: concrete type name (Int, List, user ADT)
          collect_annot_params(cdr(types), acc_map, acc_ids, counter)
        } else {
          // lowercase symbol: implicit type parameter — register if not seen
          if option.is_some(param_find(acc_map, name)) {
            collect_annot_params(cdr(types), acc_map, acc_ids, counter)
          } else {
            let fv = fresh(counter, 1)
            let new_t = fresh_ty(fv)
            let new_ids = cons(tvar_id(new_t), acc_ids)
            collect_annot_params(cdr(types), cons(ParamBind(name, new_t), acc_map), new_ids, fresh_counter(fv))
          }
        }
      }
      form.FAtom(_) -> collect_annot_params(cdr(types), acc_map, acc_ids, counter)
      form.FList(items) -> {
        // compound type: (Name arg1 ...) or (quote a) — recurse into args
        let sub = collect_annot_params(cdr(items), acc_map, acc_ids, counter)
        collect_annot_params(cdr(types), pmap_binds(sub), pmap_ids(sub), pmap_counter(sub))
      }
    }
  }
}

// parse_type_annot(t : form.Form, param_map) -> type or nil
// Convert an annotation to internal type representation.
// t is either a symbol (simple type) or a list (Name arg1 ...) for compound
// types. Bare lowercase symbols resolve to type params via param_map;
// uppercase symbols are concrete type names (t_base).
fn parse_type_annot(t : form.Form, param_map : List(ParamBind)) -> Ty {
  if form.is_nil_form(t) {
    nil
  } else if form.is_sym_form(t) {
    let sym = form.sym_at(t)
    match param_find(param_map, sym) {
      option.Some(b) -> pb_ty(b)
      option.None -> t_base(sym)
    }
  } else {
    let items = form.items(t)
    if form.is_sym(form.nth(items, 0), 'quote) {
      // quoted type param reference: 'a
      parse_type_annot(form.nth(items, 1), param_map)
    } else if form.is_sym(form.nth(items, 0), 'arrow) {
      // function type annotation: (arrow A B) from parser's a -> b
      t_arrow(parse_type_annot(form.nth(items, 1), param_map),
      parse_type_annot(form.nth(items, 2), param_map))
    } else {
      // compound type: (Name arg1 arg2 ...)
      t_app(form.sym_at(form.nth(items, 0)), parse_type_annot_list(cdr(items), param_map))
    }
  }
}

fn parse_type_annot_list(ts : List(form.Form), param_map : List(ParamBind)) -> List(Ty) {
  if null?(ts) {
    nil
  } else {
    cons(parse_type_annot(car(ts), param_map), parse_type_annot_list(cdr(ts), param_map))
  }
}

// annot_to_type_params(param_types : List(form.Form), acc, counter, param_map)
//   -> Fresh
// Build curried arrow from param type list, threading accumulator (ret type).
fn annot_to_type_params(param_types : List(form.Form), acc : Ty, counter : Int, param_map : List(ParamBind)) -> Fresh {
  if null?(param_types) {
    Fresh(acc, counter)
  } else {
    let pt = car(param_types)
    let pr = if form.is_nil_form(pt) {
      fresh(counter, 0)
    } else {
      Fresh(parse_type_annot(pt, param_map), counter)
    }
    let t = fresh_ty(pr)
    let c1 = fresh_counter(pr)
    // Recurse into the rest FIRST, then wrap: the first param must be the
    // OUTERMOST arrow (application order) -> t1 -> (t2 -> ret). Forward
    // accumulation reversed heterogeneous multi-param generic sigs.
    let inner = annot_to_type_params(cdr(param_types), acc, c1, param_map)
    Fresh(t_arrow(t, fresh_ty(inner)), fresh_counter(inner))
  }
}

// annot_to_type(param_types : List(form.Form), ret_type : form.Form, counter)
//   -> Fresh
// Build arrow type from annotation lists. Bare lowercase symbols appearing
// anywhere in the annotations become implicit type params, quantified as a
// forall scheme (e.g. head(xs: List(a)) -> a  =>  forall a. List(a) -> a).
fn annot_to_type(param_types : List(form.Form), ret_type : form.Form, counter : Int) -> Fresh {
  // collect implicit type params from param types, then from the return type
  let cr1 = collect_annot_params(param_types, nil, nil, counter)
  // ret_type is a single type (symbol or (Name args)), wrap it in a list
  let cr2 = collect_annot_params(cons(ret_type, nil), pmap_binds(cr1), pmap_ids(cr1), pmap_counter(cr1))
  let param_map = pmap_binds(cr2)
  let ret_r = if form.is_nil_form(ret_type) {
    fresh(pmap_counter(cr2), 0)
  } else {
    Fresh(parse_type_annot(ret_type, param_map), pmap_counter(cr2))
  }
  let at = annot_to_type_params(param_types, fresh_ty(ret_r), fresh_counter(ret_r), param_map)
  let arrow_t = fresh_ty(at)
  let ids = pmap_ids(cr2)
  if null?(ids) {
    Fresh(arrow_t, fresh_counter(at))
  } else {
    Fresh(t_forall(ids, arrow_t), fresh_counter(at))
  }
}

// collect_type_sigs(forms : List(form.Form), sig_env : List(EnvEntry), counter : Int)
//   -> EnvC
// Walk top-level forms for (type-sig name param_types ret_type) and
// (external_fn name param_types ret_type) — both share the same shape
// (name param_types ret_type), so external_fn declarations (C module
// signatures from lib/<mod>.ta) register alongside ordinary annotations.
fn collect_type_sigs(forms : List(form.Form), sig_env : List(EnvEntry), counter : Int) -> EnvC {
  if null?(forms) {
    EnvC(sig_env, counter)
  } else {
    let items = form.items(car(forms))
    let head = form.nth(items, 0)
    if form.is_sym(head, 'type-sig) {
      let name = form.sym_at(form.nth(items, 1))
      let param_types = form.items(form.nth(items, 2))
      let ret_type = form.nth(items, 3)
      let at = annot_to_type(param_types, ret_type, counter)
      collect_type_sigs(cdr(forms), extend(sig_env, name, fresh_ty(at)), fresh_counter(at))
    } else if form.is_sym(head, 'external_fn) {
      let name = form.sym_at(form.nth(items, 1))
      let param_types = form.items(form.nth(items, 2))
      let ret_type = form.nth(items, 3)
      let at = annot_to_type(param_types, ret_type, counter)
      collect_type_sigs(cdr(forms), extend(sig_env, name, fresh_ty(at)), fresh_counter(at))
    } else {
      collect_type_sigs(cdr(forms), sig_env, counter)
    }
  }
}

// extend_env_from_sigs(env, sigs) -> env with every sig binding registered.
// external_fn declarations have no define form, so their arrow types must be
// threaded into the env directly for infer_call to find them.
fn extend_env_from_sigs(env : List(EnvEntry), sigs : List(EnvEntry)) -> List(EnvEntry) {
  match sigs {
    nil -> env
    cons(binding, rest) -> {
      extend_env_from_sigs(cons(binding, env), rest)
    }
  }
}

// Prog — 一趟顶层推断的产物：环境 + 替换表 + 下一个 tvar 计数器。
// （旧实现是 `(env . (s . counter))` 的嵌套点对，每个用它的函数都在数 car/cdr。）
type Prog { Prog(env : List(EnvEntry), s : Subst, counter : Int) }

// prog_env(p) — 顶层推断后的环境（签名缓存要用它取模块导出的 scheme）。
pub fn prog_env(p : Prog) -> List(EnvEntry) { match p { Prog(env, _, _) -> env } }
fn prog_s(p : Prog) -> Subst { match p { Prog(_, s, _) -> s } }
fn prog_counter(p : Prog) -> Int { match p { Prog(_, _, counter) -> counter } }

// registered_scheme(env, name) — pass 1 给该顶层名预留的类型。查不到不该发生
// （pass 1 必然登记过）；真查不到时给底部类型，它与一切相容且不绑定任何一边，
// 不会凭空造出一个诊断。
fn registered_scheme(env : List(EnvEntry), name : Symbol) -> Ty {
  match env_find(env, name) {
    option.Some(e) -> entry_scheme(e)
    option.None -> t_never()
  }
}

// define_binding(name, sigs, counter) -> Fresh：有 type-sig 注解就用注解，否则
// 给一个待定的 tvar（pass 2 再把它定下来）。
fn define_binding(name : Symbol, sigs : List(EnvEntry), counter : Int) -> Fresh {
  match env_find(sigs, name) {
    option.Some(e) -> Fresh(entry_scheme(e), counter)
    option.None -> fresh(counter, 0)
  }
}

// collect_defines(forms, env, s, counter, sigs, seen) -> Prog
// Pass 1: register each define with a fresh tvar so recursive calls work.
// If a matching type-sig exists, use the annotated type instead.
// DupScan — dup_check 的产出：更新后的替换表 + 已登记的顶层名集合。
type DupScan { DupScan(s : Subst, seen : List(Symbol)) }

fn dup_s(r : DupScan) -> Subst { match r { DupScan(s, _) -> s } }
fn dup_seen(r : DupScan) -> List(Symbol) { match r { DupScan(_, seen) -> seen } }

// dup_check(s, seen, name) -> DupScan
// 顶层 define/define_pub/const 撞名（#289）：三者在 pass 1 共享一个全局名
// 集合，重复注册记录 E0006 并继续（与 arity 同风格，一趟报多处）。此前
// const 与 fn 撞名要到运行期才以 "call on non-function" 炸，甚至更糟——
// const 内联会污染调用点，静默算出错值。
// 键是 decl_key(name)：同一个单元里 pub / 非 pub 是**同一个命名空间**，只是
// mangle 用了不同的分隔符（`mod.name` / `mod$name`），按符号比较会漏掉
// 「有参构造子 vs 私有函数同名」（#462 P4 review）。
fn dup_check(s : Subst, seen : List(Symbol), name : Symbol) -> DupScan {
  let key = decl_key(name)
  if seen_has(seen, key) {
    DupScan(add_error(s, TcDuplicate(key)), cons(key, seen))
  } else {
    DupScan(s, cons(key, seen))
  }
}

// decl_key(name) -> 顶层符号表的键：`<单元前缀>.<成员>`。
// `$` 只出现在非 pub 函数的 mangle 里（rename_member_name），声明期换回 `.`，
// 于是「类型 / 构造子 / pub fn / 非 pub fn / const」落在同一把键上。前缀本身
// 不含 `$`，第一个 `$` 就是分界。
fn decl_key(name : Symbol) -> Symbol {
  if symbol?(name) {
    let k = str.sym_to_str(name)
    let d = str.index_of(k, "$")
    if d < 0 {
      name
    } else {
      str.to_sym(str.concat(str.substr(k, 0, d),
      str.concat(".", str.substr(k, d + 1, str.length(k) - d - 1))))
    }
  } else {
    name
  }
}

// dup_scan_decl(type_name, ctors, s, seen) -> DupScan
// 一条 type 声明把类型名和全部构造器名登记进顶层符号表，于是 pass 0 的 seen
// 直接成了 pass 1 的起点 —— 一整趟符号表，不分「类型」「函数」「常量」。
// 唯一豁免：构造子与**自己**的类型同名（`type EB { EB(..) }` 是常态写法），
// 只登记不判重；跟别的声明撞名照旧 E0006。
fn dup_scan_decl(type_name : Symbol, ctors : List(Symbol), s : Subst, seen : List(Symbol)) -> DupScan {
  let r = dup_check(s, seen, type_name)
  dup_scan_ctors(ctors, type_name, dup_s(r), dup_seen(r))
}

fn dup_scan_ctors(ctors : List(Symbol), type_name : Symbol, s : Subst, seen : List(Symbol)) -> DupScan {
  if null?(ctors) { DupScan(s, seen) } else {
    let c = car(ctors)
    let r = if decl_key(c) == decl_key(type_name) { DupScan(s, seen) } else { dup_check(s, seen, c) }
    dup_scan_ctors(cdr(ctors), type_name, dup_s(r), dup_seen(r))
  }
}

// seen_has(lst, name) — 符号表成员判断。注意不能用 assq：seen 是符号表
// （list of symbols），assq 期望关联表，会对元素做 car 而炸。
fn seen_has(lst : List(Symbol), name : Symbol) -> Bool {
  if null?(lst) { false } else { if car(lst) == name { true } else { seen_has(cdr(lst), name) } }
}

// collect_arities(forms : List(form.Form)) -> the local arity table: one Arity
// per local top-level define/define_pub. Planted as the ArityTable env entry so
// arity_error can check user call sites (issue #376). Imported
// module functions are deliberately excluded: they resolve through the seed
// env under module-qualified names, and listing only local defines keeps a
// local param that shadows a define name out of the table (no false arity
// error).
fn collect_arities(forms : List(form.Form)) -> List(Arity) {
  if null?(forms) {
    nil
  } else {
    let items = form.items(car(forms))
    let head = form.nth(items, 0)
    if form.is_sym(head, 'define) || form.is_sym(head, 'define_pub) {
      let sig = form.items(form.nth(items, 1))
      cons(Arity(form.sym_at(form.nth(sig, 0)), list.length(cdr(sig))), collect_arities(cdr(forms)))
    } else {
      collect_arities(cdr(forms))
    }
  }
}

fn collect_defines(forms : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, sigs : List(EnvEntry), seen : List(Symbol)) -> Prog {
  if null?(forms) {
    Prog(env, s, counter)
  } else {
    let items = form.items(car(forms))
    let head = form.nth(items, 0)
    if form.is_sym(head, 'define) || form.is_sym(head, 'define_pub) {
      let name = form.sym_at(form.nth(form.items(form.nth(items, 1)), 0))
      let fv = define_binding(name, sigs, counter)
      let r = dup_check(s, seen, name)
      collect_defines(cdr(forms), extend(env, name, fresh_ty(fv)), dup_s(r), fresh_counter(fv), sigs, dup_seen(r))
    } else if form.is_sym(head, 'const) {
      // (const NAME expr) — register the name so references resolve
      // through the env during body inference, like a define. The
      // binding is tagged ('ctor . tvar) because uppercase const
      // names parse as (quote Name) symbol literals; infer_quote
      // resolves ctor/const-tagged bindings to their real type.
      let name = form.sym_at(form.nth(items, 1))
      let fv = fresh(counter, 0)
      let r = dup_check(s, seen, name)
      collect_defines(cdr(forms), cons(Ctor(name, fresh_ty(fv)), env), dup_s(r), fresh_counter(fv), sigs, dup_seen(r))
    } else {
      // skip import, type, type-sig, and other forms
      collect_defines(cdr(forms), env, s, counter, sigs, seen)
    }
  }
}

// infer_define(top : form.Form, env, s, counter, level) -> Prog
// Infer type for one (define (name params...) body...)
fn infer_define(top : form.Form, env : List(EnvEntry), s : Subst, counter : Int, level : Int) -> Prog {
  let items = form.items(top)
  let sig = form.items(form.nth(items, 1))
  let name = form.sym_at(form.nth(sig, 0))
  let params = form.syms(cdr(sig))
  let body = cdr(cdr(items))
  // Look up pre-registered type
  let registered_t = registered_scheme(env, name)
  // A forall registered type is a generic type-sig: instantiate it and use
  // the annotated param types to drive body inference (e.g. head(xs: List(a))
  // -> a infers xs : List('a) so the body stays polymorphic).
  let sig_i = match registered_t {
    TyForall(_, _) -> option.Some(instantiate(registered_t, counter, level + 1))
    _ -> option.None
  }
  let sig_t = match sig_i {
    option.Some(f) -> fresh_ty(f)
    option.None -> t_never()
  }
  let counter0 = match sig_i {
    option.Some(f) -> fresh_counter(f)
    option.None -> counter
  }
  // A plain (non-forall) annotation — fn f(x : String) -> Int — drives the
  // body the same way: split it into the declared param types plus the
  // return annotation (issue #411). The params get their declared types
  // directly, and check_lambda_ret (inside infer_lambda) unifies the return
  // annotation against the *body's* result type. The old whole-arrow unify
  // ran afterwards against whatever the body inferred — for
  // `fn h(a : String) -> Int { id(a) }` it unified the annotation with id's
  // instantiated 'a -> 'a, reported the conflict on the callee, and on
  // failure dropped the partial bindings, generalizing h to forall a. a -> a
  // and leaking the wrong type to every caller.
  // A bare tvar registered type is the no-annotation placeholder
  // (collect_defines): nothing to split, the final unify still pins it.
  let plain_r = match registered_t {
    TyForall(_, _) -> option.None
    TyVar(_, _) -> option.None
    _ -> option.Some(arrow_split(registered_t, list.length(params)))
  }
  let sig_types = match sig_i {
    option.Some(_) -> arrow_params(sig_t)
    option.None -> { match plain_r {
        option.Some(r) -> split_params(r)
        option.None -> nil
      } }
  }
  let ret_type = match plain_r {
    option.Some(r) -> option.Some(split_ret(r))
    option.None -> option.None
  }
  // Infer lambda type at level + 1 (like let-binding). For a plain
  // annotation the declared params and return are enforced inside
  // infer_lambda (sig_types + ret_type); the whole-arrow unify below only
  // remains for the forall and placeholder cases, so nothing is checked
  // twice.
  let lam_r = infer_lambda(params, body, env, s, counter0, level + 1, cons(name, nil), sig_types, ret_type)
  let inferred_t = inf_ty(lam_r)
  let s1 = inf_s(lam_r)
  let c1 = inf_c(lam_r)
  // If registered is already a generalized scheme, this name was defined
  // earlier (e.g. same name in another imported module) — replace it without
  // checking. Only bare tvars (collect_defines placeholders) and type-sig
  // annotations get unified against the inferred type.
  let s2 = match registered_t {
    TyForall(_, _) -> {
      // Standard HM check: the body must satisfy the declared forall signature.
      // Unify the inferred lambda type against an instantiation of the scheme
      // (e.g. fn head(xs: List(a)) -> a with a `Nil -> 0` body resolves to
      // List(int) -> int — the int arm pins the param — instead of silently
      // accepting an incompatible body).
      let sig_ctx = cons(name, cons(str.to_sym("body does not match declared signature"), nil))
      unify_check(inferred_t, sig_t, s1, sig_ctx)
    }
    _ -> {
      if option.is_none(plain_r) {
        // Unify inferred with registered
        unify_check(inferred_t, registered_t, s1, cons(name, nil))
      } else {
        // The declared params drove the body and check_lambda_ret unified the
        // declared return against the body result — a mismatch is already
        // recorded there, so a whole-arrow re-unify would only report it a
        // second time.
        s1
      }
    }
  }
  // Resolve type through substitution. On the plain-annotation path take the
  // *declared* type: even when the body failed the return check, callers see
  // the signature they wrote, not a half-bound guess (issue #411: the error
  // must not leak to call sites).
  let resolved_t = if option.is_none(plain_r) { apply_subst(inferred_t, s2) } else { apply_subst(registered_t, s2) }
  // Generalize
  let scheme = generalize_l(resolved_t, level, s2)
  // Update env: remove old binding, add new
  let env_without = remove_binding(env, name)
  Prog(extend_global(env_without, Bind(name, scheme)), s2, c1)
}

// remove_binding(env, name) -> env without the binding for name
fn remove_binding(env : List(EnvEntry), name : Symbol) -> List(EnvEntry) {
  match env {
    nil -> nil
    cons(binding, rest) -> {
      if entry_name(binding) == name {
        rest
      } else {
        cons(binding, remove_binding(rest, name))
      }
    }
  }
}

// infer_defines(forms : List(form.Form), env, s, counter, level) -> Prog
// Pass 2: infer each define in order.
fn infer_defines(forms : List(form.Form), env : List(EnvEntry), s : Subst, counter : Int, level : Int) -> Prog {
  if null?(forms) {
    Prog(env, s, counter)
  } else {
    let items = form.items(car(forms))
    let head = form.nth(items, 0)
    if form.is_sym(head, 'define) || form.is_sym(head, 'define_pub) {
      let r = infer_define(car(forms), env, s, counter, level)
      infer_defines(cdr(forms), prog_env(r), prog_s(r), prog_counter(r), level)
    } else if form.is_sym(head, 'const) {
      // (const NAME expr) — infer the value's type, unify against
      // the pass-1 placeholder, generalize, and update the env so
      // later references see the real type (like a toplevel let).
      let name = form.sym_at(form.nth(items, 1))
      let val_expr = form.nth(items, 2)
      let registered_t = registered_scheme(env, name)
      let r = infer_expr(val_expr, env, s, counter, level + 1, cons(name, nil))
      let val_t = inf_ty(r)
      let s1 = inf_s(r)
      let c1 = inf_c(r)
      let s2 = unify_check(val_t, registered_t, s1, cons(name, nil))
      let resolved_t = apply_subst(val_t, s2)
      let scheme = generalize_l(resolved_t, level, s2)
      let env_without = remove_binding(env, name)
      // Keep the Ctor shape so later (quote Name) references still
      // resolve through infer_quote (see collect_defines).
      let new_env = extend_global(env_without, Ctor(name, scheme))
      infer_defines(cdr(forms), new_env, s2, c1, level)
    } else {
      // skip non-define forms
      infer_defines(cdr(forms), env, s, counter, level)
    }
  }
}

// make_builtin_env(counter) -> EnvC
fn t_pid() -> Ty { TyBase(BPid) }

fn make_builtin_env(counter : Int) -> EnvC {
  // car: forall(a b, a -> b) — heterogeneous pairs are legal in TA;
  // the element type is unconstrained (matches null?/pair? permissiveness)
  let car_t = t_forall(cons(0, cons(1, nil)), t_arrow(t_var(0, 0), t_var(1, 0)))
  let e1 = extend(nil, 'car, car_t)
  // cdr: forall(a, a -> a)
  let e2 = extend(e1, 'cdr, car_t)
  // cons: forall(a b, a -> b -> b)
  let cons_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_arrow(t_var(1, 0), t_var(1, 0))))
  let e3 = extend(e2, 'cons, cons_t)
  // print: forall(a c, a -> c)
  let print_t = t_forall(cons(0, cons(2, nil)),
  t_arrow(t_var(0, 0), t_var(2, 0)))
  let e4 = extend(e3, 'print, print_t)
  // null?: forall(a, a -> bool)
  let nb_t = t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_bool()))
  let e5 = extend(e4, 'null?, nb_t)
  // pair?: forall(a, a -> bool)
  let e6 = extend(e5, 'pair?, nb_t)
  // int?: forall(a, a -> bool)
  let e7 = extend(e6, 'int?, nb_t)
  // string?: forall(a, a -> bool)
  let e8 = extend(e7, 'string?, nb_t)
  // bytes?: forall(a, a -> bool) — opcode exists (op_is_bytes, codegen +
  // builtin_arity already knew it); it was only missing here, which made
  // `bytes?` E0002 at compile time and the opcode dead from TA source.
  let e8b = extend(e8, 'bytes?, nb_t)
  // pid?: forall(a, a -> bool) — same story as bytes? (op_is_pid)
  let e8c = extend(e8b, 'pid?, nb_t)
  // symbol?: forall(a, a -> bool)
  let e9 = extend(e8c, 'symbol?, nb_t)
  // float? / bool?: forall(a, a -> bool) — 与 bytes?/pid? 同一个洞的第二批：
  // C 侧 host.c 的 bare_preds 注册着、compile.ta 的 bare_cfunc 白名单里也有，
  // 只有这里漏了，于是从 TA 源码写出来是 E0002（名字「不存在」）。
  let e9a = extend(e9, 'float?, nb_t)
  let e9b = extend(e9a, 'bool?, nb_t)
  // tuple?/tuple-len/tuple-ref: the tuple primitives every ADT constructor
  // compiles to (both backends have had the opcodes since the tuple stage),
  // and the only way TA source can read a tuple it did not build itself.
  // Typed as loosely as car/cdr — a tuple's tag and fields are dynamic.
  let e9c = extend(e9b, 'tuple?, nb_t)
  let e9d = extend(e9c, 'tuple-len, t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_int())))
  let e9e = extend(e9d, 'tuple-ref,
  t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_arrow(t_int(), t_var(1, 0)))))
  // len removed (D2 #4): was a phantom builtin — typecheck promised it but
  // runtime had no implementation. Users define their own fn len.
  // list? removed: 名字说「是不是 list」，实现只能是 nil-or-pair（真检查要
  // 递归走完整条表）。名字兑现不了就不该存在 —— 「是 List(a)」是类型层的问题，
  // 运行期谓词的签名 forall a. a -> Bool 也窄不到 List(a)。需要 proper-list
  // 检查的地方自己写四行递归，开销摆在调用点上。
  let e10 = e9e
  // str_concat: string -> string -> string
  let e11 = extend(e10, 'str_concat,
  t_arrow(t_string(), t_arrow(t_string(), t_string())))
  // list_ref removed (D2 #4): phantom builtin, same story as len.
  // Indexing into a form is lib/list.ta's nth, not a builtin promise.
  let e12 = e11
  // spawn: forall(a, a -> pid)
  let spawn_t = t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_pid()))
  let e13 = extend(e12, 'spawn, spawn_t)
  // send: forall(a b, a -> b -> b)
  let send_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_arrow(t_var(1, 0), t_var(1, 0))))
  let e14 = extend(e13, 'send, send_t)
  // recv: forall(a, a)
  let recv_t = t_forall(cons(0, nil), t_var(0, 0))
  let e15 = extend(e14, 'recv, recv_t)
  // self: pid (no-arg C function)
  let e16 = extend(e15, 'self, t_pid())
  // monitor: forall(a b, a -> b)
  let monitor_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_var(1, 0)))
  let e17 = extend(e16, 'monitor, monitor_t)
  // recv-after: forall(a, int -> a) — nil on timeout (issue #33)
  let ra_t = t_forall(cons(0, nil), t_arrow(t_int(), t_var(0, 0)))
  let e20b = extend(e17, 'recv_after, ra_t)
  // str.eq: string -> string -> bool
  let e21 = extend(e20b, 'str.eq,
  t_arrow(t_string(), t_arrow(t_string(), t_bool())))
  // str.concat: string -> string -> string
  let e22 = extend(e21, 'str.concat,
  t_arrow(t_string(), t_arrow(t_string(), t_string())))
  // int.to_float: int -> float  (strict numeric tower, issue #92)
  let e22a = extend(e22, 'int.to_float, t_arrow(t_int(), t_float()))
  // float.to_int: float -> int  (truncates toward zero)
  let e22b = extend(e22a, 'float.to_int, t_arrow(t_float(), t_int()))
  // str.length: string -> int
  let e23 = extend(e22b, 'str.length,
  t_arrow(t_string(), t_int()))
  // str.char_at: string -> int -> int
  let e24 = extend(e23, 'str.char_at,
  t_arrow(t_string(), t_arrow(t_int(), t_int())))
  // str.substr: string -> int -> int -> string
  let e25 = extend(e24, 'str.substr,
  t_arrow(t_string(), t_arrow(t_int(), t_arrow(t_int(), t_string()))))
  // str.to_int: string -> int
  let e26 = extend(e25, 'str.to_int,
  t_arrow(t_string(), t_int()))
  // str.from_int: int -> string
  let e27 = extend(e26, 'str.from_int,
  t_arrow(t_int(), t_string()))
  // str.index_of: string -> string -> int
  let e28 = extend(e27, 'str.index_of,
  t_arrow(t_string(), t_arrow(t_string(), t_int())))
  // str.to_sym: string -> symbol  (C3: was forall(a, string -> a))
  let sts_t = t_arrow(t_string(), t_symbol())
  let e29 = extend(e28, 'str.to_sym, sts_t)
  // str.sym_to_str: symbol -> string  (C3: was forall(a, a -> string))
  let sts2_t = t_arrow(t_symbol(), t_string())
  let e30 = extend(e29, 'str.sym_to_str, sts2_t)
  // vm.parse_source: forall(a, string -> a)
  let vps_t = t_forall(cons(0, nil),
  t_arrow(t_string(), t_var(0, 0)))
  let e30a = extend(e30, 'vm.parse_source, vps_t)
  // vm.is_builtin_module: forall(a, a -> bool)
  let e30b = extend(e30a, 'vm.is_builtin_module, nb_t)
  // vm.get_arg: int -> string
  let ga_t = t_arrow(t_int(), t_string())
  let e30c = extend(e30b, 'vm.get_arg, ga_t)
  // vm.load_bytecode: no binding — the loader was deleted with the old VM path
  // (7c-2); keeping the promise would only defer the failure to run time, as a
  // missing builtin (issue #277).
  // vm.time_ms: int — no-arg monotonic clock (concrete, semantic binding)
  let e30d = extend(e30c, 'vm.time_ms, t_int())
  // vm.time_us: int — no-arg monotonic µs clock (benchmarking)
  let e30e = extend(e30d, 'vm.time_us, t_int())
  // +, -, *, /: int -> int -> int
  let arith_t = t_arrow(t_int(), t_arrow(t_int(), t_int()))
  let e31 = extend(e30e, '+, arith_t)
  let e32 = extend(e31, '-, arith_t)
  let e33 = extend(e32, '*, arith_t)
  let e34 = extend(e33, '/, arith_t)
  // <, >, <=, >=: int -> int -> bool
  let cmp_t = t_arrow(t_int(), t_arrow(t_int(), t_bool()))
  let e35 = extend(e34, '<, cmp_t)
  let e36 = extend(e35, '>, cmp_t)
  let e37 = extend(e36, '<=, cmp_t)
  let e38 = extend(e37, '>=, cmp_t)
  // ==: forall(a, a -> a -> bool)
  let eq_t = t_forall(cons(0, nil),
  t_arrow(t_var(0, 0), t_arrow(t_var(0, 0), t_bool())))
  let e39 = extend(e38, '==, eq_t)
  // str.chr: int -> string — byte value -> 1-char string (inverse of char_at)
  let e40 = extend(e39, 'str.chr,
  t_arrow(t_int(), t_string()))
  // ============ D/E 反哺：模块函数类型承诺（C 光谱规则落地） ============
  // 原则：语义绑定原语必须带具体类型。历史哨兵（net -1、file.read 失败 nil）
  // 是底层无类型的溢出，类型承诺"成功路径"，TA 侧用 null? 检查失败。
  // cov.line：parser 的插桩标记，不是函数。--cov 构建时 parser 在每条语句前
  // 插 (begin (cov.line 文件 行) 语句)，covinst 在 typecheck 之后把它换成
  // (cov.hit k)，标记永不到达 VM。登记在这里而不是给 typecheck 开特例：
  // 编译器自己的插桩也就是「一处声明」。
  let e41 = extend(e40, 'cov.line,
  t_forall(cons(0, nil), t_arrow(t_string(), t_arrow(t_int(), t_var(0, 0)))))
  // net.*（net.read 变参 fd[, max]，豁免——箭头无法表达变参，见 check-modules）
  let e42 = extend(e41, 'net.listen,
  t_arrow(t_int(), t_int()))
  let e43 = extend(e42, 'net.accept,
  t_arrow(t_int(), t_int()))
  // net.connect: string -> int -> a。可选 timeout 拆成两个名字（connect 2 参 /
  // connect_timeout 3 参，C 侧同一实现），箭头因此能如实写出元数。返回值留
  // 多态：fd (int) / nil（连接在途）/ 错误符号是一个箭头表达不了的联合。
  let e44 = extend(e43, 'net.connect,
  t_forall(cons(0, nil), t_arrow(t_string(), t_arrow(t_int(), t_var(0, 0)))))
  let e44b = extend(e44, 'net.connect_timeout,
  t_forall(cons(0, nil),
  t_arrow(t_string(), t_arrow(t_int(), t_arrow(t_int(), t_var(0, 0))))))
  let e45 = extend(e44b, 'net.write,
  t_arrow(t_int(), t_arrow(t_string(), t_int())))
  // net.close: 副作用，返回 nil
  let e46 = extend(e45, 'net.close,
  t_arrow(t_int(), t_nil()))
  // file.*
  let e47 = extend(e46, 'file.read,
  t_arrow(t_string(), t_string()))
  let e48 = extend(e47, 'file.write,
  t_arrow(t_string(), t_arrow(t_string(), t_int())))
  let e49 = extend(e48, 'file.exists,
  t_arrow(t_string(), t_int()))
  // vm.* 公开（内部函数 make_tok_vec/tok_type/tok_val/free_tok_vec
  // 是编译器专用，豁免注册，见 check-modules）
  // vm.cfunc_index: 接受 symbol 或 string（查询原语，宽松）
  let e52 = extend(e49, 'vm.cfunc_index,
  t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_int())))
  EnvC(e52, counter)
}

// infer_program(forms) -> Prog
// infer_program_seeded(forms, seed_env) -> Prog
//
// infer_program_seeded pre-loads seed_env bindings (frozen module-export
// schemes reloaded from the signature cache, Phase C issue #99) ahead of
// the builtin env — the same visibility a whole-program typecheck has, so
// cached modules' definitions resolve without re-inferring them. Seed
// schemes must be fully generalized (forall) or concrete: they are
// instantiated on use, never unified against.
// max_int_in(v, acc) — largest int found anywhere inside a value: pairs, tuples
// and atoms are all walked. Used to measure seeded signature tvar ids;
// over-approximating is harmless (the counter just starts higher — tvar ids
// only need to be unique).
fn max_int_in(v : Atom, acc : Int) -> Int {
  if int?(v) {
    if v > acc { v } else { acc }
  } else if pair?(v) {
    max_int_in(cdr(v), max_int_in(car(v), acc))
  } else if tuple?(v) {
    max_int_in_slots(v, 0, tuple-len(v), acc)
  } else {
    acc
  }
}

fn max_int_in_slots(v : Atom, i : Int, n : Int, acc : Int) -> Int {
  if i >= n {
    acc
  } else {
    max_int_in_slots(v, i + 1, n, max_int_in(tuple-ref(v, i), acc))
  }
}

// max_seed_int(seed, acc) — max int over every seeded binding. An entry is a
// record (a tuple), so this walks the whole thing: the scheme's tvar ids and
// every table slot inside it.
fn max_seed_int(seed : List(EnvEntry), acc : Int) -> Int {
  match seed {
    nil -> acc
    cons(e, rest) -> max_seed_int(rest, max_int_in(e, acc))
  }
}

pub fn infer_program_seeded(forms : List(form.Form), seed_env : List(EnvEntry)) -> Prog {
  // The seed replays cached signatures with their ORIGINAL tvar ids; those
  // collide with the unit's own fresh ids (which restart near 0). A seeded
  // list(E7) next to the unit's own id-7 aborts the build (issue #102 cold
  // cache). Start the counter above every seeded id instead.
  let counter = max_seed_int(seed_env, -1) + 1
  let s = empty_subst()
  let be = make_builtin_env(counter)
  // seeded exports come in front of builtins, exactly like module defines
  // shadow builtins in a whole-program pass
  let env0 = list.append(seed_env, envc_env(be))
  let c0 = envc_counter(be)
  // Pass 0: collect type declarations (ADT constructors), together with the
  // declaration-time duplicate check its names feed into pass 1's symbol table.
  let ctd = collect_type_decls(forms, env0, s, c0, nil)
  let env_types = declr_env(ctd)
  let s_decl = declr_s(ctd)
  let c_types = declr_counter(ctd)
  let seen_decl = declr_seen(ctd)
  // Pass 0.5: collect type-sig annotations + external_fn declarations
  let cts = collect_type_sigs(forms, nil, c_types)
  let sigs = envc_env(cts)
  let c_sigs = envc_counter(cts)
  // external_fn declarations (C module signatures) have no define form, so
  // register them directly in the env so module calls typecheck strictly.
  // type-sig entries are re-registered (harmlessly) alongside their defines.
  let env_sigs = extend_env_from_sigs(env_types, sigs)
  // Pass 1: collect all defines. seen_decl carries pass 0's type/ctor names, so
  // a define that collides with one of them is the same E0006 as any duplicate.
  let cd = collect_defines(forms, env_sigs, s_decl, c_sigs, sigs, seen_decl)
  // Plant the local top-level arity table (issue #376) so arity_error can
  // reject calls that under- or over-supply arguments to a user define.
  let env_ar = cons(ArityTable(collect_arities(forms)), prog_env(cd))
  // Pass 2: infer each define
  infer_defines(forms, env_ar, prog_s(cd), prog_counter(cd), 0)
}

pub fn infer_program(forms : List(form.Form)) -> Prog {
  infer_program_seeded(forms, nil)
}

// ============================================================
// Type pretty-printing
// ============================================================

// fmt_type_name(name) -> String
// The head of a base/app type is normally a symbol, but a malformed type
// tree can carry garbage there (issue #208: a variant field the parser
// mis-parses as nil lands in BName(nil) / TyApp(nil, ...)). Error
// formatting must be total — str.sym_to_str on a non-symbol crashes the
// whole compiler and hides the real type errors. Fall back to a raw
// readable marker instead; never swallow, never crash.
fn fmt_type_name(name : Symbol) -> String {
  if symbol?(name) { str.sym_to_str(name) }
  else {
    if null?(name) { "<?type>" }
    else {
      if int?(name) { str.concat("<?type ", str.concat(str.from_int(name), ">")) }
      else { "<?type>" }
    }
  }
}

// TvarName — 打印时一个 tvar 分到的名字（'a、'b…）：`assigned` 表的一条。
type TvarName { TvarName(id : Int, letter : String) }

fn tvar_name_of(id : Int, assigned : List(TvarName)) -> option.Option(String) {
  match assigned {
    nil -> option.None
    cons(a, rest) -> {
      match a {
        TvarName(vid, letter) -> if vid == id { option.Some(letter) } else { tvar_name_of(id, rest) }
      }
    }
  }
}

// === 诊断渲染用的模块名表（disp） ===
//
// 类型名在 env 里是 `<内部单元前缀>.Name`，前缀带 `~` 哈希（qual_prefix），直接
// 打出来没人认得（issue #462 P4，docs/ux-log.md）。Disp 是「内部前缀 → 它在
// import 行里写出来的名字」的一条：凡是内部符号要变成用户写得出来的拼写，都从
// 这张表过一遍。
type Disp { Disp(prefix : Symbol, written : String) }

// disp_written(disp, prefix) -> 该前缀在 import 行写出的全名，未登记为 None。
// E0004 的「哪个模块」用它 —— 用户得照着它去补 import 行。
pub fn disp_written(disp : List(Disp), prefix : Symbol) -> option.Option(String) {
  match disp_find(disp, prefix) {
    option.None -> option.None
    option.Some(d) -> option.Some(written_of(d))
  }
}

fn written_of(d : Disp) -> String { match d { Disp(_, written) -> written } }

fn disp_find(disp : List(Disp), prefix : Symbol) -> option.Option(Disp) {
  match disp {
    nil -> option.None
    cons(d, rest) -> {
      match d {
        Disp(p, _) -> if p == prefix { option.Some(d) } else { disp_find(rest, prefix) }
      }
    }
  }
}

// short_segment(path) -> 路径末段，也就是默认别名：import "tinyactor:lib/str"
// 之后写 `str.x`。fix-it 建议与类型显示要它，因为那才是用户写得出来的拼写。
fn short_segment(path : String) -> String {
  let i = str.index_of(path, "/")
  if i < 0 { path } else { short_segment(str.substr(path, i + 1, str.length(path) - i - 1)) }
}

// disp_short(disp, prefix) -> 该前缀的短名（写出名的末段 = import 的默认
// 别名），未登记为 None。fix-it 建议要用户能原样贴回源码的拼写，所以那里用
// 它而不是 disp_written 的全名。
pub fn disp_short(disp : List(Disp), prefix : Symbol) -> option.Option(String) {
  match disp_find(disp, prefix) {
    option.None -> option.None
    option.Some(d) -> option.Some(short_segment(written_of(d)))
  }
}

// type_format(t, s, disp) -> String
// 渲染时把内部前缀换成短名 —— 报告里出现的每个拼写都必须是用户能写出来的。
pub fn type_format(t : Ty, s : Subst, disp : List(Disp)) -> String {
  let resolved = apply_subst(t, s)
  type_format_resolved(resolved, nil, disp)
}

// disp_member(name, disp) -> Symbol
// `前缀.成员` 命中 disp 就换成 `短名.成员`；没有 '.' 的（原语、本单元裸名）和
// 查不到的（别的编译单元路径）原样。前缀不含 '.'，所以第一个点就是分界。
// 类型名、构造子名、非穷尽匹配里的变体名、E0006 的撞名——凡是内部符号要变成
// 用户能写出来的拼写，都走这一处（driver 的 tc_errors_text 也调它）。
pub fn disp_member(name : Symbol, disp : List(Disp)) -> Symbol {
  if symbol?(name) {
    let k = str.sym_to_str(name)
    let dot = str.index_of(k, ".")
    if dot < 0 {
      name
    } else {
      let prefix = str.to_sym(str.substr(k, 0, dot))
      match disp_short(disp, prefix) {
        option.None -> name
        option.Some(short) -> str.to_sym(str.concat(short, str.substr(k, dot, str.length(k) - dot)))
      }
    }
  } else {
    name
  }
}

// type_format_resolved(t, assigned, disp) -> String
// assigned: the tvar names handed out so far (TvarName), oldest first
fn type_format_resolved(t : Ty, assigned : List(TvarName), disp : List(Disp)) -> String {
  match t {
    TyBase(b) -> fmt_type_name(disp_member(base_name(b), disp))
    TyVar(vid, _) -> {
      match tvar_name_of(vid, assigned) {
        // Assign next letter: 'a, 'b, ... 'z, then 't0, 't1, ...
        option.None -> tvar_letter(list.length(assigned))
        option.Some(letter) -> letter
      }
    }
    TyArrow(from, to) -> {
      // Collect assigned from 'from' first, pass to 'to'
      let from_assigned = collect_tvars(from, assigned)
      let from_str = type_format_resolved(from, assigned, disp)
      let to_str = type_format_resolved(to, from_assigned, disp)
      // Arrow is right-associative: parenthesize 'from' if it's an arrow,
      // but 'to' needs no parens (A -> B -> C means A -> (B -> C))
      let from_wrapped = match from {
        TyArrow(_, _) -> str.concat("(", str.concat(from_str, ")"))
        _ -> from_str
      }
      str.concat(from_wrapped, str.concat(" -> ", to_str))
    }
    TyApp(name, args) -> {
      let name_str = fmt_type_name(disp_member(name, disp))
      if null?(args) {
        name_str
      } else {
        let args_str = format_type_list(args, assigned, disp)
        str.concat(name_str, str.concat("(", str.concat(args_str, ")")))
      }
    }
    TyForall(_, body) -> type_format_resolved(body, assigned, disp) // strip the shell, print the body
    _ -> "?" // malformed tree — never crash the compiler (issue #208)
  }
}

fn format_type_list(ts : List(Ty), assigned : List(TvarName), disp : List(Disp)) -> String {
  match ts {
    nil -> ""
    cons(h, nil) -> type_format_resolved(h, assigned, disp)
    cons(h, rest) -> {
      let h_assigned = collect_tvars(h, assigned)
      str.concat(type_format_resolved(h, assigned, disp), str.concat(", ", format_type_list(rest, h_assigned, disp)))
    }
  }
}

// Collect tvar assignments from a type, so sequential formatting is consistent
fn collect_tvars(t : Ty, assigned : List(TvarName)) -> List(TvarName) {
  match t {
    TyVar(vid, _) -> {
      match tvar_name_of(vid, assigned) {
        option.None -> cons(TvarName(vid, tvar_letter(list.length(assigned))), assigned)
        option.Some(_) -> assigned
      }
    }
    TyArrow(from, to) -> {
      let a1 = collect_tvars(from, assigned)
      collect_tvars(to, a1)
    }
    TyApp(_, args) -> collect_tvars_list(args, assigned)
    _ -> assigned // base, forall or unknown
  }
}

fn collect_tvars_list(ts : List(Ty), assigned : List(TvarName)) -> List(TvarName) {
  match ts {
    nil -> assigned
    cons(h, rest) -> collect_tvars_list(rest, collect_tvars(h, assigned))
  }
}

// ============================================================
// Type error reporting
//
// 诊断在 typecheck 内部就是 TcError 变体，出口也不换形状：get_errors 交出去
// 的是 `List(TcError)` —— 同构列表，每个元素自带名字。渲染在 driver
// （tc_errors_text），它按变体取字段拼文案。
// ============================================================

// collect_errors(s) — 全部诊断，最新的在前（= 报告顺序）。
fn collect_errors(s : Subst) -> List(TcError) {
  subst_errors(s)
}

pub fn count_errors(result : Prog) -> Int {
  list.length(collect_errors(prog_s(result)))
}

// tc_ctx(e) — 诊断的上下文链：链首是函数名，其后逐层是失败点说明
// （"arg 2 of helper"），最内层在末尾。无上下文的诊断（TcDuplicate）给 nil。
pub fn tc_ctx(e : TcError) -> List(Symbol) {
  match e {
    TcMismatch(ctx, _, _) -> ctx
    TcUndefinedVar(_, ctx) -> ctx
    TcUndefinedFn(_, ctx) -> ctx
    TcArity(ctx, _, _, _) -> ctx
    TcNotExported(ctx, _, _) -> ctx
    TcNoExport(ctx, _, _) -> ctx
    TcBareMember(ctx, _, _) -> ctx
    TcDuplicate(_) -> nil
    TcLabelUnknown(ctx, _, _) -> ctx
    TcLabelDuplicate(ctx, _, _) -> ctx
    TcLabelMissing(ctx, _, _) -> ctx
    TcLabelNoFields(ctx, _) -> ctx
    TcNonExh(ctx, _, _) -> ctx
    TcNonExhPartial(ctx, _, _) -> ctx
    TcUnknownCtor(ctx, _, _) -> ctx
  }
}

pub fn get_errors(result : Prog) -> List(TcError) {
  collect_errors(prog_s(result))
}

// tvar_letter(n) -> String: 0->'a, 1->'b, ..., 25->'z, 26->'t0, etc.
fn tvar_letter(n) {
  if n < 26 {
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let ch = str.substr(letters, n, 1)
    str.concat("'", ch)
  } else {
    str.concat("'t", str.from_int(n - 26))
  }
}
