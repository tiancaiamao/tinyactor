// compile.ta — KL（脱糖后）→ .tabc 字节码。
//
// 四趟（与 docs/backend.md 一致，各自简单）：codegen（Ins 指令树）→ fuse（指令
// 融合）→ flatten（IF 展开回填 + 常量池，产 int 词流）→ depthpass（逐 Ins 模拟栈深
// 得 maxd）。写文件是 bytecode.ta，本文件只交 FnBC 表 + 常量池。
//
// 表示分层：form（异构 sexp）**只在 top.ta** —— top.parse_program 把它一次收敛成
// Top/Expr/Const。本文件从 Expr 起，全量标注 + 穷尽 match；Ins 是带类型的指令树，
// fuse/flatten/depth 按变体消费。异构数据与「这是符号还是调用」的形状判断只发生一次。
//
// == 表示分层（三段式）==
//   1. form —— 宿主 reader 的产物，异构树（symbol / pair / int / string /
//      nil / bool 混在一棵树上）。**只出现在 top.ta 的 parse 层**。
//   2. Expr —— 带类型的 KL 语法树：parse 一次收敛，之后编译器再也见不到
//      异构数据。free_vars / codegen 面对它做穷尽 match，每个变体各归其位。
//   3. Ins —— 带类型的指令树，flatten / depth / write 三趟继续消费。
//
// 为什么值得插这一层：直接对 sexp 编，则每个吃节点的函数都得在任何时刻
// 重新判断「这是符号还是调用还是字面量」（car/cdr + 头部字符串比较 + 运行
// 期 atom 分类散落各处）；插入 Expr 后，形状判断只在 parse 里发生一次，
// 下游全是穷尽 match —— 少一类「忘了一个形状」的 bug，且能全量标注。
//
//   codegen  Expr 树  → Ins 指令树          （compile_expr 一族）
//   fuse     Ins 树   → Ins 树             （*P 压栈融合 / IConstI / IIfP·IIfI）
//   flatten  Ins 树   → int 词流 + 常量池   （flat2 / flat_if，跳转回填）
//   depth    Ins 树   → maxd                （逐指令模拟栈深）
//
// 词流要逐字节对齐旧实现（G-A 门：同一输入两条路 .tabc 相同），故融合指令、立即数
// 指令、actor 内建都照搬；练习版模型见 example/scripts/klc.ta。
//
// 算符一律按二元处理：TA 源的 a + b + c 降级后本就是 (+ (+ a b) c)，合法输入
// 不会出现多元算符；手写的畸形 (+ 1 2 3) 会落成普通调用，由装载期报未知函数。
//
// 类型标注的边界：form 层（top.ta）一律不标注 —— 带**具体**标注的函数签名不做泛化，
// 而异构节点要求同一个函数收 symbol / pair / int 都合法；Expr 之后的所有函数
// （free_vars / codegen / fuse / flatten / depth）全量标注、穷尽 match。
//

import "bootstrap/top" as top
import option

// ---------- 操作码（ta.h 的镜像；只有 flat2 一处消费）----------
const OP_CONST = 0
const OP_LOAD = 1
const OP_STORE = 2
const OP_LOADF = 3
const OP_PUSH = 4
const OP_ADD = 5
const OP_SUB = 6
const OP_MUL = 7
const OP_DIV = 8
const OP_MOD = 9
const OP_LT = 10
const OP_LE = 11
const OP_GT = 12
const OP_GE = 13
const OP_EQ = 14
const OP_PAIRP = 15
const OP_SYMP = 16
const OP_CONS = 17
const OP_CAR = 18
const OP_CDR = 19
// 条件跳转：单操作数 = 假目标（真 → pc+2 下落进紧随其后的 then 段）
const OP_JIF = 20
const OP_JUMP = 21
const OP_CALL = 22
const OP_TCALL = 23
const OP_RET = 24
const OP_MAKE_CLOSURE = 25
const OP_GLOBAL = 26
const OP_RESERVE = 27
const OP_BUILTIN = 28
// 压栈融合：*P = 「取值 + IPush」合成一条（实参传递热路径）。
const OP_LOADP = 29
const OP_CONSTP = 30
const OP_GLOBP = 31
// 融合比较+跳转：if 的 cond 以 OP_LT..OP_EQ 结尾时，比较吃进跳转位（见 fuse）。
// W[pc+1]/W[pc+2] = 真/假目标。与 OP_LT..OP_EQ 连续对应（IIfP 展平期
// op - OP_LT 定位变体）。
const OP_JIF_LT = 32
const OP_JIF_LE = 33
const OP_JIF_GT = 34
const OP_JIF_GE = 35
const OP_JIF_EQ = 36
// 立即数形态：右操作数是编译期已知的 int 字面量，内嵌进指令词流，不占常量池。
const OP_CONST_I = 37
const OP_ADD_I = 38
const OP_SUB_I = 39
const OP_JIF_EQ_I = 40

// actor 内建 id（vm.c 的 builtin 表镜像；compile_general 在编译期固化）
const B_SELF = 0
const B_SPAWN = 1
const B_SEND = 2
const B_RECV = 3
const B_MONITOR = 4
const B_RECV_AFTER = 5
const B_RECV_PEEK = 6
const B_RECV_COMMIT = 7

// ---------- 表示 ----------
// Const / Expr / Top（form 层的 parse 产物）在 top.ta；本文件从 Expr 起消费。

// 函数名：define 有名字（.tabc 的 nameidx 要求），entry / lambda 匿名。
pub type FnName {
  Named(name : Symbol)
  Anon
}

// 指令树。IF 是唯一复合指令：两分支各自成段，展平期回填跳转。
// 融合指令（*P / *.I / IIfP·IIfI / IBuiltin）由 fuse 产出，语义都是「少一次
// 取指」，net 栈效应与未融合形态一致（depth 各自成 case）。
type Ins {
  IConst(c : Const)
  // 整数字面量：内嵌进指令词流，不占常量池
  IConstI(imm : Int)
  ILoad(slot : Int)
  ILoadF(idx : Int)
  ILoadP(slot : Int)
  IConstP(c : Const)
  IGlobP(name : Symbol)
  IStore(slot : Int)
  IGlob(name : Symbol)
  IPush
  IOp(op : Int)
  IOpI(op : Int, imm : Int)
  ICall(n : Int)
  ITCall(n : Int)
  IBuiltin(id : Int, n : Int)
  IClos(fid : Int, nfree : Int)
  IRet(nargs : Int)
  IReserve(n : Int)
  IIf(cond : List(Ins), yes : List(Ins), no : List(Ins))
  // 融合比较+条件跳转：cond 已剥掉结尾的 IOp(cmp)，op 记录被剥的比较
  IIfP(op : Int, cond : List(Ins), yes : List(Ins), no : List(Ins))
  // IIfP 的立即数版（只对 OP_EQ）：cond 再剥掉结尾的 IConstI(imm)
  IIfI(imm : Int, cond : List(Ins), yes : List(Ins), no : List(Ins))
}

// tail_const_i 的结果。-1 也是合法立即数，故不用 int 哨兵。
type TailImm {
  TailImmYes(imm : Int)
  TailImmNo
}

// 名字 → 槽号（locals）/ free 下标（upvals）。-1 = 缺席（assoc_find 约定）。
type Bind { Bind(name : Symbol, val : Int) }

// 编译期上下文：本层词法环境 + 两个计数器 + 已产出的函数池（按 fid 有序）。
type Ctx {
  Ctx(locals : List(Bind), upvals : List(Bind), next_slot : Int, next_fnid : Int, fns : List(FnRec))
}

type CompRes { CompRes(code : List(Ins), ctx : Ctx) }
type FnRec { FnRec(fid : Int, name : FnName, nargs : Int, code : List(Ins)) }
// 交给 bytecode.ta 的落盘形状：名字带类型（Anon → nameidx -1），池序即 fid 序
// （insert_fn 保证），故不再带 fid。
pub type FnBC { FnBC(name : FnName, nargs : Int, maxd : Int, words : List(Int)) }

type Globals { Globals(alist : List(Bind), next_id : Int) DupGlobal(msg : String) }
type WRes { WRes(ws : List(Int), pool : List(Const)) }
// 常量池查找：未命中回报下标 = 当前池长（调用方追加尾部）
type PoolIdx { PoolNew(idx : Int) PoolHit(idx : Int) }
type FlatRes { FlatRes(fns : List(FnBC), pool : List(Const)) }
type DepthRes { DP(d : Int, m : Int) }
pub type Out { Out(fns : List(FnBC), consts : List(Const)) Fail(msg : String) }

// =====================================================================
// 通用小工具（多态，故只标 List(t) 这类类型变量）
// =====================================================================

fn len(lst : List(t)) -> Int { len_into(lst, 0) }

fn len_into(lst : List(t), acc : Int) -> Int {
  match lst {
    [] -> acc
    [_ | rest] -> len_into(rest, acc + 1)
  }
}

// 尾递归 cat：先逆序 a，再回卷盖到 b 前
fn cat(a : List(t), b : List(t)) -> List(t) { cat_into(rev(a), b) }

fn cat_into(ra : List(t), b : List(t)) -> List(t) {
  match ra {
    [] -> b
    [h | rest] -> cat_into(rest, cons(h, b))
  }
}

fn rev(lst : List(t)) -> List(t) { rev_into(lst, nil) }

fn rev_into(lst : List(t), acc : List(t)) -> List(t) {
  match lst {
    [] -> acc
    [h | rest] -> rev_into(rest, cons(h, acc))
  }
}

// ---------- alist / 名字工具 ----------
fn assoc_find(key : Symbol, alist : List(Bind)) -> Int {
  match alist {
    [] -> -1
    [Bind(k, v) | rest] -> if k == key { v } else { assoc_find(key, rest) }
  }
}

fn member(x : Symbol, xs : List(Symbol)) -> Bool {
  match xs {
    [] -> false
    [h | rest] -> if h == x { true } else { member(x, rest) }
  }
}

// 首遇序去重（accumulator 逆序攒，收尾 rev 翻正）
fn uniq(xs : List(Symbol)) -> List(Symbol) { uniq_acc(xs, nil) }

fn uniq_acc(xs : List(Symbol), acc : List(Symbol)) -> List(Symbol) {
  match xs {
    [] -> rev(acc)
    [h | rest] -> if member(h, acc) { uniq_acc(rest, acc) } else { uniq_acc(rest, cons(h, acc)) }
  }
}

// ---------- 名字分类：算符原语 / 宿主 cfunc ----------
// 一次分类成 ADT，调用点据变体平 match —— 不再用「opcode 或 -1」的 int 哨兵。
// 注意：TA 的 match 对纯标点符号名（+ < …）永不命中（parser bug：标点字面量
// 模式被静默降成 `'_`），故算符名只能走字符串比较。
type OpKind {
  BinOp(op : Int)
  UnOp(op : Int)
  NotAnOp
}

fn op_kind(name : Symbol) -> OpKind {
  match str.sym_to_str(name) {
    "+" -> BinOp(OP_ADD)
    "-" -> BinOp(OP_SUB)
    "*" -> BinOp(OP_MUL)
    "/" -> BinOp(OP_DIV)
    "%" -> BinOp(OP_MOD)
    "modulo" -> BinOp(OP_MOD)
    "=" -> BinOp(OP_EQ)
    "eq?" -> BinOp(OP_EQ)
    "<" -> BinOp(OP_LT)
    "<=" -> BinOp(OP_LE)
    ">" -> BinOp(OP_GT)
    ">=" -> BinOp(OP_GE)
    "cons" -> BinOp(OP_CONS)
    "car" -> UnOp(OP_CAR)
    "cdr" -> UnOp(OP_CDR)
    "pair?" -> UnOp(OP_PAIRP)
    "symbol?" -> UnOp(OP_SYMP)
    _ -> NotAnOp
  }
}

fn bare_cfunc(name : Symbol) -> Bool {
  match name {
    'print -> true
    'int? -> true
    'string? -> true
    'bytes? -> true
    'pid? -> true
    'float? -> true
    'bool? -> true
    'list? -> true
    'map? -> true
    'nil? -> true
    _ -> false
  }
}

// op_builtin 派发表（vm.c 的 LB_* 镜像）：actor 原语不走 IGlob/按名路径 ——
// bare_cfunc 不收它们。arity 由运行期检查（与 CALL 的 fn_args 检查同策略）。
fn builtin_id(name : Symbol) -> Option(Int) {
  match name {
    'self -> Some(B_SELF)
    'spawn -> Some(B_SPAWN)
    'send -> Some(B_SEND)
    'recv -> Some(B_RECV)
    'recv_after -> Some(B_RECV_AFTER)
    'recv_peek -> Some(B_RECV_PEEK)
    'recv_commit -> Some(B_RECV_COMMIT)
    'monitor -> Some(B_MONITOR)
    _ -> None
  }
}

// 名字里带点（str.concat / file.read）→ 模块 cfunc。逐字符扫。
fn has_dot(s : String, i : Int) -> Bool {
  if i >= str.length(s) {
    false
  } else {
    if str.char_at(s, i) == 46 { true } else { has_dot(s, i + 1) }
  }
}

fn lib_cfunc_head(name : Symbol) -> Bool {
  if bare_cfunc(name) { true } else { has_dot(str.sym_to_str(name), 0) }
}

// 调用头若是算符原语（binop / unop），编译期直接发 opcode，不产生变量引用。
// 缺了这一步，free_vars 会把 (eq? a b) 的 eq? 当成未定义名。
fn op_name(name : Symbol) -> Bool {
  match op_kind(name) {
    NotAnOp -> false
    _ -> true
  }
}

// =====================================================================
// free_vars：Expr 上的一次纯扫描（全标注 + 穷尽 match）
// =====================================================================
// 返回 body 里自由的名字，按首遇序去重。三级判定（见 free_sym）：
//   bound = 本 lambda 自己的词法绑定（参数 + 内部 let）；
//   outer = 外层 lambda 可见的词法绑定（父层 env ∪ upvals 的名字）。
// 返回 body 里自由的名字，按首遇序去重。三级判定（见 free_sym）：
//   bound = 本 lambda 自己的词法绑定（参数 + 内部 let）；
//   outer = 外层 lambda 可见的词法绑定（父层 env ∪ upvals 的名字）。
// 作用域模型与 codegen 的 ctx 穿透**逐处对齐**（见 introduced）：一个 let 的绑定
// 在其所在序列的后续表单里仍可见。不这么算，fvs 会把真·本地名当自由变量 ——
// 既误报 undefined，又给闭包塞多余/错位的 upval 槽。
// 调用方约定：lambda 编译传 bound = 自己的参数、outer = 父层可见名（得到本层
// upvals，序 = LOADF 下标）；闭包封闭性检查传 outer = nil（顶层，非空 = 未定义名）。
fn free_vars(e : Expr, bound : List(Symbol), outer : List(Symbol), g : List(Bind)) -> List(Symbol) {
  match e {
    EConst(_) -> nil
    ESym(name) -> free_sym(name, bound, outer, g)
    ELambda(params, body) -> free_vars(body, cat(params, bound), outer, g)
    ELet(name, init, body) -> {
      // init 在绑定建立**之前**求值：名字只进 body 的 bound
      uniq(cat(free_vars(init, bound, outer, g), free_vars(body, cons(name, bound), outer, g)))
    }
    // if：cond 先求值，它引入的绑定对两分支可见；分支各自引入的不外泄。
    EIf(cond, yes, no) -> {
      let b1 = cat(introduced(cond), bound)
      uniq(cat(free_vars(cond, bound, outer, g), cat(free_vars(yes, b1, outer, g),
      free_vars(no, b1, outer, g))))
    }
    EBegin(forms) -> free_seq(forms, bound, outer, g)
    ECall(callee, args) -> uniq(cat(free_head(callee, bound, outer, g),
    free_seq(args, cat(introduced(callee), bound), outer, g)))
  }
}

// 调用头：算符原语不产生变量引用；其余符号当变量，非符号（((f a) b)）递归。
fn free_head(callee : Expr, bound : List(Symbol), outer : List(Symbol), g : List(Bind)) -> List(Symbol) {
  match callee {
    ESym(name) -> if op_name(name) { nil } else { free_sym(name, bound, outer, g) }
    _ -> free_vars(callee, bound, outer, g)
  }
}

// 三级：本层 bound → 不自由；外层 outer → 自由（**词法捕获优先于全局**，否则
// 与全局 define/cfunc 同名的捕获值会静默落到 IGlob，见 issue 复现）；否则全局可
// 解 → 不自由（真全局引用）；否则自由（未定义名，闭包封闭性检查据此报错）。
fn free_sym(name : Symbol, bound : List(Symbol), outer : List(Symbol), g : List(Bind)) -> List(Symbol) {
  if member(name, bound) {
    nil
  } else {
    if member(name, outer) {
      [name]
    } else {
      if resolvable(name, g) { nil } else {[name] }
    }
  }
}

// 全局可解 = define 名，或宿主 cfunc 名（裸白名单 / 带点）。
// 名字是否可用：locals/全局表命中，或宿主侧可解析的名字（裸 cfunc / 带点
// 模块 cfunc / actor 内建原语）。actor 原语不走 IGlob 而走 builtin_id 固化
// 的整数 id（compile_general），故它们同样「有名字可解析」——本判据与
// compile_general 的分派必须一致，否则 receive 脱糖产物（recv_peek /
// recv_commit）会被这里误判成未定义名。
fn resolvable(name : Symbol, g : List(Bind)) -> Bool {
  if assoc_find(name, g) >= 0 {
    true
  } else {
    if lib_cfunc_head(name) { true } else { is_builtin(name) }
  }
}

fn is_builtin(name : Symbol) -> Bool {
  match builtin_id(name) {
    Some(_) -> true
    None -> false
  }
}

// 序列（begin 表单 / 调用实参）：逐项求值，前一项引入的绑定对后一项可见 ——
// 与 compile_begin / compile_call 的 ctx 穿透同序。
fn free_seq(forms : List(Expr), bound : List(Symbol), outer : List(Symbol), g : List(Bind)) -> List(Symbol) {
  match forms {
    [] -> nil
    [h | rest] -> cat(free_vars(h, bound, outer, g), free_seq(rest, cat(introduced(h), bound), outer, g))
  }
}

// 「本表达式求值后，同一序列里新增的可见名字」—— codegen 的 ctx 扩展在名字集上的
// 投影：compile_let 回传扩展后的 env（含 body 增量）、compile_begin / compile_call
// 顺序穿透、compile_if 只回传 cond 之后的 env、lambda 开新作用域不外泄。
fn introduced(e : Expr) -> List(Symbol) {
  match e {
    EConst(_) -> nil
    ESym(_) -> nil
    ELambda(_, _) -> nil
    ELet(name, _, body) -> cons(name, introduced(body))
    EIf(cond, _, _) -> introduced(cond)
    EBegin(forms) -> introduced_seq(forms)
    ECall(callee, args) -> cat(introduced(callee), introduced_seq(args))
  }
}

fn introduced_seq(forms : List(Expr)) -> List(Symbol) {
  match forms {
    [] -> nil
    [h | rest] -> cat(introduced(h), introduced_seq(rest))
  }
}

// =====================================================================
// codegen：Expr 树 → Ins 树（全标注 + 穷尽 match）
// =====================================================================

// 原子字面量 → 指令。整数字面量走 IConstI（立即数内嵌进指令词流，不占常量池）。
fn const_ins(c : Const) -> List(Ins) {
  match c {
    CInt(v) ->[IConstI(v)]
    _ ->[IConst(c)]
  }
}

fn compile_expr(e : Expr, g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match e {
    EConst(x) -> CompRes(const_ins(x), c)
    ESym(name) -> compile_ref(name, g, c)
    ELambda(params, body) -> compile_lambda(params, body, g, c, Anon, -1)
    ELet(name, init, body) -> compile_let(name, init, body, g, c, tail)
    EIf(cond, yes, no) -> compile_if(cond, yes, no, g, c, tail)
    EBegin(forms) -> compile_begin(forms, g, c, tail)
    ECall(callee, args) -> compile_call(callee, args, g, c, tail)
  }
}

// 变量引用：locals → ILoad；upvals → ILoadF；否则按名全局（define / cfunc）。
// 「否则」是安全的：free_vars 已把全局可解的名字排除出 upvals，故落到这里
// 的名字必然是 define 名或 cfunc 名，装载期 link_unit 按名解析。
fn compile_ref(name : Symbol, g : List(Bind), c : Ctx) -> CompRes {
  match c {
    Ctx(locals, upvals, _, _, _) -> {
      let slot = assoc_find(name, locals)
      if slot >= 0 {
        CompRes([ILoad(slot)], c)
      } else {
        let idx = assoc_find(name, upvals)
        if idx >= 0 { CompRes([ILoadF(idx)], c) } else { CompRes([IGlob(name)], c) }
      }
    }
  }
}

// if：三分支各自编译成 IIf。else 必须用 cond 之后的 locals —— then 里的
// let 绑定不得泄漏进 else（槽号重合会让 else 读到 then 的残留值）。计数器
// 与函数池取 then 之后的值：槽区按最宽分支预留，且单调不回退。
fn compile_if(cond : Expr, yes : Expr, no : Expr, g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match compile_expr(cond, g, c, false) {
    CompRes(cc, c1) -> match c1 {
      Ctx(env1, up1, _, _, _) ->
      match compile_expr(yes, g, c1, tail) {
        CompRes(tc, Ctx(_, _, ns2, nf2, fns2)) ->
        match compile_expr(no, g, Ctx(env1, up1, ns2, nf2, fns2), tail) {
          CompRes(fc, c3) -> CompRes([IIf(cc, tc, fc)], c3)
        }
      }
    }
  }
}

// begin：顺序拼接；中间值入 acc 即死（无需栈流量），末位继承 tail。
// 空 begin（`(begin)`）只有手写 `.kl` 造得出（TA 源的 `{}` 落成 begin 里的一个
// nil），给 nil —— 旧编译器这条退化路径给整数 0，是新老产物**唯一**一处分歧。
fn compile_begin(forms : List(Expr), g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match forms {
    [] -> CompRes(const_ins(CNil), c)
    [one] -> compile_expr(one, g, c, tail)
    [h | rest] -> match compile_expr(h, g, c, false) {
      CompRes(hc, c1) -> match compile_begin(rest, g, c1, tail) {
        CompRes(tc, c2) -> CompRes(cat(hc, tc), c2)
      }
    }
  }
}

// (let (name init) body)：init → IStore 新槽；body 在扩展后的 locals 里编。
// init 编译后计数器/函数池可能前进（里面的匿名 lambda 占了号），故 body 的
// ctx 从 init 的结果解构，而不是沿用入参 c。
fn compile_let(name : Symbol, init : Expr, body : Expr, g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match compile_expr(init, g, c, false) {
    CompRes(vc, Ctx(env, up, ns, nf, fns)) ->
    match compile_expr(body, g, Ctx(cons(Bind(name, ns), env), up, ns + 1, nf, fns), tail) {
      CompRes(bc, c3) -> CompRes(cat(vc, cat([IStore(ns)], bc)), c3)
    }
  }
}

// (lambda (p...) body)：本层新函数。
//   locals = 参数（VM CALL 把实参放 base+1..n），局部槽从 nargs+4 起编
//     （槽 0 fn、槽 1..nargs 实参、槽 nargs+1..nargs+3 是 CALL 压的 cont 三槽）
//   upvals = free_vars(body, params, 父层可见名)，下标序即 ILoadF 序
// 父侧按同一张表取值（末值留 acc）再发 MAKE_CLOSURE：free[] 槽位与子层
// ILoadF 下标一一对齐。
fn compile_lambda(params : List(Symbol), body : Expr, g : List(Bind), c : Ctx,
nm : FnName, fid : Int) -> CompRes {
  match c {
    Ctx(env, up, ns, nf, fns) -> {
      // outer = 父层 env ∪ upvals 的名字：本层自由名若在外层词法作用域里，
      // 必须当作捕获（LOADF），不能因为与全局 define/cfunc 同名而落到 IGlob。
      let fvs = free_vars(body, params, cat(bind_names(env), bind_names(up)), g)
      let cbody = Ctx(param_bindings(params, 1), index_bindings(fvs, 0), len(params) + 4, nf, fns)
      match compile_expr(body, g, cbody, true) {
        CompRes(bc, Ctx(_, _, bns, bnf, bfns)) -> {
          let nlocals = bns - len(params) - 4
          let code = cat([IReserve(nlocals)], cat(bc,[IRet(len(params))]))
          // 匿名 lambda 的 fid 后序分配（body 编完才取号）；fid >= 0 是预分配的 define id。
          let myfid = if fid < 0 { bnf } else { fid }
          let nfin = if fid < 0 { bnf + 1 } else { bnf }
          let pool = insert_fn(FnRec(myfid, nm, len(params), code), bfns)
          CompRes(cat(free_loads(fvs, env, up),[IClos(myfid, len(fvs))]),
          Ctx(env, up, ns, nfin, pool))
        }
      }
    }
  }
}

fn param_bindings(params : List(Symbol), slot : Int) -> List(Bind) {
  match params {
    [] -> nil
    [p | rest] -> cons(Bind(p, slot), param_bindings(rest, slot + 1))
  }
}

fn index_bindings(names : List(Symbol), i : Int) -> List(Bind) {
  match names {
    [] -> nil
    [h | rest] -> cons(Bind(h, i), index_bindings(rest, i + 1))
  }
}

// Bind 列表 → 名字列表（父层可见词法名，供 free_vars 的 outer 判「词法捕获」）。
fn bind_names(binds : List(Bind)) -> List(Symbol) {
  match binds {
    [] -> nil
    [Bind(n, _) | rest] -> cons(n, bind_names(rest))
  }
}

// 父侧自由变量取值。每取一个补 IPUSH，末值留 acc —— MAKE_CLOSURE 先
// flush acc 作最后一个自由值，再从栈上收前 n-1 个。
fn free_loads(fvs : List(Symbol), env : List(Bind), up : List(Bind)) -> List(Ins) {
  match fvs {
    [] -> nil
    [f | rest] -> {
      let one = free_load(f, env, up)
      if pair?(rest) {
        cat(one, cons(IPush, free_loads(rest, env, up)))
      } else {
        cat(one, free_loads(rest, env, up))
      }
    }
  }
}

fn free_load(name : Symbol, env : List(Bind), up : List(Bind)) -> List(Ins) {
  let slot = assoc_find(name, env)
  if slot >= 0 {[ILoad(slot)] } else {[ILoadF(assoc_find(name, up))] }
}

// ---------- 调用 ----------
fn call_ins(tail : Bool, n : Int) -> Ins {
  if tail { ITCall(n) } else { ICall(n) }
}

// 符号头调用：算符原语（binop / unop）编译期固化 opcode，否则一般调用。
// 参数个数与算符不匹配（畸形输入）退化成一般调用 —— 显式走运行期报错，
// 而不是静默编出垃圾。
fn compile_call(callee : Expr, args : List(Expr), g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match callee {
    ESym(name) -> match op_kind(name) {
      BinOp(op) -> match args {
        [a, b] -> compile_binop(op, a, b, g, c)
        _ -> compile_general(callee, args, g, c, tail)
      }
      UnOp(op) -> match args {
        [a] -> compile_unop(op, a, g, c)
        _ -> compile_general(callee, args, g, c, tail)
      }
      NotAnOp -> compile_general(callee, args, g, c, tail)
    }
    _ -> compile_general(callee, args, g, c, tail)
  }
}

// 二元原语：左操作数 → 栈顶（IPUSH），右操作数留 acc，IOp 配对。
fn compile_binop(op : Int, a : Expr, b : Expr, g : List(Bind), c : Ctx) -> CompRes {
  match compile_expr(a, g, c, false) {
    CompRes(lc, c1) -> match compile_expr(b, g, c1, false) {
      CompRes(rc, c2) -> CompRes(cat(cat(lc,[IPush]), cat(rc,[IOp(op)])), c2)
    }
  }
}

fn compile_unop(op : Int, e : Expr, g : List(Bind), c : Ctx) -> CompRes {
  match compile_expr(e, g, c, false) {
    CompRes(xc, c1) -> CompRes(cat(xc,[IOp(op)]), c1)
  }
}

// 一般调用协议（与 tavm CALL n 对齐）：f 入栈；a1..a(n-1) 逐个 IPUSH；末参留
// acc；CALL n = 参数数 + 1（CALL 内 flush acc 作末参 → 压 cont 三槽 → 整帧成形）。
// 0 参是特例：不发 IPUSH，f 留在 acc 由 CALL 的 flush 充当 fn 槽。
// 调用：内建 actor 原语（self/spawn/send/recv…）在编译期固化成整数 id，其余
// 走一般调用。派发表是 builtin_id。
fn compile_general(callee : Expr, args : List(Expr), g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  match callee {
    ESym(name) -> match builtin_id(name) {
      Some(bid) -> compile_builtin(bid, args, g, c)
      None -> compile_general_named(callee, args, g, c, tail)
    }
    _ -> compile_general_named(callee, args, g, c, tail)
  }
}

// spawn('name)：tavm 的 LB_SPAWN 接受闭包值（子进程跑 entry fnid），而 'name
// 本身不是闭包值 —— 故编译成 IClos(fnid, 0) + B_SPAWN。名字不在 define 表
// （拼错 / 非顶层名）就不走特例，交给运行期显式失败。
fn compile_builtin(bid : Int, args : List(Expr), g : List(Bind), c : Ctx) -> CompRes {
  match args {
    [EConst(CSym(name))] ->
    if bid == B_SPAWN && assoc_find(name, g) >= 0 {
      CompRes([IClos(assoc_find(name, g), 0), IBuiltin(B_SPAWN, 1)], c)
    } else {
      builtin_call(bid, args, g, c)
    }
    _ -> builtin_call(bid, args, g, c)
  }
}

// 内建调用：协议与 CALL 一致（前 n-1 参压栈、末参留 acc）但不发 fn 槽。
fn builtin_call(bid : Int, args : List(Expr), g : List(Bind), c : Ctx) -> CompRes {
  match compile_args(args, g, c) {
    CompRes(ac, c1) -> CompRes(cat(ac,[IBuiltin(bid, len(args))]), c1)
  }
}

// 一般调用协议（与 tavm CALL n 对齐）：f 入栈；a1..a(n-1) 逐个 IPUSH；末参留
// acc；CALL n = 参数数 + 1（CALL 内 flush acc 作末参 → 压 cont 三槽 → 整帧成形）。
// 0 参是特例：不发 IPUSH，f 留在 acc 由 CALL 的 flush 充当 fn 槽。
fn compile_general_named(callee : Expr, args : List(Expr), g : List(Bind), c : Ctx, tail : Bool) -> CompRes {
  let n = len(args) + 1
  match compile_head(callee, g, c) {
    CompRes(fc, c1) -> match args {
      [] -> CompRes(cat(fc,[call_ins(tail, n)]), c1)
      _ -> match compile_args(args, g, c1) {
        CompRes(ac, c2) -> CompRes(cat(cat(cat(fc,[IPush]), ac),[call_ins(tail, n)]), c2)
      }
    }
  }
}

// 调用头解析序：locals → define 表 → 宿主 cfunc（裸白名单 / 带点）→ 运行期值。
fn compile_head(callee : Expr, g : List(Bind), c : Ctx) -> CompRes {
  match callee {
    ESym(name) -> match c {
      Ctx(env, _, _, _, _) ->
      if assoc_find(name, env) < 0 && assoc_find(name, g) < 0 && lib_cfunc_head(name) {
        CompRes([IGlob(name)], c)
      } else {
        compile_ref(name, g, c)
      }
    }
    _ -> compile_expr(callee, g, c, false)
  }
}

// 除末参外：逐个编译 + IPUSH；末参只编译（留 acc）。
fn compile_args(args : List(Expr), g : List(Bind), c : Ctx) -> CompRes {
  match args {
    [] -> CompRes(nil, c)
    [last] -> compile_expr(last, g, c, false)
    [h | rest] -> match compile_expr(h, g, c, false) {
      CompRes(hc, c1) -> match compile_args(rest, g, c1) {
        CompRes(tc, c2) -> CompRes(cat(cat(hc,[IPush]), tc), c2)
      }
    }
  }
}

// =====================================================================
// 顶层
// =====================================================================

// define 收集：名字 → fnid（1..k）。重名编译期拒绝（同名全局会静默调错）。
fn collect_globals(forms : List(Top), next_id : Int, acc : List(Bind)) -> Globals {
  match forms {
    [] -> Globals(acc, next_id)
    [TDef(name, _) | rest] -> {
      if assoc_find(name, acc) == -1 {
        collect_globals(rest, next_id + 1, cat(acc,[Bind(name, next_id)]))
      } else {
        DupGlobal(str.concat("duplicate global: ", str.sym_to_str(name)))
      }
    }
    [_ | rest] -> collect_globals(rest, next_id, acc)
  }
}

// 未定义名拦截：define 必须自我封闭，顶层表单不得引用未绑定名。放在 codegen
// 之前 —— 否则 compile_ref 会把未定义名当成 IGlob，拖到运行期才炸（名字
// 错误必须在前端拦）。define 值非 lambda 也在这里一并拒掉（嵌套模式顺手咬住）。
// 顶层也是一个序列：前面的 (let …) 引入的名字对后面的表单可见（与 codegen 的顶层
// ctx 一致），故 bound 随表单累积。
fn check_names(forms : List(Top), bound : List(Symbol), g : List(Bind)) -> Option(String) {
  match forms {
    [] -> None
    // define 体在 codegen 里以当前顶层 ctx 为外层作用域（compile_program 传 c），
    // 故 outer = bound：引用得到顶层 let 就当捕获，和 codegen 对齐。
    [TDef(name, ELambda(params, body)) | rest] -> {
      let fv = free_vars(body, params, bound, g)
      if pair?(fv) {
        Some(undef_msg(str.concat("define ", str.sym_to_str(name)), fv))
      } else {
        check_names(rest, bound, g)
      }
    }
    [TDef(name, _) | rest] -> Some(str.concat("define value must be a lambda: ", str.sym_to_str(name)))
    [TExpr(e) | rest] -> {
      let fv = free_vars(e, bound, nil, g)
      if pair?(fv) { Some(undef_msg("top level", fv)) } else { check_names(rest, cat(introduced(e), bound), g) }
    }
  }
}

fn undef_msg(where : String, names : List(Symbol)) -> String {
  str.concat("undefined name(s) in ", str.concat(where, str.concat(": ", render_names(names))))
}

fn render_names(names : List(Symbol)) -> String {
  match names {
    [] -> ""
    [h | rest] -> str.concat(str.sym_to_str(h), str.concat(" ", render_names(rest)))
  }
}

// 顶层 define 编成独立函数（名字进 FnRec，供 .tabc 的 nameidx 与按名链接）；
// 其余表单顺序拼进 entry。
fn compile_program(forms : List(Top), g : List(Bind), c : Ctx) -> CompRes {
  match forms {
    [] -> CompRes(nil, c)
    [TDef(name, ELambda(params, body)) | rest] ->
    match compile_lambda(params, body, g, c, Named(name), assoc_find(name, g)) {
      CompRes(_, c2) -> compile_program(rest, g, c2)
    }
    // check_names 已把「define 值非 lambda」拒在门外；这里跳过继续编其余。
    [TDef(_, _) | rest] -> compile_program(rest, g, c)
    [TExpr(e) | rest] -> match compile_expr(e, g, c, false) {
      CompRes(fc, c1) -> match compile_program(rest, g, c1) {
        CompRes(rc, c2) -> CompRes(cat(fc, rc), c2)
      }
    }
  }
}

// compile(prog) -> Out(fns, consts) | Fail(msg)
// entry（fnid 0）的局部槽从 4 起：槽 0 fn、槽 1..3 与被调帧的 cont 区对齐，
// 顶层 let 的槽号才与被调帧布局一致。
pub fn compile(prog : List(Top)) -> Out {
  match collect_globals(prog, 1, nil) {
    DupGlobal(msg) -> Fail(msg)
    Globals(g, nid) ->
    match check_names(prog, nil, g) {
      Some(msg) -> Fail(msg)
      None ->
      match compile_program(prog, g, Ctx(nil, nil, 4, nid, nil)) {
        CompRes(code, Ctx(_, _, ens, _, pool)) -> {
          let entry = FnRec(0, Anon, 0, cat([IReserve(ens - 4)], cat(code,[IRet(0)])))
          match flatten_all(insert_fn(entry, pool), nil, nil) {
            FlatRes(fns, consts) -> Out(fns, consts)
          }
        }
      }
    }
  }
}

// =====================================================================
// fuse：指令融合（flatten / depth 吃同一棵融合后的 Ins 树）
// =====================================================================
// 两类：（1）ILoad/IConst/IGlob 后紧跟 IPush（实参传递形态，热路径大头）→
// 一条融合指令；（2）IIf 的 cond 以比较 IOp 结尾（if <cmp> 形态）→ IIfP/IIfI，
// flatten 期发 JIF_* 融合跳转。递归进 IIf 三分支。

// 列表以 IOp(op) 结尾 → 该 op，否则 None（只在编译期；cond 列表短）
fn last_iop(code : List(Ins)) -> Option(Int) {
  match code {
    [] -> None
    [IOp(op)] -> Some(op)
    [_ | rest] -> last_iop(rest)
  }
}

// 去掉末元素（配 last_iop）
fn init_ins(code : List(Ins)) -> List(Ins) {
  match code {
    [] -> nil
    [_] -> nil
    [h | rest] -> cons(h, init_ins(rest))
  }
}

// 列表以 IConstI(imm) 结尾 → TailImmYes(imm)。if (<cmp> imm) 的 cond 剥掉结尾
// IOp(cmp) 后剩的尾巴：立即数字面量 → IIfI（仅 EQ）或 IIfP。
fn tail_const_i(code : List(Ins)) -> TailImm {
  match code {
    [] -> TailImmNo
    [IConstI(imm)] -> TailImmYes(imm)
    [_ | rest] -> tail_const_i(rest)
  }
}

// 可融合成立即数形态的算术：只留 ADD/SUB —— MUL/DIV/MOD 的流量占比在基准与
// 真实负载里都不到 6%，不值得各自的 opcode。故意不含 OP_LT..OP_EQ：那五条走
// if 的 IIfP/IIfI 融合（比较+跳转合成一次派发），比各自出 IOpI 更好。
fn arith_i_p(op : Int) -> Bool { op == OP_ADD || op == OP_SUB }

fn fuse(code : List(Ins)) -> List(Ins) {
  match code {
    [] -> nil
    [IIf(cond, yes, no) | rest] -> {
      // cond 以比较结尾（if <cmp> 形态）→ 融合成比较+跳转。typecheck 保证
      // cond : bool，而 bool 值的 IOp 只有五条比较，范围检查兜底。
      let fc = fuse(cond)
      // body = 剥掉结尾 IOp(cmp) 的 cond（IIfP 收 cond，IIfI 还要再剥一层）
      let body = init_ins(fc)
      match last_iop(fc) {
        Some(op) ->
        if op >= OP_LT && op <= OP_EQ {
          match tail_const_i(body) {
            // cond = [..., IConstI(imm), IOp(cmp)]：右操作数是立即数字面量。
            // 只有 EQ 走立即数版（JIF_EQ_I 一次派发完成比较+跳转）；其余比较
            // 退回 IIfP（仍是一次派发，只是右操作数走常量池）。
            TailImmYes(imm) ->
            if op == OP_EQ {
              cons(IIfI(imm, init_ins(body), fuse(yes), fuse(no)), fuse(rest))
            } else {
              cons(IIfP(op, body, fuse(yes), fuse(no)), fuse(rest))
            }
            TailImmNo -> cons(IIfP(op, body, fuse(yes), fuse(no)), fuse(rest))
          }
        } else {
          cons(IIf(fc, fuse(yes), fuse(no)), fuse(rest))
        }
        None -> cons(IIf(fc, fuse(yes), fuse(no)), fuse(rest))
      }
    }
    [ILoad(s) | rest] -> match rest {
      [IPush | more] -> cons(ILoadP(s), fuse(more))
      _ -> cons(ILoad(s), fuse(rest))
    }
    [IConst(a) | rest] -> match rest {
      [IPush | more] -> cons(IConstP(a), fuse(more))
      _ -> cons(IConst(a), fuse(rest))
    }
    // 立即数字面量后跟算术 IOp → IOpI：imm 在 acc = 右操作数，语义正确
    //（+1、-1 这类最常见形态各少一次派发）。
    [IConstI(a) | rest] -> match rest {
      [IOp(op) | more] ->
      if arith_i_p(op) {
        cons(IOpI(op, a), fuse(more))
      } else {
        cons(IConstI(a), fuse(rest))
      }
      _ -> cons(IConstI(a), fuse(rest))
    }
    [IGlob(x) | rest] -> match rest {
      [IPush | more] -> cons(IGlobP(x), fuse(more))
      _ -> cons(IGlob(x), fuse(rest))
    }
    [i | rest] -> cons(i, fuse(rest))
  }
}

// =====================================================================
// flatten：Ins 树 → int 词流 + 常量池
// =====================================================================
// 编码知识全部集中在这个 match 里。IIf 展平：
//   cond; JIF <假→else>; then; JUMP <→end>; else
// 真路径 = pc+2 下落进 then，故 JIF 只带一个操作数（假目标）。
// 编码知识全部集中在这个 match 里。IIf 展平：cond；融合/普通跳转；then；JUMP；
// else。真路径 = 跳转后的下落，故目标全是函数内**绝对词偏移**，展平期回填。
// OP_JIF 只带一个操作数（假目标），融合跳转（OP_JIF_*）带真/假两个。
fn flat_if(rest : List(Ins), jif_op : Int, cond : List(Ins), yes : List(Ins), no : List(Ins),
ws : List(Int), pool : List(Const)) -> WRes {
  match flat2(cond, ws, pool) {
    WRes(wa, pa) -> {
      let ji = len(wa)
      let two_word = jif_op == OP_JIF
      let wb = if two_word { emit2(wa, jif_op, 0) } else { emit3(wa, jif_op, 0, 0) }
      match flat2(yes, wb, pa) {
        WRes(wt, pb) -> {
          let t_off = len(wb)
          let wc = emit2(wt, OP_JUMP, 0)
          let jp = len(wc) - 1
          let f_off = jp + 1
          match flat2(no, wc, pb) {
            WRes(we, pe) -> {
              let end = len(we)
              let w1 = if two_word {
                set_w(set_w(we, ji + 1, f_off), jp, end)
              } else {
                set_w(set_w(set_w(we, ji + 1, t_off), ji + 2, f_off), jp, end)
              }
              flat2(rest, w1, pe)
            }
          }
        }
      }
    }
  }
}

// IIfI 的展平：与 flat_if 同构，唯一差别是融合跳转多带一个立即数字
// （(JIF_EQ_I, imm, t, f) 占 4 词），两目标位从 ji+1/ji+2 后移到 ji+2/ji+3。
fn flat_if_i(rest : List(Ins), jif_op : Int, imm : Int, cond : List(Ins), yes : List(Ins), no : List(Ins),
ws : List(Int), pool : List(Const)) -> WRes {
  match flat2(cond, ws, pool) {
    WRes(wa, pa) -> {
      let ji = len(wa)
      let wb = emit4(wa, jif_op, imm, 0, 0)
      match flat2(yes, wb, pa) {
        WRes(wt, pb) -> {
          let t_off = len(wb)
          let wc = emit2(wt, OP_JUMP, 0)
          let jp = len(wc) - 1
          let f_off = jp + 1
          match flat2(no, wc, pb) {
            WRes(we, pe) -> {
              let end = len(we)
              flat2(rest, set_w(set_w(set_w(we, ji + 2, t_off), ji + 3, f_off), jp, end), pe)
            }
          }
        }
      }
    }
  }
}

fn flat2(ins : List(Ins), ws : List(Int), pool : List(Const)) -> WRes {
  match ins {
    [] -> WRes(ws, pool)
    [i | rest] -> match i {
      IConst(c) -> match pool_add_idx(c, pool) {
        PoolNew(idx) -> flat2(rest, emit2(ws, OP_CONST, idx), cat(pool,[c]))
        PoolHit(idx) -> flat2(rest, emit2(ws, OP_CONST, idx), pool)
      }
      IConstP(c) -> match pool_add_idx(c, pool) {
        PoolNew(idx) -> flat2(rest, emit2(ws, OP_CONSTP, idx), cat(pool,[c]))
        PoolHit(idx) -> flat2(rest, emit2(ws, OP_CONSTP, idx), pool)
      }
      IConstI(imm) -> flat2(rest, emit2(ws, OP_CONST_I, imm), pool)
      ILoad(s) -> flat2(rest, emit2(ws, OP_LOAD, s), pool)
      ILoadP(s) -> flat2(rest, emit2(ws, OP_LOADP, s), pool)
      ILoadF(k) -> flat2(rest, emit2(ws, OP_LOADF, k), pool)
      IStore(s) -> flat2(rest, emit2(ws, OP_STORE, s), pool)
      IGlob(name) -> match pool_add_idx(CSym(name), pool) {
        PoolNew(idx) -> flat2(rest, emit2(ws, OP_GLOBAL, idx), cat(pool,[CSym(name)]))
        PoolHit(idx) -> flat2(rest, emit2(ws, OP_GLOBAL, idx), pool)
      }
      IGlobP(name) -> match pool_add_idx(CSym(name), pool) {
        PoolNew(idx) -> flat2(rest, emit2(ws, OP_GLOBP, idx), cat(pool,[CSym(name)]))
        PoolHit(idx) -> flat2(rest, emit2(ws, OP_GLOBP, idx), pool)
      }
      IPush -> flat2(rest, emit1(ws, OP_PUSH), pool)
      IOp(op) -> flat2(rest, emit1(ws, op), pool)
      IOpI(op, imm) -> flat2(rest, emit2(ws, op - OP_ADD + OP_ADD_I, imm), pool)
      ICall(n) -> flat2(rest, emit2(ws, OP_CALL, n), pool)
      ITCall(n) -> flat2(rest, emit2(ws, OP_TCALL, n), pool)
      IBuiltin(id, n) -> flat2(rest, emit3(ws, OP_BUILTIN, id, n), pool)
      IClos(fid, nfree) -> flat2(rest, emit3(ws, OP_MAKE_CLOSURE, fid, nfree), pool)
      IRet(k) -> flat2(rest, emit2(ws, OP_RET, k), pool)
      IReserve(n) -> flat2(rest, emit2(ws, OP_RESERVE, n), pool)
      IIf(cond, yes, no) -> flat_if(rest, OP_JIF, cond, yes, no, ws, pool)
      IIfP(op, cond, yes, no) -> flat_if(rest, op - OP_LT + OP_JIF_LT, cond, yes, no, ws, pool)
      IIfI(imm, cond, yes, no) -> flat_if_i(rest, OP_JIF_EQ_I, imm, cond, yes, no, ws, pool)
    }
  }
}

fn pool_add_idx(c : Const, pool : List(Const)) -> PoolIdx {
  let i = pool_idx(c, pool, 0)
  if i < 0 { PoolNew(len(pool)) } else { PoolHit(i) }
}

fn pool_idx(c : Const, pool : List(Const), k : Int) -> Int {
  match pool {
    [] -> -1
    [h | rest] -> if const_eq(h, c) { k } else { pool_idx(c, rest, k + 1) }
  }
}

fn pool_add(c : Const, pool : List(Const)) -> List(Const) {
  match pool_add_idx(c, pool) {
    PoolNew(_) -> cat(pool,[c])
    PoolHit(_) -> pool
  }
}

// 两个常量是否相等：不能直接用 == —— 构造器值落在堆上是 pair，按身份比较
// （CSym('a) == CSym('a) 为假），逐字段递归才是正确语义。把 [a, b] 收进一个
// 列表再匹配：平铺所有情形，免去逐层嵌套 match（无参构造子直接 `==` 相等，
// 带参的靠 guard 拆字段）。用**列表** [a, b] 而非 pair cons(a, b)，因为列表是
// 齐次 List，构造子模式（`[CInt(v), CInt(w)]`）能干净统一；pair 形态反而让
// 类型 check 纠结。
// 没有 CFloat 臂是**有意的**：浮点常量在池里按身份不去重（与旧编译器逐字对齐
// —— 旧侧拿 `('float "1.5")` 形态按 == 比，从不命中）。补上它会让池布局变化，
// 破坏「旧新产物逐字节相同」这条门。
fn const_eq(a : Const, b : Const) -> Bool {
  match[a, b] {
    [CNil, CNil] -> true
    [CTrue, CTrue] -> true
    [CFalse, CFalse] -> true
    [CInt(v), CInt(w)] when v == w -> true
    [CSym(n), CSym(m)] when n == m -> true
    [CStr(s), CStr(t)] when str.eq(s, t) -> true
    _ -> false
  }
}

// 函数池按 fid 有序插入（fid 连续 0..n-1，各一次）；展平直接吃这个顺序。
fn insert_fn(fr : FnRec, pool : List(FnRec)) -> List(FnRec) {
  match fr {
    FnRec(fid, _, _, _) -> insert_at(fid, fr, pool)
  }
}

fn insert_at(fid : Int, fr : FnRec, pool : List(FnRec)) -> List(FnRec) {
  match pool {
    [] ->[fr]
    [FnRec(f2, _, _, _) | _] -> if fid < f2 { cons(fr, pool) } else { cons(car(pool), insert_at(fid, fr, cdr(pool))) }
  }
}

// 每个函数：define 名入池 → fuse → 展平 body → 算 maxd（必须在展平前，词流已
// 认不出指令边界）。d0 = nargs + 4；首指令 IReserve 自己把 d 抬过局部变量区。
fn flatten_all(fns : List(FnRec), pool : List(Const), acc : List(FnBC)) -> FlatRes {
  match fns {
    [] -> FlatRes(rev(acc), pool)
    [FnRec(_, nm, na, code) | rest] -> {
      let p0 = match nm {
        Named(s) -> pool_add(CSym(s), pool)
        Anon -> pool
      }
      let fc = fuse(code)
      match flat2(fc, nil, p0) {
        WRes(ws, p1) -> match depth(fc, na + 4, na + 4) {
          DP(_, mx) -> flatten_all(rest, p1, cons(FnBC(nm, na, mx, ws), acc))
        }
      }
    }
  }
}

// =====================================================================
// depth：在 Ins 树上模拟栈深
// =====================================================================
// 帧布局（vm.c 显式 continuation 协议）：
//   base+0 fn | base+1..nargs 实参 | base+nargs+1..+3 cont 三槽 | 其上局部变量
// PUSH +1；二元原语弹 1；CALL n 净深 d+1-n、瞬态峰 d+4（flush 末参 + cont
// 三槽）；MAKE_CLOSURE 净深 d+1-nfv。
fn bigger(a : Int, b : Int) -> Int { if a > b { a } else { b } }

fn binop_p(op : Int) -> Bool { op >= 5 && op <= 14 || op == 17 }

// 逐指令模拟求值栈深。融合指令的净效应与未融合形态一致，见 Ins 注释。
fn depth(code : List(Ins), d : Int, m : Int) -> DepthRes {
  match code {
    [] -> DP(d, m)
    [i | rest] -> match i {
      IReserve(n) -> depth(rest, d + n, bigger(d + n, m))
      IPush -> depth(rest, d + 1, bigger(d + 1, m))
      ILoadP(_) -> depth(rest, d + 1, bigger(d + 1, m))
      IConstP(_) -> depth(rest, d + 1, bigger(d + 1, m))
      IGlobP(_) -> depth(rest, d + 1, bigger(d + 1, m))
      IOp(op) -> if binop_p(op) { depth(rest, d - 1, m) } else { depth(rest, d, m) }
      IOpI(op, _) -> if binop_p(op) { depth(rest, d - 1, m) } else { depth(rest, d, m) }
      ICall(n) -> depth(rest, d + 1 - n, bigger(d + 4, m))
      ITCall(n) -> depth(rest, d + 1 - n, bigger(d + 4, m))
      // 内建调用同样把 n 个实参移出求值栈（净 0），峰值与 CALL 同形。
      IBuiltin(_, n) -> depth(rest, d, bigger(d + n - 1, m))
      IClos(_, nfv) -> depth(rest, d + 1 - nfv, bigger(d + 1 - nfv, m))
      IIf(cond, yes, no) -> if_branches(cond, yes, no, rest, d, m, 0)
      // 融合比较+跳转：cond 里那次比较已不在树上，两分支从 dc - 1 起。
      IIfP(_, cond, yes, no) -> if_branches(cond, yes, no, rest, d, m, 1)
      IIfI(_, cond, yes, no) -> if_branches(cond, yes, no, rest, d, m, 1)
      _ -> depth(rest, d, m)
    }
  }
}

// IIf 三分支的栈深：cond 走完后两分支各从哪里起（融合跳转少了 cond 尾部的
// 比较 —— 那次比较本来会弹掉一个操作数，故 pop = 1 时起点下移一格）。分支汇合
// 后必须接着走 rest：丢掉 rest 会漏算 if 之后指令抬起来的峰值（尾调用的 d+4）。
fn if_branches(cond : List(Ins), yes : List(Ins), no : List(Ins), rest : List(Ins),
d : Int, m : Int, pop : Int) -> DepthRes {
  match depth(cond, d, m) {
    DP(dc, mc) -> match depth(yes, dc - pop, mc) {
      DP(dt, mt) -> match depth(no, dt, mt) {
        DP(de, me) -> depth(rest, de, me)
      }
    }
  }
}

// ---------- 词流小工具 ----------
fn emit1(ws : List(Int), a : Int) -> List(Int) { cat(ws,[a]) }
fn emit2(ws : List(Int), a : Int, b : Int) -> List(Int) { cat(ws,[a, b]) }
fn emit3(ws : List(Int), a : Int, b : Int, c : Int) -> List(Int) { cat(ws,[a, b, c]) }
fn emit4(ws : List(Int), a : Int, b : Int, c : Int, d : Int) -> List(Int) { cat(ws,[a, b, c, d]) }

// 第 pos 词改值（跳转回填）：前缀逆序累积，命中后回卷重建。
fn set_w(ws : List(Int), pos : Int, v : Int) -> List(Int) { sw_loop(ws, pos, v, nil, 0) }

fn sw_loop(ws : List(Int), pos : Int, v : Int, pre : List(Int), k : Int) -> List(Int) {
  match ws {
    [] -> ws
    [h | rest] -> if k == pos { rebuild(pre, cons(v, rest)) } else { sw_loop(rest, pos, v, cons(h, pre), k + 1) }
  }
}

fn rebuild(pre : List(Int), rest : List(Int)) -> List(Int) {
  match pre {
    [] -> rest
    [h | tl] -> rebuild(tl, cons(h, rest))
  }
}
