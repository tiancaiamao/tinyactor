// cov.ta — coverage instrumentation (phase 2).
//
// Phase 1: function-entry counters. Phase 2 adds statement / match-arm
// granularity with source lines. The pipeline slot is unchanged: after
// typecheck, before codegen.
//
// The parser (--cov builds only) wraps every statement and match/receive
// arm body in a (begin (cov.line path line) form) marker. The marker is
// an ordinary cov.<fn> call, so resolve/typecheck accept it untouched;
// instrument() walks the post-resolve forms and rewrites each marker in
// place into (begin (cov.hit k) form), assigning sequential ids and
// recording (k fn file line) rows for the covmap.
//
// Function entries keep a dedicated id (covmap line 0): the gate
// (COV_TA_MIN) still measures function coverage only. An entry row's
// file is derived from the body's first statement marker — defines
// carry no source path after resolve.
//
// The runtime sink is the C "cov" module (src/cov.c): a counter array
// shared by all actors, dumped at process exit and joined with the
// covmap for the report. cov.line is deliberately NOT registered in the
// cov module — a marker that survives to runtime fails loudly instead
// of silently losing coverage data.

import str
import file

// instrument(forms) -> (instrumented_forms . entries)
// entries: ((k name_sym file line_int) ...) in instrument order;
// line 0 = fn entry, line > 0 = statement / arm body.
pub fn instrument(forms) {
  inst_loop(forms, 0, nil, nil)
}

fn rev(xs, acc) {
  if null?(xs) { acc } else { rev(cdr(xs), cons(car(xs), acc)) }
}

fn inst_loop(forms, k, facc, eacc) {
  if null?(forms) {
    cons(rev(facc, nil), rev(eacc, nil))
  } else {
    let form = car(forms)
    if is_define(form) == 1 {
      let name = car(car(cdr(form)))
      let body = car(cdr(cdr(form)))
      let instrumented = cons('begin,
      cons(cons('cov.hit, cons(k, nil)), cons(body, nil)))
      let rb = rw(instrumented, name, k + 1, nil)
      let new_form = cons(car(form),
      cons(car(cdr(form)), cons(car(rb), nil)))
      let stmts = rev(cdr(cdr(rb)), nil)
      let efile = if null?(stmts) { "" } else { car(cdr(cdr(car(stmts)))) }
      let entry = cons(k, cons(name, cons(efile, cons(0, nil))))
      let eacc2 = rev(cons(entry, stmts), eacc)
      inst_loop(cdr(forms), car(cdr(rb)),
      cons(new_form, facc), eacc2)
    } else {
      inst_loop(cdr(forms), k, cons(form, facc), eacc)
    }
  }
}

// rw(e, fname, k, acc) -> (new_e . (next_k . entries_rev)).
// Generic rewrite: recurse into every subform; a marker
// (begin (cov.line f l) s) becomes (begin (cov.hit k) s) and records
// (k fname f l). Everything else is rebuilt unchanged — match arm
// triples and pattern data cannot contain a marker, and the marker
// shape (begin with a cov.line call as its sole first element) does not
// occur in user code.
fn rw(e, fname, k, acc) {
  if pair?(e) {
    if is_marker(e) == 1 {
      let loc = car(cdr(e))
      let hit = cons('cov.hit, cons(k, nil))
      // the marker consumes id k; nested markers start allocating at k + 1
      let rs = rw(car(cdr(cdr(e))), fname, k + 1, acc)
      let inner = cons('begin, cons(hit, cons(car(rs), nil)))
      let row = cons(k, cons(fname,
      cons(car(cdr(loc)), cons(car(cdr(cdr(loc))), nil))))
      let acc2 = cons(row, cdr(cdr(rs)))
      cons(inner, cons(car(cdr(rs)), acc2))
    } else {
      rw_list(e, fname, k, acc)
    }
  } else {
    cons(e, cons(k, acc))
  }
}

fn rw_list(xs, fname, k, acc) {
  if null?(xs) {
    cons(nil, cons(k, acc))
  } else {
    let h = rw(car(xs), fname, k, acc)
    let t = rw_list(cdr(xs), fname, car(cdr(h)), cdr(cdr(h)))
    // t = (new_tail . (k . acc)) — keep only the tail list, not the
    // (k . acc) spine (consing t itself would splice k/acc into the AST).
    cons(cons(car(h), car(t)), cdr(t))
  }
}

// is_marker(e): (begin (cov.line path line) form)
fn is_marker(e) {
  if pair?(e) {
    if car(e) == 'begin {
      let second = car(cdr(e))
      if pair?(second) {
        if car(second) == 'cov.line { 1 } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

// is_define(form): top-level fn definitions are (define (name . params)
// body) / (define_pub ...). Everything else (type, const, import,
// external fn, type-sig) carries no callable body and is left untouched.
fn is_define(form) {
  let head = car(form)
  if head == 'define { 1 } else if head == 'define_pub { 1 } else { 0 }
}

// write_covmap(path, entries): one "k file:line name" row per id;
// line 0 marks a function entry.
pub fn write_covmap(path, entries) {
  file.write(path, covmap_text(entries, ""))
}

fn covmap_text(entries, acc) {
  if null?(entries) {
    acc
  } else {
    let e = car(entries)
    let id_str = str.from_int(car(e))
    let file_str = car(cdr(cdr(e)))
    let line_str = str.from_int(car(cdr(cdr(cdr(e)))))
    let name_str = str.sym_to_str(car(cdr(e)))
    let loc_str = str.concat(file_str, str.concat(":", line_str))
    let row = str.concat(id_str, str.concat(" ",
    str.concat(loc_str, str.concat(" ", str.concat(name_str, "\n")))))
    covmap_text(cdr(entries), str.concat(acc, row))
  }
}
