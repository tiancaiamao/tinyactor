// covinst.ta — coverage instrumentation (TA program coverage).
//
// Pipeline slot: after typecheck, before lower. The parser (--cov builds
// only) wraps every statement and match/receive arm body in a
// (begin (cov.line path line) form) marker. The marker is an ordinary
// cov.<fn> call, so resolve/typecheck accept it untouched; instrument()
// walks the post-resolve form tree and rewrites each marker in place into
// (begin (cov.hit k) form), assigning sequential ids and recording
// (k name file line) rows for the covmap.
//
// Function entries keep a dedicated id (covmap line 0): the gate
// (COV_TA_MIN) measures function coverage. An entry row's file is
// derived from the body's first statement marker — defines carry no
// source path after resolve.
//
// The runtime sink is the C "cov" module (lib/cov.c): a counter array
// shared by all actors, dumped at process exit (TA_COV_DUMP_DIR) and
// joined with the covmap for the report. cov.line is deliberately NOT
// registered in the cov module, so a marker that survives
// instrumentation fails loudly at runtime instead of silently
// reporting nothing. inst_loop walks every top-level form (defines and
// const-bound lambdas alike) so that no body is skipped.
//
// The instrumenter module must not be named `cov`: resolve_loop treats
// `import <builtin-module>` as a no-op, so a colliding name silently
// returns nil from every instrument call (covinst vs the C module cov).
//
// 两棵树都很清楚：进出的程序树是 `form.Form`（与 parser / typecheck /
// lower-ast 同一棵），covmap 行表是**旁路状态**——它天生异型（k 是 int、
// name/file 是文本、line 是 int），不是树，故不进 Form，只在写 .covmap 时
// 按位置读一次。
//
// Phase 2 (statement / match-arm rows, `k file:line name`) is done.
// Phase 3 (SBCL-style entered-but-not-taken third state) is planned, not
// implemented — see docs/coverage-design.md.

import "tinyactor:lib/str"
import "tinyactor:lib/file"
import "tinyactor:lib/bootstrap/ast" as ast
import "tinyactor:lib/bootstrap/form" as form

// instrument(forms) -> (instrumented_forms . entries)
// entries: ((k name file line) ...) in instrument order;
// line 0 = fn entry, line > 0 = statement / arm body.
pub fn instrument(forms : List(form.Form)) {
  inst_loop(forms, 0, nil, nil)
}

fn rev(xs, acc) {
  if null?(xs) { acc } else { rev(cdr(xs), cons(car(xs), acc)) }
}

// ---- 三元组读法（新节点 . (下一个 k . 行表)) ----
//
// rw / rw_list 一次交出三样东西：重写后的节点、下一个可用 id、累积的行表。
// 三者不同型（Form / Int / 行表），HM 里没有元组可写，故按槽位读——每个读法
// 只认一个槽，名字说明读到的是什么。
fn rw_form(r) -> form.Form { car(r) }

fn rw_items(r) -> List(form.Form) { car(r) }

fn rw_k(r) -> Int { car(cdr(r)) }

fn rw_rows(r) { cdr(cdr(r)) }

// hit_form(k) — (cov.hit k)：计数器自增点的调用形（lower 之后就是普通调用）。
fn hit_form(k : Int) -> form.Form {
  form.lst([form.sym('cov.hit), form.FAtom(ast.CInt(k))])
}

fn inst_loop(forms : List(form.Form), k, facc, eacc) {
  if null?(forms) {
    cons(rev(facc, nil), rev(eacc, nil))
  } else {
    let form0 = car(forms)
    let items = form.items(form0)
    if is_define(form0) {
      let name = define_name(form0)
      // The body is the whole element list after (define sig) (the parser
      // emits exactly one form there, but lower's lower_body treats it as a
      // list — wrap the list, so the entry counter precedes every body form).
      let instrumented = form.lst(cons(form.sym('begin),
      cons(hit_form(k), cdr(cdr(items)))))
      let rb = rw(instrumented, name, k + 1, nil)
      let new_form = form.lst([form.nth(items, 0), form.nth(items, 1), rw_form(rb)])
      let rows = rw_rows(rb)
      let efile = if null?(rows) { "" } else { row_file(car(rows)) }
      let entry = cons(k, cons(name, cons(efile, cons(0, nil))))
      let eacc2 = rev(cons(entry, rows), eacc)
      inst_loop(cdr(forms), rw_k(rb),
      cons(new_form, facc), eacc2)
    } else {
      // Non-define top-level forms can still carry markers (e.g. a lambda
      // bound by const); rewrite them so every emitted id lands in the
      // covmap, attributing rows to the const name when present.
      let name = if form.is_sym(form.nth(items, 0), 'const) { sym_str(form.nth(items, 1)) } else { "" }
      let rb = rw(form0, name, k, nil)
      let eacc2 = rev(rw_rows(rb), eacc)
      inst_loop(cdr(forms), rw_k(rb), cons(rw_form(rb), facc), eacc2)
    }
  }
}

// rw(e, fname, k, acc) -> (new_e . (next_k . entries_rev)).
// Generic rewrite: recurse into every subform; a marker
// (begin (cov.line f l) s) becomes (begin (cov.hit k) s) and records
// (k fname f l). Everything else is rebuilt unchanged — match arm
// triples and pattern data cannot contain a marker, and the marker
// shape (begin with a cov.line call as its sole first element) does not
// occur in user code.
fn rw(e : form.Form, fname : String, k : Int, acc) {
  match e {
    form.FAtom(_) -> cons(e, cons(k, acc))
    form.FList(items) -> {
      if is_marker(e) {
        let loc = form.nth(items, 1)
        // the marker consumes id k; nested markers start allocating at k + 1
        let rs = rw(form.nth(items, 2), fname, k + 1, acc)
        let inner = form.lst([form.sym('begin), hit_form(k), rw_form(rs)])
        let row = cons(k, cons(fname,
        cons(loc_path(loc), cons(loc_line(loc), nil))))
        let acc2 = cons(row, rw_rows(rs))
        cons(inner, cons(rw_k(rs), acc2))
      } else {
        // 元素表要装回 FList 才算树节点（form.lst 是唯一的装箱点）。
        let r = rw_list(items, fname, k, acc)
        cons(form.lst(rw_items(r)), cons(rw_k(r), rw_rows(r)))
      }
    }
  }
}

// rw_list(xs, fname, k, acc) -> (new_items . (next_k . entries_rev)).
// 交出的是**元素表**，装箱由调用点做（FList 只在节点这一层存在）。
fn rw_list(xs : List(form.Form), fname : String, k : Int, acc) {
  if null?(xs) {
    cons(nil, cons(k, acc))
  } else {
    let h = rw(car(xs), fname, k, acc)
    let t = rw_list(cdr(xs), fname, rw_k(h), rw_rows(h))
    // t = (new_tail . (k . acc)) — keep only the tail items, not the
    // (k . acc) spine (consing t itself would splice k/acc into the tree).
    cons(cons(rw_form(h), rw_items(t)), cons(rw_k(t), rw_rows(t)))
  }
}

// is_marker(f): (begin (cov.line path line) form)
fn is_marker(f : form.Form) -> Bool {
  let items = form.items(f)
  if form.is_sym(form.nth(items, 0), 'begin) {
    form.is_sym(form.nth(form.items(form.nth(items, 1)), 0), 'cov.line)
  } else {
    false
  }
}

// is_define(f): top-level fn definitions are (define (name . params)
// body) / (define_pub ...). Everything else (type, const, import,
// external fn, type-sig) carries no callable body and is left untouched.
fn is_define(f : form.Form) -> Bool {
  form.is_sym(form.nth(form.items(f), 0), 'define)
  || form.is_sym(form.nth(form.items(f), 0), 'define_pub)
}

// define_name(f): (define (name . params) ...) -> name; the parser
// always emits the pair shape, the bare (define name ...) form is
// accepted for symmetry with lower's lower_define. 名字进 covmap 行是
// **文本**（行表不是树），故这里就地读成字符串。
fn define_name(f : form.Form) -> String {
  let sig = form.nth(form.items(f), 1)
  match sig {
    form.FList(ps) -> sym_str(form.nth(ps, 0))
    form.FAtom(_) -> sym_str(sig)
  }
}

// sym_str(f) — 符号原子 → 名字文本；其它形状 → ""（covmap 行不是树，
// 这里把 Form 读成裸值）。
fn sym_str(f : form.Form) -> String {
  if form.is_sym_form(f) { str.sym_to_str(form.sym_at(f)) } else { "" }
}

// loc_path / loc_line — marker 的 (cov.line path line) 里第 2、3 槽：源路径
// （字符串原子）与行号（整数原子）。形状不对时给零值（与旧版读坏树同义）。
fn loc_path(loc : form.Form) -> String {
  match form.nth(form.items(loc), 1) {
    form.FAtom(ast.CStr(s)) -> s
    _ -> ""
  }
}

fn loc_line(loc : form.Form) -> Int {
  match form.nth(form.items(loc), 2) {
    form.FAtom(ast.CInt(n)) -> n
    _ -> 0
  }
}

// row_file(row) — 行表是旁路状态 (k name file line)，按位置读。
fn row_file(row) { car(cdr(cdr(row))) }

// write_covmap(path, entries): one "k file:line name" row per id;
// line 0 marks a function entry.
//
// Rows are built first and joined once: accumulating rows with str.concat
// is quadratic in the row count, and the image being instrumented is the
// 292 KB bootstrap driver — tens of thousands of rows.
pub fn write_covmap(path, entries) {
  file.write(path, str.join(covmap_rows(entries, nil), ""))
}

fn covmap_rows(entries, acc) {
  if null?(entries) {
    rev(acc, nil)
  } else {
    let e = car(entries)
    let row = str.concat(str.from_int(car(e)),
    str.concat(" ", str.concat(entry_loc(e),
    str.concat(" ", str.concat(car(cdr(e)), "\n")))))
    covmap_rows(cdr(entries), cons(row, acc))
  }
}

fn entry_loc(e) {
  str.concat(car(cdr(cdr(e))),
  str.concat(":", str.from_int(car(cdr(cdr(cdr(e)))))))
}
