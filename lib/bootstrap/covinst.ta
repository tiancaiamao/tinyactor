// covinst.ta — coverage instrumentation (TA program coverage).
//
// Pipeline slot: after typecheck, before lower. The parser (--cov builds
// only) wraps every statement and match/receive arm body in a
// (begin (cov.line path line) form) marker. The marker is an ordinary
// cov.<fn> call, so resolve/typecheck accept it untouched; instrument()
// walks the post-resolve forms and rewrites each marker in place into
// (begin (cov.hit k) form), assigning sequential ids and recording
// (k name file line) rows for the covmap.
//
// Function entries keep a dedicated id (covmap line 0): the gate
// (COV_TA_MIN) measures function coverage. An entry row's file is
// derived from the body's first statement marker — defines carry no
// source path after resolve.
//
// The runtime sink is the C "cov" module (lib/cov.c): a counter array
// shared by all actors, dumped at process exit (TA_COV_DUMP_DIR) and
// joined with the covmap for the report. cov.line is deliberately NOT
// registered in the cov module, so a marker that survives
// instrumentation fails loudly at runtime instead of silently
// reporting nothing. inst_loop walks every top-level form (defines and
// const-bound lambdas alike) so that no body is skipped.
//
// The instrumenter module must not be named `cov`: resolve_loop treats
// `import <builtin-module>` as a no-op, so a colliding name silently
// returns nil from every instrument call (covinst vs the C module cov).
//
// Phase 2 (statement / match-arm rows, `k file:line name`) is done.
// Phase 3 (SBCL-style entered-but-not-taken third state) is planned, not
// implemented — see docs/coverage-design.md.

import str
import file

// instrument(forms) -> (instrumented_forms . entries)
// entries: ((k name file line) ...) in instrument order;
// line 0 = fn entry, line > 0 = statement / arm body.
pub fn instrument(forms) {
  inst_loop(forms, 0, nil, nil)
}

fn rev(xs, acc) {
  if null?(xs) { acc } else { rev(cdr(xs), cons(car(xs), acc)) }
}

fn inst_loop(forms, k, facc, eacc) {
  if null?(forms) {
    cons(rev(facc, nil), rev(eacc, nil))
  } else {
    let form = car(forms)
    if is_define(form) == 1 {
      let name = define_name(form)
      // The body is the whole cdr(cdr(form)) list (the parser emits exactly
      // one form there, but lower's lower_body treats it as a list — wrap
      // the list, so the entry counter precedes every body form).
      let instrumented = cons('begin,
      cons(cons('cov.hit, cons(k, nil)), cdr(cdr(form))))
      let rb = rw(instrumented, name, k + 1, nil)
      let new_form = cons(car(form),
      cons(car(cdr(form)), cons(car(rb), nil)))
      let rows = cdr(cdr(rb))
      let efile = if null?(rows) { "" } else { car(cdr(cdr(car(rows)))) }
      let entry = cons(k, cons(name, cons(efile, cons(0, nil))))
      let eacc2 = rev(cons(entry, rows), eacc)
      inst_loop(cdr(forms), car(cdr(rb)),
      cons(new_form, facc), eacc2)
    } else {
      // Non-define top-level forms can still carry markers (e.g. a lambda
      // bound by const); rewrite them so every emitted id lands in the
      // covmap, attributing rows to the const name when present.
      let name = if car(form) == 'const { car(cdr(form)) } else { "" }
      let rb = rw(form, name, k, nil)
      let eacc2 = rev(cdr(cdr(rb)), eacc)
      inst_loop(cdr(forms), car(cdr(rb)), cons(car(rb), facc), eacc2)
    }
  }
}

// rw(e, fname, k, acc) -> (new_e . (next_k . entries_rev)).
// Generic rewrite: recurse into every subform; a marker
// (begin (cov.line f l) s) becomes (begin (cov.hit k) s) and records
// (k fname f l). Everything else is rebuilt unchanged — match arm
// triples and pattern data cannot contain a marker, and the marker
// shape (begin with a cov.line call as its sole first element) does not
// occur in user code.
fn rw(e, fname, k, acc) {
  if pair?(e) {
    if is_marker(e) == 1 {
      let loc = car(cdr(e))
      let hit = cons('cov.hit, cons(k, nil))
      // the marker consumes id k; nested markers start allocating at k + 1
      let rs = rw(car(cdr(cdr(e))), fname, k + 1, acc)
      let inner = cons('begin, cons(hit, cons(car(rs), nil)))
      let row = cons(k, cons(fname,
      cons(car(cdr(loc)), cons(car(cdr(cdr(loc))), nil))))
      let acc2 = cons(row, cdr(cdr(rs)))
      cons(inner, cons(car(cdr(rs)), acc2))
    } else {
      rw_list(e, fname, k, acc)
    }
  } else {
    cons(e, cons(k, acc))
  }
}

fn rw_list(xs, fname, k, acc) {
  if null?(xs) {
    cons(nil, cons(k, acc))
  } else {
    let h = rw(car(xs), fname, k, acc)
    let t = rw_list(cdr(xs), fname, car(cdr(h)), cdr(cdr(h)))
    // t = (new_tail . (k . acc)) — keep only the tail list, not the
    // (k . acc) spine (consing t itself would splice k/acc into the AST).
    cons(cons(car(h), car(t)), cdr(t))
  }
}

// is_marker(e): (begin (cov.line path line) form)
fn is_marker(e) {
  if pair?(e) {
    if car(e) == 'begin {
      let second = car(cdr(e))
      if pair?(second) {
        if car(second) == 'cov.line { 1 } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

// is_define(form): top-level fn definitions are (define (name . params)
// body) / (define_pub ...). Everything else (type, const, import,
// external fn, type-sig) carries no callable body and is left untouched.
fn is_define(form) {
  let head = car(form)
  if head == 'define { 1 } else if head == 'define_pub { 1 } else { 0 }
}

// define_name(form): (define (name . params) ...) -> name; the parser
// always emits the pair shape, the bare (define name ...) form is
// accepted for symmetry with lower's lower_define.
fn define_name(form) {
  let sig = car(cdr(form))
  if pair?(sig) { car(sig) } else { sig }
}

// write_covmap(path, entries): one "k file:line name" row per id;
// line 0 marks a function entry.
//
// Rows are built first and joined once: accumulating rows with str.concat
// is quadratic in the row count, and the image being instrumented is the
// 292 KB bootstrap driver — tens of thousands of rows.
pub fn write_covmap(path, entries) {
  file.write(path, str.join(covmap_rows(entries, nil), ""))
}

fn covmap_rows(entries, acc) {
  if null?(entries) {
    rev(acc, nil)
  } else {
    let e = car(entries)
    let row = str.concat(str.from_int(car(e)),
    str.concat(" ", str.concat(entry_loc(e),
    str.concat(" ", str.concat(entry_name(e), "\n")))))
    covmap_rows(cdr(entries), cons(row, acc))
  }
}

fn entry_loc(e) {
  str.concat(car(cdr(cdr(e))),
  str.concat(":", str.from_int(car(cdr(cdr(cdr(e)))))))
}

// entry_name: rows rewritten outside a define carry the const name, or ""
// when no name is in scope — str.sym_to_str is strict (issue #101), so
// only symbols are converted.
fn entry_name(e) {
  let n = car(cdr(e))
  if symbol?(n) { str.sym_to_str(n) } else { n }
}
