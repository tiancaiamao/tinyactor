(if
(if
                    (pair? _m)
(if
                      (eq? (car _m) 'Out)
(if
                        (pair? (cdr _m))
(if
                          true
(if
                            (pair? (cdr (cdr _m)))
                            (if true (eq? (cdr (cdr (cdr _m))) nil)))))))
(let
                    (consts (car (cdr (cdr _m))))
(let
                      (fns (car (cdr _m)))
                      (bytecode~1530480983.write_bc out fns consts)))
                  nil))))
          nil)))))

(begin (main) nil)
