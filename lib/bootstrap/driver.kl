                          rest
                          (cdr poss)
                          src
                          (+ n 1)
                          (- paren 1)
                          brack
                          brace)
                        (err_at src poss 0 "unbalanced ')'" "')'"))
(if
                        (= typ 'lbracket)
(scan_tokens
                          rest
                          (cdr poss)
                          src
                          (+ n 1)
                          paren
                          (+ brack 1)
                          brace)
(if
                          (= typ 'rbracket)
(if
                            (> brack 0)
(scan_tokens
                              rest
                              (cdr poss)
                              src
                              (+ n 1)
                              paren
                              (- brack 1)
                              brace)
                            (err_at src poss 0 "unbalanced ']'" "']'"))
(if
                            (= typ 'lbrace)
(scan_tokens
                              rest
                              (cdr poss)
                              src
                              (+ n 1)
                              paren
                              brack
                              (+ brace 1))
(if
                              (= typ 'rbrace)
(if
                                (> brace 0)
(scan_tokens
                                  rest
                                  (cdr poss)
                                  src
                                  (+ n 1)
                                  paren
                                  brack
                                  (- brace 1))
                                (err_at src poss 0 "unbalanced '}'" "'}'"))
(scan_tokens
                                rest
                                (cdr poss)
                                src
                                (+ n 1)
                                paren
                                brack
                                brace))))))))))))))))

(def
  resolve_imports
(lambda
    (forms dir use_ta with_cov)
(let
      (ar (rewrite_unit_aliases forms dir))
(let
        (aerr (cdr ar))
(if
          (null? aerr)
(let
            (r (resolve_loop (car ar) dir nil nil nil use_ta with_cov))
(let
              (err (cdr (cdr r)))
(if
                (null? err)
(let
                  (seq (reverse (car r)))
                  (cons (seq_forms seq nil) (cons seq nil)))
                (cons nil (cons nil err)))))
          (cons nil (cons nil aerr)))))))

(def
  seq_forms
(lambda
    (seq acc)
(if
      (null? seq)
      (reverse acc)
(let
        (e (car seq))
(if
          (= (car e) 'U)
          (seq_forms (cdr seq) (rev_app (cdr (cdr (cdr e))) acc))
          (seq_forms (cdr seq) (cons (cdr e) acc)))))))

(def
  resolve_loop
(lambda
    (forms dir stack visited seq use_ta with_cov)
(if
      (null? forms)
      (cons seq (cons visited nil))
(let
        (f (car forms))
(let
          (rest (cdr forms))
(if
            (pair? f)
(if
