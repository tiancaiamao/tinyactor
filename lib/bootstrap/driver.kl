(def
  typecheck~2120406276$max_int_in
(lambda
    (v acc)
(if
      (int? v)
      (if (> v acc) v acc)
(if
        (pair? v)
(let
          (a (typecheck~2120406276$max_int_in (car v) acc))
          (typecheck~2120406276$max_int_in (cdr v) a))
        acc))))

(def
  typecheck~2120406276$max_seed_int
(lambda
    (seed acc)
(if
      (null? seed)
      acc
(typecheck~2120406276$max_seed_int
        (cdr seed)
(typecheck~2120406276$max_int_in
          (cdr (car seed))
          (typecheck~2120406276$max_int_in (car (car seed)) acc))))))

(def
  typecheck~2120406276.infer_program_seeded
(lambda
    (forms seed_env)
(let
      (counter (+ (typecheck~2120406276$max_seed_int seed_env -1) 1))
(let
        (s (typecheck~2120406276$make_buckets 32))
(let
          (be (typecheck~2120406276$make_builtin_env counter))
(let
            (env0 (typecheck~2120406276$append seed_env (car be)))
(let
              (c0 (cdr be))
(let
                (ctd (typecheck~2120406276$collect_type_decls forms env0 c0))
(let
                  (env_types (car ctd))
(let
                    (c_types (cdr ctd))
(let
(cts
(typecheck~2120406276$collect_type_sigs
                          forms
                          nil
                          c_types))
(let
                        (sigs (car cts))
(let
                          (c_sigs (cdr cts))
(let
(env_sigs
(typecheck~2120406276$extend_env_from_sigs
                                env_types
                                sigs))
(let
(cd
(typecheck~2120406276$collect_defines
                                  forms
                                  env_sigs
                                  s
                                  c_sigs
                                  sigs
                                  nil))
(let
                                (env1 (car cd))
(let
                                  (sc1 (cdr cd))
(let
                                    (s1 (car sc1))
(let
                                      (c1 (cdr sc1))
(typecheck~2120406276$infer_defines
                                        forms
                                        env1
                                        s1
                                        c1
                                        0))))))))))))))))))))

(def
  typecheck~2120406276.infer_program
  (lambda (forms) (typecheck~2120406276.infer_program_seeded forms nil)))

(def
  typecheck~2120406276$fmt_type_name
(lambda
    (name)
(if
      (symbol? name)
      (str.sym_to_str name)
(if
        (null? name)
        "<?type>"
(if
          (int? name)
          (str.concat "<?type " (str.concat (str.from_int name) ">"))
          "<?type>")))))

(def
  typecheck~2120406276.type_format
(lambda
    (t s)
(let
      (resolved (typecheck~2120406276$apply_subst t s))
      (typecheck~2120406276$type_format_resolved resolved nil))))

(def
  typecheck~2120406276$type_format_resolved
(lambda
    (t assigned)
(let
      (tag (car t))
(if
        (= tag 'base)
(let
          (name (car (cdr t)))
(if
            (= name 'int)
            "int"
(if
              (= name 'string)
              "string"
(if
                (= name 'bool)
                "bool"
(if
                  (= name 'symbol)
                  "symbol"
(if
                    (= name 'pid)
                    "pid"
                    (typecheck~2120406276$fmt_type_name name)))))))
(if
          (= tag 'tvar)
(let
            (vid (car (cdr t)))
(let
              (found (typecheck~2120406276$assq vid assigned))
(if
                (null? found)
(let
                  (n (typecheck~2120406276$list_length assigned))
                  (let (letter (typecheck~2120406276$tvar_letter n)) letter))
                (cdr found))))
(if
            (= tag 'arrow)
(let
              (from (car (cdr t)))
(let
                (to (car (cdr (cdr t))))
(let
(from_assigned
                    (typecheck~2120406276$collect_tvars from assigned))
(let
(from_str
(typecheck~2120406276$type_format_resolved
                        from
                        assigned))
(let
(to_str
(typecheck~2120406276$type_format_resolved
                          to
                          from_assigned))
(let
                        (from_tag (car from))
(let
(from_wrapped
(if
                              (= from_tag 'arrow)
                              (str.concat "(" (str.concat from_str ")"))
                              from_str))
                          (str.concat from_wrapped (str.concat " -> " to_str)))))))))
(if
              (= tag 'app)
(let
                (name (car (cdr t)))
(let
                  (args (cdr (cdr t)))
(let
                    (name_str (typecheck~2120406276$fmt_type_name name))
(if
                      (null? args)
                      name_str
(let
(args_str
(typecheck~2120406276$format_type_list
                            args
                            assigned))
(str.concat
                          name_str
                          (str.concat "(" (str.concat args_str ")"))))))))
(if
                (= tag 'forall)
(let
                  (body (car (cdr (cdr t))))
                  (typecheck~2120406276$type_format_resolved body assigned))
                "?"))))))))

(def
  typecheck~2120406276$format_type_list
(lambda
    (ts assigned)
(let
      (_m ts)
(if
        (eq? _m nil)
        ""
(if
          (if (pair? _m) (if true (eq? (cdr _m) nil)))
(let
            (h (car _m))
            (typecheck~2120406276$type_format_resolved h assigned))
(if
            (if (pair? _m) (if true true))
(let
              (rest (cdr _m))
(let
                (h (car _m))
(let
                  (h_assigned (typecheck~2120406276$collect_tvars h assigned))
(str.concat
                    (typecheck~2120406276$type_format_resolved h assigned)
(str.concat
                      ", "
                      (typecheck~2120406276$format_type_list rest h_assigned))))))
            nil))))))

(def
  typecheck~2120406276$collect_tvars
(lambda
    (t assigned)
(let
      (tag (car t))
(if
        (= tag 'tvar)
(let
          (vid (car (cdr t)))
(let
            (found (typecheck~2120406276$assq vid assigned))
(if
              (null? found)
(let
                (n (typecheck~2120406276$list_length assigned))
(let
                  (letter (typecheck~2120406276$tvar_letter n))
                  (cons (cons vid letter) assigned)))
              assigned)))
(if
          (= tag 'arrow)
(let
            (a1 (typecheck~2120406276$collect_tvars (car (cdr t)) assigned))
            (typecheck~2120406276$collect_tvars (car (cdr (cdr t))) a1))
(if
            (= tag 'app)
            (typecheck~2120406276$collect_tvars_list (cdr (cdr t)) assigned)
            assigned))))))

(def
  typecheck~2120406276$collect_tvars_list
(lambda
    (ts assigned)
(let
      (_m ts)
(if
        (eq? _m nil)
        assigned
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (h (car _m))
(typecheck~2120406276$collect_tvars_list
                rest
                (typecheck~2120406276$collect_tvars h assigned))))
          nil)))))

(def
  typecheck~2120406276$list_length
(lambda
    (lst)
    (if (null? lst) 0 (+ 1 (typecheck~2120406276$list_length (cdr lst))))))

(def
  typecheck~2120406276$collect_errors
  (lambda (s) (typecheck~2120406276$collect_bucket_errors s 0)))

(def
  typecheck~2120406276$collect_bucket_errors
(lambda
    (s i)
(if
      (= i 32)
      nil
(typecheck~2120406276$append
        (typecheck~2120406276$collect_errors_in_bucket (car s))
        (typecheck~2120406276$collect_bucket_errors (cdr s) (+ i 1))))))

(def
  typecheck~2120406276$collect_errors_in_bucket
(lambda
    (bucket)
(let
      (_m bucket)
(if
        (eq? _m nil)
        nil
(if
          (if (pair? _m) (if true true))
(let
