(typecheck~2120406276$t_forall
                                            scheme_ids
                                            arrow_t)))
(let
(env2
(typecheck~2120406276$extend
                                            env
                                            ctor_name
                                            (cons 'ctor scheme)))
(                                          typecheck~2120406276$collect_variants_loop
                                          rest
                                          type_name
