                (= (car pair) 'tc_error)
(cons
                  pair
                  (typecheck~2120406276$collect_errors_in_bucket rest))
(if
                  (= (car pair) 'tc_dupglobal)
(cons
                    pair
                    (typecheck~2120406276$collect_errors_in_bucket rest))
(if
                    (= (car pair) 'tc_undefined)
(cons
                      pair
                      (typecheck~2120406276$collect_errors_in_bucket rest))
(if
                      (= (car pair) 'tc_arity)
(cons
                        pair
                        (typecheck~2120406276$collect_errors_in_bucket rest))
(if
                        (= (car pair) 'tc_not_exported)
(cons
                          pair
                          (typecheck~2120406276$collect_errors_in_bucket rest))
(if
                          (= (car pair) 'tc_no_export)
(cons
                            pair
(typecheck~2120406276$collect_errors_in_bucket
                              rest))
(if
                            (= (car pair) 'tc_nonexh)
(cons
                              pair
(typecheck~2120406276$collect_errors_in_bucket
                                rest))
(typecheck~2120406276$collect_errors_in_bucket
                              rest))))))))))
          nil)))))

