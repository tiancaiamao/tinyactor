(let
                (mod_name (car (cdr f)))
(if
                  (is_builtin_import mod_name)
(let
(r
(resolve_loop
                        rest
                        dir
                        stack
                        visited
                        (cons (cons 'F f) seq)
                        use_ta
                        with_cov))
                    (cons (car r) (cons (car (cdr r)) (cdr (cdr r)))))
(let
(ur
                      (ensure_unit mod_name dir stack visited use_ta with_cov))
(let
                      (uerr (cdr (cdr (cdr ur))))
(if
                        (null? uerr)
(let
                          (entry (car ur))
(let
(seq2
(if
                                (null? entry)
                                (cons (cons 'F f) seq)
(cons
                                  (cons 'F f)
(cons
                                    (cons 'U entry)
                                    (rev_app (car (cdr ur)) seq)))))
(let
(r
(resolve_loop
                                  rest
                                  dir
                                  stack
                                  (car (cdr (cdr ur)))
                                  seq2
                                  use_ta
                                  with_cov))
(cons
                                (car r)
                                (cons (car (cdr r)) (cdr (cdr r)))))))
                        (cons nil (cons (car (cdr (cdr ur))) uerr)))))))
(let
(r
(resolve_loop
                    rest
                    dir
                    stack
                    visited
                    (cons (cons 'F f) seq)
                    use_ta
                    with_cov))
                (cons (car r) (cons (car (cdr r)) (cdr (cdr r))))))
(let
(r
(resolve_loop
                  rest
                  dir
                  stack
                  visited
                  (cons (cons 'F f) seq)
                  use_ta
                  with_cov))
              (cons (car r) (cons (car (cdr r)) (cdr (cdr r)))))))))))

(def
  ensure_unit
(lambda
    (name dir stack visited use_ta with_cov)
(let
      (found (find_module_path name dir))
(let
        (ferr (cdr (cdr found)))
(if
          (= (null? ferr) false)
          (cons nil (cons nil (cons visited ferr)))
(let
            (path (car found))
(if
              (null? path)
(let
(shown
(if
                    (>= (str.index_of name ":") 0)
                    name
                    (str.concat name ".ta")))
(cons
                  nil
(cons
                    nil
(cons
                      visited
                      (str.concat "error: module not found: " shown)))))
(if
                (= (stack_has_path path stack) 1)
(cons
                  nil
(cons
                    nil
(cons
                      visited
(str.concat
                        "error: circular import: "
                        (cycle_chain stack name)))))
(if
                  (= (loaded_has_path path visited) 1)
                  (cons nil (cons nil (cons visited nil)))
(let
(pr
(parse_module_content
                        (car (cdr found))
                        path
                        use_ta
                        with_cov))
(let
                      (err (cdr pr))
(if
                        (= (null? err) false)
                        (cons nil (cons nil (cons visited err)))
(let
                          (forms (car pr))
(let
                            (ar (rewrite_unit_aliases forms dir))
(let
                              (aerr (cdr ar))
(if
                                (= (null? aerr) false)
(cons
                                  nil
(cons
                                    nil
(cons
                                      visited
                                      (str.concat path (str.concat ": " aerr)))))
(let
                                  (uforms (car ar))
(let
                                    (defs (scan_unit_defs uforms nil nil nil))
(let
                                      (pubs (car defs))
(let
                                        (privs (car (cdr defs)))
(let
                                          (consts (cdr (cdr defs)))
(let
                                            (canon (canon_of_path path name))
(let
(named
(qualify_unit_forms
                                                  uforms
                                                  (qual_prefix canon)
                                                  pubs
                                                  privs
                                                  consts))
(let
(rr
(unit_seq_loop
                                                    named
                                                    (dirname path)
(cons
                                                      (cons path name)
                                                      stack)
                                                    visited
                                                    nil
                                                    use_ta
                                                    with_cov))
(let
                                                  (rerr (cdr (cdr rr)))
(if
                                                    (null? rerr)
(let
(entry
(cons
                                                          canon
(cons
                                                            (car (cdr found))
                                                            named)))
(let
(visited2
(cons
                                                            (cons path canon)
                                                            (car (cdr rr))))
(cons
                                                          entry
(cons
                                                            (car rr)
(cons
                                                              visited2
                                                              nil)))))
(cons
                                                      nil
(cons
                                                        nil
(cons
                                                          (car (cdr rr))
                                                          rerr)))))))))))))))))))))))))))))

(def
  unit_seq_loop
(lambda
    (forms dir stack visited acc use_ta with_cov)
(if
      (null? forms)
      (cons acc (cons visited nil))
(let
        (f (car forms))
(if
          (pair? f)
(if
            (= (car f) 'import)
(let
              (mod_name (car (cdr f)))
(if
                (is_builtin_import mod_name)
(unit_seq_loop
                  (cdr forms)
                  dir
                  stack
                  visited
                  acc
                  use_ta
                  with_cov)
(let
(ur
                    (ensure_unit mod_name dir stack visited use_ta with_cov))
(let
                    (uerr (cdr (cdr (cdr ur))))
(if
                      (= (null? uerr) false)
                      (cons nil (cons (car (cdr (cdr ur))) uerr))
(let
                        (entry (car ur))
(let
(acc2
(if
                              (null? entry)
                              acc
(list_append
                                (list_append acc (car (cdr ur)))
                                (cons (cons 'U entry) nil))))
(unit_seq_loop
                            (cdr forms)
                            dir
                            stack
                            (car (cdr (cdr ur)))
                            acc2
                            use_ta
                            with_cov))))))))
            (unit_seq_loop (cdr forms) dir stack visited acc use_ta with_cov))
          (unit_seq_loop (cdr forms) dir stack visited acc use_ta with_cov))))))

(def is_builtin_import (lambda (name) (vm.is_builtin_module name)))

(def
  name_unwritable
(lambda
    (name)
(if
      (>= (str.index_of name ":") 0)
      1
(if
        (>= (str.index_of name "/") 0)
        1
        (if (>= (str.index_of name ".") 0) 1 0)))))

(def
  last_segment
(lambda
    (name)
(let
      (idx (find_last_slash name (- (str.length name) 1)))
(if
        (< idx 0)
        name
        (str.substr name (+ idx 1) (- (- (str.length name) idx) 1))))))

(def
  qual_prefix
(lambda
    (name)
(if
      (= (name_unwritable name) 0)
      name
(let
        (seg (last_segment name))
(let
          (head (if (> (str.length seg) 24) (str.substr seg 0 24) seg))
(str.concat
            head
            (str.concat "~" (str.from_int (modsig~1748518853.str_hash name)))))))))

(def
  seg_ok
(lambda
    (s a b)
(if
(let
        (_m (= (- b a) 2))
(if
          _m
(let
            (_m (= (str.char_at s a) 46))
            (if _m (= (str.char_at s (+ a 1)) 46) _m))
          _m))
      0
      1)))

(def
  check_segments
(lambda
    (s i n seg_start)
(if
      (= i n)
      (if (= i seg_start) 0 (seg_ok s seg_start i))
(if
        (= (str.char_at s i) 47)
(if
          (= i seg_start)
          0
(if
            (= (seg_ok s seg_start i) 1)
            (check_segments s (+ i 1) n (+ i 1))
            0))
        (check_segments s (+ i 1) n seg_start)))))

(def first_seg_has_dot (lambda (s) (fshd_loop s 0 (str.length s) 0)))

(def
  fshd_loop
(lambda
    (s i n seen_dot)
(if
      (= i n)
      seen_dot
(if
        (= (str.char_at s i) 47)
        seen_dot
        (fshd_loop s (+ i 1) n (if (= (str.char_at s i) 46) 1 seen_dot))))))

(def
  check_import_name
(lambda
    (name)
(let
      (n (str.length name))
(if
        (= n 0)
        0
(let
          (ci (str.index_of name ":"))
(if
            (< ci 0)
            (check_segments name 0 n 0)
(let
              (ident (str.substr name 0 ci))
(let
                (path (str.substr name (+ ci 1) (- (- n ci) 1)))
(if
(let
                    (_m (= (str.length ident) 0))
                    (if _m _m (= (str.length path) 0)))
                  0
(if
                    (>= (str.index_of path ":") 0)
                    0
(if
                      (= (first_seg_has_dot ident) 0)
                      0
(if
                        (= (check_segments ident 0 (str.length ident) 0) 1)
                        (check_segments path 0 (str.length path) 0)
                        0))))))))))))

(def
  find_module_path
(lambda
    (name dir)
(if
      (= (check_import_name name) 0)
      (cons nil (cons nil (str.concat "error: invalid module name: " name)))
(if
        (>= (str.index_of name ":") 0)
        (vendor_identity_path name)
(let
          (mod_path (path_join dir name))
(let
            (content (file.read mod_path))
(if
              (null? content)
(let
(helpers_path
                  (path_join (str.concat (str.concat dir "/") "helpers") name))
(let
                  (content_h (file.read helpers_path))
(if
                    (null? content_h)
                    (vendor_stdlib_path name)
                    (cons helpers_path (cons content_h nil)))))
              (cons mod_path (cons content nil)))))))))

(def
  vendor_identity_path
(lambda
    (name)
(let
      (ci (str.index_of name ":"))
(let
(vp
(str.concat
            "vendor/"
(str.concat
              (str.substr name 0 ci)
(str.concat
                "/"
(str.concat
                  (str.substr name (+ ci 1) (- (- (str.length name) ci) 1))
                  ".ta")))))
(let
          (content (file.read vp))
(if
            (null? content)
            (cons nil (cons nil nil))
            (cons vp (cons content nil))))))))

(def
  vendor_stdlib_path
(lambda
    (bare)
(let
(lib_path
(str.concat
          "vendor/"
(str.concat
            "github.com/tiancaiamao/tinyactor"
            (str.concat "/lib/" (str.concat bare ".ta")))))
(let
        (content (file.read lib_path))
(if
          (null? content)
(let
(bs_path
(str.concat
                "vendor/"
(str.concat
                  "github.com/tiancaiamao/tinyactor"
                  (str.concat "/lib/bootstrap/" (str.concat bare ".ta")))))
(let
              (content2 (file.read bs_path))
(if
                (null? content2)
                (cons nil (cons nil nil))
                (cons bs_path (cons content2 nil)))))
          (cons lib_path (cons content nil)))))))

(def
  canon_of_path
(lambda
    (path name)
(let
(libpfx
(str.concat
          "vendor/"
          (str.concat "github.com/tiancaiamao/tinyactor" "/lib/")))
(if
        (= (str.index_of path libpfx) 0)
(let
(rest
(str.substr
              path
              (str.length libpfx)
              (- (str.length path) (str.length libpfx))))
          (str.substr rest 0 (- (str.length rest) 3)))
        name))))

(def
  canon_of_import
(lambda
    (name dir)
(let
      (path (car (find_module_path name dir)))
      (if (null? path) name (canon_of_path path name)))))

(def
  stack_has_path
(lambda
    (path stack)
(if
      (null? stack)
      0
      (if (= (car (car stack)) path) 1 (stack_has_path path (cdr stack))))))

(def
  loaded_has_path
(lambda
    (path visited)
(if
      (null? visited)
      0
      (if (= (car (car visited)) path) 1 (loaded_has_path path (cdr visited))))))

(def
  cycle_chain
(lambda
    (stack name)
    (chain_join (list_append (stack_names stack nil) (cons name nil)))))

(def
  stack_names
(lambda
    (stack acc)
(if
      (null? stack)
      acc
      (stack_names (cdr stack) (cons (cdr (car stack)) acc)))))

(def
  chain_join
(lambda
    (names)
(if
      (null? names)
      ""
(if
        (null? (cdr names))
        (car names)
        (str.concat (car names) (str.concat " -> " (chain_join (cdr names))))))))

(def
  collect_aliases
(lambda
    (forms acc dir)
(if
      (null? forms)
      acc
(let
        (f (car forms))
(if
          (pair? f)
(if
            (= (car f) 'import)
(let
              (name (car (cdr f)))
(let
                (alias (car (cdr (cdr f))))
(if
                  (null? alias)
                  (collect_aliases (cdr forms) acc dir)
(let
                    (canon (canon_of_import name dir))
(let
                      (target (qual_prefix canon))
(if
                        (= alias name)
(if
                          (= (name_unwritable name) 1)
(collect_aliases
                            (cdr forms)
(cons
(cons
                                (str.to_sym (last_segment name))
                                (str.to_sym target))
                              acc)
                            dir)
(if
                            (= canon name)
                            (collect_aliases (cdr forms) acc dir)
(collect_aliases
                              (cdr forms)
(cons
                                (cons (str.to_sym name) (str.to_sym target))
                                acc)
                              dir)))
(collect_aliases
                          (cdr forms)
(cons
                            (cons (str.to_sym alias) (str.to_sym target))
                            acc)
                          dir)))))))
            (collect_aliases (cdr forms) acc dir))
          (collect_aliases (cdr forms) acc dir))))))

(def
  rewrite_unit_aliases
(lambda
    (forms dir)
(let
      (aliases (collect_aliases forms nil dir))
      (if (null? aliases) (cons forms nil) (alias_walk forms aliases)))))

(def
  alias_walk
(lambda
    (e aliases)
(if
      (pair? e)
(if
        (= (car e) 'import)
        (cons e nil)
(let
          (r1 (alias_walk (car e) aliases))
(if
            (= (null? (cdr r1)) false)
            (cons nil (cdr r1))
(let
              (r2 (alias_walk (cdr e) aliases))
(if
                (= (null? (cdr r2)) false)
                (cons nil (cdr r2))
                (cons (cons (car r1) (car r2)) nil))))))
      (if (symbol? e) (alias_rewrite_sym e aliases) (cons e nil)))))

(def
  alias_rewrite_sym
(lambda
    (s aliases)
(let
      (s_str (str.sym_to_str s))
(let
        (dot (str.index_of s_str "."))
(if
          (<= dot 0)
          (cons s nil)
(let
            (pfx (str.substr s_str 0 dot))
(let
              (hit (alist_assoc (str.to_sym pfx) aliases))
(if
                (= (null? hit) false)
(let
                  (rest (str.substr s_str dot (- (str.length s_str) dot)))
(cons
                    (str.to_sym (str.concat (str.sym_to_str (cdr hit)) rest))
                    nil))
(if
                  (= (aliased_real_pfx pfx aliases) 1)
(cons
                    nil
(str.concat
                      "error: module '"
(str.concat
                        pfx
(str.concat
                          "' is imported under an alias in this file; the real name is not usable here ('"
                          (str.concat s_str "')")))))
                  (cons s nil))))))))))

(def
  aliased_real_pfx
(lambda
    (pfx aliases)
(if
      (null? aliases)
      0
(if
        (= (str.sym_to_str (cdr (car aliases))) pfx)
        1
        (aliased_real_pfx pfx (cdr aliases))))))

(def
  alist_assoc
(lambda
    (key lst)
(if
      (null? lst)
      nil
      (if (= (car (car lst)) key) (car lst) (alist_assoc key (cdr lst))))))

(def
  scan_unit_defs
(lambda
    (forms pubs privs consts)
(if
      (null? forms)
      (cons pubs (cons privs consts))
(let
        (f (car forms))
(if
          (pair? f)
(let
            (head (car f))
(if
              (= head 'define_pub)
(let
                (name (car (car (cdr f))))
                (scan_unit_defs (cdr forms) (cons name pubs) privs consts))
(if
                (= head 'define)
(let
                  (name (car (car (cdr f))))
                  (scan_unit_defs (cdr forms) pubs (cons name privs) consts))
(if
                  (= head 'const)
(let
                    (name (car (cdr f)))
                    (scan_unit_defs (cdr forms) pubs privs (cons name consts)))
                  (scan_unit_defs (cdr forms) pubs privs consts)))))
          (scan_unit_defs (cdr forms) pubs privs consts))))))

(def
  qualify_unit_forms
(lambda
    (forms mod pubs privs consts)
(if
      (null? forms)
      nil
(cons
        (qualify_unit_form (car forms) mod pubs privs consts)
        (qualify_unit_forms (cdr forms) mod pubs privs consts)))))

(def
  qualify_unit_form
(lambda
    (f mod pubs privs consts)
(if
      (= (pair? f) false)
      f
(let
        (head (car f))
(if
          (= head 'define)
(let
            (sig (car (cdr f)))
(let
              (params (cdr sig))
(let
                (body (car (cdr (cdr f))))
(let
                  (newname (rename_member_name (car sig) mod privs))
(let
                    (newbody (qualify_expr body mod pubs privs consts params))
(cons
                      'define
                      (cons (cons newname params) (cons newbody nil))))))))
(if
            (= head 'define_pub)
(let
              (sig (car (cdr f)))
(let
                (params (cdr sig))
(let
                  (body (car (cdr (cdr f))))
(let
(newname
(str.to_sym
(str.concat
                          mod
                          (str.concat "." (str.sym_to_str (car sig))))))
(let
(newbody
                        (qualify_expr body mod pubs privs consts params))
(cons
                        'define_pub
                        (cons (cons newname params) (cons newbody nil))))))))
(if
              (= head 'const)
(let
                (name (car (cdr f)))
(let
                  (val (car (cdr (cdr f))))
(let
(newname
(str.to_sym
(str.concat
                          mod
                          (str.concat "." (str.sym_to_str name)))))
(cons
                      'const
(cons
                        newname
(cons
                          (qualify_expr val mod pubs privs consts nil)
                          nil))))))
(if
                (= head 'type-sig)
(let
                  (newname (rename_member_name (car (cdr f)) mod privs))
                  (cons 'type-sig (cons newname (cdr (cdr f)))))
                f))))))))

(def
  rename_member_name
(lambda
    (name mod privs)
(if
      (= (sym_in name privs) 1)
      (str.to_sym (str.concat mod (str.concat "$" (str.sym_to_str name))))
      (str.to_sym (str.concat mod (str.concat "." (str.sym_to_str name)))))))

(def
  qualify_expr
(lambda
    (e mod pubs privs consts bound)
(if
      (pair? e)
(let
        (head (car e))
(if
          (= head 'quote)
(let
            (inner (car (cdr e)))
(if
              (symbol? inner)
(if
                (= (sym_in inner consts) 1)
(cons
                  'quote
(cons
(str.to_sym
                      (str.concat mod (str.concat "." (str.sym_to_str inner))))
                    nil))
                e)
              e))
(if
            (= head 'lambda)
(let
              (params (car (cdr e)))
(let
                (body (car (cdr (cdr e))))
(let
                  (ret_type (car (cdr (cdr (cdr e)))))
(cons
                    'lambda
(cons
                      params
(cons
(qualify_expr
                          body
                          mod
                          pubs
                          privs
                          consts
                          (syms_append params bound))
                        (cons ret_type nil)))))))
(if
              (= head 'let)
(let
                (b (car (cdr e)))
(if
                  (symbol? b)
(let
                    (init (car (cdr (cdr e))))
(let
                      (rest (car (cdr (cdr (cdr e)))))
(cons
                        'let
(cons
                          b
(cons
                            (qualify_expr init mod pubs privs consts bound)
(cons
(qualify_expr
                                rest
                                mod
                                pubs
                                privs
                                consts
                                (cons b bound))
                              nil))))))
(if
                    (null? b)
                    e
(let
                      (br (qualify_bindings b mod pubs privs consts bound))
(cons
                        'let
(cons
                          (car br)
(qualify_expr
                            (cdr (cdr e))
                            mod
                            pubs
                            privs
                            consts
                            (cdr br))))))))
(if
                (= head 'match)
(let
                  (scrut (car (cdr e)))
(cons
                    'match
(cons
                      (qualify_expr scrut mod pubs privs consts bound)
                      (qualify_arms (cdr (cdr e)) mod pubs privs consts bound))))
(if
                  (= head 'receive)
(cons
                    'receive
                    (qualify_arms (cdr e) mod pubs privs consts bound))
(cons
                    (qualify_expr (car e) mod pubs privs consts bound)
                    (qualify_expr (cdr e) mod pubs privs consts bound))))))))
(if
        (symbol? e)
(if
          (= (sym_in e bound) 1)
          e
(let
            (s_str (str.sym_to_str e))
(if
              (>= (str.index_of s_str ".") 0)
              e
(if
                (= (sym_in e privs) 1)
                (str.to_sym (str.concat mod (str.concat "$" s_str)))
(if
                  (= (sym_in e pubs) 1)
                  (str.to_sym (str.concat mod (str.concat "." s_str)))
(if
                    (= (sym_in e consts) 1)
                    (str.to_sym (str.concat mod (str.concat "." s_str)))
                    e))))))
        e))))

(def
  qualify_bindings
(lambda
    (bs mod pubs privs consts bound)
(if
      (null? bs)
      (cons nil bound)
(let
        (b (car bs))
(let
          (v (car b))
(let
            (init (car (cdr b)))
(let
              (new_init (qualify_expr init mod pubs privs consts bound))
(let
(rest
(qualify_bindings
                    (cdr bs)
                    mod
                    pubs
                    privs
                    consts
                    (cons v bound)))
                (cons (cons (cons v new_init) (car rest)) (cdr rest))))))))))

(def
  qualify_arms
(lambda
    (arms mod pubs privs consts bound)
(if
      (null? arms)
      nil
(let
        (arm (car arms))
(let
          (pat (car arm))
(let
            (nb (syms_append (pat_binders pat nil) bound))
(let
(new_arm
(if
                  (null? (cdr (cdr arm)))
(cons
                    pat
(cons
                      (qualify_expr (car (cdr arm)) mod pubs privs consts nb)
                      nil))
(cons
                    pat
(cons
                      (qualify_expr (car (cdr arm)) mod pubs privs consts nb)
(cons
(qualify_expr
                          (car (cdr (cdr arm)))
                          mod
                          pubs
                          privs
                          consts
                          nb)
                        nil)))))
(cons
                new_arm
                (qualify_arms (cdr arms) mod pubs privs consts bound)))))))))

(def
  pat_binders
(lambda
    (pat acc)
(if
      (symbol? pat)
      (cons pat acc)
(if
        (pair? pat)
(if
          (= (car pat) 'quote)
          acc
          (pat_binders (car pat) (pat_binders (cdr pat) acc)))
        acc))))

(def
  sym_in
(lambda
    (x lst)
    (if (null? lst) 0 (if (= (car lst) x) 1 (sym_in x (cdr lst))))))

(def
  syms_append
(lambda
    (xs ys)
    (if (null? xs) ys (cons (car xs) (syms_append (cdr xs) ys)))))

(def
  list_append
  (lambda (a b) (if (null? a) b (cons (car a) (list_append (cdr a) b)))))

(def
  prepend_rev
(lambda
    (lst acc)
    (if (null? lst) acc (prepend_rev (cdr lst) (cons (car lst) acc)))))

(def
  typecheck_report
(lambda
    (tc src)
(let
      (errors (typecheck~2120406276.get_errors tc))
(if
        (null? errors)
        ""
(str.concat
(str.concat
            "typecheck: "
(str.concat
              (str.from_int (typecheck~2120406276.count_errors tc))
              " type error(s) found\n"))
          (tc_errors_text errors src nil))))))

(def
  join_syms
(lambda
    (syms sep)
(if
      (null? syms)
      ""
(if
        (null? (cdr syms))
        (str.sym_to_str (car syms))
(str.concat
          (str.sym_to_str (car syms))
          (str.concat sep (join_syms (cdr syms) sep)))))))

(def
  tc_errors_text
(lambda
    (errors src used)
(let
      (_m errors)
(if
        (eq? _m nil)
        ""
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (err (car _m))
(let
                (kind (car err))
(let
                  (ctx (car (cdr err)))
(let
                    (name (str.sym_to_str (ctx_root_name ctx)))
(let
                      (details (ctx_detail_list ctx nil))
(let
(detail
(if
                            (null? details)
                            nil
                            (str.sym_to_str (list_last details))))
(let
                          (line (find_fn_line src name))
(let
(loc
(if
                                (> line 0)
(str.concat
                                  "in function '"
(str.concat
                                    name
(str.concat
                                      "' (line "
                                      (str.concat (str.from_int line) "): "))))
(str.concat
                                  "in function '"
                                  (str.concat name "': "))))
(let
(ehead
(if
                                  (= kind 'mismatch)
(let
                                    (t1 (car (cdr (cdr err))))
(let
                                      (t2 (car (cdr (cdr (cdr err)))))
(let
(msg
(str.concat
                                            "cannot unify "
(str.concat
(                                                typecheck~2120406276.type_format
                                                t1
                                                nil)
(str.concat
                                                " with "
(                                                  typecheck~2120406276.type_format
                                                  t2
                                                  nil)))))
(let
(full
(if
                                              (null? detail)
                                              msg
(str.concat
                                                detail
                                                (str.concat ": " msg))))
(str.concat
                                            "  [E0001] "
                                            (str.concat loc full))))))
(if
                                    (= kind 'arity)
(let
(bname
                                        (str.sym_to_str (car (cdr (cdr err)))))
(let
                                        (got (car (cdr (cdr (cdr err)))))
(let
(want
                                            (car (cdr (cdr (cdr (cdr err))))))
(let
(msg
(str.concat
                                                "wrong number of arguments for '"
(str.concat
                                                  bname
(str.concat
                                                    "' (got "
(str.concat
                                                      (str.from_int got)
(str.concat
                                                        ", want "
(str.concat
                                                          (str.from_int want)
                                                          ")")))))))
(let
(full
(if
                                                  (null? detail)
                                                  msg
(str.concat
                                                    detail
                                                    (str.concat ": " msg))))
(str.concat
                                                "  [E0003] "
                                                (str.concat loc full)))))))
(if
                                      (= kind 'undefined-var)
(let
(vname
(str.sym_to_str
                                            (car (cdr (cdr err)))))
(str.concat
                                          "  [E0002] "
(str.concat
                                            loc
(str.concat
                                              "undefined variable '"
                                              (str.concat vname "'")))))
(if
                                        (= kind 'not-exported)
(let
(ename
(str.sym_to_str
                                              (car (cdr (cdr err)))))
(let
(emod
(str.sym_to_str
                                                (car (cdr (cdr (cdr err))))))
(str.concat
                                              "  [E0004] "
(str.concat
                                                loc
(str.concat
                                                  "'"
(str.concat
                                                    ename
(str.concat
                                                      "' is not exported by module '"
                                                      (str.concat emod "'"))))))))
(if
                                          (= kind 'no-export)
(let
(ename
(str.sym_to_str
                                                (car (cdr (cdr err)))))
(let
(emod
(str.sym_to_str
                                                  (car (cdr (cdr (cdr err))))))
(str.concat
                                                "  [E0004] "
(str.concat
                                                  loc
(str.concat
                                                    "module '"
(str.concat
                                                      emod
(str.concat
                                                        "' has no export '"
                                                        (str.concat ename "'"))))))))
(if
                                            (= kind 'non-exhaustive)
(let
(missing
                                                (car (cdr (cdr (cdr err)))))
(str.concat
                                                "  [E0005] "
(str.concat
                                                  loc
(str.concat
                                                    "non-exhaustive match: missing "
                                                    (join_syms missing ", ")))))
(if
                                              (= kind 'duplicate)
(let
(dname
(str.sym_to_str
                                                    (car (cdr (cdr err)))))
(str.concat
                                                  "  [E0006] "
(str.concat
                                                    "duplicate global: "
                                                    dname)))
(let
(uname
(str.sym_to_str
                                                    (car (cdr (cdr err)))))
(str.concat
                                                  "  [E0002] "
(str.concat
                                                    loc
(str.concat
                                                      "undefined function '"
                                                      (str.concat uname "'")))))))))))))
(let
(su
(if
                                    (= kind 'mismatch)
(if
                                      (null? detail)
                                      (cons "" used)
(let
                                        (shead (detail_head detail))
(let
(key
(str.concat
                                              name
                                              (str.concat "/" shead)))
(let
(site
(find_call_site
                                                src
                                                name
                                                shead
                                                (used_count used key)))
(let
(st
(if
                                                  (null? site)
                                                  ""
(str.concat
                                                    "           line "
(str.concat
(str.from_int
                                                        (car site))
(str.concat
                                                        ": >>> "
                                                        (cdr site))))))
                                              (cons st (used_bump used key)))))))
                                    (cons "" used)))
(let
                                  (site_text (car su))
(let
                                    (used2 (cdr su))
(let
                                      (head_line (str.concat ehead "\n"))
(let
(out
(if
                                            (= site_text "")
                                            head_line
(str.concat
                                              head_line
                                              (str.concat site_text "\n"))))
(str.concat
                                          out
                                          (tc_errors_text rest src used2)))))))))))))))))
          nil)))))

(def
  ctx_root_name
  (lambda (ctx) (if (pair? ctx) (ctx_root_name (car ctx)) ctx)))

(def
  ctx_detail_list
(lambda
    (ctx acc)
    (if (pair? ctx) (ctx_detail_list (car ctx) (cons (cdr ctx) acc)) acc)))

(def
  list_last
  (lambda (lst) (if (null? (cdr lst)) (car lst) (list_last (cdr lst)))))

(def
  detail_head
(lambda
    (detail)
(let
      (idx (str.index_of detail " of "))
(if
        (< idx 0)
        detail
        (str.substr detail (+ idx 4) (- (- (str.length detail) idx) 4))))))

(def
  find_call_site
(lambda
    (src name head nth)
(let
      (fn_off (str.index_of src (str.concat "fn " name)))
(if
        (< fn_off 0)
        nil
(let
          (tail (str.substr src fn_off (- (str.length src) fn_off)))
(let
            (open (str.index_of tail "{"))
(if
              (< open 0)
              nil
(let
                (body_start (+ fn_off open))
(let
                  (body_end (match_brace src (+ body_start 1) 1))
(let
                    (body (str.substr src body_start (- body_end body_start)))
(let
                      (pat (str.concat head "("))
(find_hit_from
                        body
                        pat
                        body_start
                        src
                        (- (str.length body) 1)
                        nth
                        (str.length body)))))))))))))

(def
  find_hit_from
(lambda
    (body pat body_start src i nth limit)
(if
      (< i 0)
      nil
(if
        (str.eq (str.substr body i (str.length pat)) pat)
(if
          (= nth 0)
(let
            (abs (+ body_start i))
            (cons (+ 1 (count_newlines src 0 abs)) (line_at src abs)))
          (find_hit_from body pat body_start src (- i 1) (- nth 1) limit))
        (find_hit_from body pat body_start src (- i 1) nth limit)))))

(def
  used_count
(lambda
    (used key)
(let
      (_m used)
(if
        (eq? _m nil)
        0
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (pair (car _m))
              (if (str.eq (car pair) key) (cdr pair) (used_count rest key))))
          nil)))))

(def
  used_bump
(lambda
    (used key)
(let
      (_m used)
(if
        (eq? _m nil)
        (cons (cons key 1) nil)
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (pair (car _m))
(if
                (str.eq (car pair) key)
                (cons (cons key (+ (cdr pair) 1)) rest)
                (cons pair (used_bump rest key)))))
          nil)))))

(def
  last_index_of
(lambda
    (s needle i)
(if
      (< i 0)
      -1
(let
        (idx (str.index_of (str.substr s i (- (str.length s) i)) needle))
(if
          (= idx 0)
          i
          (if (> idx 0) (+ i idx) (last_index_of s needle (- i 1))))))))

(def
  match_brace
(lambda
    (src i depth)
(if
      (= depth 0)
      i
(if
        (>= i (str.length src))
        i
(let
          (c (str.char_at src i))
(if
            (= c 123)
            (match_brace src (+ i 1) (+ depth 1))
(if
              (= c 125)
              (match_brace src (+ i 1) (- depth 1))
              (match_brace src (+ i 1) depth))))))))

(def
  line_at
(lambda
    (src i)
(let
      (start (line_start src i))
      (let (end (line_end src i)) (str.substr src start (- end start))))))

(def
  line_start
(lambda
    (src i)
(if
      (<= i 0)
      0
      (if (= (str.char_at src (- i 1)) 10) i (line_start src (- i 1))))))

(def
  line_end
(lambda
    (src i)
(if
      (>= i (str.length src))
      (str.length src)
      (if (= (str.char_at src i) 10) i (line_end src (+ i 1))))))

(def
  find_fn_line
(lambda
    (src name)
(let
      (idx (str.index_of src (str.concat "fn " name)))
      (if (< idx 0) 0 (+ 1 (count_newlines src 0 idx))))))

(def
  count_newlines
(lambda
    (src i limit)
(if
      (>= i limit)
      0
(if
        (= (str.char_at src i) 10)
        (+ 1 (count_newlines src (+ i 1) limit))
        (count_newlines src (+ i 1) limit)))))

(def
  typecheck_cached
(lambda
    (forms seq cache_dir verbose)
(if
      (= (str.length cache_dir) 0)
      (typecheck~2120406276.infer_program forms)
(let
(plan
(plan_cache
            (seq_units seq nil)
            cache_dir
            nil
            nil
            nil
            nil
            nil
            verbose))
(let
          (seed (car (cdr plan)))
(let
            (hitnames (car (cdr (cdr plan))))
(let
              (skipnames (car (cdr (cdr (cdr plan)))))
(let
                (misses (cdr (cdr (cdr (cdr plan)))))
(let
                  (tc_forms (tc_filter_seq seq skipnames nil))
(let
                    (t0 (vm.time_ms))
(let
(tc
(typecheck~2120406276.infer_program_seeded
                          tc_forms
                          seed))
(let
                        (dt (- (vm.time_ms) t0))
(begin
(if
                            (= verbose 1)
(print
(str.concat
                                "[sig] typecheck "
(str.concat
                                  (str.from_int dt)
(str.concat
                                    "ms ("
(str.concat
                                      (str.from_int (count_strs hitnames))
(str.concat
                                        " hit, "
(str.concat
                                          (str.from_int (count_strs misses))
                                          " miss)")))))))
                            nil)
(store_misses
                            (reverse misses)
                            cache_dir
                            (car plan)
                            (car tc))
                          tc)))))))))))))

(def
  seq_units
(lambda
    (seq acc)
(if
      (null? seq)
      (rev_strs acc nil)
(let
        (e (car seq))
(if
          (= (car e) 'U)
          (seq_units (cdr seq) (cons (cdr e) acc))
          (seq_units (cdr seq) acc))))))

(def
  plan_cache
(lambda
    (units cachedir sighashes seed hitnames skipnames misses verbose)
(if
      (null? units)
      (cons sighashes (cons seed (cons hitnames (cons skipnames misses))))
(let
        (u (car units))
(let
          (name (car u))
(let
            (source (car (cdr u)))
(let
              (ownforms (cdr (cdr u)))
(let
                (deps (modsig~1748518853.unit_dep_names ownforms name nil))
(let
                  (dpr (dep_pairs deps sighashes))
(let
                    (t0 (vm.time_ms))
(if
                      (= (cdr dpr) 0)
(begin
(if
                          (= verbose 1)
(print
(str.concat
                              "[sig] miss "
                              (str.concat name " (dependency rechecking)")))
                          nil)
(plan_cache
                          (cdr units)
                          cachedir
                          sighashes
                          seed
                          hitnames
                          skipnames
                          (cons u misses)
                          verbose))
(let
                        (key (modsig~1748518853.eff_key source (car dpr)))
(let
(text
(file.read
                              (modsig~1748518853.sig_path cachedir name key)))
(let
(entry
                              (modsig~1748518853.sig_load_entry text source))
(if
                              (null? entry)
(let
(pre
(typecheck~2120406276.infer_program_seeded
                                    ownforms
                                    seed))
(let
(pre_errors
                                    (typecheck~2120406276.get_errors pre))
(if
                                    (null? pre_errors)
(let
(bindings
(modsig~1748518853.unit_bindings
                                          ownforms
                                          name
                                          (car pre)
                                          nil))
(let
(etext
(modsig~1748518853.exports_text
                                            bindings))
(let
(sh
                                            (modsig~1748518853.str_hash etext))
(let
(seed2
                                              (list_append seed bindings))
(begin
(if
                                                (= verbose 1)
(print
(str.concat
                                                    "[sig] miss "
                                                    name))
                                                nil)
(plan_cache
                                                (cdr units)
                                                cachedir
(cons
                                                  (cons (str.to_sym name) sh)
                                                  sighashes)
                                                seed2
                                                hitnames
                                                skipnames
                                                (cons u misses)
                                                verbose))))))
(begin
(if
                                        (= verbose 1)
(print
                                          (str.concat "[sig] miss " name))
                                        nil)
(plan_cache
                                        (cdr units)
                                        cachedir
                                        sighashes
                                        seed
                                        hitnames
                                        skipnames
                                        (cons u misses)
                                        verbose)))))
(let
                                (dt (- (vm.time_ms) t0))
(begin
(if
                                    (= verbose 1)
(print
(str.concat
                                        "[sig] hit "
(str.concat
                                          name
(str.concat
                                            " ("
(str.concat
                                              (str.from_int dt)
                                              "ms)")))))
                                    nil)
(plan_cache
                                    (cdr units)
                                    cachedir
(cons
                                      (cons (str.to_sym name) (cdr entry))
                                      sighashes)
                                    (list_append seed (car entry))
                                    (cons name hitnames)
                                    (cons name skipnames)
                                    misses
                                    verbose))))))))))))))))))

(def dep_pairs (lambda (deps sighashes) (dep_pairs_loop deps sighashes nil)))

(def
  dep_pairs_loop
(lambda
    (deps sighashes acc)
(if
      (null? deps)
      (cons (rev_strs acc nil) 1)
(let
        (hit (alist_assoc (str.to_sym (car deps)) sighashes))
(if
          (null? hit)
          (cons nil 0)
(dep_pairs_loop
            (cdr deps)
            sighashes
            (cons (cons (car deps) (cdr hit)) acc)))))))

(def
  tc_filter_seq
(lambda
    (seq hitnames acc)
(if
      (null? seq)
      (reverse acc)
(let
        (e (car seq))
(if
          (= (car e) 'U)
(let
            (ownforms (cdr (cdr (cdr e))))
(let
(acc2
(if
                  (str_in_strs (car (cdr e)) hitnames)
                  (rev_app (keep_cached_forms ownforms nil) acc)
                  (rev_app ownforms acc)))
              (tc_filter_seq (cdr seq) hitnames acc2)))
          (tc_filter_seq (cdr seq) hitnames (cons (cdr e) acc)))))))

(def
  keep_cached_forms
(lambda
    (forms acc)
(if
      (null? forms)
      acc
(let
        (f (car forms))
(let
(acc2
(if
              (pair? f)
(let
                (head (car f))
(if
                  (= head 'type)
                  (cons f acc)
(if
                    (= head 'external_fn)
                    (cons f acc)
                    (if (= head 'import) (cons f acc) acc))))
              acc))
          (keep_cached_forms (cdr forms) acc2))))))

(def
  store_misses
(lambda
    (misses cachedir sighashes env)
(if
      (null? misses)
      sighashes
(let
        (u (car misses))
(let
          (name (car u))
(let
            (source (car (cdr u)))
(let
              (ownforms (cdr (cdr u)))
(let
                (deps (modsig~1748518853.unit_dep_names ownforms name nil))
(let
                  (dpr (dep_pairs deps sighashes))
(if
                    (= (cdr dpr) 1)
(let
(bindings
(modsig~1748518853.unit_bindings
                          ownforms
                          name
                          env
                          nil))
(let
                        (etext (modsig~1748518853.exports_text bindings))
(let
                          (sh (modsig~1748518853.str_hash etext))
(let
                            (key (modsig~1748518853.eff_key source (car dpr)))
(begin
(modsig~1748518853.sig_store
                                cachedir
                                name
                                key
                                source
                                etext
                                sh)
(store_misses
                                (cdr misses)
                                cachedir
                                (cons (cons (str.to_sym name) sh) sighashes)
                                env))))))
                    (store_misses (cdr misses) cachedir sighashes env)))))))))))

(def
  str_in_strs
(lambda
    (s lst)
    (if (null? lst) false (if (= (car lst) s) true (str_in_strs s (cdr lst))))))

(def
  count_strs
  (lambda (lst) (if (null? lst) 0 (+ 1 (count_strs (cdr lst))))))

(def
  rev_strs
(lambda
    (lst acc)
    (if (null? lst) acc (rev_strs (cdr lst) (cons (car lst) acc)))))

(def
  load_source_ta
(lambda
    (path use_ta with_cov)
(let
      (src (file.read path))
(if
        (null? src)
        (cons nil (cons nil (str.concat "error: cannot read file: " path)))
(let
          (pr (parse_module_content src path use_ta with_cov))
(let
            (err (cdr pr))
(if
              (null? err)
              (resolve_imports (car pr) (dirname path) use_ta with_cov)
              (cons nil (cons nil err)))))))))

(def
  die
(lambda
    (stage)
    (die_msg (str.concat "lisp-backend: " (str.concat stage "\n")))))

(def
  die_msg
  (lambda (msg) (begin (file.write "/dev/stderr" msg) (os.exit 1))))

(def
  fmt_file
(lambda
    (path)
(let
      (src (file.read path))
(let
        (out (fmt~2284362179.format src))
        (if (!= out src) (file.write path out) nil)))))

(def
  fmt_check
(lambda
    (path)
(let
      (src (file.read path))
(let
        (out (fmt~2284362179.format src))
(if
          (= out src)
          (print (str.concat "ok: " path))
          (print (str.concat "diff: " path)))))))

(def
  main
(lambda
    nil
(let
      (a0 (vm.get_arg 0))
(if
        (= a0 "fmt")
(let
          (arg1 (vm.get_arg 1))
          (if (= arg1 "--check") (fmt_check (vm.get_arg 2)) (fmt_file arg1)))
(if
          (= a0 "--emit-kl")
(compile_ta
            (vm.get_arg 2)
            (vm.get_arg 3)
            (vm.get_arg 4)
            (vm.get_arg 1)
            nil)
(if
            (= a0 "--emit-kl-dir")
(compile_ta
              (vm.get_arg 2)
              (vm.get_arg 3)
              (vm.get_arg 4)
              nil
              (vm.get_arg 1))
(if
              (= a0 "--from-kl")
              (compile_kl (vm.get_arg 1) (vm.get_arg 2))
(if
                (= a0 "--link-kl")
                (link_kl (vm.get_arg 1) 2)
                (compile_ta a0 (vm.get_arg 1) (vm.get_arg 2) nil nil)))))))))

(def
  compile_ta
(lambda
    (src out cache_dir emit_kl emit_kl_dir)
(let
      (text (file.read src))
(begin
        (if (null? text) (die "cannot read source file") nil)
        (let (pr (parse_module_content text src 1 0)) nil)
        (if (= (null? (cdr pr)) false) (die (cdr pr)) nil)
        (let (ast (car pr)) nil)
        (let (rr (resolve_imports ast (dirname src) 1 0)) nil)
        (let (rerr (cdr (cdr rr))) nil)
        (if (= (null? rerr) false) (die (str.concat "module: " rerr)) nil)
        (let (forms (car rr)) nil)
        (let (cd (if (null? cache_dir) "" cache_dir)) nil)
        (let (tc (typecheck_cached forms (car (cdr rr)) cd 0)) nil)
(if
          (> (typecheck~2120406276.count_errors tc) 0)
(die_msg
(str.concat
              (typecheck_report tc text)
              "lisp-backend: typecheck\n"))
          nil)
        (let (low (lower-ast~1807651144.lower_program forms)) nil)
        (if (int? low) (die "lower") nil)
(if
          (= (null? emit_kl) false)
          (file.write emit_kl (kl~678549171.write_program low))
          nil)
(if
          (= (null? emit_kl_dir) false)
          (emit_kl_chunks emit_kl_dir (car (cdr rr)))
          nil)
        (compile_low low out)))))

(def
  emit_kl_chunks
(lambda
    (dir seq)
(let
      (grouped (group_chunks (seq_tagged seq nil) nil nil))
(write_chunks
        dir
        (dedupe_last (car grouped) nil)
        (car (cdr grouped))
        0
        ""))))

(def
  seq_tagged
(lambda
    (seq acc_rev)
(if
      (null? seq)
      (reverse acc_rev)
(if
        (= (car (car seq)) 'U)
(let
          (name (qual_prefix (car (cdr (car seq)))))
(seq_tagged
            (cdr seq)
            (rev_app_tagged (cdr (cdr (cdr (car seq)))) name acc_rev)))
        (seq_tagged (cdr seq) (cons (cons (cdr (car seq)) "main") acc_rev))))))

(def
  rev_app_tagged
(lambda
    (lst tag acc)
(if
      (null? lst)
      acc
      (rev_app_tagged (cdr lst) tag (cons (cons (car lst) tag) acc)))))

(def
  group_chunks
(lambda
    (tagged order_rev chunks)
(if
      (null? tagged)
      (cons (reverse order_rev) (cons chunks nil))
(let
        (p (car tagged))
(let
          (cur (assq_key (cdr p) chunks))
(let
(new_chunks
(if
                (null? cur)
                (cons (cons (cdr p) (cons (car p) nil)) chunks)
                (cons (cons (cdr p) (cons (car p) (cdr cur))) chunks)))
(let
(new_order
(if
                  (null? cur)
                  (cons (cdr p) order_rev)
                  (cons (cdr p) order_rev)))
              (group_chunks (cdr tagged) new_order new_chunks))))))))

(def
  dedupe_last
(lambda
    (order acc)
(if
      (null? order)
      (reverse acc)
(let
        (keep (if (in_list (car order) (cdr order)) false true))
        (dedupe_last (cdr order) (if keep (cons (car order) acc) acc))))))

(def
  in_list
(lambda
    (x lst)
    (if (null? lst) false (if (= (car lst) x) true (in_list x (cdr lst))))))

(def
  assq_key
(lambda
    (key alist)
(if
      (null? alist)
      nil
      (if (= (car (car alist)) key) (car alist) (assq_key key (cdr alist))))))

(def
  write_chunks
(lambda
    (dir order chunks i manifest)
(if
      (null? order)
      (file.write (str.concat dir "/manifest") (str.concat manifest "\n"))
(let
        (name (car order))
(let
          (forms (reverse (cdr (assq_key name chunks))))
(let
            (lowc (lower-ast~1807651144.lower_program forms))
(begin
              (if (int? lowc) (die "lower chunk") nil)
(let
(fname
(str.concat
                    (pad2 i)
                    (str.concat "-" (str.concat name ".kl"))))
                nil)
(file.write
                (str.concat dir (str.concat "/" fname))
                (kl~678549171.write_program lowc))
(let
(next_manifest
(if
                    (= manifest "")
                    fname
                    (str.concat manifest (str.concat "\n" fname))))
                nil)
              (write_chunks dir (cdr order) chunks (+ i 1) next_manifest))))))))

(def
  pad2
(lambda
    (i)
    (if (< i 10) (str.concat "0" (str.from_int i)) (str.from_int i))))

(def
  link_kl
(lambda
    (out i)
(begin
      (if (= out "") (die "--link-kl: missing output path") nil)
      (if (= (vm.get_arg 2) "") (die "--link-kl: no input .kl files") nil)
      (link_kl_read out 2 nil))))

(def
  link_kl_read
(lambda
    (out i acc)
(let
      (a (vm.get_arg i))
(if
        (= a "")
        (file.write out (kl~678549171.write_program acc))
(let
          (text (file.read a))
(begin
(if
              (null? text)
              (die (str.concat "cannot read .kl file: " a))
              nil)
(let
              (_m (kl~678549171.read_program text))
(if
(if
                  (pair? _m)
(if
                    (eq? (car _m) 'Err)
                    (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
(let
                  (msg (car (cdr _m)))
(die
(str.concat
                      ".kl parse: "
                      (str.concat a (str.concat ": " msg)))))
(if
(if
                    (pair? _m)
(if
                      (eq? (car _m) 'Ok)
                      (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
(let
                    (fs (car (cdr _m)))
                    (link_kl_read out (+ i 1) (list.append acc fs)))
                  nil)))))))))

(def
  compile_kl
(lambda
    (kl_path out)
(let
      (text (file.read kl_path))
(begin
(if
          (null? text)
          (die (str.concat "cannot read .kl file: " kl_path))
          nil)
(let
          (_m (kl~678549171.read_program text))
(if
(if
              (pair? _m)
(if
                (eq? (car _m) 'Err)
                (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
            (let (msg (car (cdr _m))) (die (str.concat ".kl parse: " msg)))
(if
(if
                (pair? _m)
(if
                  (eq? (car _m) 'Ok)
                  (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
              (let (low (car (cdr _m))) (compile_low low out))
              nil)))))))

(def
  compile_low
(lambda
    (low out)
(let
      (_m (kl~678549171.read_program (bytecode~1530480983.lib_src)))
(if
(if
          (pair? _m)
(if
            (eq? (car _m) 'Err)
            (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
        (let (msg (car (cdr _m))) (die (str.concat "prelude parse: " msg)))
(if
(if
            (pair? _m)
(if
              (eq? (car _m) 'Ok)
              (if (pair? (cdr _m)) (if true (eq? (cdr (cdr _m)) nil)))))
(let
            (prelude (car (cdr _m)))
