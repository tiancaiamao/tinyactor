(def
  typecheck~2120406276$map_tc_errors
(lambda
    (errors)
(let
      (_m errors)
(if
        (eq? _m nil)
        nil
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (err (car _m))
(if
                (= (car err) 'tc_error)
(let
                  (t1 (car (cdr err)))
(let
                    (t2 (car (cdr (cdr err))))
(let
                      (ctx (car (cdr (cdr (cdr err)))))
(cons
                        (cons 'mismatch (cons ctx (cons t1 (cons t2 nil))))
                        (typecheck~2120406276$map_tc_errors rest)))))
(if
                  (= (car err) 'tc_arity)
(let
                    (name (car (cdr err)))
(let
                      (got (car (cdr (cdr err))))
(let
                        (want (car (cdr (cdr (cdr err)))))
(let
                          (ctx (car (cdr (cdr (cdr (cdr err))))))
(cons
(cons
                              'arity
(cons
                                ctx
                                (cons name (cons got (cons want nil)))))
                            (typecheck~2120406276$map_tc_errors rest))))))
(if
                    (= (car err) 'tc_not_exported)
(let
                      (name (car (cdr err)))
(let
                        (mod (car (cdr (cdr err))))
(let
                          (ctx (car (cdr (cdr (cdr err)))))
(cons
(cons
                              'not-exported
                              (cons ctx (cons name (cons mod nil))))
                            (typecheck~2120406276$map_tc_errors rest)))))
(if
                      (= (car err) 'tc_no_export)
(let
                        (name (car (cdr err)))
(let
                          (mod (car (cdr (cdr err))))
(let
                            (ctx (car (cdr (cdr (cdr err)))))
(cons
(cons
                                'no-export
                                (cons ctx (cons name (cons mod nil))))
                              (typecheck~2120406276$map_tc_errors rest)))))
(if
                        (= (car err) 'tc_nonexh)
(let
                          (tname (car (cdr err)))
(let
                            (missing (car (cdr (cdr err))))
(let
                              (ctx (car (cdr (cdr (cdr err)))))
(cons
(cons
                                  'non-exhaustive
                                  (cons ctx (cons tname (cons missing nil))))
                                (typecheck~2120406276$map_tc_errors rest)))))
(if
                          (= (car err) 'tc_dupglobal)
(let
                            (name (car (cdr err)))
(cons
                              (cons 'duplicate (cons name (cons name nil)))
                              (typecheck~2120406276$map_tc_errors rest)))
(let
                            (name (car (cdr err)))
(let
                              (ctx (car (cdr (cdr err))))
(let
                                (kind (car (cdr (cdr (cdr err)))))
(let
(out_kind
(if
                                      (= kind 'variable)
                                      'undefined-var
                                      'undefined))
(cons
                                    (cons out_kind (cons ctx (cons name nil)))
                                    (typecheck~2120406276$map_tc_errors rest))))))))))))))
          nil)))))

(def
  typecheck~2120406276$print_error_list
(lambda
    (errors)
(let
      (_m errors)
(if
        (eq? _m nil)
        nil
(if
          (if (pair? _m) (if true true))
(let
            (rest (cdr _m))
(let
              (err (car _m))
(begin
(if
                  (= (car err) 'tc_error)
(let
                    (t1 (car (cdr err)))
(let
                      (t2 (car (cdr (cdr err))))
(let
                        (ctx (car (cdr (cdr (cdr err)))))
(let
(msg
(str.concat
                              "  [E0001] cannot unify "
(str.concat
                                (typecheck~2120406276.type_format t1 nil)
(str.concat
                                  " with "
                                  (typecheck~2120406276.type_format t2 nil)))))
(if
                            (null? ctx)
                            (print msg)
(print
(str.concat
                                "  in function '"
(str.concat
(str.sym_to_str
                                    (typecheck~2120406276$tc_ctx_root ctx))
                                  (str.concat "': " msg)))))))))
(if
                    (= (car err) 'tc_arity)
(let
                      (name (car (cdr err)))
(let
                        (got (car (cdr (cdr err))))
(let
                          (want (car (cdr (cdr (cdr err)))))
(let
                            (ctx (car (cdr (cdr (cdr (cdr err))))))
(let
(msg
(str.concat
                                  "  [E0003] wrong number of arguments for '"
(str.concat
                                    (str.sym_to_str name)
(str.concat
                                      "' (got "
(str.concat
                                        (str.from_int got)
(str.concat
                                          ", want "
                                          (str.concat (str.from_int want) ")")))))))
(if
                                (null? ctx)
                                (print msg)
(print
(str.concat
                                    "  in function '"
(str.concat
(str.sym_to_str
                                        (typecheck~2120406276$tc_ctx_root ctx))
                                      (str.concat "': " msg))))))))))
(if
                      (= (car err) 'tc_not_exported)
(let
                        (name (car (cdr err)))
(let
                          (mod (car (cdr (cdr err))))
(let
                            (ctx (car (cdr (cdr (cdr err)))))
(let
(msg
(str.concat
                                  "  [E0004] '"
(str.concat
                                    (str.sym_to_str name)
(str.concat
                                      "' is not exported by module '"
                                      (str.concat (str.sym_to_str mod) "'")))))
(if
                                (null? ctx)
                                (print msg)
(print
(str.concat
                                    "  in function '"
(str.concat
(str.sym_to_str
                                        (typecheck~2120406276$tc_ctx_root ctx))
                                      (str.concat "': " msg)))))))))
(if
                        (= (car err) 'tc_no_export)
(let
                          (name (car (cdr err)))
(let
                            (mod (car (cdr (cdr err))))
(let
                              (ctx (car (cdr (cdr (cdr err)))))
(let
(msg
(str.concat
                                    "  [E0004] module '"
(str.concat
                                      (str.sym_to_str mod)
(str.concat
                                        "' has no export '"
                                        (str.concat (str.sym_to_str name) "'")))))
(if
                                  (null? ctx)
                                  (print msg)
(print
(str.concat
                                      "  in function '"
(str.concat
(str.sym_to_str
(typecheck~2120406276$tc_ctx_root
                                            ctx))
                                        (str.concat "': " msg)))))))))
(if
                          (= (car err) 'tc_dupglobal)
(let
                            (name (car (cdr err)))
(print
(str.concat
                                "  [E0006] duplicate global: "
                                (str.sym_to_str name))))
(let
                            (name (car (cdr err)))
(let
                              (ctx (car (cdr (cdr err))))
(let
                                (kind (car (cdr (cdr (cdr err)))))
(let
(what
(if
                                      (= kind 'variable)
                                      "undefined variable '"
                                      "undefined function '"))
(let
(msg
(str.concat
                                        "  [E0002] "
(str.concat
                                          what
(str.concat
                                            (str.sym_to_str name)
                                            "'"))))
(if
                                      (null? ctx)
                                      (print msg)
(print
(str.concat
                                          "  in function '"
(str.concat
(str.sym_to_str
(                                                typecheck~2120406276$tc_ctx_root
                                                ctx))
                                            (str.concat "': " msg)))))))))))))))
                (typecheck~2120406276$print_error_list rest))))
          nil)))))

