// driver.ta — Bootstrap driver with TA import resolution

// 全仓库统一写法：`"<identity>:<树内路径>"` 全名（docs/modules.md），
// 无裸名、无相对形式。显式 `as <末段>` 不是装饰：make bootstrap 的自举种子
// （上一次的 bootstrap.tabc）只会给「显式 as」建别名对——无 as 的默认
// 别名是新契约语义，种子不认识，自举第一遍就会 typecheck 红。显式拼写
// 与新编译器的默认别名（末段）语义完全一致，收敛后逐字节稳定。
import "tinyactor:lib/bootstrap/tokenizer" as tokenizer
import "tinyactor:lib/bootstrap/parser" as parser
import "tinyactor:lib/bootstrap/typecheck" as typecheck
import "tinyactor:lib/bootstrap/modsig" as modsig
import "tinyactor:lib/bootstrap/compile" as compile
import "tinyactor:lib/bootstrap/ast" as ast
import "tinyactor:lib/bootstrap/form" as form
import "tinyactor:lib/file"
import "tinyactor:lib/bootstrap/fmt" as fmt
import "tinyactor:lib/list"
import "tinyactor:lib/bootstrap/lower-ast" as lower-ast
// covinst = --cov 插桩器（typecheck 后 / lower 前原地改写 cov.line 标记）。
// 与 C 侧 sink 模块 lib/cov.c（模块名 cov）**不能撞名**：resolve 把
// `import <builtin 模块名>` 当 no-op，撞名时每个 instrument 调用静默返回 nil。
import "tinyactor:lib/bootstrap/covinst" as covinst
import "tinyactor:lib/bootstrap/bytecode" as bytecode
// 原生后端（KL→C）：生成器与 C 宿主同在 lib/native/（与 lib/bootstrap/ 平级的
// 编译器侧子树）—— 第二后端的东西不散到 src/（字节码 VM 运行时）里。
import "tinyactor:lib/native/cgen" as cgen
// kl = .kl writer + reader（--emit-kl / --from-kl 两半；reader 在编译器层，
//      编译路径因此不 dlopen lib/sexp.dylib，见 docs/kl-format.md §2）
import "tinyactor:lib/bootstrap/kl" as kl
import "tinyactor:lib/os"
import "tinyactor:lib/str"
import "tinyactor:lib/vm"
import "tinyactor:lib/result"
import "tinyactor:lib/option"

fn find_last_slash(path, i) {
  if i < 0 { -1 }
  else {
    if str.char_at(path, i) == '/' { i }
    else { find_last_slash(path, i - 1) }
  }
}

pub fn dirname(path) {
  let idx = find_last_slash(path, str.length(path) - 1)
  if idx < 0 { "." }
  else { str.substr(path, 0, idx) }
}

// === Efficient list operations ===

fn rev_app(lst, acc) {
  if null?(lst) { acc }
  else { rev_app(cdr(lst), cons(car(lst), acc)) }
}

fn reverse(lst) { rev_app(lst, nil) }

// Parse source content with the TA tokenizer/parser.
// Returns (forms . err): err is nil on success, or an error message string.
// pub（7b-4）：CLI 半程复用同一验证链（check_syntax +
// find_parse_error + check_toplevel_forms + 富位置报告），两条宿主路径
// 对负例的拒绝口径由此同源——lisp 侧自造 parse 检查曾放行 10 个负例。
pub fn parse_module_content(content, path, use_ta, with_cov) {
  let pr = if use_ta == 1 {
    // tokenize_pos also yields one (line col off) entry per token so
    // syntax/parse errors can report a location (issue #66) and --cov
    // builds can stamp statements with source lines.
    let tp = tokenizer.tokenize_pos(content)
    let toks = car(tp)
    let poss = cdr(tp)
    let err = check_syntax(toks, poss, content)
    if null?(err) {
            // parser 的两个入口，都直接产 form.Form 树（本层不经过未类型化副本）。
      let result = if with_cov == 1 {
        parser.parse_forms_cov(toks, poss, path)
      } else {
        parser.parse_forms(toks)
      }
      let perr = find_parse_error(result)
      if null?(perr) {
        cons(result, nil)
      } else {
        let msg = car(perr)
        let tokpos = cdr(perr)
        let desc = tok_text(toks, tokpos)
        cons(nil, str.concat(str.concat(path, ": "), err_at(content, poss, tokpos, msg, desc)))
      }
    } else {
      cons(nil, str.concat(str.concat(path, ": "), err))
    }
  } else {
    // C 侧 lisp reader（vm.parse_source）交的还是未类型化 cons 树：这是
    // **C 边界**，永久保留的一道 from_untyped。
    let result = form.from_untyped_program(vm.parse_source(content))
    cons(result, nil)
  }
  // Top-level form check: bare expressions are silently ignored by the
  // typechecker, which used to turn garbage input into an empty no-op
  // program.
  if null?(cdr(pr)) {
    let ferr = check_toplevel_forms(car(pr))
    if null?(ferr) { pr }
    else { cons(nil, str.concat(str.concat(path, ": "), ferr)) }
  } else {
    pr
  }
}

// find_parse_error(forms) -> (msg . tokpos), or nil if the tree is clean.
// The parser embeds a (parse_error msg tokpos) marker form in the AST when
// it rejects a user-written form (e.g. prefix (and ...) / (or ...)); tokpos
// is the offending token index, used for the line/col in the message (see
// mk_parse_error in parser.ta). The marker can land at any depth —
// top-level, a function body, a let value, a match arm — so scan the whole
// tree for it.
fn find_parse_error(forms : List(form.Form)) {
  if null?(forms) {
    nil
  } else {
    let f = car(forms)
    let items = form.items(f)
    if form.is_sym(form.nth(items, 0), 'parse_error) {
      // (parse_error msg tokpos) —— 三段真列表，msg 是字符串原子、tokpos 是
      // 整数原子（位置就是第三个元素；M3 之前它是点对尾
      // (parse_error msg . tokpos)，退场后不用再猜 cdr 拿到什么）。
      match form.nth(items, 1) {
        form.FAtom(ast.CStr(msg)) -> cons(msg, tokpos_at(form.nth(items, 2)))
        // msg 不是字符串：不是真正的 marker（手写 / 坏树），当干净。
        _ -> nil
      }
    } else {
      // marker 可以落在任意深度，故先深搜本 form 再走余下的表。
      let fa = find_parse_error(items)
      if null?(fa) { find_parse_error(cdr(forms)) }
      else { fa }
    }
  }
}

// tokpos_at(f) — marker 第三个元素（token 下标）；形状不对 → 0（首 token）。
fn tokpos_at(f : form.Form) -> Int {
  match f {
    form.FAtom(ast.CInt(n)) -> n
    _ -> 0
  }
}

// ---- form 小工具（源树是 form.Form）----
//
// 槽位约定都只看 **items**（FAtom 的 items 是 nil），所以「不像的地方」
// 自然读成 nil 原子，不再需要到处 pair?/car/cdr 试探。

// str_at(f) — 字符串原子 → 该字符串；其它（含 nil 原子）→ ""。
fn str_at(f : form.Form) -> String {
  match f {
    form.FAtom(ast.CStr(s)) -> s
    _ -> ""
  }
}

// imp_name(f) / imp_alias(f) — import form
// `(import "<树名>:<路径>" "<别名>")` 的两槽（都是字符串原子；别名缺省为
// nil 原子，用 form.is_nil_form 判）。
fn imp_name(f : form.Form) -> String {
  str_at(form.nth(form.items(f), 1))
}

fn imp_alias(f : form.Form) -> String {
  str_at(form.nth(form.items(f), 2))
}

// sig_name(f) — 定义 form `(define (name args…) body…)` 的名字；签名槽不是
// 列表时给 'nil（旧 `car(car(cdr(f)))` 在坏树上静默给 nil 的那份语义）。
fn sig_name(f : form.Form) -> Symbol {
  form.sym_at(form.nth(form.items(form.nth(form.items(f), 1)), 0))
}

// Every top-level form must be a declaration (define/define_pub/type/
// type-sig/import). Anything else — a bare symbol, int, or an expression
// such as `x = 1` or `1 2 3` — parses fine but is silently dropped by the
// typechecker, producing an empty no-op program with exit code 0.
// Returns nil if OK, or an error message string.
fn check_toplevel_forms(forms : List(form.Form)) {
  match forms {
    nil -> nil
    cons(f, rest) -> match f {
      form.FAtom(_) -> "parse error: unexpected top-level expression"
      form.FList(items) -> {
        let head = form.nth(items, 0)
        if form.is_sym(head, 'define) {
          check_define_name(f, rest)
        } else {
          if form.is_sym(head, 'define_pub) {
            check_define_name(f, rest)
          } else {
            if form.is_sym(head, 'import) {
              // import requires a module name; `import` alone parses as
              // (import nil) and used to fail silently at resolve time.
              if form.is_nil_form(form.nth(items, 1)) {
                "parse error: import requires a module name"
              } else {
                check_toplevel_forms(rest)
              }
            } else {
              if form.is_sym(head, 'type) {
                check_toplevel_forms(rest)
              } else {
                if form.is_sym(head, 'type-sig) {
                  check_toplevel_forms(rest)
                } else {
                  if form.is_sym(head, 'external_fn) {
                    // external C module signature declaration (lib/<mod>.ta)
                    check_toplevel_forms(rest)
                  } else {
                    if form.is_sym(head, 'const) {
                      // const NAME = expr (compile-time constant)
                      check_toplevel_forms(rest)
                    } else {
                      "parse error: unexpected top-level expression"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// A function name must not be a keyword: `fn fn fn` parses the keyword
// `fn` as the function name, producing (define (fn) nil).
fn check_define_name(form : form.Form, rest : List(form.Form)) {
  // form = (define (name args) body ...)
  match form.nth(form.items(form), 1) {
    // 签名槽不是列表 ⇒ 没有名字可查，放行（旧 car 的静默语义）。
    form.FAtom(_) -> check_toplevel_forms(rest)
    form.FList(sig) -> {
      let name = form.sym_at(form.nth(sig, 0))
      if tokenizer.is_kw(str.sym_to_str(name)) == true {
        str.concat("parse error: invalid function name '", str.concat(str.sym_to_str(name), "'"))
      } else {
        check_toplevel_forms(rest)
      }
    }
  }
}

// === Positioned parse-error messages (issue #66) ===
//
// Every syntax/parse error is reported as:
//   parse error: <msg> at line L, col C (token <desc>) near "<snippet>"
// and end-of-file imbalance as:
//   parse error: <msg> (line L, col C, end of file) near "<snippet>"
// where L/C locate the offending token (or EOF), <desc> is the token's
// printable value and <snippet> is ~10 chars of source on each side,
// clipped to a single line.

// Position entry (line col off) for token index n in the parallel
// position list. Falls back to (1 1 0) when n is out of range.
fn pos_of(poss, n) {
  if null?(poss) {
    cons(1, cons(1, cons(0, nil)))
  } else {
    if n <= 0 {
      car(poss)
    } else {
      pos_of(cdr(poss), n - 1)
    }
  }
}

// Printable description of the n-th token, e.g. '}' or 'foo'.
fn tok_text(toks, n) {
  if null?(toks) {
    "'token'"
  } else {
    if n <= 0 {
      render_tok(car(toks))
    } else {
      tok_text(cdr(toks), n - 1)
    }
  }
}

fn render_tok(tok) {
  let typ = car(tok)
  let val = cdr(tok)
  match typ {
    'eof -> "'eof'"
    'lparen -> "'('"
    'rparen -> "')'"
    'lbracket -> "'['"
    'rbracket -> "']'"
    'lbrace -> "'{'"
    'rbrace -> "'}'"
    _ -> {
      if string?(val) {
        str.concat("'", str.concat(val, "'"))
      } else {
        if int?(val) {
          str.concat("'", str.concat(str.from_int(val), "'"))
        } else {
          "'token'"
        }
      }
    }
  }
}

// Last index of '\n' in [i, limit), or -1 when none.
fn last_nl_before(src, i, limit) {
  if i >= limit {
    -1
  } else {
    if str.char_at(src, i) == '\n' {
      let r = last_nl_before(src, i + 1, limit)
      if r < 0 { i } else { r }
    } else {
      last_nl_before(src, i + 1, limit)
    }
  }
}

// First index of '\n' in [i, limit), or limit when none.
fn first_nl_from(src, i, limit) {
  if i >= limit {
    limit
  } else {
    if str.char_at(src, i) == '\n' { i } else { first_nl_from(src, i + 1, limit) }
  }
}

// Source snippet around `off`: up to 10 chars on each side, clipped to
// the line containing `off` so the snippet is always single-line.
fn snippet_at(src, off) {
  let len = str.length(src)
  let raw_start = if off - 10 < 0 { 0 } else { off - 10 }
  let raw_end = if off + 10 > len { len } else { off + 10 }
  let nl = last_nl_before(src, raw_start, off)
  let start = if nl < 0 { raw_start } else { nl + 1 }
  let end = first_nl_from(src, off, raw_end)
  str.substr(src, start, end - start)
}

// "parse error: <msg> at line L, col C (token <desc>) near \"<snippet>\""
fn err_at(src, poss, n, msg, desc) {
  let p = pos_of(poss, n)
  let line = car(p)
  let col = car(cdr(p))
  let off = car(cdr(cdr(p)))
  str.concat("parse error: ",
  str.concat(msg,
  str.concat(" at line ",
  str.concat(str.from_int(line),
  str.concat(", col ",
  str.concat(str.from_int(col),
  str.concat(" (token ",
  str.concat(desc,
  str.concat(") near \"",
  str.concat(snippet_at(src, off), "\""))))))))))
}

// "parse error: <msg> (line L, col C, end of file) near \"<snippet>\""
fn err_at_eof(src, poss, n, msg) {
  let p = pos_of(poss, n)
  let line = car(p)
  let col = car(cdr(p))
  let off = car(cdr(cdr(p)))
  str.concat("parse error: ",
  str.concat(msg,
  str.concat(" (line ",
  str.concat(str.from_int(line),
  str.concat(", col ",
  str.concat(str.from_int(col),
  str.concat(", end of file) near \"",
  str.concat(snippet_at(src, off), "\""))))))))
}

// Scan token list for syntax errors before parsing.
// Returns nil if OK, or an error message string.
// Catches: unterminated string literals, unknown characters, and
// unbalanced delimiters — previously these compiled silently into
// garbage bytecode that only failed at runtime (or not at all).
// `poss` carries a (line col off) entry per token and is threaded through
// the scan alongside the token list, so when an error fires the offending
// token's entry is at index 0; `src` is the tokenized source for
// location/snippet reporting (issue #66).
fn check_syntax(toks, poss, src) {
  scan_tokens(toks, poss, src, 0, 0, 0, 0)
}

fn scan_tokens(toks, poss, src, n, paren, brack, brace) {
  if null?(toks) { nil }
  else {
    let tok = car(toks)
    let typ = car(tok)
    let rest = cdr(toks)
    if typ == 'eof {
      // End of input: everything must be balanced. Report the EOF location.
      if paren > 0 { err_at_eof(src, poss, 0, "unbalanced '(' — missing ')'") }
      else if brack > 0 { err_at_eof(src, poss, 0, "unbalanced '[' — missing ']'") }
      else if brace > 0 { err_at_eof(src, poss, 0, "unbalanced '{' — missing '}'") }
      else { nil }
    } else if typ == 'unterminated {
      err_at(src, poss, 0, "unterminated string literal", "'\"'")
    } else if typ == 'unknown {
      let p = pos_of(poss, 0)
      let off = car(cdr(cdr(p)))
      let desc = str.concat("'", str.concat(str.substr(src, off, 1), "'"))
      err_at(src, poss, 0, "unexpected character", desc)
    } else if typ == 'lparen {
      scan_tokens(rest, cdr(poss), src, n + 1, paren + 1, brack, brace)
    } else if typ == 'rparen {
      if paren > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren - 1, brack, brace)
      } else {
        err_at(src, poss, 0, "unbalanced ')'", "')'")
      }
    } else if typ == 'lbracket {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack + 1, brace)
    } else if typ == 'rbracket {
      if brack > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren, brack - 1, brace)
      } else {
        err_at(src, poss, 0, "unbalanced ']'", "']'")
      }
    } else if typ == 'lbrace {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace + 1)
    } else if typ == 'rbrace {
      if brace > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace - 1)
      } else {
        err_at(src, poss, 0, "unbalanced '}'", "'}'")
      }
    } else {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace)
    }
  }
}

// ============================================================
// Module graph resolution (Phase B, issue #96)
// ============================================================
//
// An imported module is no longer flattened into the importer's namespace.
// Each loaded unit keeps its own namespace by renaming its definitions:
//   - pub fn        -> mod.name   (the qualified name user code writes;
//                      visible to importers through the export table)
//   - non-pub fn    -> mod$name   (unreachable by qualified syntax, so
//                      module-private; the module's own bare references
//                      are rewritten to the renamed name)
//   - const         -> mod.name   (no `pub const` syntax exists yet, so
//                      consts are treated as exported — parser keeps its
//                      current shape per the Phase B scope)
//   - pub type      -> mod.Name   (issue #462; the parser drops `pub` on
//                      types today, so every type declaration is exported)
//   - ctor          -> mod.Ctor   (same member family as its type: the tag
//                      the compiler emits is the qualified symbol, which is
//                      why lib/str.c interns `option.Some`, not `Some`)
//   - external_fn   -> verbatim (the C symbol name must match the VM
//                      registry); only its annotations are qualified

// Dotted references (mpc.ret) then resolve directly against the renamed
// pub members in both typecheck and the compile chain; the old "strip the prefix and
// look up the bare name" fallback is deleted (two modules exporting the
// same bare name can no longer shadow each other).
//
// `import foo as f` rewrites f.bar references to foo.bar inside the unit
// that declared the alias; using the real name of an aliased module is an
// error so exactly one spelling is live per file.
//
// The import graph deduplicates by resolved path (diamond dependencies
// load a module once) and detects cycles explicitly:
//   error: circular import: a -> b -> a
// (replacing the old depth>16 heuristic).
//
// Phase C (issue #99) additionally records the splice as a sequence:
//   ('F . form)  — a loose form (main-file form, retained import marker)
//   ('U . unit)  — a loaded module, unit = (name . (source . ownforms))
// seq_forms(seq) reproduces the exact splice order the compiler has always seen
// (unit forms at their import position, import marker after), while the
// signature cache walks seq to decide which units' typechecking can be
// skipped. A unit's own forms follow its transitive imports, so seq order
// is topo order (dependencies first).

// Returns (forms . (seq . err)): forms is the flat form list in the
// historical splice order (compiler input, order-sensitive); seq is the
// grouped form of the same splice. err is nil on success.
pub fn resolve_imports(forms : List(form.Form), root, use_ta, with_cov) {
  // The main file's own `import x as a` aliases apply to its references.
  let ar = rewrite_unit_aliases(forms)
  let aerr = cdr(ar)
  if null?(aerr) {
    let r = resolve_loop(car(ar), root, nil, nil, nil, use_ta, with_cov)
    let err = cdr(cdr(r))
    if null?(err) {
      let seq = reverse(car(r))
      // external fn 引用侧 verbatim（#433）：默认别名改写把 external 引用
      // 带上了目标单元的 mangle 前缀，与声明侧的 verbatim C 名对不上。全
      // 单元装载完成后按各单元的 external 声明表返工一遍。
      let extmap = ext_map_units(seq, nil)
      let seq2 = if null?(extmap) {
        seq
      } else {
        ext_refs_seq(seq, extmap)
      }
      cons(seq_forms(seq2, nil), cons(seq2, nil))
    } else {
      cons(nil, cons(nil, err))
    }
  } else {
    cons(nil, cons(nil, aerr))
  }
}

// seq_forms(seq, acc) — flatten the splice sequence back to the flat form
// list (acc threaded in reverse). The flat order is exactly the historical
// splice: a unit's transitive dependencies first, the unit's own forms,
// then the import marker; only the inert position of import markers can
// differ from the old flat list (they are skipped by every pass).
fn seq_forms(seq, acc : List(form.Form)) -> List(form.Form) {
  if null?(seq) {
    reverse(acc)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      seq_forms(cdr(seq), rev_app(cdr(cdr(cdr(e))), acc))
    } else {
      seq_forms(cdr(seq), cons(cdr(e), acc))
    }
  }
}

// resolve_loop processes the main program's forms left-to-right,
// accumulating into 'seq' in REVERSE order. An import splices (in final
// order) the unit's dependency entries, the unit entry, then the import form
// — matching the old flat splice (deps first, own forms last).
// Returns (seq . (visited . err)).
fn resolve_loop(forms : List(form.Form), root, stack, visited, seq, use_ta, with_cov) {
  if null?(forms) {
    cons(seq, cons(visited, nil))
  } else {
    let f = car(forms)
    let rest = cdr(forms)
    if form.is_sym(form.nth(form.items(f), 0), 'import) {
      let ur = ensure_unit(imp_name(f), root, stack, visited, use_ta, with_cov)
      let uerr = cdr(cdr(cdr(ur)))
      if null?(uerr) {
        // dep entries, the unit, then the import form
        let entry = car(ur)
        let seq2 = if null?(entry) {
          // Diamond dependency: already in the program, nothing to splice.
          cons(cons('F, f), seq)
        } else {
          cons(cons('F, f),
          cons(cons('U, entry), rev_app(car(cdr(ur)), seq)))
        }
        let r = resolve_loop(rest, root, stack, car(cdr(cdr(ur))), seq2, use_ta, with_cov)
        cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
      } else {
        cons(nil, cons(car(cdr(cdr(ur))), uerr))
      }
    } else {
      // Non-import form: keep as-is
      let r = resolve_loop(rest, root, stack, visited, cons(cons('F, f), seq), use_ta, with_cov)
      cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
    }
  }
}

// ensure_unit(name, dir, stack, visited, use_ta)
//   -> (entry . (depseq . (visited . err)))
// Loads, parses and namespaces one module unit (exactly once per resolved
// path). entry = (name . (source . ownforms)) — the unit's own qualified
// forms plus the source text the signature cache hashes. depseq is the
// FORWARD-ordered splice of the unit's own transitive dependency entries
// (each dep after its own deps — topo order); nil entry + nil depseq for
// an already-loaded diamond dependency.
fn ensure_unit(name, root, stack, visited, use_ta, with_cov) {
  let found = find_module_path(name, root)
  let ferr = cdr(cdr(found))
  if null?(ferr) == false {
    cons(nil, cons(nil, cons(visited, ferr)))
  } else {
    let path = car(found)
    if null?(car(cdr(found))) {
      cons(nil, cons(nil, cons(visited, not_found_msg(name, path, root))))
    } else {
      if stack_has_path(path, stack) == 1 {
        cons(nil, cons(nil, cons(visited,
        str.concat("error: circular import: ", cycle_chain(stack, name)))))
      } else {
        if loaded_has_path(path, visited) == 1 {
          // Diamond dependency: already in the program, nothing to splice.
          cons(nil, cons(nil, cons(visited, nil)))
        } else {
          let pr = parse_module_content(car(cdr(found)), path, use_ta, with_cov)
          let err = cdr(pr)
          if null?(err) == false {
            cons(nil, cons(nil, cons(visited, err)))
          } else {
            let forms = car(pr)
            let ar = rewrite_unit_aliases(forms)
            let aerr = cdr(ar)
            if null?(aerr) == false {
              cons(nil, cons(nil, cons(visited,
              str.concat(path, str.concat(": ", aerr)))))
            } else {
              let uforms = car(ar)
              let defs = scan_unit_defs(uforms, nil, nil, nil)
              let pubs = car(defs)
              let privs = car(cdr(defs))
              let consts = cdr(cdr(defs))
              // 类型名与构造器和 pub fn 同一 mangle（issue #462）：并进 pubs，
              // 于是 qualify_expr / qualify_pat 对它们的处理与 pub 成员一致。
              let pubs2 = list.append(pubs, unit_type_members(uforms, nil))
              // unit 键 = 写出的名字（唯一形态 ⇒ 唯一拼写）；限定前缀 =
              // 内部名（unit_prefix）。名字就是身份，没有"规范名"。
              let named = qualify_unit_forms(uforms, unit_prefix(name), pubs2, privs, consts)
              let rr = unit_seq_loop(named, root,
              cons(cons(path, name), stack), visited, nil, use_ta, with_cov)
              let rerr = cdr(cdr(rr))
              if null?(rerr) {
                let entry = cons(name, cons(car(cdr(found)), named))
                // record this unit as loaded so later imports of the same
                // resolved path deduplicate (diamond dependencies)
                let visited2 = cons(cons(path, name), car(cdr(rr)))
                cons(entry, cons(car(rr), cons(visited2, nil)))
              } else {
                cons(nil, cons(nil, cons(car(cdr(rr)), rerr)))
              }
            }
          }
        }
      }
    }
  }
}

// ============================================================
// external fn 引用侧 verbatim（issue #433）
// ============================================================
//
// external fn 是 C 符号不是模块成员：声明侧 verbatim（C 全名必须与 VM
// 注册表一致，qualify_unit_form 对 external_fn 走 verbatim 分支）。但引用
// 侧的默认别名改写（collect_aliases）把 <拼写>.<成员> 按目标单元的内部
// 前缀改写成 <unit_prefix>.<成员>——同一个 C 符号两侧两个名字。tinyactor
// 自己的 lib/ 靠 unit_prefix 的 SELF_IDENTITY 例外（前缀 = lib/ 后路径）
// 恰好对上；第三方树的纯 external 声明单元则编译不过（报 has no export）。
//
// 这里在 resolve_loop 之后统一返工：凡引用 <prefix>.<m> 且目标单元声明过
// external <任意点分名>（成员段 = m），改回声明的 verbatim 全名。两个例外
// 都保持原样：(1) m 同时是该单元的 pub fn（pub 语义优先，如 lib/fs.ta 的
// remove 既是 file.remove 的 Result 包装又是引用拼写）；(2) m 不在 external
// 表里（普通 TA 引用，mangle 照旧，跨树同名不冲突的保证不变）。

// unit_ext_members(forms, acc) — 该单元 external fn 声明的
// ((成员符号 . verbatim 全名符号) ...) 列表。成员段 = 声明名第一个点之后
// 的整段（与引用侧 typecheck 的第一点切分一致，multi-dot 声明名也对得上）。
fn unit_ext_members(forms : List(form.Form), acc) {
  if null?(forms) {
    acc
  } else {
    let f = car(forms)
    let items = form.items(f)
    let acc2 = if form.is_sym(form.nth(items, 0), 'external_fn) {
      let n_str = str.sym_to_str(form.sym_at(form.nth(items, 1)))
      let dot = str.index_of(n_str, ".")
      if dot > 0 {
        cons(cons(str.to_sym(str.substr(n_str, dot + 1, str.length(n_str) - dot - 1)),
        cons(form.sym_at(form.nth(items, 1)), nil)), acc)
      } else {
        acc
      }
    } else {
      acc
    }
    unit_ext_members(cdr(forms), acc2)
  }
}

// unit_pub_names(forms, acc) — 该单元已限定名的导出符号列表（qualify_unit_form
// 之后名字 = <prefix>.<成员>；define_pub 的名字在签名对里，const/type-sig
// 的名字直接在第 2 位）。导出成员与 external 同成员名时导出优先：引用该
// 成员拼写的点分名是 TA 导出调用，不是 C 符号。
fn unit_pub_names(forms : List(form.Form), acc) {
  if null?(forms) {
    acc
  } else {
    let f = car(forms)
    let items = form.items(f)
    let acc2 = if form.is_sym(form.nth(items, 0), 'define_pub) {
      cons(sig_name(f), acc)
    } else {
      if form.is_sym(form.nth(items, 0), 'const) || form.is_sym(form.nth(items, 0), 'type-sig) {
        cons(form.sym_at(form.nth(items, 1)), acc)
      } else {
        acc
      }
    }
    unit_pub_names(cdr(forms), acc2)
  }
}

// ext_map_units(seq, acc) — 程序里每个单元一条 (前缀符号 . 成员表)。
fn ext_map_units(seq, acc) {
  if null?(seq) {
    acc
  } else {
    let e = car(seq)
    if car(e) == 'U {
      let members = unit_ext_members(cdr(cdr(cdr(e))), nil)
      if null?(members) {
        ext_map_units(cdr(seq), acc)
      } else {
        ext_map_units(cdr(seq),
        cons(cons(str.to_sym(unit_prefix(car(cdr(e)))),
        cons(members, unit_pub_names(cdr(cdr(cdr(e))), nil))), acc))
      }
    } else {
      ext_map_units(cdr(seq), acc)
    }
  }
}

// ext_ref_sym(s, extmap) -> 符号。点分引用 pfx.m 命中某单元的 external
// 声明且该拼写不是该单元的 pub fn → verbatim 全名；否则原样。
fn ext_ref_sym(s : Symbol, extmap) -> Symbol {
  let s_str = str.sym_to_str(s)
  let dot = str.index_of(s_str, ".")
  if dot > 0 {
    let hit = alist_assoc(str.to_sym(str.substr(s_str, 0, dot)), extmap)
    if null?(hit) {
      s
    } else {
      let mhit = alist_assoc(str.to_sym(str.substr(s_str, dot + 1, str.length(s_str) - dot - 1)), car(cdr(hit)))
      if null?(mhit) {
        s
      } else {
        if sym_in(s, cdr(cdr(hit))) == 1 {
          s
        } else {
          car(cdr(mhit))
        }
      }
    }
  } else {
    s
  }
}

fn ext_ref_walk(e : form.Form, extmap) -> form.Form {
  match e {
    form.FAtom(ast.CSym(s)) -> form.sym(ext_ref_sym(s, extmap))
    form.FAtom(_) -> e
    form.FList(items) -> form.FList(ext_ref_walk_forms(items, extmap))
  }
}

fn ext_ref_walk_forms(forms : List(form.Form), extmap) -> List(form.Form) {
  if null?(forms) {
    nil
  } else {
    cons(ext_ref_walk(car(forms), extmap), ext_ref_walk_forms(cdr(forms), extmap))
  }
}

// ext_refs_seq(seq, extmap) -> seq — 对 seq 里每个单元的 forms（'U）和
// 程序自身的每个 form（'F）做一遍 external 引用返工。'U 条目是非正规表
// ('U name source . forms)——forms 是尾部，不是第 4 个元素。
fn ext_refs_seq(seq, extmap) {
  if null?(seq) {
    nil
  } else {
    let e = car(seq)
    if car(e) == 'U {
      cons(cons('U, cons(car(cdr(e)),
      cons(car(cdr(cdr(e))), ext_ref_walk_forms(cdr(cdr(cdr(e))), extmap)))),
      ext_refs_seq(cdr(seq), extmap))
    } else {
      if car(e) == 'F {
        cons(cons('F, ext_ref_walk(cdr(e), extmap)), ext_refs_seq(cdr(seq), extmap))
      } else {
        cons(e, ext_refs_seq(cdr(seq), extmap))
      }
    }
  }
}

// unit_seq_loop(forms, dir, stack, visited, acc, use_ta)
//   -> (depseq . (visited . err))
// Walks one unit's own forms (in order) collecting ONLY its non-builtin
// import splices: acc (forward order) grows to
//   acc ++ depseq(dep) ++ [('U . dep_entry)]
// per import. The unit's own forms are not part of depseq — they travel in
// the unit's own entry, spliced after depseq by the caller. The units'
// internal import forms stay inside each unit's ownforms (they are inert:
// typecheck skips them, lower-ast drops them at lowering).
fn unit_seq_loop(forms : List(form.Form), root, stack, visited, acc, use_ta, with_cov) {
  if null?(forms) {
    cons(acc, cons(visited, nil))
  } else {
    let f = car(forms)
    if form.is_sym(form.nth(form.items(f), 0), 'import) {
      let ur = ensure_unit(imp_name(f), root, stack, visited, use_ta, with_cov)
      let uerr = cdr(cdr(cdr(ur)))
      if null?(uerr) == false {
        cons(nil, cons(car(cdr(cdr(ur))), uerr))
      } else {
        let entry = car(ur)
        let acc2 = if null?(entry) {
          // diamond dep: its entry is already elsewhere in the program
          acc
        } else {
          list.append(list.append(acc, car(cdr(ur))),
          cons(cons('U, entry), nil))
        }
        unit_seq_loop(cdr(forms), root, stack,
        car(cdr(cdr(ur))), acc2, use_ta, with_cov)
      }
    } else {
      unit_seq_loop(cdr(forms), root, stack, visited, acc, use_ta, with_cov)
    }
  }
}

// ============================================================
// Import contract — see docs/modules.md
//
//   1) 只有一种名字形态：`import "<树名>:<树内路径>"`。名字到文件是**纯函数**
//      （resolve 不接收"导入方目录"）：
//
//        <根>/vendor/<树名>/<路径>.ta        候选恒一条
//
//      没有裸名、没有子路径糖、没有相对形式、没有 `std:`——所以也没有
//      搜索、没有顺序、没有遮蔽。
//   2) 根 = 入口源文件所在目录向上，第一个含 `vendor/` 的祖先目录；一次构建
//      算一次。**不读 $PWD、不读环境变量**：同一个入口文件从任何 cwd 调用都
//      解析到同一棵树（旧设计的 `$PWD` 基准实测会因 cd 报 module not found）。
//      项目要工具链标准库就 `tinyactor init` 建一条普通树链接。
//   3) `as n` 文件本地短名，语法不变；无 `as` 时默认别名 = 名字末段。
//   4) 卫生：段禁空、禁 "." / ".." 点段。违规响亮拒绝
//      （error: invalid module name）。树名就是 vendor/ 下的目录名，没有
//      额外前缀约束——`tinyactor` 与 `example.org/hello` 一样合法。
//   5) 单元键 = **写出的名字**（唯一形态 ⇒ 唯一拼写 ⇒ 一个文件一个名字），
//      于是去重天然成立、限定前缀（unit_prefix）唯一。
//
// 语言不知道「版本」：冲突解决 / fetch / lock 是用户与工具的事。
// ============================================================

// name_unwritable(name)：名字是否含不能直接当引用头的字符（':' '/' '.'）。
// 不可写的名字靠别名（显式 as 或末段默认别名）被引用。
fn name_unwritable(name) {
  if str.index_of(name, ":") >= 0 { 1 }
  else {
    if str.index_of(name, "/") >= 0 { 1 }
    else {
      if str.index_of(name, ".") >= 0 { 1 } else { 0 }
    }
  }
}

fn last_segment(name) {
  let idx = find_last_slash(name, str.length(name) - 1)
  if idx < 0 { name } else { str.substr(name, idx + 1, str.length(name) - idx - 1) }
}

// ============================================================
// 内部限定前缀（mangling，方案已过审：.pge/explore/e2-mangling.md）
//
// 显示名 = import 写出的字符串（错误信息、seq/dep 匹配、sig cache 语义键
// 都用它）；内部前缀 = lowered 限定符号的前缀。写出名可写时原样（既有语料
// 的 lowered 符号零变化）；identity/含点形态压缩为「末段截 24 字符 + ~ +
// 名字 32 位 FNV 哈希十进制」（如 json~1203948576）——长度有界（kl 符号
// 255 上限）、无冒号，且不与 alias_rewrite_sym 的首点切头纠缠。
// 返回 string（qualify_unit_forms 的 mod 参数要 str.concat）；alias 表键值
// 是符号，调用方 collect_aliases 自行 str.to_sym。
fn qual_prefix(name) {
  if name_unwritable(name) == 0 {
    name
  } else {
    let seg = last_segment(name)
    let head = if str.length(seg) > 24 { str.substr(seg, 0, 24) } else { seg }
    str.concat(head, str.concat("~", str.from_int(modsig.str_hash(name))))
  }
}

// 发行版自己的树名。它同时是「工具链标准库」的名字（`tinyactor:lib/str`）
// 与安装树链接名（`tinyactor init` 建 vendor/tinyactor -> 安装根）。改名 = 改
// 身份：要动它必须同时改这里的常量、`tinyactor` 脚本的 SELF_TREE 与全语料。
const SELF_IDENTITY = "tinyactor"

// unit_prefix(name) — 单元成员在 lowered 之后的前缀（内部名）。
//
// 一般规则就是 qual_prefix(名字)（mangle，避免不同树的同名末段互撞）。
// **发行版自己的树是唯一例外**：它的模块用 lib/ 相对名（"str"、
// "bootstrap/parser" 而非 "tinyactor:lib/str"）。这不是第二个身份，
// 而是 C 侧 external fn 的硬约束——`qualify_unit_form` 对 external_fn 走
// verbatim 分支（C 函数名必须和 VM 注册表里的全局名一致，如 "str.trim"），
// 前缀一旦 mangle，声明仍叫 str.trim、引用却被改写成 str~<h>.trim，两边
// 永远对不上（typecheck 报 has no export）。同理 typecheck.ta 里的前置承诺
// （str.concat / file.read / …）也是全局裸名。
// 于是：树内 lib/ 之下的模块前缀 = qual_prefix(lib/ 之后的路径)。
fn unit_prefix(name) {
  let ci = str.index_of(name, ":")
  let ident = str.substr(name, 0, ci)
  let path = str.substr(name, ci + 1, str.length(name) - ci - 1)
  if ident == SELF_IDENTITY && str.index_of(path, "lib/") == 0 {
    qual_prefix(str.substr(path, 4, str.length(path) - 4))
  } else {
    qual_prefix(name)
  }
}

// ---- 卫生检查（check_import_name -> 1 合法 / 0 违规）----

// seg_ok(s, a, b)：段 [a,b) 不能是 "." 或 ".."——点段会被机械拼成
// <root>/vendor/<树>//./x.ta，也就是同一个文件的第二个名字（名字即身份，
// 一个文件一个名字）。非空由调用方保证。
fn seg_ok(s, a, b) {
  if b - a == 1 && str.char_at(s, a) == '.' {
    0
  } else {
    if b - a == 2 && str.char_at(s, a) == '.' && str.char_at(s, a + 1) == '.' {
      0
    } else {
      1
    }
  }
}

// check_segments(s, i, n, seg_start)：'/ 分隔的段全部非空且非 ".."。
fn check_segments(s, i, n, seg_start) {
  if i == n {
    if i == seg_start { 0 } else { seg_ok(s, seg_start, i) }
  } else {
    if str.char_at(s, i) == '/' {
      if i == seg_start { 0 }
      else {
        if seg_ok(s, seg_start, i) == 1 {
          check_segments(s, i + 1, n, i + 1)
        } else {
          0
        }
      }
    } else {
      check_segments(s, i + 1, n, seg_start)
    }
  }
}

// check_import_name 见下：段规则只剩「非空、非点段」。
// check_import_name(name)：整体卫生。名字**必须**写成 "<树名>:<路径>"——
// 裸名没有候选（§1 唯一形态），所以裸名本身就是违规名。其余：空段 / ".."
// 段 / 第二个 ':'，全部拒绝。
fn check_import_name(name) {
  let n = str.length(name)
  let ci = str.index_of(name, ":")
  if n == 0 || ci <= 0 { 0 }
  else {
    let ident = str.substr(name, 0, ci)
    let path = str.substr(name, ci + 1, n - ci - 1)
    if str.length(path) == 0 || str.index_of(path, ":") >= 0 { 0 }
    else {
      if check_segments(ident, 0, str.length(ident), 0) == 1 {
        check_segments(path, 0, str.length(path), 0)
      } else {
        0
      }
    }
  }
}

// module_file(name, root) — 名字到路径的**全部**规则：机械拼接，候选恒一条。
//   名字 = <树名>:<树内路径>          （省略 .ta）
//   文件 = <根>/vendor/<树名>/<树内路径>.ta
fn module_file(name, root) {
  let ci = str.index_of(name, ":")
  str.concat(root, str.concat("/vendor/",
  str.concat(str.substr(name, 0, ci), str.concat("/",
  str.concat(str.substr(name, ci + 1, str.length(name) - ci - 1), ".ta")))))
}

// find_module_path(name, root) -> (path . (content . err))。
// err 非 nil = 名字违规（卫生规则），此时 path/content 为 nil；
// 名字合法但文件不存在时 path 有值、content 为 nil（ensure_unit 据此报
// "module not found" 并摊开那一拼）。
// 命中判据 = 一次 file.read：没有 exists 探测、没有候选列表、没有顺序。
fn find_module_path(name, root) {
  if check_import_name(name) == 0 {
    cons(nil, cons(nil, str.concat("error: invalid module name: ", name)))
  } else {
    let path = module_file(name, root)
    cons(path, cons(file.read(path), nil))
  }
}

// ============================================================
// 根 —— 模块解析的基准
//
// 根 = 入口源文件所在目录向上，第一个含 vendor/ 的祖先目录（一次构建算
// 一次）。这不是配置项：**不读 $PWD、不读环境变量**，于是同一个入口文件从
// 任何 cwd 调用都解析到同一棵树。要工具链标准库就在项目里 `tinyactor init`
// 建一条普通树链接（vendor/<树名> -> <安装根>）。
//
// 找不到根不在这里报错：纯计算程序不需要 vendor/，由调用方在"真有 import"
// 时才拒绝（见 need_root）。
// ============================================================

fn find_root(dir) {
  if str.length(dir) == 0 { "" }
  else {
    // file.exists 走 typecheck 的 bootstrap 承诺：String -> Int，不是 Bool。
    if file.exists(str.concat(dir, "/vendor")) == 1 { dir }
    else {
      let up = dirname(dir)
      if up == dir { "" } else { find_root(up) }
    }
  }
}

// has_import(forms)：入口文件自身有没有顶层 import。没有 import 的程序不
// 需要根（也没有任何单元会被加载），所以"没有 vendor/"只在有 import 时才
// 是错误。
fn has_import(forms : List(form.Form)) {
  if null?(forms) { 0 }
  else {
    if form.is_sym(form.nth(form.items(car(forms)), 0), 'import) { 1 }
    else { has_import(cdr(forms)) }
  }
}

// need_root(src, forms)：解析根；有 import 却没根时返回错误串（§8 的三行
// 报告），否则 nil。
fn need_root(src, forms : List(form.Form)) {
  let root = find_root(dirname(src))
  if str.length(root) > 0 {
    cons(root, nil)
  } else {
    if has_import(forms) == 0 {
      cons("", nil)
    } else {
      cons(nil, str.concat(str.concat("error: no vendor/ directory above ", src),
      str.concat("\n  module names resolve as <root>/vendor/<tree>/<path>.ta",
      str.concat("\n  searched upward from: ", str.concat(dirname(src),
      "\n  run `tinyactor init` in your project to create one")))))
    }
  }
}

// not_found_msg(name, path, root)：模块不存在时把那一拼摊开（§8）。
fn not_found_msg(name, path, root) {
  str.concat(str.concat("error: module not found: ", name),
  str.concat("\n  tried: ", str.concat(path,
  str.concat("\n  root:  ", str.concat(root, "   (vendor/ here)")))))
}

fn stack_has_path(path, stack) {
  if null?(stack) { 0 }
  else {
    if car(car(stack)) == path { 1 }
    else { stack_has_path(path, cdr(stack)) }
  }
}

fn loaded_has_path(path, visited) {
  if null?(visited) { 0 }
  else {
    if car(car(visited)) == path { 1 }
    else { loaded_has_path(path, cdr(visited)) }
  }
}

// stack is innermost-first; the message walks outermost -> innermost -> name.
fn cycle_chain(stack, name) {
  chain_join(list.append(stack_names(stack, nil), cons(name, nil)))
}

fn stack_names(stack, acc) {
  if null?(stack) { acc }
  else { stack_names(cdr(stack), cons(cdr(car(stack)), acc)) }
}

fn chain_join(names) {
  if null?(names) { "" }
  else {
    if null?(cdr(names)) { car(names) }
    else { str.concat(car(names), str.concat(" -> ", chain_join(cdr(names)))) }
  }
}

// ============================================================
// Alias rewriting (`import foo as f`)
// ============================================================

// collect_aliases(forms, acc) — 单元自己顶层 import 的「可用拼写 -> 目标」
// 表。键 = 源码里能写的引用头（显式 `as` 或默认别名 = 名字末段），
// 值 = (限定前缀 . 写出名)：前缀是别名改写的目标（与成员定义侧一致），
// 写出名留给「真实名不可用」的判据（alias_rewrite_sym）。
// 一次 import 只有一个可用拼写（issue #96 Phase B）。
fn collect_aliases(forms : List(form.Form), acc) {
  if null?(forms) { acc }
  else {
    let f = car(forms)
    if form.is_sym(form.nth(form.items(f), 0), 'import) {
      let name = imp_name(f)
      if form.is_nil_form(form.nth(form.items(f), 2)) {
        collect_aliases(cdr(forms), acc)
      } else {
        let alias = imp_alias(f)
        let pair = cons(str.to_sym(unit_prefix(name)), name)
        if alias == name {
          // 没有 `as`：名字不可写时默认别名 = 末段；可写名（合法名字里不
          // 会出现——名字必含 ':'）自带前缀，无需改写。
          if name_unwritable(name) == 1 {
            collect_aliases(cdr(forms), cons(cons(str.to_sym(last_segment(name)), pair), acc))
          } else {
            collect_aliases(cdr(forms), acc)
          }
        } else {
          collect_aliases(cdr(forms), cons(cons(str.to_sym(alias), pair), acc))
        }
      }
    } else {
      collect_aliases(cdr(forms), acc)
    }
  }
}

// rewrite_unit_aliases(forms, dir) -> (forms . err)
// Rewrites alias-qualified references (f.bar -> foo.bar) throughout the
// unit. Import forms themselves are not rewritten. Using the real name of
// an aliased module is rejected so exactly one spelling is live per file.
fn rewrite_unit_aliases(forms : List(form.Form)) {
  let aliases = collect_aliases(forms, nil)
  if null?(aliases) {
    cons(forms, nil)
  } else {
    alias_walk_forms(forms, aliases)
  }
}

// alias_walk(e, aliases) -> (e . err)
fn alias_walk(e : form.Form, aliases) {
  match e {
    form.FAtom(ast.CSym(s)) -> {
      // alias_rewrite_sym 换的是**符号**，回填时必须包回 FAtom 原子，否则
      // 树上会混进裸符号（form 层里裸符号不是节点）。
      let r = alias_rewrite_sym(s, aliases)
      if null?(cdr(r)) == false {
        cons(e, cdr(r))
      } else {
        cons(form.sym(car(r)), nil)
      }
    }
    form.FAtom(_) -> cons(e, nil)
    form.FList(items) -> {
      let r = alias_walk_forms(items, aliases)
      cons(form.FList(car(r)), cdr(r))
    }
  }
}

// alias_walk_forms(forms, aliases) -> (forms . err) — 逐个 form 走
// alias_walk；第一个错误胜出。import form 自己不改写。
fn alias_walk_forms(forms : List(form.Form), aliases) {
  if null?(forms) {
    cons(nil, nil)
  } else {
    let f = car(forms)
    let r1 = if form.is_sym(form.nth(form.items(f), 0), 'import) {
      cons(f, nil)
    } else {
      alias_walk(f, aliases)
    }
    if null?(cdr(r1)) == false {
      cons(nil, cdr(r1))
    } else {
      let r2 = alias_walk_forms(cdr(forms), aliases)
      if null?(cdr(r2)) == false {
        cons(nil, cdr(r2))
      } else {
        cons(cons(car(r1), car(r2)), nil)
      }
    }
  }
}

// alias_rewrite_sym(s, aliases) -> (s . err)
// Dotted symbol `pfx.rest`: pfx an alias -> rewrite to real.rest;
// pfx the real name of an aliased module -> error.
fn alias_rewrite_sym(s : Symbol, aliases) {
  let s_str = str.sym_to_str(s)
  let dot = str.index_of(s_str, ".")
  if dot <= 0 {
    cons(s, nil)
  } else {
    let pfx = str.substr(s_str, 0, dot)
    let hit = alist_assoc(str.to_sym(pfx), aliases)
    if null?(hit) == false {
      let rest = str.substr(s_str, dot, str.length(s_str) - dot)
      cons(str.to_sym(str.concat(str.sym_to_str(car(cdr(hit))), rest)), nil)
    } else {
      if aliased_real_pfx(pfx, aliases) == 1 {
        cons(nil, str.concat("error: module '", str.concat(pfx, str.concat("' is imported under an alias in this file; the real name is not usable here ('", str.concat(s_str, "')")))))
      } else {
        cons(s, nil)
      }
    }
  }
}

// aliased_real_pfx(pfx, aliases)：pfx 是不是某个「已被别名占用」的模块的
// 真实名。判据比**名字末段**（= 默认别名，也就是读者会误写的那个拼写）：
// 全名拼写（"<树名>:<路径>"）下真实名本身写不进源码——点号会把引用头切在
// 第一段上——所以末段才是唯一现实的误写方式。与 collect_aliases 生成默认
// 别名用的规则同源，于是「一个文件一个拼写」与拼写形式无关。
fn aliased_real_pfx(pfx, aliases) {
  if null?(aliases) { 0 }
  else {
    if last_segment(cdr(cdr(car(aliases)))) == pfx { 1 }
    else { aliased_real_pfx(pfx, cdr(aliases)) }
  }
}

fn alist_assoc(key, lst) {
  if null?(lst) { nil }
  else {
    if car(car(lst)) == key { car(lst) }
    else { alist_assoc(key, cdr(lst)) }
  }
}

// ============================================================
// Unit namespacing (rename + internal reference qualification)
// ============================================================

// scan_unit_defs(forms, pubs, privs, consts) -> (pubs . (privs . consts))
// Bare names defined at this unit's top level, per visibility.
fn scan_unit_defs(forms : List(form.Form), pubs, privs, consts) {
  if null?(forms) {
    cons(pubs, cons(privs, consts))
  } else {
    let f = car(forms)
    let head = form.nth(form.items(f), 0)
    if form.is_sym(head, 'define_pub) {
      scan_unit_defs(cdr(forms), cons(sig_name(f), pubs), privs, consts)
    } else {
      if form.is_sym(head, 'define) {
        scan_unit_defs(cdr(forms), pubs, cons(sig_name(f), privs), consts)
      } else {
        if form.is_sym(head, 'const) {
          scan_unit_defs(cdr(forms), pubs, privs,
          cons(form.sym_at(form.nth(form.items(f), 1)), consts))
        } else {
          scan_unit_defs(cdr(forms), pubs, privs, consts)
        }
      }
    }
  }
}

// unit_type_members(forms, acc) — 本单元 `type` 声明的成员名：类型名 + 全部
// 构造器名。两者与 pub fn / const 同一条 mangle（mod.Name），所以 qualify 时
// 直接并进 pubs 一起判定：本模块内写 `Some` / `Option(Int)` 都会被重写成
// `option.Some` / `option.Option`（issue #462）。
fn unit_type_members(forms : List(form.Form), acc) {
  if null?(forms) {
    acc
  } else {
    let f = car(forms)
    let items = form.items(f)
    let acc2 = if form.is_sym(form.nth(items, 0), 'type) {
      // (type Name <参数槽> 变体…)——变体从第 4 个元素起到尾
      ctor_names(cdr(cdr(cdr(items))), cons(form.sym_at(form.nth(items, 1)), acc))
    } else {
      acc
    }
    unit_type_members(cdr(forms), acc2)
  }
}

// ctor_names(variants, acc) — 变体表里的构造器名：nullary 是 (quote V)，
// n-ary 是 (Ctor f1 f2 ...)。
fn ctor_names(variants : List(form.Form), acc) {
  if null?(variants) {
    acc
  } else {
    let items = form.items(car(variants))
    let name = if form.is_sym(form.nth(items, 0), 'quote) {
      form.sym_at(form.nth(items, 1))
    } else {
      form.sym_at(form.nth(items, 0))
    }
    ctor_names(cdr(variants), cons(name, acc))
  }
}

// qualify_unit_forms — rename each define/define_pub/const/type-sig name to
// its namespaced form and qualify the unit's own bare references in the
// renamed definitions' bodies.
fn qualify_unit_forms(forms : List(form.Form), mod, pubs, privs, consts) {
  if null?(forms) { nil }
  else {
    cons(qualify_unit_form(car(forms), mod, pubs, privs, consts),
    qualify_unit_forms(cdr(forms), mod, pubs, privs, consts))
  }
}

// 每个成员定义重建为「换掉名字槽 + 限定体」的同形 form；名字槽的**形状**
// 原样透传（签名表只换首元素，external_fn 的 C 名 / type 的参数槽不动）。
fn qualify_unit_form(f : form.Form, mod, pubs, privs, consts) -> form.Form {
  match f {
    form.FAtom(_) -> f
    form.FList(items) -> {
      let head = form.nth(items, 0)
      let rest = cdr(items)
      if form.is_sym(head, 'define) {
        let sig = form.nth(rest, 0)
        let newname = rename_member_name(sig_name(f), mod, privs)
        // 签名表 (name args…) 的**参数**是首元素之后那段：名字本身不是绑定
        // （递归调用要照常限定成 mod$name）。
        let newbody = qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts,
        form.syms(cdr(form.items(sig))))
        form.lst(cons(head, cons(form.FList(cons(form.sym(newname), cdr(form.items(sig)))),
        cons(newbody, nil))))
      } else {
        if form.is_sym(head, 'define_pub) {
          let sig = form.nth(rest, 0)
          let newname = str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(sig_name(f)))))
          let newbody = qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts,
          form.syms(cdr(form.items(sig))))
          form.lst(cons(head, cons(form.FList(cons(form.sym(newname), cdr(form.items(sig)))),
          cons(newbody, nil))))
        } else {
          if form.is_sym(head, 'const) {
            form.lst(cons(head, cons(form.sym(qualify_name(form.sym_at(form.nth(rest, 0)), mod)),
            cons(qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts, nil), nil))))
          } else {
            if form.is_sym(head, 'type-sig) {
              // keep name in lockstep with the renamed definition it annotates;
              // 注解里的类型同样要限定（`Option(Int)` -> `option.Option(Int)`）
              let newname = rename_member_name(form.sym_at(form.nth(rest, 0)), mod, privs)
              form.lst(cons(head, cons(form.sym(newname),
              qualify_forms(cdr(rest), mod, pubs, privs, consts, nil))))
            } else {
              if form.is_sym(head, 'type) {
                form.lst(cons(head, cons(form.sym(qualify_name(form.sym_at(form.nth(rest, 0)), mod)),
                cons(form.nth(rest, 1),
                qualify_variants(cdr(cdr(rest)), mod, pubs, privs, consts)))))
              } else {
                if form.is_sym(head, 'external_fn) {
                  // C 符号名 verbatim（必须与 VM 注册表一致），注解照常限定
                  form.lst(cons(head, cons(form.nth(rest, 0),
                  qualify_forms(cdr(rest), mod, pubs, privs, consts, nil))))
                } else {
                  // import: verbatim
                  f
                }
              }
            }
          }
        }
      }
    }
  }
}

// qualify_name(name, mod) — 成员在 mod 里的全名 mod.name（pub fn / const /
// 类型 / 构造器共用这一种拼写：issue #462 的「一套 mangle」）。
fn qualify_name(name, mod) {
  str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(name))))
}

// upper_first(s) — 符号首字母是否大写（本模块的裸构造器/类型名都这样拼）。
fn upper_first(s) {
  let c = str.char_at(str.sym_to_str(s), 0)
  if c >= 65 { if c <= 90 { 1 } else { 0 } } else { 0 }
}

// qualify_variants(variants, ...) — 变体表：类型名与构造器名各自限定，字段
// 类型里的本模块裸类型名一并限定（字段类型走 qualify_expr，字段标签原样
// 保留：标签是声明里的名字，不是引用）。
fn qualify_variants(variants : List(form.Form), mod, pubs, privs, consts) -> List(form.Form) {
  if null?(variants) {
    nil
  } else {
    let items = form.items(car(variants))
    if form.is_sym(form.nth(items, 0), 'quote) {
      // nullary: (quote V)
      cons(form.lst(cons(form.nth(items, 0),
      cons(form.sym(qualify_name(form.sym_at(form.nth(items, 1)), mod)), nil))),
      qualify_variants(cdr(variants), mod, pubs, privs, consts))
    } else {
      // n-ary: (Ctor (label type) ...)
      cons(form.lst(cons(form.sym(qualify_name(form.sym_at(form.nth(items, 0)), mod)),
      qualify_fields(cdr(items), mod, pubs, privs, consts))),
      qualify_variants(cdr(variants), mod, pubs, privs, consts))
    }
  }
}

// qualify_fields(fields, ...) — 每个字段是 (label type)：标签是声明处的
// 名字（nil = 未标注），留在原地；类型是引用，照常限定。
fn qualify_fields(fields : List(form.Form), mod, pubs, privs, consts) -> List(form.Form) {
  if null?(fields) {
    nil
  } else {
    let items = form.items(car(fields))
    cons(form.lst(cons(form.nth(items, 0),
    cons(qualify_expr(form.nth(items, 1), mod, pubs, privs, consts, nil), nil))),
    qualify_fields(cdr(fields), mod, pubs, privs, consts))
  }
}

// rename_member_name — non-pub members take the mod$name form (invisible to
// qualified syntax), pub members mod.name.
fn rename_member_name(name, mod, privs) {
  if sym_in(name, privs) == 1 {
    str.to_sym(str.concat(mod, str.concat("$", str.sym_to_str(name))))
  } else {
    str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(name))))
  }
}

// qualify_expr(e, mod, pubs, privs, consts, bound) — rewrite bare references
// to the unit's own definitions into their namespaced names. Scope-aware,
// mirroring lower-ast.resolve_consts: lambda params, let bindings and
// match/receive pattern binders shadow member names. Quoted symbols are
// rewritten only when they are const references or own constructors/type
// names (`Some`, `Option` parse as (quote Name)); other quoted data is left
// alone.
fn qualify_expr(e : form.Form, mod, pubs, privs, consts, bound) -> form.Form {
  match e {
    form.FAtom(ast.CSym(s)) -> form.sym(qualify_sym(s, mod, pubs, privs, consts, bound))
    form.FAtom(_) -> e
    form.FList(items) -> qualify_form(items, mod, pubs, privs, consts, bound)
  }
}

// qualify_sym(s, ...) — 裸符号引用：bound 里的原样；点分名（已限定 / builtin）
// 原样；本单元自己的 priv / pub / const 成员换成限定名。
fn qualify_sym(s : Symbol, mod, pubs, privs, consts, bound) -> Symbol {
  if sym_in(s, bound) == 1 {
    s
  } else {
    let s_str = str.sym_to_str(s)
    if str.index_of(s_str, ".") >= 0 {
      // already qualified (or builtin dotted): not a bare member ref
      s
    } else {
      if sym_in(s, privs) == 1 {
        str.to_sym(str.concat(mod, str.concat("$", s_str)))
      } else {
        if sym_in(s, pubs) == 1 {
          str.to_sym(str.concat(mod, str.concat(".", s_str)))
        } else {
          if sym_in(s, consts) == 1 {
            str.to_sym(str.concat(mod, str.concat(".", s_str)))
          } else {
            s
          }
        }
      }
    }
  }
}

// qualify_form(items, ...) — 一个列表 form：特殊构造按语义处理（只限定其中
// 是**引用**的槽），其余按「逐元素限定」（首元素也是引用）。
fn qualify_form(items : List(form.Form), mod, pubs, privs, consts, bound) -> form.Form {
  let head = form.nth(items, 0)
  let rest = cdr(items)
  if form.is_sym(head, 'quote) {
    qualify_quoted(items, mod, pubs, privs, consts)
  } else {
    if form.is_sym(head, 'lambda) {
      // ('lambda params body ret_type) — the ret_type slot is optional
      // (the `use` desugar builds (lambda (x) rest) without one), so it is
      // read nil-safely.
      let params = form.parse_params(form.nth(rest, 0))
      form.lst(cons(head, cons(form.nth(rest, 0),
      cons(qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts, list.append(params, bound)),
      cons(form.nth(rest, 2), nil)))))
    } else {
      if form.is_sym(head, 'let) {
        qualify_let(head, rest, mod, pubs, privs, consts, bound)
      } else {
        if form.is_sym(head, 'match) {
          form.lst(cons(head, cons(qualify_expr(form.nth(rest, 0), mod, pubs, privs, consts, bound),
          qualify_arms(cdr(rest), mod, pubs, privs, consts, bound))))
        } else {
          if form.is_sym(head, 'receive) {
            form.lst(cons(head, qualify_arms(rest, mod, pubs, privs, consts, bound)))
          } else {
            if form.is_sym(head, 'ctor.labels) {
              // ('ctor.labels (quote R) base assigns)：构造器名走 quote 分支，
              // base 与字段值是引用，照常限定；**标签原样保留**——标签是
              // 声明处的字段名，不是本模块的成员引用（同名私有函数存在时
              // 也不能被改写成 mod$x）。
              form.lst(cons(head, cons(qualify_expr(form.nth(rest, 0), mod, pubs, privs, consts, bound),
              cons(qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts, bound),
              cons(form.lst(qualify_assigns(form.items(form.nth(rest, 2)), mod, pubs, privs, consts,
              bound)), nil)))))
            } else {
              form.lst(qualify_forms(items, mod, pubs, privs, consts, bound))
            }
          }
        }
      }
    }
  }
}

// qualify_forms(forms, ...) — 逐个 form 限定（列表形式的「逐元素限定」）。
fn qualify_forms(forms : List(form.Form), mod, pubs, privs, consts, bound) -> List(form.Form) {
  if null?(forms) {
    nil
  } else {
    cons(qualify_expr(car(forms), mod, pubs, privs, consts, bound),
    qualify_forms(cdr(forms), mod, pubs, privs, consts, bound))
  }
}

// qualify_quoted(items, ...) — (quote inner)：inner 是 const 引用或本模块的
// 构造器/类型名时就地限定（构造器的值与标签都是 (quote Name) 形状，和 const
// 同一片语法，issue #462）；其余 quoted 数据不动。
fn qualify_quoted(items : List(form.Form), mod, pubs, privs, consts) -> form.Form {
  match form.nth(cdr(items), 0) {
    form.FAtom(ast.CSym(inner)) -> {
      if sym_in(inner, consts) == 1 || (upper_first(inner) == 1 && sym_in(inner, pubs) == 1) {
        form.lst(cons(form.nth(items, 0), cons(form.sym(qualify_name(inner, mod)), nil)))
      } else {
        form.lst(items)
      }
    }
    _ -> form.lst(items)
  }
}

// qualify_let(head, rest, ...) — ('let …) 的三种形状：单绑定 (let var init
// rest)、扁平块级 3 元素 (let var expr)、多绑定 (let ((v1 e1)…) body…)。
fn qualify_let(head : form.Form, rest : List(form.Form), mod, pubs, privs, consts,
bound) -> form.Form {
  let b = form.nth(rest, 0)
  match b {
    // nil：没有绑定表的 let，原样
    form.FAtom(ast.CNil) -> form.lst(cons(head, rest))
    form.FAtom(ast.CSym(v)) -> {
      // var scopes over rest only. A flat block-level `let` has no rest slot
      // yet (parser emits the 3-element (let var expr)); nth yields nil for
      // the missing slot instead of reading past the end of the form.
      form.lst(cons(head, cons(b,
      cons(qualify_expr(form.nth(rest, 1), mod, pubs, privs, consts, bound),
      cons(qualify_expr(form.nth(rest, 2), mod, pubs, privs, consts, cons(v, bound)), nil)))))
    }
    form.FList(bs) -> {
      // multi-binding let: ((v1 e1) (v2 e2) ...) then body forms;
      // later initializers see earlier binders (let* order).
      let br = qualify_bindings(bs, mod, pubs, privs, consts, bound)
      form.lst(cons(head, cons(car(br),
      qualify_forms(cdr(rest), mod, pubs, privs, consts, cdr(br)))))
    }
    _ -> form.lst(cons(head, rest))
  }
}
// qualify_assigns(assigns, ...) — ((label expr) ...)：只限定值。
// 必须保持正规 2-list：typecheck 的 collect_let_bindings 预扫描是**按列表**
// 遍历 form 树，点对 `(label . expr)` 会让它把表达式当列表 `car`（源码里写不出
// 点对，所以整棵树要么全是列表、要么是这里造的谎）。
fn qualify_assigns(assigns : List(form.Form), mod, pubs, privs, consts, bound) -> List(form.Form) {
  if null?(assigns) {
    nil
  } else {
    let items = form.items(car(assigns))
    cons(form.lst(cons(form.nth(items, 0),
    cons(qualify_expr(form.nth(items, 1), mod, pubs, privs, consts, bound), nil))),
    qualify_assigns(cdr(assigns), mod, pubs, privs, consts, bound))
  }
}

// qualify_bindings(bs, ...) -> (new_bindings . bound_with_all_vars)
fn qualify_bindings(bs : List(form.Form), mod, pubs, privs, consts, bound) {
  if null?(bs) {
    cons(nil, bound)
  } else {
    let items = form.items(car(bs))
    let v = form.sym_at(form.nth(items, 0))
    let new_init = qualify_expr(form.nth(items, 1), mod, pubs, privs, consts, bound)
    let rest = qualify_bindings(cdr(bs), mod, pubs, privs, consts, cons(v, bound))
    cons(form.lst(cons(form.nth(items, 0), cons(new_init, nil))), cons(car(rest), cdr(rest)))
  }
}

// qualify_arms — pattern binders scope over the guard and body of their arm;
// the pattern's constructor tags are qualified (qualify_pat), its binders are
// a declaration region and stay bare.
fn qualify_arms(arms : List(form.Form), mod, pubs, privs, consts, bound) -> List(form.Form) {
  if null?(arms) { nil }
  else {
    let items = form.items(car(arms))
    let pat = qualify_pat(form.nth(items, 0), mod, pubs, privs, consts)
    let nb = list.append(pat_binders(pat, nil), bound)
    let new_arm = if null?(cdr(cdr(items))) {
      // (pat body)
      form.lst(cons(pat, cons(qualify_expr(form.nth(items, 1), mod, pubs, privs, consts, nb), nil)))
    } else {
      // (pat guard body)
      form.lst(cons(pat, cons(qualify_expr(form.nth(items, 1), mod, pubs, privs, consts, nb),
      cons(qualify_expr(form.nth(items, 2), mod, pubs, privs, consts, nb), nil))))
    }
    cons(new_arm, qualify_arms(cdr(arms), mod, pubs, privs, consts, bound))
  }
}

// qualify_pat(pat, ...) — 模式里的构造器标签限定。模式与值同形
// （mk_ctor_form），标签也是 (quote Name)：值侧的标签（qualify_expr）已经
// 变成 mod.Name，模式侧不跟着改就永远对不上。裸符号是绑定变量，原样保留。
fn qualify_pat(pat : form.Form, mod, pubs, privs, consts) -> form.Form {
  match pat {
    form.FAtom(_) -> pat
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'quote) {
        match form.nth(cdr(items), 0) {
          form.FAtom(ast.CSym(inner)) -> {
            if upper_first(inner) == 1 && sym_in(inner, pubs) == 1 {
              form.lst(cons(form.nth(items, 0), cons(form.sym(qualify_name(inner, mod)), nil)))
            } else {
              pat
            }
          }
          _ -> pat
        }
      } else {
        form.lst(qualify_pat_forms(items, mod, pubs, privs, consts))
      }
    }
  }
}

fn qualify_pat_forms(forms : List(form.Form), mod, pubs, privs, consts) -> List(form.Form) {
  if null?(forms) {
    nil
  } else {
    cons(qualify_pat(car(forms), mod, pubs, privs, consts),
    qualify_pat_forms(cdr(forms), mod, pubs, privs, consts))
  }
}

// pat_binders(pat, acc) — bare symbols in a pattern are binders; quoted
// names (constructors, literals) bind nothing. Mirrors lower-ast's
// collect_pattern_bindings.
fn pat_binders(pat : form.Form, acc) -> List(Symbol) {
  match pat {
    form.FAtom(ast.CSym(s)) -> cons(s, acc)
    form.FAtom(_) -> acc
    form.FList(items) -> {
      if form.is_sym(form.nth(items, 0), 'quote) { acc }
      else { pat_binders_forms(items, acc) }
    }
  }
}

// pat_binders_forms(forms, acc) — 表里每个 form 的绑定变量（acc 序无关，
// 只用于 sym_in 的成员判定）。
fn pat_binders_forms(forms : List(form.Form), acc) -> List(Symbol) {
  if null?(forms) { acc }
  else { pat_binders_forms(cdr(forms), pat_binders(car(forms), acc)) }
}

fn sym_in(x, lst) {
  if null?(lst) { 0 }
  else {
    if car(lst) == x { 1 }
    else { sym_in(x, cdr(lst)) }
  }
}

// === Compilation pipeline ===

// typecheck_report — tc 的完整报告文本：首行 "typecheck: N type error(s)
// found"，随后 [E00xx] 明细行（含 E0005 non-exhaustive——负例 expect 的
// 文案只在这里出现）。返回字符串而非直接 print：失败路径要把报告与阶段
// 名合成**一条**消息一次写出——file.write 是 truncate-on-open，一条失败
// 拆成多次写 /dev/stderr（或写进与 stdout 合并的捕获文件）会互相清空
// （issue #275「报告静默」的根因，见 die_msg）。
pub fn typecheck_report(tc, src, disp) {
  let errors = typecheck.get_errors(tc)
  if null?(errors) {
    ""
  } else {
    str.concat(str.concat("typecheck: ", str.concat(str.from_int(typecheck.count_errors(tc)), " type error(s) found\n")), tc_errors_text(errors, src, nil, cons(disp, short_disp(disp))))
  }
}

// disp_names(seq, acc) — ((内部前缀 . import 写出名) ...)（#425/#424）。
// 诊断渲染用它把 mangle 过的单元前缀反查回用户在 import 行写出的全名，
// 内部名（qual_prefix 的哈希拼写）一律不进给人看的输出。
fn disp_names(seq, acc) {
  if null?(seq) {
    acc
  } else {
    let e = car(seq)
    let acc2 = if car(e) == 'U {
      cons(cons(str.to_sym(unit_prefix(car(cdr(e)))), car(cdr(e))), acc)
    } else {
      acc
    }
    disp_names(cdr(seq), acc2)
  }
}

// 诊断渲染用的 disp 是**一对**表：(全名表 . 短名表)，键都是内部前缀符号。
//   全名表 = import 行写出的全名 —— 「这是哪个模块」用（E0004 的 not-exported
//            / no-export，用户可能要照着它去补 import 行）；
//   短名表 = 全名的末段（默认别名）—— fix-it 建议和类型显示用，因为那是用户
//            **能写出来**的拼写。
// 短名表由长表派生（short_disp），不单独维护第二份来源。
fn short_name(path) {
  let i = str.index_of(path, "/")
  if i < 0 {
    path
  } else {
    short_name(str.substr(path, i + 1, str.length(path) - i - 1))
  }
}

fn short_disp(disp) {
  if null?(disp) {
    nil
  } else {
    cons(cons(car(car(disp)), short_name(cdr(car(disp)))), short_disp(cdr(disp)))
  }
}

// disp_mod(modsym, disp) — 模块名渲染：命中反查表打写出名，
// 否则（表拿不到，如单元外路径）原样。键是内部前缀符号。
fn disp_mod(modsym, tbl) {
  let hit = alist_assoc(modsym, tbl)
  if null?(hit) {
    str.sym_to_str(modsym)
  } else {
    cdr(hit)
  }
}

// join_members(syms, sep, tbl) -> "A, B, C"
// 列表里的符号是内部拼写（`前缀.成员`），先反 mangle 成 `短名.成员` 再拼：
// E0005 的 missing / partial 列表也是给人看的（#462 P4 review）。
// tbl 是本文件的短名表（disp 的 cdr），与 E0004 fix-it 共用同一张。
fn join_members(syms, sep, tbl) {
  if null?(syms) {
    ""
  } else {
    if null?(cdr(syms)) {
      str.sym_to_str(typecheck.disp_member(car(syms), tbl))
    } else {
      str.concat(str.sym_to_str(typecheck.disp_member(car(syms), tbl)),
      str.concat(sep, join_members(cdr(syms), sep, tbl)))
    }
  }
}

// disp = (全名表 . 短名表)（见 typecheck_report）：说明「哪个模块」用全名，
// fix-it 建议和类型显示用短名。
fn tc_errors_text(errors, src, used, disp) {
  match errors {
    nil -> ""
    cons(err, rest) -> {
      // err = (kind . (ctx . payload)); kind is 'mismatch or 'undefined
      let kind = car(err)
      let ctx = car(cdr(err))
      // ctx is a symbol (fn name) or nested (ctx . detail) pairs: the chain
      // root is the function name; each cdr is a detail symbol like
      // "arg 2 of helper" describing the failing site, innermost last.
      let name = str.sym_to_str(ctx_root_name(ctx))
      let details = ctx_detail_list(ctx, nil)
      let detail = if null?(details) { nil } else { str.sym_to_str(list_last(details)) }
      let line = find_fn_line(src, name)
      let loc = if line > 0 {
        str.concat("in function '", str.concat(name, str.concat("' (line ", str.concat(str.from_int(line), "): "))))
      } else {
        str.concat("in function '", str.concat(name, "': "))
      }
      let ehead = if kind == 'mismatch {
        let t1 = car(cdr(cdr(err)))
        let t2 = car(cdr(cdr(cdr(err))))
        let msg = str.concat("cannot unify ", str.concat(typecheck.type_format(t1, nil, cdr(disp)), str.concat(" with ", typecheck.type_format(t2, nil, cdr(disp)))))
        let full = if null?(detail) { msg } else { str.concat(detail, str.concat(": ", msg)) }
        str.concat("  [E0001] ", str.concat(loc, full))
      } else {
        if kind == 'arity {
          // payload = (name . (got . (want . nil))): a builtin called with
          // the wrong number of arguments — Direction B, rejected at
          // compile time so it never reaches the VM.
          let bname = str.sym_to_str(car(cdr(cdr(err))))
          let got = car(cdr(cdr(cdr(err))))
          let want = car(cdr(cdr(cdr(cdr(err)))))
          let msg = str.concat("wrong number of arguments for '", str.concat(bname, str.concat("' (got ", str.concat(str.from_int(got), str.concat(", want ", str.concat(str.from_int(want), ")"))))))
          let full = if null?(detail) { msg } else { str.concat(detail, str.concat(": ", msg)) }
          str.concat("  [E0003] ", str.concat(loc, full))
        } else {
          if kind == 'undefined-var {
            // payload = (name . nil): a variable reference with no binding
            // at all (issue #81) — not a param, not a let in scope, not a
            // builtin/outer define.
            let vname = str.sym_to_str(car(cdr(cdr(err))))
            str.concat("  [E0002] ", str.concat(loc, str.concat("undefined variable '", str.concat(vname, "'"))))
          } else {
            if kind == 'not-exported {
              // payload = (name . (mod . nil)): dotted reference into a
              // module member that exists but is not pub (issue #96).
              let ename = str.sym_to_str(car(cdr(cdr(err))))
              let emod = disp_mod(car(cdr(cdr(cdr(err)))), car(disp))
              str.concat("  [E0004] ", str.concat(loc, str.concat("'", str.concat(ename, str.concat("' is not exported by module '", str.concat(emod, "'"))))))
            } else {
              if kind == 'no-export {
                // payload = (name . (mod . nil)): dotted reference into a
                // module with no such member at all (issue #96).
                let ename = str.sym_to_str(car(cdr(cdr(err))))
                let emod = disp_mod(car(cdr(cdr(cdr(err)))), car(disp))
                str.concat("  [E0004] ", str.concat(loc, str.concat("module '", str.concat(emod, str.concat("' has no export '", str.concat(ename, "'"))))))
              } else {
                if kind == 'non-exhaustive {
                  // payload = (tname . (missing . nil)): an ADT match whose
                  // arms do not cover the listed variants (issue #118).
                  let missing = car(cdr(cdr(cdr(err))))
                  str.concat("  [E0005] ", str.concat(loc, str.concat("non-exhaustive match: missing ", join_members(missing, ", ", cdr(disp)))))
                } else {
                  if kind == 'non-exhaustive-partial {
                    // payload = (tname . (partial . nil)): every variant has
                    // an arm, but the listed ones are only reached by nested
                    // patterns (Some(Some(y)) leaves Some(None) open), so no
                    // arm covers all of them — say "cannot prove" instead of
                    // "missing", which would read as nonsense (issue #396).
                    let partial = car(cdr(cdr(cdr(err))))
                    str.concat("  [E0005] ", str.concat(loc, str.concat("cannot prove exhaustive match: nested patterns cover only part of ", str.concat(join_members(partial, ", ", cdr(disp)), " — add an explicit `_ ->` arm"))))
                  } else {
                    if kind == 'unknown-ctor {
                      // payload = (tname . (name . nil))：模式里出现一个既不是
                      // tname 的变体、也不是内建类型名、也没有任何构造子声明的
                      // 名字（#443）。这条臂的拼写错误不会匹配任何值，只会静默
                      // 落到 `_ ->` 或别的臂上——所以它是错误而不是警告。
                      let ctname = str.sym_to_str(car(cdr(cdr(err))))
                      let cname = str.sym_to_str(car(cdr(cdr(cdr(err)))))
                      str.concat("  [E0005] ", str.concat(loc, str.concat("unknown constructor '", str.concat(cname, str.concat("' in match on ", ctname)))))
                    } else {
                      if kind == 'duplicate {
                        // payload = (name . nil)：顶层 define/define_pub/const
                        // 撞名（#289）。pass 1 无函数上下文（ctx 只是重名载体），
                        // loc 不适用。
                        let dname = str.sym_to_str(typecheck.disp_member(car(cdr(cdr(err))), cdr(disp)))
                        str.concat("  [E0006] ", str.concat("duplicate global: ", dname))
                      } else if kind == 'label-error {
                        // payload = (ctor . (label . (why . nil)))：记录构造/更新
                        // 里的标签错——why 是 'unknown（声明里没有这个字段）、
                        // 'duplicate（同一个字段给两次）、'missing（不带 base 的
                        // 构造里漏了一个已命名的字段）或 'no-fields（零参变体上
                        // 写了 `..base`，此时 label 是 nil）。
                        let ctor = str.sym_to_str(car(cdr(cdr(err))))
                        let why = car(cdr(cdr(cdr(cdr(err)))))
                        let msg = if why == 'no-fields {
                          str.concat("'", str.concat(ctor, "' has no fields to update"))
                        } else {
                          let label = str.sym_to_str(car(cdr(cdr(cdr(err)))))
                          if why == 'duplicate {
                            str.concat("duplicate field '", str.concat(label, str.concat("' in ", str.concat(ctor, "(...)"))))
                          } else if why == 'missing {
                            str.concat("'", str.concat(ctor, str.concat("' is missing field '", str.concat(label, "'"))))
                          } else {
                            str.concat("'", str.concat(ctor, str.concat("' has no field '", str.concat(label, "'"))))
                          }
                        }
                        str.concat("  [E0007] ", str.concat(loc, msg))
                      } else {
                        if kind == 'bare-member {
                          // payload = (name . (mod . nil))：裸写了另一个模块的
                          // 构造器 / 类型名（issue #462）。跨模块引用必须带模块
                          // 前缀，只有定义模块内部和语言基元享受裸名 —— 这里
                          // 直接把限定写法给出来。
                          let bname = str.sym_to_str(car(cdr(cdr(err))))
                          let bmod = disp_mod(car(cdr(cdr(cdr(err)))), cdr(disp))
                          str.concat("  [E0004] ", str.concat(loc, str.concat("'", str.concat(bname, str.concat("' is not in scope; did you mean '", str.concat(bmod, str.concat(".", str.concat(bname, "'?"))))))))
                        } else {
                          let uname = str.sym_to_str(car(cdr(cdr(err))))
                          str.concat("  [E0002] ", str.concat(loc, str.concat("undefined function '", str.concat(uname, "'"))))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      // Locate the failing call line inside the function body. The subst
      // yields errors newest-first, so successive errors at the same callee
      // resolve from the last occurrence backwards via `used` (issue #90:
      // they used to all show the last occurrence's line).
      // su = (site_text . used2)：明细行文本与更新后的 used 一起带回。
      let su = if kind == 'mismatch {
        if null?(detail) {
          cons("", used)
        } else {
          let shead = detail_head(detail)
          let key = str.concat(name, str.concat("/", shead))
          let site = find_call_site(src, name, shead, used_count(used, key))
          let st = if null?(site) {
            ""
          } else {
            str.concat("           line ", str.concat(str.from_int(car(site)), str.concat(": >>> ", cdr(site))))
          }
          cons(st, used_bump(used, key))
        }
      } else {
        cons("", used)
      }
      let site_text = car(su)
      let used2 = cdr(su)
      let head_line = str.concat(ehead, "\n")
      let out = if site_text == "" { head_line } else { str.concat(head_line, str.concat(site_text, "\n")) }
      str.concat(out, tc_errors_text(rest, src, used2, disp))
    }
  }
}

// Walk the (ctx . detail) pair chain to the root function-name symbol.
fn ctx_root_name(ctx) {
  if pair?(ctx) { ctx_root_name(car(ctx)) } else { ctx }
}

// Collect detail symbols from the ctx chain, outermost first.
fn ctx_detail_list(ctx, acc) {
  if pair?(ctx) { ctx_detail_list(car(ctx), cons(cdr(ctx), acc)) } else { acc }
}

fn list_last(lst) {
  if null?(cdr(lst)) { car(lst) } else { list_last(cdr(lst)) }
}

// Extract the called name from a detail like "arg 2 of helper".
fn detail_head(detail) {
  let idx = str.index_of(detail, " of ")
  if idx < 0 { detail }
  else { str.substr(detail, idx + 4, str.length(detail) - idx - 4) }
}

// Locate the line of the failing call within `fn name`'s body. Heuristic:
// the last occurrence of "<head>(" in the body is usually the violating
// call (earlier uses establish the type, later ones break it). Returns
// (line_no . line_text) or nil when not found (e.g. imported module).
fn find_call_site(src, name, head, nth) {
  let fn_off = str.index_of(src, str.concat("fn ", name))
  if fn_off < 0 {
    nil
  } else {
    let tail = str.substr(src, fn_off, str.length(src) - fn_off)
    let open = str.index_of(tail, "{")
    if open < 0 {
      nil
    } else {
      let body_start = fn_off + open
      let body_end = match_brace(src, body_start + 1, 1)
      let body = str.substr(src, body_start, body_end - body_start)
      let pat = str.concat(head, "(")
      find_hit_from(body, pat, body_start, src, str.length(body) - 1, nth, str.length(body))
    }
  }
}

// Backward scan of body[i..limit) for occurrences of `pat`; returns the
// (nth+1)-th one found (nth = 0 is the last before the limit) as
// (line_number . line_text), or nil. The limit bounds every later
// recursion, so an occurrence claimed by an earlier error can never be
// found again (issue #90: a suffix-search shortcut here jumped forward
// past the claimed hit and re-returned it).
fn find_hit_from(body, pat, body_start, src, i, nth, limit) {
  if i < 0 {
    nil
  } else {
    if str.eq(str.substr(body, i, str.length(pat)), pat) {
      if nth == 0 {
        let abs = body_start + i
        cons(1 + count_newlines(src, 0, abs), line_at(src, abs))
      } else {
        find_hit_from(body, pat, body_start, src, i - 1, nth - 1, limit)
      }
    } else {
      find_hit_from(body, pat, body_start, src, i - 1, nth, limit)
    }
  }
}

// used-count assoc for call-site resolution: key = "fn/callee" string,
// value = how many of that callee's occurrences (from the last) are
// already claimed by earlier-printed errors.
fn used_count(used, key) {
  match used {
    nil -> 0
    cons(pair, rest) -> {
      if str.eq(car(pair), key) { cdr(pair) } else { used_count(rest, key) }
    }
  }
}

fn used_bump(used, key) {
  match used {
    nil -> cons(cons(key, 1), nil)
    cons(pair, rest) -> {
      if str.eq(car(pair), key) {
        cons(cons(key, cdr(pair) + 1), rest)
      } else {
        cons(pair, used_bump(rest, key))
      }
    }
  }
}

// Last occurrence of `needle` in `s` at or before position `i`.
fn last_index_of(s, needle, i) {
  if i < 0 {
    -1
  } else {
    let idx = str.index_of(str.substr(s, i, str.length(s) - i), needle)
    if idx == 0 {
      i
    } else {
      if idx > 0 {
        i + idx
      } else {
        last_index_of(s, needle, i - 1)
      }
    }
  }
}

// Match braces from an open brace; returns offset just past the closing.
fn match_brace(src, i, depth) {
  if depth == 0 {
    i
  } else {
    if i >= str.length(src) {
      i
    } else {
      let c = str.char_at(src, i)
      if c == '{' {
        match_brace(src, i + 1, depth + 1)
      } else {
        if c == '}' {
          match_brace(src, i + 1, depth - 1)
        } else {
          match_brace(src, i + 1, depth)
        }
      }
    }
  }
}

// Extract the line of text containing offset `i`.
fn line_at(src, i) {
  let start = line_start(src, i)
  let end = line_end(src, i)
  str.substr(src, start, end - start)
}

fn line_start(src, i) {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == '\n' {
      i
    } else {
      line_start(src, i - 1)
    }
  }
}

fn line_end(src, i) {
  if i >= str.length(src) {
    str.length(src)
  } else {
    if str.char_at(src, i) == '\n' {
      i
    } else {
      line_end(src, i + 1)
    }
  }
}

// Find the source line where `fn <name>` is defined; 0 when not found
// (e.g. the function lives in an imported module).
fn find_fn_line(src, name) {
  let idx = str.index_of(src, str.concat("fn ", name))
  if idx < 0 { 0 }
  else { 1 + count_newlines(src, 0, idx) }
}

fn count_newlines(src, i, limit) {
  if i >= limit { 0 }
  else {
    if str.char_at(src, i) == '\n' { 1 + count_newlines(src, i + 1, limit) }
    else { count_newlines(src, i + 1, limit) }
  }
}

// ============================================================
// Signature-cache typecheck (Phase C, issue #99)
//
// Whole-program typecheck is kept byte-for-byte when caching is off
// (cache_dir = ""). When on, modules whose frozen signatures provably
// could not change are skipped: their definitions are dropped from the
// typechecked form list and their env bindings are reloaded from
// .build/modules/<name>-<key>.sig via infer_program_seeded. Everything
// else — parse, compile, form order, error behavior — is untouched.
// ============================================================

// typecheck_cached(forms, seq, cache_dir, verbose) -> tc result
pub fn typecheck_cached(forms : List(form.Form), seq, cache_dir, verbose) {
  if str.length(cache_dir) == 0 {
    typecheck.infer_program(forms)
  } else {
    let plan = plan_cache(seq_units(seq, nil), cache_dir, nil, nil,
    nil, nil, nil, verbose)
    // plan = (sighashes . (seed . (hitnames . (skipnames . misses))))
    let seed = car(cdr(plan))
    let hitnames = car(cdr(cdr(plan)))
    let skipnames = car(cdr(cdr(cdr(plan))))
    let misses = cdr(cdr(cdr(cdr(plan))))
    let tc_forms = tc_filter_seq(seq, skipnames, nil)
    let t0 = vm.time_ms()
    let tc = typecheck.infer_program_seeded(tc_forms, seed)
    let dt = vm.time_ms() - t0
    if verbose == 1 {
      print(str.concat("[sig] typecheck ", str.concat(str.from_int(dt),
      str.concat("ms (", str.concat(str.from_int(count_strs(hitnames)),
      str.concat(" hit, ", str.concat(str.from_int(count_strs(misses)), " miss)")))))))

    }
    store_misses(reverse(misses), cache_dir, car(plan), car(tc))
    tc
  }
}

// seq_units(seq, acc) — the ('U . unit) entries of the splice sequence,
// in splice order (= topo order, dependencies first).
fn seq_units(seq, acc) {
  if null?(seq) {
    rev_strs(acc, nil)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      seq_units(cdr(seq), cons(cdr(e), acc))
    } else {
      seq_units(cdr(seq), acc)
    }
  }
}

// plan_cache(units, cachedir, sighashes, seed, hitnames, skipnames,
//             misses, verbose)
//   -> (sighashes . (seed . (hitnames . (skipnames . misses))))
// A source miss is checked immediately in isolation. If its exports remain
// unchanged, its new signature is available to later dependents, which may
// then hit despite this module being rechecked.
fn plan_cache(units, cachedir, sighashes, seed, hitnames, skipnames, misses, verbose) {
  if null?(units) {
    cons(sighashes, cons(seed, cons(hitnames, cons(skipnames, misses))))
  } else {
    let u = car(units)
    let name = car(u)
    let source = car(cdr(u))
    let ownforms = cdr(cdr(u))
    let deps = modsig.unit_dep_names(ownforms, name, nil)
    let dpr = dep_pairs(deps, sighashes)
    let t0 = vm.time_ms()
    if cdr(dpr) == 0 {
      if verbose == 1 {
        print(str.concat("[sig] miss ", str.concat(name, " (dependency rechecking)")))
      }
      plan_cache(cdr(units), cachedir, sighashes, seed, hitnames,
      skipnames, cons(u, misses), verbose)
    } else {
      let key = modsig.eff_key(source, car(dpr))
      let text = file.read(modsig.sig_path(cachedir, name, key))
      let entry = modsig.sig_load_entry(text, source)
      if null?(entry) {
        // Do not treat this as a hit: source equality was not established.
        // But use the old entry's export hash as a baseline, then infer the
        // changed unit so its actual exports can be propagated immediately.
        let pre = typecheck.infer_program_seeded(ownforms, seed)

        let pre_errors = typecheck.get_errors(pre)
        if null?(pre_errors) {
          let bindings = modsig.unit_bindings(ownforms, name, car(pre), nil)
          let etext = modsig.exports_text(bindings)
          let sh = modsig.str_hash(etext)
          let seed2 = list.append(seed, bindings)
          if verbose == 1 {
            print(str.concat("[sig] miss ", name))
          }
          plan_cache(cdr(units), cachedir,
          cons(cons(str.to_sym(name), sh), sighashes), seed2,
          hitnames, skipnames, cons(u, misses), verbose)

        } else {
          if verbose == 1 { print(str.concat("[sig] miss ", name)) }
          plan_cache(cdr(units), cachedir, sighashes, seed,
          hitnames, skipnames, cons(u, misses), verbose)
        }
      } else {
        let dt = vm.time_ms() - t0
        if verbose == 1 {
          print(str.concat("[sig] hit ", str.concat(name,
          str.concat(" (", str.concat(str.from_int(dt), "ms)")))))
        }
        plan_cache(cdr(units), cachedir,
        cons(cons(str.to_sym(name), cdr(entry)), sighashes),
        list.append(seed, car(entry)), cons(name, hitnames),
        cons(name, skipnames), misses, verbose)
      }
    }
  }
}

// dep_pairs(deps, sighashes) -> (((name . sighash) ...) . ok)
// ok = 0 when any dependency has no current signature (caller must miss).
fn dep_pairs(deps, sighashes) {
  dep_pairs_loop(deps, sighashes, nil)
}

fn dep_pairs_loop(deps, sighashes, acc) {
  if null?(deps) {
    cons(rev_strs(acc, nil), 1)
  } else {
    let hit = alist_assoc(str.to_sym(car(deps)), sighashes)
    if null?(hit) {
      cons(nil, 0)
    } else {
      dep_pairs_loop(cdr(deps), sighashes, cons(cons(car(deps), cdr(hit)), acc))
    }
  }
}

// tc_filter_seq(seq, hitnames, acc) — the typechecked form list. Hit units
// contribute only their type / external_fn / import forms, so ctor and
// C-signature registration happens in the same order as a whole-program
// pass (their fn/const bindings come from the cache seed instead); miss
// units and all loose forms contribute everything.
fn tc_filter_seq(seq, hitnames, acc) -> List(form.Form) {
  if null?(seq) {
    reverse(acc)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      let ownforms = cdr(cdr(cdr(e)))
      let acc2 = if str_in_strs(car(cdr(e)), hitnames) {
        rev_app(keep_cached_forms(ownforms, nil), acc)
      } else {
        rev_app(ownforms, acc)
      }
      tc_filter_seq(cdr(seq), hitnames, acc2)
    } else {
      tc_filter_seq(cdr(seq), hitnames, cons(cdr(e), acc))
    }
  }
}

// Cached units keep only order-relevant declarations: type forms register
// constructors (the ctor schemes are also in the signature so dependents
// still invalidate), external_fn forms keep C-module call sites checked
// strictly, import forms are inert. define/define_pub/const/type-sig are
// covered by the seeded bindings (a type-sig's raw annotated arrow would
// shadow the fully generalized cached scheme — wrong, so it is dropped).
fn keep_cached_forms(forms : List(form.Form), acc) -> List(form.Form) {
  if null?(forms) {
    acc
  } else {
    let f = car(forms)
    let head = form.nth(form.items(f), 0)
    let acc2 = if form.is_sym(head, 'type) {
      cons(f, acc)
    } else {
      if form.is_sym(head, 'external_fn) {
        cons(f, acc)
      } else {
        if form.is_sym(head, 'import) { cons(f, acc) } else { acc }
      }
    }
    keep_cached_forms(cdr(forms), acc2)
  }
}

// store_misses(misses, cachedir, sighashes, env) — write fresh entries for
// every rechecked module, in topo order: by the time a module is stored,
// its dependencies' new signature hashes are already in sighashes, so the
// key written here matches the key the next cold lookup will compute.
fn store_misses(misses, cachedir, sighashes, env) {
  if null?(misses) {
    sighashes
  } else {
    let u = car(misses)
    let name = car(u)
    let source = car(cdr(u))
    let ownforms = cdr(cdr(u))
    let deps = modsig.unit_dep_names(ownforms, name, nil)
    let dpr = dep_pairs(deps, sighashes)
    if cdr(dpr) == 1 {
      let bindings = modsig.unit_bindings(ownforms, name, env, nil)
      let etext = modsig.exports_text(bindings)
      let sh = modsig.str_hash(etext)
      let key = modsig.eff_key(source, car(dpr))
      modsig.sig_store(cachedir, name, key, source, etext, sh)
      store_misses(cdr(misses), cachedir, cons(cons(str.to_sym(name), sh), sighashes), env)
    } else {
      // unreachable in topo order — skip rather than write a bad key
      store_misses(cdr(misses), cachedir, sighashes, env)
    }
  }
}

fn str_in_strs(s, lst) {
  if null?(lst) { false }
  else {
    if car(lst) == s { true }
    else { str_in_strs(s, cdr(lst)) }
  }
}

fn count_strs(lst) {
  if null?(lst) { 0 }
  else { 1 + count_strs(cdr(lst)) }
}

fn rev_strs(lst, acc) {
  if null?(lst) { acc }
  else { rev_strs(cdr(lst), cons(car(lst), acc)) }
}

// Returns (forms . (seq . err)): err is nil on success, or an error
// message string (parse error / module error / unreadable file).
pub fn load_source_ta(path, use_ta, with_cov) {
  let src = file.read(path)
  if null?(src) {
    cons(nil, cons(nil, str.concat("error: cannot read file: ", path)))
  } else {
    let pr = parse_module_content(src, path, use_ta, with_cov)
    let err = cdr(pr)
    if null?(err) {
      let nr = need_root(path, car(pr))
      if null?(car(nr)) {
        cons(nil, cons(nil, cdr(nr)))
      } else {
        resolve_imports(car(pr), car(nr), use_ta, with_cov)
      }
    } else {
      cons(nil, cons(nil, err))
    }
  }
}

// ---------- CLI 驱动半程（D9 并入：原独立 driver CLI 脚本） ----------
//
// `tinyactor --vm=lisp run x.ta` 的编译半程：tavm 跑本驱动（种子
// = 本文件闭包的编译产物 lib/bootstrap.tabc），把用户源码经 lisp 管线
// 编成字节码，再由 tavm 执行；fmt 子命令 = 7b-3 再宿主的执行体
// （与旧链入口 build.ta 同款 dispatch）。
//
// CLI 语义与 corpus/扫描器路径的差异：输入来自 argv；失败时打印阶段名
// 并 os.exit(1)；模块解析与 typecheck 复用上面的原生机制（resolve_imports
// 命名空间化 + typecheck_cached），不再吃展开后的单命名空间文本
// （展开文本当单程序 typecheck 会因命名空间丢失误报，issue #256）。
//
// 仍不收敛的构造（README「语料覆盖」）会让本驱动挂死，由宿主超时兜底。

// 失败走 stderr（与 run_tavm 的约定一致）：log.ta 同款 /dev/stderr 写入，
// 不新增 C 层 builtin。整条失败消息经 die_msg 单次写出。
fn die(stage) {
  die_msg(str.concat("lisp-backend: ", str.concat(stage, "\n")))
}

// die_msg — 完整失败消息**一次**写 stderr 后退出。禁止一条失败拆成多次
// 写：file.write 是 truncate-on-open，对 /dev/stderr 的第二次写会把先前
// 落盘的内容整个清空——CI harness 用 >log 2>&1 把 stdout/stderr 合进同
// 一个文件，已打印的 typecheck 报告会被 die 的写入抹掉，负例判定只看到
// "lisp-backend: typecheck"（issue #275「报告静默」的根因）。本地终端
// tty 无截断，所以只有 CI 挂。
fn die_msg(msg) {
  file.write("/dev/stderr", msg)
  os.exit(1)
}

// ---------- fmt 子命令（旧链 build.ta 的 fmt 分支原样移植） ----------
// 参数布局与旧链一致：get_arg(0)="fmt"、get_arg(1)=("--check"|path)、
// get_arg(2)=path（--check 时）——tavm/tavm 的 argv[0] 都是 .tabc 之后
// 第一个实参，索引语义无需适配。
// 只在内容真的变了才写：file.write 必刷新 mtime，而 lib/bootstrap/driver.ta
// 正是种子 lib/bootstrap.tabc 的 staleness 基准（tinyactor 的 `-ot` 判断）——
// 对已格式化的树空写一次，就把种子判成过期，随后每个并发测试各自触发一次
// 种子自重建；其 stderr 通知落在测试日志第 1 行，而负例判定只读第 1 行
// （test/lib.sh 的 head -1）⇒ 拒绝正确的程序被误判为"未被拒绝"。
// fmt 的语义是"让文件变成格式化后的内容"，内容相同即无操作（同 fmt_check
// 的比较口径）。
fn fmt_file(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  if out != src {
    file.write(path, out)
  }
}

fn fmt_check(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  if out == src {
    print(str.concat("ok: ", path))
  } else {
    print(str.concat("diff: ", path))
  }
}

fn main() {
  let a0 = vm.get_arg(0)
  if a0 == "fmt" {
    let arg1 = vm.get_arg(1)
    if arg1 == "--check" {
      fmt_check(vm.get_arg(2))
    } else {
      fmt_file(arg1)
    }
  } else if a0 == "--cov" {
    // --cov <src> <out> <cache_dir>：编译期插桩（函数入口 + 语句/arm），
    // 另写 <out>.covmap 侧表（id -> file:line name）。见 covinst.ta。
    compile_ta(vm.get_arg(1), vm.get_arg(2), vm.get_arg(3), nil, nil, 1)
  } else if a0 == "--emit-kl" {
    // --emit-kl <kl> <src> <out> <cache_dir>：.kl 只是多写一份文本，
    // 编译仍走 .ta 路（§3.1 接缝的 emit 半边）。
    compile_ta(vm.get_arg(2), vm.get_arg(3), vm.get_arg(4), vm.get_arg(1), nil, 0)
  } else if a0 == "--emit-kl-dir" {
    // --emit-kl-dir <dir> <src> <out> <cache_dir>：--emit-kl 的逐模块版。
    // 编译仍走 .ta 路且产物不变（G-C 同款判据），另把 lower 产物按归属
    // 单元分块写 <dir>/<NN>-<name>.kl + manifest（= flat 顺序，链接门的
    // 拼接序，docs/kl-format.md §9）。
    compile_ta(vm.get_arg(2), vm.get_arg(3), vm.get_arg(4), nil, vm.get_arg(1), 0)
  } else if a0 == "--emit-c" {
    // --emit-c <kl> <out.c>：原生后端（M1）。与 --from-kl 并列：输入同样是
    // kl AST，只是尾段换成 cgen.ta（C 源码）而不是 bytecode.ta（.tabc）。
    compile_kl_c(vm.get_arg(1), vm.get_arg(2))
  } else if a0 == "--from-kl" {
    // --from-kl <kl> <out>：**没有** <src> 参数 —— .kl 路不读源码、不跑
    // typecheck（结构性事实，见 compile_kl 的注释）。
    compile_kl(vm.get_arg(1), vm.get_arg(2))
  } else if a0 == "--link-kl" {
    // --link-kl <out> <f1> <f2> ...：按给定顺序链接逐模块 .kl（docs/kl-format.md §9）。
    // 链接 = 顶层 form 表按序拼接后整体重写规范文本——链接不是编译，
    // 没有任何语义 pass；write 是纯函数，拼接顺序即字节序。
    link_kl(vm.get_arg(1), 2)
  } else {
    compile_ta(a0, vm.get_arg(1), vm.get_arg(2), nil, nil, 0)
  }
}

// compile_ta — src -> out 编译半程（原 compile_main，7b-3 起由上面的 main
// 按 argv[0] dispatch："fmt" 走 fmt 分支，"--emit-kl"/"--from-kl" 走 .kl
// 分支，否则本函数）。
// emit_kl 非 nil 时把 lower 产物按 .kl 格式写到该路径；emit_kl_dir 非 nil
// 时另把同一 lower 产物按归属单元分块写逐模块 .kl + manifest（步 2，docs/kl-format.md §9）。
// 两者都只是多写文本，**仍走原路**（写入不参与编译，产物逐字节不变）。
// with_cov=1（--cov 分支）时在 typecheck 之后、lower 之前插桩，另写
// <out>.covmap；其余调用方一律传 0，非 cov 路径产物逐字节不变。
fn compile_ta(src, out, cache_dir, emit_kl, emit_kl_dir, with_cov) {
  let text = file.read(src)
  if null?(text) {
    die("cannot read source file")
  }
  // parse 验证统一走 parse_module_content：check_syntax（tokenizer 级）+
  // find_parse_error（AST 内嵌 marker 深扫）+ check_toplevel_forms
  // （裸表达式 / import 缺名），错误串带 issue #66 富位置（line/col/near）。
  // 7b-4 实测：lisp 侧自造的 int?(ast) 检查放行了 10 个负例。
  let pr = parse_module_content(text, src, 1, with_cov)
  if null?(cdr(pr)) == false {
    die(cdr(pr))
  }
  let parsed = car(pr)
  // 根 = 入口文件向上第一个含 vendor/ 的祖先（一次构建算一次）。没有根而
  // 程序真有 import 时在这里响亮拒绝，不把它留到解析器深处。
  let nr = need_root(src, parsed)
  let root = car(nr)
  if null?(root) {
    die_msg(str.concat(cdr(nr), "\n"))
  }
  // 模块解析（命名空间化，对齐 native 构建）+ 按模块语义的 typecheck
  let rr = resolve_imports(parsed, root, 1, with_cov)
  let rerr = cdr(cdr(rr))
  if null?(rerr) == false {
    die(str.concat("module: ", rerr))
  }
  let forms = car(rr)
  // sig cache：argv[2] 传 cache_dir（run_tavm 传项目级 .build/modules），
  // 缺省/空串关闭。没有 cache 时每次 run 都全量 typecheck 全部依赖模块
  // ——corpus/make test 逐文件调用会被放大成几十分钟（CI 实测）。
  let cd = if null?(cache_dir) { "" } else { cache_dir }
  // seq = car(cdr(rr))：resolve_imports 返回 (forms . (seq . err))，
  // seq 是 sig cache 的单位序列，包错一层会让 cache 永远空转
  let tc = typecheck_cached(forms, car(cdr(rr)), cd, 0)
  if typecheck.count_errors(tc) > 0 {
    // 富报告（pub）：首行 "typecheck: N type error(s) found" +
    // [E00xx] 明细（含 E0005 non-exhaustive——负例 expect 的文案只在
    // 这里出现）。与阶段名合成一条消息
    // 单次写 stderr（die_msg 的约束）：拆开写会把报告从合并捕获里抹掉。
    die_msg(str.concat(typecheck_report(tc, text, disp_names(car(cdr(rr)), nil)), "lisp-backend: typecheck\n"))
  }
  // 记录构造/更新：标签 -> 槽位表（从声明里扫出来），在 typecheck 之后、
  // lower 之前把 ('ctor.labels …) 位置化成和位置构造一样的 tuple。
  let tables = typecheck.ctor_label_tables(forms)
  let expanded = expand_records_forms(forms, tables)
  // --cov 插桩：标记（begin (cov.line f l) s）是 parser 插的，typecheck 靠
  // builtin env 里的一条 cov.line 承诺认它（不再有「宿主模块豁免」）。变换
  // 落在 typecheck 之后、lower 之前 —— 类型检查看到的是未插桩的 form 树
  // （签名缓存照旧），产物带 (cov.hit k) 计数器，k -> file:line 侧表写到
  // <out>.covmap。
  // 下游全部吃 form.Form：covinst 插桩与 lower-ast 降级都直接接这棵树，
  // 源树侧不再有 Form → 未类型化的转换（只剩 C 边界那一处 from_untyped）。
  let wrapped = if with_cov == 1 {
    let ir = covinst.instrument(expanded)
    covinst.write_covmap(str.concat(out, ".covmap"), cdr(ir))
    car(ir)
  } else {
    expanded
  }
  let tops = lower-ast.lower_program(wrapped)
  if null?(emit_kl) == false {
    file.write(emit_kl, kl.write_program(form.encode_program(tops)))
  }
  if null?(emit_kl_dir) == false {
    emit_kl_chunks(emit_kl_dir, car(cdr(rr)), tables)
  }
  compile_low(tops, out)
}

// ----------------------------------------------------------------
// 记录构造 / 更新的位置化（typecheck 之后、lower 之前）
//
// ('ctor.labels (quote R) base assigns)：标签在 typecheck 里已核对过（字段存在、
// 不重复、无 base 时每个槽位都被覆盖），这里只把标签对回槽位，产出和位置
// 构造完全一样的 (tuple (quote R) v1 … vn)——record 不是第二种值，只是
// 构造器的另一种拼写。
//
//   R(num: 3, den: 4)  ->  (tuple (quote R) 3 4)
//   R(..r, num: 3)     ->  (let _r r (tuple (quote R) 3 (tuple-ref _r 2)))
//
// base 只求值一次（绑到临时变量），没覆盖的槽位从它读——语义就是「复制 r
// 再改这几格」。槽位表来自**声明**（typecheck.ctor_label_tables 扫 forms 里
// 的 type），不是推断的副产物：签名缓存跳过的模块体只有声明可依，而声明本
// 来就躺在 forms 里。
fn expand_records_forms(forms : List(form.Form), tables) -> List(form.Form) {
  if null?(forms) {
    nil
  } else {
    cons(expand_records(car(forms), tables), expand_records_forms(cdr(forms), tables))
  }
}

// expand_records — 深走 form 树，把 ('ctor.labels …) 就地换成位置构造。quoted
// 数据整棵跳过（构造器名/标签都是 (quote Name)，换掉就没法再对表）。
fn expand_records(e : form.Form, tables) -> form.Form {
  match e {
    form.FAtom(_) -> e
    form.FList(items) -> {
      let head = form.nth(items, 0)
      let rest = cdr(items)
      if form.is_sym(head, 'quote) {
        e
      } else if form.is_sym(head, 'ctor.labels) {
        // base 与字段值里还可能嵌着更新（R(..S(..r, a: 1), b: 2)）：先递归展开再
        // 拼 tuple。assigns 整棵走通用递归是安全的——元素是 (label expr)，label
        // 是符号，递归到它原样返回，只有 expr 会被改写。
        record_tuple(form.sym_at(form.nth(form.items(form.nth(rest, 0)), 1)),
        expand_records(form.nth(rest, 1), tables),
        expand_records(form.nth(rest, 2), tables), tables)
      } else {
        form.lst(expand_records_forms(items, tables))
      }
    }
  }
}

// 更新时的 base 临时名。词法器产不出含 `#` 的符号（tokenizer.is_ident_char），
// 用户无从引用，所以不会被同名变量遮蔽。
const RECORD_BASE = "#r"

fn record_tuple(name : Symbol, base : form.Form, assigns : form.Form, tables) -> form.Form {
  let entry = alist_assoc(name, tables)
  let quoted = form.lst(cons(form.sym('quote), cons(form.sym(name), nil)))
  if null?(entry) {
    // typecheck 认得这个构造器名，表里就一定有它（同一份 forms 扫出来的）。
    // 对不上说明两个 pass 各看到了不同的树，是真 bug——不猜。
    die(str.concat("internal: no field labels for ", str.sym_to_str(name)))
  } else {
    let arity = list.nth(entry, 1)
    let labels = list.nth(entry, 2)
    if form.is_nil_form(base) {
      form.lst(cons(form.sym('tuple),
      cons(quoted, slot_values(assigns, labels, 'nil, arity, 1, nil))))
    } else {
      // base 只求值一次，未覆盖的槽位从这个 let 读。临时名带 `#`：词法器的
      // is_ident_char 不含它，任何用户表达式（含 `_r` 这种下划线名）都指不到
      // 它——换成一个合法标识符就会遮蔽用户作用域里的同名变量。
      // 嵌套更新（R(..S(..r, a: 1), b: 2)）里内层 let 在外层 body 之内，
      // 各自的 base 都在自己 let 的**值**位置求值，互不干涉。
      let rec = str.to_sym(RECORD_BASE)
      let vals = slot_values(assigns, labels, rec, arity, 1, nil)
      form.lst(cons(form.sym('let), cons(form.sym(rec), cons(base,
      cons(form.lst(cons(form.sym('tuple), cons(quoted, vals))), nil)))))
    }
  }
}

// slot_values(assigns, labels, rec, arity, i, acc_rev) -> (v1 … vn)
// 槽位 i 的取值：源码给了就用它，没给就从 base 里原样搬（(tuple-ref rec i)）。
// rec 为 'nil 时不会有没给的槽位——typecheck 的 record_coverage 已经拒过。
fn slot_values(assigns : form.Form, labels, rec, arity, i, acc_rev) -> List(form.Form) {
  if i > arity {
    reverse(acc_rev)
  } else {
    let hit = assign_value(form.items(assigns), labels, i)
    let v = if null?(hit) {
      form.lst(cons(form.sym('tuple-ref),
      cons(form.sym(rec), cons(form.FAtom(ast.CInt(i)), nil))))
    } else {
      cdr(hit)
    }
    slot_values(assigns, labels, rec, arity, i + 1, cons(v, acc_rev))
  }
}

// assign_value(assigns, labels, slot) -> (1 expr) 或 nil
fn assign_value(assigns : List(form.Form), labels, slot) {
  if null?(assigns) {
    nil
  } else {
    let items = form.items(car(assigns))
    if car(cdr(alist_assoc(form.sym_at(form.nth(items, 0)), labels))) == slot {
      cons(1, form.nth(items, 1))
    } else {
      assign_value(cdr(assigns), labels, slot)
    }
  }
}

// ----------------------------------------------------------------
// 步 2：逐模块 .kl + 链接（docs/kl-format.md §9）。
//
// 分块的依据不是 lower 产物（lower 会内联 const / 丢 inert form / 尾补
// main 调用，块边界已抹掉），而是 resolve_imports 的 seq：重放 flat 顺序
// 给每个 form 打上归属（主文件 -> "main"，'U 单元 ownforms -> 单元内部名
// unit_prefix，mangled 后无 '/' 可作文件名），
// 按末次出现顺序分块；每块独立过同一个 lower_program，写
// <dir>/<NN>-<name>.kl，manifest 逐行记文件名（= flat 顺序）。
// 回归门：--link-kl 按 manifest 顺序拼接 == --emit-kl 整 .kl 逐字节
// （test/run_kl_link_gate.sh，docs/kl-format.md §9）。逐字节成立依赖：lower 的跨块耦合只有
// const（TA const 不出口，跨块引用会被 typecheck 拒绝）和 main 调用
// （归主文件块）；任何一边被破坏，门先红。

// emit_kl_chunks — dir 下写逐模块 .kl + manifest。dir 必须已存在（调用方
// 建目录；driver 不做 mkdir）。tables 是全局的标签->槽位表：声明可能落在
// 别的块里，所以每次写块都用同一份（不是从块内 forms 重算）。
fn emit_kl_chunks(dir, seq, tables) {
  let grouped = group_chunks(seq_tagged(seq, nil), nil, nil)
  write_chunks(dir, dedupe_last(car(grouped), nil), car(cdr(grouped)), 0, "", tables)
}

// seq_tagged — seq_forms 的 tagged 版：重放 flat 顺序（'U 的 ownforms
// 在同一位置按原序展开），每个 form 配上归属，返回 (form . tag) 列表。
// 归属标签是单元的**内部名**（unit_prefix）：mangled 后不含 '/'，才能
// 直接充当 emit-kl-dir 的文件名（'00-<name>.kl'，manifest 同名）；显示名
// 可能是带斜杠的 import 路径（docs/modules.md 显示名/内部名边界）。
fn seq_tagged(seq, acc_rev) {
  if null?(seq) {
    reverse(acc_rev)
  } else if car(car(seq)) == 'U {
    let name = unit_prefix(car(cdr(car(seq))))
    seq_tagged(cdr(seq), rev_app_tagged(cdr(cdr(cdr(car(seq)))), name, acc_rev))
  } else {
    seq_tagged(cdr(seq), cons(cons(cdr(car(seq)), "main"), acc_rev))
  }
}

fn rev_app_tagged(lst : List(form.Form), tag, acc) {
  if null?(lst) { acc }
  else { rev_app_tagged(cdr(lst), tag, cons(cons(car(lst), tag), acc)) }
}

// group_chunks — tagged flat forms -> (order_all . chunks)：order_all 是
// 块名表（每次出现都记，含重复，反向累积）；chunks 是 name -> (rev . forms)
// 的 assoc（同块 form 反向累积，取用时 reverse；重复键取最新，assq 语义）。
// 块序取**末次出现**（emit_kl_chunks 里 dedupe_last）：单元的 ownforms 在
// flat 里连续，首末一致；主文件的 import 标记（inert，不产代码）会把
// "main" 提前到头部，而主文件真实 forms 在 flat 末尾（imports 全在顶部时），
// 逐字节门要求主文件块排在最后。
fn group_chunks(tagged, order_rev, chunks) {
  if null?(tagged) {
    cons(reverse(order_rev), cons(chunks, nil))
  } else {
    let p = car(tagged)
    let cur = assq_key(cdr(p), chunks)
    let new_chunks = if null?(cur) {
      cons(cons(cdr(p), cons(car(p), nil)), chunks)
    } else {
      cons(cons(cdr(p), cons(car(p), cdr(cur))), chunks)
    }
    let new_order = if null?(cur) { cons(cdr(p), order_rev) } else { cons(cdr(p), order_rev) }
    group_chunks(cdr(tagged), new_order, new_chunks)
  }
}

// dedupe_last — 保序去重，同名保**最后一次**出现。
fn dedupe_last(order, acc) {
  if null?(order) {
    reverse(acc)
  } else {
    let keep = if in_list(car(order), cdr(order)) { false } else { true }
    dedupe_last(cdr(order), if keep { cons(car(order), acc) } else { acc })
  }
}

fn in_list(x, lst) {
  if null?(lst) { false } else { if car(lst) == x { true } else { in_list(x, cdr(lst)) } }
}

fn assq_key(key, alist) {
  if null?(alist) { nil }
  else { if car(car(alist)) == key { car(alist) } else { assq_key(key, cdr(alist)) } }
}

fn write_chunks(dir, order, chunks, i, manifest, tables) {
  if null?(order) {
    file.write(str.concat(dir, "/manifest"), str.concat(manifest, "\n"))
  } else {
    let name = car(order)
    let forms = expand_records_forms(reverse(cdr(assq_key(name, chunks))), tables)
    let tops = lower-ast.lower_program(forms)
    let fname = str.concat(pad2(i), str.concat("-", str.concat(name, ".kl")))
    file.write(str.concat(dir, str.concat("/", fname)), kl.write_program(form.encode_program(tops)))
    let next_manifest = if manifest == "" { fname } else { str.concat(manifest, str.concat("\n", fname)) }
    write_chunks(dir, cdr(order), chunks, i + 1, next_manifest, tables)
  }
}

fn pad2(i) {
  if i < 10 { str.concat("0", str.from_int(i)) } else { str.from_int(i) }
}

// link_kl — 逐模块 .kl -> 整 .kl（docs/kl-format.md §9 链接半边）。输入文件名从 get_arg(i)
// 起读到空串为止；链接 = 顶层 form 表按序 list.append 后整体
// kl.write_program 重写——链接不是编译，没有语义 pass；write 是纯函数，
// 拼接顺序即字节序（回归门判定 link == 整 .kl 的根据）。
fn link_kl(out, i) {
  if out == "" {
    die("--link-kl: missing output path")
  }
  if vm.get_arg(2) == "" {
    die("--link-kl: no input .kl files")
  }
  link_kl_read(out, 2, nil)
}

// 输入文件可以是**空** .kl（纯 external fn 声明的单元整程序 lower 后就是
// 空文本，如 lib/str.ta）——空文件贡献零 form，不是错误；「没有输入文件」
// 由 link_kl 的首参检查拦截。
fn link_kl_read(out, i, acc) {
  let a = vm.get_arg(i)
  if a == "" {
    file.write(out, kl.write_program(acc))
  } else {
    let text = file.read(a)
    if null?(text) {
      die(str.concat("cannot read .kl file: ", a))
    }
    match kl.read_program(text) {
      result.Err(msg) -> die(str.concat(".kl parse: ", str.concat(a, str.concat(": ", msg))))
      result.Ok(fs) -> link_kl_read(out, i + 1, list.append(acc, fs))
    }
  }
}

// compile_kl — .kl 文本 -> out（§3.1 接缝的 read 半边）。
// §3.3：`.kl` 路**不跑** tokenize / parse / resolve_imports / typecheck ——
// 它们在生成这份文本时已经跑过，而 lower 已经把类型信息丢掉了（`infer_form`
// 不产 `type`/`type-sig`/`const`），这里既跑不了也不必跑。所以：
//   * `.kl` 是**编译器产物格式**（可读、可手写，用于调试/教学），不是受支持
//     的用户入口；手写 `.kl` 绕过全部静态检查是结构性事实，不是漏洞；
//   * 不要试图给 `.kl` 补一层 typechecker —— 那要把 lower 丢掉的东西重新背
//     回格式里，等于把已经移除的缺陷再加回来。
fn compile_kl(kl_path, out) {
  let text = file.read(kl_path)
  if null?(text) {
    die(str.concat("cannot read .kl file: ", kl_path))
  }
  match kl.read_program(text) {
    result.Err(msg) -> die(str.concat(".kl parse: ", msg))
    result.Ok(forms) -> {
      // .kl 读回的 form 表在**同一条** form → Top 边界上收敛（与 .ta 路在
      // compile_low 汇合）。手写 .kl 可以写词表外的形状，故 None 是输入问题。
      let tops = tops_or_die(form.parse_program(forms), "kl: form outside the .kl word list")
      compile_low(tops, out)
    }
  }
}

// tops_or_die — Option(List(Top)) → List(Top)，None 就带着 stage 硬停。
//
// 现在只剩**读入**侧需要它：手写 .kl / 前奏文本可以写出词表外的形状，
// None = 输入问题，靠 stage 文案说清（lower-ast 那侧已无 Option：它造的就是
// Top 本身，形状由类型钉住）。
fn tops_or_die(opt, stage) {
  match opt {
    option.None -> die(stage)
    option.Some(tops) -> tops
  }
}

// compile_low — 编译半程尾段：kl AST（List(Top)）→ .tabc。编译器的入参就是
// Top 树（ast.ta），尾段自然从 Top 起；.ta 路与 .kl 路共用，所以「两条路同
// 产物」不靠人工保持同步，而是结构上没有第二个尾段。
fn compile_low(tops : List(ast.Top), out) {
  // lib_src 是文本，AST 管线里读回 form 表、再跨过 form → Top 边界前置（同旧
  // prelude 语义）。这份文本就是 `.kl` 词表里的东西，所以用同一个 reader（kl）
  // 读——编译路径对 lib/sexp.dylib 的调用到此为止（C3）。
  let prelude = tops_or_die(form.parse_program(prelude_forms()), "prelude: form outside the .kl word list")
  match compile.compile(list.append(prelude, tops)) {
    compile.Fail(msg) -> die(str.concat("reject: ", msg))
    compile.Out(fns, consts) -> bytecode.write_bc(out, fns, consts)
  }
}

// compile_c — 原生后端尾段：kl AST（List(Top)）→ C 源码文本。
// 与 compile_low 并列而不取代它：.tabc 仍是默认产物。prelude 同样前置，
// 两个后端的输入因此是同一棵树（同样的 define 顺序、同样的全局编号序）。
fn compile_c(tops : List(ast.Top), out) {
  let prelude = tops_or_die(form.parse_program(prelude_forms()), "prelude: form outside the .kl word list")
  match cgen.gen(list.append(prelude, tops)) {
    cgen.CgFail(msg) -> die(str.concat("cgen: ", msg))
    cgen.CgOk(src) -> file.write(out, src)
  }
}

// compile_kl_c — .kl 文本 → C 源码（--emit-c 的读入半边）。
fn compile_kl_c(kl_path, out) {
  let text = file.read(kl_path)
  if null?(text) {
    die(str.concat("cannot read .kl file: ", kl_path))
  }
  match kl.read_program(text) {
    result.Err(msg) -> die(str.concat(".kl parse: ", msg))
    result.Ok(forms) -> compile_c(tops_or_die(form.parse_program(forms), "kl: form outside the .kl word list"), out)
  }
}

// prelude_forms — bytecode.lib_src()（lisp 语法文本）→ form 表，.kl reader 读。
fn prelude_forms() {
  match kl.read_program(bytecode.lib_src()) {
    result.Err(msg) -> die(str.concat("prelude parse: ", msg))
    result.Ok(forms) -> forms
  }
}
