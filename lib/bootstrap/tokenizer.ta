pub fn is_digit(c) {
  match c {
    '0' -> true
    '1' -> true
    '2' -> true
    '3' -> true
    '4' -> true
    '5' -> true
    '6' -> true
    '7' -> true
    '8' -> true
    '9' -> true
    _ -> false
  }
}

pub fn is_alpha(c) {
  match c {
    'A' -> true
    'B' -> true
    'C' -> true
    'D' -> true
    'E' -> true
    'F' -> true
    'G' -> true
    'H' -> true
    'I' -> true
    'J' -> true
    'K' -> true
    'L' -> true
    'M' -> true
    'N' -> true
    'O' -> true
    'P' -> true
    'Q' -> true
    'R' -> true
    'S' -> true
    'T' -> true
    'U' -> true
    'V' -> true
    'W' -> true
    'X' -> true
    'Y' -> true
    'Z' -> true
    'a' -> true
    'b' -> true
    'c' -> true
    'd' -> true
    'e' -> true
    'f' -> true
    'g' -> true
    'h' -> true
    'i' -> true
    'j' -> true
    'k' -> true
    'l' -> true
    'm' -> true
    'n' -> true
    'o' -> true
    'p' -> true
    'q' -> true
    'r' -> true
    's' -> true
    't' -> true
    'u' -> true
    'v' -> true
    'w' -> true
    'x' -> true
    'y' -> true
    'z' -> true
    '_' -> true
    _ -> false
  }
}

pub fn is_ident_char(c) {
  if is_alpha(c) {
    true
  } else {
    if is_digit(c) {
      true
    } else {
      match c {
        '.' -> true
        '+' -> true
        '-' -> true
        '<' -> true
        '>' -> true
        '=' -> true
        '!' -> true
        '?' -> true
        '*' -> true
        '/' -> true
        _ -> false
      }
    }
  }
}

fn reverse_helper(lst, acc) {
  if null?(lst) {
    acc
  } else {
    reverse_helper(cdr(lst), cons(car(lst), acc))
  }
}

fn reverse(lst) {
  reverse_helper(lst, nil)
}

pub fn is_kw(s) {
  match s {
    "fn" -> true
    "let" -> true
    "match" -> true
    "if" -> true
    "else" -> true
    "when" -> true
    "spawn" -> true
    "send" -> true
    "import" -> true
    "receive" -> true
    "pub" -> true
    "type" -> true
    "external" -> true
    "const" -> true
    "nil" -> true
    "true" -> true
    "false" -> true
    _ -> false
  }
}

// ---- fmt support: tokenize keeping comments + positions ----
// fmt token format: ((type value) start_off line)
// Comments are kept as tokens ('comment, text) where text includes the "//".
// Lines are 1-based; start_off is the char offset of the token/comment start.

fn fmt_scan_comment(src, start, i, len) {
  if i >= len {
    cons(i, str.substr(src, start, i - start))
  } else {
    if str.char_at(src, i) == '\n' {
      cons(i, str.substr(src, start, i - start))
    } else {
      fmt_scan_comment(src, start, i + 1, len)
    }
  }
}

// fmt_skip_ws(src, i, line, acc) -> (i' line' acc')
// acc accumulates tokens (reversed); comment tokens are prepended as found.
fn fmt_skip_ws(src, i, line, acc) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, acc))
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      fmt_skip_ws(src, i + 1, line, acc)
    } else {
      if c == '\t' {
        fmt_skip_ws(src, i + 1, line, acc)
      } else {
        if c == '\n' {
          fmt_skip_ws(src, i + 1, line + 1, acc)
        } else {
          if c == '\r' {
            fmt_skip_ws(src, i + 1, line, acc)
          } else {
            if c == '/' {
              if i + 1 < len {
                if str.char_at(src, i + 1) == '/' {
                  let r = fmt_scan_comment(src, i, i + 2, len)
                  let end_i = car(r)
                  let text = cdr(r)
                  let tok = cons(cons('comment, text), cons(i, cons(line, cons(text, nil))))
                  fmt_skip_ws(src, end_i, line, cons(tok, acc))
                } else {
                  cons(i, cons(line, acc))
                }
              } else {
                cons(i, cons(line, acc))
              }
            } else {
              cons(i, cons(line, acc))
            }
          }
        }
      }
    }
  }
}

fn fmt_loop(src, i, line, acc) {
  let len = str.length(src)
  let w = fmt_skip_ws(src, i, line, acc)
  let i2 = car(w)
  let line2 = car(cdr(w))
  let acc2 = cdr(cdr(w))
  if i2 >= len {
    reverse(acc2)
  } else {
    let ws_before = if i2 > i { 1 } else { 0 }
    let r = read_token(src, i2, ws_before)
    let tok = car(r)
    let next_i = cdr(r)
    let raw = str.substr(src, i2, next_i - i2)
    let t2 = cons(tok, cons(i2, cons(line2, cons(raw, nil))))
    fmt_loop(src, next_i, line2, cons(t2, acc2))
  }
}

pub fn tokenize_fmt(src) {
  fmt_loop(src, 0, 1, nil)
}

// read_string_lit: scan the content of a string literal from `i` (first
// content char) and DECODE backslash escapes into the token value.
//   \n \r \t \\ \" \'  — single-char escapes
//   \xNN               — hex byte escape (e.g. \x0d for CR)
// Unknown escapes keep backslash + char literally. An escaped quote does NOT
// terminate the string. Unterminated strings emit an 'unterminated token with
// the raw content (escapes not decoded) for error reporting.
fn read_string_lit(src, i, start, acc) {
  let len = str.length(src)
  if i >= len {
    cons(cons('unterminated, str.substr(src, start, i - start)), i)
  } else {
    let c = str.char_at(src, i)
    if c == '"' {
      cons(cons('string, acc), i + 1)
    } else {
      if c == '\\' {
        // Backslash: decode the escape sequence
        if i + 1 >= len {
          cons(cons('unterminated, str.substr(src, start, i - start)), i)
        } else {
          let e = str.char_at(src, i + 1)
          if e == 'x' {
            // \xNN hex byte escape
            let hi = hex_digit(str.char_at(src, i + 2))
            let lo = hex_digit(str.char_at(src, i + 3))
            if hi < 0 {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              } else {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              }
            } else {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))))
              } else {
                read_string_lit(src, i + 4, start, str.concat(acc, str.chr(hi * 16 + lo)))
              }
            }
          } else {
            let v = escape_value(e)
            if v < 0 {
              // Unknown escape — keep both characters literally
              read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(e))))
            } else {
              read_string_lit(src, i + 2, start, str.concat(acc, str.chr(v)))
            }
          }
        }
      } else {
        read_string_lit(src, i + 1, start, str.concat(acc, str.chr(c)))
      }
    }
  }
}

// escape_value(c) -> int byte value, or -1 for unknown escapes
fn escape_value(c) {
  if c == 'n' { '\n' }
  else {
    if c == 'r' { '\r' }
    else {
      if c == 't' { '\t' }
      else {
        if c == '\\' { '\\' }
        else {
          if c == '"' { '"' }
          else {
            if c == '\'' { '\'' }
            else { -1 }
          }
        }
      }
    }
  }
}

// hex_digit(c) -> 0..15, or -1 when c is not a hex digit
fn hex_digit(c) {
  if c >= '0' {
    if c <= '9' { c - '0' }
    else {
      if c >= 'a' {
        if c <= 'f' { c - 'a' + 10 }
        else {
          if c >= 'A' {
            if c <= 'F' { c - 'A' + 10 }
            else { -1 }
          } else { -1 }
        }
      } else { -1 }
    }
  } else { -1 }
}

// read_number_lit: scan a numeric literal starting at src[i] (i is at the
// first digit). Decimal integers and float literals are supported; a float
// literal is digits '.' digits (digits on BOTH sides — no exponent notation,
// no "1." / ".5" shorthand). Returns cons(token, next_index):
//   digits            -> ('int, n)
//   digits '.' digits -> ('float, "digits.digits")
// The float VALUE is carried as the literal string — the bootstrap language
// has no float values, so the string flows token → AST → bytecode and the VM
// parses it with strtod at runtime.
fn read_number_lit(src, i, start) {
  let len = str.length(src)
  if i >= len {
    finish_number(src, start, len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_number_lit(src, i + 1, start)
    } else {
      if str.char_at(src, i) == '.' {
        if i + 1 < len {
          if is_digit(str.char_at(src, i + 1)) {
            read_frac_lit(src, i + 2, start)
          } else {
            // "1." — a dot with no fractional digit is NOT a float literal;
            // emit the int and let the caller choke on the dot.
            finish_number(src, start, i)
          }
        } else {
          // "1." at end of input: int, then a trailing dot (syntax error).
          finish_number(src, start, i)
        }
      } else {
        finish_number(src, start, i)
      }
    }
  }
}

// read_frac_lit: scan digits after the '.' of a float literal. i is the
// first index AFTER the dot; start is the start of the whole literal
// (the '.' is included because read_number_lit passes its own start).
fn read_frac_lit(src, i, start) {
  let len = str.length(src)
  if i >= len {
    let s = str.substr(src, start, len - start)
    cons(cons('float, s), len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_frac_lit(src, i + 1, start)
    } else {
      let s = str.substr(src, start, i - start)
      cons(cons('float, s), i)
    }
  }
}

fn finish_number(src, start, end) {
  let s = str.substr(src, start, end - start)
  cons(cons('int, str.to_int(s)), end)
}

fn read_ident(src, i, start) {
  let len = str.length(src)
  if i >= len {
    make_ident_tok(src, start, len)
  } else {
    if is_ident_char(str.char_at(src, i)) {
      read_ident(src, i + 1, start)
    } else {
      make_ident_tok(src, start, i)
    }
  }
}

fn make_ident_tok(src, start, end) {
  let s = str.substr(src, start, end - start)
  if is_kw(s) {
    cons(cons('kw, s), end)
  } else {
    cons(cons('ident, s), end)
  }
}

// read_char_lit: try to parse a char literal at src[i] (i is at a quote).
// Supports plain 'X' and the same backslash escapes as strings:
// \n \r \t \\ \" \' \xNN. Returns cons(token, next_index) on success,
// or nil when this quote is NOT a char literal (i.e. it is a quote form).
fn read_char_lit(src, i, len) {
  if i + 1 < len {
    if str.char_at(src, i + 1) == '\\' {
      // backslash escape: '\X' is 4 chars, '\xNN' is 6 chars
      if i + 2 < len {
        let e = str.char_at(src, i + 2)
        if e == 'x' {
          // \xNN hex escape: '\xNN' closing quote at i + 5
          if i + 5 < len {
            if str.char_at(src, i + 5) == '\'' {
              let hi = hex_digit(str.char_at(src, i + 3))
              let lo = hex_digit(str.char_at(src, i + 4))
              if hi >= 0 {
                if lo >= 0 { cons(cons('int, hi * 16 + lo), i + 6) }
                else { nil }
              } else { nil }
            } else { nil }
          } else { nil }
        } else {
          // single-char escape: '\X' closing quote at i + 3
          if i + 3 < len {
            if str.char_at(src, i + 3) == '\'' {
              let v = escape_value(e)
              if v < 0 { nil } else { cons(cons('int, v), i + 4) }
            } else { nil }
          } else { nil }
        }
      } else { nil }
    } else {
      // plain 'X': closing quote at i + 2
      if i + 2 < len {
        if str.char_at(src, i + 2) == '\'' {
          cons(cons('int, str.char_at(src, i + 1)), i + 3)
        } else { nil }
      } else { nil }
    }
  } else { nil }
}

fn read_token(src, i, ws_before) {
  let len = str.length(src)
  let c = str.char_at(src, i)
  match c {
    // lparen value records whether whitespace preceded it (1) or it is
    // glued to the previous token (0). The parser uses this to enforce
    // that calls are written f(x) — a spaced `(` after an identifier is
    // a syntax error, not a call opener (TA has no Lisp s-exprs).
    '(' -> cons(cons('lparen, ws_before), i + 1)
    ')' -> cons(cons('rparen, nil), i + 1)
    '{' -> cons(cons('lbrace, nil), i + 1)
    '}' -> cons(cons('rbrace, nil), i + 1)
    ',' -> cons(cons('comma, nil), i + 1)
    ':' -> cons(cons('colon, nil), i + 1)
    ';' -> cons(cons('semicol, nil), i + 1)
    '[' -> cons(cons('lbracket, nil), i + 1)
    ']' -> cons(cons('rbracket, nil), i + 1)
    '\'' -> {
      // Disambiguation (D6): 'X' (quote-char-quote) is a char literal whose
      // token value is the Unicode codepoint of X; escapes like '\n' decode
      // the same as strings. Any other use of ' is the quote form
      // ('symbol -> (quote symbol) in the parser).
      let r = read_char_lit(src, i, len)
      if null?(r) {
        cons(cons('quote, nil), i + 1)
      } else {
        r
      }
    }
    '"' -> read_string_lit(src, i + 1, i + 1, "")
    '-' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '>' {
          cons(cons('arrow, nil), i + 2)
        } else {
          if is_digit(str.char_at(src, i + 1)) {
            let r = read_number_lit(src, i + 1, i + 1)
            let tok = car(r)
            let val = cdr(tok)
            let next_i = cdr(r)
            if car(tok) == 'float {
              // Negative float: keep the sign in the literal string, e.g.
              // ('float, "-1.5") — the value is a string end-to-end.
              cons(cons('float, str.concat("-", val)), next_i)
            } else {
              cons(cons('int, 0 - val), next_i)
            }
          } else {
            cons(cons('op, "-"), i + 1)
          }
        }
      } else {
        cons(cons('op, "-"), i + 1)
      }
    }
    '=' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "=="), i + 2)
        } else {
          cons(cons('op, "="), i + 1)
        }
      } else {
        cons(cons('op, "="), i + 1)
      }
    }
    '<' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "<="), i + 2)
        } else {
          cons(cons('op, "<"), i + 1)
        }
      } else {
        cons(cons('op, "<"), i + 1)
      }
    }
    '>' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, ">="), i + 2)
        } else {
          cons(cons('op, ">"), i + 1)
        }
      } else {
        cons(cons('op, ">"), i + 1)
      }
    }
    '+' -> cons(cons('op, "+"), i + 1)
    '!' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "!="), i + 2)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      } else {
        cons(cons('unknown, nil), i + 1)
      }
    }
    '*' -> cons(cons('op, "*"), i + 1)
    '/' -> cons(cons('op, "/"), i + 1)
    '%' -> cons(cons('op, "%"), i + 1)
    '&' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '&' {
          cons(cons('op, "&&"), i + 2)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      } else {
        cons(cons('unknown, nil), i + 1)
      }
    }
    '|' -> {
      if i + 1 < len {
        let c2 = str.char_at(src, i + 1)
        if c2 == '|' {
          cons(cons('op, "||"), i + 2)
        } else if c2 == '>' {
          cons(cons('op, "|>"), i + 2)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      } else {
        cons(cons('unknown, nil), i + 1)
      }
    }
    _ -> {
      if is_digit(c) {
        read_number_lit(src, i, i)
      } else {
        if is_alpha(c) {
          read_ident(src, i, i)
        } else {
          cons(cons('unknown, nil), i + 1)
        }
      }
    }
  }
}

// ---- main tokenize path with positions (issue #66) ----
// tokenize_pos scans identically to the old tokenize_loop but also tracks
// the (line col off) of each token: 1-based line/column of the token's
// first char plus its 0-based source offset. The driver uses these to
// report parse errors with a location and a source snippet. tokenize keeps
// its original signature (plain token list) so existing callers are
// unaffected.

// skip_ws_l(src, i, line) -> (i' line'): skip whitespace and // comments,
// counting newlines so `line` stays 1-based.
fn skip_ws_l(src, i, line) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, nil))
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      skip_ws_l(src, i + 1, line)
    } else if c == '\t' {
      skip_ws_l(src, i + 1, line)
    } else if c == '\n' {
      skip_ws_l(src, i + 1, line + 1)
    } else if c == '\r' {
      skip_ws_l(src, i + 1, line)
    } else if c == '/' {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '/' {
          skip_comment_l(src, i + 2, line)
        } else {
          cons(i, cons(line, nil))
        }
      } else {
        cons(i, cons(line, nil))
      }
    } else {
      cons(i, cons(line, nil))
    }
  }
}

fn skip_comment_l(src, i, line) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, nil))
  } else {
    if str.char_at(src, i) == '\n' {
      skip_ws_l(src, i + 1, line + 1)
    } else {
      skip_comment_l(src, i + 1, line)
    }
  }
}

// 0-based offset of the first character of the line containing `i`.
fn pos_line_start(src, i) {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == '\n' {
      i
    } else {
      pos_line_start(src, i - 1)
    }
  }
}

// 1-based column of offset `i` within its line.
fn line_col(src, i) {
  i - pos_line_start(src, i) + 1
}

// Position entry for a token starting at `off` on `line`: (line col off).
fn mk_pos(src, off, line) {
  cons(line, cons(line_col(src, off), cons(off, nil)))
}

// tokenize_pos_loop(src, i, line, tacc, pacc) -> (tokens . positions)
// Token list and position list are built in parallel (same order, same
// length); both include the trailing 'eof' token, whose position is the
// end-of-file location.
fn tokenize_pos_loop(src, i, line, tacc, pacc) {
  let len = str.length(src)
  let w = skip_ws_l(src, i, line)
  let i2 = car(w)
  let line2 = car(cdr(w))
  if i2 >= len {
    let toks = reverse(cons(cons('eof, nil), tacc))
    let poss = reverse(cons(mk_pos(src, i2, line2), pacc))
    cons(toks, poss)
  } else {
    let ws_before = if i2 > i { 1 } else { 0 }
    let result = read_token(src, i2, ws_before)
    let tok = car(result)
    let next_i = cdr(result)
    tokenize_pos_loop(src, next_i, line2, cons(tok, tacc), cons(mk_pos(src, i2, line2), pacc))
  }
}

// tokenize_pos(src) -> (tokens . positions): tokens identical to
// tokenize(src), plus one (line col off) entry per token.
pub fn tokenize_pos(src) {
  tokenize_pos_loop(src, 0, 1, nil, nil)
}

pub fn tokenize(src) {
  car(tokenize_pos(src))
}
