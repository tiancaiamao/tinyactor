// tokenizer.ta — TA 源 → List(Token)
//
// 一个 token 是**具名变体**：种类 +（可选）载荷 + 源偏移 `at`。旧编码是一个
// 点对 (tag . val) 外面再套一层平行的「位置表」，读的人得数 car/cdr 才知道
// 哪层是什么，而同一个 cdr 里有时是 Int、有时是 String。
//
// 位置只留 `at`（0-based 源偏移）一份，行/列由 line_of / col_of 从 src + at
// 现算。旧的 tokenize_pos 把 (line col off) 也做成一张并行表，多行字符串那
// 一路还得靠 line_delta 维护第二份行号（issue #91）—— 一份数据没法漂移。
import "tinyactor:lib/option"
import "tinyactor:lib/str"

pub fn is_digit(c) {
  match c {
    '0' -> true
    '1' -> true
    '2' -> true
    '3' -> true
    '4' -> true
    '5' -> true
    '6' -> true
    '7' -> true
    '8' -> true
    '9' -> true
    _ -> false
  }
}

pub fn is_alpha(c) {
  match c {
    'A' -> true
    'B' -> true
    'C' -> true
    'D' -> true
    'E' -> true
    'F' -> true
    'G' -> true
    'H' -> true
    'I' -> true
    'J' -> true
    'K' -> true
    'L' -> true
    'M' -> true
    'N' -> true
    'O' -> true
    'P' -> true
    'Q' -> true
    'R' -> true
    'S' -> true
    'T' -> true
    'U' -> true
    'V' -> true
    'W' -> true
    'X' -> true
    'Y' -> true
    'Z' -> true
    'a' -> true
    'b' -> true
    'c' -> true
    'd' -> true
    'e' -> true
    'f' -> true
    'g' -> true
    'h' -> true
    'i' -> true
    'j' -> true
    'k' -> true
    'l' -> true
    'm' -> true
    'n' -> true
    'o' -> true
    'p' -> true
    'q' -> true
    'r' -> true
    's' -> true
    't' -> true
    'u' -> true
    'v' -> true
    'w' -> true
    'x' -> true
    'y' -> true
    'z' -> true
    '_' -> true
    _ -> false
  }
}

pub fn is_ident_char(c) {
  if is_alpha(c) {
    true
  } else {
    if is_digit(c) {
      true
    } else {
      match c {
        '.' -> true
        '+' -> true
        '-' -> true
        '<' -> true
        '>' -> true
        '=' -> true
        '!' -> true
        '?' -> true
        '*' -> true
        '/' -> true
        _ -> false
      }
    }
  }
}

fn reverse_helper(lst, acc) {
  if null?(lst) {
    acc
  } else {
    reverse_helper(cdr(lst), cons(car(lst), acc))
  }
}

fn reverse(lst) {
  reverse_helper(lst, nil)
}

pub fn is_kw(s) {
  match s {
    "fn" -> true
    "let" -> true
    "match" -> true
    "if" -> true
    "else" -> true
    "when" -> true
    "spawn" -> true
    "send" -> true
    "import" -> true
    "receive" -> true
    "pub" -> true
    "type" -> true
    "external" -> true
    "const" -> true
    "nil" -> true
    "true" -> true
    "false" -> true
    _ -> false
  }
}

// ---------- 表示 ----------
//
// 一个 token = 种类 +（可选）载荷 + `at`（0-based 源偏移，指向首字符）。
// 载荷的种类由变体本身钉住：Int 的只有 TInt / TLparen，其余是 String 或
// 无载荷。TLparen 的载荷是「'(' 前有没有空白」（1/0）：调用必须写 f(x)，
// 空开的 `f (x)` 是语法错误而非调用（TA 没有 Lisp s-expr）。
//
// 变体名不是随手起的：C 侧把 token 压扁进 token vec 时，按「'T' + 标签首
// 字母大写」把它折回解析器用的裸标签（TInt ↔ 'int，TEof ↔ 'eof）。改名前先
// 看一眼 test/basic/tokvec-api.ta —— 它钉住这条约定。
//
// 字符字面量 'X' 也走 TInt（载荷就是码点）：VM 里它就是一个 int。
pub type Token {
  TComment(text : String, at : Int)
  TUnterminated(raw : String, at : Int)
  TString(s : String, at : Int)
  TFloat(lit : String, at : Int)
  TInt(n : Int, at : Int)
  TKw(s : String, at : Int)
  TIdent(s : String, at : Int)
  TOp(op : String, at : Int)
  TLparen(ws : Int, at : Int)
  TRparen(at : Int)
  TLbrace(at : Int)
  TRbrace(at : Int)
  TComma(at : Int)
  TColon(at : Int)
  TSemicol(at : Int)
  TLbracket(at : Int)
  TRbracket(at : Int)
  TQuote(at : Int)
  TArrow(at : Int)
  TSpread(at : Int)
  TUnknown(at : Int)
  TEof(at : Int)
}

pub fn tok_at(t : Token) -> Int {
  match t {
    TComment(_, at) -> at
    TUnterminated(_, at) -> at
    TString(_, at) -> at
    TFloat(_, at) -> at
    TInt(_, at) -> at
    TKw(_, at) -> at
    TIdent(_, at) -> at
    TOp(_, at) -> at
    TLparen(_, at) -> at
    TRparen(at) -> at
    TLbrace(at) -> at
    TRbrace(at) -> at
    TComma(at) -> at
    TColon(at) -> at
    TSemicol(at) -> at
    TLbracket(at) -> at
    TRbracket(at) -> at
    TQuote(at) -> at
    TArrow(at) -> at
    TSpread(at) -> at
    TUnknown(at) -> at
    TEof(at) -> at
  }
}

// 种类标签。fmt 按种类排版；解析一路读的是 vm.tok_type，C 侧压扁 token vec
// 时按变体名折出同一批标签（见上面 Token 的注释）。
pub fn tok_tag(t : Token) -> Symbol {
  match t {
    TComment(_, _) -> 'comment
    TUnterminated(_, _) -> 'unterminated
    TString(_, _) -> 'string
    TFloat(_, _) -> 'float
    TInt(_, _) -> 'int
    TKw(_, _) -> 'kw
    TIdent(_, _) -> 'ident
    TOp(_, _) -> 'op
    TLparen(_, _) -> 'lparen
    TRparen(_) -> 'rparen
    TLbrace(_) -> 'lbrace
    TRbrace(_) -> 'rbrace
    TComma(_) -> 'comma
    TColon(_) -> 'colon
    TSemicol(_) -> 'semicol
    TLbracket(_) -> 'lbracket
    TRbracket(_) -> 'rbracket
    TQuote(_) -> 'quote
    TArrow(_) -> 'arrow
    TSpread(_) -> 'spread
    TUnknown(_) -> 'unknown
    TEof(_) -> 'eof
  }
}

// 一份人读的描述，进 parse error 的 `(token <desc>)` 槽：定界符写成它自己
// （'(' / '}'），其余写成带引号的载荷（'foo'、'42'），没有载荷的种类退回
// 通用 'token'。**逐字节对用户可见**，负例测试依赖它，别随手改。
pub fn tok_text(t : Token) -> String {
  match t {
    TEof(_) -> "'eof'"
    TLparen(_, _) -> "'('"
    TRparen(_) -> "')'"
    TLbracket(_) -> "'['"
    TRbracket(_) -> "']'"
    TLbrace(_) -> "'{'"
    TRbrace(_) -> "'}'"
    TComment(text, _) -> quoted(text)
    TUnterminated(raw, _) -> quoted(raw)
    TString(s, _) -> quoted(s)
    TFloat(lit, _) -> quoted(lit)
    TKw(s, _) -> quoted(s)
    TIdent(s, _) -> quoted(s)
    TOp(op, _) -> quoted(op)
    TInt(n, _) -> quoted(str.from_int(n))
    TComma(_) -> "'token'"
    TColon(_) -> "'token'"
    TSemicol(_) -> "'token'"
    TQuote(_) -> "'token'"
    TArrow(_) -> "'token'"
    TSpread(_) -> "'token'"
    TUnknown(_) -> "'token'"
  }
}

fn quoted(s) -> String {
  str.concat("'", str.concat(s, "'"))
}

// ---------- 位置：偏移 → 行列 ----------
//
// 都从 (src, at) 现算：位置只有 at 一份数据，行列是它的投影。

// 1-based 行号 = src[0, off) 里 '\n' 的个数 + 1。逐行跳到下一个 '\n'：一次
// C 级扫描一行（--cov 每条语句算一次，逐字节的 TA 循环付不起）。
pub fn line_of(src, off) -> Int {
  count_nl(src, 0, off, 1)
}

fn count_nl(src, i, stop, n) -> Int {
  if i >= stop {
    n
  } else {
    let j = str.index_of_char(src, i, '\n')
    if j < 0 { n }
    else if j >= stop { n }
    else { count_nl(src, j + 1, stop, n + 1) }
  }
}

// 1-based 列号 = off 到所在行行首的距离 + 1。
pub fn col_of(src, off) -> Int {
  off - pos_line_start(src, off) + 1
}

// 0-based offset of the first character of the line containing `i`.
fn pos_line_start(src, i) -> Int {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == '\n' {
      i
    } else {
      pos_line_start(src, i - 1)
    }
  }
}

// ---------- 扫描 ----------
//
// 分工：子扫描器只交**载荷 + 下一个下标**（它们看的不是 token 的第一个字符，
// 或还要对载荷做算术：负数），read_token 一处署名种类与 `at`。
//
// 每个子扫描器一个具名类型，别把 (载荷 . 下标) 塞回点对：载荷有 Int 也有
// String，点对读的人分不出，编译器也拦不住。

// 扫描产物：token + 下一个下标 + token 内部吃掉的行数。line_delta 只服务
// fmt（它按行排版，增量行号最省）；主 token 流的行号由 at 现算。
type Scanned {
  Scanned(tok : Token, next : Int, line_delta : Int)
}

fn scanned_tok(s : Scanned) -> Token { match s { Scanned(t, _, _) -> t } }
fn scanned_next(s : Scanned) -> Int { match s { Scanned(_, n, _) -> n } }
fn scanned_line_delta(s : Scanned) -> Int { match s { Scanned(_, _, d) -> d } }

// 字符串字面量：闭合 / 未闭合（未闭合带原文，供报错）。
type StrScan {
  StrLit(text : String, next : Int, line_delta : Int)
  StrUnterm(raw : String, next : Int, line_delta : Int)
}

// 数字字面量：整数 / 浮点。浮点的值是**字面量文本**（bootstrap 没有浮点值，
// 文本一路流到 VM，装载期由 strtod 取值）。
type NumScan {
  NumInt(n : Int, next : Int)
  NumFloat(lit : String, next : Int)
}

// 标识符（含关键字，由调用方按 is_kw 分流）。
type IdentScan {
  IdentScan(name : String, next : Int)
}

// 'X' 字符字面量：码点 + 下一个下标。None = 这个 ' 不是字符字面量，是引用
// 形式（'sym → (quote sym)，见 read_token 的 '\'' 分支）。
type CharLit {
  CharLit(code : Int, next : Int)
}

// read_string_lit: scan the content of a string literal from `i` (first
// content char) and DECODE backslash escapes into the token value.
//   \n \r \t \\ \" \'  — single-char escapes
//   \xNN               — hex byte escape (e.g. \x0d for CR)
// Unknown escapes keep backslash + char literally. An escaped quote does NOT
// terminate the string. Unterminated strings report the raw content (escapes
// not decoded) for error reporting.
// line_delta is the number of '\n' consumed inside the literal, so callers
// counting lines incrementally stay 1-based across multi-line strings
// (issue #91).
fn read_string_lit(src, i, start, acc, line_delta) -> StrScan {
  let len = str.length(src)
  if i >= len {
    let raw = str.substr(src, start, i - start)
    StrUnterm(raw, i, line_of(raw, str.length(raw)) - 1)
  } else {
    let c = str.char_at(src, i)
    if c == '"' {
      StrLit(acc, i + 1, line_delta)
    } else {
      if c == '\\' {
        // Backslash: decode the escape sequence
        if i + 1 >= len {
          let raw = str.substr(src, start, i - start)
          StrUnterm(raw, i, line_of(raw, str.length(raw)) - 1)
        } else {
          let e = str.char_at(src, i + 1)
          if e == 'x' {
            // \xNN hex byte escape
            let hi = hex_digit(str.char_at(src, i + 2))
            let lo = hex_digit(str.char_at(src, i + 3))
            if hi < 0 {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              } else {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              }
            } else {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              } else {
                read_string_lit(src, i + 4, start, str.concat(acc, str.chr(hi * 16 + lo)), line_delta)
              }
            }
          } else {
            let v = escape_value(e)
            if v < 0 {
              // Unknown escape — keep both characters literally
              read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(e))), line_delta)
            } else {
              read_string_lit(src, i + 2, start, str.concat(acc, str.chr(v)), line_delta)
            }
          }
        }
      } else {
        // A raw newline in the source (not a \n escape) advances the line.
        let nd = if c == '\n' { line_delta + 1 } else { line_delta }
        read_string_lit(src, i + 1, start, str.concat(acc, str.chr(c)), nd)
      }
    }
  }
}

// escape_value(c) -> int byte value, or -1 for unknown escapes
fn escape_value(c) {
  if c == 'n' { '\n' }
  else {
    if c == 'r' { '\r' }
    else {
      if c == 't' { '\t' }
      else {
        if c == '\\' { '\\' }
        else {
          if c == '"' { '"' }
          else {
            if c == '\'' { '\'' }
            else { -1 }
          }
        }
      }
    }
  }
}

// hex_digit(c) -> 0..15, or -1 when c is not a hex digit
fn hex_digit(c) {
  if c >= '0' {
    if c <= '9' { c - '0' }
    else {
      if c >= 'a' {
        if c <= 'f' { c - 'a' + 10 }
        else {
          if c >= 'A' {
            if c <= 'F' { c - 'A' + 10 }
            else { -1 }
          } else { -1 }
        }
      } else { -1 }
    }
  } else { -1 }
}

// read_number_lit: scan a numeric literal starting at src[i] (i is at the
// first digit). Decimal integers and float literals are supported; a float
// literal is digits '.' digits (digits on BOTH sides — no exponent notation,
// no "1." / ".5" shorthand).
//   digits            -> NumInt(n, next)
//   digits '.' digits -> NumFloat("digits.digits", next)
fn read_number_lit(src, i, start) -> NumScan {
  let len = str.length(src)
  if i >= len {
    finish_number(src, start, len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_number_lit(src, i + 1, start)
    } else {
      if str.char_at(src, i) == '.' {
        if i + 1 < len {
          if is_digit(str.char_at(src, i + 1)) {
            read_frac_lit(src, i + 2, start)
          } else {
            // "1." — a dot with no fractional digit is NOT a float literal;
            // emit the int and let the caller choke on the dot.
            finish_number(src, start, i)
          }
        } else {
          // "1." at end of input: int, then a trailing dot (syntax error).
          finish_number(src, start, i)
        }
      } else {
        finish_number(src, start, i)
      }
    }
  }
}

// read_frac_lit: scan digits after the '.' of a float literal. i is the
// first index AFTER the dot; start is the start of the whole literal
// (the '.' is included because read_number_lit passes its own start).
fn read_frac_lit(src, i, start) -> NumScan {
  let len = str.length(src)
  if i >= len {
    NumFloat(str.substr(src, start, len - start), len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_frac_lit(src, i + 1, start)
    } else {
      NumFloat(str.substr(src, start, i - start), i)
    }
  }
}

fn finish_number(src, start, end) -> NumScan {
  NumInt(str.to_int(str.substr(src, start, end - start)), end)
}

fn read_ident(src, i, start) -> IdentScan {
  let len = str.length(src)
  if i >= len {
    IdentScan(str.substr(src, start, len - start), len)
  } else {
    if is_ident_char(str.char_at(src, i)) {
      read_ident(src, i + 1, start)
    } else {
      IdentScan(str.substr(src, start, i - start), i)
    }
  }
}

// read_char_lit: try to parse a char literal at src[i] (i is at a quote).
// Supports plain 'X' and the same backslash escapes as strings:
// \n \r \t \\ \" \' \xNN. Returns Some(CharLit) on success, or None when this
// quote is NOT a char literal (i.e. it is a quote form).
fn read_char_lit(src, i, len) -> option.Option(CharLit) {
  if i + 1 < len {
    if str.char_at(src, i + 1) == '\\' {
      // backslash escape: '\X' is 4 chars, '\xNN' is 6 chars
      if i + 2 < len {
        let e = str.char_at(src, i + 2)
        if e == 'x' {
          // \xNN hex escape: '\xNN' closing quote at i + 5
          if i + 5 < len {
            if str.char_at(src, i + 5) == '\'' {
              let hi = hex_digit(str.char_at(src, i + 3))
              let lo = hex_digit(str.char_at(src, i + 4))
              if hi >= 0 {
                if lo >= 0 { option.Some(CharLit(hi * 16 + lo, i + 6)) }
                else { option.None }
              } else { option.None }
            } else { option.None }
          } else { option.None }
        } else {
          // single-char escape: '\X' closing quote at i + 3
          if i + 3 < len {
            if str.char_at(src, i + 3) == '\'' {
              let v = escape_value(e)
              if v < 0 { option.None } else { option.Some(CharLit(v, i + 4)) }
            } else { option.None }
          } else { option.None }
        }
      } else { option.None }
    } else {
      // plain 'X': closing quote at i + 2
      if i + 2 < len {
        if str.char_at(src, i + 2) == '\'' {
          option.Some(CharLit(str.char_at(src, i + 1), i + 3))
        } else { option.None }
      } else { option.None }
    }
  } else { option.None }
}

// read_token: one token at src[i] (i is its first char) → Scanned.
// `ws_before` is 1 when whitespace precedes the token (TLparen carries it).
fn read_token(src, i, ws_before) -> Scanned {
  let len = str.length(src)
  let c = str.char_at(src, i)
  match c {
    '(' -> Scanned(TLparen(ws_before, i), i + 1, 0)
    ')' -> Scanned(TRparen(i), i + 1, 0)
    '{' -> Scanned(TLbrace(i), i + 1, 0)
    '}' -> Scanned(TRbrace(i), i + 1, 0)
    ',' -> Scanned(TComma(i), i + 1, 0)
    ':' -> Scanned(TColon(i), i + 1, 0)
    ';' -> Scanned(TSemicol(i), i + 1, 0)
    '[' -> Scanned(TLbracket(i), i + 1, 0)
    ']' -> Scanned(TRbracket(i), i + 1, 0)
    '\'' -> {
      // Disambiguation (D6): 'X' (quote-char-quote) is a char literal whose
      // token value is the Unicode codepoint of X; escapes like '\n' decode
      // the same as strings. Any other use of ' is the quote form
      // ('symbol -> (quote symbol) in the parser).
      match read_char_lit(src, i, len) {
        option.Some(CharLit(code, next)) -> Scanned(TInt(code, i), next, 0)
        option.None -> Scanned(TQuote(i), i + 1, 0)
      }
    }
    '"' -> {
      match read_string_lit(src, i + 1, i + 1, "", 0) {
        StrLit(text, next, line_delta) -> Scanned(TString(text, i), next, line_delta)
        StrUnterm(raw, next, line_delta) -> Scanned(TUnterminated(raw, i), next, line_delta)
      }
    }
    '-' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '>' {
          Scanned(TArrow(i), i + 2, 0)
        } else {
          if is_digit(str.char_at(src, i + 1)) {
            match read_number_lit(src, i + 1, i + 1) {
              // Negative float: keep the sign in the literal string, e.g.
              // TFloat("-1.5") — the value is a string end-to-end.
              NumFloat(lit, next) -> Scanned(TFloat(str.concat("-", lit), i), next, 0)
              NumInt(n, next) -> Scanned(TInt(0 - n, i), next, 0)
            }
          } else {
            Scanned(TOp("-", i), i + 1, 0)
          }
        }
      } else {
        Scanned(TOp("-", i), i + 1, 0)
      }
    }
    '=' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          Scanned(TOp("==", i), i + 2, 0)
        } else {
          Scanned(TOp("=", i), i + 1, 0)
        }
      } else {
        Scanned(TOp("=", i), i + 1, 0)
      }
    }
    '<' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          Scanned(TOp("<=", i), i + 2, 0)
        } else if str.char_at(src, i + 1) == '>' {
          // `<>` — string concat (Gleam spelling). Same shape as the other
          // infix ops: one token whose value is the operator text; the parser
          // desugars it to the promised builtin (str.concat a b).
          Scanned(TOp("<>", i), i + 2, 0)
        } else {
          Scanned(TOp("<", i), i + 1, 0)
        }
      } else {
        Scanned(TOp("<", i), i + 1, 0)
      }
    }
    '>' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          Scanned(TOp(">=", i), i + 2, 0)
        } else {
          Scanned(TOp(">", i), i + 1, 0)
        }
      } else {
        Scanned(TOp(">", i), i + 1, 0)
      }
    }
    '+' -> Scanned(TOp("+", i), i + 1, 0)
    '!' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          Scanned(TOp("!=", i), i + 2, 0)
        } else {
          Scanned(TUnknown(i), i + 1, 0)
        }
      } else {
        Scanned(TUnknown(i), i + 1, 0)
      }
    }
    '*' -> Scanned(TOp("*", i), i + 1, 0)
    // `..` 是记录更新/带标签构造的展开前缀（Ctor(..base, f: v)）。标识符
    // 可以从含 `.` 的字符集里**延续**（str.concat、mod.member），但永不
    // 以 `.` 开头，所以只有独立的 `..` 落到这个分支；单个 `.` 不是任何
    // TA 语法的开头，仍报 unknown。
    '.' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '.' {
          Scanned(TSpread(i), i + 2, 0)
        } else {
          Scanned(TUnknown(i), i + 1, 0)
        }
      } else {
        Scanned(TUnknown(i), i + 1, 0)
      }
    }
    '/' -> Scanned(TOp("/", i), i + 1, 0)
    '%' -> Scanned(TOp("%", i), i + 1, 0)
    '&' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '&' {
          Scanned(TOp("&&", i), i + 2, 0)
        } else {
          Scanned(TUnknown(i), i + 1, 0)
        }
      } else {
        Scanned(TUnknown(i), i + 1, 0)
      }
    }
    '|' -> {
      if i + 1 < len {
        let c2 = str.char_at(src, i + 1)
        if c2 == '|' {
          Scanned(TOp("||", i), i + 2, 0)
        } else if c2 == '>' {
          Scanned(TOp("|>", i), i + 2, 0)
        } else {
          // A lone `|` is its own token: the list-pattern rest separator
          // ([h | t], issue #118). No expression rule consumes it, so
          // `a | b` stays a compile error — parse_operand rejects the token
          // by name rather than letting it degrade into a call argument.
          Scanned(TOp("|", i), i + 1, 0)
        }
      } else {
        Scanned(TUnknown(i), i + 1, 0)
      }
    }
    _ -> {
      if is_digit(c) {
        match read_number_lit(src, i, i) {
          NumInt(n, next) -> Scanned(TInt(n, i), next, 0)
          NumFloat(lit, next) -> Scanned(TFloat(lit, i), next, 0)
        }
      } else {
        if is_alpha(c) {
          match read_ident(src, i, i) {
            IdentScan(name, next) -> if is_kw(name) {
              Scanned(TKw(name, i), next, 0)
            } else {
              Scanned(TIdent(name, i), next, 0)
            }
          }
        } else {
          Scanned(TUnknown(i), i + 1, 0)
        }
      }
    }
  }
}

// skip_ws(src, i) -> 下一个 token 的下标：跳过空白与 // 注释。
fn skip_ws(src, i) -> Int {
  let len = str.length(src)
  if i >= len {
    i
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      skip_ws(src, i + 1)
    } else if c == '\t' {
      skip_ws(src, i + 1)
    } else if c == '\n' {
      skip_ws(src, i + 1)
    } else if c == '\r' {
      skip_ws(src, i + 1)
    } else if c == '/' {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '/' {
          skip_comment(src, i + 2)
        } else {
          i
        }
      } else {
        i
      }
    } else {
      i
    }
  }
}

fn skip_comment(src, i) -> Int {
  let len = str.length(src)
  if i >= len {
    i
  } else {
    if str.char_at(src, i) == '\n' {
      skip_ws(src, i + 1)
    } else {
      skip_comment(src, i + 1)
    }
  }
}

fn tokenize_loop(src, i, acc : List(Token)) -> List(Token) {
  let len = str.length(src)
  let i2 = skip_ws(src, i)
  if i2 >= len {
    reverse(cons(TEof(i2), acc))
  } else {
    let ws_before = if i2 > i { 1 } else { 0 }
    let r = read_token(src, i2, ws_before)
    tokenize_loop(src, scanned_next(r), cons(scanned_tok(r), acc))
  }
}

// tokenize(src) -> List(Token)。末尾恒有一个 TEof（at = 文件尾）。
pub fn tokenize(src) -> List(Token) {
  tokenize_loop(src, 0, nil)
}

// ---------- fmt 路 ----------
//
// fmt 按行排版，要 token 的原文（raw）和行号：两者扫描时顺手就有，不必回头
// 再从 src 切一遍、数一遍行。注释在这里是 token（TComment），排版要保住它。

pub type FmtTok {
  FmtTok(tok : Token, line : Int, raw : String)
}

pub fn fmt_tok(t : FmtTok) -> Token { match t { FmtTok(tok, _, _) -> tok } }
pub fn fmt_line(t : FmtTok) -> Int { match t { FmtTok(_, line, _) -> line } }
pub fn fmt_raw(t : FmtTok) -> String { match t { FmtTok(_, _, raw) -> raw } }

// 跳过空白/注释后的游标：下一个 token 的下标、当前行、已累积的 token。
type FmtCursor {
  FmtCursor(i : Int, line : Int, acc : List(FmtTok))
}

// 注释扫描结果：注释结束处（换行符或文件尾）+ 注释原文（含 "//"）。
type CommentScan {
  CommentScan(next : Int, text : String)
}

fn fmt_scan_comment(src, start, i, len) -> CommentScan {
  if i >= len {
    CommentScan(i, str.substr(src, start, i - start))
  } else {
    if str.char_at(src, i) == '\n' {
      CommentScan(i, str.substr(src, start, i - start))
    } else {
      fmt_scan_comment(src, start, i + 1, len)
    }
  }
}

// fmt_skip_ws(src, i, line, acc) -> FmtCursor：跳过空白与注释，注释作为
// TComment 收进 acc。
fn fmt_skip_ws(src, i, line, acc : List(FmtTok)) -> FmtCursor {
  let len = str.length(src)
  if i >= len {
    FmtCursor(i, line, acc)
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      fmt_skip_ws(src, i + 1, line, acc)
    } else if c == '\t' {
      fmt_skip_ws(src, i + 1, line, acc)
    } else if c == '\n' {
      fmt_skip_ws(src, i + 1, line + 1, acc)
    } else if c == '\r' {
      fmt_skip_ws(src, i + 1, line, acc)
    } else if c == '/' {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '/' {
          match fmt_scan_comment(src, i, i + 2, len) {
            CommentScan(next, text) -> fmt_skip_ws(src, next, line, cons(FmtTok(TComment(text, i), line, text), acc))
          }
        } else {
          FmtCursor(i, line, acc)
        }
      } else {
        FmtCursor(i, line, acc)
      }
    } else {
      FmtCursor(i, line, acc)
    }
  }
}

fn fmt_loop(src, i, line, acc) -> List(FmtTok) {
  let len = str.length(src)
  match fmt_skip_ws(src, i, line, acc) {
    FmtCursor(i2, line2, acc2) -> if i2 >= len {
      reverse(acc2)
    } else {
      let ws_before = if i2 > i { 1 } else { 0 }
      let r = read_token(src, i2, ws_before)
      let raw = str.substr(src, i2, scanned_next(r) - i2)
      fmt_loop(src, scanned_next(r), line2 + scanned_line_delta(r), cons(FmtTok(scanned_tok(r), line2, raw), acc2))
    }
  }
}

pub fn tokenize_fmt(src) -> List(FmtTok) {
  fmt_loop(src, 0, 1, nil)
}
