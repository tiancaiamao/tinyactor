// bytecode.ta — .tabc 落盘器：compile AST → 文本字节码（write_bc），
// 外加 lisp 侧库文本（lib_src，driver/bridge 管线编译前拼接到单元头部）。
//
// 原「读 .lisp 文本 → sexp.parse → compile → 写 .tabc」的文件驱动
//（build()/main() + test/backend/*.lisp 夹具 + drv.ta 负例驱动）已删：
// 没有任何 runner/gate 消费它们（#286），语义覆盖由 run_bridge.sh 的
// TA AST 管线承担；.lisp 字面量方言已移除。
//
// 文件格式（全空白分隔的整数流）：
//   nfns nconsts
//   (nameidx entry nargs maxd codelen code...) × nfns
//     nameidx = 定义名常量池下标（-1 = 匿名：entry / lambda）；2.1 链接用
//     entry = 文件内绝对词下标
//   (kind ...) × nconsts    kind: 0 int val | 1 nil | 2 true | 3 false
//                                 | 4 sym len bytes | 5 str len bytes
//                                 | 6 float len bytes（文本，装载期 strtod）
// 代码里的跳转目标 = 代码节内词偏移；GLOBAL 操作数 = 常量池符号下标，
// tavm 加载期按名字解析为 fnid（.o 式链接）；符号 id = 常量池下标（去重保证唯一）。

import "tinyactor:lib/list"
import "tinyactor:lib/buffer"
import "tinyactor:lib/result"
import "tinyactor:lib/bootstrap/ast" as ast
import "tinyactor:lib/bootstrap/compile"

// ---------- 写文件 ----------
// 注意：TA 的 [x , rest] 是精确二元模式，单元素列表两臂都不命中、match
// 静默返回 nil——遍历一律用 pair? 循环。
fn write_ints(h, lst) {
  if pair?(lst) {
    buffer.push_str(h, str.concat(str.from_int(car(lst)), " "))
    write_ints(h, cdr(lst))
  } else {
    1
  }
}

fn str_to_bytes(s, i, n) {
  if i >= n {
    []
  } else {
    cons(str.char_at(s, i), str_to_bytes(s, i + 1, n))
  }
}

// sym/str 共用的 kind+len+bytes 词序列（kind 4 / 5 分别由调用方给）
fn text_words(kind, s) {
  cons(kind, cons(str.length(s), str_to_bytes(s, 0, str.length(s))))
}

// 常量池元素 → .tabc 词序列。kind 0..6 是 VM 装载协议（src/main.c 的
// parse_unit），这里与它逐条对应。池元素本来就是带类型的 ast.Const，故对
// Const 做穷尽 match：漏一种形状是编译错误，而不是静默写出错位的字节流
// ——旧的「裸原子 + int?/string?/symbol? 逐个排除」写法正是在 bool 上错过
//（true / false 被擦成 kind 0 的 int 0，而 int 0 在 tavm 里是 truthy）。
fn const_words(c : ast.Const) -> List(Int) {
  match c {
    // kind 1 = nil，无操作数
    ast.CNil -> cons(1, nil)
    ast.CTrue -> cons(2, nil)
    ast.CFalse -> cons(3, nil)
    ast.CInt(v) -> cons(0, cons(v, nil))
    // 符号 / 字符串：kind + len + UTF-8 bytes
    ast.CSym(name) -> text_words(4, str.sym_to_str(name))
    ast.CStr(s) -> text_words(5, s)
    // 浮点：文本原样入池（kind 6 = len + bytes），tavm 加载期 strtod —— 与
    // parser/codegen 的文本端到端约定一致
    ast.CFloat(text) -> text_words(6, text)
  }
}

fn write_consts(h, consts : List(ast.Const)) {
  if null?(consts) {
    1
  } else {
    write_ints(h, const_words(car(consts)))
    write_consts(h, cdr(consts))
  }
}

// entry = 代码首词的绝对下标；起始 8 = 3(文件头) + 5(首记录头)；
// 每个 fn 贡献 5(头：nameidx entry nargs maxd codelen) + codelen
// nameidx = 定义名在常量池里的下标。池元素是 ast.Const，故符号只需认
// CSym；别的形状（int/str/float…）跳过但仍占一个下标 —— 下标即池位置。
fn sym_pool_idx(pool : List(ast.Const), sym : Symbol, k) -> Int {
  if null?(pool) {
    -1
  } else {
    match car(pool) {
      ast.CSym(name) -> {
        if name == sym { k } else { sym_pool_idx(cdr(pool), sym, k + 1) }
      }
      _ -> sym_pool_idx(cdr(pool), sym, k + 1)
    }
  }
}

fn write_fns(h, fns, consts : List(ast.Const), entry) {
  if pair?(fns) {
    match car(fns) {
      compile.FnBC(name, nargs, maxd, code) -> {
        // nameidx：Named(sym) → 符号的常量池下标；Anon（entry / lambda）
        // → -1。loader 建名字→fnid 表，GLOBAL 重定位用（2.1 链接）
        let ni = match name {
          compile.Named(sym) -> sym_pool_idx(consts, sym, 0)
          compile.Anon -> -1
        }
        buffer.push_str(h, str.concat(str.from_int(ni), " "))
        buffer.push_str(h, str.concat(str.from_int(entry), " "))
        buffer.push_str(h, str.concat(str.from_int(nargs), " "))
        buffer.push_str(h, str.concat(str.from_int(maxd), " "))
        buffer.push_str(h, str.concat(str.from_int(list.length(code)), " "))
        write_ints(h, code)
        write_fns(h, cdr(fns), consts, entry + 5 + list.length(code))
      }
    }
  } else {
    1
  }
}

// 图像头首词 = 图像格式版本，必须与 ta.h 的 TA_BC_VERSION 同值。
//
// 一个数写在两种语言里是必然的：.ta 编译器读不到 ta.h，C 装载器读不到这里。
// 不为此加一致性门 —— 版本门（main.c parse_unit）本身就是那把锁：两处不等
// 就当场 fatal，而 ta.h 一改就会重建 tavm、再重建 lib/bootstrap.tabc，
// 漏 bump 的一天内必然死在 `make bootstrap` 上，不会拖到运行期。
fn bc_version_word() -> String { "4 " }

// 常量池的落盘形状逐条对 VM 的装载协议（kind 0..6，见 const_words），池
// 元素就是 compile 侧交来的 ast.Const —— 这里不再过一层「Const → 裸原子」
// 的桥：那层桥只在 write_consts 里做运行期类型排除，且体会把 bool 擦成 int。
// 池里存符号本体是硬要求：write_fns 的 nameidx 就是「名字符号在池中的下标」
//（sym_pool_idx）。
pub fn write_bc(path, fns, consts : List(ast.Const)) {
  match buffer.new() {
    result.Ok(h) -> {
      let pool = consts
      // 头 3 词：version nfns nconsts。装载器（main.c parse_unit）读到旧版本
      // 直接 fatal —— 槽号布局随编译器协议演进，旧图像在新 VM 上是错位字节流，
      // 静默执行比 loud 失败危险得多。
      buffer.push_str(h, bc_version_word())
      buffer.push_str(h, str.concat(str.from_int(list.length(fns)), " "))
      buffer.push_str(h, str.concat(str.from_int(list.length(pool)), " "))
      write_fns(h, fns, pool, 8)
      write_consts(h, pool)
      write_out(h, path)
    }
    result.Err(_) -> -1
  }
}

// 收尾：to_string 出快照 → close 交还 slot → file.write 整串落盘。
// file.write 是 truncate-on-open 的全量 fwrite；.tabc 是纯空白分隔文本、
// 无 NUL，与旧的逐字节 buf.write_to 写出的字节流等价。close 不是装饰：
// 旧的 buf 没有 free，同一进程第 257 次 write_bc 就再也拿不到句柄。
fn write_out(h, path) {
  match buffer.to_string(h) {
    result.Ok(s) -> {
      buffer.close(h)
      file.write(path, s)
    }
    result.Err(_) -> -1
  }
}

fn member(x, xs) {
  if pair?(xs) {
    if car(xs) == x { true } else { member(x, cdr(xs)) }
  } else {
    false
  }
}

// lisp 侧库函数：纯用现有词表写出来的定义，以**文本**前置到每个编译单元
//（旧 prelude.lisp + sexp 前置已删：异构 cons 在 TA 类型层过不去，文本拼接
// 不碰类型层）。print/println 不在这里——它们是宿主原生，VM 运行期按名
// 解析，无需声明。
pub fn lib_src() {
  "(define null? (lambda (x) (eq? x nil))) "
}
