// bytecode.ta — .tabc 落盘器：compile AST → 文本字节码（write_bc），
// 外加 lisp 侧库文本（lib_src，driver/bridge 管线编译前拼接到单元头部）。
//
// 原「读 .lisp 文本 → sexp.parse → compile → 写 .tabc」的文件驱动
//（build()/main() + test/backend/*.lisp 夹具 + drv.ta 负例驱动）已删：
// 没有任何 runner/gate 消费它们（#286），语义覆盖由 run_bridge.sh 的
// TA AST 管线承担；.lisp 字面量方言支持在 ROADMAP 里已记「已移除」。
//
// 文件格式（全空白分隔的整数流）：
//   nfns nconsts
//   (nameidx entry nargs maxd codelen code...) × nfns
//     nameidx = 定义名常量池下标（-1 = 匿名：entry / lambda）；2.1 链接用
//     entry = 文件内绝对词下标
//   (kind ...) × nconsts    kind: 0 int val | 1 nil | 2 true | 3 false
//                                 | 4 sym len bytes | 5 str len bytes
// 代码里的跳转目标 = 代码节内词偏移；GLOBAL 操作数 = 常量池符号下标，
// tavm 加载期按名字解析为 fnid（.o 式链接）；符号 id = 常量池下标（去重保证唯一）。

import list
import buffer
import result
import "bootstrap/top" as top

// ---------- 写文件 ----------
// 注意：TA 的 [x , rest] 是精确二元模式，单元素列表两臂都不命中、match
// 静默返回 nil——遍历一律用 pair? 循环。
fn write_ints(h, lst) {
  if pair?(lst) {
    buffer.push_str(h, str.concat(str.from_int(car(lst)), " "))
    write_ints(h, cdr(lst))
  } else {
    1
  }
}

fn str_to_bytes(s, i, n) {
  if i >= n {
    []
  } else {
    cons(str.char_at(s, i), str_to_bytes(s, i + 1, n))
  }
}

// sym/str 共用的 kind+len+bytes 词序列（kind 4 / 5 分别由调用方给）
fn text_words(kind, s) {
  cons(kind, cons(str.length(s), str_to_bytes(s, 0, str.length(s))))
}

fn const_words(a) {
  if pair?(a) {
    if car(a) == 'float && string?(car(cdr(a))) && null?(cdr(cdr(a))) {
      // 浮点字面量 ('float "1.5")：文本原样入池（kind 6 = len + UTF-8
      // bytes，同字符串布局），tavm 加载期 strtod —— 与 parser/codegen
      // 的文本端到端约定一致
      text_words(6, car(cdr(a)))
    } else {
      // quoted list 已从 quote 支持中移除；混入到这里的 pair 是编译器 bug 或
      // 误用，故意写 kind -1 让 tavm 加载期 fatal("bad const kind") 拒绝
      cons(-1, nil)
    }
  } else {
    if null?(a) {
      // VM 常量 kind 1 = nil，无操作数
      cons(1, nil)
    } else {
      if symbol?(a) {
        text_words(4, str.sym_to_str(a))
      } else {
        if int?(a) {
          // a 静态 symbol-typed、运行期是 int；list.nth 擦除类型
          let ai = list.nth(cons(a, 0), 0)
          cons(0, cons(ai, nil))
        } else {
          if string?(a) {
            // 字符串常量：kind 5 + len + UTF-8 bytes
            text_words(5, a)
          } else {
            // 剩下只可能是 bool。sexp.parse 会把 true/false 直接读成 TA bool，
            // 而 int?/string?/symbol?/null? 都接受 any 参数，逐个排除后即
            // 唯一确定。必须显式区分：若沿用「非 nil 非 symbol 即 int」的旧
            // 写法，true 和 false 都会被擦成 kind 0/int 0，而 int 0 在
            // tavm 里是 truthy，false 永远为真。
            if a == true { cons(2, nil) } else { cons(3, nil) }
          }
        }
      }
    }
  }
}

fn write_consts(h, consts) {
  if pair?(consts) {
    write_ints(h, const_words(car(consts)))
    write_consts(h, cdr(consts))
  } else {
    1
  }
}

// entry = 代码首词的绝对下标；起始 7 = 2(文件头) + 5(首记录头)；
// 每个 fn 贡献 5(头：nameidx entry nargs maxd codelen) + codelen
fn sym_pool_idx(pool, sym, k) {
  if pair?(pool) {
    if car(pool) == sym {
      k
    } else {
      sym_pool_idx(cdr(pool), sym, k + 1)
    }
  } else {
    -1
  }
}

fn write_fns(h, fns, consts, entry) {
  if pair?(fns) {
    match car(fns) {
      FnBC(name, nargs, maxd, code) -> {
        // nameidx：Named(sym) → 符号的常量池下标；Anon（entry / lambda）
        // → -1。loader 建名字→fnid 表，GLOBAL 重定位用（2.1 链接）
        let ni = match name {
          Named(sym) -> sym_pool_idx(consts, sym, 0)
          Anon -> -1
        }
        buffer.push_str(h, str.concat(str.from_int(ni), " "))
        buffer.push_str(h, str.concat(str.from_int(entry), " "))
        buffer.push_str(h, str.concat(str.from_int(nargs), " "))
        buffer.push_str(h, str.concat(str.from_int(maxd), " "))
        buffer.push_str(h, str.concat(str.from_int(list.length(code)), " "))
        write_ints(h, code)
        write_fns(h, cdr(fns), consts, entry + 5 + list.length(code))
      }
    }
  } else {
    1
  }
}

// 常量池的落盘形状是**裸原子**（kind 1..6，见 const_words）；compile 侧交来的
// 是带类型的 Const，故 write_bc 入口过一把 top.const_atom ——Const → 原子的
// 唯一权威在 top.ta（同一映射也供 .kl / form 层共用）。池里存符号本体是
// 硬要求：write_fns 的 nameidx 就是「名字符号在池中的下标」（sym_pool_idx）。
pub fn write_bc(path, fns, consts) {
  match buffer.new() {
    Ok(h) -> {
      let pool = list.map(top.const_atom, consts)
      // 头 3 词：version nfns nconsts。版本词与 ta.h 的 TA_BC_VERSION
      // 镜像：装载器（main.c parse_unit）读到旧版本直接 fatal —— 槽号
      // 布局随编译器协议演进，旧图像在新 VM 上是错位字节流，静默执行
      // 比 loud 失败危险得多。
      buffer.push_str(h, "3 ")
      buffer.push_str(h, str.concat(str.from_int(list.length(fns)), " "))
      buffer.push_str(h, str.concat(str.from_int(list.length(pool)), " "))
      write_fns(h, fns, pool, 8)
      write_consts(h, pool)
      write_out(h, path)
    }
    Err(_) -> -1
  }
}

// 收尾：to_string 出快照 → close 交还 slot → file.write 整串落盘。
// file.write 是 truncate-on-open 的全量 fwrite；.tabc 是纯空白分隔文本、
// 无 NUL，与旧的逐字节 buf.write_to 写出的字节流等价。close 不是装饰：
// 旧的 buf 没有 free，同一进程第 257 次 write_bc 就再也拿不到句柄。
fn write_out(h, path) {
  match buffer.to_string(h) {
    Ok(s) -> {
      buffer.close(h)
      file.write(path, s)
    }
    Err(_) -> -1
  }
}

fn member(x, xs) {
  if pair?(xs) {
    if car(xs) == x { true } else { member(x, cdr(xs)) }
  } else {
    false
  }
}

// lisp 侧库函数：纯用现有词表写出来的定义，以**文本**前置到每个编译单元
//（旧 prelude.lisp + sexp 前置已删：异构 cons 在 TA 类型层过不去，文本拼接
// 不碰类型层）。print/println 不在这里——它们是宿主原生，VM 运行期按名
// 解析，无需声明。
pub fn lib_src() {
  "(define null? (lambda (x) (eq? x nil))) "
}
