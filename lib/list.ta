// list module: cons-list helpers.
// Pure functions built on cons/car/cdr/null? + recursion. None of them
// mutate their inputs; list-building functions return fresh cons cells
// (append shares b's tail, matching the reference hand-written style).

pub fn length(lst) {
  if null?(lst) {
    0
  } else {
    1 + length(cdr(lst))
  }
}

// nth: 0-based element access; out-of-bounds or non-list returns nil.
pub fn nth(lst, n) {
  if null?(lst) {
    nil
  } else {
    if pair?(lst) {
      if n == 0 {
        car(lst)
      } else {
        nth(cdr(lst), n - 1)
      }
    } else {
      nil
    }
  }
}

// append: new list a ++ b; a's cells are copied, b's tail is shared.
pub fn append(a, b) {
  if null?(a) {
    b
  } else {
    cons(car(a), append(cdr(a), b))
  }
}

// reverse: new list, tail-recursive with accumulator.
pub fn reverse(lst) {
  reverse_acc(nil, lst)
}

fn reverse_acc(acc, lst) {
  if null?(lst) {
    acc
  } else {
    reverse_acc(cons(car(lst), acc), cdr(lst))
  }
}

pub fn take(n, lst) {
  if n == 0 {
    nil
  } else {
    if null?(lst) {
      nil
    } else {
      cons(car(lst), take(n - 1, cdr(lst)))
    }
  }
}

// map: apply f to each element, order preserved.
pub fn map(f, lst) {
  if null?(lst) {
    nil
  } else {
    cons(f(car(lst)), map(f, cdr(lst)))
  }
}

// filter: keep elements where f(x) is true, order preserved.
pub fn filter(f, lst) {
  if null?(lst) {
    nil
  } else {
    if f(car(lst)) {
      cons(car(lst), filter(f, cdr(lst)))
    } else {
      filter(f, cdr(lst))
    }
  }
}

// foldl: left fold, f(acc, elem) applied left to right.
pub fn foldl(f, acc, lst) {
  if null?(lst) {
    acc
  } else {
    foldl(f, f(acc, car(lst)), cdr(lst))
  }
}
