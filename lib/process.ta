// process module: Go os/exec-style child processes.
//
// C implementation: lib/process.c (lazily dlopen'd on first call) —
// on the opaque Resource value (docs/c-resource-design.md): the state
// (child pid + the two parent-side pipe fds) is a per-allocation
// payload, the per-holder header carries ownership, and release has
// four paths (close / GC / actor death / VM teardown) so a forgotten
// Proc never leaks an fd or an unreaped child. The constructor is the
// capability: `Proc` wraps the C-owned payload value, forging a raw
// value is a type error, and the C side only checks liveness +
// ownership.
//
// Spawn shape (Go os/exec.Command): run(cmd, argv) execs `cmd` with
// argv[0] = cmd followed by the list elements — the list does NOT
// repeat the program. The child's stdin/stdout are pipes (its stderr is
// inherited); the parent-held ends are O_NONBLOCK and their fds are
// handed out raw so they go through the same net.read / net.write /
// poller path as sockets (net.c signal vocabulary: string = data,
// 'eof = child closed, nil = not ready → retry, -1 = error).
//
//   run(cmd, argv)   -> Ok(Proc); Err("spawn failed") on any spawn
//                       failure (bad types, missing cmd, pipe / fork)
//   stdin_w(p)       -> fd of the child's stdin (write end), or a
//                       negative hard error (-1 released/invalid,
//                       -2 not owner — p was sent to another actor).
//                       The fd is BORROWED: it goes to net.write, and
//                       the module closes it — do NOT net.close() it
//                       yourself. Use close_stdin(p) to signal eof.
//   stdout_r(p)      -> fd of the child's stdout (read end), same
//                       borrowing rule and error signals as stdin_w
//   close_stdin(p)   -> 1 after closing the child's stdin pipe (the
//                       child sees eof); -1 already closed / released,
//                       -2 not owner
//   wait(p)          -> exit code (>= 0) of a normal exit; -1 on a
//                       released handle, waitpid error, or abnormal
//                       termination; -2 not owner. Reaps the child,
//                       closes the remaining pipe fds and releases the
//                       resource — later operations see Err/closed.
//   close(p)         -> the not-yet-waited cleanup path: close both
//                       pipes + graceful reap (blocking waitpid until
//                       the child exits on its own — no signal is sent;
//                       a runaway child keeps close() blocked).
//                       Idempotent for every copy (returns 1); -1 when
//                       released/invalid, -2 not owner. wait followed
//                       by close is also 1.
//
// The fd accessors / wait / close keep raw negative ints as their
// hard-error signals (callers test < 0; signatures unchanged).
//
// Sharing: a Proc crosses actors only by send, which transfers
// ownership — the sender's copy then reports -2 and the receiver's
// works. When the owner dies or drops the last reference without
// wait/close, the release backstop closes the pipes, kills the child
// and reaps it (see lib/process.c dtor).
//
import result

type Proc {
  P(Resource)
}

external fn process.raw_run(cmd, argv) -> a
external fn process.raw_stdin_w(h) -> Int
external fn process.raw_stdout_r(h) -> Int
external fn process.raw_wait(h) -> Int
external fn process.raw_close(h) -> Int
external fn process.raw_close_stdin(h) -> Int

// raw_run returns the resource on success and Int -1 on failure (the
// `a` return type keeps that duality honest); int? dispatches — there
// is no resource? predicate by design (docs/c-resource-design.md §7).
pub fn run(cmd : String, argv) {
  let r = process.raw_run(cmd, argv)
  if int?(r) {
    Err("spawn failed")
  } else {
    Ok(P(r))
  }
}

// Raw fd accessors: a negative int is the hard error
// (docs/c-module.md §4); the fd itself feeds net.read / net.write.
pub fn stdin_w(p : Proc) {
  match p {
    P(h) -> process.raw_stdin_w(h)
  }
}

pub fn stdout_r(p : Proc) {
  match p {
    P(h) -> process.raw_stdout_r(h)
  }
}

pub fn wait(p : Proc) {
  match p {
    P(h) -> process.raw_wait(h)
  }
}

pub fn close(p : Proc) {
  match p {
    P(h) -> process.raw_close(h)
  }
}

// Signal eof to a child reading stdin: closes the write end of the
// child's stdin pipe. The pipe fds belong to the module, so this — not
// net.close(stdin_w(p)) — is the way to end the child's input.
pub fn close_stdin(p : Proc) {
  match p {
    P(h) -> process.raw_close_stdin(h)
  }
}
