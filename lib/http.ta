;; http — dynamically loaded C module example
;;
;; This file tells the TA compiler that "http" is a C module.
;; The actual implementation is in lib/http.c, built as lib/http.so.
;;
;; The module is auto-loaded at runtime when http.response or
;; http.parse_request is called — no -L flag or vm.load_c_module needed.
;;
;; Build the shared library:
;;   make lib/http.so