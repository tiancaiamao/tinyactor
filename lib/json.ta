// json module: RFC 8259 JSON parser + value accessors, built on mpc.
//
// The grammar's token level (numbers — the historical weak spot) is a real
// combinator pipeline: `-? int frac? exp?` with int = "0" | [1-9][0-9]*,
// frac = "." digit+, exp = [eE] [+-]? digit+. Malformed numbers therefore
// fail at the exact offending offset through the mpc error channel, never
// silently accepted ("1e" is not 1.0, "01" is not 1). Strings, arrays and
// objects are hand-written fn(s, i) parsers (mpc's documented escape hatch
// for hand parsers): they thread a nesting depth and raise errors with
// mpc.err_at so every failure merges into the same channel — line/col come
// free via mpc.fmt_err.
//
// Value representation (same shape as go.blog's json.ta, but NOT a drop-in
// replacement — three same-name API divergences, see below):
//   JStr(s) / JInt(n) / JFloat(f) / JBool(b) / JNull / JArr(items) / JObj(d)
// JArr items are a list; JObj wraps a Dict(string -> Json) (dict.str_cmp):
// keys are unique and traversal is in ascending key order. The accessors
// keep the historical assoc-list shape — object_fields yields Field(key,
// value) records in ascending key order — and object_dict exposes the raw
// Dict for O(log n) lookup / ordered fold.
//
// Differences from go.blog's json.ta (migrating go.blog consumers):
//   1. parse error behavior: go.blog's parse is fail-fast (prints the error
//      and crashes on bad input); here parse returns nil on error and the
//      fail-fast variant is parse_or_fail — switch call sites that relied
//      on the crash to parse_or_fail, or nil-check parse results.
//   2. object_fields element shape: go.blog fields are (bare-string . value)
//      cells with the key directly comparable as a string; here a field is a
//      Field(key, value) record whose key is a JStr value — unwrap it with
//      string_value (or field_key) before string-comparing keys.
//   3. duplicate object keys: go.blog object_get is first-wins; here the
//      keys collapse (JObj is a dict) and the LAST value wins (documented
//      decision below, pinned by tests).
//
// Documented semantics decisions (all pinned by tests):
//   - objects are dict-backed (dict.str_new): a key binds once — duplicate
//     keys collapse to ONE field and the LAST value wins (jansson-style).
//     object_get / object_dict are O(log n) dict lookups; field order
//     everywhere is ascending key order (dict str_cmp), NOT document
//     order (pinned by tests).
//   - write(): compact JSON text, no spaces. Object keys ascending.
//     Strings escape " \ and control chars (short forms, then \u00xx);
//     raw non-ASCII bytes pass through unvalidated (same policy as parse).
//     Floats render via str.from_float ("%g"); a rendering with no '.'
//     or exponent gets ".0" appended so a whole float stays a float on
//     re-parse. Non-finite floats (only constructible by user arithmetic,
//     never by parse) render as invalid JSON text — out of scope.
//   - a lone "-" / "0" mantissa keeps its literal kind: no frac/exp => int
//     ("-0" is JInt(0)), any frac/exp => float ("-0.0" is JFloat(0.0)).
//   - \uXXXX escapes: surrogate pairs (D800-DBFF + DC00-DFFF) are merged
//     into one codepoint and UTF-8 encoded. A LONE surrogate (unpaired or
//     inverted) is a parse error — the strict reading of RFC 8259 ("the
//     ABNF permits ... but ... unpredictability"), matching Rust/Go.
//   - raw non-ASCII bytes inside strings pass through unvalidated (VM
//     strings are byte strings; UTF-8 well-formedness of raw bytes is the
//     producer's responsibility). \u escapes are always properly encoded.
//   - nesting depth: values may nest up to max_depth() (512) levels.
//     Deeper input is rejected with "nesting too deep" instead of letting
//     recursive descent exhaust the VM stack.
//   - integers: VM ints are 48-bit; an integer literal outside
//     [-140737488355328, 140737488355327] is a parse error (strict, no
//     silent wraparound). Use a float literal (1e18 style) for magnitudes.
//   - floats: parsed as IEEE double via Horner accumulation over the
//     digits, then scaled by a power of ten. ~15-17 significant digits
//     (double precision), NOT correctly-rounded like C strtod. Underflow
//     yields 0.0. Overflow (magnitude > ~1.7e308) is a parse error — the
//     VM cannot represent -Inf, so we refuse both signs symmetrically.
//   - accessor signatures are unannotated on purpose: annotating the value
//     parameter (e.g. is_string(v : Json)) makes the typechecker reject
//     json-mpc.ta with a spurious "cannot unify float with int" at a
//     distant call site — an unresolved typechecker limitation, not a
//     signature problem (json.write / csv.write carry full annotations
//     where the checker accepts them). Revisit when the checker fixes this.

import "tinyactor:lib/mpc"
import "tinyactor:lib/result"
import "tinyactor:lib/dict"
import "tinyactor:lib/option"
import "tinyactor:lib/list"
import "tinyactor:lib/str"
import "tinyactor:lib/buffer"

pub type Json {
  JStr(s)
  JInt(n)
  JFloat(f)
  JBool(b)
  JNull
  JArr(items)
  JObj(fields)
}

// Field: one object member as object_fields hands it out — the key as a JStr
// value (the historical go.blog shape: compare it via string_value) plus the
// member's value.
pub type Field {
  Field(key, value)
}

// field_key / field_value: the Field accessors (a match beats car/cdr).
pub fn field_key(f) {
  match f {
    Field(k, _) -> k
  }
}

pub fn field_value(f) {
  match f {
    Field(_, v) -> v
  }
}

// ---------- configuration ----------

// Maximum value nesting (arrays/objects counting each level). 512 accepts
// JSONTestSuite's 500-deep i_ case while bounding recursive descent well
// below any stack pressure. Exposed so callers know the contract.
pub fn max_depth() {
  512
}

// VM ints are 48-bit signed: [-2^47, 2^47-1]. The value +2^47 itself is
// NOT representable in .ta source (it wraps to -2^47 at tokenize time),
// so the accepted JSON integer range is the symmetric [-(2^47-1), 2^47-1]
// — matching what a .ta author can write. Documented decision.
const int48_max = 140737488355327

// ---------- parsing: shared helpers ----------

fn is_ws(c) {
  if c == ' ' { true }
  else if c == '\t' { true }
  else if c == '\n' { true }
  else { c == '\r' }
}

// skip JSON whitespace (and only that — formfeed & friends are errors)
fn skip_ws(s, i) {
  if i < str.length(s) {
    if is_ws(str.char_at(s, i)) {
      skip_ws(s, i + 1)
    } else {
      i
    }
  } else {
    i
  }
}

fn is_digit_c(c) {
  and(c >= '0', c <= '9')
}

// hex digit value, or -1
fn hex_val(c) {
  if is_digit_c(c) {
    c - '0'
  } else {
    if and(c >= 'a', c <= 'f') {
      c - 'a' + 10
    } else {
      if and(c >= 'A', c <= 'F') {
        c - 'A' + 10
      } else {
        -1
      }
    }
  }
}

// ---------- parsing: numbers (mpc combinator grammar) ----------

// NumParts: the four slots of number = "-"? int frac? exp?, in source order.
// A declared record, not a cons chain: the slots differ in type (a sign flag,
// the integer digit chars, and two optional parts), which cons — a list
// builder — cannot carry.
type NumParts {
  NumParts(neg : Bool, ip : List(Int), fr : option.Option(List(Int)), ex : option.Option(Exp))
}

// Exp: the exponent part [eE] [+-]? digit+
type Exp {
  Exp(neg : Bool, digits : List(Int))
}

// Mag: a magnitude under construction. Floats never travel as bare
// parameters (the typechecker does not infer through them), so the numeric
// accumulators thread a Mag and unpack it into a let binding, where float
// arithmetic works.
type Mag {
  Mag(f)
}

// mpc.opt yields nil for "absent"; the parts record says absent with None
fn maybe(x) {
  if null?(x) { option.None } else { option.Some(x) }
}

// sign flag of an optional '+'/'-' (nil when absent)
fn is_minus(sg) {
  if null?(sg) { false } else { str.eq(sg, "-") }
}

// int = "0" | [1-9] [0-9]*   — yields the digit chars as a list
fn int_part() {
  mpc.choice_list([
  mpc.pmap(fn(_) { cons('0', nil) }, mpc.lit("0")),
  int_lead(),
  ])
}

fn int_lead() {
  use c < - mpc.then(mpc.range('1', '9'))
  use rest < - mpc.then(mpc.star(mpc.digit()))
  mpc.ret(cons(c, rest))
}

// frac = "." digit+ — yields the digit chars after the dot
fn frac_part() {
  use _ < - mpc.then(mpc.lit("."))
  use ds < - mpc.then(mpc.plus(mpc.digit()))
  mpc.ret(ds)
}

fn exp_char() {
  mpc.choice(mpc.lit("e"), mpc.lit("E"))
}

fn exp_sign() {
  mpc.choice(mpc.lit("+"), mpc.lit("-"))
}

// exp = [eE] [+-]? digit+ — yields Exp(neg, digit-chars)
fn exp_part() {
  use _ < - mpc.then(exp_char())
  use sg < - mpc.then(mpc.opt(exp_sign()))
  use ds < - mpc.then(mpc.plus(mpc.digit()))
  mpc.ret(Exp(is_minus(sg), ds))
}

// number = "-"? int frac? exp? — yields NumParts.
// A frac or exp that cannot complete simply fails inside opt(), so the
// number stops early and the enclosing structure fails at the leftover
// characters ("1." never parses as 1, "0.e1" never parses as 0).
fn number_grammar() {
  use neg < - mpc.then(mpc.opt(mpc.lit("-")))
  use ip < - mpc.then(int_part())
  use fr < - mpc.then(mpc.opt(frac_part()))
  use ex < - mpc.then(mpc.opt(exp_part()))
  mpc.ret(NumParts(is_minus(neg), ip, maybe(fr), maybe(ex)))
}

// Public entry: parse a JSON number at s[i]. Success yields Ok(JInt|JFloat,
// next); failure is an mpc-channel error positioned at the start of the
// number (out-of-range diagnostics point at the literal).
fn jnumber() {
  fn(s, i) {
    match number_grammar()(s, i) {
      mpc.Err(msg, pos) -> mpc.Err(msg, pos)
      mpc.Ok(parts, j) -> make_number(parts, i, j)
    }
  }
}

// convert grammar parts to JInt/JFloat; no frac and no exp means an integer
fn make_number(parts, start, j) {
  match parts {
    NumParts(neg, ip, fr, ex) ->
    if and(option.is_none(fr), option.is_none(ex)) {
      make_int(neg, ip, start, j)
    } else {
      make_float(neg, ip, fr, ex, start, j)
    }
  }
}

// the int value of the digit chars, None once it leaves the int48 range
fn make_int(neg, ip, start, j) {
  match int_acc(ip, 0) {
    option.None -> mpc.err_at("integer out of 48-bit range", start)
    option.Some(m) -> if neg { mpc.Ok(JInt(0 - m), j) } else { mpc.Ok(JInt(m), j) }
  }
}

// accumulate digit chars as an int, None on int48 overflow (the caller
// points the error at the literal's start)
fn int_acc(ds, v) {
  if null?(ds) {
    option.Some(v)
  } else {
    let d = car(ds) - '0'
    if v > (int48_max - d) / 10 {
      option.None
    } else {
      int_acc(cdr(ds), v * 10 + d)
    }
  }
}

// 10.0^k for k >= 0, by repeated multiplication (exact up to 10^22,
// good enough as a scaling factor at double precision)
fn pow10f(k : Int) -> Float {
  if k <= 0 {
    1.0
  } else {
    10.0 * pow10f(k - 1)
  }
}

// overflow threshold: ~1.7e308, just below DBL_MAX. Magnitudes above it
// are refused (the VM cannot represent -Inf, so we refuse both signs).
fn float_max() {
  17.0 * pow10f(307)
}

// NOTE ON FLOATS: since the strict numeric tower (issue #92) mixing int and
// float operands is a type error, and named-fn float param annotations do not
// participate in inference. Floats therefore never travel as bare parameters:
// they ride in a Mag record and are unpacked into a let binding, where float
// arith works (see test/basic/float-arith.ta). Digit chars cross the tower
// boundary via int.to_float.

// accumulate digit chars onto mag (Horner), None once the magnitude passes
// float_max() — VM inf/overflow never gets constructed (note: VM division
// yields IEEE inf, and inf > float_max() is true, so the guard below also
// catches any inf produced upstream). The caller points the error at the
// literal's start.
fn float_acc(ds, mag : Mag) -> option.Option(Mag) {
  if null?(ds) {
    option.Some(mag)
  } else {
    match mag {
      Mag(v) -> {
        let w = v * 10.0 + int.to_float(car(ds) - '0')
        if w > float_max() {
          option.None
        } else {
          float_acc(cdr(ds), Mag(w))
        }
      }
    }
  }
}

// exponent digits -> int, saturating at 100000 so huge exponent strings
// (hundreds of digits) cannot wrap or loop forever
fn exp_acc(ds, v) {
  if null?(ds) {
    v
  } else {
    if v >= 100000 {
      100000
    } else {
      exp_acc(cdr(ds), v * 10 + (car(ds) - '0'))
    }
  }
}

// scale mag by 10^e10 (e10 may be negative), None on overflow;
// overflow-checked on every multiply (VM gives IEEE inf on overflow;
// inf > float_max() is true, so it is caught here), underflow degrades to
// 0.0 (accepted, RFC-typical) and short-circuits via the m == 0.0 test
fn float_scale(mag : Mag, e10 : Int) -> option.Option(Mag) {
  match mag {
    Mag(m) ->
    if m == 0.0 {
      option.Some(mag)
    } else {
      if e10 > 0 {
        let w = m * 10.0
        if w > float_max() {
          option.None
        } else {
          float_scale(Mag(w), e10 - 1)
        }
      } else {
        if e10 < 0 {
          float_scale(Mag(m / 10.0), e10 + 1)
        } else {
          option.Some(mag)
        }
      }
    }
  }
}

// the signed value of an exp part: 0 when absent
fn exponent_of(ex) {
  match ex {
    option.None -> 0
    option.Some(Exp(neg, ds)) -> if neg { 0 - exp_acc(ds, 0) } else { exp_acc(ds, 0) }
  }
}

// make_float: the int and frac digits are ONE magnitude (Horner over
// "int ++ frac"), scaled by 10^(exp - #frac digits) so the fraction lands
// where the decimal point was.
fn make_float(neg, ip, fr, ex, start, j) {
  let frd = option.unwrap_or(nil, fr)
  match float_acc(list.append(ip, frd), Mag(0.0)) {
    option.None -> mpc.err_at("float overflow", start)
    option.Some(mag) ->
    match float_scale(mag, exponent_of(ex) - list_length(frd, 0)) {
      option.None -> mpc.err_at("float overflow", start)
      option.Some(Mag(m)) -> if neg { mpc.Ok(JFloat(0.0 - m), j) } else { mpc.Ok(JFloat(m), j) }
    }
  }
}
fn list_length(l, n) {
  if null?(l) {
    n
  } else {
    list_length(cdr(l), n + 1)
  }
}

// 0-based nth of a list, nil out of range
fn list_nth(l, n) {
  if null?(l) {
    nil
  } else {
    if n == 0 {
      car(l)
    } else {
      list_nth(cdr(l), n - 1)
    }
  }
}

// ---------- parsing: strings ----------

// parse a JSON string; i is just past the opening quote. Yields
// Ok(JStr(s), next) or an err_at failure.
fn jstring(s, i) {
  str_body(s, i, "")
}

fn str_body(s, i, acc) {
  let j = plain_end(s, i)
  let acc2 = str.concat(acc, str.substr(s, i, j - i))
  let c = str.char_at(s, j)
  if c == '"' {
    mpc.Ok(JStr(acc2), j + 1)
  } else {
    if c == '\\' {
      str_escape(s, j, acc2)
    } else {
      if c < ' ' {
        mpc.err_at("raw control character in string", j)
      } else {
        // char_at returns -1 past the end: unterminated string
        mpc.err_at("unterminated string", j)
      }
    }
  }
}

// end of the run of plain chars at or after i: the first byte that is
// a quote, a backslash, or a control char — three C scans, min'd, instead
// of a per-character TA loop (issue #402, light-request path).
fn plain_end(s : String, i : Int) -> Int {
  let j = first3(str.index_of_char(s, i, '"'),
  str.index_of_char(s, i, '\\'), str.index_of_ctrl(s, i))
  if j < 0 {
    str.length(s)
  } else {
    j
  }
}

// min of three index results, treating -1 (absent) as +infinity
fn first3(a, b, c) {
  let ab = if a < 0 {
    b
  } else {
    if b < 0 {
      a
    } else {
      if a < b {
        a
      } else {
        b
      }
    }
  }
  if ab < 0 {
    c
  } else {
    if c < 0 {
      ab
    } else {
      if ab < c {
        ab
      } else {
        c
      }
    }
  }
}

// one escape sequence at s[j] == '\\'
fn str_escape(s, j, acc) {
  if j + 1 >= str.length(s) {
    mpc.err_at("unterminated escape", j)
  } else {
    let e = str.char_at(s, j + 1)
    if e == 'u' {
      str_u_escape(s, j, acc)
    } else {
      let c = simple_escape_char(e)
      if c < 0 {
        mpc.err_at("invalid escape character", j + 1)
      } else {
        str_body(s, j + 2, str.concat(acc, str.chr(c)))
      }
    }
  }
}

// byte value of a simple escape, or -1 for invalid
fn simple_escape_char(e) {
  if e == '"' {
    '"'
  } else {
    if e == '\\' {
      '\\'
    } else {
      if e == '/' {
        '/'
      } else {
        if e == 'b' {
          8
        } else {
          if e == 'f' {
            12
          } else {
            if e == 'n' {
              '\n'
            } else {
              if e == 'r' {
                '\r'
              } else {
                if e == 't' {
                  '\t'
                } else {
                  -1
                }
              }
            }
          }
        }
      }
    }
  }
}

// \uXXXX (with surrogate pair merging) at s[j] == '\\'
fn str_u_escape(s, j, acc) {
  let hi = hex4(s, j + 2)
  if hi < 0 {
    mpc.err_at("expecting 4 hex digits after \\u", j)
  } else {
    if and(hi >= 55296, hi <= 56319) {
      // high surrogate: the next sequence must be \uDC00-\uDFFF
      if and(j + 7 < str.length(s), and(str.char_at(s, j + 6) == '\\', str.char_at(s, j + 7) == 'u')) {
        let lo = hex4(s, j + 8)
        if and(lo >= 56320, lo <= 57343) {
          let cp = 65536 + (hi - 55296) * 1024 + (lo - 56320)
          str_body(s, j + 12, str.concat(acc, utf8_encode(cp)))
        } else {
          mpc.err_at("invalid low surrogate after high surrogate", j)
        }
      } else {
        mpc.err_at("lone high surrogate", j)
      }
    } else {
      if and(hi >= 56320, hi <= 57343) {
        mpc.err_at("lone low surrogate", j)
      } else {
        str_body(s, j + 6, str.concat(acc, utf8_encode(hi)))
      }
    }
  }
}

// 4 hex digits starting at s[i] -> int, or -1 (also bounds-checked: a
// \u at end of input yields -1, reported as an escape error by callers)
fn hex4(s, i) {
  hex4_loop(s, i, 0, 4)
}

fn hex4_loop(s, i, v, n) {
  if n == 0 {
    v
  } else {
    if i >= str.length(s) {
      -1
    } else {
      let h = hex_val(str.char_at(s, i))
      if h < 0 {
        -1
      } else {
        hex4_loop(s, i + 1, v * 16 + h, n - 1)
      }
    }
  }
}

// UTF-8 encode a codepoint (from \u escapes; always in range — lone
// surrogates are rejected before this runs) as 1-4 bytes via str.chr.
fn utf8_encode(cp) {
  if cp < 128 {
    str.chr(cp)
  } else {
    if cp < 2048 {
      str.concat(str.chr(192 + cp / 64), str.chr(128 + cp % 64))
    } else {
      if cp < 65536 {
        str.concat(str.chr(224 + cp / 4096),
        str.concat(str.chr(128 + (cp / 64) % 64), str.chr(128 + cp % 64)))
      } else {
        str.concat(str.chr(240 + cp / 262144),
        str.concat(str.chr(128 + (cp / 4096) % 64),
        str.concat(str.chr(128 + (cp / 64) % 64), str.chr(128 + cp % 64))))
      }
    }
  }
}

// ---------- parsing: values, arrays, objects ----------

// literal keyword (true/false/null) via mpc.lit: the matched text is dropped,
// the value is the literal's Json
fn jliteral(s, i, kw, v) {
  match mpc.lit(kw)(s, i) {
    mpc.Err(msg, pos) -> mpc.Err(msg, pos)
    mpc.Ok(_, j) -> mpc.Ok(v, j)
  }
}

// parse one value at s[i] (i is at first non-ws char). depth counts the
// nesting level of the value being parsed (1 = top level).
fn pvalue(s, i, depth) {
  if depth > max_depth() {
    mpc.err_at(str.concat("nesting too deep (max ", str.concat(str.from_int(max_depth()), " levels)")), i)
  } else {
    let c = str.char_at(s, i)
    if c == '[' {
      parray(s, i + 1, depth + 1)
    } else {
      if c == '{' {
        pobject(s, i + 1, depth + 1)
      } else {
        if c == '"' {
          jstring(s, i + 1)
        } else {
          if c == 't' {
            jliteral(s, i, "true", JBool(true))
          } else {
            if c == 'f' {
              jliteral(s, i, "false", JBool(false))
            } else {
              if c == 'n' {
                jliteral(s, i, "null", JNull)
              } else {
                if or(c == '-', is_digit_c(c)) {
                  jnumber()(s, i)
                } else {
                  mpc.err_at("expecting JSON value", i)
                }
              }
            }
          }
        }
      }
    }
  }
}

// array items; i is just past '['. Tail-recursive per element.
fn parray(s, i, depth) {
  let i1 = skip_ws(s, i)
  if str.char_at(s, i1) == ']' {
    mpc.Ok(JArr(nil), i1 + 1)
  } else {
    arr_items(s, i1, depth, nil)
  }
}

// (arr_items, not array_items: the public accessor array_items(v) below
// exposes the go.blog contract; a later duplicate fn would shadow this one)
fn arr_items(s, i, depth, acc) {
  match pvalue(s, i, depth) {
    mpc.Err(msg, pos) -> mpc.Err(msg, pos)
    mpc.Ok(v, j0) -> {
      let j = skip_ws(s, j0)
      let c = str.char_at(s, j)
      if c == ']' {
        mpc.Ok(JArr(j_rev(cons(v, acc), nil)), j + 1)
      } else {
        if c == ',' {
          arr_items(s, skip_ws(s, j + 1), depth, cons(v, acc))
        } else {
          mpc.err_at("expecting ',' or ']'", j)
        }
      }
    }
  }
}

// object members; i is just past '{'. Tail-recursive per member; fields
// accumulate into the dict (duplicate keys replace in place — last wins).
fn pobject(s, i, depth) {
  let i1 = skip_ws(s, i)
  if str.char_at(s, i1) == '}' {
    mpc.Ok(JObj(dict.str_new()), i1 + 1)
  } else {
    object_pairs(s, i1, depth, dict.str_new())
  }
}

fn object_pairs(s, i, depth, d) {
  match object_member(s, i, depth) {
    mpc.Err(msg, pos) -> mpc.Err(msg, pos)
    mpc.Ok(e, j) -> {
      let d2 = dict.insert(d, dict.entry_key(e), dict.entry_val(e))
      let c = str.char_at(s, j)
      if c == '}' {
        mpc.Ok(JObj(d2), j + 1)
      } else {
        if c == ',' {
          object_pairs(s, skip_ws(s, j + 1), depth, d2)
        } else {
          mpc.err_at("expecting ',' or '}'", j)
        }
      }
    }
  }
}

// one member at s[i] (the key's opening quote): Ok(Entry(key, value), the
// index of the ',' or '}' that follows it)
fn object_member(s, i, depth) {
  // key must start with '"' — otherwise jstring would scan past the closing
  // '}' to end-of-input and report a confusing "control character" error
  if str.char_at(s, i) != '"' {
    mpc.err_at("expecting '\\\"' for object key", i)
  } else {
    match jstring(s, i + 1) {
      mpc.Err(msg, pos) -> mpc.Err(msg, pos)
      mpc.Ok(k, j) -> member_value(s, skip_ws(s, j), depth, string_value(k))
    }
  }
}

// the member's value, given its parsed key: the ':' must be at s[i]
fn member_value(s, i, depth, key) {
  if str.char_at(s, i) != ':' {
    mpc.err_at("expecting ':' after object key", i)
  } else {
    match pvalue(s, skip_ws(s, i + 1), depth) {
      mpc.Err(msg, pos) -> mpc.Err(msg, pos)
      mpc.Ok(v, j) -> mpc.Ok(dict.Entry(key, v), skip_ws(s, j))
    }
  }
}

fn j_rev(l, acc) {
  if null?(l) {
    acc
  } else {
    j_rev(cdr(l), cons(car(l), acc))
  }
}

// ---------- serialization (buffer-backed) ----------
//
// The whole document is pushed into ONE buffer and snapshotted once, so
// output size is linear in the text (the str.concat-per-fragment ladder
// would be quadratic). The buffer handle is opened per write() call and
// closed before returning; the only failure modes are the buffer table
// being full / a closed handle, neither reachable through this module —
// they abort with a message instead of inventing a return value.

// write: compact JSON text for v. Object keys in ascending (dict) order;
// see the module header for escaping / float policies.
pub fn write(v : Json) -> String {
  match buffer.new() {
    result.Ok(b) -> {
      write_value(b, v)
      match buffer.to_string(b) {
        result.Ok(s) -> {
          buffer.close(b)
          s
        }
        result.Err(e) -> write_crash(e)
      }
    }
    result.Err(e) -> write_crash(e)
  }
}

fn write_crash(e) {
  print(str.concat("json.write: buffer error: ", e))
  1 / 0
}

// push one fragment, lifting a buffer hard error to the crash path
fn buf_push(b, s) {
  match buffer.push_str(b, s) {
    result.Ok(_) -> 1
    result.Err(e) -> write_crash(e)
  }
}

// write_value: one match over the ADT. The is_*/`*_value` predicate chain
// it replaced cost a call plus a tag walk per predicate (7 deep for an
// object) — this is the per-value dispatch of every write.
fn write_value(b, v) {
  match v {
    JStr(s) -> write_string(b, s)
    JInt(n) -> buf_push(b, str.from_int(n))
    JFloat(f) -> buf_push(b, float_text(f))
    JBool(t) -> if t {
      buf_push(b, "true")
    } else {
      buf_push(b, "false")
    }
    JNull -> buf_push(b, "null")
    JArr(items) -> write_array(b, items)
    JObj(d) -> write_object(b, d)
  }
}

fn write_array(b, items) {
  buf_push(b, "[")
  write_items(b, items)
  buf_push(b, "]")
}

fn write_items(b, items) {
  if null?(items) {
    1
  } else {
    write_value(b, car(items))
    if null?(cdr(items)) {
      1
    } else {
      buf_push(b, ",")
      write_items(b, cdr(items))
    }
  }
}

fn write_object(b, d) {
  buf_push(b, "{")
  write_fields(b, dict.to_list(d))
  buf_push(b, "}")
}

// fields are dict Entry records in dict (ascending key) order
fn write_fields(b, fields) {
  if null?(fields) {
    1
  } else {
    let e = car(fields)
    write_string(b, dict.entry_key(e))
    buf_push(b, ":")
    write_value(b, dict.entry_val(e))
    if null?(cdr(fields)) {
      1
    } else {
      buf_push(b, ",")
      write_fields(b, cdr(fields))
    }
  }
}

// float_text: "%g" rendering, forced to keep its float kind — a whole
// value renders as "3" and would re-parse as JInt, so ".0" is appended
// when %g produced neither a '.' nor an exponent.
fn float_text(f) {
  let s = str.from_float(f)
  if has_float_mark(s, 0) {
    s
  } else {
    str.concat(s, ".0")
  }
}

fn has_float_mark(s, i) {
  if i >= str.length(s) {
    false
  } else {
    let c = str.char_at(s, i)
    if or(c == '.', or(c == 'e', c == 'E')) {
      true
    } else {
      has_float_mark(s, i + 1)
    }
  }
}

fn write_string(b, s) {
  buf_push(b, "\"")
  write_str_body(b, s, 0)
  buf_push(b, "\"")
}

// write_str_body pushes a whole run of plain chars as one substr and only
// stops at a char that needs escaping — a 64-char hex digest costs 2 pushes
// instead of 64 (issue #402, light-request path).
fn write_str_body(b, s, i) {
  let j = plain_end(s, i)
  if j > i {
    buf_push(b, str.substr(s, i, j - i))
  }
  if j < str.length(s) {
    write_escape(b, str.char_at(s, j))
    write_str_body(b, s, j + 1)
  } else {
    1
  }
}

// escape for the one non-plain char at the run's end: ", \, or a control
// char — plain_end already excluded everything else, so the last arm below
// is always c < ' '.
fn write_escape(b, c) {
  if c == '"' {
    buf_push(b, "\\\"")
  } else {
    if c == '\\' {
      buf_push(b, "\\\\")
    } else {
      if c == '\n' {
        buf_push(b, "\\n")
      } else {
        if c == '\r' {
          buf_push(b, "\\r")
        } else {
          if c == '\t' {
            buf_push(b, "\\t")
          } else {
            if c == 8 {
              buf_push(b, "\\b")
            } else {
              if c == 12 {
                buf_push(b, "\\f")
              } else {
                buf_push(b, str.concat("\\u00", hex2(c)))
              }
            }
          }
        }
      }
    }
  }
}

// two lowercase hex digits for a control char (c < 0x20)
fn hex2(c) {
  str.concat(hex_digit(c / 16), hex_digit(c % 16))
}

fn hex_digit(d) {
  if d < 10 {
    str.chr('0' + d)
  } else {
    str.chr('a' + d - 10)
  }
}

// ---------- public API: parsing ----------

// try_parse: Result(value, string) — Ok(value) or Err("line L, col C: msg").
// The error string is pre-formatted (mpc.fmt_err) so callers can surface it
// directly.
pub fn try_parse(text) {
  let r = pvalue(text, skip_ws(text, 0), 1)
  match r {
    mpc.Err(_, _) -> result.Err(mpc.fmt_err(text, r))
    mpc.Ok(v, pos) -> {
      let j = skip_ws(text, pos)
      if j == str.length(text) {
        result.Ok(v)
      } else {
        result.Err(mpc.fmt_err(text, mpc.err_at("expecting end of input", j)))
      }
    }
  }
}

// parse: the value, or nil on any error. nil is also a parse failure of
// the empty input — use try_parse when the distinction matters. (A JSON
// null inside a document is JNull, never nil, so nil unambiguously means
// "did not parse".)
pub fn parse(text) {
  match try_parse(text) {
    result.Ok(v) -> v
    result.Err(_) -> nil
  }
}

// parse_or_fail: the value, or print the error and abort the process —
// go.blog's fail-fast contract (a broken index.json should abort the
// build, not silently produce empty pages).
pub fn parse_or_fail(text) {
  match try_parse(text) {
    result.Ok(v) -> v
    result.Err(msg) -> {
      print(str.concat("json parse error: ", msg))
      1 / 0
    }
  }
}

// load: read a file and parse it (parse_or_fail semantics, with the path
// in the message); a missing/unreadable file also aborts.
pub fn load(path) {
  let s = file.read(path)
  if null?(s) {
    print(str.concat("json.load: cannot read ", path))
    1 / 0
  } else {
    match try_parse(s) {
      result.Ok(v) -> v
      result.Err(msg) -> {
        print(str.concat("json: ", str.concat(path, str.concat(": ", msg))))
        1 / 0
      }
    }
  }
}

// try_load: Result(value, string) — the non-crashing variant.
pub fn try_load(path) {
  let s = file.read(path)
  if null?(s) {
    result.Err(str.concat("cannot read ", path))
  } else {
    result.map_err(fn(msg) { str.concat(str.concat(path, ": "), msg) }, try_parse(s))
  }
}

// ---------- public API: accessors (go.blog contract) ----------

// A payload-carrying Json value is the constructor tuple — tag in slot 0,
// payload in slot 1 — so the tag is one slot read, whatever the arity.
// JNull carries no payload and is the bare 'JNull symbol: it has no tag,
// and no other value can be equal to it, which is all is_null needs.

pub fn is_string(v) { tag(v) == 'JStr }

pub fn is_int(v) { tag(v) == 'JInt }

pub fn is_float(v) { tag(v) == 'JFloat }

pub fn is_number(v) {
  or(is_int(v), is_float(v))
}

pub fn is_bool(v) { tag(v) == 'JBool }

pub fn is_null(v) {
  v == JNull
}

pub fn is_array(v) { tag(v) == 'JArr }

pub fn is_object(v) { tag(v) == 'JObj }

// tag(v) -> the constructor name a payload-carrying value starts with, or nil
// for anything else (JNull, a number, a list...). Accessors below stay
// unannotated on purpose (see the header's typechecker note).
fn tag(v) {
  if tuple?(v) { tuple-ref(v, 0) } else { nil }
}

// payload(v) -> slot 1 of a value tag said is there; nil when v is not a
// payload-carrying value at all.
fn payload(v) {
  if tuple?(v) { tuple-ref(v, 1) } else { nil }
}

// kind: symbol describing the value ('string/'number/'bool/'null/
// 'array/'object), or nil for a non-Json value.
pub fn kind(v) {
  if is_string(v) {
    'string
  } else {
    if is_number(v) {
      'number
    } else {
      if is_bool(v) {
        'bool
      } else {
        if is_null(v) {
          'null
        } else {
          if is_array(v) {
            'array
          } else {
            if is_object(v) {
              'object
            } else {
              nil
            }
          }
        }
      }
    }
  }
}

pub fn string_value(v) {
  if is_string(v) { payload(v) } else { nil }
}

pub fn int_value(v) {
  if is_int(v) { payload(v) } else { nil }
}

pub fn float_value(v) {
  if is_float(v) { payload(v) } else { nil }
}

// number_value: int for JInt, float for JFloat.
pub fn number_value(v) {
  if is_number(v) { payload(v) } else { nil }
}

pub fn bool_value(v) {
  if is_bool(v) { payload(v) } else { nil }
}

pub fn array_size(v) {
  if is_array(v) {
    list_length(payload(v), 0)
  } else {
    0
  }
}

// array_get: 0-based element access; out-of-range returns nil.
pub fn array_get(v, i) {
  if is_array(v) {
    list_nth(payload(v), i)
  } else {
    nil
  }
}

pub fn array_items(v) {
  if is_array(v) { payload(v) } else { nil }
}

// object_get: field value, or nil when missing or not an object.
// Duplicate keys: the LAST occurrence wins.
pub fn object_get(v, key) {
  if is_object(v) {
    option.unwrap_or(nil, dict.get(payload(v), key))
  } else {
    nil
  }
}

// object_dict: the raw Dict(string -> Json) backing an object (nil for a
// non-object) — O(log n) lookup and ordered fold via the dict API.
pub fn object_dict(v) {
  if is_object(v) {
    payload(v)
  } else {
    nil
  }
}

// fields as Field(key, value) records in ascending key order, the key a JStr
// value; duplicate keys collapsed (last value wins) — see the module header.
pub fn object_fields(v) {
  if is_object(v) {
    list.map(fn(e) { Field(JStr(dict.entry_key(e)), dict.entry_val(e)) }, dict.to_list(payload(v)))
  } else {
    nil
  }
}
