// coverage_html.ta — go-tool-cover style HTML report for TA program
// coverage (`--cov` covmap joined with runtime counter dumps).
//
//   tinyactor run tools/coverage_html.ta <covmap> <dump-dir> <out.html> [out-misses.txt]
//   open <out.html>
//
// Deliberately user-layer: it only consumes the covmap/dump file formats
// documented in docs/coverage-design.md, so it never enters the bootstrap
// compiler image. Lines with executed statements render green, statement
// lines never executed render red, all other lines render neutral — the
// same visual language as `go tool cover -html`.
//
// The optional 4th argument receives a plain-text miss list for tooling
// (one uncovered location per line: `fn <path> <name>` / `line <path>:<n>`)
//
// Data model note: per-file stats live in `files` (path -> [fh ft sh st])
// and per-line counts in the flat `lines` dict ("path:line" -> count).
// We deliberately do NOT nest a Dict inside another Dict's value (stdlib
// issue, tracked separately) — the flat key keeps every dict value plain.

import str
import file
import fs
import os
import dict
import list
import option
import result
import cmp

fn main() {
  let args = cdr(os.args())
  let catalog = if list.length(args) > 4 { list.nth(args, 4) } else { "" }
  if list.length(args) < 3 {
    print("usage: tinyactor run tools/coverage_html.ta <covmap> <dump-dir> <out.html> [out-misses.txt]")
    os.exit(1)
  }
  let rows = parse_rows(str.split(file.read(list.nth(args, 0)), "\n"), nil)
  let counts = read_dump_dir(list.nth(args, 1), dict.int_new())
  let acc = classify(rows, counts, dict.str_new(), dict.str_new(), nil)
  let catalog_acc = add_catalog(catalog, car(acc), car(cdr(acc)), dict.str_new())
  let lines = cdr(catalog_acc)
  file.write(list.nth(args, 2), render(car(catalog_acc), lines))
  print(str.concat("coverage html: ", list.nth(args, 2)))
  if list.length(args) >= 4 {
    let miss_path = list.nth(args, 3)
    file.write(miss_path, miss_report(car(cdr(acc)), cdr(cdr(acc))))
    print(str.concat("coverage misses: ", miss_path))
  }
}

// === parsing ===

// parse_rows: covmap lines to (id . (file . (line . name))) rows, input
// order kept. Nested pairs, not a flat list: car/cdr keep each field's
// type independent (a flat heterogeneous list unifies one element type).
fn parse_rows(lines, acc) {
  if null?(lines) {
    list.reverse(acc)
  } else {
    let fields = str.split(car(lines), " ")
    let row = if list.length(fields) == 3 {
      let id = str.to_int(list.nth(fields, 0))
      let loc = list.nth(fields, 1)
      let name = list.nth(fields, 2)
      let ci = rcolon(loc, str.length(loc) - 1)
      if ci < 0 {
        nil
      } else {
        let f = str.substr(loc, 0, ci)
        let l = str.to_int(str.substr(loc, ci + 1, str.length(loc)))
        cons(id, cons(f, cons(l, name)))
      }
    } else {
      nil
    }
    parse_rows(cdr(lines), if null?(row) { acc } else { cons(row, acc) })
  }
}

// rcolon: index of the last ':' in s, or -1.
fn rcolon(s, i) {
  if i < 0 {
    -1
  } else {
    if str.substr(s, i, 1) == ":" { i } else { rcolon(s, i - 1) }
  }
}

// read_dump_dir: sum "id count" rows of every file in dir into dict.
fn read_dump_dir(dir, d) {
  match fs.list_dir(dir) {
    Err(e) -> {
      print(str.concat("cannot list dump dir: ", dir))
      os.exit(1)
    }
    Ok(names) -> read_dump_loop(dir, names, d)
  }
}

fn read_dump_loop(dir, names, d) {
  if null?(names) {
    d
  } else {
    let path = str.concat(dir, str.concat("/", car(names)))
    let d2 = add_dump(str.split(file.read(path), "\n"), d)
    read_dump_loop(dir, cdr(names), d2)
  }
}

fn add_dump(lines, d) {
  if null?(lines) {
    d
  } else {
    let fields = str.split(car(lines), " ")
    let d2 = if list.length(fields) == 2 {
      let id = str.to_int(list.nth(fields, 0))
      dict.insert(d, id, option.unwrap_or(0, dict.get(d, id)) + str.to_int(list.nth(fields, 1)))
    } else {
      d
    }
    add_dump(cdr(lines), d2)
  }
}

// === aggregation ===

// classify: fold covmap rows (joined with dump counts) into
//   files: path -> [fn_hit fn_tot stmt_hit stmt_tot]
//   lines: "path:line" -> summed statement hit count
//   missfns: "fn <path> <name>" entries for functions with zero calls
// Returns cons(files, cons(lines, missfns)).
// Add catalog paths with zero coverage to the report's file set.
fn add_catalog(path, files, lines, seen) {
  if path == "" { cons(files, lines) } else {
    let text = file.read(path)
    add_catalog_lines(str.split(text, "\n"), files, lines, seen)
  }
}

fn add_catalog_lines(names, files, lines, seen) {
  if null?(names) { cons(files, lines) } else {
    let path = car(names)
    if path == "" || dict.has_key(seen, path) {
      add_catalog_lines(cdr(names), files, lines, seen)
    } else {
      let next_files = if dict.has_key(files, path) { files } else { dict.insert(files, path, fresh_file()) }
      let next_lines = if dict.has_key(files, path) { lines } else { add_source_lines(path, 1, list.length(str.split(file.read(path), "\n")), lines) }
      add_catalog_lines(cdr(names), next_files, next_lines, dict.insert(seen, path, 1))
    }
  }
}

fn add_source_lines(path, line, count, lines) {
  if line > count { lines } else {
    let key = line_key(path, line)
    let next = if dict.has_key(lines, key) { lines } else { dict.insert(lines, key, 0) }
    add_source_lines(path, line + 1, count, next)
  }
}

fn classify(rows, counts, files, lines, missfns) {
  if null?(rows) {
    cons(files, cons(lines, missfns))
  } else {
    let r = car(rows)
    let id = car(r)
    let f = car(cdr(r))
    let line = car(cdr(cdr(r)))
    let name = cdr(cdr(cdr(r)))
    let cnt = option.unwrap_or(0, dict.get(counts, id))
    let fd = option.unwrap_or(fresh_file(), dict.get(files, f))
    if line == 0 {
      let fd2 = dict.insert(files, f,
        cons(nth(fd, 0) + hit_bit(cnt),
        cons(nth(fd, 1) + 1, cons(nth(fd, 2), cons(nth(fd, 3), nil)))))
      let mf = if cnt > 0 {
        missfns
      } else {
        cons(str.concat("fn ", str.concat(f, str.concat(" ", name))), missfns)
      }
      classify(cdr(rows), counts, fd2, lines, mf)
    } else {
      let key = line_key(f, line)
      let old = option.unwrap_or(0, dict.get(lines, key))
      // Line-level accounting: a line is one unit; tot counts distinct
      // lines (first statement on the line), hit = any statement ran.
      let new_line = if option.is_none(dict.get(lines, key)) { 1 } else { 0 }
      let fd1 = cons(nth(fd, 0),
      cons(nth(fd, 1),
      cons(nth(fd, 2) + hit_bit(old + cnt) - hit_bit(old),
      cons(nth(fd, 3) + new_line, nil))))
      classify(cdr(rows), counts,
        dict.insert(files, f, fd1), dict.insert(lines, key, old + cnt), missfns)
    }
  }
}

fn fresh_file() {
  cons(0, cons(0, cons(0, cons(0, nil))))
}

// nth: positional access on the per-file record (small, fixed 4).
fn nth(fd, i) {
  if i == 0 {
    car(fd)
  } else {
    nth(cdr(fd), i - 1)
  }
}

fn hit_bit(n) {
  if n > 0 { 1 } else { 0 }
}

// === miss report (machine-readable) ===

// miss_report: plain text, one uncovered location per line, sorted by
// path:line — greppable feed for agents/CI. dict.to_list is key-ascending,
// so line entries come out path-major already.
fn miss_report(lines, missfns) {
  let miss_lines = list.map(
    fn(kv) { str.concat("line ", car(kv)) },
        list.filter(fn(kv) { cdr(kv) == 0 }, dict.to_list(lines)))
  str.concat("# ta coverage misses\n",
    str.concat("# fn <path> <name>    = function never called\n",
      str.concat("# line <path>:<line>  = statement line never executed\n",
        str.concat(str.join(list.append(missfns, miss_lines), "\n"), "\n"))))
}

// === rendering ===

fn render(files, lines) {
  let kv = dict.to_list(files)
  let tots = list.foldl(sum_file, cons(0, cons(0, cons(0, cons(0, nil)))), kv)
  let head = str.concat(
    str.concat("<h1>TA coverage</h1><p>",
      str.concat(str.from_int(car(tots)), str.concat("/",
        str.concat(str.from_int(nth(tots, 1)),
          str.concat(" functions, ",
            str.concat(str.from_int(nth(tots, 2)),
              str.concat("/", str.concat(str.from_int(nth(tots, 3)), " statement lines covered</p>")))))))),
    "")
  str.concat(head,
      str.concat(CSS,
        str.concat("<label>Source: <select id=\"source-select\" onchange=\"select_source(this.value)\">",
          str.concat(source_options(kv),
            str.concat("</select></label><script>function select_source(path){document.querySelectorAll('.file-section').forEach(function(s){s.hidden=s.dataset.path!==path})}</script>",
            str.concat(render_sections(kv, lines, 1), "</body></html>\n"))))))
}

fn render_sections(kv, lines, first) {
  if null?(kv) { "" } else {
    let path = car(car(kv))
    let hidden = if first == 1 { "" } else { " hidden" }
    let open = str.concat("<section class=\"file-section\" data-path=\"", esc(path))
    let open2 = str.concat(open, str.concat("\"", str.concat(hidden, ">")))
    let body = render_file(car(kv), lines)
    str.concat(open2, str.concat(body, str.concat("</section>", render_sections(cdr(kv), lines, 0))))
  }
}

fn source_options(kv) {
  if null?(kv) { "" } else {
    let path = car(car(kv))
    let selected = if null?(cdr(kv)) { " selected" } else { "" }
    let opt = str.concat("<option value=\"", esc(path))
    let opt2 = str.concat(opt, str.concat("\"", str.concat(selected, ">")))
    str.concat(opt2, str.concat(esc(path), str.concat("</option>", source_options(cdr(kv)))))
  }
}

fn sum_file(acc, kv) {
  let fd = cdr(kv)
  cons(car(acc) + nth(fd, 0),
  cons(nth(acc, 1) + nth(fd, 1),
  cons(nth(acc, 2) + nth(fd, 2),
  cons(nth(acc, 3) + nth(fd, 3), nil))))
}

// render_file: kv pair (path . [fh ft sh st]) -> one HTML section.
fn render_file(kv, lines) {
  let path = car(kv)
  let fd = cdr(kv)
  let head = str.concat(
    str.concat("<h2>", esc(path)),
    str.concat("</h2><p>",
      str.concat(str.from_int(nth(fd, 0)), str.concat("/",
        str.concat(str.from_int(nth(fd, 1)),
          str.concat(" functions &middot; ",
            str.concat(str.from_int(nth(fd, 2)),
              str.concat("/", str.concat(str.from_int(nth(fd, 3)), " statement lines</p>")))))))))
  let src = str.split(file.read(path), "\n")
  let n = list.length(src)
  str.concat(head, str.concat("<div class=\"src\">",
    str.concat(str.join(render_lines(src, path, lines, 1, n, nil), "\n"), "</div>")))
}

fn render_lines(src, path, lines, i, n, acc) {
  if i > n {
    list.reverse(acc)
  } else {
    let text = list.nth(src, i - 1)
    let cnt = option.unwrap_or(-1, dict.get(lines, line_key(path, i)))
    let cls = if cnt < 0 {
      ""
    } else {
      if cnt > 0 { "hit" } else { "miss" }
    }
    let shown = if cnt < 0 { "" } else { str.from_int(cnt) }
    let div = str.concat(
      str.concat("<div class=\"l ", str.concat(cls, "\"><span class=\"c\">")),
      str.concat(shown,
        str.concat("</span><span class=\"n\">",
          str.concat(str.from_int(i),
            str.concat("</span><span class=\"s\">", str.concat(esc(text), "</span></div>"))))))
    render_lines(src, path, lines, i + 1, n, cons(div, acc))
  }
}

fn line_key(path, i) {
  str.concat(path, str.concat(":", str.from_int(i)))
}

fn esc(s) {
  str.replace(str.replace(str.replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

const CSS = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>TA coverage</title><style>
body { font-family: menlo, monospace; font-size: 13px; margin: 1.5em; background: #f5f5f5; }
h1 { font-size: 18px; } h2 { font-size: 14px; margin: 1.2em 0 0.3em; }
.src { background: #fff; border: 1px solid #ccc; padding: 6px 0; overflow-x: auto; }
.l { white-space: pre; padding: 0 8px; }
.l.hit { background: #d4f7c5; }
.l.miss { background: #ffd6d6; }
.c { display: inline-block; width: 56px; text-align: right; margin-right: 12px; color: #555; }
.n { display: inline-block; width: 48px; text-align: right; margin-right: 12px; color: #999; }
.s { }
</style></head><body>"