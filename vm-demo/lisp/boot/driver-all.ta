  cons('define, cons(cons('wrap, cons('x, nil)),
  cons('x, nil))),
  nil))
  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  let b = assq('wrap, env)
  let sch = cdr(b)
  print(type_format(sch, s))
}

// Test L: generic recursive ADT
// type List(a) { Nil; Cons(a, List(a)) }
// (define (single x) (Cons x 'Nil))
// expect single: forall(a). a -> List(a)
// expect Nil: forall(a). List(a)
// expect Cons: forall(a). a -> List(a) -> List(a)
fn test_l() {
  print("=== Test L: generic ADT List ===")
  let prog = cons(
  cons('type, cons('List, cons(cons('a, nil),
  cons(cons('quote, cons('Nil, nil)),
  cons(cons('Cons, cons('a, cons(cons('List, cons('a, nil)), nil))), nil))))),
  cons(cons('define, cons(cons('single, cons('x, nil)),
  cons(cons('Cons, cons('x, cons(cons('quote, cons('Nil, nil)), nil))), nil))),
  nil))
  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  // single
  let bs = assq('single, env)
  print(str.concat("single: ", type_format(cdr(bs), s)))
  // Nil
  let bn = assq('Nil, env)
  print(str.concat("Nil: ", type_format(cdr(bn), s)))
  // Cons
  let bc = assq('Cons, env)
  print(str.concat("Cons: ", type_format(cdr(bc), s)))
}

// Test M: composite type annotations
// Source: fn length(lst: List(int)) -> int { ... }
//         fn unwrap(r: Result(int, string)) -> int { ... }
// AST: (type-sig length ((List int)) int)
//      (type-sig unwrap ((Result int string)) int)
fn test_m() {
  print("=== Test M: composite annotation ===")
  let prog = cons(
  cons('type-sig, cons('length,
  cons(cons(cons('List, cons('int, nil)), nil),
  cons('int, nil)))),
  cons(
  cons('type-sig, cons('unwrap,
  cons(cons(cons('Result, cons('int, cons('string, nil))), nil),
  cons('int, nil)))),
  cons(
  cons('define, cons(cons('length, cons('lst, nil)),
  cons(0, nil))),
  cons(
  cons('define, cons(cons('unwrap, cons('r, nil)),
  cons(0, nil))),
  nil))))
  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  let bl = assq('length, env)
  print(str.concat("length: ", type_format(cdr(bl), s)))
  let bu = assq('unwrap, env)
  print(str.concat("unwrap: ", type_format(cdr(bu), s)))
}

// fmt.ta — tinyactor fmt: token-stream based source formatter
//
// Layout rules (mirror the hand-written style in lib/*.ta):
//   - 2-space indent per brace/paren depth
//   - keep the original line structure: a token that starts a line in the
//     source stays on its own line; single-line blocks like `if c { 1 }`
//     are NOT split. Long lines are NOT wrapped.
//   - normalize spacing: one space around ops/'='/->/':', after ',', before '{'
//   - comments are preserved verbatim; a line-start comment is indented with
//     the block it sits in, an inline comment gets one space before it
//   - runs of blank lines collapse to one
//   - the whole file ends with exactly one trailing newline
//
// fmt token (from tokenizer.tokenize_fmt): ((type value) off line raw)
// We only need type, line and raw (the verbatim source text).
// Note: `str` was historically not imported here — the bootstrap driver
// imported it at top level and module imports were not isolated (same
// namespace). With Phase B namespacing (issue #96) fmt must declare its
// own dependency. `tokenizer` IS imported because it is a TA module we
// call directly.


fn t_type(t) { car(car(t)) }
fn t_line(t) { car(cdr(cdr(t))) }
fn t_raw(t) { car(cdr(cdr(cdr(t)))) }

// 2-space indent for depth d
fn indent_str(d) {
  if d <= 0 {
    ""
  } else {
    str.concat("  ", indent_str(d - 1))
  }
}

// update_depth: indent depth after seeing a token of `type`.
// Only braces count for indentation — parens/brackets keep the current
// indent so continuation lines stay flat (existing style: deeply nested
// calls like init_syms keep every line at 2-space).
fn update_depth(type, depth) {
  if type == 'lbrace {
    depth + 1
  } else {
    if type == 'rbrace {
      depth - 1
    } else {
      depth
    }
  }
}

// gap before an inline token: 0 or 1 space
// gap before an inline token: 0 or 1 space
fn gap(type, prev_type) {
  if prev_type == 'quote {
    0
  } else {
    if prev_type == 'lparen {
      0
    } else {
      if prev_type == 'lbracket {
        0
      } else {
        if type == 'rparen {
          0
        } else {
          if type == 'rbracket {
            0
          } else {
            if type == 'comma {
              0
            } else {
              if type == 'semicol {
                0
              } else {
                if type == 'lparen {
                  if prev_type == 'ident {
                    0
                  } else {
                    if prev_type == 'kw {
                      0
                    } else {
                      if prev_type == 'rparen {
                        0
                      } else {
                        if prev_type == 'rbracket {
                          0
                        } else {
                          if prev_type == 'lparen {
                            0
                          } else {
                            if prev_type == 'lbracket {
                              0
                            } else {
                              1
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  if type == 'lbracket {
                    0
                  } else {
                    1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// build: walk tokens, produce lines (reversed: last line first)
fn build(toks, depth, cur, out, prev_line, prev_type) {
  if null?(toks) {
    if str.length(cur) > 0 {
      cons(cur, out)
    } else {
      out
    }
  } else {
    let t = car(toks)
    let type = t_type(t)
    let line = t_line(t)
    let raw = t_raw(t)
    let rest = cdr(toks)
    if line > prev_line {
      // token starts a new line
      let out2 = if str.length(cur) > 0 {
        cons(cur, out)
      } else {
        out
      }
      let blank = line - prev_line - 1
      let out3 = if blank > 0 {
        cons("", out2)
      } else {
        out2
      }
      let d = if type == 'rbrace {
        depth - 1
      } else {
        depth
      }
      let cur2 = str.concat(indent_str(d), raw)
      build(rest, update_depth(type, depth), cur2, out3, line, type)
    } else {
      // same line as previous token
      let sp = gap(type, prev_type)
      let sep = if sp == 1 {
        " "
      } else {
        ""
      }
      let cur2 = str.concat(cur, str.concat(sep, raw))
      build(rest, update_depth(type, depth), cur2, out, prev_line, type)
    }
  }
}

// join reversed line list (last first) into a single string
fn join_rev(lst, acc) {
  if null?(lst) {
    acc
  } else {
    let h = car(lst)
    let rest = cdr(lst)
    if null?(rest) {
      str.concat(h, acc)
    } else {
      join_rev(rest, str.concat("\n", str.concat(h, acc)))
    }
  }
}

pub fn format(src) {
  let toks = tokenize_fmt(src)
  let lines = build(toks, 0, "", nil, 0, nil)
  str.concat(join_rev(lines, ""), "\n")
}

// modsig.ta — Module signature cache (Phase C, issue #99)
//
// Frozen per-module type signatures with content-hash invalidation, so a
// build skips re-typechecking modules whose signatures could not have
// changed (the Haskell .hi model: infer once at the definition site,
// reload the frozen scheme at every use site).
//
// Cache entry layout (.build/modules/<name>-<key>.sig):
//
//   TASIG1 <srclen> <sighash>\n        — header line
//   <srclen bytes: module source, verbatim>\n
//   <exports s-expression>\n
//
// The verbatim source copy makes every hit byte-exact: the 32-bit key can
// in principle collide, but an entry is only trusted after its stored
// source compares equal to the file on disk.
//
// Exports s-expr: (exports (name type...) ...) — one binding pair per
// definition the module owns (pub fn, private fn, const, type ctor).
// Privates are included so the typechecker's whole-program env — including
// the mod$priv "exists but not exported" diagnostics — is reproduced
// exactly. Schemes are the typechecker's tagged-pair representation,
// e.g. (forall (0 1) (arrow (tvar 0 0) (tvar 1 0))); quantified variables
// round-trip by id, so generic exports stay polymorphic after a reload.
//
// Valid-hash chain: key(M) = hash(source(M) + "name:sighash;" for each
// direct non-builtin import D), sighash(M) = hash(exports text). A module
// whose exports did not change keeps its sighash — editing a private
// function body invalidates only that module — while an export change
// flows into every dependent's key and forces it to recheck.


// ============================================================
// Content hash
//
// FNV-1a-flavored polynomial rolling hash, 32-bit. TA has no bitwise
// XOR/AND, so the mixing step is multiply-add; TA ints are 48-bit, so h is
// reduced mod 2^24 before the multiply to keep the product exact.
// Determinism is what matters — collisions are caught by the stored-source
// comparison on every hit.
// ============================================================

fn hash_step(h, c) {
  // TA ints are 48-bit, so the product can wrap negative; renormalize into
  // [0, 2^32) after each step so keys and stored hashes are stable strings.
  let r = ((h % 16777216) * 16777619 + c) % 4294967296
  if r < 0 { r + 4294967296 } else { r }
}

// hash chars [i, end) — recursion depth bounded by the slice size
fn hash_slice(s, i, end, h) {
  if i >= end { h }
  else { hash_slice(s, i + 1, end, hash_step(h, str.char_at(s, i))) }
}

// 1 KiB slices keep TA recursion depth ~1k even for 100KB sources.
fn hash_chunked(s, pos, len, h) {
  if pos >= len { h }
  else {
    let end = if pos + 1024 > len { len } else { pos + 1024 }
    hash_chunked(s, end, len, hash_slice(s, pos, end, h))
  }
}

pub fn str_hash(s) {
  hash_chunked(s, 0, str.length(s), 2166136261)
}

// ============================================================
// s-expr serialization of scheme binding trees
//
// Schemes contain exactly: symbols, non-negative ints, nil, proper pairs.
// ============================================================

pub fn sexpr_write(v) {
  if pair?(v) {
    str.concat("(", str.concat(sexpr_write_list(v), ")"))
  } else {
    if null?(v) { "()" }
    else {
      if int?(v) { str.from_int(v) }
      else { str.sym_to_str(v) }
    }
  }
}

fn sexpr_write_list(v) {
  if null?(v) { "" }
  else {
    if pair?(v) {
      let head = sexpr_write(car(v))
      let rest = sexpr_write_list(cdr(v))
      if rest == "" { head }
      else { str.concat(head, str.concat(" ", rest)) }
    } else {
      // improper tail — defensive; schemes are always proper lists
      str.concat(". ", sexpr_write(v))
    }
  }
}

fn rev(lst, acc) {
  if null?(lst) { acc }
  else { rev(cdr(lst), cons(car(lst), acc)) }
}

// sexpr_read(text) -> (value . ok); ok = 0 on any parse failure or
// trailing garbage, so a corrupt entry degrades to a cache miss.
pub fn sexpr_read(text) {
  let len = str.length(text)
  let r = sexpr_parse(text, 0, len)
  let pos = cdr(r)
  if pos < 0 {
    cons(nil, 0)
  } else {
    let j = sexpr_skip_ws(text, pos, len)
    if j < len { cons(nil, 0) }
    else { cons(car(r), 1) }
  }
}

fn is_ws(c) {
  if c == 32 { 1 }
  else {
    if c == 10 { 1 }
    else {
      if c == 9 { 1 }
      else {
        if c == 13 { 1 } else { 0 }
      }
    }
  }
}

fn sexpr_skip_ws(s, i, len) {
  if i >= len { i }
  else {
    if is_ws(str.char_at(s, i)) == 1 { sexpr_skip_ws(s, i + 1, len) }
    else { i }
  }
}

// sexpr_parse(s, i, len) -> (value . pos); pos = -1 signals an error.
fn sexpr_parse(s, i, len) {
  let j = sexpr_skip_ws(s, i, len)
  if j >= len {
    cons(nil, -1)
  } else {
    let c = str.char_at(s, j)
    if c == 40 {
      // '('
      sexpr_parse_list(s, j + 1, len, nil)
    } else {
      if c == 41 {
        // ')' — nothing to close here
        cons(nil, -1)
      } else {
        sexpr_parse_atom(s, j, len)
      }
    }
  }
}

fn sexpr_parse_list(s, i, len, acc) {
  let j = sexpr_skip_ws(s, i, len)
  if j >= len {
    cons(nil, -1)
  } else {
    let c = str.char_at(s, j)
    if c == 41 {
      cons(rev(acc, nil), j + 1)
    } else {
      let r = sexpr_parse(s, j, len)
      if cdr(r) < 0 { r }
      else { sexpr_parse_list(s, cdr(r), len, cons(car(r), acc)) }
    }
  }
}

fn sexpr_parse_atom(s, i, len) {
  let j = atom_end(s, i, len)
  let tok = str.substr(s, i, j - i)
  cons(car(atom_val(tok)), j)
}

fn atom_end(s, i, len) {
  if i >= len { i }
  else {
    let c = str.char_at(s, i)
    if is_ws(c) == 1 { i }
    else {
      if c == 40 { i }
      else {
        if c == 41 { i }
        else { atom_end(s, i + 1, len) }
      }
    }
  }
}

// atom_val(tok) -> (val) — a 1-element list. TA if-branches must unify,
// and an atom is int or symbol, so the value is boxed (cons/car erase the
// element type — forall(a b, a -> b) / forall(a b, a -> b -> b)).
fn atom_val(tok) {
  let len = str.length(tok)
  if len > 0 {
    let neg = if str.char_at(tok, 0) == 45 { 1 } else { 0 }
    let body = if neg == 1 { str.substr(tok, 1, len - 1) } else { tok }
    if str.length(body) > 0 {
      if all_digits(body, 0, str.length(body)) == 1 {
        let v = parse_int(body, 0, 0, str.length(body))
        if neg == 1 { cons(0 - v, nil) } else { cons(v, nil) }
      } else {
        cons(str.to_sym(tok), nil)
      }
    } else {
      cons(str.to_sym(tok), nil)
    }
  } else {
    cons(str.to_sym(tok), nil)
  }
}

fn all_digits(s, i, len) {
  if i >= len { 1 }
  else {
    let c = str.char_at(s, i)
    if c >= 48 && c <= 57 { all_digits(s, i + 1, len) }
    else { 0 }
  }
}

fn parse_int(s, i, v, len) {
  if i >= len { v }
  else { parse_int(s, i + 1, v * 10 + (str.char_at(s, i) - 48), len) }
}

// signed decimal parse for header tokens (defensive; hashes are stored
// non-negative, but a corrupt entry must not produce garbage silently)
fn parse_int_signed(tok) {
  let len = str.length(tok)
  if len > 0 {
    if str.char_at(tok, 0) == 45 {
      0 - parse_int(tok, 1, 0, len)
    } else {
      parse_int(tok, 0, 0, len)
    }
  } else {
    0
  }
}

// ============================================================
// Cache entry read/write
// ============================================================

pub fn sig_path(cachedir, name, key) {
  str.concat(cachedir, str.concat("/", str.concat(name,
  str.concat("-", str.concat(str.from_int(key), ".sig")))))
}

// sig_load_entry(text, expect_source) -> (bindings . sighash) or nil when
// the entry is absent, corrupt, hash-mismatched, or its stored source is
// not byte-identical to the file on disk (hash-collision guard).
pub fn sig_load_entry(text, expect_source) {
  if null?(text) {
    nil
  } else {
    if str.length(text) < 8 {
      nil
    } else {
      if str.substr(text, 0, 7) != "TASIG1 " {
        nil
      } else {
        let nl = str.index_of(text, "\n")
        if nl <= 7 {
          nil
        } else {
          let header = str.substr(text, 0, nl)
          let rest = str.substr(header, 7, str.length(header) - 7)
          let sp = str.index_of(rest, " ")
          if sp <= 0 {
            nil
          } else {
            let s_len_tok = str.substr(rest, 0, sp)
            let sh_tok = str.substr(rest, sp + 1, str.length(rest) - sp - 1)
            let srclen = parse_int_signed(s_len_tok)
            let sighash_hdr = parse_int_signed(sh_tok)
            sig_load_body(text, nl + 1, srclen, sighash_hdr, expect_source)
          }
        }
      }
    }
  }
}

fn sig_load_body(text, body, srclen, sighash_hdr, expect_source) {

  if srclen <= 0 {
    nil
  } else {
    if str.length(text) < body + srclen + 1 {
      nil
    } else {
      if str.char_at(text, body + srclen) != 10 {
        nil
      } else {
        let stored = str.substr(text, body, srclen)
        if stored != expect_source {
          nil
        } else {
          sig_load_exports(text, body, srclen, sighash_hdr)
        }
      }
    }
  }
}

fn sig_load_exports(text, body, srclen, sighash_hdr) {

  let etext = str.substr(text, body + srclen + 1,
  str.length(text) - (body + srclen + 1))
  // sig_store wrote etext + "\n"; hash and parse the same text it hashed.
  let elen = str.length(etext)
  let etext2 = if elen > 0 {
    if str.char_at(etext, elen - 1) == 10 {
      str.substr(etext, 0, elen - 1)
    } else {
      etext
    }
  } else {
    etext
  }
  if str_hash(etext2) != sighash_hdr {
    nil
  } else {
    let rr = sexpr_read(etext2)
    if cdr(rr) == 0 {
      nil
    } else {
      let lst = car(rr)
      if pair?(lst) == false {
        nil
      } else {
        if car(lst) == 'exports {
          cons(cdr(lst), sighash_hdr)
        } else {
          nil
        }
      }
    }
  }
}

// sig_store(cachedir, name, key, source, etext, sighash) -> int (write rc)
pub fn sig_store(cachedir, name, key, source, etext, sighash) {
  file.mkdir_p(cachedir)
  let header = str.concat("TASIG1 ",
  str.concat(str.from_int(str.length(source)),
  str.concat(" ", str.concat(str.from_int(sighash), "\n"))))
  let body = str.concat(source, str.concat("\n", str.concat(etext, "\n")))
  file.write(sig_path(cachedir, name, key), str.concat(header, body))
}

// ============================================================
// Signature contents

// ============================================================

// exports_text(bindings) — bindings: env binding pairs (name . type).
// The exact text is what sighash is taken over, so both the writer and the
// reader derive the same hash from the same bytes.
pub fn exports_text(bindings) {
  sexpr_write(cons('exports, bindings))
}

// unit_bindings(ownforms, mod, env, acc) — collect the module's env
// bindings for everything it defines: pub fn, private fn, const, and type
// constructors, in reverse form order (deterministic). Names are tried
// under both qualified spellings (mod.name / mod$name) to mirror
// rename_member_name exactly.
pub fn unit_bindings(ownforms, mod, env, acc) {
  if null?(ownforms) {
    acc
  } else {
    let f = car(ownforms)
    if pair?(f) == false {
      unit_bindings(cdr(ownforms), mod, env, acc)
    } else {
      let head = car(f)
      if head == 'define_pub {
        let base = car(car(cdr(f)))
        unit_bindings(cdr(ownforms), mod, env,
        def_binding(mod, base, env, acc))
      } else {
        if head == 'define {
          let base = car(car(cdr(f)))
          unit_bindings(cdr(ownforms), mod, env,
          def_binding(mod, base, env, acc))
        } else {
          if head == 'const {
            let base = car(cdr(f))
            unit_bindings(cdr(ownforms), mod, env,
            def_binding(mod, base, env, acc))
          } else {
            if head == 'type {
              let variants = cdr(cdr(cdr(f)))
              unit_bindings(cdr(ownforms), mod, env,
              ctor_bindings(variants, env, acc))
            } else {
              unit_bindings(cdr(ownforms), mod, env, acc)
            }
          }
        }
      }
    }
  }
}

// The unit's def names are already qualified by the driver's rename pass
// (mod.name / mod$name), so the bare name is looked up first; the prefixed
// spellings are only fallbacks.
fn def_binding(mod, base, env, acc) {
  let b = alist_assoc___modsig(base, env)
  if null?(b) == false {
    cons(b, acc)
  } else {
    let bname = str.sym_to_str(base)
    let pub_name = str.to_sym(str.concat(mod, str.concat(".", bname)))
    let b2 = alist_assoc___modsig(pub_name, env)
    if null?(b2) == false {
      cons(b2, acc)
    } else {
      let priv_name = str.to_sym(str.concat(mod, str.concat("$", bname)))
      let b3 = alist_assoc___modsig(priv_name, env)
      if null?(b3) == false { cons(b3, acc) }
      else { acc }
    }
  }
}

// variant shapes: (quote V) nullary, (Ctor f1 f2 ...) n-ary
fn ctor_bindings(variants, env, acc) {
  if null?(variants) {
    acc
  } else {
    let v = car(variants)
    let cname = if car(v) == 'quote { car(cdr(v)) } else { car(v) }
    ctor_bindings(cdr(variants), env, def_binding_val(cname, env, acc))
  }
}

fn def_binding_val(name, env, acc) {
  let b = alist_assoc___modsig(name, env)
  if null?(b) == false { cons(b, acc) }
  else { acc }
}

// unit_dep_names(ownforms, self, acc) — the module's direct non-builtin
// imports, in form order, deduplicated (the valid-hash chain inputs).
pub fn unit_dep_names(ownforms, self, acc) {
  if null?(ownforms) {
    rev(acc, nil)
  } else {
    let f = car(ownforms)
    if pair?(f) {
      if car(f) == 'import {
        // the import form's module name is a STRING (parser output), used
        // as-is — sym_to_str on a string would return nil
        let name = car(cdr(f))
        if name == self {
          unit_dep_names(cdr(ownforms), self, acc)
        } else {
          if vm.is_builtin_module(name) {
            unit_dep_names(cdr(ownforms), self, acc)
          } else {
            if dep_in(name, acc) {
              unit_dep_names(cdr(ownforms), self, acc)
            } else {
              unit_dep_names(cdr(ownforms), self, cons(name, acc))
            }
          }
        }
      } else {
        unit_dep_names(cdr(ownforms), self, acc)
      }
    } else {
      unit_dep_names(cdr(ownforms), self, acc)
    }
  }
}

fn dep_in(name, acc) {
  if null?(acc) { false }
  else {
    if car(acc) == name { true }
    else { dep_in(name, cdr(acc)) }
  }
}

// eff_key(source, dep_pairs) — the cache key: own source + every direct
// dependency's signature hash, so a changed signature anywhere upstream
// changes the key of every module downstream of it.
pub fn eff_key(source, dep_pairs) {
  str_hash(str.concat(source, dep_key_text(dep_pairs)))
}

fn dep_key_text(dep_pairs) {
  if null?(dep_pairs) {
    ""
  } else {
    str.concat(car(car(dep_pairs)),
    str.concat(":", str.concat(str.from_int(cdr(car(dep_pairs))),
    str.concat(";", dep_key_text(cdr(dep_pairs))))))
  }
}

fn alist_assoc___modsig(key, lst) {
  if null?(lst) {
    nil
  } else {
    if car(car(lst)) == key { car(lst) }
    else { alist_assoc___modsig(key, cdr(lst)) }
  }
}

// cov.ta — coverage instrumentation (phase 2).
//
// Phase 1: function-entry counters. Phase 2 adds statement / match-arm
// granularity with source lines. The pipeline slot is unchanged: after
// typecheck, before codegen.
//
// The parser (--cov builds only) wraps every statement and match/receive
// arm body in a (begin (cov.line path line) form) marker. The marker is
// an ordinary cov.<fn> call, so resolve/typecheck accept it untouched;
// instrument() walks the post-resolve forms and rewrites each marker in
// place into (begin (cov.hit k) form), assigning sequential ids and
// recording (k fn file line) rows for the covmap.
//
// Function entries keep a dedicated id (covmap line 0): the gate
// (COV_TA_MIN) still measures function coverage only. An entry row's
// file is derived from the body's first statement marker — defines
// carry no source path after resolve.
//
// The runtime sink is the C "cov" module (src/cov.c): a counter array
// shared by all actors, dumped at process exit and joined with the
// covmap for the report. cov.line is deliberately NOT registered in the
// cov module; a marker that somehow survives instrumentation is a silent
// no-op at runtime, which is why inst_loop walks every top-level form
// (defines and const-bound lambdas alike) instead of skipping non-defines.


// instrument(forms) -> (instrumented_forms . entries)
// entries: ((k name_sym file line_int) ...) in instrument order;
// line 0 = fn entry, line > 0 = statement / arm body.
pub fn instrument(forms) {
  inst_loop(forms, 0, nil, nil)
}

fn rev___covinst(xs, acc) {
  if null?(xs) { acc } else { rev___covinst(cdr(xs), cons(car(xs), acc)) }
}

fn inst_loop(forms, k, facc, eacc) {
  if null?(forms) {
    cons(rev___covinst(facc, nil), rev___covinst(eacc, nil))
  } else {
    let form = car(forms)
    if is_define(form) == 1 {
      let name = car(car(cdr(form)))
      let body = car(cdr(cdr(form)))
      let instrumented = cons('begin,
      cons(cons('cov.hit, cons(k, nil)), cons(body, nil)))
      let rb = rw(instrumented, name, k + 1, nil)
      let new_form = cons(car(form),
      cons(car(cdr(form)), cons(car(rb), nil)))
      let rows = cdr(cdr(rb))
      let efile = if null?(rows) { "" } else { car(cdr(cdr(car(rows)))) }
      let entry = cons(k, cons(name, cons(efile, cons(0, nil))))
      let eacc2 = rev___covinst(cons(entry, rows), eacc)
      inst_loop(cdr(forms), car(cdr(rb)),
      cons(new_form, facc), eacc2)
    } else {
      // Non-define top-level forms can still carry markers (e.g. a lambda
      // bound by const); rewrite them so every emitted id lands in the
      // covmap, attributing rows to the const name when present.
      let name = if car(form) == 'const { car(cdr(form)) } else { "" }
      let rb = rw(form, name, k, nil)
      let eacc2 = rev___covinst(cdr(cdr(rb)), eacc)
      inst_loop(cdr(forms), car(cdr(rb)), cons(car(rb), facc), eacc2)
    }
  }
}

// rw(e, fname, k, acc) -> (new_e . (next_k . entries_rev)).
// Generic rewrite: recurse into every subform; a marker
// (begin (cov.line f l) s) becomes (begin (cov.hit k) s) and records
// (k fname f l). Everything else is rebuilt unchanged — match arm
// triples and pattern data cannot contain a marker, and the marker
// shape (begin with a cov.line call as its sole first element) does not
// occur in user code.
fn rw(e, fname, k, acc) {
  if pair?(e) {
    if is_marker(e) == 1 {
      let loc = car(cdr(e))
      let hit = cons('cov.hit, cons(k, nil))
      // the marker consumes id k; nested markers start allocating at k + 1
      let rs = rw(car(cdr(cdr(e))), fname, k + 1, acc)
      let inner = cons('begin, cons(hit, cons(car(rs), nil)))
      let row = cons(k, cons(fname,
      cons(car(cdr(loc)), cons(car(cdr(cdr(loc))), nil))))
      let acc2 = cons(row, cdr(cdr(rs)))
      cons(inner, cons(car(cdr(rs)), acc2))
    } else {
      rw_list(e, fname, k, acc)
    }
  } else {
    cons(e, cons(k, acc))
  }
}

fn rw_list(xs, fname, k, acc) {
  if null?(xs) {
    cons(nil, cons(k, acc))
  } else {
    let h = rw(car(xs), fname, k, acc)
    let t = rw_list(cdr(xs), fname, car(cdr(h)), cdr(cdr(h)))
    // t = (new_tail . (k . acc)) — keep only the tail list, not the
    // (k . acc) spine (consing t itself would splice k/acc into the AST).
    cons(cons(car(h), car(t)), cdr(t))
  }
}

// is_marker(e): (begin (cov.line path line) form)
fn is_marker(e) {
  if pair?(e) {
    if car(e) == 'begin {
      let second = car(cdr(e))
      if pair?(second) {
        if car(second) == 'cov.line { 1 } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

// is_define(form): top-level fn definitions are (define (name . params)
// body) / (define_pub ...). Everything else (type, const, import,
// external fn, type-sig) carries no callable body and is left untouched.
fn is_define(form) {
  let head = car(form)
  if head == 'define { 1 } else if head == 'define_pub { 1 } else { 0 }
}

// write_covmap(path, entries): one "k file:line name" row per id;
// line 0 marks a function entry.
pub fn write_covmap(path, entries) {
  file.write(path, covmap_text(entries, ""))
}

fn covmap_text(entries, acc) {
  if null?(entries) {
    acc
  } else {
    let e = car(entries)
    let id_str = str.from_int(car(e))
    let file_str = car(cdr(cdr(e)))
    let line_str = str.from_int(car(cdr(cdr(cdr(e)))))
    let name_str = str.sym_to_str(car(cdr(e)))
    let loc_str = str.concat(file_str, str.concat(":", line_str))
    let row = str.concat(id_str, str.concat(" ",
    str.concat(loc_str, str.concat(" ", str.concat(name_str, "\n")))))
    covmap_text(cdr(entries), str.concat(acc, row))
  }
}
