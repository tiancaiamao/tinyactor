}

// Test E: recursive actor with monitor
// (define (loop self_pid) (monitor self_pid))
// (define (start) (spawn (lambda (p) (loop p))))
// expect start: 'a (polymorphic)
fn test_e() {
  print("=== Test E: monitor ===")
  let prog = cons(
  cons('define, cons(cons('loop, cons('self_pid, nil)),
  cons(cons('monitor, cons('self_pid, nil)), nil))),
  cons(
  cons('define, cons(cons('start, nil),
