fn test_basic_1() {
  print("=== Test 1: collect_defines ===")
  let prog1 = cons(
  cons('define, cons(cons('double, cons('x, nil)),
  cons(cons('*, cons('x, cons(2, nil))), nil))),
  nil)
  let cd1 = collect_defines(prog1, nil, nil, 0, nil)
  let env_cd1 = car(cd1)
  let binding1 = assq('double, env_cd1)
  print(null?(binding1) == false)

  print("=== Test 2: infer_define (double) ===")
  let form_double = cons('define,
  cons(cons('double, cons('x, nil)),
  cons(cons('*, cons('x, cons(2, nil))), nil)))
  let fv_d = fresh(0, 0)
  let env_d0 = extend(nil, 'double, car(fv_d))
  let id_r = infer_define(form_double, env_d0, nil, cdr(fv_d), 0)
  let env_d1 = car(id_r)
  let s_d1 = car(cdr(id_r))
  let double_binding = assq('double, env_d1)
  let double_scheme = cdr(double_binding)
  print(type_format(double_scheme, s_d1))

  print("=== Test 3: infer_define (add) ===")
  let form_add = cons('define,
  cons(cons('add, cons('x, cons('y, nil))),
  cons(cons('+, cons('x, cons('y, nil))), nil)))
  let fv_a = fresh(0, 0)
  let env_a0 = extend(nil, 'add, car(fv_a))
  let ia_r = infer_define(form_add, env_a0, nil, cdr(fv_a), 0)
  let env_a1 = car(ia_r)
  let s_a1 = car(cdr(ia_r))
  let add_binding = assq('add, env_a1)
  let add_scheme = cdr(add_binding)
  print(type_format(add_scheme, s_a1))
}

fn test_basic_2() {
  print("=== Test 4: infer_program (multi-function) ===")
  let prog2 = cons(
  cons('define, cons(cons('double, cons('x, nil)),
  cons(cons('*, cons('x, cons(2, nil))), nil))),
  cons(
  cons('define, cons(cons('quad, cons('x, nil)),
  cons(cons('double, cons(cons('double, cons('x, nil)), nil)), nil))),
  nil))
  let ip2 = infer_program(prog2)
  let env_ip2 = car(ip2)
  let s_ip2 = car(cdr(ip2))
  let quad_binding = assq('quad, env_ip2)
  let quad_scheme = cdr(quad_binding)
  print(type_format(quad_scheme, s_ip2))

  print("=== Test 5: recursive function (fact) ===")
  let prog3 = cons(
  cons('define, cons(cons('fact, cons('n, nil)),
  cons(cons('if,
  cons(cons('<=, cons('n, cons(1, nil))),
  cons(1,
  cons(cons('*, cons('n,
  cons(cons('fact, cons(cons('-, cons('n, cons(1, nil))), nil)),
  nil))), nil)))), nil))),
  nil)
  let ip3 = infer_program(prog3)
  let env_ip3 = car(ip3)
  let s_ip3 = car(cdr(ip3))
  let fact_binding = assq('fact, env_ip3)
  let fact_scheme = cdr(fact_binding)
  print(type_format(fact_scheme, s_ip3))
}

fn test_basic_3() {
  print("=== Test 6: higher-order function (map-like) ===")
  let prog4 = cons(
  cons('define, cons(cons('apply2, cons('f, cons('x, nil))),
  cons(cons('f, cons(cons('f, cons('x, nil)), nil)), nil))),
  nil)
  let ip4 = infer_program(prog4)
  let env_ip4 = car(ip4)
  let s_ip4 = car(cdr(ip4))
  let apply2_binding = assq('apply2, env_ip4)
  let apply2_scheme = cdr(apply2_binding)
  print(type_format(apply2_scheme, s_ip4))

  print("=== Test 7: type_format ===")
  print(type_format(t_int(), nil))
  print(type_format(t_string(), nil))
  print(type_format(t_bool(), nil))
  print(type_format(t_var(0, 0), nil))
  print(type_format(t_arrow(t_int(), t_int()), nil))
  print(type_format(t_arrow(t_int(), t_arrow(t_int(), t_int())), nil))
  print(type_format(t_arrow(t_arrow(t_int(), t_int()), t_int()), nil))
}

fn typecheck_run_tests() {
  test_basic_1()
  test_basic_2()
  test_basic_3()

  print("=== ALL BASIC TESTS DONE ===")

  test_a()
  test_b()
  test_c()
  test_d()
  test_e()
  test_f()

  print("=== ALL ACTOR TESTS DONE ===")

  test_g()
  test_h()
  test_i()
  test_j()
  test_k()
  test_l()
  test_m()
}

// Test J: annotated function
// Source: fn add(x: int, y: int) -> int { x + y }
// AST: (type-sig add (int int) int) (define (add x y) (+ x y))
// Expected: "int -> int -> int"
fn test_j() {
  print("=== Test J: annotated function ===")
  let prog = cons(
  cons('type-sig, cons('add,
  cons(cons('int, cons('int, nil)),
  cons('int, nil)))),
  cons(
  cons('define, cons(cons('add, cons('x, cons('y, nil))),
  cons(cons('+, cons('x, cons('y, nil))), nil))),
  nil))
  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  let b = assq('add, env)
  let sch = cdr(b)
  print(type_format(sch, s))
}

// Test K: partial annotation
// Source: fn wrap(x: int) { x }   (no return annotation)
// AST: (type-sig wrap (int) nil) (define (wrap x) x)
// Expected: "int -> int"
fn test_k() {
  print("=== Test K: partial annotation ===")
  let prog = cons(
  cons('type-sig, cons('wrap,
  cons(cons('int, nil),
  cons(nil, nil)))),
