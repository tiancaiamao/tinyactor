  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  let b = assq('counter_loop, env)
  let sch = cdr(b)
  print(type_format(sch, s))
}

// Test G: nullary ADT constructors via quote
// (type Color () (quote Red) (quote Green) (quote Blue))
// (define (f) 'Red)
// expect f: 'a -> Color
fn test_g() {
  print("=== Test G: nullary ADT ===")
  let prog = cons(
