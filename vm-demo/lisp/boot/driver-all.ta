}

// Test F: complete actor program
// (define (counter_loop state)
//   (receive-scan (lambda (msg) (if (<= msg 0) state (+ msg state)))))
// expect: int -> int
fn test_f() {
  print("=== Test F: complete actor ===")
  let prog = cons(
  cons('define, cons(cons('counter_loop, cons('state, nil)),
  cons(cons('receive-scan,
  cons(cons('lambda, cons(cons('msg, nil),
  cons(cons('if,
  cons(cons('<=, cons('msg, cons(0, nil))),
  cons('state,
  cons(cons('+, cons('msg, cons('state, nil))), nil)))), nil))), nil)), nil))),
