  let ip = infer_program(prog)
  let env = car(ip)
  let s = car(cdr(ip))
  let b = assq('main, env)
  let sch = cdr(b)
  print(type_format(sch, s))
}

// Test D: if/else branching (simulates match desugaring)
// (define (classify n) (if (<= n 0) 0 (+ n 1)))
// expect: int -> int
fn test_d() {
  print("=== Test D: if/else (match desugar) ===")
  let prog = cons(
  cons('define, cons(cons('classify, cons('n, nil)),
  cons(cons('if,
  cons(cons('<=, cons('n, cons(0, nil))),
  cons(0,
  cons(cons('+, cons('n, cons(1, nil))), nil)))), nil))),
  nil)
  let ip = infer_program(prog)
