// driver.ta — Bootstrap driver with TA import resolution










fn path_join(dir, name) {
  str.concat(str.concat(dir, "/"), str.concat(name, ".ta"))
}

fn find_last_slash(path, i) {
  if i < 0 { -1 }
  else {
    if str.char_at(path, i) == '/' { i }
    else { find_last_slash(path, i - 1) }
  }
}

fn dirname(path) {
  let idx = find_last_slash(path, str.length(path) - 1)
  if idx < 0 { "." }
  else { str.substr(path, 0, idx) }
}

// === Efficient list operations ===

fn rev_app(lst, acc) {
  if null?(lst) { acc }
  else { rev_app(cdr(lst), cons(car(lst), acc)) }
}

fn reverse(lst) { rev_app(lst, nil) }

// Parse source content with the TA tokenizer/parser.
// Returns (forms . err): err is nil on success, or an error message string.
fn parse_module_content(content, path, use_ta, with_cov) {
  let pr = if use_ta == 1 {
    // tokenize_pos also yields one (line col off) entry per token so
    // syntax/parse errors can report a location (issue #66) and --cov
    // builds can stamp statements with source lines.
    let tp = tokenize_pos(content)
    let toks = car(tp)
    let poss = cdr(tp)
    let err = check_syntax(toks, poss, content)
    if null?(err) {
      let result = if with_cov == 1 {
        parse_cov(toks, poss, path)
      } else {
        parse(toks)
      }
      let perr = find_parse_error(result)
      if null?(perr) {
        cons(result, nil)
      } else {
        let msg = car(perr)
        let tokpos = cdr(perr)
        let desc = tok_text(toks, tokpos)
        cons(nil, str.concat(str.concat(path, ": "), err_at(content, poss, tokpos, msg, desc)))
      }
    } else {
      cons(nil, str.concat(str.concat(path, ": "), err))
    }
  } else {
    let result = vm.parse_source(content)
    cons(result, nil)
  }
  // Top-level form check: bare expressions are silently ignored by the
  // typechecker, which used to turn garbage input into an empty no-op
  // program.
  if null?(cdr(pr)) {
    let ferr = check_toplevel_forms(car(pr))
    if null?(ferr) { pr }
    else { cons(nil, str.concat(str.concat(path, ": "), ferr)) }
  } else {
    pr
  }
}

// find_parse_error(forms) -> (msg . tokpos), or nil if the tree is clean.
// The parser embeds a (parse_error msg tokpos) marker form in the AST when
// it rejects a user-written form (e.g. prefix (and ...) / (or ...)); tokpos
// is the offending token index, used for the line/col in the message (see
// mk_parse_error in parser.ta). The marker can land at any depth —
// top-level, a function body, a let value, a match arm — so scan the whole
// tree for it.
fn find_parse_error(forms) {
  if pair?(forms) == false {
    nil
  } else if car(forms) == 'parse_error {
    let rest = cdr(forms)
    if pair?(rest) {
      let msg = car(rest)
      let tokpos = cdr(rest)
      if string?(msg) {
        let tp = if int?(tokpos) { tokpos } else { 0 }
        cons(msg, tp)
      } else {
        nil
      }
    } else {
      // Bare (parse_error . msg) marker without position info.
      if string?(rest) { cons(rest, 0) } else { nil }
    }
  } else {
    let fa = find_parse_error(car(forms))
    if null?(fa) { find_parse_error(cdr(forms)) }
    else { fa }
  }
}

// Every top-level form must be a declaration (define/define_pub/type/
// type-sig/import). Anything else — a bare symbol, int, or an expression
// such as `x = 1` or `1 2 3` — parses fine but is silently dropped by the
// typechecker, producing an empty no-op program with exit code 0.
// Returns nil if OK, or an error message string.
fn check_toplevel_forms(forms) {
  match forms {
    nil -> nil
    cons(form, rest) -> {
      if pair?(form) == false {
        "parse error: unexpected top-level expression"
      } else {
        let head = car(form)
        if head == 'define {
          check_define_name(form, rest)
        } else {
          if head == 'define_pub {
            check_define_name(form, rest)
          } else {
            if head == 'import {
              // import requires a module name; `import` alone parses as
              // (import nil) and used to fail silently at resolve time.
              if null?(car(cdr(form))) {
                "parse error: import requires a module name"
              } else {
                check_toplevel_forms(rest)
              }
            } else {
              if head == 'type {
                check_toplevel_forms(rest)
              } else {
                if head == 'type-sig {
                  check_toplevel_forms(rest)
                } else {
                  if head == 'external_fn {
                    // external C module signature declaration (lib/<mod>.ta)
                    check_toplevel_forms(rest)
                  } else {
                    if head == 'const {
                      // const NAME = expr (compile-time constant)
                      check_toplevel_forms(rest)
                    } else {
                      "parse error: unexpected top-level expression"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// A function name must not be a keyword: `fn fn fn` parses the keyword
// `fn` as the function name, producing (define (fn) nil).
fn check_define_name(form, rest) {
  // form = (define (name args) body ...)
  let name_pair = car(cdr(form))
  if pair?(name_pair) {
    let name = car(name_pair)
    if is_kw(str.sym_to_str(name)) == true {
      str.concat("parse error: invalid function name '", str.concat(str.sym_to_str(name), "'"))
    } else {
      check_toplevel_forms(rest)
    }
  } else {
    check_toplevel_forms(rest)
  }
}

// === Positioned parse-error messages (issue #66) ===
//
// Every syntax/parse error is reported as:
//   parse error: <msg> at line L, col C (token <desc>) near "<snippet>"
// and end-of-file imbalance as:
//   parse error: <msg> (line L, col C, end of file) near "<snippet>"
// where L/C locate the offending token (or EOF), <desc> is the token's
// printable value and <snippet> is ~10 chars of source on each side,
// clipped to a single line.

// Position entry (line col off) for token index n in the parallel
// position list. Falls back to (1 1 0) when n is out of range.
fn pos_of(poss, n) {
  if null?(poss) {
    cons(1, cons(1, cons(0, nil)))
  } else {
    if n <= 0 {
      car(poss)
    } else {
      pos_of(cdr(poss), n - 1)
    }
  }
}

// Printable description of the n-th token, e.g. '}' or 'foo'.
fn tok_text(toks, n) {
  if null?(toks) {
    "'token'"
  } else {
    if n <= 0 {
      render_tok(car(toks))
    } else {
      tok_text(cdr(toks), n - 1)
    }
  }
}

fn render_tok(tok) {
  let typ = car(tok)
  let val = cdr(tok)
  match typ {
    'eof -> "'eof'"
    'lparen -> "'('"
    'rparen -> "')'"
    'lbracket -> "'['"
    'rbracket -> "']'"
    'lbrace -> "'{'"
    'rbrace -> "'}'"
    _ -> {
      if string?(val) {
        str.concat("'", str.concat(val, "'"))
      } else {
        if int?(val) {
          str.concat("'", str.concat(str.from_int(val), "'"))
        } else {
          "'token'"
        }
      }
    }
  }
}

// Last index of '\n' in [i, limit), or -1 when none.
fn last_nl_before(src, i, limit) {
  if i >= limit {
    -1
  } else {
    if str.char_at(src, i) == '\n' {
      let r = last_nl_before(src, i + 1, limit)
      if r < 0 { i } else { r }
    } else {
      last_nl_before(src, i + 1, limit)
    }
  }
}

// First index of '\n' in [i, limit), or limit when none.
fn first_nl_from(src, i, limit) {
  if i >= limit {
    limit
  } else {
    if str.char_at(src, i) == '\n' { i } else { first_nl_from(src, i + 1, limit) }
  }
}

// Source snippet around `off`: up to 10 chars on each side, clipped to
// the line containing `off` so the snippet is always single-line.
fn snippet_at(src, off) {
  let len = str.length(src)
  let raw_start = if off - 10 < 0 { 0 } else { off - 10 }
  let raw_end = if off + 10 > len { len } else { off + 10 }
  let nl = last_nl_before(src, raw_start, off)
  let start = if nl < 0 { raw_start } else { nl + 1 }
  let end = first_nl_from(src, off, raw_end)
  str.substr(src, start, end - start)
}

// "parse error: <msg> at line L, col C (token <desc>) near \"<snippet>\""
fn err_at(src, poss, n, msg, desc) {
  let p = pos_of(poss, n)
  let line = car(p)
  let col = car(cdr(p))
  let off = car(cdr(cdr(p)))
  str.concat("parse error: ",
  str.concat(msg,
  str.concat(" at line ",
  str.concat(str.from_int(line),
  str.concat(", col ",
  str.concat(str.from_int(col),
  str.concat(" (token ",
  str.concat(desc,
  str.concat(") near \"",
  str.concat(snippet_at(src, off), "\""))))))))))
}

// "parse error: <msg> (line L, col C, end of file) near \"<snippet>\""
fn err_at_eof(src, poss, n, msg) {
  let p = pos_of(poss, n)
  let line = car(p)
  let col = car(cdr(p))
  let off = car(cdr(cdr(p)))
  str.concat("parse error: ",
  str.concat(msg,
  str.concat(" (line ",
  str.concat(str.from_int(line),
  str.concat(", col ",
  str.concat(str.from_int(col),
  str.concat(", end of file) near \"",
  str.concat(snippet_at(src, off), "\""))))))))
}

// Scan token list for syntax errors before parsing.
// Returns nil if OK, or an error message string.
// Catches: unterminated string literals, unknown characters, and
// unbalanced delimiters — previously these compiled silently into
// garbage bytecode that only failed at runtime (or not at all).
// `poss` carries a (line col off) entry per token and is threaded through
// the scan alongside the token list, so when an error fires the offending
// token's entry is at index 0; `src` is the tokenized source for
// location/snippet reporting (issue #66).
fn check_syntax(toks, poss, src) {
  scan_tokens(toks, poss, src, 0, 0, 0, 0)
}

fn scan_tokens(toks, poss, src, n, paren, brack, brace) {
  if null?(toks) { nil }
  else {
    let tok = car(toks)
    let typ = car(tok)
    let rest = cdr(toks)
    if typ == 'eof {
      // End of input: everything must be balanced. Report the EOF location.
      if paren > 0 { err_at_eof(src, poss, 0, "unbalanced '(' — missing ')'") }
      else if brack > 0 { err_at_eof(src, poss, 0, "unbalanced '[' — missing ']'") }
      else if brace > 0 { err_at_eof(src, poss, 0, "unbalanced '{' — missing '}'") }
      else { nil }
    } else if typ == 'unterminated {
      err_at(src, poss, 0, "unterminated string literal", "'\"'")
    } else if typ == 'unknown {
      let p = pos_of(poss, 0)
      let off = car(cdr(cdr(p)))
      let desc = str.concat("'", str.concat(str.substr(src, off, 1), "'"))
      err_at(src, poss, 0, "unexpected character", desc)
    } else if typ == 'lparen {
      scan_tokens(rest, cdr(poss), src, n + 1, paren + 1, brack, brace)
    } else if typ == 'rparen {
      if paren > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren - 1, brack, brace)
      } else {
        err_at(src, poss, 0, "unbalanced ')'", "')'")
      }
    } else if typ == 'lbracket {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack + 1, brace)
    } else if typ == 'rbracket {
      if brack > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren, brack - 1, brace)
      } else {
        err_at(src, poss, 0, "unbalanced ']'", "']'")
      }
    } else if typ == 'lbrace {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace + 1)
    } else if typ == 'rbrace {
      if brace > 0 {
        scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace - 1)
      } else {
        err_at(src, poss, 0, "unbalanced '}'", "'}'")
      }
    } else {
      scan_tokens(rest, cdr(poss), src, n + 1, paren, brack, brace)
    }
  }
}

// ============================================================
// Module graph resolution (Phase B, issue #96)
// ============================================================
//
// An imported module is no longer flattened into the importer's namespace.
// Each loaded unit keeps its own namespace by renaming its definitions:
//   - pub fn        -> mod.name   (the qualified name user code writes;
//                      visible to importers through the export table)
//   - non-pub fn    -> mod$name   (unreachable by qualified syntax, so
//                      module-private; the module's own bare references
//                      are rewritten to the renamed name)
//   - const         -> mod.name   (no `pub const` syntax exists yet, so
//                      consts are treated as exported — parser keeps its
//                      current shape per the Phase B scope)
//   - type / ctor / external_fn: global bare names (the parser drops
//                      `pub` on types today; namespacing types is Phase C)
// Dotted references (mpc.ret) then resolve directly against the renamed
// pub members in both typecheck and codegen; the old "strip the prefix and
// look up the bare name" fallback is deleted (two modules exporting the
// same bare name can no longer shadow each other).
//
// `import foo as f` rewrites f.bar references to foo.bar inside the unit
// that declared the alias; using the real name of an aliased module is an
// error so exactly one spelling is live per file.
//
// The import graph deduplicates by resolved path (diamond dependencies
// load a module once) and detects cycles explicitly:
//   error: circular import: a -> b -> a
// (replacing the old depth>16 heuristic).
//
// Phase C (issue #99) additionally records the splice as a sequence:
//   ('F . form)  — a loose form (main-file form, retained import marker)
//   ('U . unit)  — a loaded module, unit = (name . (source . ownforms))
// seq_forms(seq) reproduces the exact splice order codegen has always seen
// (unit forms at their import position, import marker after), while the
// signature cache walks seq to decide which units' typechecking can be
// skipped. A unit's own forms follow its transitive imports, so seq order
// is topo order (dependencies first).

// Returns (forms . (seq . err)): forms is the flat form list in the
// historical splice order (codegen input, order-sensitive); seq is the
// grouped form of the same splice. err is nil on success.
fn resolve_imports(forms, dir, use_ta, with_cov) {
  // The main file's own `import x as a` aliases apply to its references.
  let ar = rewrite_unit_aliases(forms)
  let aerr = cdr(ar)
  if null?(aerr) {
    let r = resolve_loop(car(ar), dir, nil, nil, nil, use_ta, with_cov)
    let err = cdr(cdr(r))
    if null?(err) {
      let seq = reverse(car(r))
      cons(seq_forms(seq, nil), cons(seq, nil))
    } else {
      cons(nil, cons(nil, err))
    }
  } else {
    cons(nil, cons(nil, aerr))
  }
}

// seq_forms(seq, acc) — flatten the splice sequence back to the flat form
// list (acc threaded in reverse). The flat order is exactly the historical
// splice: a unit's transitive dependencies first, the unit's own forms,
// then the import marker; only the inert position of import markers can
// differ from the old flat list (they are skipped by every pass).
fn seq_forms(seq, acc) {
  if null?(seq) {
    reverse(acc)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      seq_forms(cdr(seq), rev_app(cdr(cdr(cdr(e))), acc))
    } else {
      seq_forms(cdr(seq), cons(cdr(e), acc))
    }
  }
}

// resolve_loop processes the main program's forms left-to-right,
// accumulating into 'seq' in REVERSE order. A non-builtin import splices
// (in final order) the unit's dependency entries, the unit entry, then the
// import form — matching the old flat splice (deps first, own forms last).
// Returns (seq . (visited . err)).
fn resolve_loop(forms, dir, stack, visited, seq, use_ta, with_cov) {
  if null?(forms) {
    cons(seq, cons(visited, nil))
  } else {
    let f = car(forms)
    let rest = cdr(forms)
    if pair?(f) {
      if car(f) == 'import {
        let mod_name = car(cdr(f))
        if vm.is_builtin_module(mod_name) {
          // Builtin import: keep as-is
          let r = resolve_loop(rest, dir, stack, visited, cons(cons('F, f), seq), use_ta, with_cov)
          cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
        } else {
          let ur = ensure_unit(mod_name, dir, stack, visited, use_ta, with_cov)
          let uerr = cdr(cdr(cdr(ur)))
          if null?(uerr) {
            // dep entries, the unit, then the import form
            let entry = car(ur)
            let seq2 = if null?(entry) {
              // Diamond dependency: already in the program, nothing to splice.
              cons(cons('F, f), seq)
            } else {
              cons(cons('F, f),
              cons(cons('U, entry), rev_app(car(cdr(ur)), seq)))
            }
            let r = resolve_loop(rest, dir, stack, car(cdr(cdr(ur))), seq2, use_ta, with_cov)
            cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
          } else {
            cons(nil, cons(car(cdr(cdr(ur))), uerr))
          }
        }
      } else {
        // Non-import form: keep as-is
        let r = resolve_loop(rest, dir, stack, visited, cons(cons('F, f), seq), use_ta, with_cov)
        cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
      }
    } else {
      // Non-pair form: keep as-is
      let r = resolve_loop(rest, dir, stack, visited, cons(cons('F, f), seq), use_ta, with_cov)
      cons(car(r), cons(car(cdr(r)), cdr(cdr(r))))
    }
  }
}

// ensure_unit(name, dir, stack, visited, use_ta)
//   -> (entry . (depseq . (visited . err)))
// Loads, parses and namespaces one module unit (exactly once per resolved
// path). entry = (name . (source . ownforms)) — the unit's own qualified
// forms plus the source text the signature cache hashes. depseq is the
// FORWARD-ordered splice of the unit's own transitive dependency entries
// (each dep after its own deps — topo order); nil entry + nil depseq for
// an already-loaded diamond dependency.
fn ensure_unit(name, dir, stack, visited, use_ta, with_cov) {
  let found = find_module_path(name, dir)
  let path = car(found)
  if null?(path) {
    cons(nil, cons(nil, cons(visited,
    str.concat("error: module not found: ", str.concat(name, ".ta")))))
  } else {
    if stack_has_path(path, stack) == 1 {
      cons(nil, cons(nil, cons(visited,
      str.concat("error: circular import: ", cycle_chain(stack, name)))))
    } else {
      if loaded_has_path(path, visited) == 1 {
        // Diamond dependency: already in the program, nothing to splice.
        cons(nil, cons(nil, cons(visited, nil)))
      } else {
        let pr = parse_module_content(cdr(found), path, use_ta, with_cov)
        let err = cdr(pr)
        if null?(err) == false {
          cons(nil, cons(nil, cons(visited, err)))
        } else {
          let forms = car(pr)
          let ar = rewrite_unit_aliases(forms)
          let aerr = cdr(ar)
          if null?(aerr) == false {
            cons(nil, cons(nil, cons(visited,
            str.concat(path, str.concat(": ", aerr)))))
          } else {
            let uforms = car(ar)
            let defs = scan_unit_defs(uforms, nil, nil, nil)
            let pubs = car(defs)
            let privs = car(cdr(defs))
            let consts = cdr(cdr(defs))
            let named = qualify_unit_forms(uforms, name, pubs, privs, consts)
            let rr = unit_seq_loop(named, dirname(path),
            cons(cons(path, name), stack), visited, nil, use_ta, with_cov)
            let rerr = cdr(cdr(rr))
            if null?(rerr) {
              let entry = cons(name, cons(cdr(found), named))
              // record this unit as loaded so later imports of the same
              // resolved path deduplicate (diamond dependencies)
              let visited2 = cons(cons(path, name), car(cdr(rr)))
              cons(entry, cons(car(rr), cons(visited2, nil)))
            } else {
              cons(nil, cons(nil, cons(car(cdr(rr)), rerr)))
            }
          }
        }
      }
    }
  }
}

// unit_seq_loop(forms, dir, stack, visited, acc, use_ta)
//   -> (depseq . (visited . err))
// Walks one unit's own forms (in order) collecting ONLY its non-builtin
// import splices: acc (forward order) grows to
//   acc ++ depseq(dep) ++ [('U . dep_entry)]
// per import. The unit's own forms are not part of depseq — they travel in
// the unit's own entry, spliced after depseq by the caller. The units'
// internal import forms stay inside each unit's ownforms (they are inert:
// skipped by typecheck and codegen alike).
fn unit_seq_loop(forms, dir, stack, visited, acc, use_ta, with_cov) {
  if null?(forms) {
    cons(acc, cons(visited, nil))
  } else {
    let f = car(forms)
    if pair?(f) {
      if car(f) == 'import {
        let mod_name = car(cdr(f))
        if vm.is_builtin_module(mod_name) {
          unit_seq_loop(cdr(forms), dir, stack, visited, acc, use_ta, with_cov)
        } else {
          let ur = ensure_unit(mod_name, dir, stack, visited, use_ta, with_cov)
          let uerr = cdr(cdr(cdr(ur)))
          if null?(uerr) == false {
            cons(nil, cons(car(cdr(cdr(ur))), uerr))
          } else {
            let entry = car(ur)
            let acc2 = if null?(entry) {
              // diamond dep: its entry is already elsewhere in the program
              acc
            } else {
              list_append(list_append(acc, car(cdr(ur))),
              cons(cons('U, entry), nil))
            }
            unit_seq_loop(cdr(forms), dir, stack,
            car(cdr(cdr(ur))), acc2, use_ta, with_cov)
          }
        }
      } else {
        unit_seq_loop(cdr(forms), dir, stack, visited, acc, use_ta, with_cov)
      }
    } else {
      unit_seq_loop(cdr(forms), dir, stack, visited, acc, use_ta, with_cov)
    }
  }
}

// find_module_path(name, dir) -> (path . content) or (nil . nil).
// Four-step search: the importer's directory first (local overrides),
// then the importer's helpers/ subdirectory (test/helper modules kept next
// to the code that imports them without becoming runnable test cases),
// then the lib/ standard library, then lib/bootstrap/ (compiler sources —
// tokenizer/parser stay importable for the compiler test suite).
fn find_module_path(name, dir) {
  let mod_path = path_join(dir, name)
  let content = file.read(mod_path)
  if null?(content) {
    let helpers_path = path_join(str.concat(str.concat(dir, "/"), "helpers"), name)
    let content_h = file.read(helpers_path)
    if null?(content_h) {
      let lib_path = str.concat("lib/", str.concat(name, ".ta"))
      let content2 = file.read(lib_path)
      if null?(content2) {
        let bs_path = str.concat("lib/bootstrap/", str.concat(name, ".ta"))
        let content3 = file.read(bs_path)
        if null?(content3) {
          cons(nil, nil)
        } else {
          cons(bs_path, content3)
        }
      } else {
        cons(lib_path, content2)
      }
    } else {
      cons(helpers_path, content_h)
    }
  } else {
    cons(mod_path, content)
  }
}

fn stack_has_path(path, stack) {
  if null?(stack) { 0 }
  else {
    if car(car(stack)) == path { 1 }
    else { stack_has_path(path, cdr(stack)) }
  }
}

fn loaded_has_path(path, visited) {
  if null?(visited) { 0 }
  else {
    if car(car(visited)) == path { 1 }
    else { loaded_has_path(path, cdr(visited)) }
  }
}

// stack is innermost-first; the message walks outermost -> innermost -> name.
fn cycle_chain(stack, name) {
  chain_join(list_append(stack_names(stack, nil), cons(name, nil)))
}

fn stack_names(stack, acc) {
  if null?(stack) { acc }
  else { stack_names(cdr(stack), cons(cdr(car(stack)), acc)) }
}

fn chain_join(names) {
  if null?(names) { "" }
  else {
    if null?(cdr(names)) { car(names) }
    else { str.concat(car(names), str.concat(" -> ", chain_join(cdr(names)))) }
  }
}

// ============================================================
// Alias rewriting (`import foo as f`)
// ============================================================

// collect_aliases(forms, acc) — alias -> real pairs from a unit's own
// top-level import forms. `import foo` (alias == name) adds nothing.
fn collect_aliases(forms, acc) {
  if null?(forms) { acc }
  else {
    let f = car(forms)
    if pair?(f) {
      if car(f) == 'import {
        let name = car(cdr(f))
        let alias = car(cdr(cdr(f)))
        if null?(alias) {
          collect_aliases(cdr(forms), acc)
        } else {
          if alias == name {
            collect_aliases(cdr(forms), acc)
          } else {
            // tval of ident tokens is a String; store alias pairs keyed by
            // Symbol to match the str.to_sym(pfx) lookups in
            // alias_rewrite_sym.
            collect_aliases(cdr(forms), cons(cons(str.to_sym(alias), str.to_sym(name)), acc))
          }
        }
      } else {
        collect_aliases(cdr(forms), acc)
      }
    } else {
      collect_aliases(cdr(forms), acc)
    }
  }
}

// rewrite_unit_aliases(forms) -> (forms . err)
// Rewrites alias-qualified references (f.bar -> foo.bar) throughout the
// unit. Import forms themselves are not rewritten. Using the real name of
// an aliased module is rejected so exactly one spelling is live per file.
fn rewrite_unit_aliases(forms) {
  let aliases = collect_aliases(forms, nil)
  if null?(aliases) {
    cons(forms, nil)
  } else {
    alias_walk(forms, aliases)
  }
}

// alias_walk(e, aliases) -> (e . err)
fn alias_walk(e, aliases) {
  if pair?(e) {
    if car(e) == 'import {
      cons(e, nil)
    } else {
      let r1 = alias_walk(car(e), aliases)
      if null?(cdr(r1)) == false {
        cons(nil, cdr(r1))
      } else {
        let r2 = alias_walk(cdr(e), aliases)
        if null?(cdr(r2)) == false {
          cons(nil, cdr(r2))
        } else {
          cons(cons(car(r1), car(r2)), nil)
        }
      }
    }
  } else {
    if symbol?(e) {
      alias_rewrite_sym(e, aliases)
    } else {
      cons(e, nil)
    }
  }
}

// alias_rewrite_sym(s, aliases) -> (s . err)
// Dotted symbol `pfx.rest`: pfx an alias -> rewrite to real.rest;
// pfx the real name of an aliased module -> error.
fn alias_rewrite_sym(s, aliases) {
  let s_str = str.sym_to_str(s)
  let dot = str.index_of(s_str, ".")
  if dot <= 0 {
    cons(s, nil)
  } else {
    let pfx = str.substr(s_str, 0, dot)
    let hit = alist_assoc(str.to_sym(pfx), aliases)
    if null?(hit) == false {
      let rest = str.substr(s_str, dot, str.length(s_str) - dot)
      cons(str.to_sym(str.concat(str.sym_to_str(cdr(hit)), rest)), nil)
    } else {
      if aliased_real_pfx(pfx, aliases) == 1 {
        cons(nil, str.concat("error: module '", str.concat(pfx, str.concat("' is imported under an alias in this file; the real name is not usable here ('", str.concat(s_str, "')")))))
      } else {
        cons(s, nil)
      }
    }
  }
}

fn aliased_real_pfx(pfx, aliases) {
  if null?(aliases) { 0 }
  else {
    if str.sym_to_str(cdr(car(aliases))) == pfx { 1 }
    else { aliased_real_pfx(pfx, cdr(aliases)) }
  }
}

fn alist_assoc(key, lst) {
  if null?(lst) { nil }
  else {
    if car(car(lst)) == key { car(lst) }
    else { alist_assoc(key, cdr(lst)) }
  }
}

// ============================================================
// Unit namespacing (rename + internal reference qualification)
// ============================================================

// scan_unit_defs(forms, pubs, privs, consts) -> (pubs . (privs . consts))
// Bare names defined at this unit's top level, per visibility.
fn scan_unit_defs(forms, pubs, privs, consts) {
  if null?(forms) {
    cons(pubs, cons(privs, consts))
  } else {
    let f = car(forms)
    if pair?(f) {
      let head = car(f)
      if head == 'define_pub {
        let name = car(car(cdr(f)))
        scan_unit_defs(cdr(forms), cons(name, pubs), privs, consts)
      } else {
        if head == 'define {
          let name = car(car(cdr(f)))
          scan_unit_defs(cdr(forms), pubs, cons(name, privs), consts)
        } else {
          if head == 'const {
            let name = car(cdr(f))
            scan_unit_defs(cdr(forms), pubs, privs, cons(name, consts))
          } else {
            scan_unit_defs(cdr(forms), pubs, privs, consts)
          }
        }
      }
    } else {
      scan_unit_defs(cdr(forms), pubs, privs, consts)
    }
  }
}

// qualify_unit_forms — rename each define/define_pub/const/type-sig name to
// its namespaced form and qualify the unit's own bare references in the
// renamed definitions' bodies.
fn qualify_unit_forms(forms, mod, pubs, privs, consts) {
  if null?(forms) { nil }
  else {
    cons(qualify_unit_form(car(forms), mod, pubs, privs, consts),
    qualify_unit_forms(cdr(forms), mod, pubs, privs, consts))
  }
}

fn qualify_unit_form(f, mod, pubs, privs, consts) {
  if pair?(f) == false {
    f
  } else {
    let head = car(f)
    if head == 'define {
      let sig = car(cdr(f))
      let params = cdr(sig)
      let body = car(cdr(cdr(f)))
      let newname = rename_member_name(car(sig), mod, privs)
      let newbody = qualify_expr(body, mod, pubs, privs, consts, params)
      cons('define, cons(cons(newname, params), cons(newbody, nil)))
    } else {
      if head == 'define_pub {
        let sig = car(cdr(f))
        let params = cdr(sig)
        let body = car(cdr(cdr(f)))
        let newname = str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(car(sig)))))
        let newbody = qualify_expr(body, mod, pubs, privs, consts, params)
        cons('define_pub, cons(cons(newname, params), cons(newbody, nil)))
      } else {
        if head == 'const {
          let name = car(cdr(f))
          let val = car(cdr(cdr(f)))
          let newname = str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(name))))
          cons('const, cons(newname, cons(qualify_expr(val, mod, pubs, privs, consts, nil), nil)))
        } else {
          if head == 'type-sig {
            // keep name in lockstep with the renamed definition it annotates
            let newname = rename_member_name(car(cdr(f)), mod, privs)
            cons('type-sig, cons(newname, cdr(cdr(f))))
          } else {
            // type / external_fn / import: verbatim (types and C externals
            // stay global in Phase B)
            f
          }
        }
      }
    }
  }
}

// rename_member_name — non-pub members take the mod$name form (invisible to
// qualified syntax), pub members mod.name.
fn rename_member_name(name, mod, privs) {
  if sym_in(name, privs) == 1 {
    str.to_sym(str.concat(mod, str.concat("$", str.sym_to_str(name))))
  } else {
    str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(name))))
  }
}

// qualify_expr(e, mod, pubs, privs, consts, bound) — rewrite bare references
// to the unit's own definitions into their namespaced names. Scope-aware,
// mirroring codegen.resolve_consts: lambda params, let bindings and
// match/receive pattern binders shadow member names. Quoted symbols are
// rewritten only when they are const references (uppercase const names
// parse as (quote Name)); other quoted data is left alone.
fn qualify_expr(e, mod, pubs, privs, consts, bound) {
  if pair?(e) {
    let head = car(e)
    if head == 'quote {
      let inner = car(cdr(e))
      if symbol?(inner) {
        if sym_in(inner, consts) == 1 {
          cons('quote, cons(str.to_sym(str.concat(mod, str.concat(".", str.sym_to_str(inner)))), nil))
        } else {
          e
        }
      } else {
        e
      }
    } else {
      if head == 'lambda {
        // ('lambda params body ret_type)
        let params = car(cdr(e))
        let body = car(cdr(cdr(e)))
        let ret_type = car(cdr(cdr(cdr(e))))
        cons('lambda, cons(params,
        cons(qualify_expr(body, mod, pubs, privs, consts, syms_append(params, bound)),
        cons(ret_type, nil))))
      } else {
        if head == 'let {
          let b = car(cdr(e))
          if symbol?(b) {
            // ('let var init rest) — var scopes over rest only
            let init = car(cdr(cdr(e)))
            let rest = car(cdr(cdr(cdr(e))))
            cons('let, cons(b,
            cons(qualify_expr(init, mod, pubs, privs, consts, bound),
            cons(qualify_expr(rest, mod, pubs, privs, consts, cons(b, bound)), nil))))
          } else {
            if null?(b) {
              e
            } else {
              // multi-binding let: ((v1 e1) (v2 e2) ...) then body forms;
              // later initializers see earlier binders (let* order).
              let br = qualify_bindings(b, mod, pubs, privs, consts, bound)
              cons('let, cons(car(br),
              qualify_expr(cdr(cdr(e)), mod, pubs, privs, consts, cdr(br))))
            }
          }
        } else {
          if head == 'match {
            let scrut = car(cdr(e))
            cons('match, cons(qualify_expr(scrut, mod, pubs, privs, consts, bound),
            qualify_arms(cdr(cdr(e)), mod, pubs, privs, consts, bound)))
          } else {
            if head == 'receive {
              cons('receive, qualify_arms(cdr(e), mod, pubs, privs, consts, bound))
            } else {
              cons(qualify_expr(car(e), mod, pubs, privs, consts, bound),
              qualify_expr(cdr(e), mod, pubs, privs, consts, bound))
            }
          }
        }
      }
    }
  } else {
    if symbol?(e) {
      if sym_in(e, bound) == 1 {
        e
      } else {
        let s_str = str.sym_to_str(e)
        if str.index_of(s_str, ".") >= 0 {
          // already qualified (or builtin dotted): not a bare member ref
          e
        } else {
          if sym_in(e, privs) == 1 {
            str.to_sym(str.concat(mod, str.concat("$", s_str)))
          } else {
            if sym_in(e, pubs) == 1 {
              str.to_sym(str.concat(mod, str.concat(".", s_str)))
            } else {
              if sym_in(e, consts) == 1 {
                str.to_sym(str.concat(mod, str.concat(".", s_str)))
              } else {
                e
              }
            }
          }
        }
      }
    } else {
      e
    }
  }
}

// qualify_bindings(bs, ...) -> (new_bindings . bound_with_all_vars)
fn qualify_bindings(bs, mod, pubs, privs, consts, bound) {
  if null?(bs) {
    cons(nil, bound)
  } else {
    let b = car(bs)
    let v = car(b)
    let init = car(cdr(b))
    let new_init = qualify_expr(init, mod, pubs, privs, consts, bound)
    let rest = qualify_bindings(cdr(bs), mod, pubs, privs, consts, cons(v, bound))
    cons(cons(cons(v, new_init), car(rest)), cdr(rest))
  }
}

// qualify_arms — pattern binders scope over the guard and body of their arm;
// the pattern itself is a declaration region and is left as-is.
fn qualify_arms(arms, mod, pubs, privs, consts, bound) {
  if null?(arms) { nil }
  else {
    let arm = car(arms)
    let pat = car(arm)
    let nb = syms_append(pat_binders(pat, nil), bound)
    let new_arm = if null?(cdr(cdr(arm))) {
      // (pat body)
      cons(pat, cons(qualify_expr(car(cdr(arm)), mod, pubs, privs, consts, nb), nil))
    } else {
      // (pat guard body)
      cons(pat, cons(qualify_expr(car(cdr(arm)), mod, pubs, privs, consts, nb),
      cons(qualify_expr(car(cdr(cdr(arm))), mod, pubs, privs, consts, nb), nil)))
    }
    cons(new_arm, qualify_arms(cdr(arms), mod, pubs, privs, consts, bound))
  }
}

// pat_binders(pat, acc) — bare symbols in a pattern are binders; quoted
// names (constructors, literals) bind nothing. Mirrors codegen's
// collect_pattern_bindings.
fn pat_binders(pat, acc) {
  if symbol?(pat) {
    cons(pat, acc)
  } else {
    if pair?(pat) {
      if car(pat) == 'quote {
        acc
      } else {
        pat_binders(car(pat), pat_binders(cdr(pat), acc))
      }
    } else {
      acc
    }
  }
}

fn sym_in(x, lst) {
  if null?(lst) { 0 }
  else {
    if car(lst) == x { 1 }
    else { sym_in(x, cdr(lst)) }
  }
}

fn syms_append(xs, ys) {
  if null?(xs) { ys }
  else { cons(car(xs), syms_append(cdr(xs), ys)) }
}

fn list_append(a, b) {
  if null?(a) { b }
  else { cons(car(a), list_append(cdr(a), b)) }
}

// Prepend lst's elements (forward order) onto acc (reverse order accumulator):
// after the surrounding reverse, lst's elements appear before acc in order.
fn prepend_rev(lst, acc) {
  if null?(lst) { acc }
  else { prepend_rev(cdr(lst), cons(car(lst), acc)) }
}

// === Compilation pipeline ===

// Type error reporting with source line numbers for the main file.
// Errors inside imported modules fall back to function-name-only messages.
fn report_type_errors(tc, src) {
  let errors = get_errors(tc)
  if null?(errors) {
    nil
  } else {
    print(str.concat("typecheck: ", str.concat(str.from_int(count_errors(tc)), " type error(s) found")))
    print_tc_errors(errors, src, nil)
  }
}

// join_syms(syms, sep) -> "A, B, C"
fn join_syms(syms, sep) {
  if null?(syms) {
    ""
  } else {
    if null?(cdr(syms)) {
      str.sym_to_str(car(syms))
    } else {
      str.concat(str.sym_to_str(car(syms)), str.concat(sep, join_syms(cdr(syms), sep)))
    }
  }
}

fn print_tc_errors(errors, src, used) {
  match errors {
    nil -> nil
    cons(err, rest) -> {
      // err = (kind . (ctx . payload)); kind is 'mismatch or 'undefined
      let kind = car(err)
      let ctx = car(cdr(err))
      // ctx is a symbol (fn name) or nested (ctx . detail) pairs: the chain
      // root is the function name; each cdr is a detail symbol like
      // "arg 2 of helper" describing the failing site, innermost last.
      let name = str.sym_to_str(ctx_root_name(ctx))
      let details = ctx_detail_list(ctx, nil)
      let detail = if null?(details) { nil } else { str.sym_to_str(list_last(details)) }
      let line = find_fn_line(src, name)
      let loc = if line > 0 {
        str.concat("in function '", str.concat(name, str.concat("' (line ", str.concat(str.from_int(line), "): "))))
      } else {
        str.concat("in function '", str.concat(name, "': "))
      }
      if kind == 'mismatch {
        let t1 = car(cdr(cdr(err)))
        let t2 = car(cdr(cdr(cdr(err))))
        let msg = str.concat("cannot unify ", str.concat(type_format(t1, nil), str.concat(" with ", type_format(t2, nil))))
        let full = if null?(detail) { msg } else { str.concat(detail, str.concat(": ", msg)) }
        print(str.concat("  [E0001] ", str.concat(loc, full)))
      } else {
        if kind == 'arity {
          // payload = (name . (got . (want . nil))): a builtin called with
          // the wrong number of arguments — Direction B, rejected at
          // compile time so it never reaches the VM.
          let bname = str.sym_to_str(car(cdr(cdr(err))))
          let got = car(cdr(cdr(cdr(err))))
          let want = car(cdr(cdr(cdr(cdr(err)))))
          let msg = str.concat("wrong number of arguments for '", str.concat(bname, str.concat("' (got ", str.concat(str.from_int(got), str.concat(", want ", str.concat(str.from_int(want), ")"))))))
          let full = if null?(detail) { msg } else { str.concat(detail, str.concat(": ", msg)) }
          print(str.concat("  [E0003] ", str.concat(loc, full)))
        } else {
          if kind == 'undefined-var {
            // payload = (name . nil): a variable reference with no binding
            // at all (issue #81) — not a param, not a let in scope, not a
            // builtin/outer define.
            let vname = str.sym_to_str(car(cdr(cdr(err))))
            print(str.concat("  [E0002] ", str.concat(loc, str.concat("undefined variable '", str.concat(vname, "'")))))
          } else {
            if kind == 'not-exported {
              // payload = (name . (mod . nil)): dotted reference into a
              // module member that exists but is not pub (issue #96).
              let ename = str.sym_to_str(car(cdr(cdr(err))))
              let emod = str.sym_to_str(car(cdr(cdr(cdr(err)))))
              print(str.concat("  [E0004] ", str.concat(loc, str.concat("'", str.concat(ename, str.concat("' is not exported by module '", str.concat(emod, "'")))))))
            } else {
              if kind == 'no-export {
                // payload = (name . (mod . nil)): dotted reference into a
                // module with no such member at all (issue #96).
                let ename = str.sym_to_str(car(cdr(cdr(err))))
                let emod = str.sym_to_str(car(cdr(cdr(cdr(err)))))
                print(str.concat("  [E0004] ", str.concat(loc, str.concat("module '", str.concat(emod, str.concat("' has no export '", str.concat(ename, "'")))))))
              } else {
                if kind == 'non-exhaustive {
                  // payload = (tname . (missing . nil)): an ADT match whose
                  // arms do not cover the listed variants (issue #118).
                  let missing = car(cdr(cdr(cdr(err))))
                  print(str.concat("  [E0005] ", str.concat(loc, str.concat("non-exhaustive match: missing ", join_syms(missing, ", ")))))
                } else {
                  let uname = str.sym_to_str(car(cdr(cdr(err))))
                  print(str.concat("  [E0002] ", str.concat(loc, str.concat("undefined function '", str.concat(uname, "'")))))
                }
              }
            }
          }
        }
      }
      // Locate the failing call line inside the function body. The subst
      // yields errors newest-first, so successive errors at the same callee
      // resolve from the last occurrence backwards via `used` (issue #90:
      // they used to all show the last occurrence's line).
      let used2 = if kind == 'mismatch {
        if null?(detail) {
          used
        } else {
          let shead = detail_head(detail)
          let key = str.concat(name, str.concat("/", shead))
          let site = find_call_site(src, name, shead, used_count(used, key))
          if null?(site) {
            nil
          } else {
            print(str.concat("           line ", str.concat(str.from_int(car(site)), str.concat(": >>> ", cdr(site)))))
          }
          used_bump(used, key)
        }
      } else {
        used
      }
      print_tc_errors(rest, src, used2)
    }
  }
}

// Walk the (ctx . detail) pair chain to the root function-name symbol.
fn ctx_root_name(ctx) {
  if pair?(ctx) { ctx_root_name(car(ctx)) } else { ctx }
}

// Collect detail symbols from the ctx chain, outermost first.
fn ctx_detail_list(ctx, acc) {
  if pair?(ctx) { ctx_detail_list(car(ctx), cons(cdr(ctx), acc)) } else { acc }
}

fn list_last(lst) {
  if null?(cdr(lst)) { car(lst) } else { list_last(cdr(lst)) }
}

// Extract the called name from a detail like "arg 2 of helper".
fn detail_head(detail) {
  let idx = str.index_of(detail, " of ")
  if idx < 0 { detail }
  else { str.substr(detail, idx + 4, str.length(detail) - idx - 4) }
}

// Locate the line of the failing call within `fn name`'s body. Heuristic:
// the last occurrence of "<head>(" in the body is usually the violating
// call (earlier uses establish the type, later ones break it). Returns
// (line_no . line_text) or nil when not found (e.g. imported module).
fn find_call_site(src, name, head, nth) {
  let fn_off = str.index_of(src, str.concat("fn ", name))
  if fn_off < 0 {
    nil
  } else {
    let tail = str.substr(src, fn_off, str.length(src) - fn_off)
    let open = str.index_of(tail, "{")
    if open < 0 {
      nil
    } else {
      let body_start = fn_off + open
      let body_end = match_brace(src, body_start + 1, 1)
      let body = str.substr(src, body_start, body_end - body_start)
      let pat = str.concat(head, "(")
      find_hit_from(body, pat, body_start, src, str.length(body) - 1, nth, str.length(body))
    }
  }
}

// Backward scan of body[i..limit) for occurrences of `pat`; returns the
// (nth+1)-th one found (nth = 0 is the last before the limit) as
// (line_number . line_text), or nil. The limit bounds every later
// recursion, so an occurrence claimed by an earlier error can never be
// found again (issue #90: a suffix-search shortcut here jumped forward
// past the claimed hit and re-returned it).
fn find_hit_from(body, pat, body_start, src, i, nth, limit) {
  if i < 0 {
    nil
  } else {
    if str.eq(str.substr(body, i, str.length(pat)), pat) {
      if nth == 0 {
        let abs = body_start + i
        cons(1 + count_newlines(src, 0, abs), line_at(src, abs))
      } else {
        find_hit_from(body, pat, body_start, src, i - 1, nth - 1, limit)
      }
    } else {
      find_hit_from(body, pat, body_start, src, i - 1, nth, limit)
    }
  }
}

// used-count assoc for call-site resolution: key = "fn/callee" string,
// value = how many of that callee's occurrences (from the last) are
// already claimed by earlier-printed errors.
fn used_count(used, key) {
  match used {
    nil -> 0
    cons(pair, rest) -> {
      if str.eq(car(pair), key) { cdr(pair) } else { used_count(rest, key) }
    }
  }
}

fn used_bump(used, key) {
  match used {
    nil -> cons(cons(key, 1), nil)
    cons(pair, rest) -> {
      if str.eq(car(pair), key) {
        cons(cons(key, cdr(pair) + 1), rest)
      } else {
        cons(pair, used_bump(rest, key))
      }
    }
  }
}

// Last occurrence of `needle` in `s` at or before position `i`.
fn last_index_of(s, needle, i) {
  if i < 0 {
    -1
  } else {
    let idx = str.index_of(str.substr(s, i, str.length(s) - i), needle)
    if idx == 0 {
      i
    } else {
      if idx > 0 {
        i + idx
      } else {
        last_index_of(s, needle, i - 1)
      }
    }
  }
}

// Match braces from an open brace; returns offset just past the closing.
fn match_brace(src, i, depth) {
  if depth == 0 {
    i
  } else {
    if i >= str.length(src) {
      i
    } else {
      let c = str.char_at(src, i)
      if c == '{' {
        match_brace(src, i + 1, depth + 1)
      } else {
        if c == '}' {
          match_brace(src, i + 1, depth - 1)
        } else {
          match_brace(src, i + 1, depth)
        }
      }
    }
  }
}

// Extract the line of text containing offset `i`.
fn line_at(src, i) {
  let start = line_start(src, i)
  let end = line_end(src, i)
  str.substr(src, start, end - start)
}

fn line_start(src, i) {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == '\n' {
      i
    } else {
      line_start(src, i - 1)
    }
  }
}

fn line_end(src, i) {
  if i >= str.length(src) {
    str.length(src)
  } else {
    if str.char_at(src, i) == '\n' {
      i
    } else {
      line_end(src, i + 1)
    }
  }
}

// Find the source line where `fn <name>` is defined; 0 when not found
// (e.g. the function lives in an imported module).
fn find_fn_line(src, name) {
  let idx = str.index_of(src, str.concat("fn ", name))
  if idx < 0 { 0 }
  else { 1 + count_newlines(src, 0, idx) }
}

fn count_newlines(src, i, limit) {
  if i >= limit { 0 }
  else {
    if str.char_at(src, i) == '\n' { 1 + count_newlines(src, i + 1, limit) }
    else { count_newlines(src, i + 1, limit) }
  }
}

// ============================================================
// Signature-cache typecheck (Phase C, issue #99)
//
// Whole-program typecheck is kept byte-for-byte when caching is off
// (cache_dir = ""). When on, modules whose frozen signatures provably
// could not change are skipped: their definitions are dropped from the
// typechecked form list and their env bindings are reloaded from
// .build/modules/<name>-<key>.sig via infer_program_seeded. Everything
// else — parse, codegen, form order, error behavior — is untouched.
// ============================================================

// typecheck_cached(forms, seq, cache_dir, verbose) -> tc result
fn typecheck_cached(forms, seq, cache_dir, verbose) {
  if str.length(cache_dir) == 0 {
    infer_program(forms)
  } else {
    let plan = plan_cache(seq_units(seq, nil), cache_dir, nil, nil,
    nil, nil, nil, verbose)
    // plan = (sighashes . (seed . (hitnames . (skipnames . misses))))
    let seed = car(cdr(plan))
    let hitnames = car(cdr(cdr(plan)))
    let skipnames = car(cdr(cdr(cdr(plan))))
    let misses = cdr(cdr(cdr(cdr(plan))))
    let tc_forms = tc_filter_seq(seq, skipnames, nil)
    let t0 = vm.time_ms()
    let tc = infer_program_seeded(tc_forms, seed)
    let dt = vm.time_ms() - t0
    if verbose == 1 {
      print(str.concat("[sig] typecheck ", str.concat(str.from_int(dt),
      str.concat("ms (", str.concat(str.from_int(count_strs(hitnames)),
      str.concat(" hit, ", str.concat(str.from_int(count_strs(misses)), " miss)")))))))

    }
    store_misses(reverse(misses), cache_dir, car(plan), car(tc))
    tc
  }
}

// seq_units(seq, acc) — the ('U . unit) entries of the splice sequence,
// in splice order (= topo order, dependencies first).
fn seq_units(seq, acc) {
  if null?(seq) {
    rev_strs(acc, nil)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      seq_units(cdr(seq), cons(cdr(e), acc))
    } else {
      seq_units(cdr(seq), acc)
    }
  }
}

// plan_cache(units, cachedir, sighashes, seed, hitnames, skipnames,
//             misses, verbose)
//   -> (sighashes . (seed . (hitnames . (skipnames . misses))))
// A source miss is checked immediately in isolation. If its exports remain
// unchanged, its new signature is available to later dependents, which may
// then hit despite this module being rechecked.
fn plan_cache(units, cachedir, sighashes, seed, hitnames, skipnames, misses, verbose) {
  if null?(units) {
    cons(sighashes, cons(seed, cons(hitnames, cons(skipnames, misses))))
  } else {
    let u = car(units)
    let name = car(u)
    let source = car(cdr(u))
    let ownforms = cdr(cdr(u))
    let deps = unit_dep_names(ownforms, name, nil)
    let dpr = dep_pairs(deps, sighashes)
    let t0 = vm.time_ms()
    if cdr(dpr) == 0 {
      if verbose == 1 {
        print(str.concat("[sig] miss ", str.concat(name, " (dependency rechecking)")))
      }
      plan_cache(cdr(units), cachedir, sighashes, seed, hitnames,
      skipnames, cons(u, misses), verbose)
    } else {
      let key = eff_key(source, car(dpr))
      let text = file.read(sig_path(cachedir, name, key))
      let entry = sig_load_entry(text, source)
      if null?(entry) {
        // Do not treat this as a hit: source equality was not established.
        // But use the old entry's export hash as a baseline, then infer the
        // changed unit so its actual exports can be propagated immediately.
        let pre = infer_program_seeded(ownforms, seed)

        let pre_errors = get_errors(pre)
        if null?(pre_errors) {
          let bindings = unit_bindings(ownforms, name, car(pre), nil)
          let etext = exports_text(bindings)
          let sh = str_hash(etext)
          let seed2 = list_append(seed, bindings)
          if verbose == 1 {
            print(str.concat("[sig] miss ", name))
          }
          plan_cache(cdr(units), cachedir,
          cons(cons(str.to_sym(name), sh), sighashes), seed2,
          hitnames, skipnames, cons(u, misses), verbose)

        } else {
          if verbose == 1 { print(str.concat("[sig] miss ", name)) }
          plan_cache(cdr(units), cachedir, sighashes, seed,
          hitnames, skipnames, cons(u, misses), verbose)
        }
      } else {
        let dt = vm.time_ms() - t0
        if verbose == 1 {
          print(str.concat("[sig] hit ", str.concat(name,
          str.concat(" (", str.concat(str.from_int(dt), "ms)")))))
        }
        plan_cache(cdr(units), cachedir,
        cons(cons(str.to_sym(name), cdr(entry)), sighashes),
        list_append(seed, car(entry)), cons(name, hitnames),
        cons(name, skipnames), misses, verbose)
      }
    }
  }
}

// dep_pairs(deps, sighashes) -> (((name . sighash) ...) . ok)
// ok = 0 when any dependency has no current signature (caller must miss).
fn dep_pairs(deps, sighashes) {
  dep_pairs_loop(deps, sighashes, nil)
}

fn dep_pairs_loop(deps, sighashes, acc) {
  if null?(deps) {
    cons(rev_strs(acc, nil), 1)
  } else {
    let hit = alist_assoc(str.to_sym(car(deps)), sighashes)
    if null?(hit) {
      cons(nil, 0)
    } else {
      dep_pairs_loop(cdr(deps), sighashes, cons(cons(car(deps), cdr(hit)), acc))
    }
  }
}

// tc_filter_seq(seq, hitnames, acc) — the typechecked form list. Hit units
// contribute only their type / external_fn / import forms, so ctor and
// C-signature registration happens in the same order as a whole-program
// pass (their fn/const bindings come from the cache seed instead); miss
// units and all loose forms contribute everything.
fn tc_filter_seq(seq, hitnames, acc) {
  if null?(seq) {
    reverse(acc)
  } else {
    let e = car(seq)
    if car(e) == 'U {
      let ownforms = cdr(cdr(cdr(e)))
      let acc2 = if str_in_strs(car(cdr(e)), hitnames) {
        rev_app(keep_cached_forms(ownforms, nil), acc)
      } else {
        rev_app(ownforms, acc)
      }
      tc_filter_seq(cdr(seq), hitnames, acc2)
    } else {
      tc_filter_seq(cdr(seq), hitnames, cons(cdr(e), acc))
    }
  }
}

// Cached units keep only order-relevant declarations: type forms register
// constructors (the ctor schemes are also in the signature so dependents
// still invalidate), external_fn forms keep C-module call sites checked
// strictly, import forms are inert. define/define_pub/const/type-sig are
// covered by the seeded bindings (a type-sig's raw annotated arrow would
// shadow the fully generalized cached scheme — wrong, so it is dropped).
fn keep_cached_forms(forms, acc) {
  if null?(forms) {
    acc
  } else {
    let f = car(forms)
    let acc2 = if pair?(f) {
      let head = car(f)
      if head == 'type {
        cons(f, acc)
      } else {
        if head == 'external_fn {
          cons(f, acc)
        } else {
          if head == 'import { cons(f, acc) } else { acc }
        }
      }
    } else {
      acc
    }
    keep_cached_forms(cdr(forms), acc2)
  }
}

// store_misses(misses, cachedir, sighashes, env) — write fresh entries for
// every rechecked module, in topo order: by the time a module is stored,
// its dependencies' new signature hashes are already in sighashes, so the
// key written here matches the key the next cold lookup will compute.
fn store_misses(misses, cachedir, sighashes, env) {
  if null?(misses) {
    sighashes
  } else {
    let u = car(misses)
    let name = car(u)
    let source = car(cdr(u))
    let ownforms = cdr(cdr(u))
    let deps = unit_dep_names(ownforms, name, nil)
    let dpr = dep_pairs(deps, sighashes)
    if cdr(dpr) == 1 {
      let bindings = unit_bindings(ownforms, name, env, nil)
      let etext = exports_text(bindings)
      let sh = str_hash(etext)
      let key = eff_key(source, car(dpr))
      sig_store(cachedir, name, key, source, etext, sh)
      store_misses(cdr(misses), cachedir, cons(cons(str.to_sym(name), sh), sighashes), env)
    } else {
      // unreachable in topo order — skip rather than write a bad key
      store_misses(cdr(misses), cachedir, sighashes, env)
    }
  }
}

fn str_in_strs(s, lst) {
  if null?(lst) { false }
  else {
    if car(lst) == s { true }
    else { str_in_strs(s, cdr(lst)) }
  }
}

fn count_strs(lst) {
  if null?(lst) { 0 }
  else { 1 + count_strs(cdr(lst)) }
}

fn rev_strs(lst, acc) {
  if null?(lst) { acc }
  else { rev_strs(cdr(lst), cons(car(lst), acc)) }
}

// Returns (forms . (seq . err)): err is nil on success, or an error
// message string (parse error / module error / unreadable file).
fn load_source_ta(path, use_ta, with_cov) {
  let src = file.read(path)
  if null?(src) {
    cons(nil, cons(nil, str.concat("error: cannot read file: ", path)))
  } else {
    let pr = parse_module_content(src, path, use_ta, with_cov)
    let err = cdr(pr)
    if null?(err) {
      resolve_imports(car(pr), dirname(path), use_ta, with_cov)
    } else {
      cons(nil, cons(nil, err))
    }
  }
}

fn compile_and_run(bc) {
  let top_fn = vm.load_bytecode(bc)
  if top_fn < 0 {
    print("ERROR: load_bytecode failed")
  } else {
    let pid = vm.spawn(top_fn)
    let ref = monitor(pid)
    let msg = recv()
    match msg {
      [DOWN, r, p, reason] -> 'ok
    }
  }
}

pub fn compile_file(path, use_ta, cache_dir, verbose) {
  let lr = load_source_ta(path, use_ta, 0)
  let err = cdr(cdr(lr))
  if null?(err) {
    // Typecheck the raw AST — const forms and references are handled by the
    // typechecker (names resolve through the env), so const values are
    // type-checked instead of being inlined away first.
    let tc = typecheck_cached(car(lr), car(cdr(lr)), cache_dir, verbose)
    report_type_errors(tc, file.read(path))
    let bc = compile(car(lr))
    compile_and_run(bc)
  } else {
    print(err)
  }
}

pub fn compile_file_skip_check(path, use_ta) {
  let lr = load_source_ta(path, use_ta, 0)
  let err = cdr(cdr(lr))
  if null?(err) {
    let ast = car(lr)
    let bc = compile(ast)
    let top_fn = vm.load_bytecode(bc)
    if top_fn < 0 {
      print("ERROR: load_bytecode failed")
    } else {
      let pid = vm.spawn(top_fn)
      let ref = monitor(pid)
      let msg = recv()
      match msg {
        [DOWN, r, p, reason] -> 'ok
      }
    }
  } else {
    print(err)
  }
}

pub fn compile_file_to_tabc(source_path, out_path, use_ta, cache_dir, verbose, with_cov) {
  let lr = load_source_ta(source_path, use_ta, with_cov)
  let err = cdr(cdr(lr))
  if null?(err) {
    // Typecheck the raw AST (const forms are handled by the typechecker).
    let tc = typecheck_cached(car(lr), car(cdr(lr)), cache_dir, verbose)
    report_type_errors(tc, file.read(source_path))
    let n = count_errors(tc)
    if n > 0 {
      print(str.concat("compile aborted: ", str.concat(str.from_int(n), " type error(s)")))
    } else {
      // --cov: instrument after typecheck and before codegen. The
      // parser stamped (cov.line path line) markers — permissive
      // cov.<fn> calls — on every statement; instrument() rewrites them
      // into (cov.hit k) and emits the covmap side table
      // ("k file:line fn" rows) for the report.
      let forms = if with_cov == 1 {
        let ir = instrument(car(lr))
        write_covmap(str.concat(out_path, ".covmap"), cdr(ir))
        car(ir)
      } else {
        car(lr)
      }
      compile_and_write(forms, out_path)
    }
  } else {
    print(err)
  }
}

// fmt subcommand: `tinyactor fmt <file.ta>` formats in place,
// `tinyactor fmt --check <file.ta>` reports files that differ.
fn fmt_file(path) {
  let src = file.read(path)
  let out = format(src)
  file.write(path, out)
}

fn fmt_check(path) {
  let src = file.read(path)
  let out = format(src)
  if out == src {
    print(str.concat("ok: ", path))
  } else {
    print(str.concat("diff: ", path))
  }
}

fn main() {
  let arg0 = vm.get_arg(0)
  if arg0 == "fmt" {
    let arg1 = vm.get_arg(1)
    if arg1 == "--check" {
      fmt_check(vm.get_arg(2))
    } else {
      fmt_file(arg1)
    }
  } else {
    // [--verbose] <path> [out] [cache_dir]
    // cache_dir is passed by the tinyactor script (the project's
    // .build/modules); absent/empty disables the signature cache and
    // keeps the whole-program typecheck.
    let verbose = if arg0 == "--verbose" { 1 } else { 0 }
    let i0 = if verbose == 1 { 1 } else { 0 }
    // --cov (build only): emit (cov.hit k) calls + <out>.covmap side table.
    let with_cov = if vm.get_arg(i0) == "--cov" { 1 } else { 0 }
    let i1 = i0 + with_cov
    let path = vm.get_arg(i1)
    let out = vm.get_arg(i1 + 1)
    let cache_dir = vm.get_arg(i1 + 2)
    if out == "--no-check" {
      compile_file_skip_check(path, 1)
    } else {
      if str.length(out) > 0 {
        compile_file_to_tabc(path, out, 1, cache_dir, verbose, with_cov)
      } else {
        compile_file(path, 1, cache_dir, verbose)
      }
    }
  }

}

pub fn is_digit(c) {
  match c {
    '0' -> true
    '1' -> true
    '2' -> true
    '3' -> true
    '4' -> true
    '5' -> true
    '6' -> true
    '7' -> true
    '8' -> true
    '9' -> true
    _ -> false
  }
}

pub fn is_alpha(c) {
  match c {
    'A' -> true
    'B' -> true
    'C' -> true
    'D' -> true
    'E' -> true
    'F' -> true
    'G' -> true
    'H' -> true
    'I' -> true
    'J' -> true
    'K' -> true
    'L' -> true
    'M' -> true
    'N' -> true
    'O' -> true
    'P' -> true
    'Q' -> true
    'R' -> true
    'S' -> true
    'T' -> true
    'U' -> true
    'V' -> true
    'W' -> true
    'X' -> true
    'Y' -> true
    'Z' -> true
    'a' -> true
    'b' -> true
    'c' -> true
    'd' -> true
    'e' -> true
    'f' -> true
    'g' -> true
    'h' -> true
    'i' -> true
    'j' -> true
    'k' -> true
    'l' -> true
    'm' -> true
    'n' -> true
    'o' -> true
    'p' -> true
    'q' -> true
    'r' -> true
    's' -> true
    't' -> true
    'u' -> true
    'v' -> true
    'w' -> true
    'x' -> true
    'y' -> true
    'z' -> true
    '_' -> true
    _ -> false
  }
}

pub fn is_ident_char(c) {
  if is_alpha(c) {
    true
  } else {
    if is_digit(c) {
      true
    } else {
      match c {
        '.' -> true
        '+' -> true
        '-' -> true
        '<' -> true
        '>' -> true
        '=' -> true
        '!' -> true
        '?' -> true
        '*' -> true
        '/' -> true
        _ -> false
      }
    }
  }
}

fn reverse_helper(lst, acc) {
  if null?(lst) {
    acc
  } else {
    reverse_helper(cdr(lst), cons(car(lst), acc))
  }
}

fn reverse___tokenizer(lst) {
  reverse_helper(lst, nil)
}

pub fn is_kw(s) {
  match s {
    "fn" -> true
    "let" -> true
    "match" -> true
    "if" -> true
    "else" -> true
    "when" -> true
    "spawn" -> true
    "send" -> true
    "import" -> true
    "receive" -> true
    "pub" -> true
    "type" -> true
    "external" -> true
    "const" -> true
    "nil" -> true
    "true" -> true
    "false" -> true
    _ -> false
  }
}

// ---- fmt support: tokenize keeping comments + positions ----
// fmt token format: ((type value) start_off line)
// Comments are kept as tokens ('comment, text) where text includes the "//".
// Lines are 1-based; start_off is the char offset of the token/comment start.

fn fmt_scan_comment(src, start, i, len) {
  if i >= len {
    cons(i, str.substr(src, start, i - start))
  } else {
    if str.char_at(src, i) == '\n' {
      cons(i, str.substr(src, start, i - start))
    } else {
      fmt_scan_comment(src, start, i + 1, len)
    }
  }
}

// fmt_skip_ws(src, i, line, acc) -> (i' line' acc')
// acc accumulates tokens (reversed); comment tokens are prepended as found.
fn fmt_skip_ws(src, i, line, acc) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, acc))
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      fmt_skip_ws(src, i + 1, line, acc)
    } else {
      if c == '\t' {
        fmt_skip_ws(src, i + 1, line, acc)
      } else {
        if c == '\n' {
          fmt_skip_ws(src, i + 1, line + 1, acc)
        } else {
          if c == '\r' {
            fmt_skip_ws(src, i + 1, line, acc)
          } else {
            if c == '/' {
              if i + 1 < len {
                if str.char_at(src, i + 1) == '/' {
                  let r = fmt_scan_comment(src, i, i + 2, len)
                  let end_i = car(r)
                  let text = cdr(r)
                  let tok = cons(cons('comment, text), cons(i, cons(line, cons(text, nil))))
                  fmt_skip_ws(src, end_i, line, cons(tok, acc))
                } else {
                  cons(i, cons(line, acc))
                }
              } else {
                cons(i, cons(line, acc))
              }
            } else {
              cons(i, cons(line, acc))
            }
          }
        }
      }
    }
  }
}

fn fmt_loop(src, i, line, acc) {
  let len = str.length(src)
  let w = fmt_skip_ws(src, i, line, acc)
  let i2 = car(w)
  let line2 = car(cdr(w))
  let acc2 = cdr(cdr(w))
  if i2 >= len {
    reverse___tokenizer(acc2)
  } else {
    let ws_before = if i2 > i { 1 } else { 0 }
    let r = read_token(src, i2, ws_before)
    let tok = car(r)
    let rest = cdr(r)
    let next_i = car(rest)
    let line_delta = cdr(rest)
    let raw = str.substr(src, i2, next_i - i2)
    let t2 = cons(tok, cons(i2, cons(line2, cons(raw, nil))))
    fmt_loop(src, next_i, line2 + line_delta, cons(t2, acc2))
  }
}

pub fn tokenize_fmt(src) {
  fmt_loop(src, 0, 1, nil)
}

// read_string_lit: scan the content of a string literal from `i` (first
// content char) and DECODE backslash escapes into the token value.
//   \n \r \t \\ \" \'  — single-char escapes
//   \xNN               — hex byte escape (e.g. \x0d for CR)
// Unknown escapes keep backslash + char literally. An escaped quote does NOT
// terminate the string. Unterminated strings emit an 'unterminated token with
// the raw content (escapes not decoded) for error reporting.
// Returns cons(cons(token, value), cons(next_index, line_delta)):
// line_delta is the number of '\n' consumed inside the literal, so callers
// keep the token's line 1-based across multi-line strings (issue #91).
fn read_string_lit(src, i, start, acc, line_delta) {
  let len = str.length(src)
  if i >= len {
    let raw = str.substr(src, start, i - start)
    cons(cons('unterminated, raw), cons(i, count_newlines___tokenizer(raw)))
  } else {
    let c = str.char_at(src, i)
    if c == '"' {
      cons(cons('string, acc), cons(i + 1, line_delta))
    } else {
      if c == '\\' {
        // Backslash: decode the escape sequence
        if i + 1 >= len {
          let raw = str.substr(src, start, i - start)
          cons(cons('unterminated, raw), cons(i, count_newlines___tokenizer(raw)))
        } else {
          let e = str.char_at(src, i + 1)
          if e == 'x' {
            // \xNN hex byte escape
            let hi = hex_digit(str.char_at(src, i + 2))
            let lo = hex_digit(str.char_at(src, i + 3))
            if hi < 0 {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              } else {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              }
            } else {
              if lo < 0 {
                read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(120))), line_delta)
              } else {
                read_string_lit(src, i + 4, start, str.concat(acc, str.chr(hi * 16 + lo)), line_delta)
              }
            }
          } else {
            let v = escape_value(e)
            if v < 0 {
              // Unknown escape — keep both characters literally
              read_string_lit(src, i + 2, start, str.concat(acc, str.concat(str.chr(92), str.chr(e))), line_delta)
            } else {
              read_string_lit(src, i + 2, start, str.concat(acc, str.chr(v)), line_delta)
            }
          }
        }
      } else {
        // A raw newline in the source (not a \n escape) advances the line.
        let nd = if c == '\n' { line_delta + 1 } else { line_delta }
        read_string_lit(src, i + 1, start, str.concat(acc, str.chr(c)), nd)
      }
    }
  }
}

// escape_value(c) -> int byte value, or -1 for unknown escapes
fn escape_value(c) {
  if c == 'n' { '\n' }
  else {
    if c == 'r' { '\r' }
    else {
      if c == 't' { '\t' }
      else {
        if c == '\\' { '\\' }
        else {
          if c == '"' { '"' }
          else {
            if c == '\'' { '\'' }
            else { -1 }
          }
        }
      }
    }
  }
}

// hex_digit(c) -> 0..15, or -1 when c is not a hex digit
fn hex_digit(c) {
  if c >= '0' {
    if c <= '9' { c - '0' }
    else {
      if c >= 'a' {
        if c <= 'f' { c - 'a' + 10 }
        else {
          if c >= 'A' {
            if c <= 'F' { c - 'A' + 10 }
            else { -1 }
          } else { -1 }
        }
      } else { -1 }
    }
  } else { -1 }
}

// read_number_lit: scan a numeric literal starting at src[i] (i is at the
// first digit). Decimal integers and float literals are supported; a float
// literal is digits '.' digits (digits on BOTH sides — no exponent notation,
// no "1." / ".5" shorthand). Returns cons(token, next_index):
//   digits            -> ('int, n)
//   digits '.' digits -> ('float, "digits.digits")
// The float VALUE is carried as the literal string — the bootstrap language
// has no float values, so the string flows token → AST → bytecode and the VM
// parses it with strtod at runtime.
fn read_number_lit(src, i, start) {
  let len = str.length(src)
  if i >= len {
    finish_number(src, start, len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_number_lit(src, i + 1, start)
    } else {
      if str.char_at(src, i) == '.' {
        if i + 1 < len {
          if is_digit(str.char_at(src, i + 1)) {
            read_frac_lit(src, i + 2, start)
          } else {
            // "1." — a dot with no fractional digit is NOT a float literal;
            // emit the int and let the caller choke on the dot.
            finish_number(src, start, i)
          }
        } else {
          // "1." at end of input: int, then a trailing dot (syntax error).
          finish_number(src, start, i)
        }
      } else {
        finish_number(src, start, i)
      }
    }
  }
}

// read_frac_lit: scan digits after the '.' of a float literal. i is the
// first index AFTER the dot; start is the start of the whole literal
// (the '.' is included because read_number_lit passes its own start).
fn read_frac_lit(src, i, start) {
  let len = str.length(src)
  if i >= len {
    let s = str.substr(src, start, len - start)
    cons(cons('float, s), len)
  } else {
    if is_digit(str.char_at(src, i)) {
      read_frac_lit(src, i + 1, start)
    } else {
      let s = str.substr(src, start, i - start)
      cons(cons('float, s), i)
    }
  }
}

fn finish_number(src, start, end) {
  let s = str.substr(src, start, end - start)
  cons(cons('int, str.to_int(s)), end)
}

fn read_ident(src, i, start) {
  let len = str.length(src)
  if i >= len {
    make_ident_tok(src, start, len)
  } else {
    if is_ident_char(str.char_at(src, i)) {
      read_ident(src, i + 1, start)
    } else {
      make_ident_tok(src, start, i)
    }
  }
}

fn make_ident_tok(src, start, end) {
  let s = str.substr(src, start, end - start)
  if is_kw(s) {
    cons(cons('kw, s), end)
  } else {
    cons(cons('ident, s), end)
  }
}

// read_char_lit: try to parse a char literal at src[i] (i is at a quote).
// Supports plain 'X' and the same backslash escapes as strings:
// \n \r \t \\ \" \' \xNN. Returns cons(token, next_index) on success,
// or nil when this quote is NOT a char literal (i.e. it is a quote form).
fn read_char_lit(src, i, len) {
  if i + 1 < len {
    if str.char_at(src, i + 1) == '\\' {
      // backslash escape: '\X' is 4 chars, '\xNN' is 6 chars
      if i + 2 < len {
        let e = str.char_at(src, i + 2)
        if e == 'x' {
          // \xNN hex escape: '\xNN' closing quote at i + 5
          if i + 5 < len {
            if str.char_at(src, i + 5) == '\'' {
              let hi = hex_digit(str.char_at(src, i + 3))
              let lo = hex_digit(str.char_at(src, i + 4))
              if hi >= 0 {
                if lo >= 0 { cons(cons('int, hi * 16 + lo), i + 6) }
                else { nil }
              } else { nil }
            } else { nil }
          } else { nil }
        } else {
          // single-char escape: '\X' closing quote at i + 3
          if i + 3 < len {
            if str.char_at(src, i + 3) == '\'' {
              let v = escape_value(e)
              if v < 0 { nil } else { cons(cons('int, v), i + 4) }
            } else { nil }
          } else { nil }
        }
      } else { nil }
    } else {
      // plain 'X': closing quote at i + 2
      if i + 2 < len {
        if str.char_at(src, i + 2) == '\'' {
          cons(cons('int, str.char_at(src, i + 1)), i + 3)
        } else { nil }
      } else { nil }
    }
  } else { nil }
}

// read_token returns a triple: (token, next_index, line_delta), where
// line_delta is the number of newlines consumed INSIDE the token (multi-line
// string literals). Callers add it to their line state to stay 1-based
// across multi-line tokens (issue #91).
fn read_token(src, i, ws_before) {
  let len = str.length(src)
  let c = str.char_at(src, i)
  match c {
    // lparen value records whether whitespace preceded it (1) or it is
    // glued to the previous token (0). The parser uses this to enforce
    // that calls are written f(x) — a spaced `(` after an identifier is
    // a syntax error, not a call opener (TA has no Lisp s-exprs).
    '(' -> cons(cons('lparen, ws_before), cons(i + 1, 0))
    ')' -> cons(cons('rparen, nil), cons(i + 1, 0))
    '{' -> cons(cons('lbrace, nil), cons(i + 1, 0))
    '}' -> cons(cons('rbrace, nil), cons(i + 1, 0))
    ',' -> cons(cons('comma, nil), cons(i + 1, 0))
    ':' -> cons(cons('colon, nil), cons(i + 1, 0))
    ';' -> cons(cons('semicol, nil), cons(i + 1, 0))
    '[' -> cons(cons('lbracket, nil), cons(i + 1, 0))
    ']' -> cons(cons('rbracket, nil), cons(i + 1, 0))
    '\'' -> {
      // Disambiguation (D6): 'X' (quote-char-quote) is a char literal whose
      // token value is the Unicode codepoint of X; escapes like '\n' decode
      // the same as strings. Any other use of ' is the quote form
      // ('symbol -> (quote symbol) in the parser).
      let r = read_char_lit(src, i, len)
      if null?(r) {
        cons(cons('quote, nil), cons(i + 1, 0))
      } else {
        cons(car(r), cons(cdr(r), 0))
      }
    }
    '"' -> {
      let r = read_string_lit(src, i + 1, i + 1, "", 0)
      cons(car(r), cdr(r))
    }
    '-' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '>' {
          cons(cons('arrow, nil), cons(i + 2, 0))
        } else {
          if is_digit(str.char_at(src, i + 1)) {
            let r = read_number_lit(src, i + 1, i + 1)
            let tok = car(r)
            let val = cdr(tok)
            let next_i = cdr(r)
            if car(tok) == 'float {
              // Negative float: keep the sign in the literal string, e.g.
              // ('float, "-1.5") — the value is a string end-to-end.
              cons(cons('float, str.concat("-", val)), cons(next_i, 0))
            } else {
              cons(cons('int, 0 - val), cons(next_i, 0))
            }
          } else {
            cons(cons('op, "-"), cons(i + 1, 0))
          }
        }
      } else {
        cons(cons('op, "-"), cons(i + 1, 0))
      }
    }
    '=' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "=="), cons(i + 2, 0))
        } else {
          cons(cons('op, "="), cons(i + 1, 0))
        }
      } else {
        cons(cons('op, "="), cons(i + 1, 0))
      }
    }
    '<' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "<="), cons(i + 2, 0))
        } else {
          cons(cons('op, "<"), cons(i + 1, 0))
        }
      } else {
        cons(cons('op, "<"), cons(i + 1, 0))
      }
    }
    '>' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, ">="), cons(i + 2, 0))
        } else {
          cons(cons('op, ">"), cons(i + 1, 0))
        }
      } else {
        cons(cons('op, ">"), cons(i + 1, 0))
      }
    }
    '+' -> cons(cons('op, "+"), cons(i + 1, 0))
    '!' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '=' {
          cons(cons('op, "!="), cons(i + 2, 0))
        } else {
          cons(cons('unknown, nil), cons(i + 1, 0))
        }
      } else {
        cons(cons('unknown, nil), cons(i + 1, 0))
      }
    }
    '*' -> cons(cons('op, "*"), cons(i + 1, 0))
    '/' -> cons(cons('op, "/"), cons(i + 1, 0))
    '%' -> cons(cons('op, "%"), cons(i + 1, 0))
    '&' -> {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '&' {
          cons(cons('op, "&&"), cons(i + 2, 0))
        } else {
          cons(cons('unknown, nil), cons(i + 1, 0))
        }
      } else {
        cons(cons('unknown, nil), cons(i + 1, 0))
      }
    }
    '|' -> {
      if i + 1 < len {
        let c2 = str.char_at(src, i + 1)
        if c2 == '|' {
          cons(cons('op, "||"), cons(i + 2, 0))
        } else if c2 == '>' {
          cons(cons('op, "|>"), cons(i + 2, 0))
        } else {
          cons(cons('unknown, nil), cons(i + 1, 0))
        }
      } else {
        cons(cons('unknown, nil), cons(i + 1, 0))
      }
    }
    _ -> {
      if is_digit(c) {
        let r = read_number_lit(src, i, i)
        cons(car(r), cons(cdr(r), 0))
      } else {
        if is_alpha(c) {
          let r = read_ident(src, i, i)
          cons(car(r), cons(cdr(r), 0))
        } else {
          cons(cons('unknown, nil), cons(i + 1, 0))
        }
      }
    }
  }
}

// ---- main tokenize path with positions (issue #66) ----
// tokenize_pos scans identically to the old tokenize_loop but also tracks
// the (line col off) of each token: 1-based line/column of the token's
// first char plus its 0-based source offset. The driver uses these to
// report parse errors with a location and a source snippet. tokenize keeps
// its original signature (plain token list) so existing callers are
// unaffected.

// skip_ws_l(src, i, line) -> (i' line'): skip whitespace and // comments,
// counting newlines so `line` stays 1-based.
fn skip_ws_l(src, i, line) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, nil))
  } else {
    let c = str.char_at(src, i)
    if c == ' ' {
      skip_ws_l(src, i + 1, line)
    } else if c == '\t' {
      skip_ws_l(src, i + 1, line)
    } else if c == '\n' {
      skip_ws_l(src, i + 1, line + 1)
    } else if c == '\r' {
      skip_ws_l(src, i + 1, line)
    } else if c == '/' {
      if i + 1 < len {
        if str.char_at(src, i + 1) == '/' {
          skip_comment_l(src, i + 2, line)
        } else {
          cons(i, cons(line, nil))
        }
      } else {
        cons(i, cons(line, nil))
      }
    } else {
      cons(i, cons(line, nil))
    }
  }
}

fn skip_comment_l(src, i, line) {
  let len = str.length(src)
  if i >= len {
    cons(i, cons(line, nil))
  } else {
    if str.char_at(src, i) == '\n' {
      skip_ws_l(src, i + 1, line + 1)
    } else {
      skip_comment_l(src, i + 1, line)
    }
  }
}

// Number of '\n' in s. Only used on the rare unterminated-string path.
fn count_newlines___tokenizer(s) {
  let n = str.index_of(s, "\n")
  if n < 0 {
    0
  } else {
    1 + count_newlines___tokenizer(str.substr(s, n + 1, str.length(s) - n - 1))
  }
}

// 0-based offset of the first character of the line containing `i`.
fn pos_line_start(src, i) {
  if i <= 0 {
    0
  } else {
    if str.char_at(src, i - 1) == '\n' {
      i
    } else {
      pos_line_start(src, i - 1)
    }
  }
}

// 1-based column of offset `i` within its line.
fn line_col(src, i) {
  i - pos_line_start(src, i) + 1
}

// Position entry for a token starting at `off` on `line`: (line col off).
fn mk_pos(src, off, line) {
  cons(line, cons(line_col(src, off), cons(off, nil)))
}

// tokenize_pos_loop(src, i, line, tacc, pacc) -> (tokens . positions)
// Token list and position list are built in parallel (same order, same
// length); both include the trailing 'eof' token, whose position is the
// end-of-file location. `line` is advanced by each token's line_delta so
// it stays correct across multi-line string literals (issue #91).
fn tokenize_pos_loop(src, i, line, tacc, pacc) {
  let len = str.length(src)
  let w = skip_ws_l(src, i, line)
  let i2 = car(w)
  let line2 = car(cdr(w))
  if i2 >= len {
    let toks = reverse___tokenizer(cons(cons('eof, nil), tacc))
    let poss = reverse___tokenizer(cons(mk_pos(src, i2, line2), pacc))
    cons(toks, poss)
  } else {
    let ws_before = if i2 > i { 1 } else { 0 }
    let result = read_token(src, i2, ws_before)
    let tok = car(result)
    let rest = cdr(result)
    let next_i = car(rest)
    let line_delta = cdr(rest)
    tokenize_pos_loop(src, next_i, line2 + line_delta, cons(tok, tacc), cons(mk_pos(src, i2, line2), pacc))
  }
}

// tokenize_pos(src) -> (tokens . positions): tokens identical to
// tokenize(src), plus one (line col off) entry per token.
pub fn tokenize_pos(src) {
  tokenize_pos_loop(src, 0, 1, nil, nil)
}

pub fn tokenize(src) {
  car(tokenize_pos(src))
}


// List helpers
fn list_ref(lst, n) {
  if null?(lst) { nil }
  else { if n <= 0 { car(lst) } else { list_ref(cdr(lst), n - 1) } }
}

fn list_length(lst) {
  if null?(lst) { 0 } else { 1 + list_length(cdr(lst)) }
}

// Token cursor helpers (threaded state pattern)
// The parser threads `toks` as a bundle (tokvec_id poss path): the token
// vec handle the VM accessors expect, plus the parallel (line col off)
// position list and the source path used ONLY by --cov builds to stamp
// (cov.line path line) markers onto statements. poss is nil for plain
// parse() — markers vanish and the AST is identical to the untagged parse.
fn ttype(toks, pos) {
  vm.tok_type(car(toks), pos)
}

fn tval(toks, pos) {
  vm.tok_val(car(toks), pos)
}

fn is_type(toks, pos, typ) {
  if vm.tok_type(car(toks), pos) == typ { 1 } else { 0 }
}

fn p_is_kw(toks, pos, kw) {
  if is_type(toks, pos, 'kw) == 1 {
    if tval(toks, pos) == kw { 1 } else { 0 }
  } else { 0 }
}

fn is_op(toks, pos, op) {
  if is_type(toks, pos, 'op) == 1 {
    if tval(toks, pos) == op { 1 } else { 0 }
  } else { 0 }
}

// cov_tag(toks, pos, form): wrap a statement in a --cov location marker
// (begin (cov.line path line) form). The line comes from the token
// position list at the statement's first token. With no position list
// (plain parse) the form is returned untouched.
fn cov_tag(toks, pos, form) {
  if null?(car(cdr(toks))) { form }
  else {
    let loc = list_ref(car(cdr(toks)), pos)
    cons('begin,
    cons(cons('cov.line, cons(car(cdr(cdr(toks))), cons(car(loc), nil))),
    cons(form, nil)))
  }
}

fn is_uppercase(s) {
  let c = str.char_at(s, 0)
  if c >= 'A' { if c <= 'Z' { 1 } else { 0 } } else { 0 }
}

// === Expression parser: returns (result . next_pos) ===

// Infix logical precedence (lowest → highest binding): `||` then `&&`.
// `a || b && c` must parse as `a || (b && c)`, so `&&` is handled inside
// parse_comparison (tighter than comparison) and `||` sits at the top.
fn parse_expr(toks, pos) {
  let r = parse_or_level(toks, pos)
  let left = car(r)
  let p = cdr(r)
  parse_pipe_rest(toks, p, left)
}

// (a || b || ...) — the full infix ladder minus |>. Pipe binds loosest
// of all, so it sits on top in parse_expr.
fn parse_or_level(toks, pos) {
  let r = parse_comparison(toks, pos)
  let left = car(r)
  let p = cdr(r)
  let r2 = parse_and_rest(toks, p, left)
  let left2 = car(r2)
  let p2 = cdr(r2)
  parse_or_rest(toks, p2, left2)
}

// (a |> f(b) |> g(c)) — lowest-precedence pipe, left-associative.
// Desugared at parse time: `left |> right` rewrites so `left` becomes
// the FIRST argument of the call on the right:
//   x |> f(a, b)  =>  (f x a b)
//   x |> f        =>  (f x)
//   x |> Foo(a)   =>  (cons (quote Foo) (cons x (cons a nil)))
// Anything else on the right is a parse error.
fn parse_pipe_rest(toks, pos, left) {
  if is_op(toks, pos, "|>") == 1 {
    let r = parse_or_level(toks, pos + 1)
    let right = car(r)
    let p2 = cdr(r)
    let rw = rewrite_pipe(left, right, pos)
    let expr = car(rw)
    let p3 = cdr(rw)
    if is_pipe_error_node(expr) == 1 {
      rw
    } else {
      // Success: advance past the right-hand expression (p2), NOT the
      // pipe token's own position, or the loop would re-read `|>`.
      parse_pipe_rest(toks, p2, expr)
    }
  } else {
    cons(left, pos)
  }
}

fn is_pipe_error_node(expr) {
  if pair?(expr) {
    if car(expr) == 'parse_error { 1 } else { 0 }
  } else {
    0
  }
}

// Build a positioned parse-error marker. The returned pair follows the
// parser's (form . nextpos) convention, but the marker form itself also
// carries the offending token index — (parse_error msg tokpos) — so the
// driver can report line/col for the error (issue #66).
fn mk_parse_error(msg, pos) {
  cons(cons('parse_error, cons(msg, pos)), pos)
}

fn rewrite_pipe(left, right, pos) {
  if symbol?(right) {
    // x |> f  =>  (f x)
    if is_pipeable_head(right) == 1 {
      cons(cons(right, cons(left, nil)), pos)
    } else {
      pipe_error(pos)
    }
  } else if pair?(right) {
    let head = car(right)
    if is_pipeable_head(head) == 1 {
      if head == 'cons {
        // Constructor call: (cons (quote Name) arg_chain)
        // x |> Foo(a, b)  =>  (cons (quote Foo) (cons x (cons a (cons b nil))))
        let quoted = car(cdr(right))
        let arg_chain = car(cdr(cdr(right)))
        if pair?(quoted) {
          if car(quoted) == 'quote {
            let new_args = cons('cons, cons(left, cons(arg_chain, nil)))
            cons(cons('cons, cons(quoted, cons(new_args, nil))), pos)
          } else {
            pipe_error(pos)
          }
        } else {
          pipe_error(pos)
        }
      } else {
        // x |> f(a, b)  =>  (f x a b)
        cons(cons(head, cons(left, cdr(right))), pos)
      }
    } else {
      pipe_error(pos)
    }
  } else {
    pipe_error(pos)
  }
}

// Only ordinary function names may be pipe targets. Operators and special
// forms also have symbol heads in the AST, but are not calls.
fn is_pipeable_head(head) {
  if head == 'cons {
    1
  } else if symbol?(head) {
    if head == 'quote { 0 }
    else if head == 'if { 0 }
    else if head == 'let { 0 }
    else if head == 'begin { 0 }
    else if head == 'match { 0 }
    else if head == 'and { 0 }
    else if head == 'or { 0 }
    else if head == 'float { 0 }
    else if head == str.to_sym("+") { 0 }
    else if head == str.to_sym("-") { 0 }
    else if head == str.to_sym("*") { 0 }
    else if head == str.to_sym("/") { 0 }
    else if head == str.to_sym("%") { 0 }
    else if head == str.to_sym("=") { 0 }
    else if head == str.to_sym("!=") { 0 }
    else if head == str.to_sym("<") { 0 }
    else if head == str.to_sym(">") { 0 }
    else if head == str.to_sym("<=") { 0 }
    else if head == str.to_sym(">=") { 0 }

    else { 1 }
  } else {
    0
  }
}

fn pipe_error(pos) {
  mk_parse_error("pipe target must be a function call (x |> f(a, b))", pos + 1)
}

// (a || b || ...) — lowest-precedence logical infix. Binds looser than &&.
// Right operands are parsed at comparison level, which includes &&, so
// `a || b && c` becomes ('or a ('and b c)).
fn parse_or_rest(toks, pos, left) {
  if is_op(toks, pos, "||") == 1 {
    let r = parse_comparison(toks, pos + 1)
    parse_or_rest(toks, cdr(r), cons(str.to_sym("or"), cons(left, cons(car(r), nil))))
  } else {
    cons(left, pos)
  }
}

// (a && b && ...) — logical-and infix. Binds tighter than ||, looser than
// comparisons. parse_comparison hands off here once its comparison chain
// ends, and the right operand is a full comparison (so `a && b == c`
// becomes ('and a ('= b c))).
fn parse_and_rest(toks, pos, left) {
  if is_op(toks, pos, "&&") == 1 {
    let r = parse_comparison(toks, pos + 1)
    parse_and_rest(toks, cdr(r), cons(str.to_sym("and"), cons(left, cons(car(r), nil))))
  } else {
    cons(left, pos)
  }
}

fn parse_comparison(toks, pos) {
  let r = parse_additive(toks, pos)
  let left = car(r)
  let p = cdr(r)
  if is_op(toks, p, "<") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("<"), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, p, ">") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym(">"), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, p, "<=") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("<="), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, p, ">=") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym(">="), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, p, "==") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("="), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, p, "!=") == 1 {
    let r2 = parse_additive(toks, p + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("!="), cons(left, cons(car(r2), nil))))
  } else {
    // No comparison operator — hand off to the && level.
    parse_and_rest(toks, p, left)
  }
}

fn parse_comparison_rest(toks, pos, left) {
  if is_op(toks, pos, "<") == 1 {
    let r2 = parse_additive(toks, pos + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("<"), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, pos, ">") == 1 {
    let r2 = parse_additive(toks, pos + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym(">"), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, pos, "==") == 1 {
    let r2 = parse_additive(toks, pos + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("="), cons(left, cons(car(r2), nil))))
  } else if is_op(toks, pos, "!=") == 1 {
    let r2 = parse_additive(toks, pos + 1)
    parse_comparison_rest(toks, cdr(r2), cons(str.to_sym("!="), cons(left, cons(car(r2), nil))))
  } else {
    // Comparison chain complete — hand off to the && level.
    parse_and_rest(toks, pos, left)
  }
}

fn parse_additive(toks, pos) {
  let r = parse_multiplicative(toks, pos)
  let left = car(r)
  let p = cdr(r)
  parse_additive_rest(toks, p, left)
}

fn parse_additive_rest(toks, pos, left) {
  if is_op(toks, pos, "+") == 1 {
    let r = parse_multiplicative(toks, pos + 1)
    parse_additive_rest(toks, cdr(r), cons(str.to_sym("+"), cons(left, cons(car(r), nil))))
  } else if is_op(toks, pos, "-") == 1 {
    let r = parse_multiplicative(toks, pos + 1)
    parse_additive_rest(toks, cdr(r), cons(str.to_sym("-"), cons(left, cons(car(r), nil))))
  } else {
    cons(left, pos)
  }
}

// Chained call suffix: f(x)(y)(z) -> (((f x) y) z).
// parse_operand returns (expr . next_pos); if next_pos points at '(' the
// expression is being called with more args — wrap it as a nested call
// instead of letting the following (…) fall through as a sibling
// expression / extra argument of an enclosing call.
fn parse_operand_chain(toks, pos) {
  let r = parse_operand(toks, pos)
  let node = car(r)
  let p = cdr(r)
  parse_chain_suffix(toks, p, node)
}

fn parse_chain_suffix(toks, pos, node) {
  if is_type(toks, pos, 'lparen) == 1 {
    let ar = parse_call_args_list(toks, pos + 1, nil, 0)
    let args = car(ar)
    let p2 = cdr(ar)
    parse_chain_suffix(toks, p2, cons(node, args))
  } else {
    cons(node, pos)
  }
}

fn parse_multiplicative(toks, pos) {
  let r = parse_operand_chain(toks, pos)
  let left = car(r)
  let p = cdr(r)
  parse_mult_rest(toks, p, left)
}

fn parse_mult_rest(toks, pos, left) {
  if is_op(toks, pos, "*") == 1 {
    let r = parse_operand_chain(toks, pos + 1)
    parse_mult_rest(toks, cdr(r), cons(str.to_sym("*"), cons(left, cons(car(r), nil))))
  } else if is_op(toks, pos, "/") == 1 {
    let r = parse_operand_chain(toks, pos + 1)
    parse_mult_rest(toks, cdr(r), cons(str.to_sym("/"), cons(left, cons(car(r), nil))))
  } else if is_op(toks, pos, "%") == 1 {
    let r = parse_operand_chain(toks, pos + 1)
    parse_mult_rest(toks, cdr(r), cons(str.to_sym("%"), cons(left, cons(car(r), nil))))
  } else {
    cons(left, pos)
  }
}

// Build a proper list from array items: (item1 item2 ...)
fn build_call_list(head, items, n) {
  if n <= 0 {
    nil
  } else {
    cons(head, build_args(items, 0, n))
  }
}

fn build_args(items, i, n) {
  if i >= n { nil }
  else { cons(list_ref(items, i), build_args(items, i + 1, n)) }
}

fn parse_operand(toks, pos) {
  let typ = ttype(toks, pos)
  let val = tval(toks, pos)

  if typ == 'op {
    cons(str.to_sym(val), pos + 1)
  } else if typ == 'int {
    cons(val, pos + 1)
  } else if typ == 'float {
    // Float literal: the token value is the literal STRING (e.g. "1.5");
    // the bootstrap language has no float values, so the string flows
    // AST → bytecode and the VM parses it with strtod at runtime.
    // Node shape: ('float "1.5") — a PROPER list (a generic improper pair
    // like ('float . "1.5") would break typecheck's tree walkers, which
    // call cdr on list tails).
    cons(cons('float, cons(val, nil)), pos + 1)
  } else if typ == 'string {
    // String literal
    cons(val, pos + 1)
  } else if typ == 'kw {
    // nil/true/false keywords, then form keywords
    if val == "nil" {
      cons(nil, pos + 1)
    } else if val == "true" {
      cons(true, pos + 1)
    } else if val == "false" {
      cons(false, pos + 1)
    } else if val == "fn" {
      parse_lambda(toks, pos)
    } else if val == "if" {
      parse_if_expr(toks, pos)
    } else if val == "match" {
      parse_match(toks, pos)
    } else if val == "receive" {
      parse_receive(toks, pos)
    } else {
      // Other keywords (spawn, send, etc.) treated as identifiers
      parse_ident_or_call(toks, pos)
    }
  } else if typ == 'ident {
    // Identifier
    parse_ident_or_call(toks, pos)
  } else if typ == 'lbracket {
    // List literal [a, b, c] -> (list ...) form
    parse_list_expr(toks, pos + 1, nil)
  } else if typ == 'lparen {
    // Parenthesized expression: parse ALL elements, not just the
    // first. A single element is unwrapped; multiple elements form
    // a list. (This is what makes (or a b) / (and a b) parse into a
    // proper list headed by 'or/'and — previously the inner or/and
    // was truncated to a bare symbol and fell through to a function
    // call, i.e. short-circuit logic never compiled.)
    parse_paren_list(toks, pos + 1, nil)
  } else if typ == 'lbrace {
    // Braced block
    parse_braced(toks, pos)
  } else if typ == 'quote {
    // Quote — read single atom as symbol
    let val = tval(toks, pos + 1)
    cons(cons('quote, cons(str.to_sym(val), nil)), pos + 2)
  } else {
    cons(nil, pos + 1)
  }
}

fn parse_lambda(toks, pos) {
  // pos at 'fn' keyword
  let p = pos + 1
  if is_type(toks, p, 'lparen) == 1 {
    let pr = parse_param_list(toks, p)
    let pairs = car(pr)
    let params = extract_names(pairs)
    let p2 = cdr(pr)
    // optional -> Type return-type annotation (nil when absent)
    let ar = parse_return_type(toks, p2)
    let ret_type = car(ar)
    let p3 = cdr(ar)
    let br = parse_braced(toks, p3)
    let body = car(br)
    let p4 = cdr(br)
    cons(cons('lambda, cons(params, cons(body, cons(ret_type, nil)))), p4)
  } else {
    // no params
    let ar = parse_return_type(toks, p)
    let ret_type = car(ar)
    let p3 = cdr(ar)
    let br = parse_braced(toks, p3)
    let body = car(br)
    let p4 = cdr(br)
    cons(cons('lambda, cons(nil, cons(body, cons(ret_type, nil)))), p4)
  }
}

fn extract_names(pairs) {
  if null?(pairs) { nil }
  else { cons(car(car(pairs)), extract_names(cdr(pairs))) }
}

fn extract_types(pairs) {
  if null?(pairs) { nil }
  else { cons(cdr(car(pairs)), extract_types(cdr(pairs))) }
}

fn has_any_nonnil(lst) {
  if null?(lst) { 0 }
  else { if null?(car(lst)) { has_any_nonnil(cdr(lst)) } else { 1 } }
}

fn has_any_type(types, ret_type) {
  if null?(ret_type) { has_any_nonnil(types) } else { 1 }
}

fn parse_return_type(toks, pos) {
  if is_type(toks, pos, 'arrow) == 1 {
    let tr = parse_type_after_colon(toks, pos + 1)
    cons(car(tr), cdr(tr))
  } else {
    cons(nil, pos)
  }
}

fn prepend_all(forms, acc) {
  if null?(forms) { acc }
  else { prepend_all(cdr(forms), cons(car(forms), acc)) }
}

fn wrap_single(form, pos) {
  cons(cons(form, nil), pos)
}

fn parse_param_list(toks, pos) {
  // pos at 'lparen'
  let p = pos + 1
  parse_params_loop(toks, p, nil)
}

fn parse_params_loop(toks, pos, acc) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(reverse_list(acc), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed param list — stop without advancing.
    cons(reverse_list(acc), pos)
  } else {
    let pr = parse_single_param(toks, pos)
    let pair = cons(car(pr), car(cdr(pr)))
    let p = cdr(cdr(pr))
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_params_loop(toks, p2, cons(pair, acc))
  }
}

fn parse_single_param(toks, pos) {
  // ident, optional : Type
  // returns (name_sym . (type_repr . pos))
  let name = tval(toks, pos)
  let p = pos + 1
  if is_type(toks, p, 'colon) == 1 {
    let tr = parse_type_after_colon(toks, p + 1)
    cons(str.to_sym(name), cons(car(tr), cdr(tr)))
  } else {
    cons(str.to_sym(name), cons(nil, p))
  }
}

// parse_type_after_colon(toks, pos) -> (type_repr . next_pos)
// pos points at the type name token. Parses a single type atom — symbol,
// (Name arg1 ...) compound, or (quote sym) — optionally followed by -> for
// function types (right-associative):
//   a -> b        => ('arrow a b)
//   a -> b -> c   => ('arrow a ('arrow b c))
fn parse_type_after_colon(toks, pos) {
  let base = parse_type_atom(toks, pos)
  if is_type(toks, cdr(base), 'arrow) == 1 {
    let right = parse_type_after_colon(toks, cdr(base) + 1)
    cons(cons('arrow, cons(car(base), cons(car(right), nil))), cdr(right))
  } else {
    base
  }
}

fn parse_type_atom(toks, pos) {
  if is_type(toks, pos, 'quote) == 1 {
    // quoted type param: 'a -> (quote a)
    let inner = str.to_sym(tval(toks, pos + 1))
    cons(cons('quote, cons(inner, nil)), pos + 2)
  } else {
    let type_sym = str.to_sym(tval(toks, pos))
    let p = pos + 1
    if is_type(toks, p, 'lparen) == 1 {
      let args_r = parse_type_args(toks, p + 1, nil)
      let args = car(args_r)
      let p2 = cdr(args_r)
      cons(cons(type_sym, args), p2)
    } else {
      cons(type_sym, p)
    }
  }
}

// parse_type_args(toks, pos, acc) -> (reversed_arg_list . next_pos)
fn parse_type_args(toks, pos, acc) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(reverse_list(acc), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed type-arg list — stop without advancing.
    cons(reverse_list(acc), pos)
  } else {
    let tr = parse_type_after_colon(toks, pos)
    let arg = car(tr)
    let p = cdr(tr)
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_type_args(toks, p2, cons(arg, acc))
  }
}

fn skip_type(toks, pos) {
  if is_type(toks, pos, 'comma) == 1 { pos }
  else if is_type(toks, pos, 'rparen) == 1 { pos }
  else if is_type(toks, pos, 'eof) == 1 { pos }
  else { skip_type(toks, pos + 1) }
}

// Direction B: a '(' token carries whether whitespace preceded it (value 1)
// or it is glued to the previous token (value 0). is_ws_lparen reports a
// SPACED '('. Calls must be glued — f(x), not f (x) — so a spaced '(' after
// an identifier is a syntax error, never a call opener.
fn is_ws_lparen(toks, pos) {
  if is_type(toks, pos, 'lparen) == 1 {
    if tval(toks, pos) == 1 { 1 } else { 0 }
  } else { 0 }
}

fn parse_ident_or_call(toks, pos) {
  let name = tval(toks, pos)
  let p = pos + 1
  let is_ctor = is_uppercase(name)

  if is_ctor == 1 {
    // Constructor
    if is_ws_lparen(toks, p) == 1 {
      // Spaced '(' — not this constructor's arg list. TA has no Lisp
      // s-exprs: P(x) is the only constructor call form, so reject
      // rather than silently misparse.
      mk_parse_error("constructor call must be glued: P(x), not P (x)", p + 1)
    } else if is_type(toks, p, 'lparen) == 1 {
      // n-ary constructor: (cons (quote Name) (cons arg1 ... nil))
      let ar = parse_call_args(toks, p + 1, nil, 0)
      let args = car(ar)
      let p2 = cdr(ar)
      let quoted_head = cons('quote, cons(str.to_sym(name), nil))
      cons(cons('cons, cons(quoted_head, cons(args, nil))), p2)
    } else {
      // nullary constructor: (quote Name)
      cons(cons('quote, cons(str.to_sym(name), nil)), p)
    }
  } else {
    // Regular identifier
    let sym = str.to_sym(name)
    if is_ws_lparen(toks, p) == 1 {
      // f (x) is invalid — the call's arg-list paren must be glued: f(x).
      // Letting it through is what used to make sexp-style (f (g x)) parse.
      mk_parse_error("call must be glued: f(x), not f (x)", p + 1)
    } else if is_type(toks, p, 'lparen) == 1 {
      // function call: (sym arg1 arg2 ...)
      let ar = parse_call_args_list(toks, p + 1, nil, 0)
      let args = car(ar)
      let p2 = cdr(ar)
      cons(cons(sym, args), p2)
    } else {
      // just a variable reference
      cons(sym, p)
    }
  }
}

// Parse call args, return (args_list . next_pos) where args_list is proper list
fn parse_call_args_list(toks, pos, acc, n) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(reverse_list(acc), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed call — stop without advancing.
    cons(reverse_list(acc), pos)
  } else {
    let r = parse_expr(toks, pos)
    let arg = car(r)
    let p = cdr(r)
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_call_args_list(toks, p2, cons(arg, acc), n + 1)
  }
}

// Parse constructor args, return (nested_cons . next_pos)
fn parse_call_args(toks, pos, acc, n) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(build_cons_chain(acc, n), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed ctor call — stop without advancing.
    cons(build_cons_chain(acc, n), pos)
  } else {
    let r = parse_expr(toks, pos)
    let arg = car(r)
    let p = cdr(r)
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_call_args(toks, p2, cons(arg, acc), n + 1)
  }
}

fn build_cons_chain(items, n) {
  if n <= 0 { nil }
  else {
    let rest = build_cons_chain(items, n - 1)
    let item = list_ref(items, n - 1)
    cons('cons, cons(item, cons(rest, nil)))
  }
}

// Reverse a list
fn reverse_list(lst) {
  p_rev_helper(lst, nil)
}

// Parse parenthesized content: (e1 e2 ... eN). Each element is parsed as a
// full expression (infix works inside). A single element is unwrapped so
// (a + b) yields (+ a b), not ((+ a b)).
fn parse_paren_list(toks, pos, acc) {
  if is_type(toks, pos, 'rparen) == 1 {
    let items = reverse_list(acc)
    if is_and_or_head(items) == 1 {
      // User-written prefix (and ...) / (or ...) is rejected: the only
      // supported logical connectives are && and ||. The 'and / 'or
      // symbols are internal IR built by parse_and_rest / parse_or_rest
      // (from && / ||) and mk_and (pattern guards) — those construct the
      // cons directly and never pass through parse_paren_list, so they
      // are unaffected by this check.
      mk_parse_error("use && or || instead of (and ...)/(or ...)", pos + 1)
    } else if null?(cdr(items)) {
      if null?(items) { cons(nil, pos + 1) }
      else { cons(car(items), pos + 1) }
    } else {
      // Multi-element paren lists are the Lisp s-expr call form (f x).
      // TA has no s-exprs — calls are written f(x), lists are [a b c].
      // Rejecting here is what makes (car x x) and (car (cdr r)) fail at
      // parse time instead of silently misparsing to the VM.
      mk_parse_error("no Lisp-style parenthesized calls: write f(x) instead of (f x)", pos + 1)
    }
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed paren — stop without advancing (fuzz inputs hit this).
    cons(reverse_list(acc), pos)
  } else {
    let r = parse_expr(toks, pos)
    parse_paren_list(toks, cdr(r), cons(car(r), acc))
  }
}

// is_and_or_head(items): true when a parenthesized list starts with the
// identifier `and` or `or`, i.e. user wrote prefix (and ...) / (or ...).
// (and a b) parses the first element to the symbol 'and, so any arity —
// (and), (and a), (and a b) — is caught here.
fn is_and_or_head(items) {
  if null?(items) { 0 }
  else {
    let head = car(items)
    if head == 'and { 1 }
    else { if head == 'or { 1 } else { 0 } }
  }
}

fn p_rev_helper(lst, acc) {
  if null?(lst) { acc }
  else { p_rev_helper(cdr(lst), cons(car(lst), acc)) }
}

// === Block parser ===

fn parse_braced(toks, pos) {
  // expect lbrace
  let p = if is_type(toks, pos, 'lbrace) == 1 { pos + 1 } else { pos }
  let r = parse_block_rest(toks, p)
  let body = car(r)
  let p2 = cdr(r)
  // skip rbrace
  let p3 = if is_type(toks, p2, 'rbrace) == 1 { p2 + 1 } else { p2 }
  cons(body, p3)
}

fn skip_semi(toks, pos) {
  if is_type(toks, pos, 'semicol) == 1 { pos + 1 } else { pos }
}

fn parse_block_rest(toks, pos) {
  let p = skip_semi(toks, pos)
  if is_type(toks, p, 'rbrace) == 1 {
    cons(nil, p)
  } else if is_type(toks, p, 'eof) == 1 {
    cons(nil, p)
  } else {
    let fr = parse_form(toks, p)
    let first = car(fr)
    let p2 = skip_semi(toks, cdr(fr))
    // Check if it's a let — if so, wrap rest
    if is_let_form(first) == 1 {
      let rest_r = parse_block_rest(toks, p2)
      let rest = car(rest_r)
      let p3 = cdr(rest_r)
      // first = (let var expr), build (let var expr rest)
      let var_sym = car(cdr(first))
      let expr_val = car(cdr(cdr(first)))
      cons(cov_tag(toks, p,
      cons('let, cons(var_sym, cons(expr_val, cons(rest, nil))))), p3)
    } else if is_use_form(first) == 1 {
      // use x <- expr; rest  =>  (expr (lambda (x) rest))
      // Gleam-style: the RHS is itself the continuation consumer, desugared
      // to a plain call node (same shape as f(a) / chained f(x)(y)). Same
      // block-wrapping as let: the rest of the block becomes the lambda
      // body. Chained use forms are handled by the recursion.
      let rest_r = parse_block_rest(toks, p2)
      let rest = car(rest_r)
      let p3 = cdr(rest_r)
      let var_sym = car(cdr(first))
      let cont_expr = car(cdr(cdr(first)))
      let lam = cons('lambda, cons(cons(var_sym, nil), cons(rest, nil)))
      cons(cov_tag(toks, p, cons(cont_expr, cons(lam, nil))), p3)
    } else if is_type(toks, p2, 'rbrace) == 1 {
      // collect remaining forms
      cons(cov_tag(toks, p, first), p2)
    } else if is_type(toks, p2, 'eof) == 1 {
      cons(cov_tag(toks, p, first), p2)
    } else {
      let rest_r = parse_block_forms(toks, p2, nil)
      let forms = car(rest_r)
      let p3 = cdr(rest_r)
      // forms are already tagged by parse_block_forms
      cons(cons('begin, cons(cov_tag(toks, p, first), forms)), p3)
    }
  }
}

fn parse_block_forms(toks, pos, acc) {
  let p = skip_semi(toks, pos)
  if is_type(toks, p, 'rbrace) == 1 {
    cons(reverse_list(acc), p)
  } else if is_type(toks, p, 'eof) == 1 {
    cons(reverse_list(acc), p)
  } else {
    let fr = parse_form(toks, p)
    let form = car(fr)
    let p2 = skip_semi(toks, cdr(fr))
    // use x <- expr desugars by wrapping the REST of the block in a lambda,
    // which is only possible at block start. A use mid-block (or in any
    // position parsed through parse_block_forms) cannot be desugared, so
    // reject it instead of leaking the internal ((use . use) ...) form.
    if is_use_form(form) == 1 {
      mk_parse_error("use must be the first statement of a block (use x <- expr)", p2)
    } else {
      parse_block_forms(toks, p2, cons(cov_tag(toks, p, form), acc))
    }
  }
}

fn is_let_form(form) {
  if pair?(form) {
    if car(form) == 'let {
      // Only intercept block-level let: (let var expr) — 3 elements.
      // Match desugar produces (let var expr body) — 4 elements — which is complete.
      if null?(cdr(cdr(cdr(form)))) { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
}

// === Form parser (statements within blocks) ===

fn parse_if_expr(toks, pos) {
  let cr = parse_expr(toks, pos + 1)
  let cond = car(cr)
  let p = cdr(cr)
  let tr = parse_braced(toks, p)
  let then_b = car(tr)
  let p2 = cdr(tr)
  if p_is_kw(toks, p2, "else") == 1 {
    let er2 = if is_type(toks, p2 + 1, 'lbrace) == 1 {
      parse_braced(toks, p2 + 1)
    } else {
      // A use binding can only desugar at block start (it wraps the rest of
      // the block in a lambda). An unbraced else with use has no rest to
      // wrap, so reject it instead of embedding the internal marker.
      let fr2 = parse_form(toks, p2 + 1)
      if is_use_form(car(fr2)) == 1 {
        mk_parse_error("use must be the first statement of a block (use x <- expr)", cdr(fr2))
      } else {
        // Single-expression else body: same statement role as a match
        // arm body, so give it a --cov marker too (no-op without pos).
        cons(cov_tag(toks, p2 + 1, car(fr2)), cdr(fr2))
      }
    }
    let else_b = car(er2)
    let p3 = cdr(er2)
    cons(cons('if, cons(cond, cons(then_b, cons(else_b, nil)))), p3)
  } else {
    cons(cons('if, cons(cond, cons(then_b, cons(nil, nil)))), p2)
  }
}

fn parse_form(toks, pos) {
  // let x = expr
  if p_is_kw(toks, pos, "let") == 1 {
    let var_name = tval(toks, pos + 1)
    let p = pos + 2
    // skip = sign
    let p2 = if is_op(toks, p, "=") == 1 { p + 1 } else { p }
    let er = parse_expr(toks, p2)
    let expr = car(er)
    let p3 = cdr(er)
    cons(cons('let, cons(str.to_sym(var_name), cons(expr, nil))), p3)
  } else if p_is_kw(toks, pos, "if") == 1 {
    // if cond { then } else { else }
    parse_if_expr(toks, pos)
  } else if p_is_kw(toks, pos, "match") == 1 {
    // match scrut { ... }
    parse_match(toks, pos)
  } else if p_is_kw(toks, pos, "receive") == 1 {
    // receive { ... }
    parse_receive(toks, pos)
  } else if is_use_keyword(toks, pos) == 1 {
    // use x <- expr  |  use <- expr
    parse_use_form(toks, pos)
  } else {
    // plain expression
    parse_expr(toks, pos)
  }
}

// "use" is NOT a reserved keyword (so `use(x)` stays a function call).
// It is treated as use-syntax only when followed by `<-`:
//   use x <- expr   (variable binding)
//   use <- expr     (discard result)
//
// `<-` is recognized here as the two-token sequence `<` `-` (the tokenizer
// keeps `<` and `-` separate so `a < -b` still parses as less-than of a
// negative; only in use position are they glued together).
fn is_use_keyword(toks, pos) {
  if is_type(toks, pos, 'ident) == 1 {
    if tval(toks, pos) == "use" {
      if is_arrow(toks, pos + 1) == 1 { 1 }
      else if is_type(toks, pos + 1, 'ident) == 1 {
        if is_arrow(toks, pos + 2) == 1 { 1 } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

// `<-` as two adjacent op tokens: `<` then `-`
fn is_arrow(toks, pos) {
  if is_op(toks, pos, "<") == 1 {
    if is_op(toks, pos + 1, "-") == 1 { 1 }
    // '<-' glued to a negative literal: the tokenizer folds -5 into a
    // single negative int/float token (unlike '- 5' where '-' stays an op).
    // Without this, `use x <-5` silently parses as the comparison x < -5.
    else if is_type(toks, pos + 1, 'int) == 1 {
      if tval(toks, pos + 1) < 0 { 1 } else { 0 }
    }
    else if is_type(toks, pos + 1, 'float) == 1 {
      // float tokens carry their value as a string ("-1.5"); comparing the
      // string to 0.0 degrades to false, so check the leading '-' instead.
      if str.char_at(tval(toks, pos + 1), 0) == '-' { 1 } else { 0 }
    }
    else { 0 }
  } else { 0 }
}

// ((use . use) var expr) — block-level form, desugared in parse_block_rest
// to (expr (lambda (var) rest-of-block)) — a plain call node, Gleam-style:
// the RHS is the continuation consumer. The head is the dotted pair
// (use . use): a function call's head is always a symbol, so is_use_form
// can never mistake an ordinary use(...) / use-use(...) call for a binding.
fn parse_use_form(toks, pos) {
  let p = pos + 1
  if is_arrow(toks, p) == 1 {
    // use <- expr: p is '<'. The tokenizer folds a glued negative literal
    // (use <-5) into one int/float token, so the expression is p+1 there,
    // but '< - 5' keeps '-' as an op token and the expression is at p+2.
    let expr_pos = if is_op(toks, p + 1, "-") == 1 { p + 2 } else { p + 1 }
    if use_expr_missing(toks, expr_pos) == 1 {
      mk_parse_error("use expects an expression after '<-' (use x <- expr)", expr_pos)
    } else {
      let er = parse_expr(toks, expr_pos)
      cons(cons(cons('use, 'use), cons(str.to_sym("_"), cons(car(er), nil))), cdr(er))
    }
  } else {
    // use var <- expr: p is the variable, '<' at p+1.
    let var_name = tval(toks, p)
    let expr_pos = if is_op(toks, p + 2, "-") == 1 { p + 3 } else { p + 2 }
    if use_expr_missing(toks, expr_pos) == 1 {
      mk_parse_error("use expects an expression after '<-' (use x <- expr)", expr_pos)
    } else {
      let er = parse_expr(toks, expr_pos)
      cons(cons(cons('use, 'use), cons(str.to_sym(var_name), cons(car(er), nil))), cdr(er))
    }
  }
}

// `use x <- }` / `use x <- )` / `use x <- ;` / `use x <-` — the token after
// '<-' is not the start of an expression. parse_operand would silently
// swallow block terminators as nil, so check the token type up front.
fn use_expr_missing(toks, pos) {
  if is_type(toks, pos, 'rbrace) == 1 { 1 }
  else if is_type(toks, pos, 'rparen) == 1 { 1 }
  else if is_type(toks, pos, 'eof) == 1 { 1 }
  else if is_type(toks, pos, 'semicol) == 1 { 1 }
  // parse_operand also silently returns nil for comma/colon, so a missing
  // expression after '<-' would otherwise desugar to (nil (lambda ...)).
  else if is_type(toks, pos, 'comma) == 1 { 1 }
  else if is_type(toks, pos, 'colon) == 1 { 1 }
  else if is_type(toks, pos, 'arrow) == 1 { 1 }
  // '- 5' with whitespace leaves a second '-' op token as the expression
  // start; TA has no spaced unary minus (parse_expr returns the bare '-'
  // symbol and the number leaks into the block), so reject it.
  else if is_type(toks, pos, 'op) == 1 {
    if tval(toks, pos) == "-" { 1 } else { 0 }
  }
  else { 0 }
}

fn is_use_form(form) {
  if pair?(form) {
    if pair?(car(form)) {
      // Verify the head is exactly the internal (use . use) dotted pair.
      // A chained call f(x)(y, z) also parses to a pair head ((f x) y z),
      // so checking "head is a pair" alone is not enough.
      if car(car(form)) == 'use {
        if cdr(car(form)) == 'use {
          // exactly 2 elements after the head
          if pair?(cdr(cdr(form))) {
            if null?(cdr(cdr(cdr(form)))) { 1 } else { 0 }
          } else { 0 }
        } else { 0 }
      } else { 0 }
    } else { 0 }
  } else { 0 }
}

fn parse_match(toks, pos) {
  // pos at 'match' keyword
  let sr = parse_expr(toks, pos + 1)
  let scrut = car(sr)
  let p = cdr(sr)
  // expect lbrace
  let p2 = if is_type(toks, p, 'lbrace) == 1 { p + 1 } else { p }
  let arms_r = parse_match_arms(toks, p2, nil)
  let arms = car(arms_r)
  let p3 = cdr(arms_r)
  // skip rbrace
  let p4 = if is_type(toks, p3, 'rbrace) == 1 { p3 + 1 } else { p3 }
  // Output (match scrut arm1 arm2 ...) directly
  let result = cons('match, cons(scrut, arms))
  cons(result, p4)
}

fn parse_receive(toks, pos) {
  // pos at 'receive' keyword
  let p = pos + 1
  // expect lbrace
  let p2 = if is_type(toks, p, 'lbrace) == 1 { p + 1 } else { p }
  let arms_r = parse_match_arms(toks, p2, nil)
  let arms = car(arms_r)
  let p3 = cdr(arms_r)
  // skip rbrace
  let p4 = if is_type(toks, p3, 'rbrace) == 1 { p3 + 1 } else { p3 }
  // Return (receive arm1 arm2 ...) directly
  // compile_receive handles pattern matching with dedicated bytecodes.
  let result = cons('receive, arms)
  cons(result, p4)
}

fn parse_match_arms(toks, pos, acc) {
  let p = skip_semi(toks, pos)
  let p0 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
  if is_type(toks, p0, 'rbrace) == 1 {
    cons(reverse_list(acc), p0)
  } else if is_type(toks, p0, 'eof) == 1 {
    cons(reverse_list(acc), p0)
  } else {
    let pr = parse_pattern(toks, p0)
    let pat = car(pr)
    let p2 = cdr(pr)
    // optional when guard
    let gr = if p_is_kw(toks, p2, "when") == 1 {
      parse_expr(toks, p2 + 1)
    } else if p_is_kw(toks, p2, "if") == 1 {
      mk_parse_error("use 'when' instead of 'if' for match/receive guards", p2)
    } else { nil }
    let has_guard = if null?(gr) { 0 } else { 1 }
    let guard = if has_guard == 1 { car(gr) } else { true }
    let p_guard = if has_guard == 1 { cdr(gr) } else { p2 }
    // expect arrow
    let p3 = if is_type(toks, p_guard, 'arrow) == 1 { p_guard + 1 } else { p_guard }
    // body: braced or single expr
    let br = if is_type(toks, p3, 'lbrace) == 1 {
      parse_braced(toks, p3)
    } else {
      // use can only desugar at block start; a single-expression arm body
      // has no rest to wrap, so reject it (no leaking the internal marker).
      let fr3 = parse_form(toks, p3)
      if is_use_form(car(fr3)) == 1 {
        mk_parse_error("use must be the first statement of a block (use x <- expr)", cdr(fr3))
      } else { fr3 }
    }
    // Braced bodies carry per-statement tags from the block parsers; a
    // single-expression body gets its marker here (same statement role).
    let raw_body = car(br)
    let p4 = cdr(br)
    let body = if is_type(toks, p3, 'lbrace) == 1 {
      raw_body
    } else {
      cov_tag(toks, p3, raw_body)
    }
    let arm = if has_guard == 1 {
      cons(pat, cons(guard, cons(body, nil)))
    } else {
      cons(pat, cons(body, nil))
    }
    parse_match_arms(toks, p4, cons(arm, acc))
  }
}

fn build_cons_patterns(items, result) {
  if null?(items) {
    result
  } else {
    let new_r = cons(str.to_sym("cons"), cons(car(items), cons(result, nil)))
    build_cons_patterns(cdr(items), new_r)
  }
}

// Build list-literal expression from item list: (a b c) -> (list a b c)
// The 'list special form (NOT a cons chain) lets typecheck unify every
// element type against each other (issue #80), while hand-written cons
// keeps its heterogeneous pair semantics. Codegen expands the form back
// into a runtime cons chain.
fn build_list_expr(items) {
  cons(str.to_sym("list"), items)
}

// Parse [expr, expr, ...] list literal -> (list ...) AST form
fn parse_list_expr(toks, pos, acc) {
  let p = skip_semi(toks, pos)
  if is_type(toks, p, 'rbracket) == 1 {
    cons(build_list_expr(reverse_list(acc)), p + 1)
  } else if is_type(toks, p, 'eof) == 1 {
    // Unclosed list literal — stop without advancing.
    cons(build_list_expr(reverse_list(acc)), p)
  } else {
    let pr = parse_expr(toks, p)
    let p2 = skip_semi(toks, cdr(pr))
    if is_type(toks, p2, 'comma) == 1 {
      parse_list_expr(toks, p2 + 1, cons(car(pr), acc))
    } else {
      parse_list_expr(toks, p2, cons(car(pr), acc))
    }
  }
}

fn parse_bracket_pattern(toks, pos, acc) {
  let p = skip_semi(toks, pos)
  if is_type(toks, p, 'rbracket) == 1 {
    let items = acc
    let result = build_cons_patterns(items, nil)
    cons(result, p + 1)
  } else if is_type(toks, p, 'eof) == 1 {
    // Unclosed bracket pattern — stop without advancing.
    let result = build_cons_patterns(acc, nil)
    cons(result, p)
  } else {
    let pr = parse_pattern(toks, p)
    let pat = car(pr)
    let p2 = cdr(pr)
    let p3 = skip_semi(toks, p2)
    if is_type(toks, p3, 'comma) == 1 {
      parse_bracket_pattern(toks, p3 + 1, cons(pat, acc))
    } else {
      parse_bracket_pattern(toks, p3, cons(pat, acc))
    }
  }
}

// === Pattern parser ===

// cons_chain(es) — fold element patterns (e1 .. eK) into the cons-chain
// encoding (cons e1 (cons e2 ... (cons eK nil))): the terminating cdr-side
// nil is the arity pin, identical to how parse_bracket_pattern folds [a, b].
fn cons_chain(es) {
  if null?(es) {
    nil
  } else {
    cons('cons, cons(car(es), cons(cons_chain(cdr(es)), nil)))
  }
}

fn parse_pattern(toks, pos) {
  let typ = ttype(toks, pos)
  let val = tval(toks, pos)

  if typ == 'int {
    cons(val, pos + 1)
  } else if typ == 'float {
    // Float literals cannot appear in patterns — the baseline has no
    // float pattern-matching (no float equality/match opcodes). Reject
    // with a clear parse error so the program fails at compile time.
    mk_parse_error("float literals cannot be used in patterns", pos + 1)
  } else if typ == 'string {
    cons(val, pos + 1)
  } else if typ == 'kw {
    if val == "nil" {
      cons(nil, pos + 1)
    } else {
      cons(str.to_sym(val), pos + 1)
    }
  } else if typ == 'ident {
    let name = val
    let p = pos + 1
    let is_ctor = is_uppercase(name)
    if is_ctor == 1 {
      if is_type(toks, p, 'lparen) == 1 {
        // Constructor pattern: (Name p1 .. pN) desugars right here into the
        // cons-chain list pattern (cons (quote Name) (cons p1 ... nil)) —
        // the SAME encoding as bracket pattern [Name, p1, ...]. One list-
        // pattern compiler serves both backends: host codegen takes its
        // proven 'cons branch, the lisp pipeline's lower_pat flattens the
        // chain into its spine form. A constructor value IS a tagged list,
        // so the pattern is literally the value's shape; the trailing-nil
        // chain terminator pins arity.
        let ar = parse_call_args_list(toks, p + 1, nil, 0)
        let args = car(ar)
        let p2 = cdr(ar)
        let quoted_head = cons('quote, cons(str.to_sym(name), nil))
        cons(cons_chain(cons(quoted_head, args)), p2)
      } else {
        // Nullary constructor: (quote Name)
        cons(cons('quote, cons(str.to_sym(name), nil)), p)
      }
    } else if name == "cons" {
      if is_type(toks, p, 'lparen) == 1 {
        // Pair pattern: cons(a, b) → (cons pat_a pat_b)
        let ar = parse_call_args_list(toks, p + 1, nil, 0)
        let args = car(ar)
        let p2 = cdr(ar)
        let pat_a = list_ref(args, 0)
        let pat_b = list_ref(args, 1)
        cons(cons(str.to_sym("cons"), cons(pat_a, cons(pat_b, nil))), p2)
      } else {
        cons(str.to_sym(name), p)
      }
    } else {
      // Variable binding (or _)
      cons(str.to_sym(name), p)
    }
  } else if typ == 'quote {
    let r = parse_pattern(toks, pos + 1)
    cons(cons('quote, cons(car(r), nil)), cdr(r))
  } else if typ == 'lbracket {
    parse_bracket_pattern(toks, pos + 1, nil)
  } else {
    cons(str.to_sym("_"), pos + 1)
  }
}

// === Top-level parser ===

pub fn parse(toks) {
  let id = vm.make_tok_vec(toks)
  let result = parse_toplevels(cons(id, cons(nil, cons(nil, nil))), 0, nil)
  vm.free_tok_vec(id)
  result
}

// parse_cov(toks, poss, path): the --cov entry. Same grammar; every
// statement and match/receive arm body is wrapped in a
// (begin (cov.line path line) form) marker for covinst to rewrite into
// (cov.hit k). See cov_tag / driver parse_module_content.
pub fn parse_cov(toks, poss, path) {
  let id = vm.make_tok_vec(toks)
  let result = parse_toplevels(cons(id, cons(poss, cons(path, nil))), 0, nil)
  vm.free_tok_vec(id)
  result
}

fn parse_toplevels(toks, pos, acc) {
  if is_type(toks, pos, 'eof) == 1 {
    reverse_list(acc)
  } else {
    let r = parse_toplevel(toks, pos)
    let forms = car(r)
    let p = cdr(r)
    if p <= pos {
      // Parser failed to advance (syntax error) — skip token to guarantee
      // progress and avoid infinite recursion.
      parse_toplevels(toks, pos + 1, acc)
    } else {
      parse_toplevels(toks, p, prepend_all(forms, acc))
    }
  }
}

fn parse_toplevel(toks, pos) {
  // pub fn / pub type
  if p_is_kw(toks, pos, "pub") == 1 {
    if p_is_kw(toks, pos + 1, "fn") == 1 {
      parse_fn(toks, pos + 1, 1)
    } else if p_is_kw(toks, pos + 1, "type") == 1 {
      let r = parse_type(toks, pos + 1)
      wrap_single(car(r), cdr(r))
    } else {
      let r = parse_expr(toks, pos)
      wrap_single(car(r), cdr(r))
    }
  } else if p_is_kw(toks, pos, "fn") == 1 {
    // fn
    parse_fn(toks, pos, 0)
  } else if p_is_kw(toks, pos, "import") == 1 {
    // import name
    // import name as alias
    // Both produce (import name alias); without `as`, alias equals name.
    // The alias lets the importer write alias.member instead of name.member
    // (issue #96 Phase B); the driver rewrites alias-qualified references.
    let mod_name = tval(toks, pos + 1)
    if is_type(toks, pos + 2, 'ident) == 1 {
      if tval(toks, pos + 2) == "as" {
        let alias = tval(toks, pos + 3)
        wrap_single(cons('import, cons(mod_name, cons(alias, nil))), pos + 4)
      } else {
        wrap_single(cons('import, cons(mod_name, cons(mod_name, nil))), pos + 2)
      }
    } else {
      wrap_single(cons('import, cons(mod_name, cons(mod_name, nil))), pos + 2)
    }
  } else if p_is_kw(toks, pos, "type") == 1 {
    // type
    let r = parse_type(toks, pos)
    wrap_single(car(r), cdr(r))
  } else if p_is_kw(toks, pos, "external") == 1 {
    // external fn (C module declaration)
    if p_is_kw(toks, pos + 1, "fn") == 1 {
      parse_external_fn(toks, pos + 2)
    } else {
      let r = parse_expr(toks, pos)
      wrap_single(car(r), cdr(r))
    }
  } else if p_is_kw(toks, pos, "const") == 1 {
    // const NAME = expr (compile-time constant, inlined by codegen)
    if is_type(toks, pos + 2, 'op) == 1 {
      if tval(toks, pos + 2) == "=" {
        if is_type(toks, pos + 3, 'eof) == 1 {
          // `const X =` with nothing after the '=': parse_expr would
          // silently return nil and the const would vanish at codegen.
          wrap_single(mk_parse_error("const requires a value after '='", pos + 1), pos + 1)
        } else {
          let name = str.to_sym(tval(toks, pos + 1))
          let eq_pos = pos + 3 // skip 'const' 'NAME' '='
          let r = parse_expr(toks, eq_pos)
          let expr = car(r)
          let p = cdr(r)
          wrap_single(cons('const, cons(name, cons(expr, nil))), p)
        }
      } else {
        wrap_single(mk_parse_error("const requires 'NAME = expr'", pos + 1), pos + 1)
      }
    } else {
      wrap_single(mk_parse_error("const requires 'NAME = expr'", pos + 1), pos + 1)
    }
  } else {
    // expression at top level
    let r = parse_expr(toks, pos)
    wrap_single(car(r), cdr(r))
  }
}

// parse_external_fn(toks, pos) -> ((form) . next_pos)
// Parse `external fn demo.double(int) -> int`.
// pos points at the dotted module.function name. Params are TYPES only
// (no param names), comma-separated, parsed like type annotations.
// Produces: ('external_fn 'demo.double (int) int)
fn parse_external_fn(toks, pos) {
  let name = tval(toks, pos)
  let name_sym = str.to_sym(name)
  let p = pos + 1

  // params ( ... ) — types only
  let params_r = if is_type(toks, p, 'lparen) == 1 {
    parse_external_params(toks, p + 1, nil)
  } else {
    cons(nil, p)
  }
  let param_types = car(params_r)
  let p2 = cdr(params_r)

  // optional -> Type
  let ar = parse_return_type(toks, p2)
  let ret_type = car(ar)
  let p3 = cdr(ar)

  let form = cons('external_fn, cons(name_sym, cons(param_types, cons(ret_type, nil))))
  cons(cons(form, nil), p3)
}

// parse_external_params(toks, pos, acc) -> (param_types . next_pos)
// Parse a comma-separated list of type annotations ending at ')'.
// Each element is parsed with parse_type_after_colon (types, not names).
fn parse_external_params(toks, pos, acc) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(reverse_list(acc), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed param list — stop without advancing.
    cons(reverse_list(acc), pos)
  } else {
    let tr = parse_type_after_colon(toks, pos)
    let t = car(tr)
    let p = cdr(tr)
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_external_params(toks, p2, cons(t, acc))
  }
}

fn parse_fn(toks, pos, is_pub) {
  // pos at 'fn' keyword
  // A named function must be followed by an identifier. An anonymous fn
  // (`fn(x) { ... }`, `fn { ... }`) is only valid in expression position,
  // where parse_expr routes it to parse_lambda. At top level a bare
  // anonymous fn has no binding target — it used to be silently mis-parsed
  // as a define with a nil/garbage name (params and return annotation
  // dropped), so reject it with a clear parse error.
  if is_type(toks, pos + 1, 'ident) == 0 {
    wrap_single(mk_parse_error("anonymous fn not allowed at top level; expected function name (for a lambda write: let f = fn(x) { ... })", pos + 1), pos + 1)
  } else {
    let name = tval(toks, pos + 1)
    let name_sym = str.to_sym(name)
    let p = pos + 2

    // params ( ... )
    let params_r = if is_type(toks, p, 'lparen) == 1 {
      parse_param_list(toks, p)
    } else {
      cons(nil, p)
    }
    let pairs = car(params_r)
    let p2 = cdr(params_r)

    let params = extract_names(pairs)
    let param_types = extract_types(pairs)

    // optional -> Type
    let ar = parse_return_type(toks, p2)
    let ret_type = car(ar)
    let p3 = skip_to_lbrace(toks, cdr(ar))

    // body block
    let br = parse_braced(toks, p3)
    let body = car(br)
    let p4 = cdr(br)

    let sig = cons(name_sym, params)
    let head = if is_pub == 1 { 'define_pub } else { 'define }
    let define_form = cons(head, cons(sig, cons(body, nil)))

    let forms = if has_any_type(param_types, ret_type) == 1 {
      let type_sig = cons('type-sig, cons(name_sym, cons(param_types, cons(ret_type, nil))))
      cons(type_sig, cons(define_form, nil))
    } else {
      cons(define_form, nil)
    }
    cons(forms, p4)
  }
}

fn skip_to_lbrace(toks, pos) {
  if is_type(toks, pos, 'lbrace) == 1 { pos }
  else { if is_type(toks, pos, 'eof) == 1 { pos } else { skip_to_lbrace(toks, pos + 1) } }
}

fn parse_type_params(toks, pos, acc) {
  if is_type(toks, pos, 'rparen) == 1 {
    cons(reverse_list(acc), pos + 1)
  } else if is_type(toks, pos, 'eof) == 1 {
    // Unclosed type-param list — stop without advancing.
    cons(reverse_list(acc), pos)
  } else {
    let pname = str.to_sym(tval(toks, pos))
    let p = pos + 1
    let p2 = if is_type(toks, p, 'comma) == 1 { p + 1 } else { p }
    parse_type_params(toks, p2, cons(pname, acc))
  }
}

fn try_parse_type_params(toks, pos) {
  if is_type(toks, pos, 'lparen) == 1 {
    parse_type_params(toks, pos + 1, nil)
  } else {
    cons(nil, pos)
  }
}

fn parse_type(toks, pos) {
  // pos at 'type' keyword
  let name = tval(toks, pos + 1)
  let name_sym = str.to_sym(name)
  let p = pos + 2
  // Check for optional type params: (a, b, ...)
  let tpr = try_parse_type_params(toks, p)
  let type_params = car(tpr)
  let p1 = cdr(tpr)
  // expect lbrace
  let p2 = if is_type(toks, p1, 'lbrace) == 1 { p1 + 1 } else { p1 }
  let vr = parse_variants(toks, p2, nil)
  let variants = car(vr)
  let p3 = cdr(vr)
  let p4 = if is_type(toks, p3, 'rbrace) == 1 { p3 + 1 } else { p3 }
  cons(cons('type, cons(name_sym, cons(type_params, variants))), p4)
}

fn parse_variants(toks, pos, acc) {
  let p = skip_semi(toks, pos)
  if is_type(toks, p, 'rbrace) == 1 {
    cons(reverse_list(acc), p)
  } else if is_type(toks, p, 'eof) == 1 {
    // Unclosed variant list — stop without advancing.
    cons(reverse_list(acc), p)
  } else {
    let vr = parse_variant(toks, p)
    let variant = car(vr)
    let p2 = skip_semi(toks, cdr(vr))
    parse_variants(toks, p2, cons(variant, acc))
  }
}

fn parse_variant(toks, pos) {
  let name = tval(toks, pos)
  let name_sym = str.to_sym(name)
  let p = pos + 1
  if is_type(toks, p, 'lparen) == 1 {
    // n-ary variant
    let ar = parse_call_args_list(toks, p + 1, nil, 0)
    let args = car(ar)
    let p2 = cdr(ar)
    // (Name . args) as a dotted pair
    cons(cons(name_sym, args), p2)
  } else {
    // nullary variant: just (quote Name)
    cons(cons('quote, cons(name_sym, nil)), p)
  }
}

// codegen.ta — Self-hosted TA compiler: AST → .tabc bytecode
// Port of codegen.lisp, but uses TA's match for clean pattern-based dispatch.
//
// State = (fn_names . (next_fn_id . (fn_entries . (env . (next_slot . max_slot)))))
//   fn_names    = alist of (func_sym . fn_id) for top-level defines
//   next_fn_id  = next fn_id counter for lambda allocation
//   fn_entries  = alist of (fn_id . entry) for lambda/define function offsets
//   env         = alist of (var_sym . slot)
//   next_slot   = next available slot (negative)
//   max_slot    = minimum slot used (for ENTER calculation)



// ============================================================
// Bytecode opcode constants (mirrors OpCode enum in ta.h)
// ============================================================

const op_push_nil = 0
const op_push_true = 1
const op_push_false = 2
const op_push_int8 = 3
const op_push_int = 4
const op_push_sym = 5
const op_push_string = 6
const op_push_float = 47
const op_load = 7
const op_store = 8
const op_cons = 9
const op_car = 10
const op_cdr = 11
const op_add = 12
const op_sub = 13
const op_mul = 14
const op_div = 15
const op_mod = 16
const op_eq = 17
const op_lt = 18
const op_le = 19
const op_is_nil = 20
const op_is_pair = 21
const op_is_int = 22
const op_is_string = 23
const op_is_bytes = 24
const op_is_pid = 25
const op_jump = 26
const op_jump_if_false = 27
const op_pop = 28
const op_dup = 29
const op_closure = 30
const op_call = 31
const op_tail_call = 32
const op_ret = 33
// Reserved opcode numbers: these nine used to be the actor primitives, which
// now go through OP_BUILTIN (emit_builtin below). The numbers are kept as
// holes so no surviving opcode moves; nothing emits them. Kept as mirrors of
// the ta.h enum for check_opcode_mirrors.py.
const op_reserved_spawn = 34
const op_reserved_spawn_main = 35
const op_reserved_spawn_clos = 36
const op_reserved_send = 37
const op_reserved_recv = 38
const op_reserved_recv_peek = 39
const op_reserved_recv_commit = 40
const op_self = 41
const op_reserved_monitor = 42
const op_halt = 43
const op_enter = 44
const op_ccall_name = 45
const op_ne = 46
const op_reserved_recv_after = 48
// OP_BUILTIN: cold-path actor primitive, selected by the byte after the
// opcode (see builtin_table in src/builtin.c, and BuiltinId in ta.h for the
// index numbering). emit_builtin appends that byte.
const op_builtin = 49
// 新 opcode 只能追加编号（不能重编号）：已提交的 bootstrap.tabc 是自举输入，
// 必须能在新二进制上继续跑。op_is_symbol 与 ta.h 的 OP_IS_SYMBOL = 50 镜像。
const op_is_symbol = 50

// Static OP_BUILTIN indices — the contract with BuiltinId in ta.h and
// builtin_table[] in src/builtin.c. Change all three together.
const builtin_spawn = 0
const builtin_spawn_main = 1
const builtin_spawn_clos = 2
const builtin_send = 3
const builtin_recv = 4
const builtin_recv_peek = 5
const builtin_recv_commit = 6
const builtin_recv_after = 7
const builtin_monitor = 8

// ============================================================
// Byte emission helpers
// ============================================================

// Emit an OP_BUILTIN instruction: the opcode byte plus its one-byte static
// index (a builtin_* constant). Any further operand bytes are appended by the
// caller in the same order the old dedicated opcode used them.
fn emit_builtin(b, idx) {
  buf.push_byte(b, op_builtin)
  buf.push_byte(b, idx)
}

fn emit_u32(b, val) {
  let u = if val < 0 { val + 4294967296 } else { val }
  buf.push_byte(b, u % 256)
  buf.push_byte(b, (u / 256) % 256)
  buf.push_byte(b, (u / 65536) % 256)
  buf.push_byte(b, (u / 16777216) % 256)
}

fn emit_i64(b, val) {
  if val >= 0 {
    buf.push_byte(b, val % 256)
    buf.push_byte(b, (val / 256) % 256)
    buf.push_byte(b, (val / 65536) % 256)
    buf.push_byte(b, (val / 16777216) % 256)
    let hi = val / 4294967296
    buf.push_byte(b, hi % 256)
    buf.push_byte(b, (hi / 256) % 256)
    buf.push_byte(b, (hi / 65536) % 256)
    buf.push_byte(b, (hi / 16777216) % 256)
  } else {
    // For negative: low 32 bits as unsigned, high 32 bits all 0xFF
    let u = val + 4294967296
    buf.push_byte(b, u % 256)
    buf.push_byte(b, (u / 256) % 256)
    buf.push_byte(b, (u / 65536) % 256)
    buf.push_byte(b, (u / 16777216) % 256)
    buf.push_byte(b, 255)
    buf.push_byte(b, 255)
    buf.push_byte(b, 255)
    buf.push_byte(b, 255)
  }
}

fn patch_u32(b, pos, val) {
  let u = if val < 0 { val + 4294967296 } else { val }
  buf.set_byte(b, pos, u % 256)
  buf.set_byte(b, pos + 1, (u / 256) % 256)
  buf.set_byte(b, pos + 2, (u / 65536) % 256)
  buf.set_byte(b, pos + 3, (u / 16777216) % 256)
}

fn patch_jumps(b, jumps, target) {
  if null?(jumps) { nil }
  else {
    patch_u32(b, car(jumps), target)
    patch_jumps(b, cdr(jumps), target)
  }
}

fn patch_all_jumps(b, jumps, addr) {
  if null?(jumps) { nil }
  else {
    patch_u32(b, car(jumps), addr)
    patch_all_jumps(b, cdr(jumps), addr)
  }
}

// ============================================================
// List helpers
// ============================================================

fn list_len(lst) {
  match lst {
    nil -> 0
    cons(_, rest) -> 1 + list_len(rest)
  }
}

fn cg_list_ref(lst, n) {
  if n == 0 { car(lst) }
  else { cg_list_ref(cdr(lst), n - 1) }
}

fn cg_reverse_list(lst, acc) {
  match lst {
    nil -> acc
    cons(x, rest) -> cg_reverse_list(rest, cons(x, acc))
  }
}

fn alist_find(lst, key) {
  match lst {
    nil -> nil
    cons(pair, rest) -> {
      if car(pair) == key { cdr(pair) }
      else { alist_find(rest, key) }
    }
  }
}

fn is_define_form(head) {
  if head == 'define { 1 }
  else {
    if head == 'define_pub { 1 }
    else { 0 }
  }
}

// ============================================================
// Symbol table management
// ============================================================

fn init_syms() {
  cons(cons("quote", 0), cons(cons("define", 1), cons(cons("lambda", 2),
  cons(cons("if", 3), cons(cons("begin", 4), cons(cons("let", 5),
  cons(cons("letrec", 6), cons(cons("match", 7), cons(cons("spawn", 8),
  cons(cons("send", 9), cons(cons("recv", 10), cons(cons("self", 11),
  cons(cons("monitor", 12), cons(cons("cons", 13), cons(cons("car", 14),
  cons(cons("cdr", 15), cons(cons("+", 16), cons(cons("-", 17),
  cons(cons("*", 18), cons(cons("/", 19), cons(cons("%", 20),
  cons(cons("=", 21), cons(cons("<", 22), cons(cons("<=", 23),
  cons(cons(">", 24), cons(cons(">=", 25), cons(cons("null?", 26),
  cons(cons("pair?", 27), cons(cons("int?", 28), cons(cons("string?", 29),
  cons(cons("bytes?", 30), cons(cons("pid?", 31), cons(cons("print", 32),
  cons(cons("true", 33), cons(cons("false", 34), cons(cons("DOWN", 35),
  cons(cons("nil", 36), cons(cons("_", 37), cons(cons("and", 38),
  cons(cons("or", 39), cons(cons("not", 40), cons(cons("set!", 41),
  nil))))))))))))))))))))))))))))))))))))))))))
}

fn sym_count(syms) {
  match syms {
    nil -> 0
    cons(_, rest) -> 1 + sym_count(rest)
  }
}

fn sym_find_by_idx(syms, idx) {
  match syms {
    nil -> ""
    cons(pair, rest) -> {
      if cdr(pair) == idx { car(pair) }
      else { sym_find_by_idx(rest, idx) }
    }
  }
}

fn find_sym_index(syms, sym) {
  if null?(syms) { nil }
  else {
    let pair = car(syms)
    // sym is a lisp symbol, car(pair) is a string; convert sym to string for comparison
    if str.to_sym(car(pair)) == sym { cdr(pair) }
    else { find_sym_index(cdr(syms), sym) }
  }
}

fn intern_ast_sym(syms, sym, next_idx) {
  let idx = find_sym_index(syms, sym)
  if null?(idx) {
    let s = str.sym_to_str(sym)
    cons(cons(cons(s, next_idx), syms), next_idx + 1)
  }
  else { cons(syms, next_idx) }
}

fn embed_syms(fn_names, syms) {
  cons(cons('__syms__, syms), fn_names)
}

fn get_syms(fn_names) {
  let s = alist_find(fn_names, '__syms__)
  if null?(s) { init_syms() }
  else { s }
}

fn collect_ast_syms(ast, syms, next_idx) {
  if null?(ast) { cons(syms, next_idx) }
  else if int?(ast) { cons(syms, next_idx) }
  else if string?(ast) { cons(syms, next_idx) }
  else if pair?(ast) {
    let r1 = collect_ast_syms(car(ast), syms, next_idx)
    collect_ast_syms(cdr(ast), car(r1), cdr(r1))
  }
  else if symbol?(ast) {
    // Dispatched via symbol? (forall a. a -> bool) BEFORE the == true/false
    // literal checks: those unify ast with bool, which would conflict when
    // the same tvar is interned as a symbol here.
    intern_ast_sym(syms, ast, next_idx)
  }
  else if ast == true { cons(syms, next_idx) }
  else if ast == false { cons(syms, next_idx) }
  else { cons(syms, next_idx) }
  // (The final else is unreachable for well-formed ASTs: every atom kind
  // — int, string, pair, nil, symbol, true, false — is handled above.)
}

fn collect_ast_list(forms, syms, next_idx) {
  match forms {
    nil -> cons(syms, next_idx)
    cons(f, rest) -> {
      let r = collect_ast_syms(f, syms, next_idx)
      collect_ast_list(rest, car(r), cdr(r))
    }
  }
}

// ============================================================
// State management
// ============================================================

fn make_state(fn_names, next_fn_id, fn_entries, env, next_slot, max_slot) {
  cons(fn_names, cons(next_fn_id, cons(fn_entries,
  cons(env, cons(next_slot, max_slot)))))
}

fn st_fn_names(s) { car(s) }
fn st_next_fn_id(s) { car(cdr(s)) }
fn st_fn_entries(s) { car(cdr(cdr(s))) }
fn st_env(s) { car(cdr(cdr(cdr(s)))) }
fn st_next_slot(s) { car(cdr(cdr(cdr(cdr(s))))) }
fn st_max_slot(s) { cdr(cdr(cdr(cdr(cdr(s))))) }

// ============================================================
// Inline operator lookup
// ============================================================

// Inline operator -> opcode. Every arm names the op_* constant instead of
// repeating its number: this table used to hardcode the numbers, and a stale
// `!= -> 57` silently survived the E0 renumbering, so the mirror could drift
// from ta.h without the compiler noticing.
fn inline_op(sym) {
  if sym == '+ { op_add }
  else if sym == '- { op_sub }
  else if sym == '* { op_mul }
  else if sym == '/ { op_div }
  else if sym == '% { op_mod }
  else if sym == '= { op_eq }
  else if sym == '!= { op_ne }
  else if sym == '< { op_lt }
  else if sym == '<= { op_le }
  // '>' and '>=' are swap ops - handled by is_swap_op in compile_call
  else if sym == 'cons { op_cons }
  else if sym == 'car { op_car }
  else if sym == 'cdr { op_cdr }
  else if sym == 'null? { op_is_nil }
  else if sym == 'pair? { op_is_pair }
  else if sym == 'int? { op_is_int }
  else if sym == 'string? { op_is_string }
  else if sym == 'bytes? { op_is_bytes }
  else if sym == 'pid? { op_is_pid }
  else if sym == 'symbol? { op_is_symbol }
  else { -1 }
}

fn is_swap_op(sym) {
  if sym == '> { 1 }
  else if sym == '>= { 1 }
  else { 0 }
}

fn is_symbol_val(v) {
  if int?(v) { 0 }
  else if string?(v) { 0 }
  else if pair?(v) { 0 }
  else if null?(v) { 0 }
  else { 1 }
}

// ============================================================
// Free variable collection
// ============================================================

fn fv_contains(fv, name) {
  match fv {
    nil -> 0
    cons(pair, rest) -> {
      if car(pair) == name { 1 }
      else { fv_contains(rest, name) }
    }
  }
}

fn fv_add(name, slot, fv) {
  if fv_contains(fv, name) == 1 { fv }
  else { cons(cons(name, slot), fv) }
}

fn is_param_sym(sym, params) {
  match params {
    nil -> 0
    cons(p, rest) -> {
      if p == sym { 1 }
      else { is_param_sym(sym, rest) }
    }
  }
}

fn filter_free_vars(fv, params) {
  match fv {
    nil -> nil
    cons(pair, rest) -> {
      if is_param_sym(car(pair), params) == 1 {
        filter_free_vars(rest, params)
      } else {
        cons(pair, filter_free_vars(rest, params))
      }
    }
  }
}

fn collect_free_vars(expr, env, acc) {
  if int?(expr) { acc }
  else if string?(expr) { acc }
  else if null?(expr) { acc }
  else if pair?(expr) {
    let head = car(expr)
    if is_symbol_val(head) == 1 {
      match head {
        'quote -> acc
        'define -> acc
        'lambda -> collect_free_body(cons(car(cdr(cdr(expr))), nil), env, acc)
        'if -> {
          let a1 = collect_free_vars(cg_list_ref(expr, 1), env, acc)
          let a2 = collect_free_vars(cg_list_ref(expr, 2), env, a1)
          collect_free_vars(cg_list_ref(expr, 3), env, a2)
        }
        'begin -> collect_free_body(cdr(expr), env, acc)
        'let -> {
          let second = cg_list_ref(expr, 1)
          if is_symbol_val(second) == 1 {
            let a1 = collect_free_vars(cg_list_ref(expr, 2), env, acc)
            collect_free_body(cdr(cdr(cdr(expr))), env, a1)
          } else {
            if pair?(second) {
              collect_free_bindings(second, env, acc)
            } else {
              acc
            }
          }
        }
        'match -> {
          let a1 = collect_free_vars(cg_list_ref(expr, 1), env, acc)
          collect_free_branches(cdr(cdr(expr)), env, a1)
        }
        'receive -> collect_free_branches(cdr(expr), env, acc)
        'receive-scan -> {
          let lam = cg_list_ref(expr, 1)
          if is_symbol_val(lam) == 0 {
            collect_free_body(cdr(cdr(lam)), env, acc)
          } else { acc }
        }
        _ -> {
          let a0 = collect_free_vars(head, env, acc)
          collect_free_list(cdr(expr), env, a0)
        }
      }
    } else {
      collect_free_list(expr, env, acc)
    }
  }
  else {
    // symbol: add as free var ONLY if bound in local env
    let slot = alist_find(env, expr)
    if null?(slot) { acc }
    else { fv_add(expr, slot, acc) }
  }
}

fn collect_free_list(expr, env, acc) {
  match expr {
    nil -> acc
    cons(x, rest) -> {
      let a1 = collect_free_vars(x, env, acc)
      collect_free_list(rest, env, a1)
    }
  }
}

fn collect_free_body(body, env, acc) {
  match body {
    nil -> acc
    cons(e, rest) -> {
      let a1 = collect_free_vars(e, env, acc)
      collect_free_body(rest, env, a1)
    }
  }
}

fn collect_free_bindings(bindings, env, acc) {
  match bindings {
    nil -> acc
    cons(b, rest) -> {
      // b = (var init)
      if pair?(b) {
        if pair?(cdr(b)) {
          let a1 = collect_free_vars(cg_list_ref(b, 1), env, acc)
          let a2 = collect_free_body(rest, env, a1)
          a2
        } else { acc }
      } else { acc }
    }
  }
}

fn collect_free_branches(branches, env, acc) {
  match branches {
    nil -> acc
    cons(branch, rest) -> {
      match branch {
        cons(_, body) -> {
          let a1 = collect_free_body(body, env, acc)
          collect_free_branches(rest, env, a1)
        }
        _ -> collect_free_branches(rest, env, acc)
      }
    }
  }
}

fn compute_free_vars(body, env, params) {
  let fv_raw = collect_free_body(body, env, nil)
  let fv_filtered = filter_free_vars(fv_raw, params)
  cg_reverse_list(fv_filtered, nil)
}

// ============================================================
// Env building helpers
// ============================================================

fn build_param_env(params, slot) {
  match params {
    nil -> nil
    cons(p, rest) -> cons(cons(p, slot), build_param_env(rest, slot + 1))
  }
}

fn build_combined_env(params, slot, outer_env) {
  match params {
    nil -> outer_env
    cons(p, rest) -> cons(cons(p, slot), build_combined_env(rest, slot + 1, outer_env))
  }
}

fn add_free_vars_to_env(fv, slot, env) {
  match fv {
    nil -> env
    cons(pair, rest) -> {
      add_free_vars_to_env(rest, slot + 1,
      cons(cons(car(pair), slot), env))
    }
  }
}

fn build_body_env(params, free_vars) {
  build_body_env_loop(params, 0, free_vars)
}

fn build_body_env_loop(params, slot, free_vars) {
  match params {
    nil -> add_free_vars_to_env(free_vars, slot, nil)
    cons(p, rest) -> cons(cons(p, slot), build_body_env_loop(rest, slot + 1, free_vars))
  }
}

fn emit_free_slots(b, fv) {
  match fv {
    nil -> nil
    cons(pair, rest) -> {
      emit_u32(b, cdr(pair))
      emit_free_slots(b, rest)
    }
  }
}

// ============================================================
// rindex_dot: find last '.' in string (for module prefix resolution)
// ============================================================

fn rindex_dot(s, len) {
  if len == 0 { -1 }
  else {
    if str.char_at(s, len - 1) == '.' { len - 1 }
    else { rindex_dot(s, len - 1) }
  }
}

fn find_fn(fn_names, sym) {
  // Phase B (issue #96): the dotted-name fallback ("strip the module
  // prefix, look up the bare base name") is gone. Imported module members
  // are compiled under their namespaced names (mod.fn for pub, mod$fn for
  // non-pub), so a qualified reference resolves directly and two modules
  // exporting the same bare name can no longer shadow each other.
  alist_find(fn_names, sym)
}

// ============================================================
// Expression compilation helpers — pattern matching
// ============================================================

fn is_wildcard_sym(v) {
  if is_symbol_val(v) == 1 {
    // '_ is the wildcard SYMBOL. (v == '_' with a trailing quote is the
    // CHAR literal '_ = 95 — an int — which made this check always false
    // and `_` patterns fall through to is_pattern_var instead.)
    if v == '_ { 1 }
    else { 0 }
  } else { 0 }
}

fn is_pattern_var(v) {
  if is_symbol_val(v) == 1 {
    if is_wildcard_sym(v) == 1 { 0 }
    else if v == 'nil '{ 0 }
    else if v == 'cons '{ 0 }
    else if v == 'quote '{ 0 }
    else { 1 }
  } else { 0 }
}

// Pattern test emission — all tests are lowered to the generic opcode
// repertoire (OP_LOAD / OP_PUSH_* / OP_EQ / OP_IS_NIL / OP_IS_PAIR /
// OP_JUMP_IF_FALSE), the same instruction shapes user-written if/==
// conditions compile to. Each helper returns
//   (state (jmp_pos . fail_jumps))  — jmp_pos needs backpatching to the
// arm-failure target. NOTE (issue #167): an unresolved self-host stack bug
// miscompiles let-bindings of the deep recursive core (compile_expr /
// compile_pattern results). The pattern path avoids that shape — helpers
// emit inline opcodes and only bind leaf results (sibling emitters,
// find_sym_index), a form the three-generation bootstrap fixed point and
// the full test suite exercise and pass.

// Emit `load subj; <test>; jump_if_false -> fail` for a type test
// (OP_IS_NIL / OP_IS_PAIR).
fn emit_type_test(b, subj_slot, test_op, state, fail_jumps) {
  buf.push_byte(b, op_load)
  emit_u32(b, subj_slot)
  buf.push_byte(b, test_op)
  buf.push_byte(b, op_jump_if_false)
  let jmp_pos = buf.length(b)
  emit_u32(b, 0)
  cons(state, cons(jmp_pos, fail_jumps))
}

// Emit `load subj; <lit>; ==; jump_if_false -> fail`. lit must be an int,
// a string, or a symbol value; it is pushed inline (no compile_expr
// recursion — the pattern path stays straight-line).
fn emit_eq_test(b, subj_slot, lit, state, fail_jumps) {
  buf.push_byte(b, op_load)
  emit_u32(b, subj_slot)
  if int?(lit) {
    buf.push_byte(b, op_push_int)
    emit_i64(b, lit)
  }
  else if string?(lit) {
    buf.push_byte(b, op_push_string)
    emit_u32(b, str.length(lit))
    buf.push_string(b, lit)
  }
  else {
    buf.push_byte(b, op_push_sym)
    let idx = find_sym_index(get_syms(st_fn_names(state)), lit)
    if null?(idx) { emit_u32(b, 0) }
    else { emit_u32(b, idx) }
  }
  buf.push_byte(b, op_eq)
  buf.push_byte(b, op_jump_if_false)
  let jmp_pos = buf.length(b)
  emit_u32(b, 0)
  cons(state, cons(jmp_pos, fail_jumps))
}

// Pair pattern: test pair?, then bind car and cdr into fresh slots.
// (The fused OP_MATCH_PAIR that did this in one opcode is gone — this is
// now the same instruction sequence user-written if (pair? x) plus
// car/cdr would compile to.)
// Returns (state car_slot cdr_slot . (jmp_pos . fail_jumps)).
fn emit_pair_split(b, subj_slot, state, fail_jumps) {
  let tr = emit_type_test(b, subj_slot, op_is_pair, state, fail_jumps)
  let state1 = car(tr)
  let new_fj = cdr(tr)
  let car_slot = st_next_slot(state1)
  let cdr_slot = car_slot - 1
  let new_next = cdr_slot - 1
  buf.push_byte(b, op_load)
  emit_u32(b, subj_slot)
  buf.push_byte(b, op_car)
  buf.push_byte(b, op_store)
  emit_u32(b, car_slot)
  buf.push_byte(b, op_load)
  emit_u32(b, subj_slot)
  buf.push_byte(b, op_cdr)
  buf.push_byte(b, op_store)
  emit_u32(b, cdr_slot)
  let ms = st_max_slot(state1)
  let new_ms = if new_next < ms { new_next } else { ms }
  let state2 = make_state(st_fn_names(state1), st_next_fn_id(state1),
  st_fn_entries(state1), st_env(state1),
  new_next, new_ms)
  cons(state2, cons(car_slot, cons(cdr_slot, new_fj)))
}

fn compile_list_pattern_loop(b, remaining, subj_slot, state, fail_jumps) {
  if null?(remaining) {
    emit_type_test(b, subj_slot, op_is_nil, state, fail_jumps)
  }
  else if is_symbol_val(remaining) == 1 {
    compile_pattern(b, remaining, subj_slot, state, fail_jumps)
  }
  else {
    let pr = emit_pair_split(b, subj_slot, state, fail_jumps)
    let state2 = car(pr)
    let car_slot = car(cdr(pr))
    let cdr_slot = car(cdr(cdr(pr)))
    let fj2 = cdr(cdr(cdr(pr)))
    let r1 = compile_pattern(b, car(remaining), car_slot, state2, fj2)
    compile_list_pattern_loop(b, cdr(remaining), cdr_slot, car(r1), cdr(r1))
  }
}

fn compile_pattern(b, pat, subj_slot, state, fail_jumps) {
  if is_wildcard_sym(pat) == 1 {
    cons(state, fail_jumps)
  }
  else if is_pattern_var(pat) == 1 {
    let var_slot = st_next_slot(state)
    buf.push_byte(b, op_load)
    emit_u32(b, subj_slot)
    buf.push_byte(b, op_store)
    emit_u32(b, var_slot)
    let new_env = cons(cons(pat, var_slot), st_env(state))
    let new_next = var_slot - 1
    let ms = st_max_slot(state)
    let new_ms = if new_next < ms { new_next } else { ms }
    let state2 = make_state(st_fn_names(state), st_next_fn_id(state),
    st_fn_entries(state), new_env,
    new_next, new_ms)
    cons(state2, fail_jumps)
  }
  else if int?(pat) {
    emit_eq_test(b, subj_slot, pat, state, fail_jumps)
  }
  else if string?(pat) {
    emit_eq_test(b, subj_slot, pat, state, fail_jumps)
  }
  else if null?(pat) {
    emit_type_test(b, subj_slot, op_is_nil, state, fail_jumps)
  }
  else if pair?(pat) {
    let head = car(pat)
    match head {
      'quote -> {
        let quoted = car(cdr(pat))
        if is_symbol_val(quoted) == 1 {
          emit_eq_test(b, subj_slot, quoted, state, fail_jumps)
        } else if null?(quoted) {
          emit_type_test(b, subj_slot, op_is_nil, state, fail_jumps)
        } else {
          cons(state, fail_jumps)
        }
      }
      'cons -> {
        let pr = emit_pair_split(b, subj_slot, state, fail_jumps)
        let state2 = car(pr)
        let car_slot = car(cdr(pr))
        let cdr_slot = car(cdr(cdr(pr)))
        let fj2 = cdr(cdr(cdr(pr)))
        let pat_a = car(cdr(pat))
        let pat_b = car(cdr(cdr(pat)))
        let r1 = compile_pattern(b, pat_a, car_slot, state2, fj2)
        compile_pattern(b, pat_b, cdr_slot, car(r1), cdr(r1))
      }
      _ -> {
        // Unreachable: parse_pattern emits pair patterns only as (quote x)
        // or cons-chains (bracket / desugared constructor patterns share the
        // 'cons encoding). Reaching here means a parser contract bug.
        cons(state, fail_jumps)
      }
    }
  }
  else {
    cons(state, fail_jumps)
  }
}

// ============================================================
// Expression compilation
// ============================================================

fn compile_string_literal(b, expr, state) {
  buf.push_byte(b, op_push_string)
  emit_u32(b, str.length(expr))
  buf.push_string(b, expr)
  state
}

fn compile_expr(b, expr, tail, state) {
  if int?(expr) {
    if expr >= -128 {
      if expr < 128 {
        buf.push_byte(b, op_push_int8)
        buf.push_byte(b, expr)
      } else {
        buf.push_byte(b, op_push_int)
        emit_i64(b, expr)
      }
    } else {
      buf.push_byte(b, op_push_int)
      emit_i64(b, expr)
    }
    state
  }
  else if string?(expr) {
    compile_string_literal(b, expr, state)
  }
  else if pair?(expr) {
    if car(expr) == 'float {
      if string?(car(cdr(expr))) {
        // Float literal: the token value is the literal STRING (e.g. "1.5")
        // — the bootstrap language has no float values, so the string flows
        // end-to-end and the VM parses it with strtod at runtime.
        let s = car(cdr(expr))
        buf.push_byte(b, op_push_float)
        emit_u32(b, str.length(s))
        buf.push_string(b, s)
        state
      } else {
        compile_list(b, expr, tail, state)
      }
    } else {
      compile_list(b, expr, tail, state)
    }
  }
  else if null?(expr) {
    buf.push_byte(b, op_push_nil)
    state
  }
  else if symbol?(expr) {
    // symbol: check env, then fn_names (top-level function reference).
    // Dispatched via symbol? (forall a. a -> bool) BEFORE the == true/false
    // literal checks: those unify expr with bool, which would conflict when
    // the same tvar is used as a symbol below.
    let env = st_env(state)
    let slot = alist_find(env, expr)
    if null?(slot) {
      let fn_names = st_fn_names(state)
      let fid = find_fn(fn_names, expr)
      if null?(fid) {
        buf.push_byte(b, op_push_nil)
        state
      } else {
        buf.push_byte(b, op_closure)
        emit_u32(b, fid)
        emit_u32(b, 0)
        state
      }
    } else {
      buf.push_byte(b, op_load)
      emit_u32(b, slot)
      state
    }
  }
  else if expr == true {
    buf.push_byte(b, op_push_true)
    state
  }
  else if expr == false {
    buf.push_byte(b, op_push_false)
    state
  }
  else {
    // Unreachable for well-formed ASTs: every atom kind (int, string, pair,
    // nil, symbol, true, false) is handled above. Kept for safety.
    buf.push_byte(b, op_push_nil)
    state
  }
}

fn compile_list(b, expr, tail, state) {
  let head = car(expr)
  match head {
    'if -> compile_if(b, cdr(expr), tail, state)
    'let -> compile_let(b, cdr(expr), tail, state)
    'begin -> compile_begin(b, cdr(expr), tail, state)
    'lambda -> compile_lambda(b, cdr(expr), state)
    'and -> compile_and(b, cdr(expr), tail, state)
    'or -> compile_or(b, cdr(expr), tail, state)
    'quote -> compile_quote(b, cdr(expr), state)
    'define -> { buf.push_byte(b, op_push_nil); state }
    'define_pub -> { buf.push_byte(b, op_push_nil); state }
    'import -> { buf.push_byte(b, op_push_nil); state }
    'type -> { buf.push_byte(b, op_push_nil); state }
    'type-sig -> { buf.push_byte(b, op_push_nil); state }
    'external_fn -> { buf.push_byte(b, op_push_nil); state }
    'receive-scan -> compile_receive_scan(b, cdr(expr), tail, state)
    'list -> compile_list_literal(b, cdr(expr), state)
    _ -> compile_call(b, head, cdr(expr), tail, state)
  }
}

// (list e1 ... en): the parser's list literal form. Emit the runtime
// cons chain. OP_CONS pops cdr then car, so each element is compiled
// first, the nil tail last, then one OP_CONS per element folds the
// stack into cons(e1, cons(e2, ... cons(en, nil))).
fn compile_list_literal(b, elems, state) {
  if null?(elems) {
    buf.push_byte(b, op_push_nil)
    state
  } else {
    let s1 = compile_expr(b, car(elems), 0, state)
    let s2 = compile_list_literal(b, cdr(elems), s1)
    buf.push_byte(b, op_cons)
    s2
  }
}

fn compile_special(b, head, args, tail, state) {
  match head {
    'spawn -> compile_spawn(b, args, state)
    'send -> compile_send(b, args, state)
    'recv -> { emit_builtin(b, builtin_recv); state }
    'recv_after -> {
      let s1 = compile_expr(b, car(args), 0, state)
      emit_builtin(b, builtin_recv_after)
      s1
    }
    'self -> { buf.push_byte(b, op_self); state }
    'monitor -> {
      let s1 = compile_expr(b, car(args), 0, state)
      emit_builtin(b, builtin_monitor)
      s1
    }
    'match -> compile_match(b, args, tail, state)
    'receive -> compile_receive(b, args, tail, state)
    _ -> compile_general_call(b, head, args, tail, state)
  }
}

// ============================================================
// (if cond then else?)
// ============================================================

fn compile_if(b, args, tail, state) {
  let s1 = compile_expr(b, car(args), 0, state)
  buf.push_byte(b, op_jump_if_false)
  let jif_pos = buf.length(b)
  emit_u32(b, 0)
  let n = list_len(args)
  let s2 = compile_expr(b, car(cdr(args)), tail, s1)
  if n >= 3 {
    buf.push_byte(b, op_jump)
    let j_pos = buf.length(b)
    emit_u32(b, 0)
    let else_start = buf.length(b)
    patch_u32(b, jif_pos, else_start)
    let s3 = compile_expr(b, car(cdr(cdr(args))), tail, s2)
    patch_u32(b, j_pos, buf.length(b))
    s3
  } else {
    patch_u32(b, jif_pos, buf.length(b))
    buf.push_byte(b, op_push_nil)
    s2
  }
}

// ============================================================
// (let var init body...) or (let ((v e)...) body...)
// ============================================================

fn compile_let(b, args, tail, state) {
  let second = car(args)
  if is_symbol_val(second) == 1 {
    compile_let_single(b, second, car(cdr(args)), cdr(cdr(args)), tail, state)
  } else {
    if null?(second) {
      compile_body(b, cdr(args), tail, state)
    } else {
      compile_let_multi(b, second, cdr(args), tail, state)
    }
  }
}

fn compile_let_single(b, var, init, body, tail, state) {
  let s1 = compile_expr(b, init, 0, state)
  let ns = st_next_slot(s1)
  let ms = st_max_slot(s1)
  let new_ms = if ns - 1 < ms { ns - 1 } else { ms }
  buf.push_byte(b, op_store)
  emit_u32(b, ns)
  let new_env = cons(cons(var, ns), st_env(s1))
  compile_body(b, body, tail,
  make_state(st_fn_names(s1), st_next_fn_id(s1),
  st_fn_entries(s1), new_env, ns - 1, new_ms))
}

fn compile_let_multi(b, bindings, body, tail, state) {
  match bindings {
    nil -> compile_body(b, body, tail, state)
    cons(binding, rest) -> {
      match binding {
        cons(vname, cons(init_expr, _)) -> {
          let s1 = compile_expr(b, init_expr, 0, state)
          let ns = st_next_slot(s1)
          let ms = st_max_slot(s1)
          let new_ms = if ns - 1 < ms { ns - 1 } else { ms }
          buf.push_byte(b, op_store)
          emit_u32(b, ns)
          let new_env = cons(cons(vname, ns), st_env(s1))
          compile_let_multi(b, rest, body, tail,
          make_state(st_fn_names(s1), st_next_fn_id(s1),
          st_fn_entries(s1), new_env, ns - 1, new_ms))
        }
        _ -> compile_let_multi(b, rest, body, tail, state)
      }
    }
  }
}

// ============================================================
// (begin e1 e2 ... eN)
// ============================================================

fn compile_begin(b, args, tail, state) {
  match args {
    nil -> { buf.push_byte(b, op_push_nil); state }
    _ -> compile_begin_loop(b, args, tail, state)
  }
}

fn compile_begin_loop(b, args, tail, state) {
  match cdr(args) {
    nil -> compile_expr(b, car(args), tail, state)
    _ -> {
      let s1 = compile_expr(b, car(args), 0, state)
      buf.push_byte(b, op_pop)
      compile_begin_loop(b, cdr(args), tail, s1)
    }
  }
}

// ============================================================
// (and e1 e2 ... eN) — short-circuit
// ============================================================

fn compile_and(b, args, tail, state) {
  if null?(args) { buf.push_byte(b, op_push_true); state }
  else if null?(cdr(args)) { compile_expr(b, car(args), tail, state) }
  else { compile_and_loop(b, args, tail, state, nil) }
}

fn compile_and_loop(b, args, tail, state, jumps) {
  match cdr(args) {
    nil -> {
      let s = compile_expr(b, car(args), tail, state)
      patch_jumps(b, jumps, buf.length(b))
      s
    }
    _ -> {
      let s = compile_expr(b, car(args), 0, state)
      buf.push_byte(b, op_dup)
      buf.push_byte(b, op_jump_if_false)
      let jpos = buf.length(b)
      emit_u32(b, 0)
      buf.push_byte(b, op_pop)
      compile_and_loop(b, cdr(args), tail, s, cons(jpos, jumps))
    }
  }
}

// ============================================================
// (or e1 e2 ... eN) — short-circuit
// ============================================================

fn compile_or(b, args, tail, state) {
  if null?(args) { buf.push_byte(b, op_push_nil); state }
  else if null?(cdr(args)) { compile_expr(b, car(args), tail, state) }
  else { compile_or_loop(b, args, tail, state, nil) }
}

fn compile_or_loop(b, args, tail, state, end_jumps) {
  match cdr(args) {
    nil -> {
      let s = compile_expr(b, car(args), tail, state)
      patch_jumps(b, end_jumps, buf.length(b))
      s
    }
    _ -> {
      let s = compile_expr(b, car(args), 0, state)
      buf.push_byte(b, op_dup)
      buf.push_byte(b, op_jump_if_false)
      let patch_next = buf.length(b)
      emit_u32(b, 0)
      buf.push_byte(b, op_jump)
      let end_pos = buf.length(b)
      emit_u32(b, 0)
      patch_u32(b, patch_next, buf.length(b))
      buf.push_byte(b, op_pop)
      compile_or_loop(b, cdr(args), tail, s, cons(end_pos, end_jumps))
    }
  }
}

// ============================================================
// (quote x)
// ============================================================

fn compile_quote(b, args, state) {
  let quoted = car(args)
  if null?(quoted) {
    buf.push_byte(b, op_push_nil)
    state
  }
  else if int?(quoted) {
    if quoted >= 0 {
      if quoted < 128 {
        buf.push_byte(b, op_push_int8)
        buf.push_byte(b, quoted)
      } else {
        buf.push_byte(b, op_push_int)
        emit_i64(b, quoted)
      }
    } else {
      if quoted >= -128 {
        buf.push_byte(b, op_push_int8)
        buf.push_byte(b, quoted + 256)
      } else {
        buf.push_byte(b, op_push_int)
        emit_i64(b, quoted)
      }
    }
    state
  }
  else if pair?(quoted) {
    buf.push_byte(b, op_push_nil)
    state
  }
  else {
    let idx = find_sym_index(get_syms(st_fn_names(state)), quoted)
    if null?(idx) { buf.push_byte(b, op_push_nil); state }
    else {
      buf.push_byte(b, op_push_sym)
      emit_u32(b, idx)
      state
    }
  }
}

// ============================================================
// (lambda (params...) body...)
// ============================================================

fn compile_lambda(b, args, state) {
  let params = car(args)
  // Body is the single expression in slot 2; the optional ret_type in
  // slot 3 is a type annotation, never compiled.
  let body = cons(car(cdr(args)), nil)
  let fn_names = st_fn_names(state)
  let next_fn_id = st_next_fn_id(state)
  let fn_entries = st_fn_entries(state)
  let env = st_env(state)
  let combined_env = build_combined_env(params, 0, env)
  let free_vars = compute_free_vars(body, combined_env, params)
  let nfree = list_len(free_vars)
  buf.push_byte(b, op_closure)
  emit_u32(b, next_fn_id)
  emit_u32(b, nfree)
  emit_free_slots(b, free_vars)
  buf.push_byte(b, op_jump)
  let jump_pos = buf.length(b)
  emit_u32(b, 0)
  let entry = buf.length(b)
  let body_env = build_body_env(params, free_vars)
  buf.push_byte(b, op_enter)
  let enter_pos = buf.length(b)
  emit_u32(b, 0)
  let body_state = make_state(fn_names, next_fn_id + 1,
  cons(cons(next_fn_id, entry), fn_entries),
  body_env, -5, -5)
  let fs = compile_body(b, body, 1, body_state)
  buf.push_byte(b, op_ret)
  patch_u32(b, enter_pos, (-5) - st_max_slot(fs))
  patch_u32(b, jump_pos, buf.length(b))
  make_state(fn_names, st_next_fn_id(fs),
  st_fn_entries(fs),
  env, st_next_slot(state), st_max_slot(state))
}

// ============================================================
// Function call compilation
// ============================================================

// Emit an OP_CCALL_NAME: compile args, then emit the call with the
// symbol index and arg count. Used for registered C functions and for
// C modules auto-loaded lazily at runtime (see compile_call).
fn emit_ccall_name(b, head, args, state) {
  let s1 = compile_args(b, args, state)
  buf.push_byte(b, op_ccall_name)
  let sym_idx = find_sym_index(get_syms(st_fn_names(state)), head)
  emit_u32(b, sym_idx)
  buf.push_byte(b, list_len(args))
  s1
}

fn compile_call(b, head, args, tail, state) {
  let op = inline_op(head)
  if op >= 0 {
    let s1 = compile_args(b, args, state)
    buf.push_byte(b, op)
    s1
  }
  else if is_swap_op(head) == 1 {
    // > uses op_lt with swapped operands, >= uses op_le with swapped operands
    let swap_op = if head == '> { op_lt } else { op_le }
    let s1 = compile_expr(b, cg_list_ref(args, 1), 0, state)
    let s2 = compile_expr(b, cg_list_ref(args, 0), 0, s1)
    buf.push_byte(b, swap_op)
    s2
  }
  else if is_symbol_val(head) == 1 {
    let cfidx = vm.cfunc_index(head)
    if cfidx >= 0 {
      emit_ccall_name(b, head, args, state)
    } else {
      // C module auto-load: a dotted symbol that names no TA function
      // must be a C module member — emit OP_CCALL_NAME and let the
      // runtime lazily dlopen lib/<module>[_<tag>].<ext> on first call.
      // TA module members (mod.fn) are registered by the linker and keep
      // the normal compile_special path. Dispatching on the symbol table
      // (not on the presence of a built module file) keeps codegen
      // independent of which build config happens to have been compiled.
      let s = str.sym_to_str(head)
      let dot = rindex_dot(s, str.length(s))
      if dot >= 0 {
        if null?(find_fn(st_fn_names(state), head)) {
          emit_ccall_name(b, head, args, state)
        } else {
          compile_special(b, head, args, tail, state)
        }
      } else {
        compile_special(b, head, args, tail, state)
      }
    }
  } else {
    compile_special(b, head, args, tail, state)
  }
}

fn compile_spawn(b, args, state) {
  let arg0 = car(args)
  if pair?(arg0) {
    match car(arg0) {
      'quote -> {
        let quoted = car(cdr(arg0))
        if is_symbol_val(quoted) == 1 {
          let fid_raw = find_fn(st_fn_names(state), quoted)
          let fid = if null?(fid_raw) { 0 } else { fid_raw }
          emit_builtin(b, builtin_spawn)
          emit_u32(b, fid)
          state
        } else {
          let s1 = compile_expr(b, arg0, 0, state)
          emit_builtin(b, builtin_spawn_clos)
          s1
        }
      }
      _ -> {
        let s1 = compile_expr(b, arg0, 0, state)
        emit_builtin(b, builtin_spawn_clos)
        s1
      }
    }
  } else {
    let s1 = compile_expr(b, arg0, 0, state)
    emit_builtin(b, builtin_spawn_clos)
    s1
  }
}

fn compile_send(b, args, state) {
  // compile.c: compile msg, compile pid, OP_BUILTIN send
  let s1 = compile_expr(b, car(cdr(args)), 0, state)
  let s2 = compile_expr(b, car(args), 0, s1)
  emit_builtin(b, builtin_send)
  s2
}

fn compile_general_call(b, head, args, tail, state) {
  let s1 = compile_expr(b, head, 0, state)
  let s2 = compile_args(b, args, s1)
  if tail == 1 { buf.push_byte(b, op_tail_call) }
  else { buf.push_byte(b, op_call) }
  emit_u32(b, list_len(args))
  s2
}

fn compile_args(b, args, state) {
  match args {
    nil -> state
    cons(a, rest) -> {
      let s1 = compile_expr(b, a, 0, state)
      compile_args(b, rest, s1)
    }
  }
}

// ============================================================
// receive-scan
// (receive-scan (lambda (msg) body...))
// ============================================================

fn compile_receive_scan(b, args, tail, state) {
  let lam = car(args)
  let params = car(cdr(lam))
  let body = cdr(cdr(lam))
  let msg_sym = car(params)
  let ns = st_next_slot(state)
  let ms = st_max_slot(state)
  let new_ms = if ns - 1 < ms { ns - 1 } else { ms }
  let loop_start = buf.length(b)
  emit_builtin(b, builtin_recv_peek)
  buf.push_byte(b, op_store)
  emit_u32(b, ns)
  let new_env = cons(cons(msg_sym, ns), st_env(state))
  let body_state = make_state(st_fn_names(state), st_next_fn_id(state),
  st_fn_entries(state), new_env,
  ns - 1, new_ms)
  let fs = compile_body(b, body, 0, body_state)
  buf.push_byte(b, op_jump)
  emit_u32(b, loop_start)
  fs
}

// ============================================================
// receive { arms }
// ============================================================

fn compile_receive_branches(b, branches, tail, state, subj_slot, loop_start, end_jumps) {
  match branches {
    nil -> {
      buf.push_byte(b, op_jump)
      emit_u32(b, loop_start)
      patch_all_jumps(b, end_jumps, buf.length(b))
      state
    }
    cons(branch, rest) -> {
      match branch {
        cons(pat, body) -> {
          // arm is (pat body) or (pat guard body)
          let has_guard = if null?(cdr(body)) { 0 } else { 1 }
          let guard = if has_guard == 1 { car(body) } else { true }
          let arm_body = if has_guard == 1 { cdr(body) } else { body }
          let saved_slot = st_next_slot(state)
          let saved_env = st_env(state)
          let pj = compile_pattern(b, pat, subj_slot, state, nil)
          let state2 = car(pj)
          let fail_jumps = cdr(pj)
          let sg = if has_guard == 1 {
            let s = compile_expr(b, guard, 0, state2)
            buf.push_byte(b, op_jump_if_false)
            let gjmp = buf.length(b)
            emit_u32(b, 0)
            cons(s, cons(gjmp, fail_jumps))
          } else {
            cons(state2, fail_jumps)
          }
          // Only commit the peeked message once pattern AND guard match
          emit_builtin(b, builtin_recv_commit)
          let s3 = compile_body(b, arm_body, tail, car(sg))
          buf.push_byte(b, op_jump)
          let jmp_pos = buf.length(b)
          emit_u32(b, 0)
          patch_all_jumps(b, cdr(sg), buf.length(b))
          let state3 = make_state(st_fn_names(s3), st_next_fn_id(s3),
          st_fn_entries(s3), saved_env,
          saved_slot, st_max_slot(s3))
          compile_receive_branches(b, rest, tail, state3, subj_slot,
          loop_start, cons(jmp_pos, end_jumps))
        }
        _ -> compile_receive_branches(b, rest, tail, state, subj_slot, loop_start, end_jumps)
      }
    }
  }
}

fn compile_receive(b, args, tail, state) {
  let branches = args
  let subj_slot = st_next_slot(state)
  let new_next = subj_slot - 1
  let ms = st_max_slot(state)
  let new_ms = if new_next < ms { new_next } else { ms }
  let state2 = make_state(st_fn_names(state), st_next_fn_id(state),
  st_fn_entries(state), st_env(state),
  new_next, new_ms)
  let loop_start = buf.length(b)
  emit_builtin(b, builtin_recv_peek)
  buf.push_byte(b, op_store)
  emit_u32(b, subj_slot)
  compile_receive_branches(b, branches, tail, state2, subj_slot, loop_start, nil)
}

// ============================================================
// match
// ============================================================

fn compile_match_branches(b, branches, tail, state, subj_slot, end_jumps) {
  match branches {
    nil -> {
      buf.push_byte(b, op_push_nil)
      patch_all_jumps(b, end_jumps, buf.length(b))
      state
    }
    cons(branch, rest) -> {
      match branch {
        cons(pat, body) -> {
          // arm is (pat body) or (pat guard body)
          let has_guard = if null?(cdr(body)) { 0 } else { 1 }
          let guard = if has_guard == 1 { car(body) } else { true }
          let arm_body = if has_guard == 1 { cdr(body) } else { body }
          let saved_slot = st_next_slot(state)
          let saved_env = st_env(state)
          let pj = compile_pattern(b, pat, subj_slot, state, nil)
          let state2 = car(pj)
          let fail_jumps = cdr(pj)
          let sg = if has_guard == 1 {
            let s = compile_expr(b, guard, 0, state2)
            buf.push_byte(b, op_jump_if_false)
            let gjmp = buf.length(b)
            emit_u32(b, 0)
            cons(s, cons(gjmp, fail_jumps))
          } else {
            cons(state2, fail_jumps)
          }
          let s3 = compile_body(b, arm_body, tail, car(sg))
          buf.push_byte(b, op_jump)
          let jmp_pos = buf.length(b)
          emit_u32(b, 0)
          patch_all_jumps(b, cdr(sg), buf.length(b))
          let state3 = make_state(st_fn_names(s3), st_next_fn_id(s3),
          st_fn_entries(s3), saved_env,
          saved_slot, st_max_slot(s3))
          compile_match_branches(b, rest, tail, state3, subj_slot,
          cons(jmp_pos, end_jumps))
        }
        _ -> compile_match_branches(b, rest, tail, state, subj_slot, end_jumps)
      }
    }
  }
}

fn compile_match(b, args, tail, state) {
  let scrutinee = car(args)
  let branches = cdr(args)
  let s1 = compile_expr(b, scrutinee, 0, state)
  let subj_slot = st_next_slot(s1)
  buf.push_byte(b, op_store)
  emit_u32(b, subj_slot)
  let new_next = subj_slot - 1
  let ms = st_max_slot(s1)
  let new_ms = if new_next < ms { new_next } else { ms }
  let s2 = make_state(st_fn_names(s1), st_next_fn_id(s1), st_fn_entries(s1),
  st_env(s1), new_next, new_ms)
  compile_match_branches(b, branches, tail, s2, subj_slot, nil)
}

// ============================================================
// Body compilation
// ============================================================

fn compile_body(b, body, tail, state) {
  if null?(body) { buf.push_byte(b, op_push_nil); state }
  else if null?(cdr(body)) { compile_expr(b, car(body), tail, state) }
  else {
    let s1 = compile_expr(b, car(body), 0, state)
    buf.push_byte(b, op_pop)
    compile_body(b, cdr(body), tail, s1)
  }
}

// ============================================================
// Define body compilation
// ============================================================

fn compile_define_body(b, fn_names, next_fn_id, fn_entries, sig, body) {
  let param_env = build_param_env(cdr(sig), 0)
  buf.push_byte(b, op_enter)
  let enter_pos = buf.length(b)
  emit_u32(b, 0)
  let init_state = make_state(fn_names, next_fn_id, fn_entries, param_env, -5, -5)
  let fs = compile_body(b, body, 1, init_state)
  buf.push_byte(b, op_ret)
  patch_u32(b, enter_pos, (-5) - st_max_slot(fs))
  fs
}

// ============================================================
// Pass 1: register function names
// ============================================================

fn pass1_register(forms, acc, next_id) {
  match forms {
    nil -> cons(acc, next_id)
    cons(form, rest) -> {
      if pair?(form) {
        let head = car(form)
        if is_define_form(head) == 1 {
          let sig = car(cdr(form))
          if pair?(sig) {
            pass1_register(rest, cons(cons(car(sig), next_id), acc), next_id + 1)
          } else { pass1_register(rest, acc, next_id) }
        } else { pass1_register(rest, acc, next_id) }
      } else { pass1_register(rest, acc, next_id) }
    }
  }
}

// ============================================================
// Pass 2: compile function bodies
// ============================================================

fn pass2_compile(forms, b, fn_names, next_fn_id, fn_entries, cur_id, acc) {
  match forms {
    nil -> cons(next_fn_id, cons(fn_entries, acc))
    cons(form, rest) -> {
      if pair?(form) {
        let head = car(form)
        if is_define_form(head) == 1 {
          let sig = car(cdr(form))
          if pair?(sig) {
            let entry = buf.length(b)
            let fs = compile_define_body(b, fn_names, next_fn_id, fn_entries, sig, cdr(cdr(form)))
            pass2_compile(rest, b, fn_names,
            st_next_fn_id(fs), st_fn_entries(fs),
            cur_id + 1, cons(cons(cur_id, entry), acc))
          } else { pass2_compile(rest, b, fn_names, next_fn_id, fn_entries, cur_id, acc) }
        } else { pass2_compile(rest, b, fn_names, next_fn_id, fn_entries, cur_id, acc) }
      } else { pass2_compile(rest, b, fn_names, next_fn_id, fn_entries, cur_id, acc) }
    }
  }
}

// ============================================================
// Lookup helpers
// ============================================================

fn find_fn_offset(offsets, fn_id) {
  match offsets {
    nil -> 0
    cons(pair, rest) -> {
      if car(pair) == fn_id { cdr(pair) }
      else { find_fn_offset(rest, fn_id) }
    }
  }
}

fn find_fn_entry(define_offsets, lambda_offsets, fn_id) {
  let off = find_fn_offset(define_offsets, fn_id)
  if off > 0 { off }
  else { find_fn_offset(lambda_offsets, fn_id) }
}

fn find_main_fn(fn_names) {
  match fn_names {
    nil -> -1
    cons(pair, rest) -> {
      let rest_best = find_main_fn(rest)
      if rest_best >= 0 {
        if car(pair) == 'main {
          let curr = cdr(pair)
          if curr < rest_best { curr } else { rest_best }
        } else { rest_best }
      } else {
        if car(pair) == 'main { cdr(pair) } else { -1 }
      }
    }
  }
}

// ============================================================
// Top-level expression compilation (non-define forms at top level)
// ============================================================

fn compile_top_level(forms, b, fn_names, fn_entries, next_fn_id, has_top) {
  match forms {
    nil -> cons(has_top, cons(fn_entries, next_fn_id))
    cons(form, rest) -> {
      if pair?(form) {
        let head = car(form)
        match head {
          'define -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'define_pub -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'import -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'const -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'type -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'type-sig -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          'external_fn -> compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
          _ -> {
            let s1 = compile_expr(b, form, 0,
            make_state(fn_names, next_fn_id, fn_entries, nil, 0, 0))
            buf.push_byte(b, op_pop)
            compile_top_level(rest, b, fn_names,
            st_fn_entries(s1), st_next_fn_id(s1), 1)
          }
        }
      } else {
        compile_top_level(rest, b, fn_names, fn_entries, next_fn_id, has_top)
      }
    }
  }
}

// ============================================================
// Const support
// ============================================================

fn collect_consts(forms, acc) {
  match forms {
    nil -> acc
    cons(form, rest) -> {
      if pair?(form) {
        if car(form) == 'const {
          let name = car(cdr(form))
          let val_expr = car(cdr(cdr(form)))
          collect_consts(rest, cons(cons(name, val_expr), acc))
        } else { collect_consts(rest, acc) }
      } else { collect_consts(rest, acc) }
    }
  }
}

fn assq_key(key, alist) {
  match alist {
    nil -> nil
    cons(pair, rest) -> {
      if car(pair) == key { pair }
      else { assq_key(key, rest) }
    }
  }
}

fn sym_in_list(sym, lst) {
  match lst {
    nil -> 0
    cons(x, rest) -> {
      if x == sym { 1 } else { sym_in_list(sym, rest) }
    }
  }
}

fn append_shadow(extra, shadow) {
  match extra {
    nil -> shadow
    cons(x, rest) -> cons(x, append_shadow(rest, shadow))
  }
}

// collect_pattern_bindings(pat, acc) — lowercase identifiers in a pattern
// are binders; uppercase constructors ((quote X), (Name args)) and literals
// bind nothing. Used to shadow const names inside match/receive arm bodies.
fn collect_pattern_bindings(pat, acc) {
  if is_symbol_val(pat) == 1 {
    cons(pat, acc)
  } else {
    if pair?(pat) {
      if car(pat) == 'quote {
        acc
      } else {
        collect_pattern_bindings(cdr(pat), collect_pattern_bindings(car(pat), acc))
      }
    } else { acc }
  }
}

// resolve_match_arms(arms, consts, shadow) — each arm is (pat body) — two
// elements — or (pat guard body) — three elements. A braced body is itself
// a list, so the element count (not emptiness of cddr) tells them apart.
// Pattern binders shadow const names inside that arm's guard and body; the
// pattern itself is a declaration region, so it is left as-is.
fn resolve_match_arms(arms, consts, shadow) {
  match arms {
    nil -> nil
    cons(arm, rest) -> {
      let pat = car(arm)
      let binders = collect_pattern_bindings(pat, nil)
      let new_shadow = append_shadow(binders, shadow)
      let new_arm = if list_len(arm) == 2 {
        // (pat body)
        let body = car(cdr(arm))
        cons(pat, cons(resolve_consts(body, consts, new_shadow), nil))
      } else {
        // (pat guard body)
        let guard = car(cdr(arm))
        let body = car(cdr(cdr(arm)))
        cons(pat, cons(resolve_consts(guard, consts, new_shadow),
        cons(resolve_consts(body, consts, new_shadow), nil)))
      }
      cons(new_arm, resolve_match_arms(rest, consts, shadow))
    }
  }
}

// resolve_consts(ast, consts, shadow) — inline (const NAME value) references
// into the AST. The shadow list holds binder names (lambda params, let
// bindings, match/receive pattern vars) that must NOT be substituted even if
// they collide with a const name. Binders are scoped at their definition
// site, so the substitution is scope-aware.
pub fn resolve_consts(ast, consts, shadow) {
  if pair?(ast) {
    let head = car(ast)
    if head == 'quote {
      let inner = car(cdr(ast))
      if is_symbol_val(inner) == 1 {
        if sym_in_list(inner, shadow) == 1 {
          ast
        } else {
          let pair = assq_key(inner, consts)
          match pair {
            nil -> ast
            _ -> cdr(pair)
          }
        }
      } else { ast }
    } else {
      if head == 'define || head == 'define_pub {
        // (define (name params...) body) — params are binders for the body.
        let sig = car(cdr(ast))
        let params = cdr(sig)
        let body = car(cdr(cdr(ast)))
        let new_shadow = append_shadow(params, shadow)
        cons(head, cons(sig, cons(resolve_consts(body, consts, new_shadow), nil)))
      } else {
        if head == 'lambda {
          // ('lambda params body ret_type) — params are binders for the
          // body; the ret_type (nil when absent) is a type annotation and
          // is preserved verbatim.
          let params = car(cdr(ast))
          let body = car(cdr(cdr(ast)))
          let ret_type = car(cdr(cdr(cdr(ast))))
          let new_shadow = append_shadow(params, shadow)
          cons('lambda, cons(params, cons(resolve_consts(body, consts, new_shadow), cons(ret_type, nil))))
        } else {
          if head == 'let {
            // ('let var expr rest) — var is a binder for rest only.
            let var_sym = car(cdr(ast))
            let val_expr = car(cdr(cdr(ast)))
            let rest = car(cdr(cdr(cdr(ast))))
            cons('let, cons(var_sym,
            cons(resolve_consts(val_expr, consts, shadow),
            cons(resolve_consts(rest, consts, cons(var_sym, shadow)), nil))))
          } else {
            if head == 'match {
              // ('match scrut arms...) — pattern vars scope per-arm.
              let scrut = car(cdr(ast))
              let arms = cdr(cdr(ast))
              cons('match, cons(resolve_consts(scrut, consts, shadow),
              resolve_match_arms(arms, consts, shadow)))
            } else {
              if head == 'receive {
                // ('receive arms...) — pattern vars scope per-arm.
                let arms = cdr(ast)
                cons('receive, resolve_match_arms(arms, consts, shadow))
              } else {
                cons(resolve_consts(car(ast), consts, shadow),
                resolve_consts(cdr(ast), consts, shadow))
              }
            }
          }
        }
      }
    }
  }
  else if is_symbol_val(ast) == 1 {
    if sym_in_list(ast, shadow) == 1 {
      ast
    } else {
      let pair = assq_key(ast, consts)
      match pair {
        nil -> ast
        _ -> cdr(pair)
      }
    }
  }
  else { ast }
}
fn resolve_const_values(consts, all_consts) {
  match consts {
    nil -> nil
    cons(entry, rest) -> {
      let name = car(entry)
      let value = cdr(entry)
      let resolved_val = resolve_consts(value, all_consts, nil)
      cons(cons(name, resolved_val), resolve_const_values(rest, all_consts))
    }
  }
}

fn filter_const_forms(forms, acc) {
  match forms {
    nil -> cg_reverse_list(acc, nil)
    cons(form, rest) -> {
      if pair?(form) {
        if car(form) == 'const {
          filter_const_forms(rest, acc)
        } else {
          filter_const_forms(rest, cons(form, acc))
        }
      } else {
        filter_const_forms(rest, cons(form, acc))
      }
    }
  }
}

// ============================================================
// Main compilation pipeline
// ============================================================

// Resolve compile-time constants: inline (const NAME expr) values into the
// AST and drop the const forms. Scope-aware: lambda params, let bindings and
// match/receive pattern vars shadow const names in their bodies.
pub fn resolve_const_forms(ast) {
  let consts = collect_consts(ast, nil)
  let resolved_consts = resolve_const_values(consts, consts)
  let clean_ast = filter_const_forms(ast, nil)
  resolve_consts(clean_ast, resolved_consts, nil)
}

fn compile_code(ast) {
  let final_ast = resolve_const_forms(ast)
  let b = buf.new()
  let p1 = pass1_register(final_ast, nil, 0)
  let fn_names_base = car(p1)
  let n_funcs = cdr(p1)
  let sym_result = collect_ast_list(final_ast, init_syms(), 42)
  let full_syms = car(sym_result)
  let fn_names = embed_syms(fn_names_base, full_syms)
  buf.push_byte(b, op_jump)
  let jump_pos = buf.length(b)
  emit_u32(b, 0)
  let p2 = pass2_compile(final_ast, b, fn_names, n_funcs + 1, nil, 0, nil)
  let total_fns = car(p2)
  let fn_entries = car(cdr(p2))
  let fn_offsets = cdr(cdr(p2))
  let top_entry = buf.length(b)
  patch_u32(b, jump_pos, top_entry)
  let tl_result = compile_top_level(final_ast, b, fn_names, fn_entries, total_fns, 0)
  let has_top = car(tl_result)
  let final_fn_entries = car(cdr(tl_result))
  let final_total_fns = cdr(cdr(tl_result))
  if has_top == 0 {
    let main_fid = find_main_fn(fn_names)
    if main_fid >= 0 {
      emit_builtin(b, builtin_spawn_main)
      emit_u32(b, main_fid)
    }
  }
  buf.push_byte(b, op_push_nil)
  buf.push_byte(b, op_halt)
  cons(b, cons(final_total_fns, cons(n_funcs, cons(top_entry,
  cons(fn_offsets, cons(final_fn_entries, cons(full_syms, fn_names)))))))
}

// ============================================================
// Serialize to .tabc
// ============================================================

fn serialize_syms(out, syms, idx, max_idx) {
  if idx < max_idx {
    let name = sym_find_by_idx(syms, idx)
    emit_u32(out, str.length(name))
    buf.push_string(out, name)
    serialize_syms(out, syms, idx + 1, max_idx)
  }
}

fn ser_fn_table(out, define_off, lambda_off, idx, total_fns, top_fn_id, top_off) {
  if idx < total_fns {
    if idx == top_fn_id {
      emit_u32(out, top_off)
    } else {
      emit_u32(out, find_fn_entry(define_off, lambda_off, idx))
    }
    ser_fn_table(out, define_off, lambda_off, idx + 1, total_fns, top_fn_id, top_off)
  }
}

// fn name table (.tabc v2): reverse lookup over the (sym . fn_id) alist.
// Only top-level defines are named; the top-level thunk is "main" and
// lambdas get a synthetic "lambda#<id>" label (tracking the enclosing
// define would need too much codegen churn for little profiling value).
fn fn_name_of(fn_names, id) {
  match fn_names {
    nil -> nil
    cons(pair, rest) -> {
      if cdr(pair) == id { str.sym_to_str(car(pair)) }
      else { fn_name_of(rest, id) }
    }
  }
}

fn ser_fn_names(out, fn_names, n_funcs, total_fns, idx) {
  if idx < total_fns {
    let name =
    if idx == n_funcs { "main" }
    else {
      let n = fn_name_of(fn_names, idx)
      if null?(n) { str.concat("lambda#", str.from_int(idx)) }
      else { n }
    }
    emit_u32(out, str.length(name))
    buf.push_string(out, name)
    ser_fn_names(out, fn_names, n_funcs, total_fns, idx + 1)
  }
}

fn copy_bytes(dest, src, pos, len) {
  if pos < len {
    buf.push_byte(dest, buf.get_byte(src, pos))
    copy_bytes(dest, src, pos + 1, len)
  }
}

fn serialize_tabc(info) {
  let b = car(info)
  let total_fns = car(cdr(info))
  let n_funcs = car(cdr(cdr(info)))
  let top_entry = car(cdr(cdr(cdr(info))))
  let fn_offsets = car(cdr(cdr(cdr(cdr(info)))))
  let fn_entries = car(cdr(cdr(cdr(cdr(cdr(info))))))
  let syms = car(cdr(cdr(cdr(cdr(cdr(cdr(info)))))))
  let fn_names = cdr(cdr(cdr(cdr(cdr(cdr(cdr(info)))))))
  let n_syms = sym_count(syms)
  let out = buf.new()
  buf.push_byte(out, 84) // 'T'
  buf.push_byte(out, 65) // 'A'
  buf.push_byte(out, 66) // 'B'
  buf.push_byte(out, 67) // 'C'
  emit_u32(out, 3) // version: 3 = fn_table + per-fn name table + OP_BUILTIN actor primitives
  emit_u32(out, n_syms)
  emit_u32(out, total_fns)
  emit_u32(out, n_funcs)
  emit_u32(out, buf.length(b))
  serialize_syms(out, syms, 0, n_syms)
  ser_fn_table(out, fn_offsets, fn_entries, 0, total_fns, n_funcs, top_entry)
  ser_fn_names(out, fn_names, n_funcs, total_fns, 0)
  copy_bytes(out, b, 0, buf.length(b))
  out
}

// ============================================================
// Public API
// ============================================================

pub fn compile(ast) {
  let info = compile_code(ast)
  serialize_tabc(info)
}

pub fn compile_and_write(ast, out_path) {
  let out = compile(ast)
  buf.write_to(out, out_path)
}

// typecheck.ta — Self-hosted Hindley-Milner type checker for TinyActor
//
// Inspired by Cora's infer.cora. Pure functional, no mutable state.
//
// Type representation (all types are tagged pairs):
//   ('tvar id)      — type variable (id is an integer)
//   ('base name)    — base type ('int, 'bool, 'string, 'symbol, 'pid)
//   ('arrow A B)    — function type A -> B (curried)
//
// Type scheme (for polymorphism):
//   ('forall (id...) type)  — universally quantified type
//
// Substitution: assoc list [(id . type) ...]
//
// Environment: assoc list [(name . scheme-or-type) ...]
//
// All state (counter, subst, env) is threaded through function parameters.

// ============================================================
// List utilities
// ============================================================

fn assq(key, lst) {
  match lst {
    nil -> nil
    cons(pair, rest) -> {
      if car(pair) == key { pair }
      else { assq(key, rest) }
    }
  }
}

fn extend(env, name, typ) {
  cons(cons(name, typ), env)
}

fn list_member(x, lst) {
  match lst {
    nil -> false
    cons(h, rest) -> {
      if h == x { true }
      else { list_member(x, rest) }
    }
  }
}

fn list_union(a, b) {
  match a {
    nil -> b
    cons(h, rest) -> {
      if list_member(h, b) {
        list_union(rest, b)
      } else {
        cons(h, list_union(rest, b))
      }
    }
  }
}

fn list_diff(a, b) {
  match a {
    nil -> nil
    cons(h, rest) -> {
      if list_member(h, b) {
        list_diff(rest, b)
      } else {
        cons(h, list_diff(rest, b))
      }
    }
  }
}

// ============================================================
// Type constructors
// ============================================================

fn t_int() { cons('base, cons('int, nil)) }
fn t_float() { cons('base, cons('float, nil)) }
fn t_bool() { cons('base, cons('bool, nil)) }
fn t_string() { cons('base, cons('string, nil)) }
fn t_symbol() { cons('base, cons('symbol, nil)) }
fn t_nil() { cons('base, cons('nil, nil)) }
fn t_pair() { cons('base, cons('pair, nil)) }

fn t_base(name) { cons('base, cons(name, nil)) }

fn t_var(id, level) { cons('tvar, cons(id, cons(level, nil))) }

fn t_arrow(from, to) { cons('arrow, cons(from, cons(to, nil))) }

// Type application: ('app Name args) — e.g. List(int), Option('a)
fn t_app(name, args) { cons('app, cons(name, args)) }

// Type scheme: ('forall (id...) type)
fn t_forall(ids, t) { cons('forall, cons(ids, cons(t, nil))) }

// fresh(counter, level) -> (type . new_counter)
fn fresh(counter, level) {
  cons(t_var(counter, level), counter + 1)
}

// ============================================================
// apply_subst: resolve type variables through substitution
// ============================================================

fn apply_subst(t, s) {
  let tag = car(t)
  if tag == 'tvar {
    let binding = subst_lookup(s, car(cdr(t)))
    if null?(binding) {
      t
    } else {
      apply_subst(cdr(binding), s)
    }
  } else {
    if tag == 'base {
      t
    } else {
      if tag == 'arrow {
        let from = car(cdr(t))
        let to = car(cdr(cdr(t)))
        t_arrow(apply_subst(from, s), apply_subst(to, s))
      } else {
        if tag == 'app {
          let name = car(cdr(t))
          let args = cdr(cdr(t))
          t_app(name, apply_subst_list(args, s))
        } else {
          // forall or unknown — leave as-is
          t
        }
      }
    }
  }
}

fn apply_subst_list(ts, s) {
  match ts {
    nil -> nil
    cons(h, rest) -> cons(apply_subst(h, s), apply_subst_list(rest, s))
  }
}

// resolve_head: resolve a type's head through the substitution chain without
// rebuilding the whole tree. Used by unify/occur_check for lazy resolution —
// only the head matters for pattern-matching on the type tag; subtrees get
// resolved on demand when recursing. This avoids O(tree-size) apply_subst
// on every unification (the main typecheck bottleneck).
fn resolve_head(t, s) {
  let tag = car(t)
  if tag == 'tvar {
    let binding = subst_lookup(s, car(cdr(t)))
    if null?(binding) {
      t
    } else {
      resolve_head(cdr(binding), s)
    }
  } else {
    t
  }
}

// ============================================================
// Substitution storage: fixed-size bucket chain
//
// s is a chain of 32 buckets: (b0 . (b1 . ... . (b31 . nil))). Each bucket
// is an assoc list of (key . value); key is a tvar id (int), or 'tc_error
// (symbol, always bucket 0). Lookup is O(32 + S/32) instead of O(S) for a
// flat assoc list — the substitution table only ever grows, so linear
// scans are the dominant cost in long inference runs.
// ============================================================

fn append(a, b) {
  match a {
    nil -> b
    cons(h, rest) -> cons(h, append(rest, b))
  }
}

fn make_buckets(n) {
  if n == 0 { nil }
  else { cons(nil, make_buckets(n - 1)) }
}

fn bucket_ref(s, i) {
  if i == 0 { car(s) }
  else { bucket_ref(cdr(s), i - 1) }
}

fn bucket_set(s, i, new_bucket) {
  if i == 0 {
    cons(new_bucket, cdr(s))
  } else {
    cons(car(s), bucket_set(cdr(s), i - 1, new_bucket))
  }
}

fn bucket_index(key) {
  if int?(key) { key % 32 }
  else { 0 }
}

fn subst_lookup(s, key) {
  let bucket = bucket_ref(s, bucket_index(key))
  assq(key, bucket)
}

fn subst_bind(s, key, val) {
  let i = bucket_index(key)
  let bucket = bucket_ref(s, i)
  bucket_set(s, i, cons(cons(key, val), bucket))
}

// ============================================================
// occur_check: prevent infinite types
// ============================================================

fn occur_check(vid, t, s) {
  let t2 = resolve_head(t, s)
  let tag = car(t2)
  if tag == 'tvar {
    car(cdr(t2)) == vid
  } else {
    if tag == 'base {
      false
    } else {
      if tag == 'arrow {
        // arrow
        if occur_check(vid, car(cdr(t2)), s) {
          true
        } else {
          occur_check(vid, car(cdr(cdr(t2))), s)
        }
      } else {
        if tag == 'app {
          // app: check all args
          occur_check_list(vid, cdr(cdr(t2)), s)
        } else {
          false
        }
      }
    }
  }
}

fn occur_check_list(vid, ts, s) {
  match ts {
    nil -> false
    cons(h, rest) -> {
      if occur_check(vid, h, s) { true }
      else { occur_check_list(vid, rest, s) }
    }
  }
}

// ============================================================
// unify: Robinson unification
//
// unify(t1, t2, s) -> ('succ . new_subst) | ('fail . reason)
// ============================================================

fn unify(x, y, s) {
  let xr = resolve_head(x, s)
  let yr = resolve_head(y, s)
  unify_resolved(xr, yr, s)
}

fn unify_resolved(x, y, s) {
  let xt = car(x)
  let yt = car(y)

  if xt == 'tvar {
    if yt == 'tvar {
      if car(cdr(x)) == car(cdr(y)) {
        cons('succ, s)
      } else {
        cons('succ, subst_bind(s, car(cdr(x)), y))
      }
    } else {
      let xid = car(cdr(x))
      if occur_check(xid, y, s) {
        cons('fail, cons('occur, nil))
      } else {
        cons('succ, subst_bind(s, xid, y))
      }
    }
  } else {
    if yt == 'tvar {
      let yid = car(cdr(y))
      if occur_check(yid, x, s) {
        cons('fail, cons('occur, nil))
      } else {
        cons('succ, subst_bind(s, yid, x))
      }
    } else {
      if xt == 'base {
        if yt == 'base {
          if car(cdr(x)) == car(cdr(y)) {
            cons('succ, s)
          } else {
            cons('fail, cons('mismatch, nil))
          }
        } else {
          cons('fail, cons('mismatch, nil))
        }
      } else {
        if xt == 'arrow {
          if yt == 'arrow {
            let xa = car(cdr(x))
            let xb = car(cdr(cdr(x)))
            let ya = car(cdr(y))
            let yb = car(cdr(cdr(y)))
            let r1 = unify(xa, ya, s)
            if car(r1) == 'succ {
              unify(xb, yb, cdr(r1))
            } else {
              r1
            }
          } else {
            cons('fail, cons('mismatch, nil))
          }
        } else {
          // xt == 'app
          if yt == 'app {
            // same name? unify args
            if car(cdr(x)) == car(cdr(y)) {
              unify_list(cdr(cdr(x)), cdr(cdr(y)), s)
            } else {
              cons('fail, cons('mismatch, nil))
            }
          } else {
            cons('fail, cons('mismatch, nil))
          }
        }
      }
    }
  }
}

fn unify_list(xs, ys, s) {
  match xs {
    nil -> {
      if null?(ys) { cons('succ, s) }
      else { cons('fail, cons('arity, nil)) }
    }
    cons(xh, xrest) -> {
      if null?(ys) { cons('fail, cons('arity, nil)) }
      else {
        let r = unify(xh, car(ys), s)
        if car(r) == 'succ {
          unify_list(xrest, cdr(ys), cdr(r))
        } else {
          r
        }
      }
    }
  }
}

// ============================================================
// unify_check: like unify, but records failures as error markers in s
// Error markers: (tc_error . (t1 . (t2 . (ctx . nil))))
// ctx is a symbol (function name) or nil
// Key 'tc_error is a symbol, never matches tvar ids (integers) in assq
// ============================================================

fn unify_check(t1, t2, s, ctx) {
  let u = unify(t1, t2, s)
  if car(u) == 'succ {
    cdr(u)
  } else {
    // Record the resolved types so error messages show concrete types
    // (e.g. List(string) vs List(int)) instead of unbound tvars.
    // Record the resolved types so error messages show concrete types
    // (e.g. List(string) vs List(int)) instead of unbound tvars.
    let r1 = apply_subst(t1, s)
    let r2 = apply_subst(t2, s)
    subst_bind(s, 'tc_error, cons(r1, cons(r2, cons(ctx, nil))))
  }
}

// ============================================================
// Free type variables
// ============================================================

// free_vars_t(t, s) -> list of free tvar ids in type (after apply_subst)
fn free_vars_t(t, s) {
  let t2 = apply_subst(t, s)
  let tag = car(t2)
  if tag == 'tvar {
    cons(car(cdr(t2)), nil)
  } else {
    if tag == 'base {
      nil
    } else {
      if tag == 'arrow {
        list_union(
        free_vars_t(car(cdr(t2)), s),
        free_vars_t(car(cdr(cdr(t2))), s)
        )
      } else {
        if tag == 'app {
          free_vars_t_list(cdr(cdr(t2)), s)
        } else {
          // forall or unknown
          nil
        }
      }
    }
  }
}

fn free_vars_t_list(ts, s) {
  match ts {
    nil -> nil
    cons(h, rest) -> list_union(free_vars_t(h, s), free_vars_t_list(rest, s))
  }
}

// free_vars_scheme(scheme, s) -> free tvar ids not quantified
fn free_vars_scheme(scheme, s) {
  if car(scheme) == 'forall {
    let quantified = car(cdr(scheme))
    let body = car(cdr(cdr(scheme)))
    list_diff(free_vars_t(body, s), quantified)
  } else {
    // monomorphic — just a type
    free_vars_t(scheme, s)
  }
}

// free_vars_env(env, s) -> free tvar ids across all bindings
fn free_vars_env(env, s) {
  match env {
    nil -> nil
    cons(binding, rest) -> {
      let scheme = cdr(binding)
      list_union(free_vars_scheme(scheme, s), free_vars_env(rest, s))
    }
  }
}

// ============================================================
// Generalize and Instantiate
// ============================================================

// generalize(t, env, s) -> scheme
// Turns free vars in t not free in env into quantified vars.
fn generalize(t, env, s) {
  let t_ftv = free_vars_t(t, s)
  let env_ftv = free_vars_env(env, s)
  let quantified = list_diff(t_ftv, env_ftv)
  if null?(quantified) {
    t
  } else {
    t_forall(quantified, t)
  }
}

// generalize_l(t, level, s) -> scheme
// Level-based generalization: generalize tvars whose level > current level.
// O(T) where T is type size — replaces O(N^3) generalize.
fn generalize_l(t, level, s) {
  let resolved = apply_subst(t, s)
  let quantified = find_generalizable(resolved, level)
  if null?(quantified) {
    resolved
  } else {
    t_forall(quantified, resolved)
  }
}

// find_generalizable(t, level) -> list of tvar ids with level > current level
fn find_generalizable(t, level) {
  let tag = car(t)
  if tag == 'tvar {
    let id = car(cdr(t))
    let tv_level = car(cdr(cdr(t)))
    if tv_level > level {
      cons(id, nil)
    } else {
      nil
    }
  } else {
    if tag == 'arrow {
      list_union(
      find_generalizable(car(cdr(t)), level),
      find_generalizable(car(cdr(cdr(t))), level)
      )
    } else {
      if tag == 'app {
        find_generalizable_list(cdr(cdr(t)), level)
      } else {
        nil
      }
    }
  }
}

fn find_generalizable_list(ts, level) {
  match ts {
    nil -> nil
    cons(h, rest) -> list_union(find_generalizable(h, level), find_generalizable_list(rest, level))
  }
}

// instantiate(scheme, counter, level) -> (resolved_type . new_counter)
// Replaces quantified vars with fresh vars stamped at current level.
fn instantiate(scheme, counter, level) {
  if car(scheme) == 'forall {
    let quantified = car(cdr(scheme))
    let body = car(cdr(cdr(scheme)))
    // inst_walk returns (type . (counter . mapping))
    let result = inst_walk(body, quantified, nil, counter, level)
    let new_type = car(result)
    let new_counter = car(cdr(result))
    cons(new_type, new_counter)
  } else {
    // monomorphic — return as-is
    cons(scheme, counter)
  }
}

// inst_walk(t, quantified, mapping, counter) -> (type . counter)
// mapping: assoc list [(old_id . new_type) ...]
fn inst_walk(t, quantified, mapping, counter, level) {
  let tag = car(t)
  if tag == 'tvar {
    let vid = car(cdr(t))
    if list_member(vid, quantified) {
      // Look up in mapping or create fresh
      let found = assq(vid, mapping)
      if null?(found) {
        let fv = fresh(counter, level)
        let new_t = car(fv)
        let new_c = cdr(fv)
        let new_mapping = cons(cons(vid, new_t), mapping)
        cons(new_t, cons(new_c, new_mapping))
      } else {
        cons(cdr(found), cons(counter, mapping))
      }
    } else {
      cons(t, cons(counter, mapping))
    }
  } else {
    if tag == 'base {
      cons(t, cons(counter, mapping))
    } else {
      if tag == 'arrow {
        // arrow
        let from = car(cdr(t))
        let to = car(cdr(cdr(t)))
        let r1 = inst_walk(from, quantified, mapping, counter, level)
        let new_from = car(r1)
        let c1 = car(cdr(r1))
        let m1 = cdr(cdr(r1))
        let r2 = inst_walk(to, quantified, m1, c1, level)
        let new_to = car(r2)
        let c2 = car(cdr(r2))
        let m2 = cdr(cdr(r2))
        cons(t_arrow(new_from, new_to), cons(c2, m2))
      } else {
        if tag == 'app {
          let name = car(cdr(t))
          let args = cdr(cdr(t))
          let r = inst_walk_list(args, quantified, mapping, counter, level)
          let new_args = car(r)
          let c1 = car(cdr(r))
          let m1 = cdr(cdr(r))
          cons(t_app(name, new_args), cons(c1, m1))
        } else {
          // forall or unknown
          cons(t, cons(counter, mapping))
        }
      }
    }
  }
}

fn inst_walk_list(ts, quantified, mapping, counter, level) {
  match ts {
    nil -> cons(nil, cons(counter, mapping))
    cons(h, rest) -> {
      let r1 = inst_walk(h, quantified, mapping, counter, level)
      let new_h = car(r1)
      let c1 = car(cdr(r1))
      let m1 = cdr(cdr(r1))
      let r2 = inst_walk_list(rest, quantified, m1, c1, level)
      let new_rest = car(r2)
      let c2 = car(cdr(r2))
      let m2 = cdr(cdr(r2))
      cons(cons(new_h, new_rest), cons(c2, m2))
    }
  }
}

// ============================================================
// infer_expr: core type inference
//
// infer_expr(expr, env, s, counter) -> (type . (subst . counter))
// ============================================================

fn is_arith_op(name) {
  if name == '+ { true }
  else {
    if name == '- { true }
    else {
      if name == '* { true }
      else {
        if name == '/ { true }
        else {
          name == '%
        }
      }
    }
  }
}

fn is_cmp_op(name) {
  if name == '< { true }
  else {
    if name == '<= { true }
    else {
      if name == '> { true }
      else {
        name == '>=
      }
    }
  }
}

fn is_eq_op(name) {
  name == '=
}

fn is_ne_op(name) {
  name == '!=
}

fn infer_expr(expr, env, s, counter, level, ctx) {
  // --- Integer literal ---
  if int?(expr) {
    cons(t_int(), cons(s, counter))
  } else {
    // --- nil ---
    if null?(expr) {
      let fv = fresh(counter, level)
      cons(car(fv), cons(s, cdr(fv)))
    } else {
      // --- String literal ---
      if string?(expr) {
        cons(t_string(), cons(s, counter))
      } else {
        // --- Symbol (variable reference) ---
        if symbol?(expr) {
          let binding = assq(expr, env)
          if null?(binding) {
            // Unbound — undefined variable (issue #81). Every let-bound
            // name in the enclosing body is pre-registered in env by
            // collect_let_bindings before inference, so a name missing
            // here has no binding at all (not a param, not a let, not a
            // builtin/outer define). Record a tc_undefined marker with
            // kind 'variable and keep inferring with a fresh tvar so
            // multiple errors surface in one pass.
            let fv = fresh(counter, level)
            let s_err = subst_bind(s, 'tc_undefined, cons(expr, cons(ctx, cons('variable, nil))))
            cons(car(fv), cons(s_err, cdr(fv)))
          } else {
            let scheme = binding_scheme(binding)
            let inst = instantiate(scheme, counter, level)
            cons(car(inst), cons(s, cdr(inst)))
          }
        } else {
          // --- true / false ---
          // (Dispatched AFTER the string?/symbol? predicates: == now unifies
          // operand types, and a string literal would poison the substitution
          // with a bogus string-vs-bool tc_error here. bool is disjoint from
          // int/string/symbol/pair/nil, so reordering is equivalent. false
          // gets its own branch: leaving it to the fallback would type it as
          // a fresh tvar, letting 1 == false slip through the tower.)
          if expr == true {
            cons(t_bool(), cons(s, counter))
          } else {
            if expr == false {
              cons(t_bool(), cons(s, counter))
            } else {
              // --- Non-pair ---
              if pair?(expr) == false {
                let fv = fresh(counter, level)
                cons(car(fv), cons(s, cdr(fv)))
              } else {
                // --- Float literal: ('float "1.5") ---
                // A proper list headed by 'float whose single element is the
                // literal string. The bootstrap language has no float values,
                // so the string travels end-to-end and the VM parses it with
                // strtod. Type: float.
                if car(expr) == 'float {
                  if string?(car(cdr(expr))) {
                    cons(t_float(), cons(s, counter))
                  } else {
                    infer_compound(expr, env, s, counter, level, ctx)
                  }
                } else {
                  // --- Compound form ---
                  infer_compound(expr, env, s, counter, level, ctx)
                }
              }
            }
          }
        }
      }
    }
  }
}

// narrow_var(cond) -> symbol or nil
// If cond is a type predicate (int? v) / (string? v) / (symbol? v) with v a
// symbol, return v so the if-inference can narrow each branch independently.
fn narrow_var(cond) {
  if pair?(cond) {
    let h = car(cond)
    let v = car(cdr(cond))
    if symbol?(v) {
      if h == 'int? {
        v
      } else {
        if h == 'string? {
          v
        } else {
          if h == 'symbol? {
            v
          } else {
            nil
          }
        }
      }
    } else {
      nil
    }
  } else {
    nil
  }
}

// === Compound-form dispatch ===
//
// Each language keyword gets a dedicated inference helper. infer_compound is
// a flat else-if dispatch over the head symbol; every helper returns the
// standard (type . (s . counter)) triple.

// (match scrut (pat body)...) — language keyword. Handled FIRST so
// pattern positions (constructors, _ wildcards, bindings) never fall
// through to the general function-call path.
fn infer_match(rest, env, s, counter, level, ctx) {
  let scrut = car(rest)
  let arms = cdr(rest)
  let r0 = infer_expr(scrut, env, s, counter, level, ctx)
  let scrut_t = car(r0)
  let s0 = car(cdr(r0))
  let c0 = cdr(cdr(r0))
  let ra = infer_match_arms(arms, scrut_t, env, s0, c0, level, ctx)
  // Exhaustiveness check (issue #118): record a compile error when the arms
  // miss an ADT variant. Runs on the post-arms subst so the scrutinee type is
  // fully resolved.
  let s_w = check_exhaustive(scrut_t, arms, env, ctx, car(cdr(ra)))
  let fv = fresh(cdr(cdr(ra)), level)
  cons(car(fv), cons(s_w, cdr(fv)))
}

// (receive arm1 arm2 ...)
fn infer_receive(rest, env, s, counter, level, ctx) {
  let arms = rest
  // scrut_t = nil: a mailbox holds many message types, so there is no
  // single scrutinee type to constrain patterns against (issue #102).
  let ra = infer_match_arms(arms, nil, env, s, counter, level, ctx)
  let fv = fresh(cdr(cdr(ra)), level)
  cons(car(fv), cons(car(cdr(ra)), cdr(fv)))
}

// (quote x)
fn infer_quote(rest, env, s, counter, level, ctx) {
  let quoted = car(rest)
  if symbol?(quoted) {
    let binding = assq(quoted, env)
    if null?(binding) == false {
      if car(cdr(binding)) == 'ctor {
        // Const / nullary ADT constructor reference: uppercase names parse
        // as (quote Name), so the quoted name resolves to the binding's
        // real type (e.g. const MSG = "hi" makes MSG : string, and a nullary
        // variant V : its variant type).
        let inst = instantiate(binding_scheme(binding), counter, level)
        cons(car(inst), cons(s, cdr(inst)))
      } else {
        // Quoted function/variable name used as data: a symbol value.
        // (The old lookup returned the function's type for any bound name,
        // e.g. 'car : pair -> int, which strict == now rejects when the
        // quote is compared with a symbol.)
        cons(t_symbol(), cons(s, counter))
      }
    } else {
      cons(t_symbol(), cons(s, counter))
    }
  } else {
    cons(t_symbol(), cons(s, counter))
  }
}

// (if cond then else?)
fn infer_if(rest, env, s, counter, level, ctx) {
  let cond_e = car(rest)
  let then_e = car(cdr(rest))
  let else_e = car(cdr(cdr(rest)))
  // Infer cond
  let rc = infer_expr(cond_e, env, s, counter, level, ctx)
  let cond_t = car(rc)
  let s1 = car(cdr(rc))
  let c1 = cdr(cdr(rc))
  // Unify cond with bool
  let s2 = unify_check(cond_t, t_bool(), s1, ctx)
  // Type-predicate narrowing: if cond is (int? v) / (string? v) / (symbol? v),
  // give each branch its own fresh tvar for v. This keeps branch-specific
  // constraints (e.g. int ops in the then-branch, string ops in the else)
  // from leaking across branches, supporting dynamic type dispatch.
  let nv = narrow_var(cond_e)
  let tn = if null?(nv) {
    cons(env, c1)
  } else {
    let fv = fresh(c1, level)
    cons(extend(env, nv, car(fv)), cdr(fv))
  }
  let then_env = car(tn)
  let c_then = cdr(tn)
  // Infer then
  let rt = infer_expr(then_e, then_env, s2, c_then, level, ctx)
  let then_t = car(rt)
  let s3 = car(cdr(rt))
  let c2 = cdr(cdr(rt))
  // Infer else (fresh tvar for v too, from the current counter)
  let en = if null?(nv) {
    cons(env, c2)
  } else {
    let fv = fresh(c2, level)
    cons(extend(env, nv, car(fv)), cdr(fv))
  }
  let else_env = car(en)
  let c_else = cdr(en)
  let re = infer_expr(else_e, else_env, s3, c_else, level, ctx)
  let else_t = car(re)
  let s4 = car(cdr(re))
  let c3 = cdr(cdr(re))
  // Unify then with else
  let s5 = unify_check(then_t, else_t, s4, ctx)
  let final_t = apply_subst(then_t, s5)
  cons(final_t, cons(s5, c3))
}

// (let var expr body...)
fn infer_let(rest, env, s, counter, level, ctx) {
  let var_sym = car(rest)
  let val_expr = car(cdr(rest))
  let body = cdr(cdr(rest))
  // Infer value at level + 1
  let rv = infer_expr(val_expr, env, s, counter, level + 1, ctx)
  let val_t = car(rv)
  let s1 = car(cdr(rv))
  let c1 = cdr(cdr(rv))
  // Generalize at current level
  let scheme = generalize_l(val_t, level, s1)
  let new_env = extend(env, var_sym, scheme)
  // Infer body at level + 1
  infer_body(body, new_env, s1, c1, level + 1, ctx)
}

// (let var expr) — a braced-block `let` statement (flat form, no nested
// body). collect_let_bindings pre-registered `var` with a fresh tvar, so
// the rest of the block resolves `var` to that tvar; without binding it
// here the let's real type never reaches later statements, and a misuse
// of `var` unifies the tvar silently — the error site is lost (issue #90).
// Bind the pre-registered tvar to the RHS type through the subst. A var
// already bound (param / outer scope) was skipped by extend_let_env and
// keeps its binding, so there is nothing to bind for it. Plain unify, not
// unify_check: a forward reference before the let may have constrained the
// tvar already, and that case stays type-loose as before.
fn infer_let_stmt(rest, env, s, counter, level, ctx) {
  let var_sym = car(rest)
  let rv = infer_expr(car(cdr(rest)), env, s, counter, level, ctx)
  let val_t = car(rv)
  let s1 = car(cdr(rv))
  let c1 = cdr(cdr(rv))
  let binding = assq(var_sym, env)
  if null?(binding) {
    cons(val_t, cons(s1, c1))
  } else {
    let scheme = binding_scheme(binding)
    if car(scheme) == 'tvar {
      let u = unify(scheme, val_t, s1)
      cons(val_t, cons(cdr(u), c1))
    } else {
      cons(val_t, cons(s1, c1))
    }
  }
}

// (receive-scan (lambda (msg) body))
fn infer_receive_scan(rest, env, s, counter, level, ctx) {
  let lambda_expr = car(rest)
  let r = infer_expr(lambda_expr, env, s, counter, level, ctx)
  let lam_t = car(r)
  let s1 = car(cdr(r))
  let c1 = cdr(cdr(r))
  let resolved = apply_subst(lam_t, s1)
  if car(resolved) == 'arrow {
    let ret_t = car(cdr(cdr(resolved)))
    cons(ret_t, cons(s1, c1))
  } else {
    let fv = fresh(c1, level)
    cons(car(fv), cons(s1, cdr(fv)))
  }
}

// (cons (quote Name) args...): parser emits this for constructor calls.
// Route to the constructor's registered scheme when Name is a known ADT
// constructor (tagged 'ctor); builtins and functions keep cons behavior.
fn infer_ctor_call(expr, head, rest, env, s, counter, level, ctx) {
  let cf = ctor_form(expr)
  if null?(cf) == false {
    let name = car(cf)
    let binding = assq(name, env)
    if null?(binding) == false {
      if car(cdr(binding)) == 'ctor {
        infer_call(name, cdr(cf), env, s, counter, level, ctx)
      } else {
        infer_call(head, rest, env, s, counter, level, ctx)
      }
    } else {
      infer_call(head, rest, env, s, counter, level, ctx)
    }
  } else {
    infer_call(head, rest, env, s, counter, level, ctx)
  }
}

// builtin_arity(sym) -> int: exact argument count for opcodes and C
// builtins, or -1 for symbols with no fixed arity (variadic builtins like
// net.connect/net.read, TA functions, special forms like if/match/let).
//
// Direction B: the typechecker enforces this at compile time. Without it,
// car (forall a b. a -> b) unifies a second argument through a fresh type
// variable — over-application then compiles and corrupts the VM stack at
// runtime (e.g. car(x, x), print(x, y) — print's cfunc takes exactly one
// value).
// Arity here must match the C runtime (src/vm.c opcodes, api.c cfuncs).
fn builtin_arity(sym) {
  if sym == 'car { 1 }
  else if sym == 'cdr { 1 }
  else if sym == 'cons { 2 }
  else if sym == 'print { 1 }
  else if sym == 'null? { 1 }
  else if sym == 'pair? { 1 }
  else if sym == 'int? { 1 }
  else if sym == 'string? { 1 }
  else if sym == 'bytes? { 1 }
  else if sym == 'symbol? { 1 }
  else if sym == 'pid? { 1 }
  else if sym == '+ { 2 }
  else if sym == '- { 2 }
  else if sym == '* { 2 }
  else if sym == '/ { 2 }
  else if sym == '% { 2 }
  else if sym == '= { 2 }
  else if sym == '!= { 2 }
  else if sym == '< { 2 }
  else if sym == '<= { 2 }
  else if sym == '> { 2 }
  else if sym == '>= { 2 }
  else if sym == '== { 2 }
  else if sym == 'spawn { 1 }
  else if sym == 'send { 2 }
  else if sym == 'recv { 0 }
  else if sym == 'recv_after { 1 }
  else if sym == 'self { 0 }
  else if sym == 'monitor { 1 }
  else if sym == 'receive-scan { 1 }
  else if sym == 'recv-commit { 0 }
  else if sym == 'recv-skip { 0 }
  else if sym == 'str_concat { 2 }
  else if sym == 'str.eq { 2 }
  else if sym == 'str.concat { 2 }
  else if sym == 'int.to_float { 1 }
  else if sym == 'float.to_int { 1 }
  else if sym == 'str.length { 1 }
  else if sym == 'str.char_at { 2 }
  else if sym == 'str.substr { 3 }
  else if sym == 'str.to_int { 1 }
  else if sym == 'str.from_int { 1 }
  else if sym == 'str.index_of { 2 }
  else if sym == 'str.to_sym { 1 }
  else if sym == 'str.sym_to_str { 1 }
  else if sym == 'str.chr { 1 }
  else if sym == 'vm.parse_source { 1 }
  else if sym == 'vm.is_builtin_module { 1 }
  else if sym == 'vm.get_arg { 1 }
  else if sym == 'vm.load_bytecode { 1 }
  else if sym == 'vm.time_ms { 0 }
  else if sym == 'vm.time_us { 0 }
  else if sym == 'vm.cfunc_index { 1 }
  else if sym == 'vm.spawn { 1 }
  else if sym == 'vm.load_source { 1 }
  else if sym == 'net.listen { 1 }
  else if sym == 'net.accept { 1 }
  else if sym == 'net.write { 2 }
  else if sym == 'net.close { 1 }
  else if sym == 'file.read { 1 }
  else if sym == 'file.write { 2 }
  else if sym == 'file.exists { 1 }
  else if sym == 'buf.new { 0 }
  else if sym == 'buf.push_byte { 2 }
  else if sym == 'buf.push_int32 { 2 }
  else if sym == 'buf.push_int64 { 2 }
  else if sym == 'buf.push_string { 2 }
  else if sym == 'buf.write_to { 2 }
  else if sym == 'buf.length { 1 }
  else if sym == 'buf.get_byte { 2 }
  else if sym == 'buf.set_byte { 3 }
  else if sym == 'buf.from_file { 1 }
  else { -1 }
}

// arity_error(head, args, env, s, counter, level, ctx) -> nil when the call
// is well-formed, or an error result (type . (s . counter)) when a builtin
// is called with the wrong number of arguments. The error marker is
// recorded in the substitution and inference continues on the args so the
// driver can surface multiple errors at once.
fn arity_error(head, args, env, s, counter, level, ctx) {
  let want = builtin_arity(head)
  if want >= 0 {
    let got = list_length___typecheck(args)
    if got == want {
      nil
    } else {
      let ret_fv = fresh(counter, level)
      let ret_t = car(ret_fv)
      let c1 = cdr(ret_fv)
      let s1 = subst_bind(s, 'tc_arity, cons(head, cons(got, cons(want, cons(ctx, nil)))))
      let ra = infer_args_for_unknown(args, env, s1, c1, level, ctx)
      cons(ret_t, cons(car(cdr(ra)), cdr(cdr(ra))))
    }
  } else {
    nil
  }
}

fn infer_compound(expr, env, s, counter, level, ctx) {
  let head = car(expr)
  let rest = cdr(expr)

  // Direction B: builtin arity is checked before any dispatch so every
  // builtin call — whether it reaches infer_call or an inline-op branch —
  // is guarded. rest is the argument list for every entry in the table
  // (ctor ASTs are (cons (quote P) args): exactly 2; special forms are
  // not in the table).
  let aerr = arity_error(head, rest, env, s, counter, level, ctx)
  if null?(aerr) {
    if head == 'match {
      // (match scrut (pat body)...) — language keyword. Handled FIRST so
      // pattern positions (constructors, _ wildcards, bindings) never fall
      // through to the general function-call path.
      infer_match(rest, env, s, counter, level, ctx)
    } else if head == 'receive {
      infer_receive(rest, env, s, counter, level, ctx)
    } else if head == 'quote {
      // (quote x)
      infer_quote(rest, env, s, counter, level, ctx)
    } else if head == 'if {
      // (if cond then else?)
      infer_if(rest, env, s, counter, level, ctx)
    } else if head == 'lambda {
      // (lambda (params...) body ret_type?) — 4th slot is an optional
      // return-type annotation (nil when absent). The raw annotation from
      // the parser (bare symbol or (Name args)) is converted to the
      // checker's internal type representation before unification.
      let params = car(rest)
      let body = cons(car(cdr(rest)), nil)
      let ret_t = parse_type_annot(car(cdr(cdr(rest))), nil)
      infer_lambda(params, body, env, s, counter, level, ctx, nil, ret_t)
    } else if head == 'let {
      // (let var expr body...) — Lisp-nested form. A braced-block `let`
      // statement parses FLAT ((let x val), body = nil); that shape routes
      // to infer_let_stmt, which binds the pre-registered tvar so the rest
      // of the block sees the let's real type (issue #90).
      if null?(cdr(cdr(rest))) {
        infer_let_stmt(rest, env, s, counter, level, ctx)
      } else {
        infer_let(rest, env, s, counter, level, ctx)
      }
    } else if head == 'begin {
      // (begin e1 e2 ...)
      infer_body(rest, env, s, counter, level, ctx)
    } else if head == 'and {
      // (and e1 e2 ...) / (or e1 e2 ...) — short-circuit logic.
      // Strict Bool: each operand must be Bool and the result is Bool.
      infer_bool_args(rest, env, s, counter, level, ctx)
    } else if head == 'or {
      infer_bool_args(rest, env, s, counter, level, ctx)
    } else if head == 'receive-scan {
      // (receive-scan (lambda (msg) body))
      infer_receive_scan(rest, env, s, counter, level, ctx)
    } else {
      // Inline operators
      if symbol?(head) {
        // Constructor call: parser emits (cons (quote Name) args...).
        // Route to the constructor's registered scheme when Name is a
        // known ADT constructor; otherwise fall through to builtin cons.
        if head == 'cons {
          infer_ctor_call(expr, head, rest, env, s, counter, level, ctx)
        } else if head == 'list {
          // List literal [a, b, c] (parser emits the 'list form).
          // All element types must unify with each other — heterogeneous
          // literals like ["kernfuzz", true] are a compile error (issue
          // #80). Hand-written cons keeps its heterogeneous a -> b -> b
          // pair semantics; only the literal syntax is strict.
          infer_list_literal(rest, env, s, counter, level, ctx)
        } else if head == '% {
          // Modulo is int-only (float % is out of scope).
          infer_arith(rest, env, s, counter, level, ctx)
        } else if is_arith_op(head) {
          // + - * / — int or float (mixed OK), result float if any float.
          infer_num(rest, env, s, counter, level, ctx, false)
        } else if is_cmp_op(head) {
          infer_cmp(rest, env, s, counter, level, ctx)
        } else if is_eq_op(head) {
          infer_eq(rest, env, s, counter, level, ctx)
        } else if is_ne_op(head) {
          infer_ne(rest, env, s, counter, level, ctx)
        } else {
          // General function call
          infer_call(head, rest, env, s, counter, level, ctx)
        }
      } else {
        // Expression-headed call ((f x) y ...) — the callee is itself an
        // expression (chained call, or the use-desugaring output
        // `use x <- e; rest` → (e (lambda (x) rest))): infer the callee's
        // type and unify it against the arrow implied by the argument
        // list, so an int RHS (`use x <- 42`) is rejected at compile time
        // ("cannot unify int with ...") instead of crashing at runtime
        // with cannot-call-non-function.
        let rh = infer_expr(head, env, s, counter, level, ctx)
        let fn_t = car(rh)
        let s_head = car(cdr(rh))
        let c_head = cdr(cdr(rh))
        infer_apply_expr(fn_t, rest, env, s_head, c_head, level, ctx)
      }
    }
  } else {
    aerr
  }
}

// infer_apply_expr(fn_t, args, env, s, counter, level, ctx)
//   -> (type . (s . counter))
// Like infer_apply, but the callee is an arbitrary expression (no symbol
// to name in the error context), so each unification failure is reported
// as a plain cannot-unify at the call site.
fn infer_apply_expr(fn_t, args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(apply_subst(fn_t, s), cons(s, counter))
  } else {
    let ret_fv = fresh(counter, level)
    let ret_t = car(ret_fv)
    let c1 = cdr(ret_fv)
    let arg_fv = fresh(c1, level)
    let arg_t = car(arg_fv)
    let c2 = cdr(arg_fv)
    let arrow = t_arrow(arg_t, ret_t)
    let s1 = unify_check(fn_t, arrow, s, ctx)
    let ra = infer_expr(car(args), env, s1, c2, level, ctx)
    let actual_arg_t = car(ra)
    let s2 = car(cdr(ra))
    let c3 = cdr(cdr(ra))
    let s3 = unify_check(actual_arg_t, arg_t, s2, ctx)
    infer_apply_expr(ret_t, cdr(args), env, s3, c3, level, ctx)
  }
}
// collect_let_bindings(expr) -> list of let-bound symbols
// Collects every (let name val ...) binding name in a body. In braced blocks
// `let` is a statement whose binding extends to the rest of the block, but
// the typechecker's let form assumes Lisp-style nesting (body = remaining
// forms) — pre-registering the names with fresh tvars keeps block-scoped
// let-bound closures (e.g. f1/f2 in gc-closure-churn) from being flagged as
// undefined while staying type-loose, matching the runtime scoping.
fn collect_let_bindings(expr) {
  if pair?(expr) == false { nil }
  else {
    if car(expr) == 'let {
      let rest = cdr(cdr(expr))
      append(cons(car(cdr(expr)), nil), collect_let_bindings_list(rest))
    } else {
      collect_let_bindings_list(expr)
    }
  }
}

fn collect_let_bindings_list(items) {
  if null?(items) { nil }
  else {
    append(collect_let_bindings(car(items)), collect_let_bindings_list(cdr(items)))
  }
}

// extend_let_env(env, names, counter) -> (env . counter)
fn extend_let_env(env, names, counter, level) {
  if null?(names) { cons(env, counter) }
  else {
    // Skip names already bound (params, outer scope, builtins): pre-registering
    // them with a fresh tvar would shadow the real type in the let's own value
    // expression (e.g. fn f(x: string) { let x = x + 1 } must still fail).
    let existing = assq(car(names), env)
    if null?(existing) == false {
      extend_let_env(env, cdr(names), counter, level)
    } else {
      let fv = fresh(counter, level)
      let r = extend_let_env(extend(env, car(names), car(fv)), cdr(names), cdr(fv), level)
      cons(car(r), cdr(r))
    }
  }
}

// infer_lambda(params, body, env, s, counter) -> (type . (s . counter))
// ret_type is the optional return-type annotation (nil when absent); it is
// unified against the inferred body type when present.
fn infer_lambda(params, body, env, s, counter, level, ctx, sig_types, ret_type) {
  if null?(params) {
    // No params — infer body; the closure type is the body type itself
    // (matches no-arg builtins like self/recv). A no-arg call f() then
    // yields the body type instead of an arrow.
    let lb = extend_let_env(env, collect_let_bindings(body), counter, level)
    let rb = infer_body(body, car(lb), s, cdr(lb), level, ctx)
    let body_t = car(rb)
    let s1 = car(cdr(rb))
    let c1 = cdr(cdr(rb))
    let s2 = check_lambda_ret(body_t, ret_type, s1)
    cons(body_t, cons(s2, c1))
  } else {
    let pname = car(params)
    let pnames = cdr(params)
    // Use the annotated param type when a type-sig is available, otherwise
    // create a fresh var for this param
    let fv = if null?(sig_types) {
      fresh(counter, level)
    } else {
      cons(car(sig_types), counter)
    }
    let ptype = car(fv)
    let c1 = cdr(fv)
    let new_env = extend(env, pname, ptype)
    // Recurse for remaining params
    if null?(pnames) {
      // Last param — infer body
      let lb = extend_let_env(new_env, collect_let_bindings(body), c1, level)
      let rb = infer_body(body, car(lb), s, cdr(lb), level, ctx)
      let body_t = car(rb)
      let s1 = car(cdr(rb))
      let c2 = cdr(cdr(rb))
      let s2 = check_lambda_ret(body_t, ret_type, s1)
      cons(t_arrow(ptype, body_t), cons(s2, c2))
    } else {
      // More params — recurse
      let inner = infer_lambda(pnames, body, new_env, s, c1, level, ctx, cdr(sig_types), ret_type)
      let inner_t = car(inner)
      let s1 = car(cdr(inner))
      let c2 = cdr(cdr(inner))
      cons(t_arrow(ptype, inner_t), cons(s1, c2))
    }
  }
}

// check_lambda_ret(body_t, ret_type, s) -> s
// Unify the inferred body type against an explicit return-type annotation
// (ret_type is nil when the lambda has none). A mismatch is recorded in the
// subst as a tc_error, like other unification failures.
fn check_lambda_ret(body_t, ret_type, s) {
  if null?(ret_type) {
    s
  } else {
    unify_check(body_t, ret_type, s, cons(str.to_sym("lambda"), str.to_sym("body does not match return type annotation")))
  }
}

// infer_body(body, env, s, counter) -> (type . (s . counter))
fn infer_body(body, env, s, counter, level, ctx) {
  if null?(body) {
    let fv = fresh(counter, level)
    cons(car(fv), cons(s, cdr(fv)))
  } else {
    if null?(cdr(body)) {
      infer_expr(car(body), env, s, counter, level, ctx)
    } else {
      let r1 = infer_expr(car(body), env, s, counter, level, ctx)
      infer_body(cdr(body), env, car(cdr(r1)), cdr(cdr(r1)), level, ctx)
    }
  }
}

// infer_bool_args(args, env, s, counter) -> (bool . (s . counter))
// Strict Bool operands for 'and / 'or: each operand must unify with Bool.
fn infer_bool_args(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let s2 = unify_check(arg_t, t_bool(), s1, ctx)
    infer_bool_args(cdr(args), env, s2, c1, level, ctx)
  }
}

// infer_arith(args, env, s, counter) -> (int . (s . counter))
// INT-ONLY arithmetic: used for % (modulo). Float operands are rejected
// (float % is out of scope); the float-capable ops (+ - * /) use infer_num.
fn infer_arith(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_int(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let s2 = unify_check(arg_t, t_int(), s1, ctx)
    infer_arith(cdr(args), env, s2, c1, level, ctx)
  }
}

fn infer_num_operand(t, s, ctx) {
  let resolved = apply_subst(t, s)
  if car(resolved) == 'base {
    if car(cdr(resolved)) == 'int || car(cdr(resolved)) == 'float {
      cons(t, s)
    } else {
      let s1 = unify_check(t, t_int(), s, ctx)
      cons(t_int(), s1)
    }
  } else {
    cons(t, s)
  }
}

// infer_num(args, env, s, counter, any_float) -> (int|float . (s . counter))
// STRICT NUMERIC TOWER arithmetic (+ - * /): the first operand's type is
// the reference; every later operand must unify with it — int~int or
// float~float. Mixing (3 + 0.5, 0.5 * 2) is a type error (issue #92).
// Unconstrained tvar operands still bind to whatever the reference is, so
// generic code like `fn add(a, b) { a + b }` stays polymorphic until use.
// `any_float` only matters for the zero-argument case (no reference operand).
fn infer_num(args, env, s, counter, level, ctx, any_float) {
  if null?(args) {
    if any_float { cons(t_float(), cons(s, counter)) }
    else { cons(t_int(), cons(s, counter)) }
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let operand = infer_num_operand(arg_t, s1, ctx)
    infer_num_args(cdr(args), car(operand), env, cdr(operand), c1, level, ctx)
  }
}

// infer_num_args(args, acc_t, env, s, counter, level, ctx)
// Unify each remaining operand against the reference type acc_t. On
// mismatch, report through unify_check (a tc_error is recorded) and keep
// going so multiple errors surface in one pass.
fn infer_num_args(args, acc_t, env, s, counter, level, ctx) {
  if null?(args) {
    cons(acc_t, cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let u = unify(arg_t, acc_t, s1)
    if car(u) == 'succ {
      infer_num_args(cdr(args), acc_t, env, cdr(u), c1, level, ctx)
    } else {
      let s2 = unify_check(arg_t, acc_t, s1, ctx)
      infer_num_args(cdr(args), acc_t, env, s2, c1, level, ctx)
    }
  }
}

// infer_cmp(args, env, s, counter) -> (bool . (s . counter))
// STRICT NUMERIC TOWER comparisons (< <= > >=): the first operand's type is
// the reference; every later operand must unify with it — int~int or
// float~float, mixed (2.5 < 3) is a type error (issue #92). The reference
// type must resolve to a numeric base type; an unconstrained tvar binds to
// int (same "int-first" fallback the rest of the checker uses).
fn infer_cmp(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let r2 = infer_cmp_args(cdr(args), arg_t, env, s1, c1, level, ctx)
    let s2 = car(r2)
    let c2 = cdr(r2)
    // The reference operand must be numeric: int first, then float, else
    // report the error against int (old message).
    let ui = unify(arg_t, t_int(), s2)
    if car(ui) == 'succ {
      cons(t_bool(), cons(cdr(ui), c2))
    } else {
      let uf = unify(arg_t, t_float(), s2)
      if car(uf) == 'succ {
        cons(t_bool(), cons(cdr(uf), c2))
      } else {
        let s3 = unify_check(arg_t, t_int(), s2, ctx)
        cons(t_bool(), cons(s3, c2))
      }
    }
  }
}

fn infer_cmp_args(args, acc_t, env, s, counter, level, ctx) {
  if null?(args) {
    cons(s, counter)
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let u = unify(arg_t, acc_t, s1)
    if car(u) == 'succ {
      infer_cmp_args(cdr(args), acc_t, env, cdr(u), c1, level, ctx)
    } else {
      let s2 = unify_check(arg_t, acc_t, s1, ctx)
      infer_cmp_args(cdr(args), acc_t, env, s2, c1, level, ctx)
    }
  }
}

// t_is_nil(t, s) -> int (0/1): 1 when t resolves to the nil base type.
// Used by the == / != nil-exemption rule (issue #92 keeps nil == nil and
// x == nil legal across all operand types).
fn t_is_nil(t, s) {
  let rt = apply_subst(t, s)
  if car(rt) == 'base {
    if car(cdr(rt)) == 'nil { 1 } else { 0 }
  } else { 0 }
}

// infer_eq(args, env, s, counter) -> (bool . (s . counter))
// Equality (==): all operands must unify to a single type — the declared
// scheme is forall a. a -> a -> bool, and this path now honors it. There is
// NO numeric widening: int == float is rejected like any other cross-type
// comparison (issue #92, superseding the #83 widening rule). One exemption:
// comparing against nil is always accepted (nil == nil, x == nil) — the
// nil-exemption skips unification entirely so it never constrains the other
// operand's type.
fn infer_eq(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    infer_eq_args(cdr(args), arg_t, env, s1, c1, level, ctx)
  }
}

fn infer_eq_args(args, acc_t, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let u = unify(arg_t, acc_t, s1)
    if car(u) == 'succ {
      infer_eq_args(cdr(args), acc_t, env, cdr(u), c1, level, ctx)
    } else {
      // nil exemption: comparing against nil never constrains either side.
      if t_is_nil(arg_t, s1) == 1 {
        infer_eq_args(cdr(args), acc_t, env, s1, c1, level, ctx)
      } else {
        if t_is_nil(acc_t, s1) == 1 {
          infer_eq_args(cdr(args), acc_t, env, s1, c1, level, ctx)
        } else {
          let s2 = unify_check(arg_t, acc_t, s1, ctx)
          infer_eq_args(cdr(args), acc_t, env, s2, c1, level, ctx)
        }
      }
    }
  }
}

// infer_ne(args, env, s, counter) -> (bool . (s . counter))
// Inequality (!=): same operand-unification rule as == (see infer_eq).
fn infer_ne(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    infer_ne_args(cdr(args), arg_t, env, s1, c1, level, ctx)
  }
}

fn infer_ne_args(args, acc_t, env, s, counter, level, ctx) {
  if null?(args) {
    cons(t_bool(), cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    let arg_t = car(r1)
    let s1 = car(cdr(r1))
    let c1 = cdr(cdr(r1))
    let u = unify(arg_t, acc_t, s1)
    if car(u) == 'succ {
      infer_ne_args(cdr(args), acc_t, env, cdr(u), c1, level, ctx)
    } else {
      // nil exemption: comparing against nil never constrains either side.
      if t_is_nil(arg_t, s1) == 1 {
        infer_ne_args(cdr(args), acc_t, env, s1, c1, level, ctx)
      } else {
        if t_is_nil(acc_t, s1) == 1 {
          infer_ne_args(cdr(args), acc_t, env, s1, c1, level, ctx)
        } else {
          let s2 = unify_check(arg_t, acc_t, s1, ctx)
          infer_ne_args(cdr(args), acc_t, env, s2, c1, level, ctx)
        }
      }
    }
  }
}

// infer_call(head, args, env, s, counter) -> (type . (s . counter))
// infer_list_literal(elems, env, s, counter, level, ctx) -> (type . (s . counter))
// Every element type is unified against a single element tvar, so a
// heterogeneous literal like ["kernfuzz", true] fails at compile time
// (issue #80). The literal's own type is a fresh tvar, matching the old
// cons-chain tail behaviour so homogeneous lists and match subjects are
// unaffected. Empty lists [] (the (list) form) carry no constraint.
fn infer_list_literal(elems, env, s, counter, level, ctx) {
  // The literal's type is list(E) where E unifies with every element
  // (issue #102: a bare fresh tvar orphaned the element constraints, so
  // list(list(string)) could slip through a call expecting list(int)).
  let elem_fv = fresh(counter, level)
  let elem_t = car(elem_fv)
  let ru = infer_list_elems(elems, elem_t, env, s, cdr(elem_fv), level, ctx)
  cons(t_app('list, cons(elem_t, nil)), cons(car(ru), cdr(ru)))
}

// infer_list_elems(elems, elem_t, env, s, counter, level, ctx)
// Infer each element and unify it with elem_t (error markers recorded via
// unify_check; inference keeps going so multiple errors surface at once).
fn infer_list_elems(elems, elem_t, env, s, counter, level, ctx) {
  if null?(elems) {
    cons(s, counter)
  } else {
    let r1 = infer_expr(car(elems), env, s, counter, level, ctx)
    let s1 = unify_check(car(r1), elem_t, car(cdr(r1)), ctx)
    infer_list_elems(cdr(elems), elem_t, env, s1, cdr(cdr(r1)), level, ctx)
  }
}

fn infer_call(head, args, env, s, counter, level, ctx) {
  // Look up function type in env
  let binding = assq(head, env)
  if null?(binding) == false {
    let scheme = binding_scheme(binding)
    let inst = instantiate(scheme, counter, level)
    let fn_t = car(inst)
    let c1 = cdr(inst)
    // Apply args one by one
    infer_apply(fn_t, args, env, s, c1, level, ctx, head, 1)
  } else {
    // Not found directly in env. Qualified references (mod.fn) resolve
    // through the module export namespace built at resolve time (issue #96
    // Phase B): pub members are registered under mod.fn, non-pub members
    // under mod$fn — invisible to qualified syntax. The old "strip the
    // module prefix and look up the bare base name" fallback is deleted:
    // a bare name from another module is now undefined, and a qualified
    // miss is reported as an export error.
    let ret_fv = fresh(counter, level)
    let ret_t = car(ret_fv)
    let c1 = cdr(ret_fv)
    let s_name = str.sym_to_str(head)
    let dot = str.index_of(s_name, ".")
    if dot > 0 {
      let mod_name = str.substr(s_name, 0, dot)
      let xname = str.substr(s_name, dot + 1, str.length(s_name) - (dot + 1))
      if vm.is_builtin_module(mod_name) {
        // C builtin module function without an external_fn declaration
        // (e.g. net.read): keep the permissive unknown-call path.
        let ra = infer_args_for_unknown(args, env, s, c1, level, ctx)
        cons(ret_t, cons(car(cdr(ra)), cdr(cdr(ra))))
      } else {
        // TA module: distinguish "exists but is not pub" (registered under
        // mod$xname) from "no such export at all".
        let priv_key = str.to_sym(str.concat(mod_name, str.concat("$", xname)))
        let name_sym = str.to_sym(xname)
        let mod_sym = str.to_sym(mod_name)
        let s_err = if null?(assq(priv_key, env)) {
          subst_bind(s, 'tc_no_export, cons(name_sym, cons(mod_sym, cons(ctx, nil))))
        } else {
          subst_bind(s, 'tc_not_exported, cons(name_sym, cons(mod_sym, cons(ctx, nil))))
        }
        let ra = infer_args_for_unknown(args, env, s_err, c1, level, ctx)
        cons(ret_t, cons(car(cdr(ra)), cdr(cdr(ra))))
      }
    } else {
      let s_err = subst_bind(s, 'tc_undefined, cons(head, cons(ctx, nil)))
      let ra = infer_args_for_unknown(args, env, s_err, c1, level, ctx)
      cons(ret_t, cons(car(cdr(ra)), cdr(cdr(ra))))
    }
  }
}

// infer_args_for_unknown(args, env, s, counter) -> (_ . (s . counter))
fn infer_args_for_unknown(args, env, s, counter, level, ctx) {
  if null?(args) {
    cons(nil, cons(s, counter))
  } else {
    let r1 = infer_expr(car(args), env, s, counter, level, ctx)
    infer_args_for_unknown(cdr(args), env, car(cdr(r1)), cdr(cdr(r1)), level, ctx)
  }
}

// collect_pat_vars(pat) -> list of binding symbols in a match/receive pattern
// Literals (int, string), the wildcard _, boolean symbols, nil, and quoted
// patterns bind nothing; a bare symbol is a binding; a constructor pattern
// (Ctor p1 p2 ...) recurses into its subpatterns.
fn collect_pat_vars(pat) {
  if null?(pat) {
    nil
  } else {
    if pair?(pat) {
      if car(pat) == 'quote {
        nil
      } else {
        append(collect_pat_vars(car(pat)), collect_pat_vars_list(cdr(pat)))
      }
    } else {
      if int?(pat) {
        nil
      } else {
        if string?(pat) {
          nil
        } else {
          if pat == '_ {
            nil
          } else {
            if pat == 'true {
              nil
            } else {
              if pat == 'false {
                nil
              } else {
                cons(pat, nil)
              }
            }
          }
        }
      }
    }
  }
}

fn collect_pat_vars_list(pats) {
  if null?(pats) {
    nil
  } else {
    append(collect_pat_vars(car(pats)), collect_pat_vars_list(cdr(pats)))
  }
}

// infer_match_arms(arms, env, s, counter) -> (_ . (s . counter))
// Infers each match arm's guard (optional) and body. Patterns themselves are
// skipped: they are codegen's concern. Their binding symbols are registered
// in the arm env with fresh tvars (extend_let_env) so guard/body references
// typecheck — they were previously invisible and only passed because unbound
// symbols fell back to a fresh tvar (issue #81 tightened that fallback).
fn infer_match_arms(arms, scrut_t, env, s, counter, level, ctx) {
  if null?(arms) {
    cons(nil, cons(s, counter))
  } else {
    // arm = (pat body) or (pat guard body)
    let arm = car(arms)
    let has_guard = if null?(cdr(cdr(arm))) { 0 } else { 1 }
    let body = if has_guard == 1 { car(cdr(cdr(arm))) } else { car(cdr(arm)) }
    let pe = extend_let_env(env, collect_pat_vars(car(arm)), counter, level)
    let penv = car(pe)
    let pc = cdr(pe)
    // Pattern typing (issue #102): nil and (cons h t) patterns assert the
    // scrutinee is a list. cons ties the scrutinee to list(E) with E also
    // bound to h and list(E) bound to t, so element constraints (e.g.
    // h + 1 forcing int) flow into the scrutinee. receive passes
    // scrut_t = nil and stays type-loose (a mailbox holds many types).
    let rp = infer_list_pat(car(arm), scrut_t, penv, s, pc, level, ctx)
    let s_p = car(rp)
    let c_p = car(cdr(rp))
    let r = if has_guard == 1 {
      let rg = infer_expr(car(cdr(arm)), penv, s_p, c_p, level, ctx)
      infer_expr(body, penv, car(cdr(rg)), cdr(cdr(rg)), level, ctx)
    } else {
      infer_expr(body, penv, s_p, c_p, level, ctx)
    }
    infer_match_arms(cdr(arms), scrut_t, env, car(cdr(r)), cdr(cdr(r)), level, ctx)
  }
}

// infer_list_pat(pat, scrut_t, penv, s, counter, level, ctx) -> s
// nil / (cons h t) patterns constrain the scrutinee to list(E); cons also
// binds the pattern vars: h ~ E, t ~ list(E) (through their pre-registered
// tvars, plain unify so shadowing an already-typed name stays type-loose).
// Other patterns (ADT constructors, literals, wildcards) are unconstrained.
// scrut_t = nil (receive) skips all constraints.
//
// The constraint is applied only when the scrutinee type is an unresolved
// tvar or already a list type. A concrete non-list scrutinee type is a
// weak-typing artifact — hand-built cons cells type as their tail (cons:
// a -> b -> b), e.g. cons(1, 2) : int — and destructuring those with
// cons patterns is a supported feature, so we must not
// reject it for lacking a list type.
// Returns (s . counter) — the counter MUST be threaded: fresh() allocates
// tvar ids, and dropping the advanced counter re-allocates the same id for
// a later variable, aliasing two live vars in the substitution (the cold
// self-host failure of this branch: codegen$sym_count's recursive call
// unified list(E) against E itself, an occurs conflict).
fn infer_list_pat(pat, scrut_t, penv, s, counter, level, ctx) {
  if null?(scrut_t) {
    cons(s, cons(counter, nil))
  } else {
    if pat_list_shape_ok(scrut_t, s) {
      if pat == 'nil {
        let e = fresh(counter, level)
        let s1 = unify_check(scrut_t, t_app('list, cons(car(e), nil)), s, ctx)
        cons(s1, cons(cdr(e), nil))
      } else {
        if pair?(pat) == true {
          if car(pat) == 'cons {
            // Desugared constructor chain (cons (quote Name) ...): the
            // quoted tag up front marks an ADT constructor pattern, not a
            // builtin pair destructure — stay unconstrained (the ctor's own
            // type comes from the value expression / annotation, exactly as
            // bare-head ctor patterns did before the desugar).
            let e1 = car(cdr(pat))
            let is_ctor_chain = if pair?(e1) {
              if car(e1) == 'quote { 1 } else { 0 }
            } else {
              0
            }
            if is_ctor_chain == 1 {
              cons(s, cons(counter, nil))
            } else {
              let ef = fresh(counter, level)
              let elem_t = car(ef)
              let c1 = cdr(ef)
              let s1 = unify_check(scrut_t, t_app('list, cons(elem_t, nil)), s, ctx)
              let s2 = bind_pat_var(car(cdr(pat)), elem_t, penv, s1)
              let tail_t = t_app('list, cons(elem_t, nil))
              let s3 = bind_pat_var(car(cdr(cdr(pat))), tail_t, penv, s2)
              cons(s3, cons(c1, nil))
            }
          } else {
            cons(s, cons(counter, nil))
          }
        } else {
          cons(s, cons(counter, nil))
        }
      }
    } else {
      cons(s, cons(counter, nil))
    }
  }
}

// pat_list_shape_ok(t): the pattern constraint applies when t is an
// unresolved tvar (refine it to list(E)) or already a list type. Anything
// else (int/string/bool/pid/symbol/arrow from the loose cons semantics) is
// left alone — see the weak-typing note above.
fn pat_list_shape_ok(t, s) {
  let t2 = apply_subst(t, s)
  let tag = car(t2)
  if tag == 'tvar {
    true
  } else {
    if tag == 'app {
      car(cdr(t2)) == 'list
    } else {
      false
    }
  }
}

// bind_pat_var(name, t, penv, s) -> s
// Constrain a pattern-bound name's pre-registered tvar to type t. Plain
// unify: an unbound tvar binds (the normal case); a name that shadows an
// already-typed binding stays type-loose.
fn bind_pat_var(name, t, penv, s) {
  if name == '_ {
    s
  } else {
    let binding = assq(name, penv)
    if null?(binding) {
      s
    } else {
      let u = unify(binding_scheme(binding), t, s)
      if car(u) == 'succ {
        cdr(u)
      } else {
        s
      }
    }
  }
}

// infer_apply(fn_t, args, env, s, counter, level, ctx, head, idx) -> (type . (s . counter))
// Unifies fn_t with arrow types for each argument. Failures are tagged with
// the argument position (ctx becomes (fn_name . "arg N of name")) so the
// driver can report which argument of which call was wrong.
fn infer_apply(fn_t, args, env, s, counter, level, ctx, head, idx) {
  if null?(args) {
    cons(apply_subst(fn_t, s), cons(s, counter))
  } else {
    // Fresh var for result
    let ret_fv = fresh(counter, level)
    let ret_t = car(ret_fv)
    let c1 = cdr(ret_fv)
    // Create arrow type: arg_type -> ret_t
    let arg_fv = fresh(c1, level)
    let arg_t = car(arg_fv)
    let c2 = cdr(arg_fv)
    let arrow = t_arrow(arg_t, ret_t)
    // Tag this failure with the argument position
    let detail = str.concat("arg ", str.concat(str.from_int(idx), str.concat(" of ", str.sym_to_str(head))))
    let ctx2 = cons(ctx, str.to_sym(detail))
    // Unify fn_t with arrow
    let s1 = unify_check(fn_t, arrow, s, ctx2)
    // Infer actual argument, unify with arg_t
    let ra = infer_expr(car(args), env, s1, c2, level, ctx2)
    let actual_arg_t = car(ra)
    let s2 = car(cdr(ra))
    let c3 = cdr(cdr(ra))
    let s3 = unify_check(actual_arg_t, arg_t, s2, ctx2)
    // Recurse with remaining args
    infer_apply(ret_t, cdr(args), env, s3, c3, level, ctx, head, idx + 1)
  }
}

// ============================================================
// Program-level inference
// ============================================================

fn list_ref___typecheck(lst, n) {
  if null?(lst) { nil }
  else { if n <= 0 { car(lst) } else { list_ref___typecheck(cdr(lst), n - 1) } }
}

// make_fresh_tvars(fields, counter) -> (tvar_list . new_counter)
fn make_fresh_tvars(fields, counter) {
  match fields {
    nil -> cons(nil, counter)
    cons(f, rest) -> {
      let fv = fresh(counter, 0)
      let rp = make_fresh_tvars(rest, cdr(fv))
      cons(cons(car(fv), car(rp)), cdr(rp))
    }
  }
}

// tvar_ids(tvars) -> list of ids
fn tvar_ids(tvars) {
  match tvars {
    nil -> nil
    cons(tv, rest) -> cons(car(cdr(tv)), tvar_ids(rest))
  }
}

// build_ctor_arrow(fields, result) -> curried arrow type ending in result
fn build_ctor_arrow(fields, result) {
  match fields {
    nil -> result
    cons(f, rest) -> t_arrow(f, build_ctor_arrow(rest, result))
  }
}

// build_param_map(params, counter) -> (param_map . new_counter)
// param_map is a list of (param_sym . tvar_type) in source order
fn build_param_map(params, counter) {
  match params {
    nil -> cons(nil, counter)
    cons(p, rest) -> {
      let fv = fresh(counter, 0)
      let rp = build_param_map(rest, cdr(fv))
      cons(cons(cons(p, car(fv)), car(rp)), cdr(rp))
    }
  }
}

// param_map_tvars(param_map) -> list of tvar types
fn param_map_tvars(param_map) {
  match param_map {
    nil -> nil
    cons(binding, rest) -> cons(cdr(binding), param_map_tvars(rest))
  }
}

// param_map_ids(param_map) -> list of tvar ids
fn param_map_ids(param_map) {
  match param_map {
    nil -> nil
    cons(binding, rest) -> cons(car(cdr(cdr(binding))), param_map_ids(rest))
  }
}

// resolve_field_list(fields, param_map) -> list of types
fn resolve_field_list(fields, param_map) {
  match fields {
    nil -> nil
    cons(f, rest) -> cons(resolve_field_type(f, param_map), resolve_field_list(rest, param_map))
  }
}

// chain_to_list(chain) -> (a b c ...)
// Convert a parser-built cons chain (cons a (cons b (cons c ()))) back to a
// plain list. Only (cons X REST) nodes are unfolded; X is kept as an element
// even when it is itself a list (e.g. (quote Nil) as a ctor argument).
fn chain_to_list(chain) {
  if null?(chain) {
    nil
  } else {
    if pair?(chain) {
      if car(chain) == 'cons {
        cons(car(cdr(chain)), chain_to_list(car(cdr(cdr(chain)))))
      } else {
        nil
      }
    } else {
      nil
    }
  }
}

// ctor_form(expr) -> (Name . (arg1 arg2 ...)) or nil
// The parser emits constructor calls/type applications as
// (cons (quote Name) (cons arg1 (cons arg2 ... ()))). Recover the plain
// (Name arg1 arg2 ...) form so ADT constructors can be typed against their
// registered scheme. Returns nil when expr is not such a form.
fn ctor_form(expr) {
  if pair?(expr) {
    let h = car(expr)
    if h == 'cons {
      let arg1 = car(cdr(expr))
      if pair?(arg1) {
        if car(arg1) == 'quote {
          let name = car(cdr(arg1))
          let chain = car(cdr(cdr(expr)))
          // Only a proper ctor argument list (nil or cons-chain) is valid;
          // otherwise (cons (quote Name) <atom-or-pair>) is not a ctor call
          // and must not be mis-routed to ctor typing.
          if null?(chain) {
            cons(name, nil)
          } else {
            if pair?(chain) {
              // must be a parser-built cons-chain: (cons X (cons Y ... ()))
              if car(chain) == 'cons {
                cons(name, chain_to_list(chain))
              } else {
                nil
              }
            } else {
              nil
            }
          }
        } else {
          nil
        }
      } else {
        nil
      }
    } else {
      nil
    }
  } else {
    nil
  }
}

// binding_scheme(binding) -> scheme
// Ctor env entries are tagged ('ctor . scheme) so the expression-level
// ctor-call routing (infer_compound) can distinguish ADT constructors from
// builtins/functions. Strip the tag when the scheme is consumed.
fn binding_scheme(binding) {
  if car(cdr(binding)) == 'ctor {
    cdr(cdr(binding))
  } else {
    cdr(binding)
  }
}

// poly_field_map(fields, param_map, counter, acc_map, acc_ids)
//   -> (extended_param_map . counter . implicit_ids)
// Bare lowercase field names that are neither declared type params nor
// builtin base types are implicit polymorphic fields (e.g. Add(a, b)).
// Lift each unique name to a fresh tvar — like a type param — so every
// construction of the variant may carry values of any type.
fn poly_field_map(fields, param_map, counter, acc_map, acc_ids) {
  match fields {
    nil -> cons(acc_map, cons(counter, acc_ids))
    cons(f, rest) -> {
      if symbol?(f) {
        let found = assq(f, param_map)
        if null?(found) == false {
          poly_field_map(rest, param_map, counter, acc_map, acc_ids)
        } else {
          if f == 'int {
            poly_field_map(rest, param_map, counter, acc_map, acc_ids)
          } else {
            if f == 'string {
              poly_field_map(rest, param_map, counter, acc_map, acc_ids)
            } else {
              if f == 'bool {
                poly_field_map(rest, param_map, counter, acc_map, acc_ids)
              } else {
                if f == 'symbol {
                  poly_field_map(rest, param_map, counter, acc_map, acc_ids)
                } else {
                  if f == 'pid {
                    poly_field_map(rest, param_map, counter, acc_map, acc_ids)
                  } else {
                    if f == 'Pid {
                      poly_field_map(rest, param_map, counter, acc_map, acc_ids)
                    } else {
                      let in_acc = assq(f, acc_map)
                      if null?(in_acc) == false {
                        poly_field_map(rest, param_map, counter, acc_map, acc_ids)
                      } else {
                        let fv = fresh(counter, 0)
                        let new_t = car(fv)
                        let c1 = cdr(fv)
                        let new_map = cons(cons(f, new_t), acc_map)
                        let new_ids = cons(car(cdr(new_t)), acc_ids)
                        poly_field_map(rest, param_map, c1, new_map, new_ids)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else {
        poly_field_map(rest, param_map, counter, acc_map, acc_ids)
      }
    }
  }
}

// resolve_field_type(field, param_map) -> type
// field is a symbol (type param or base type) or a pair (Name args...) -> t_app
fn resolve_field_type(field, param_map) {
  if symbol?(field) {
    let found = assq(field, param_map)
    if null?(found) == false {
      cdr(found)
    } else {
      if field == 'int { t_int() }
      else {
        if field == 'string { t_string() }
        else {
          if field == 'bool { t_bool() }
          else {
            if field == 'pid { t_pid() }
            else {
              if field == 'Pid { t_pid() }
              else { t_base(field) }
            }
          }
        }
      }
    }
  } else {
    // Field is either a plain type application (Name arg1 ...), a
    // parser-built cons chain (cons (quote Name) (cons arg1 ...)), or a
    // by-name reference to a non-generic ADT ((quote Name)).
    let cf = ctor_form(field)
    if null?(cf) == false {
      let name = car(cf)
      let args = resolve_field_list(cdr(cf), param_map)
      t_app(name, args)
    } else {
      if car(field) == 'quote {
        let nm = car(cdr(field))
        if nm == 'Pid { t_pid() } else { t_base(nm) }
      } else {
        let name = car(field)
        let args = resolve_field_list(cdr(field), param_map)
        t_app(name, args)
      }
    }
  }
}

// collect_variants(variants, type_name, type_params, env, counter) -> (env . counter)
fn collect_variants(variants, type_name, type_params, env, counter) {
  let pmr = build_param_map(type_params, counter)
  let param_map = car(pmr)
  let c0 = cdr(pmr)
  let result_t = if null?(type_params) {
    t_base(type_name)
  } else {
    t_app(type_name, param_map_tvars(param_map))
  }
  let quantified_ids = param_map_ids(param_map)
  collect_variants_loop(variants, type_name, result_t, quantified_ids, param_map, env, c0)
}

fn collect_variants_loop(variants, type_name, result_t, quantified_ids, param_map, env, counter) {
  match variants {
    nil -> cons(env, counter)
    cons(variant, rest) -> {
      let vhead = car(variant)
      if vhead == 'quote {
        // nullary: (quote V)
        let vname = car(cdr(variant))
        let scheme = if null?(quantified_ids) { result_t } else { t_forall(quantified_ids, result_t) }
        let env2 = extend(env, vname, cons('ctor, scheme))
        collect_variants_loop(rest, type_name, result_t, quantified_ids, param_map, env2, counter)
      } else {
        // n-ary: (Ctor f1 f2 ...)
        let ctor_name = vhead
        let fields = cdr(variant)
        // Lift bare lowercase fields to implicit polymorphic params
        // (e.g. Add(a, b)), quantified per construction. Start from the
        // declared param_map so type params stay resolvable.
        let pr = poly_field_map(fields, param_map, counter, param_map, nil)
        let pm2 = car(pr)
        let c1 = car(cdr(pr))
        let imp_ids = cdr(cdr(pr))
        let resolved_fields = resolve_field_list(fields, pm2)
        let arrow_t = build_ctor_arrow(resolved_fields, result_t)
        let scheme_ids = append(quantified_ids, imp_ids)
        let scheme = if null?(scheme_ids) { arrow_t } else { t_forall(scheme_ids, arrow_t) }
        let env2 = extend(env, ctor_name, cons('ctor, scheme))
        collect_variants_loop(rest, type_name, result_t, quantified_ids, param_map, env2, c1)
      }
    }
  }
}

// collect_type_decls(forms, env, counter) -> (env . counter)
// Pass 0: register ADT constructors so they can be used before definition order.
fn collect_type_decls(forms, env, counter) {
  match forms {
    nil -> cons(env, counter)
    cons(form, rest) -> {
      if pair?(form) == false {
        collect_type_decls(rest, env, counter)
      } else {
        let head = car(form)
        if head == 'type {
          let type_name = list_ref___typecheck(form, 1)
          let type_params = list_ref___typecheck(form, 2)
          let variants = cdr(cdr(cdr(form)))
          let pr = collect_variants(variants, type_name, type_params, env, counter)
          // Also register the type name → variant list so match
          // exhaustiveness checking (issue #118) can find the variants of
          // a scrutinee's ADT.
          let env_types = extend(car(pr), type_name, cons('typedecl, variant_names(variants)))
          collect_type_decls(rest, env_types, cdr(pr))
        } else {
          collect_type_decls(rest, env, counter)
        }
      }
    }
  }
}

// === Exhaustiveness checking (issue #118) ===
//
// A match over a known ADT must cover every variant, or contain a
// wildcard/binding arm. Missing variants are recorded as 'tc_nonexh error
// entries in the subst — compilation is rejected (Gleam semantics, #118).

// variant_names(variants) -> list of constructor name symbols
// Each variant is (quote V) for nullary or (Ctor f1 f2 ...) for n-ary.
fn variant_names(variants) {
  if null?(variants) {
    nil
  } else {
    let vhead = car(car(variants))
    let name = if vhead == 'quote { car(cdr(car(variants))) } else { vhead }
    cons(name, variant_names(cdr(variants)))
  }
}

// is_uppercase_sym(s) -> 1 if the first char is an uppercase letter
// (ASCII 65..90; 'A would parse as a quoted ADT constructor symbol)
fn is_uppercase_sym(s) {
  let name = str.sym_to_str(s)
  let c = str.char_at(name, 0)
  if c >= 65 { if c <= 90 { 1 } else { 0 } } else { 0 }
}

// match_arm_ctor(pat) -> 'covered | 'none | ctor-name-symbol
//   'covered: wildcard `_` or lowercase binding — the match is exhaustive
//   'none:    pattern covering no ADT variant (literal, nil, list/cons)
//   symbol:   the arm pattern's top-level ADT constructor
fn match_arm_ctor(pat) {
  if pair?(pat) {
    if car(pat) == 'quote {
      car(cdr(pat))
    } else {
      // Desugared constructor pattern: a cons chain whose first element is
      // the (quote Name) tag — (cons (quote Name) p1 ... nil), the same
      // encoding as a bracket pattern with a constructor literal up front.
      if car(pat) == 'cons {
        let e1 = car(cdr(pat))
        if pair?(e1) {
          if car(e1) == 'quote { car(cdr(e1)) } else { 'none }
        } else {
          'none
        }
      } else {
        if symbol?(car(pat)) {
          if is_uppercase_sym(car(pat)) == 1 { car(pat) } else { 'covered }
        } else {
          'none
        }
      }
    }
  } else {
    if symbol?(pat) { 'covered } else { 'none }
  }
}

// arm_ctors(arms) -> 'covered if any arm is a wildcard/binding,
// otherwise the list of top-level constructors used across the arms.
// Arms are (pat body) or (pat guard body); car(arm) is the pattern.
fn arm_ctors(arms) {
  if null?(arms) {
    nil
  } else {
    let c = match_arm_ctor(car(car(arms)))
    if c == 'covered {
      'covered
    } else {
      let rest = arm_ctors(cdr(arms))
      if rest == 'covered {
        'covered
      } else {
        if c == 'none { rest } else { cons(c, rest) }
      }
    }
  }
}

// ctor_result_name(scheme) -> the result type's name symbol from a
// constructor binding scheme (unwrap forall / arrow), or nil.
fn ctor_result_name(scheme) {
  let t = if car(scheme) == 'forall { car(cdr(cdr(scheme))) } else { scheme }
  ctor_result_name_walk(t)
}

fn ctor_result_name_walk(t) {
  let tag = car(t)
  if tag == 'arrow {
    ctor_result_name_walk(car(cdr(cdr(t))))
  } else {
    if tag == 'base { car(cdr(t)) } else {
      if tag == 'app { car(cdr(t)) } else { nil }
    }
  }
}

// adt_name_from_arms(arms, env) -> ADT type name symbol or nil.
// Fallback for an unresolved-tvar scrutinee: constructor patterns still
// identify the ADT — look up the first ctor pattern's registered scheme.
fn adt_name_from_arms(arms, env) {
  if null?(arms) {
    nil
  } else {
    let c = match_arm_ctor(car(car(arms)))
    if c == 'covered {
      nil
    } else {
      if c == 'none {
        adt_name_from_arms(cdr(arms), env)
      } else {
        let binding = assq(c, env)
        if null?(binding) {
          adt_name_from_arms(cdr(arms), env)
        } else {
          if car(cdr(binding)) == 'ctor {
            let nm = ctor_result_name(binding_scheme(binding))
            if null?(nm) { adt_name_from_arms(cdr(arms), env) } else { nm }
          } else {
            adt_name_from_arms(cdr(arms), env)
          }
        }
      }
    }
  }
}

// sym_in_list(x, lst) -> 1 if x occurs in lst
fn sym_in_list___typecheck(x, lst) {
  if null?(lst) {
    0
  } else {
    if car(lst) == x { 1 } else { sym_in_list___typecheck(x, cdr(lst)) }
  }
}

// missing_variants(variants, used) -> declared variants absent from used
fn missing_variants(variants, used) {
  if null?(variants) {
    nil
  } else {
    if sym_in_list___typecheck(car(variants), used) == 1 {
      missing_variants(cdr(variants), used)
    } else {
      cons(car(variants), missing_variants(cdr(variants), used))
    }
  }
}

// check_exhaustive(scrut_t, arms, env, ctx, s) -> s
// If the match's ADT is known (from the resolved scrutinee type, or from
// the arm constructor patterns when the scrutinee is an unresolved tvar)
// and the arms are not wildcard-covered, record missing variants as a
// 'tc_nonexh error entry in the subst.
fn check_exhaustive(scrut_t, arms, env, ctx, s) {
  let resolved = apply_subst(scrut_t, s)
  let scrut_name = if pair?(resolved) == false {
    nil
  } else {
    let tag = car(resolved)
    if tag == 'base { car(cdr(resolved)) } else {
      if tag == 'app { car(cdr(resolved)) } else { nil }
    }
  }
  let tname = if null?(scrut_name) { adt_name_from_arms(arms, env) } else { scrut_name }
  if null?(tname) {
    s
  } else {
    let binding = assq(tname, env)
    if null?(binding) == false {
      if car(cdr(binding)) == 'typedecl {
        let cov = arm_ctors(arms)
        if cov == 'covered {
          s
        } else {
          let missing = missing_variants(cdr(cdr(binding)), cov)
          if null?(missing) {
            s
          } else {
            subst_bind(s, 'tc_nonexh, cons(tname, cons(missing, cons(ctx, nil))))
          }
        }
      } else {
        s
      }
    } else {
      s
    }
  }
}

// arrow_params(t) -> list of parameter types of an arrow type
fn arrow_params(t) {
  if car(t) == 'arrow {
    cons(car(cdr(t)), arrow_params(car(cdr(cdr(t)))))
  } else {
    nil
  }
}

// is_lowercase_sym(s) -> 1 if the first char is a lowercase letter
fn is_lowercase_sym(s) {
  let name = str.sym_to_str(s)
  let c = str.char_at(name, 0)
  if c >= 'a' { if c <= 'z' { 1 } else { 0 } } else { 0 }
}

// collect_annot_params(types, acc_map, acc_ids, counter)
//   -> (param_map . (ids . counter))
// Bare lowercase symbols in type annotations that are not builtin base types
// are implicit type parameters (e.g. head(xs: List(a)) -> a). Each unique
// name gets a fresh tvar (level 1, so the function-level generalize at
// level 0 captures it), like a declared type param. Uppercase symbols are
// user-defined type names (concrete), never type params.
fn collect_annot_params(types, acc_map, acc_ids, counter) {
  match types {
    nil -> cons(acc_map, cons(acc_ids, counter))
    cons(t, rest) -> {
      if symbol?(t) {
        if t == 'int {
          collect_annot_params(rest, acc_map, acc_ids, counter)
        } else {
          if t == 'string {
            collect_annot_params(rest, acc_map, acc_ids, counter)
          } else {
            if t == 'bool {
              collect_annot_params(rest, acc_map, acc_ids, counter)
            } else {
              if t == 'symbol {
                collect_annot_params(rest, acc_map, acc_ids, counter)
              } else {
                if t == 'pid {
                  collect_annot_params(rest, acc_map, acc_ids, counter)
                } else {
                  if t == 'Pid {
                    collect_annot_params(rest, acc_map, acc_ids, counter)
                  } else {
                    if t == 'pair {
                      // concrete base type (t_pair), not an implicit type param
                      collect_annot_params(rest, acc_map, acc_ids, counter)
                    } else {
                      if is_lowercase_sym(t) == 1 {
                        // potential type param — register if not seen
                        let found = assq(t, acc_map)
                        if null?(found) == false {
                          collect_annot_params(rest, acc_map, acc_ids, counter)
                        } else {
                          let fv = fresh(counter, 1)
                          let new_t = car(fv)
                          let c1 = cdr(fv)
                          let new_map = cons(cons(t, new_t), acc_map)
                          let new_ids = cons(car(cdr(new_t)), acc_ids)
                          collect_annot_params(rest, new_map, new_ids, c1)
                        }
                      } else {
                        // uppercase symbol: user-defined type name (concrete)
                        collect_annot_params(rest, acc_map, acc_ids, counter)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      } else {
        if pair?(t) {
          // compound type: (Name arg1 ...) or (quote a) — recurse into args
          let sub = collect_annot_params(cdr(t), acc_map, acc_ids, counter)
          let m2 = car(sub)
          let i2 = car(cdr(sub))
          let c2 = cdr(cdr(sub))
          collect_annot_params(rest, m2, i2, c2)
        } else {
          collect_annot_params(rest, acc_map, acc_ids, counter)
        }
      }
    }
  }
}

// parse_type_annot(t, param_map) -> type or nil
// Convert an annotation to internal type representation.
// t is either a symbol (simple type) or a list (Name arg1 ...) for compound
// types. Bare lowercase symbols resolve to type params via param_map.
fn parse_type_annot(t, param_map) {
  if null?(t) { nil }
  else {
    if symbol?(t) {
      let found = assq(t, param_map)
      if null?(found) == false {
        cdr(found)
      } else {
        if t == 'int { t_int() }
        else {
          if t == 'string { t_string() }
          else {
            if t == 'bool { t_bool() }
            else {
              if t == 'pid { t_pid() }
              else {
                if t == 'Pid { t_pid() }
                else { t_base(t) }
              }
            }
          }
        }
      }
    } else {
      if car(t) == 'quote {
        // quoted type param reference: 'a
        parse_type_annot(car(cdr(t)), param_map)
      } else {
        if car(t) == 'arrow {
          // function type annotation: (arrow A B) from parser's a -> b
          t_arrow(parse_type_annot(car(cdr(t)), param_map),
          parse_type_annot(car(cdr(cdr(t))), param_map))
        } else {
          // compound type: (Name arg1 arg2 ...)
          let name = car(t)
          let args = parse_type_annot_list(cdr(t), param_map)
          t_app(name, args)
        }
      }
    }
  }
}

fn parse_type_annot_list(ts, param_map) {
  match ts {
    nil -> nil
    cons(h, rest) -> cons(parse_type_annot(h, param_map), parse_type_annot_list(rest, param_map))
  }
}

// annot_to_type_params(param_types, acc, counter) -> (type . counter)
// Build curried arrow from param type list, threading accumulator (ret type).
fn annot_to_type_params(param_types, acc, counter, param_map) {
  match param_types {
    nil -> cons(acc, counter)
    cons(pt, rest) -> {
      let pr = if null?(pt) {
        fresh(counter, 0)
      } else {
        cons(parse_type_annot(pt, param_map), counter)
      }
      let t = car(pr)
      let c1 = cdr(pr)
      // Recurse into the rest FIRST, then wrap: the first param must be the
      // OUTERMOST arrow (application order) -> t1 -> (t2 -> ret). Forward
      // accumulation reversed heterogeneous multi-param generic sigs.
      let inner = annot_to_type_params(rest, acc, c1, param_map)
      cons(t_arrow(t, car(inner)), cdr(inner))
    }
  }
}

// annot_to_type(param_types, ret_type, counter) -> (type . counter)
// Build arrow type from annotation lists. Bare lowercase symbols appearing
// anywhere in the annotations become implicit type params, quantified as a
// forall scheme (e.g. head(xs: List(a)) -> a  =>  forall a. List(a) -> a).
fn annot_to_type(param_types, ret_type, counter) {
  // collect implicit type params from param types, then from the return type
  let cr1 = collect_annot_params(param_types, nil, nil, counter)
  let pm1 = car(cr1)
  let ids1 = car(cdr(cr1))
  let c1 = cdr(cdr(cr1))
  // ret_type is a single type (symbol or (Name args)), wrap it in a list
  let cr2 = collect_annot_params(cons(ret_type, nil), pm1, ids1, c1)
  let param_map = car(cr2)
  let ids = car(cdr(cr2))
  let c2 = cdr(cdr(cr2))
  let ret_r = if null?(ret_type) {
    fresh(c2, 0)
  } else {
    cons(parse_type_annot(ret_type, param_map), c2)
  }
  let rt = car(ret_r)
  let c0 = cdr(ret_r)
  let at = annot_to_type_params(param_types, rt, c0, param_map)
  let arrow_t = car(at)
  let c3 = cdr(at)
  if null?(ids) {
    cons(arrow_t, c3)
  } else {
    cons(t_forall(ids, arrow_t), c3)
  }
}

// collect_type_sigs(forms, sig_env, counter) -> (sig_env . counter)
// Walk top-level forms for (type-sig name param_types ret_type) and
// (external_fn name param_types ret_type) — both share the same shape
// (name param_types ret_type), so external_fn declarations (C module
// signatures from lib/<mod>.ta) register alongside ordinary annotations.
fn collect_type_sigs(forms, sig_env, counter) {
  match forms {
    nil -> cons(sig_env, counter)
    cons(form, rest) -> {
      if pair?(form) == false {
        collect_type_sigs(rest, sig_env, counter)
      } else {
        let head = car(form)
        if head == 'type-sig {
          let name = list_ref___typecheck(form, 1)
          let param_types = list_ref___typecheck(form, 2)
          let ret_type = list_ref___typecheck(form, 3)
          let at = annot_to_type(param_types, ret_type, counter)
          let annot_t = car(at)
          let c1 = cdr(at)
          let new_sigs = extend(sig_env, name, annot_t)
          collect_type_sigs(rest, new_sigs, c1)
        } else {
          if head == 'external_fn {
            let name = list_ref___typecheck(form, 1)
            let param_types = list_ref___typecheck(form, 2)
            let ret_type = list_ref___typecheck(form, 3)
            let at = annot_to_type(param_types, ret_type, counter)
            let annot_t = car(at)
            let c1 = cdr(at)
            let new_sigs = extend(sig_env, name, annot_t)
            collect_type_sigs(rest, new_sigs, c1)
          } else {
            collect_type_sigs(rest, sig_env, counter)
          }
        }
      }
    }
  }
}

// extend_env_from_sigs(env, sigs) -> env with every sig binding registered.
// external_fn declarations have no define form, so their arrow types must be
// threaded into the env directly for infer_call to find them.
fn extend_env_from_sigs(env, sigs) {
  match sigs {
    nil -> env
    cons(binding, rest) -> {
      extend_env_from_sigs(extend(env, car(binding), cdr(binding)), rest)
    }
  }
}

// collect_defines(forms, env, s, counter, sigs) -> (env . counter)
// Pass 1: register each define with a fresh tvar so recursive calls work.
// If a matching type-sig exists, use the annotated type instead.
fn collect_defines(forms, env, s, counter, sigs) {
  match forms {
    nil -> cons(env, counter)
    cons(form, rest) -> {
      if pair?(form) == false {
        collect_defines(rest, env, s, counter, sigs)
      } else {
        let head = car(form)
        if head == 'define {
          let sig = list_ref___typecheck(form, 1)
          let name = car(sig)
          let sb = assq(name, sigs)
          let fv = if null?(sb) { fresh(counter, 0) } else { cons(cdr(sb), counter) }
          let new_env = extend(env, name, car(fv))
          collect_defines(rest, new_env, s, cdr(fv), sigs)
        } else {
          if head == 'define_pub {
            let sig = list_ref___typecheck(form, 1)
            let name = car(sig)
            let sb = assq(name, sigs)
            let fv = if null?(sb) { fresh(counter, 0) } else { cons(cdr(sb), counter) }
            let new_env = extend(env, name, car(fv))
            collect_defines(rest, new_env, s, cdr(fv), sigs)
          } else {
            if head == 'const {
              // (const NAME expr) — register the name so references resolve
              // through the env during body inference, like a define. The
              // binding is tagged ('ctor . tvar) because uppercase const
              // names parse as (quote Name) symbol literals; infer_quote
              // resolves ctor/const-tagged bindings to their real type.
              let name = car(cdr(form))
              let fv = fresh(counter, 0)
              let new_env = extend(env, name, cons('ctor, car(fv)))
              collect_defines(rest, new_env, s, cdr(fv), sigs)
            } else {
              // skip import, type, type-sig, and other forms
              collect_defines(rest, env, s, counter, sigs)
            }
          }
        }
      }
    }
  }
}

// infer_define(form, env, s, counter) -> (env . (s . counter))
// Infer type for one (define (name params...) body...)
fn infer_define(form, env, s, counter, level) {
  let sig = list_ref___typecheck(form, 1)
  let name = car(sig)
  let params = cdr(sig)
  let body = cdr(cdr(form))
  // Look up pre-registered type
  let binding = assq(name, env)
  let registered_t = binding_scheme(binding)
  // A forall registered type is a generic type-sig: instantiate it and use
  // the annotated param types to drive body inference (e.g. head(xs: List(a))
  // -> a infers xs : List('a) so the body stays polymorphic).
  let sig_r = if car(registered_t) == 'forall {
    instantiate(registered_t, counter, level + 1)
  } else {
    nil
  }
  let counter0 = if null?(sig_r) { counter } else { cdr(sig_r) }
  let sig_types = if null?(sig_r) { nil } else { arrow_params(car(sig_r)) }
  // Infer lambda type at level + 1 (like let-binding). ret_type is nil here:
  // the declared return type is already unified below via the registered
  // signature (unify_check on the whole arrow), so no double check.
  let lam_r = infer_lambda(params, body, env, s, counter0, level + 1, name, sig_types, nil)
  let inferred_t = car(lam_r)
  let s1 = car(cdr(lam_r))
  let c1 = cdr(cdr(lam_r))
  // If registered is already a generalized scheme, this name was defined
  // earlier (e.g. same name in another imported module) — replace it without
  // checking. Only bare tvars (collect_defines placeholders) and type-sig
  // annotations (plain arrow types) get unified against the inferred type.
  let s2 = if car(registered_t) == 'forall {
    // Standard HM check: the body must satisfy the declared forall signature.
    // Unify the inferred lambda type against an instantiation of the scheme
    // (e.g. head(xs: List(a)) -> a with a Nil -> 0 body resolves to
    // List(int) -> int — the Nil branch pins the param — instead of silently
    // accepting an incompatible body).
    let sig_ctx = cons(name, str.to_sym("body does not match declared signature"))
    unify_check(inferred_t, car(sig_r), s1, sig_ctx)
  } else {
    // Unify inferred with registered
    unify_check(inferred_t, registered_t, s1, name)
  }
  // Resolve type through substitution
  let resolved_t = apply_subst(inferred_t, s2)
  // Generalize
  let scheme = generalize_l(resolved_t, level, s2)
  // Update env: remove old binding, add new
  let env_without = remove_binding(env, name)
  let new_env = extend(env_without, name, scheme)
  cons(new_env, cons(s2, c1))
}

// remove_binding(env, name) -> env without the binding for name
fn remove_binding(env, name) {
  match env {
    nil -> nil
    cons(binding, rest) -> {
      if car(binding) == name {
        rest
      } else {
        cons(binding, remove_binding(rest, name))
      }
    }
  }
}

// infer_defines(forms, env, s, counter) -> (env . (s . counter))
// Pass 2: infer each define in order.
fn infer_defines(forms, env, s, counter, level) {
  match forms {
    nil -> cons(env, cons(s, counter))
    cons(form, rest) -> {
      if pair?(form) == false {
        infer_defines(rest, env, s, counter, level)
      } else {
        let head = car(form)
        if head == 'define {
          let r = infer_define(form, env, s, counter, level)
          let env1 = car(r)
          let s1 = car(cdr(r))
          let c1 = cdr(cdr(r))
          infer_defines(rest, env1, s1, c1, level)
        } else {
          if head == 'define_pub {
            let r = infer_define(form, env, s, counter, level)
            let env1 = car(r)
            let s1 = car(cdr(r))
            let c1 = cdr(cdr(r))
            infer_defines(rest, env1, s1, c1, level)
          } else {
            if head == 'const {
              // (const NAME expr) — infer the value's type, unify against
              // the pass-1 placeholder, generalize, and update the env so
              // later references see the real type (like a toplevel let).
              let name = car(cdr(form))
              let val_expr = car(cdr(cdr(form)))
              let binding = assq(name, env)
              let registered_t = binding_scheme(binding)
              let r = infer_expr(val_expr, env, s, counter, level + 1, name)
              let val_t = car(r)
              let s1 = car(cdr(r))
              let c1 = cdr(cdr(r))
              let s2 = unify_check(val_t, registered_t, s1, name)
              let resolved_t = apply_subst(val_t, s2)
              let scheme = generalize_l(resolved_t, level, s2)
              let env_without = remove_binding(env, name)
              // Keep the 'ctor tag so later (quote Name) references still
              // resolve through infer_quote (see collect_defines).
              let new_env = extend(env_without, name, cons('ctor, scheme))
              infer_defines(rest, new_env, s2, c1, level)
            } else {
              // skip non-define forms
              infer_defines(rest, env, s, counter, level)
            }
          }
        }
      }
    }
  }
}

// make_builtin_env(counter) -> (env . counter)
fn t_pid() { cons('base, cons('pid, nil)) }

fn make_builtin_env(counter) {
  // car: forall(a b, a -> b) — heterogeneous pairs are legal in TA;
  // the element type is unconstrained (matches null?/pair? permissiveness)
  let car_t = t_forall(cons(0, cons(1, nil)), t_arrow(t_var(0, 0), t_var(1, 0)))
  let e1 = extend(nil, 'car, car_t)
  // cdr: forall(a, a -> a)
  let e2 = extend(e1, 'cdr, car_t)
  // cons: forall(a b, a -> b -> b)
  let cons_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_arrow(t_var(1, 0), t_var(1, 0))))
  let e3 = extend(e2, 'cons, cons_t)
  // print: forall(a c, a -> c)
  let print_t = t_forall(cons(0, cons(2, nil)),
  t_arrow(t_var(0, 0), t_var(2, 0)))
  let e4 = extend(e3, 'print, print_t)
  // null?: forall(a, a -> bool)
  let nb_t = t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_bool()))
  let e5 = extend(e4, 'null?, nb_t)
  // pair?: forall(a, a -> bool)
  let e6 = extend(e5, 'pair?, nb_t)
  // int?: forall(a, a -> bool)
  let e7 = extend(e6, 'int?, nb_t)
  // string?: forall(a, a -> bool)
  let e8 = extend(e7, 'string?, nb_t)
  // bytes?: forall(a, a -> bool) — opcode exists (op_is_bytes, codegen +
  // builtin_arity already knew it); it was only missing here, which made
  // `bytes?` E0002 at compile time and the opcode dead from TA source.
  let e8b = extend(e8, 'bytes?, nb_t)
  // pid?: forall(a, a -> bool) — same story as bytes? (op_is_pid)
  let e8c = extend(e8b, 'pid?, nb_t)
  // symbol?: forall(a, a -> bool)
  let e9 = extend(e8c, 'symbol?, nb_t)
  // len removed (D2 #4): was a phantom builtin — typecheck promised it but
  // runtime had no implementation. Users define their own fn len.
  let e10 = e9
  // str_concat: string -> string -> string
  let e11 = extend(e10, 'str_concat,
  t_arrow(t_string(), t_arrow(t_string(), t_string())))
  // list_ref removed (D2 #4): phantom builtin, same story as len.
  // lib/parser.ta already defines list_ref as a plain TA function.
  let e12 = e11
  // spawn: forall(a, a -> pid)
  let spawn_t = t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_pid()))
  let e13 = extend(e12, 'spawn, spawn_t)
  // send: forall(a b, a -> b -> b)
  let send_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_arrow(t_var(1, 0), t_var(1, 0))))
  let e14 = extend(e13, 'send, send_t)
  // recv: forall(a, a)
  let recv_t = t_forall(cons(0, nil), t_var(0, 0))
  let e15 = extend(e14, 'recv, recv_t)
  // self: pid (no-arg C function)
  let e16 = extend(e15, 'self, t_pid())
  // monitor: forall(a b, a -> b)
  let monitor_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_var(0, 0), t_var(1, 0)))
  let e17 = extend(e16, 'monitor, monitor_t)
  // receive-scan: forall(a b, (a -> b) -> b)
  let rs_t = t_forall(cons(0, cons(1, nil)),
  t_arrow(t_arrow(t_var(0, 0), t_var(1, 0)), t_var(1, 0)))
  let e18 = extend(e17, 'receive-scan, rs_t)
  // recv-commit, recv-skip: forall(a, a)
  let e19 = extend(e18, 'recv-commit, recv_t)
  let e20 = extend(e19, 'recv-skip, recv_t)
  // recv-after: forall(a, int -> a) — nil on timeout (issue #33)
  let ra_t = t_forall(cons(0, nil), t_arrow(t_int(), t_var(0, 0)))
  let e20b = extend(e20, 'recv_after, ra_t)
  // str.eq: string -> string -> bool
  let e21 = extend(e20b, 'str.eq,
  t_arrow(t_string(), t_arrow(t_string(), t_bool())))
  // str.concat: string -> string -> string
  let e22 = extend(e21, 'str.concat,
  t_arrow(t_string(), t_arrow(t_string(), t_string())))
  // int.to_float: int -> float  (strict numeric tower, issue #92)
  let e22a = extend(e22, 'int.to_float, t_arrow(t_int(), t_float()))
  // float.to_int: float -> int  (truncates toward zero)
  let e22b = extend(e22a, 'float.to_int, t_arrow(t_float(), t_int()))
  // str.length: string -> int
  let e23 = extend(e22b, 'str.length,
  t_arrow(t_string(), t_int()))
  // str.char_at: string -> int -> int
  let e24 = extend(e23, 'str.char_at,
  t_arrow(t_string(), t_arrow(t_int(), t_int())))
  // str.substr: string -> int -> int -> string
  let e25 = extend(e24, 'str.substr,
  t_arrow(t_string(), t_arrow(t_int(), t_arrow(t_int(), t_string()))))
  // str.to_int: string -> int
  let e26 = extend(e25, 'str.to_int,
  t_arrow(t_string(), t_int()))
  // str.from_int: int -> string
  let e27 = extend(e26, 'str.from_int,
  t_arrow(t_int(), t_string()))
  // str.index_of: string -> string -> int
  let e28 = extend(e27, 'str.index_of,
  t_arrow(t_string(), t_arrow(t_string(), t_int())))
  // str.to_sym: string -> symbol  (C3: was forall(a, string -> a))
  let sts_t = t_arrow(t_string(), t_symbol())
  let e29 = extend(e28, 'str.to_sym, sts_t)
  // str.sym_to_str: symbol -> string  (C3: was forall(a, a -> string))
  let sts2_t = t_arrow(t_symbol(), t_string())
  let e30 = extend(e29, 'str.sym_to_str, sts2_t)
  // vm.parse_source: forall(a, string -> a)
  let vps_t = t_forall(cons(0, nil),
  t_arrow(t_string(), t_var(0, 0)))
  let e30a = extend(e30, 'vm.parse_source, vps_t)
  // vm.is_builtin_module: forall(a, a -> bool)
  let e30b = extend(e30a, 'vm.is_builtin_module, nb_t)
  // vm.get_arg: int -> string
  let ga_t = t_arrow(t_int(), t_string())
  let e30c = extend(e30b, 'vm.get_arg, ga_t)
  // vm.load_bytecode: forall(a, a -> int)
  let lb_t = t_forall(cons(0, nil),
  t_arrow(t_var(0, 0), t_int()))
  let e30d = extend(e30c, 'vm.load_bytecode, lb_t)
  // vm.time_ms: int — no-arg monotonic clock (concrete, semantic binding)
  let e30e = extend(e30d, 'vm.time_ms, t_int())
  // vm.time_us: int — no-arg monotonic µs clock (benchmarking)
  let e30f = extend(e30e, 'vm.time_us, t_int())
  // +, -, *, /: int -> int -> int
  let arith_t = t_arrow(t_int(), t_arrow(t_int(), t_int()))
  let e31 = extend(e30f, '+, arith_t)
  let e32 = extend(e31, '-, arith_t)
  let e33 = extend(e32, '*, arith_t)
  let e34 = extend(e33, '/, arith_t)
  // <, >, <=, >=: int -> int -> bool
  let cmp_t = t_arrow(t_int(), t_arrow(t_int(), t_bool()))
  let e35 = extend(e34, '<, cmp_t)
  let e36 = extend(e35, '>, cmp_t)
  let e37 = extend(e36, '<=, cmp_t)
  let e38 = extend(e37, '>=, cmp_t)
  // ==: forall(a, a -> a -> bool)
  let eq_t = t_forall(cons(0, nil),
  t_arrow(t_var(0, 0), t_arrow(t_var(0, 0), t_bool())))
  let e39 = extend(e38, '==, eq_t)
  // str.chr: int -> string — byte value -> 1-char string (inverse of char_at)
  let e40 = extend(e39, 'str.chr,
  t_arrow(t_int(), t_string()))
  // ============ D/E 反哺：模块函数类型承诺（C 光谱规则落地） ============
  // 原则：语义绑定原语必须带具体类型。历史哨兵（net -1、file.read 失败 nil）
  // 是底层无类型的溢出，类型承诺"成功路径"，TA 侧用 null? 检查失败。
  // net.*（net.read 变参 fd[, max]，豁免——箭头无法表达变参，见 check-modules）
  let e42 = extend(e40, 'net.listen,
  t_arrow(t_int(), t_int()))
  let e43 = extend(e42, 'net.accept,
  t_arrow(t_int(), t_int()))
  // net.connect: string -> int -> a (optional 3rd arg timeout_ms, issue #29).
  // The result is left polymorphic ('a) because the function returns fd (int),
  // nil (in progress) or an error symbol — a union no arrow type can express —
  // and because the optional timeout arg makes the arity variable. Existing
  // 2-arg callers still get a concrete int when they use the result as an fd.
  let e44 = extend(e43, 'net.connect,
  t_forall(cons(0, nil), t_arrow(t_string(), t_arrow(t_int(), t_var(0, 0)))))
  let e45 = extend(e44, 'net.write,
  t_arrow(t_int(), t_arrow(t_string(), t_int())))
  // net.close: 副作用，返回 nil
  let e46 = extend(e45, 'net.close,
  t_arrow(t_int(), t_nil()))
  // file.*
  let e47 = extend(e46, 'file.read,
  t_arrow(t_string(), t_string()))
  let e48 = extend(e47, 'file.write,
  t_arrow(t_string(), t_arrow(t_string(), t_int())))
  let e49 = extend(e48, 'file.exists,
  t_arrow(t_string(), t_int()))
  // buf.* — 全部 int 句柄（无 GC 交互）
  let e50 = extend(e49, 'buf.new, t_int())
  let e51 = extend(e50, 'buf.push_byte,
  t_arrow(t_int(), t_arrow(t_int(), t_int())))
  let e52 = extend(e51, 'buf.push_int32,
  t_arrow(t_int(), t_arrow(t_int(), t_int())))
  let e53 = extend(e52, 'buf.push_int64,
  t_arrow(t_int(), t_arrow(t_int(), t_int())))
  let e54 = extend(e53, 'buf.push_string,
  t_arrow(t_int(), t_arrow(t_string(), t_int())))
  let e55 = extend(e54, 'buf.write_to,
  t_arrow(t_int(), t_arrow(t_string(), t_int())))
  let e56 = extend(e55, 'buf.length,
  t_arrow(t_int(), t_int()))
  let e57 = extend(e56, 'buf.get_byte,
  t_arrow(t_int(), t_arrow(t_int(), t_int())))
  let e58 = extend(e57, 'buf.set_byte,
  t_arrow(t_int(), t_arrow(t_int(), t_arrow(t_int(), t_int()))))
  let e59 = extend(e58, 'buf.from_file,
  t_arrow(t_string(), t_int()))
  // vm.* 公开（内部函数 resolve_imports/make_tok_vec/tok_type/tok_val/
  // free_tok_vec 是编译器专用，豁免注册，见 check-modules）
  let e60 = extend(e59, 'vm.spawn,
  t_arrow(t_int(), t_int()))
  let e61 = extend(e60, 'vm.load_source,
  t_arrow(t_string(), t_nil()))
  // vm.cfunc_index: 接受 symbol 或 string（查询原语，宽松）
  let e62 = extend(e61, 'vm.cfunc_index,
  t_forall(cons(0, nil), t_arrow(t_var(0, 0), t_int())))
  cons(e62, counter)
}

// infer_program(forms) -> (env . (s . counter))
// infer_program(forms) -> (env . (s . counter))
// infer_program_seeded(forms, seed_env) -> (env . (s . counter))
//
// infer_program_seeded pre-loads seed_env bindings (frozen module-export
// schemes reloaded from the signature cache, Phase C issue #99) ahead of
// the builtin env — the same visibility a whole-program typecheck has, so
// cached modules' definitions resolve without re-inferring them. Seed
// schemes must be fully generalized (forall) or concrete: they are
// instantiated on use, never unified against.
// max_int_in(v, acc) — largest int found anywhere inside a value. Used to
// measure seeded signature tvar ids; over-approximating is harmless (the
// counter just starts higher — tvar ids only need to be unique).
fn max_int_in(v, acc) {
  if int?(v) {
    if v > acc { v } else { acc }
  } else {
    if pair?(v) {
      let a = max_int_in(car(v), acc)
      max_int_in(cdr(v), a)
    } else {
      acc
    }
  }
}

// max_seed_int(seed, acc) — max tvar id over all seeded bindings.
fn max_seed_int(seed, acc) {
  if null?(seed) {
    acc
  } else {
    max_seed_int(cdr(seed), max_int_in(cdr(car(seed)), max_int_in(car(car(seed)), acc)))
  }
}

pub fn infer_program_seeded(forms, seed_env) {
  // The seed replays cached signatures with their ORIGINAL tvar ids; those
  // collide with the unit's own fresh ids (which restart near 0). A seeded
  // list(E7) next to the unit's own id-7 aborts the build (issue #102 cold
  // cache). Start the counter above every seeded id instead.
  let counter = max_seed_int(seed_env, -1) + 1
  let s = make_buckets(32)
  let be = make_builtin_env(counter)
  // seeded exports come in front of builtins, exactly like module defines
  // shadow builtins in a whole-program pass
  let env0 = append(seed_env, car(be))
  let c0 = cdr(be)
  // Pass 0: collect type declarations (ADT constructors)
  let ctd = collect_type_decls(forms, env0, c0)
  let env_types = car(ctd)
  let c_types = cdr(ctd)
  // Pass 0.5: collect type-sig annotations + external_fn declarations
  let cts = collect_type_sigs(forms, nil, c_types)
  let sigs = car(cts)
  let c_sigs = cdr(cts)
  // external_fn declarations (C module signatures) have no define form, so
  // register them directly in the env so module calls typecheck strictly.
  // type-sig entries are re-registered (harmlessly) alongside their defines.
  let env_sigs = extend_env_from_sigs(env_types, sigs)
  // Pass 1: collect all defines
  let cd = collect_defines(forms, env_sigs, s, c_sigs, sigs)
  let env1 = car(cd)
  let c1 = cdr(cd)
  // Pass 2: infer each define
  infer_defines(forms, env1, s, c1, 0)
}

pub fn infer_program(forms) {
  infer_program_seeded(forms, nil)
}

// ============================================================
// Type pretty-printing
// ============================================================

// fmt_type_name(name) -> String
// The head of a base/app type is normally a symbol, but a malformed type
// tree can carry garbage there (issue #208: a variant field the parser
// mis-parses as nil manufactures ('app nil), whose head is nil). Error
// formatting must be total — str.sym_to_str on a non-symbol crashes the
// whole compiler and hides the real type errors. Fall back to a raw
// readable marker instead; never swallow, never crash.
fn fmt_type_name(name) {
  if symbol?(name) { str.sym_to_str(name) }
  else {
    if null?(name) { "<?type>" }
    else {
      if int?(name) { str.concat("<?type ", str.concat(str.from_int(name), ">")) }
      else { "<?type>" }
    }
  }
}

// type_format(t, s) -> String
pub fn type_format(t, s) {
  let resolved = apply_subst(t, s)
  type_format_resolved(resolved, nil)
}

// type_format_resolved(t, assigned) -> String
// assigned: assoc list of (tvar_id . letter_string) for renaming
fn type_format_resolved(t, assigned) {
  let tag = car(t)
  if tag == 'base {
    let name = car(cdr(t))
    if name == 'int { "int" }
    else {
      if name == 'string { "string" }
      else {
        if name == 'bool { "bool" }
        else {
          if name == 'symbol { "symbol" }
          else {
            if name == 'pid { "pid" }
            else { fmt_type_name(name) }
          }
        }
      }
    }
  } else {
    if tag == 'tvar {
      let vid = car(cdr(t))
      let found = assq(vid, assigned)
      if null?(found) {
        // Assign next letter: 'a, 'b, ... 'z, then 't0, 't1, ...
        let n = list_length___typecheck(assigned)
        let letter = tvar_letter(n)
        letter
      } else {
        cdr(found)
      }
    } else {
      if tag == 'arrow {
        let from = car(cdr(t))
        let to = car(cdr(cdr(t)))
        // Collect assigned from 'from' first, pass to 'to'
        let from_assigned = collect_tvars(from, assigned)
        let from_str = type_format_resolved(from, assigned)
        let to_str = type_format_resolved(to, from_assigned)
        // Arrow is right-associative: parenthesize 'from' if it's an arrow,
        // but 'to' needs no parens (A -> B -> C means A -> (B -> C))
        let from_tag = car(from)
        let from_wrapped = if from_tag == 'arrow {
          str.concat("(", str.concat(from_str, ")"))
        } else {
          from_str
        }
        str.concat(from_wrapped, str.concat(" -> ", to_str))
      } else {
        if tag == 'app {
          let name = car(cdr(t))
          let args = cdr(cdr(t))
          let name_str = fmt_type_name(name)
          if null?(args) {
            name_str
          } else {
            let args_str = format_type_list(args, assigned)
            str.concat(name_str, str.concat("(", str.concat(args_str, ")")))
          }
        } else {
          if tag == 'forall {
            let body = car(cdr(cdr(t)))
            type_format_resolved(body, assigned)
          } else {
            "?"
          }
        }
      }
    }
  }
}

fn format_type_list(ts, assigned) {
  match ts {
    nil -> ""
    cons(h, nil) -> type_format_resolved(h, assigned)
    cons(h, rest) -> {
      let h_assigned = collect_tvars(h, assigned)
      str.concat(type_format_resolved(h, assigned), str.concat(", ", format_type_list(rest, h_assigned)))
    }
  }
}

// Collect tvar assignments from a type, so sequential formatting is consistent
fn collect_tvars(t, assigned) {
  let tag = car(t)
  if tag == 'tvar {
    let vid = car(cdr(t))
    let found = assq(vid, assigned)
    if null?(found) {
      let n = list_length___typecheck(assigned)
      let letter = tvar_letter(n)
      cons(cons(vid, letter), assigned)
    } else {
      assigned
    }
  } else {
    if tag == 'arrow {
      let a1 = collect_tvars(car(cdr(t)), assigned)
      collect_tvars(car(cdr(cdr(t))), a1)
    } else {
      if tag == 'app {
        collect_tvars_list(cdr(cdr(t)), assigned)
      } else {
        assigned
      }
    }
  }
}

fn collect_tvars_list(ts, assigned) {
  match ts {
    nil -> assigned
    cons(h, rest) -> collect_tvars_list(rest, collect_tvars(h, assigned))
  }
}

// list_length(lst) -> Int
fn list_length___typecheck(lst) {
  if null?(lst) { 0 }
  else { 1 + list_length___typecheck(cdr(lst)) }
}

// ============================================================
// Type error reporting
// ============================================================

// Collect all error markers from the substitution (scan all 32 buckets)
fn collect_errors(s) {
  collect_bucket_errors(s, 0)
}

fn collect_bucket_errors(s, i) {
  if i == 32 { nil }
  else {
    append(collect_errors_in_bucket(car(s)), collect_bucket_errors(cdr(s), i + 1))
  }
}

fn collect_errors_in_bucket(bucket) {
  match bucket {
    nil -> nil
    cons(pair, rest) -> {
      if car(pair) == 'tc_error {
        cons(pair, collect_errors_in_bucket(rest))
      } else {
        if car(pair) == 'tc_undefined {
          cons(pair, collect_errors_in_bucket(rest))
        } else {
          if car(pair) == 'tc_arity {
            cons(pair, collect_errors_in_bucket(rest))
          } else {
            if car(pair) == 'tc_not_exported {
              // Dotted reference to a non-pub member of a TA module
              // (issue #96 Phase B).
              cons(pair, collect_errors_in_bucket(rest))
            } else {
              if car(pair) == 'tc_no_export {
                // Dotted reference to a member a TA module does not have
                // at all (issue #96 Phase B).
                cons(pair, collect_errors_in_bucket(rest))
              } else {
                if car(pair) == 'tc_nonexh {
                  // Non-exhaustive ADT match (issue #118): missing variants
                  cons(pair, collect_errors_in_bucket(rest))
                } else {
                  collect_errors_in_bucket(rest)
                }
              }
            }
          }
        }
      }
    }
  }
}

// Count type errors in a substitution
pub fn count_errors(result) {
  let s = car(cdr(result))
  list_length___typecheck(collect_errors(s))
}

// Format and print type errors
pub fn report_errors(result) {
  let s = car(cdr(result))
  let errors = collect_errors(s)
  match errors {
    nil -> nil
    _ -> {
      print(str.concat("typecheck: ", str.concat(str.from_int(list_length___typecheck(errors)), " type error(s) found")))
      print_error_list(errors)
    }
  }
}

// Return type errors as (kind . (ctx . payload)) tuples so callers can render
// them with extra context (e.g. source line numbers). kind is 'mismatch for
// unify failures (payload = (t1 . (t2 . nil))) or 'undefined for unknown
// function calls (payload = (name . nil)).
pub fn get_errors(result) {
  let s = car(cdr(result))
  let errs = collect_errors(s)
  map_tc_errors(errs)
}

fn map_tc_errors(errors) {
  match errors {
    nil -> nil
    cons(err, rest) -> {
      if car(err) == 'tc_error {
        // err = (tc_error . (t1 . (t2 . (ctx . nil))))
        let t1 = car(cdr(err))
        let t2 = car(cdr(cdr(err)))
        let ctx = car(cdr(cdr(cdr(err))))
        cons(cons('mismatch, cons(ctx, cons(t1, cons(t2, nil)))), map_tc_errors(rest))
      } else {
        if car(err) == 'tc_arity {
          // err = (tc_arity . (name . (got . (want . (ctx . nil)))))
          let name = car(cdr(err))
          let got = car(cdr(cdr(err)))
          let want = car(cdr(cdr(cdr(err))))
          let ctx = car(cdr(cdr(cdr(cdr(err)))))
          cons(cons('arity, cons(ctx, cons(name, cons(got, cons(want, nil))))), map_tc_errors(rest))
        } else {
          if car(err) == 'tc_not_exported {
            // err = (tc_not_exported . (name . (mod . (ctx . nil))))
            let name = car(cdr(err))
            let mod = car(cdr(cdr(err)))
            let ctx = car(cdr(cdr(cdr(err))))
            cons(cons('not-exported, cons(ctx, cons(name, cons(mod, nil)))), map_tc_errors(rest))
          } else {
            if car(err) == 'tc_no_export {
              // err = (tc_no_export . (name . (mod . (ctx . nil))))
              let name = car(cdr(err))
              let mod = car(cdr(cdr(err)))
              let ctx = car(cdr(cdr(cdr(err))))
              cons(cons('no-export, cons(ctx, cons(name, cons(mod, nil)))), map_tc_errors(rest))
            } else {
              if car(err) == 'tc_nonexh {
                // err = (tc_nonexh . (tname . (missing . (ctx . nil))))
                let tname = car(cdr(err))
                let missing = car(cdr(cdr(err)))
                let ctx = car(cdr(cdr(cdr(err))))
                cons(cons('non-exhaustive, cons(ctx, cons(tname, cons(missing, nil)))), map_tc_errors(rest))
              } else {
                // err = (tc_undefined . (name . (ctx . kind))) — kind is 'variable
                // for unbound variable references (issue #81) or nil for unknown
                // function calls.
                let name = car(cdr(err))
                let ctx = car(cdr(cdr(err)))
                let kind = car(cdr(cdr(cdr(err))))
                let out_kind = if kind == 'variable { 'undefined-var } else { 'undefined }
                cons(cons(out_kind, cons(ctx, cons(name, nil))), map_tc_errors(rest))
              }
            }
          }
        }
      }
    }
  }
}

fn print_error_list(errors) {
  match errors {
    nil -> nil
    cons(err, rest) -> {
      if car(err) == 'tc_error {
        // err = (tc_error . (t1 . (t2 . (ctx . nil))))
        let t1 = car(cdr(err))
        let t2 = car(cdr(cdr(err)))
        let ctx = car(cdr(cdr(cdr(err))))
        let msg = str.concat("  [E0001] cannot unify ", str.concat(type_format(t1, nil), str.concat(" with ", type_format(t2, nil))))
        if null?(ctx) {
          print(msg)
        } else {
          print(str.concat("  in function '", str.concat(str.sym_to_str(ctx), str.concat("': ", msg))))
        }
      } else {
        if car(err) == 'tc_arity {
          // err = (tc_arity . (name . (got . (want . (ctx . nil)))))
          let name = car(cdr(err))
          let got = car(cdr(cdr(err)))
          let want = car(cdr(cdr(cdr(err))))
          let ctx = car(cdr(cdr(cdr(cdr(err)))))
          let msg = str.concat("  [E0003] wrong number of arguments for '", str.concat(str.sym_to_str(name), str.concat("' (got ", str.concat(str.from_int(got), str.concat(", want ", str.concat(str.from_int(want), ")"))))))
          if null?(ctx) {
            print(msg)
          } else {
            print(str.concat("  in function '", str.concat(str.sym_to_str(ctx), str.concat("': ", msg))))
          }
        } else {
          if car(err) == 'tc_not_exported {
            let name = car(cdr(err))
            let mod = car(cdr(cdr(err)))
            let ctx = car(cdr(cdr(cdr(err))))
            let msg = str.concat("  [E0004] '", str.concat(str.sym_to_str(name), str.concat("' is not exported by module '", str.concat(str.sym_to_str(mod), "'"))))
            if null?(ctx) {
              print(msg)
            } else {
              print(str.concat("  in function '", str.concat(str.sym_to_str(ctx), str.concat("': ", msg))))
            }
          } else {
            if car(err) == 'tc_no_export {
              let name = car(cdr(err))
              let mod = car(cdr(cdr(err)))
              let ctx = car(cdr(cdr(cdr(err))))
              let msg = str.concat("  [E0004] module '", str.concat(str.sym_to_str(mod), str.concat("' has no export '", str.concat(str.sym_to_str(name), "'"))))
              if null?(ctx) {
                print(msg)
              } else {
                print(str.concat("  in function '", str.concat(str.sym_to_str(ctx), str.concat("': ", msg))))
              }
            } else {
              // err = (tc_undefined . (name . (ctx . kind))) — kind is 'variable
              // for unbound variable references (issue #81) or nil for unknown
              // function calls.
              let name = car(cdr(err))
              let ctx = car(cdr(cdr(err)))
              let kind = car(cdr(cdr(cdr(err))))
              let what = if kind == 'variable { "undefined variable '" } else { "undefined function '" }
              let msg = str.concat("  [E0002] ", str.concat(what, str.concat(str.sym_to_str(name), "'")))
              if null?(ctx) {
                print(msg)
              } else {
                print(str.concat("  in function '", str.concat(str.sym_to_str(ctx), str.concat("': ", msg))))
              }
            }
          }
        }
      }
      print_error_list(rest)
    }
  }
}

// tvar_letter(n) -> String: 0->'a, 1->'b, ..., 25->'z, 26->'t0, etc.
fn tvar_letter(n) {
  if n < 26 {
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let ch = str.substr(letters, n, 1)
    str.concat("'", ch)
  } else {
    str.concat("'t", str.from_int(n - 26))
  }
}

