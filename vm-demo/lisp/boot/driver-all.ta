// expect main: 'b (fresh var, polymorphic result)
fn test_c() {
  print("=== Test C: receive-scan ===")
  let prog = cons(
  cons('define, cons(cons('handler, cons('msg, nil)),
  cons('msg, nil))),
  cons(
  cons('define, cons(cons('main, nil),
  cons(cons('receive-scan,
  cons(cons('lambda, cons(cons('msg, nil),
  cons(cons('handler, cons('msg, nil)), nil))), nil)), nil))),
