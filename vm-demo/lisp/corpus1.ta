// corpus1.ta — 语料扫描的单文件驱动：一次只过一个 .ta，把结论打到 stdout。
//
// 为什么要一文件一进程：编译器里有构造会让 compile 不收敛（见 README「语料
// 覆盖」一节），扫描器本身不能被一个坏文件带走整轮结果。超时判定交给宿主
// 的 run_corpus.sh，TA 这边只管「进得到哪一步」。
//
// 输入：vm-demo/lisp/corpus.one（单行文件名，由 run_corpus.sh 写）
// 输出：<status>\t<detail>   status ∈ ok / reject / tokenize / parse / lower / no-read
//
// test/basic/*-errors.ta 不计入：它们本来就该被拒，lisp 管线拒了也不能说明
// lisp 对——混进分母只会把数字刷好看。

import compile
import file
import list
import lower-ast
import main
import parser
import str
import sexp
import tokenizer

fn run_one(name, path, text) {
  let toks = tokenizer.tokenize(text)
  if int?(toks) {
    line(name, "tokenize" , "")
  } else {
    let ast = parser.parse(toks)
    if int?(ast) {
      line(name, "parse" , "")
    } else {
      let low = lower-ast.lower_program(ast)
      if int?(low) {
        line(name, "lower" , "")
      } else {
                // lib_src 是文本，AST 管线里 parse 回 forms 再前置（同旧 prelude 语义）
        match compile.compile(list.append(sexp.parse(main.lib_src()) , low)) {
          Fail(msg) -> line(name, "reject" , msg)
          Out(fns, consts) -> {
            main.write_bc(str.concat("vm-demo/lisp/corpus/" , str.concat(stem(name) , ".bc")) , fns , consts)
            line(name, "ok" , "")
          }
        }
      }
    }
  }
}

// 串成 if 链而不是早返回：TA 没有 return，每层直接给结果。
fn line(name, status, detail) {
  print(str.concat(name, str.concat("\t", str.concat(status, str.concat("\t", str.concat(detail, "\n"))))))
}

fn stem(name) {
  let n = str.length(name)
  let base = path_basename(name, n - 1)
  str.substr(name, base + 1, n - 3 - (base + 1))
}

// 从右往左找 '/'，返回下标；没有则 -1
fn path_basename(name, i) {
  if i < 0 {
    -1
  } else {
    if str.substr(name, i, 1) == "/" {
      i
    } else {
      path_basename(name, i - 1)
    }
  }
}

fn main() {
  let spec = file.read("vm-demo/lisp/corpus.one")
  if null?(spec) {
    print("ERR\tno-read\tvm-demo/lisp/corpus.one\n")
  } else {
    let name = str.trim(spec)
        let text = file.read(name)
    if null?(text) { line(name , "no-read" , "") } else { run_one(name , "test/basic" , text) }
  }
}