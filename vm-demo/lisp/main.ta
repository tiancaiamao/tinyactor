// main.ta — lisp 编译器驱动：读 .lisp 文本 → sexp.parse → compile → 写 .bc。
//
// 运行（仓库根目录）：
//   ./tinyactor run vm-demo/lisp/main.ta      # 生成 8 个 .bc（打印 8 = 全部成功）
//   ./vm-demo/lisp/lispvm vm-demo/lisp/fib.bc
//
// 端到端管线：foo.lisp --sexp.parse--> 树(pair/symbol/int)
//   --compile.compile--> Out(fns, consts, externs) --write_bc--> foo.bc --lispvm--> 输出
//
// 文件格式（全空白分隔的整数流）：
//   nfns nconsts
//   (nameidx entry nargs maxd codelen code...) × nfns
//     nameidx = 定义名常量池下标（-1 = 匿名：entry / lambda）；2.1 链接用
//     entry = 文件内绝对词下标
//   (kind ...) × nconsts    kind: 0 int val | 1 nil | 2 true | 3 false
//                                 | 4 sym len bytes | 5 str len bytes
// 代码里的跳转目标 = 代码节内词偏移；GLOBAL 操作数 = 常量池符号下标，
// lispvm 加载期按名字解析为 fnid（.o 式链接）；符号 id = 常量池下标（去重保证唯一）。

import compile
import list
import os
import sexp

// ---------- 编译单个 .lisp 文件 ----------
// parse_or_fail 语义（同 json.load）：文件读不到 / parse 硬错误直接退出。
// 实参一律走 let 中转——实参位置调用不构成 GC root，callee 内分配会回收它。
fn build(stem) {
  let src = str.concat("vm-demo/lisp/" , str.concat(stem , ".lisp"))
  let out = str.concat("vm-demo/lisp/" , str.concat(stem , ".bc"))
  let text = file.read(src)
  if null?(text) {
    print(str.concat("main: cannot read " , src))
    os.exit(1)
  }
  let forms = sexp.parse(text)
  if int?(forms) {
    print(str.concat("main: " , str.concat(src , str.concat(": " , sexp.err()))))
    os.exit(1)
  }
  // prelude 前置：extern print/println + null?/not。剥到最小内核时没有链接器，
  // 前置是唯一的「全局可见」手段——形式上就是普通的顶层 extern/def。
  let compiled = compile.compile(list.append(prelude(), forms))
  match compiled {
    // 编译期未定义拦截（2.2）：Fail 带名字列表，前端暴露不留给运行期
    Fail(msg) -> {
      print(str.concat("main: " , str.concat(src , str.concat(": " , msg))))
      os.exit(1)
    }
    Out(fns , consts , externs) -> write_bc(out , fns , consts , externs)
  }
}

// ---------- 写文件 ----------
// 注意：TA 的 [x , rest] 是精确二元模式，单元素列表两臂都不命中、match
// 静默返回 nil——遍历一律用 pair? 循环。
fn write_ints(h , lst) {
  if pair?(lst) {
    buf.push_string(h , str.concat(str.from_int(car(lst)) , " "))
    write_ints(h , cdr(lst))
  } else {
    1
  }
}

fn str_to_bytes(s , i , n) {
  if i >= n {
    []
  } else {
    cons(str.char_at(s , i) , str_to_bytes(s , i + 1 , n))
  }
}

fn const_words(a) {
  if pair?(a) {
    // quoted list 已从 quote 支持中移除；混入到这里的 pair 是编译器 bug 或
    // 误用，故意写 kind -1 让 lispvm 加载期 fatal("bad const kind") 拒绝
    cons(-1 , nil)
  } else {
    if null?(a) {
      // VM 常量 kind 1 = nil，无操作数
      cons(1 , nil)
    } else {
            if symbol?(a) {
        let s = str.sym_to_str(a)
        cons(4 , cons(str.length(s) , str_to_bytes(s , 0 , str.length(s))))
      } else {
        if int?(a) {
          // a 静态 symbol-typed、运行期是 int；list.nth 擦除类型
          let ai = list.nth(cons(a , 0) , 0)
          cons(0 , cons(ai , nil))
        } else {
                    if string?(a) {
            // 字符串常量 VM 侧还没实现（parse_const 只认 kind 0-4）。
            // 显式写 kind -1 让加载期 fatal 拒绝，而不是像旧写法那样
            // 当成 int 写出一个静默错误的值。
            cons(-1 , nil)
          } else {
            // 剩下只可能是 bool。sexp.parse 会把 true/false 直接读成 TA bool，
            // 而 int?/string?/symbol?/null? 都接受 any 参数，逐个排除后即
            // 唯一确定。必须显式区分：若沿用「非 nil 非 symbol 即 int」的旧
            // 写法，true 和 false 都会被擦成 kind 0/int 0，而 int 0 在
            // lispvm 里是 truthy，false 永远为真。
            if a == true { cons(2 , nil) } else { cons(3 , nil) }
          }
        }
      }
    }
  }
}

fn write_consts(h , consts) {
  if pair?(consts) {
    write_ints(h , const_words(car(consts)))
    write_consts(h , cdr(consts))
  } else {
    1
  }
}

// entry = 代码首词的绝对下标；起始 7 = 2(文件头) + 5(首记录头)；
// 每个 fn 贡献 5(头：nameidx entry nargs maxd codelen) + codelen
fn sym_pool_idx(pool , sym , k) {
  if pair?(pool) {
    if car(pool) == sym {
      k
    } else {
      sym_pool_idx(cdr(pool) , sym , k + 1)
    }
  } else {
    -1
  }
}

fn write_fns(h , fns , consts , entry) {
  if pair?(fns) {
    match car(fns) {
      FnBC(name , nargs , maxd , code) -> {
        // nameidx：符号 → 常量池下标；0 = 匿名（entry / lambda）→ -1。
        // loader 建名字→fnid 表，GLOBAL 重定位用（2.1 链接）
        let ni = if symbol?(name) { sym_pool_idx(consts , name , 0) } else { -1 }
        buf.push_string(h , str.concat(str.from_int(ni) , " "))
        buf.push_string(h , str.concat(str.from_int(entry) , " "))
        buf.push_string(h , str.concat(str.from_int(nargs) , " "))
        buf.push_string(h , str.concat(str.from_int(maxd) , " "))
        buf.push_string(h , str.concat(str.from_int(list.length(code)) , " "))
        write_ints(h , code)
        write_fns(h , cdr(fns) , consts , entry + 5 + list.length(code))
      }
    }
  } else {
    1
  }
}

// 常量池里去重后的符号列表，保持首次出现顺序——这就是 VM 端 intern_sym
// 的编号规则。extern 节要的是**符号 id**而不是常量池下标：同一符号出现
// 多次时两者不相等（println 在下标 2/4/8/12/16，符号 id 却是 1）。
// 注意 fn 记录的 nameidx 用的仍是常量池下标（link_unit 先用 consts_g 取值、
// 再取 payload），两者语义不同，别混用。
fn sym_list(consts , acc) {
  if pair?(consts) {
    let a = car(consts)
    if symbol?(a) {
      if member(a , acc) {
        sym_list(cdr(consts) , acc)
      } else {
        sym_list(cdr(consts) , cons(a , acc))
      }
    } else {
      sym_list(cdr(consts) , acc)
    }
  } else {
    rev_into(acc , [])
  }
}

fn rev_into(lst , acc) {
  if pair?(lst) {
    rev_into(cdr(lst) , cons(car(lst) , acc))
  } else {
    acc
  }
}

fn sym_id_of(name , syms , k) {
  if pair?(syms) {
    if car(syms) == name { k } else { sym_id_of(name , cdr(syms) , k + 1) }
  } else {
    -1
  }
}

// extern 节：nexterns + 符号 id。声明了但没用到的名字不在常量池里，跳过。
fn extern_ids_of(exts , syms) {
  if pair?(exts) {
    let rest = extern_ids_of(cdr(exts) , syms)
    let i = sym_id_of(car(exts) , syms , 0)
    if i < 0 { rest } else { cons(i , rest) }
  } else {
    nil
  }
}

pub fn write_bc(path , fns , consts , externs) {
  let h = buf.new()
  buf.push_string(h , str.concat(str.from_int(list.length(fns)) , " "))
  buf.push_string(h , str.concat(str.from_int(list.length(consts)) , " "))
  write_fns(h , fns , consts , 7)
  write_consts(h , consts)
  let ids = extern_ids_of(externs , sym_list(consts , []))
  buf.push_string(h , str.concat(str.from_int(list.length(ids)) , " "))
  write_ints(h , ids)
  buf.write_to(h , path)
}

fn main() {
  let ra = build("fib")
  let rb = build("closure")
  let rc = build("list")
  let rd = build("quote")
  let re = build("collatz")
  let rf = build("collatz1m")
  let rg = build("map")
  let rm = build("match")
  print(ra + rb + rc + rd + re + rf + rg + rm) // 8 = 全部写出成功
}
fn member(x , xs) {
  if pair?(xs) {
    if car(xs) == x { true } else { member(x , cdr(xs)) }
  } else {
    false
  }
}

// lisp 侧 prelude：VM 提供的原生函数声明 + 能用现有词表写出来的库函数。
// 放在这里而不是各自的前置文件里，是为了让 bridge_test 和语料扫描器共用
// 同一份——extern 名单一旦分叉，症状是 link 期 "undefined global"。
//
// 这些定义原来在 prelude.lisp 里靠多单元链接器，剥到最小内核时一起删了，
// 于是 null?/not 变成未定义名。改成「把 prelude 形式直接前置到程序」：
// 不需要链接器，prelude 就是普通的顶层 extern/def。
// 读 prelude.lisp 并 parse，返回它的 forms（异构 sexp 数据）。
// 语义同 json.load / sexp.parse：读不到或 parse 硬错直接退出。
// 调用方把它前置到用户程序 forms 之前（见 README「prelude」）。
pub fn prelude() {
  let src = "vm-demo/lisp/prelude.lisp"
  let text = file.read(src)
  if null?(text) {
    print(str.concat("main: cannot read " , src))
    os.exit(1)
  }
  let forms = sexp.parse(text)
  if int?(forms) {
    print(str.concat("main: " , str.concat(src , str.concat(": " , sexp.err()))))
    os.exit(1)
  }
  forms
}
