// compile.ta — Lisp 内核编译器：sexp(TA 数据) → 字节码(纯数据)。
//
// 设计见 README.md。四遍：codegen（Ins 指令树）→ flatten（IF 展开回填 +
// 常量池，产 int 词流）→ depthpass（逐词模拟栈深得 maxd）→ 写文件。
//
// == 表示分层 ==
// 输入层：sexp 树（pair/symbol/int，来自 main.ta 的 prog 构造或 sexp.parse），
//   以 pair? 收尾遍历、at() 取字段——异构数据，保留松类型。
// 内部层：TA ADT——Ins 指令树、Ctx 编译期上下文、CompRes/FreeRes/FlatRes
//   结果对、FnRec/FnBC/FnW 函数记录。字段经 match 解构访问，0 结尾记录、
//   'end 脚手架、at() 通用取字段在内部层全部消失。
//
// == 各记录 ==
//   Ins      — 指令：每个变体自带编码（见 flat2），IOp(op) 承载 int 编码的
//              二元/一元原语（binop_num/unop_num 的结果）
//   Ctx      — (env, next_slot, next_fnid, defs, fvs, lambdas)
//              env/fvs — Bind alist；defs/lambdas — FnRec 列表（最新在前）
//   FnRec    — (nargs, code)；FnW — (nargs, 词流)；FnBC — (nargs, maxd, 词流)
//   Out      — compile 的产物：(List(FnBC), 常量池)
//
// == 编码唯一权威 ==
// OP_* 常量 + flat2 的 match；lispvm.c 的 enum 是镜像副本，两边必须同步改。

// ---- 操作码（int 世界；flat2 按 Ins 变体直接引用）----
const OP_CONST = 0
const OP_LOAD = 1
const OP_STORE = 2
const OP_LOADF = 3
const OP_PUSH = 4
const OP_ADD = 5
const OP_SUB = 6
const OP_MUL = 7
const OP_DIV = 8
const OP_MOD = 9
const OP_LT = 10
const OP_LE = 11
const OP_GT = 12
const OP_GE = 13
const OP_EQ = 14
const OP_PAIRP = 15
const OP_SYMP = 16
const OP_CONS = 17
const OP_CAR = 18
const OP_CDR = 19
const OP_JIF = 20
const OP_JUMP = 21
const OP_CALL = 22
const OP_TCALL = 23
const OP_RET = 24
const OP_CLOS = 25
const OP_GLOB = 26
const OP_RESERVE = 27
const OP_BUILTIN = 28
// 融合指令（fuse pass 生成，x + PUSH 一步到位；lispvm.c 同步加 handler）
const OP_LOADP = 29
const OP_CONSTP = 30
const OP_GLOBP = 31

// op_builtin 派发 id（lispvm.c 的 LB_* 镜像，两边必须同步改）：
// 已知内建编译期固化为整数索引，运行期 O(1) 跳转，零按名查找。
const B_SELF = 0
const B_SPAWN = 1
const B_SEND = 2
const B_RECV = 3
const B_MONITOR = 4
const B_RECV_AFTER = 5
const B_RECV_PEEK = 6
const B_RECV_COMMIT = 7

// ---------- 内部表示（ADT）----------
pub type Ins {
  IConst(atom)
  ILoad(slot)
  ILoadF(idx)
  IGlob(fid)
  IStore(slot)
  IPush
  IOp(op)
  ICall(n)
  ITCall(n)
  IBuiltin(id, n)
  IClos(fid, nfv)
  IRet
  IReserve(n)
  ILoadP(slot)
  IConstP(atom)
  IGlobP(fid)
  IIf(cond, then, els)
}

pub type Bind {
  Bind(name, val)
}

// depth 的返回值：(分支编译完的栈深, 全程峰值)
pub type DepthRes {
  DP(d, m)
}

pub type FnRec {
  FnRec(name, nargs, code)
}

pub type FnW {
  FnW(name, nargs, maxd, ws)
}

pub type FnBC {
  FnBC(name, nargs, maxd, words)
}

pub type Ctx {
  Ctx(env, next_slot, next_fnid, defs, fvs, lambdas, cenv)
}

pub type CompRes {
  CompRes(code, ctx)
}

pub type FreeRes {
  FreeRes(code, pfvs)
}

pub type FlatRes {
  FlatRes(ws, pool)
}

pub type Globals {
  Globals(alist, next_id)
  DupGlobal(msg)
}

pub type Out {
  Out(fns, consts)
  Fail(msg)
}

// ---------- 自包含小工具 ----------
// at：输入层（sexp 树）字段访问。参数类型是 tvar，天然擦除记录的具体类型。
fn at(lst, n) {
  if pair?(lst) {
    if n <= 0 {
      car(lst)
    } else {
      at(cdr(lst), n - 1)
    }
  } else {
    lst
  }
}

// 尾递归：词流可达数百词，非尾递归有爆栈风险（下同）
fn len(lst) {
  len_into(lst, 0)
}

fn len_into(lst, acc) {
  if pair?(lst) {
    len_into(cdr(lst), acc + 1)
  } else {
    acc
  }
}

// 尾递归 cat：先逆序 a，再回卷盖到 b 前。代价是拷贝 a（编译期一次性，可接受）
fn cat(a, b) {
  cat_into(rev_into(a, []), b)
}

fn cat_into(rev_a, b) {
  if pair?(rev_a) {
    cat_into(cdr(rev_a), cons(car(rev_a), b))
  } else {
    b
  }
}

fn rev_into(lst, acc) {
  if pair?(lst) {
    rev_into(cdr(lst), cons(car(lst), acc))
  } else {
    acc
  }
}

fn rev(lst) { rev_into(lst, []) }

// ---------- 操作码符号 → int 编码（输入层分发用） ----------
// 注意：TA 的 match 模式臂对纯标点符号名（'+ '< 等）永不命中
// （p48 实测：'modulo/'eq? 可匹配，'+/'*/'< 全部落 _ 臂），
// 因此算符分发必须走 sym_to_str + 字符串比较。
fn binop_num(name) {
  match str.sym_to_str(name) {
    "+" -> OP_ADD
    "-" -> OP_SUB
    "*" -> OP_MUL
    "/" -> OP_DIV
    // TA parser 出 %、lisp 方言出 modulo：一张表收两个词形
    "%" -> OP_MOD
    "modulo" -> OP_MOD
    "=" -> OP_EQ
    "eq?" -> OP_EQ
    "<" -> OP_LT
    "<=" -> OP_LE
    ">" -> OP_GT
    ">=" -> OP_GE
    // cons 机制同二元 op（l=pop 与 acc 配对），quote 收敛后它成为唯一
    // 的 2 参原生构造器，必须走 primitive 分发而非通用调用
    "cons" -> OP_CONS
    _ -> -1
  }
}

fn unop_num(name) {
  match name {
    'car -> OP_CAR
    'cdr -> OP_CDR
    'pair? -> OP_PAIRP
    'symbol? -> OP_SYMP
    // null?/not 已移库（prelude.lisp，2.2）：可从 eq?/if 推导的原生
    // 不烧 opcode，opcode 只留不可推导的最小自举集
    _ -> -1
  }
}

// 裸名 cfunc 白名单：lispvm 宿主注册的「不带模块前缀」的可调用名。
// 判定序在 binop_num/unop_num（专属 opcode 原语）之后——这里只收没有
// 专属 opcode、又必须按名调到宿主 C 层的少数几个。带点名字（str.concat）
// 不走这里，由 has_dot 直接判定为模块 cfunc。
// 漂移即响：宿主删名 → 运行期按名 miss（fatal）；表里多名 → 编译期
// 误判为 IGlob，拼错名不再被前端拦 —— 两边都是显式失败，不静默。
fn bare_cfunc(name) {
  match name {
    'print -> true
    'int? -> true
    'string? -> true
    'bytes? -> true
    'pid? -> true
    'float? -> true
    'bool? -> true
    'list? -> true
    'map? -> true
        'nil? -> true
    _ -> false
  }
}

// op_builtin 派发表（lispvm.c LB_* 的镜像）：actor 原语不走 IGlob/按名
// 路径 —— bare_cfunc 不收它们。self/recv 0 参、spawn 1 参（闭包）、send 2 参，
// arity 由运行期检查（与 CALL 的 fn_args 检查同策略）。
fn builtin_id(name) {
  match name {
    'self -> B_SELF
    'spawn -> B_SPAWN
    'send -> B_SEND
    'recv -> B_RECV
    'recv_after -> B_RECV_AFTER
    'recv_peek -> B_RECV_PEEK
    'recv_commit -> B_RECV_COMMIT
    'monitor -> B_MONITOR
    _ -> -1
  }
}

// 名字里带点 → 模块限定 cfunc（str.concat / file.read）。逐字符扫，
// TA 的 str 库没有 contains。
fn has_dot(s, i) {
  if i >= str.length(s) {
    false
  } else {
    if str.char_at(s, i) == 46 {
      true
    } else {
      has_dot(s, i + 1)
    }
  }
}

fn lib_cfunc_head(f) {
  if bare_cfunc(f) {
    true
  } else {
    has_dot(str.sym_to_str(f), 0)
  }
}

// ---------- alist（元素是 Bind(name, val)）----------
fn assoc_find(key, alist) {
  if pair?(alist) {
    match car(alist) {
      Bind(k, v) -> {
        if k == key {
          v
        } else {
          assoc_find(key, cdr(alist))
        }
      }
    }
  } else {
    -1
  }
}

// ---------- codegen ----------
// 返回 CompRes(code, ctx)：code = Ins 的 nil 列表，ctx = 新编译期上下文。

fn compile_expr(x, g, c, tail) {
  if symbol?(x) {
    compile_ref(x, g, c)
  } else {
    if pair?(x) {
      compile_form(x, g, c, tail)
    } else {
      // nil / true / false / 整数自求值
      CompRes(cons(IConst(x), nil), c)
    }
  }
}

// 符号引用：env 槽 → 全局函数 → 自由变量（首遇登记）→ GLOBAL -1（运行期停机）
fn compile_ref(name, g, c) {
  match c {
    Ctx(env, ns, nf, defs, fvs, lams, cenv) -> {
      let slot = assoc_find(name, env)
      if slot >= 0 {
        CompRes(cons(ILoad(slot), nil), c)
      } else {
        // 外层 fn 的 env 链（cenv）优先于全局 fn：lambda 内自由变量与全局
        // fn 同名时（main 作参数名是测试惯用法），lexical 捕获必须赢，
        // 否则静默解析成全局 fn 引用、捕获值丢失（net-load 类 bug）。
        let ci = assoc_find(name, cenv)
        let fi = assoc_find(name, fvs)
        if ci >= 0 || fi >= 0 {
          if fi >= 0 {
            CompRes(cons(ILoadF(fi), nil), c)
          } else {
            let i2 = len(fvs)
            CompRes(cons(ILoadF(i2), nil),
              Ctx(env, ns, nf, defs, list.append(fvs, cons(Bind(name, i2), nil)),
                lams, cenv))
          }
        } else {
          let fid = assoc_find(name, g)
          // fid: def = fnid(>=1)、缺席 = -1。两者同走 GLOBAL 符号引用：
          // 操作数是常量池符号下标，加载期由 link_unit 按名解析成本文件 fn_id。
          if fid != -1 || has_dot(str.sym_to_str(name), 0) {
            // 带点值引用（cmp.int_cmp 作实参、log.ERROR 作常量）：模块名
            // 永远不是本文件的自由变量——按名全局解析（同调用头判定），
            // 运行期 link_unit 存 vm 符号 id，op_global 按名产出引用。
            CompRes(cons(IGlob(name), nil), c)
          } else {
            let i2 = len(fvs)
            // fvs 必须 append（登记序 = ILoadF 索引序）：头插会让本层
            // 登记序与 parent 侧 emit_free_loads 的遍历序镜像，free[] 槽位
            // 对不上 —— LOADF(k) 两边指到不同变量（curry/嵌套捕获必炸）
            CompRes(cons(ILoadF(i2), nil),
              Ctx(env, ns, nf, defs, list.append(fvs, cons(Bind(name, i2), nil)),
                lams, cenv))
          }
        }
      }
    }
  }
}

// receive 臂 → match 臂：每臂 body 前插 (recv_commit)（命中才消费消息），
// 守卫臂原样保留；末尾补通配重试臂 —— peek 游标已前进，下一条消息继续试。
// 臂的 2 元/3 元判别用显式 cdr 遍历而非结构模式：TA 的 (a b) 模式是
// 「不定长 pair」，会误吞 3 元守卫臂（长度未钉死，且 body 可能是 pair，
// (body) 子模式会错误下钻进 body 结构）。
pub fn recv_arms_to_match(arms) {
  if pair?(arms) {
    let arm = car(arms)
    let rest = recv_arms_to_match(cdr(arms))
    if null?(cdr(cdr(arm))) {
      // (pat body)
      cons(cons(at(arm, 0), cons(arm_commit(at(arm, 1)), nil)), rest)
    } else {
      // (pat guard body)
      cons(cons(at(arm, 0),
        cons(at(arm, 1), cons(arm_commit(at(arm, 2)), nil))), rest)
    }
  } else {
    cons(cons('_,
      cons(cons(cons('_self, cons('_self, nil)),
        cons(cons('recv_peek, nil), nil)), nil)), nil)
  }
}

pub fn arm_commit(body) {
  cons('begin, cons(cons('recv_commit, nil), cons(body, nil)))
}

// receive → Y 式自应用闭包循环（脱糖产物，逐层与手写验证版一致）：
//   (let (_scan (lambda (_self) (lambda (_msg) (match _msg ARMS))))
//     ((_scan _scan) (recv_peek)))
// scrutinee 必须是符号 _msg 本体——包成 (_msg) 会变成对消息值的调用。
fn recv_desugar(x) {
  let arms = recv_arms_to_match(cdr(x))
  let inner = cons('lambda, cons(cons('_msg, nil),
    cons(cons('match, cons('_msg, arms)), nil)))
  let outer = cons('lambda, cons(cons('_self, nil),
    cons(inner, nil)))
  cons('let, cons(cons('_scan, cons(outer, nil)),
    cons(cons(cons('_scan, cons('_scan, nil)),
      cons(cons('recv_peek, nil), nil)), nil)))
}

fn compile_form(x, g, c, tail) {
  let head = at(x, 0)
  let args = cdr(x)
  match head {
    'quote -> CompRes(quote_code(at(args, 0)), c)
    'if -> compile_if(args, g, c, tail)
    'begin -> compile_begin(args, g, c, tail)
        'lambda -> compile_lambda(x, g, c)
    'let -> compile_let(x, g, c, tail)
        'match -> compile_match(x, g, c, tail)
    'receive ->
      // receive { pat [when g] -> body ... } —— 选择性接收。脱糖为自应用
      // 闭包循环（Y 式），复用 lambda 捕获 / match / 调用全套既有机制，
      // 不加 IR 循环原语：
      //   (let (_scan (lambda (_self) (lambda (_msg)
      //     (match _msg
      //       (pat [guard] (begin (recv_commit) body)) ...
      //       (_ ((_self _self) (recv_peek)))))))
      //    ((_scan _scan) (recv_peek)))
      // 重试臂引用的是 _self（lambda 参数，词法可见），不是 _scan ——
      // let 初值在绑定建立前编译，初值里引用 _scan 会落进 fvs 变未定义名。
      // 语义与参考实现（b_recv_peek/b_recv_commit + 跳回 loop_start）一致：
      // peek 窥视游标处消息不消费；臂中则 commit 摘除并执行；全臂不中则
      // 重入扫描（游标已前进 —— 跳过的消息与本模式不匹配，留给未来的
      // receive）；游标耗尽则挂起，新消息到达后从原游标继续。外层变量
      // 经闭包捕获（LOADF），模式变量经 match 绑定，无需额外传递。
      // 嵌套 receive 同名 _scan 互不干扰：外层 _scan 只出现在判定式/初值，
      // 内层重绑定遮蔽后，重试臂引用的恒是自己的那层（同 _m 惯例）。
      compile_form(recv_desugar(x), g, c, tail)
    'float ->
      // 浮点字面量（parser 产 ('float "1.5")，文本端到端——bootstrap 语言
      // 无 float 值）：整个 form 入常量池，驱动侧 const_words 认 'float
      // 出 kind 6，lispvm 加载期 strtod。非 string 形状（防御）回退当调用。
      if string?(at(args, 0)) {
        CompRes(cons(IConst(x), nil), c)
      } else {
        compile_call(head, args, g, c, tail)
      }
    _ -> compile_call(head, args, g, c, tail)
  }
}

// ---------- match：desugar 成 s 表达式再走正常编译（4.2）----------
// 不用新 opcode / 新 Ins 变体：match 纯属编译期语法糖，展开后仍是
// if + let + eq?/pair?/car/cdr 的组合，VM 与字节码格式零改动。
//
// (match scrut (pat1 body1) (pat2 body2) ...)
//   => (let (t scrut) (if (test1 t) (arm1 t) (if (test2 t) ... nil)))
// scrut 只求值一次（存进 t 槽），无分支命中 = nil。
//
// 模式（按序判定，先命中先赢）：
//   int/true/false/nil 字面量 —— (eq? t lit)，NaN-boxing 下即位相等
//   _                          —— 恒真，不绑定
//   符号                        —— 恒真，绑定为 t
//   (a b)                      —— pair 模式：car 对 a、cdr 继续对 b
//
// 编译期不做穷尽性检查：无 arm 兜底时值为 nil，不是错误——与 Gleam
// 允许非穷尽 match 的取向一致。
fn compile_match(x, g, c, tail) {
  match compile_expr(match_desugar(at(x, 1), cdr(cdr(x))), g, c, tail) {
    CompRes(code, c1) -> CompRes(code, c1)
  }
}

// scrut 求值一次 → gensym 槽 t；再把分支链展开成嵌套 if
pub fn match_desugar(scrut, clauses) {
  let t = gensym()
  cons('let, cons(cons(t, cons(scrut, nil)),
    cons(match_chain(clauses, t), nil)))
}

// 命中 → arm 的展开式；未命中 → 下一条；链尽 → nil。
// 守卫臂 (pat guard body)：守卫引用模式变量，必须落在 match_arm 发出的
// 绑定之内，故把守卫 if 包进臂体——未过守卫落到 rest。rest 因此出现两
// 份（模式未中 / 守卫未过）：编译期展开的固有代价，代码尺寸 2^k（k 为
// 连续守卫臂数）；corpus 与真实代码的守卫链都短，不为其引入复杂度。
fn match_chain(cls, t) {
  if pair?(cls) {
    let cl = car(cls)
    let rest = match_chain(cdr(cls), t)
    let arm = if pair?(cdr(cdr(cl))) {
      match_arm(at(cl, 0), t,
        cons('if, cons(at(cl, 1), cons(at(cl, 2), cons(rest, nil)))))
    } else {
      match_arm(at(cl, 0), t, at(cl, 1))
    }
    cons('if, cons(match_test(at(cl, 0), t),
      cons(arm, cons(rest, nil))))
  } else {
    nil
  }
}

// 模式 → 判定表达式
//
// 模式列表按「脊」递归：首元素对 car，**余下的模式列表**对 cdr，末段退化为
// 原子对整个 subject。这样一条规则同时覆盖三种语义：
//
//   (a b)         不定长 pair：a→car，末段 b 是单元素模式 → 直接对 cdr
//   (a (b c))     嵌套 pair：a→car，(b c) 对 cdr 再展开
//   (a b nil)     定长 2 列表：a→car，(b nil) 对 cdr，末段 nil 发出
//                 (eq? (cdr (cdr t)) nil) 把长度钉死
//
// 早先用 at(pat, 1) 取第 2 槽——那是**按位置**取，对 (a b nil) 会把第 3 槽
// 整个丢掉：绑定变成 a=car / b=cdr，长度判定消失，`[a, b]` 静默放宽成不定长
// pair。改成对 cdr(pat) 递归后位置信息不会丢。
pub fn match_test(pat, t) {
  if pair?(pat) {
    // quoted 符号模式 (quote a)：整条发 eq?，不进脊展开——否则 (quote data)
    // 被当嵌套 pair 模式下钻，发 (pair? (car t)) 对符号恒否。
    if is_quoted_sym(pat) {
      cons('eq?, cons(t, cons(pat, nil)))
    } else {
      // 单元素模式 (a)：a 直接对 t，不发 pair? 判定。
      // 但 (a) 里 a 本身是 pair 时不是原子模式——那是「长度 1 的模式」，
      // 元素是个子模式，必须走下面的脊展开让 bind/test 递归进去。
      // 少了这个判断：((b)) 会把 (b) 当原子交给 bind_arm -> str.sym_to_str(pair)
      // 编译期崩；且与 match_test 判定不一致（判定侧当嵌套、绑定侧当原子）。
      if null?(cdr(pat)) && not_pair_p(car(pat)) {
        // 单元素模式 (a)：a 直接对 t，不发 pair? 判定
        test_atom(car(pat), t)
      } else {
        // 嵌套 if 而非把 cdr 段放进 else——那样 t 非 pair 时会先求 (cdr t)
        cons('if, cons(cons('pair?, cons(t, nil)),
          cons(cons('if, cons(match_test(car(pat), cons('car, cons(t, nil))),
            cons(match_test(cdr(pat), cons('cdr, cons(t, nil))), nil))),
        nil)))
      }
    }
    } else {
    test_atom(pat, t)
  }
}

// (quote a) 形式的 quoted 符号模式：单元素、首元素 quote、次元素符号。
// quoted list '(a b) 不在模式支持范围（quote_code 只收原子，同表达式侧约束）。
fn is_quoted_sym(x) {
  if pair?(x) {
    if pair?(cdr(x)) {
      if null?(cdr(cdr(x))) && symbol?(car(x)) {
        if str.sym_to_str(car(x)) == "quote" { symbol?(car(cdr(x))) } else { false }
      } else {
        false
      }
    } else {
      false
    }
  } else {
    false
  }
}

// pair? 的否定：单元素模式判定里和 not_pair_p 配对用
fn not_pair_p(x) { if pair?(x) { false } else { true } }

// 原子模式：字面量发 eq?，变量 / _ 恒真
fn test_atom(pat, t) {
  if is_literal(pat) {
    cons('eq?, cons(t, cons(pat, nil)))
  } else {
    // 变量 / _ 恒真：必须发 true 而不是 t 本身。发 t 会让"值即判定"，
    // cdr 位置绑到 nil 时（nil 即 falsy）整条模式反而判否——嵌套 pair
    // 模式必踩。（match 7 (x ...)) 顶层能过是巧合，值恰好非 nil。
    true
  }
}

// 模式 → 命中后的 body 展开式（绑定按模式嵌套 let）
pub fn match_arm(pat, t, body) {
  if pair?(pat) {
    if is_quoted_sym(pat) {
      // quoted 符号只判定（match_test 已发 eq?），不绑定
      body
    } else {
      // 同 match_test：单元素且元素非 pair 才算原子模式，否则当「长度 1 的
      // 模式」展开，让子模式递归进绑定。
      if null?(cdr(pat)) && not_pair_p(car(pat)) {
        bind_arm(car(pat), t, body)
      } else {
        // (a b) => (let (a (car t)) (let (b (cdr t)) body))
        // 先构造 cdr 段（内层），再包 car 段（外层）——反过来 b 会绑到
        // body 的值而非 (cdr t)，且 b 落在 a 的作用域之外
        match_arm(cdr(pat), cons('cdr, cons(t, nil)),
          match_arm(car(pat), cons('car, cons(t, nil)), body))
      }
    }
  } else {
    bind_arm(pat, t, body)
  }
}

// 原子模式的绑定：字面量不绑定（只判定），_ 不绑定，符号绑为 t
fn bind_arm(pat, t, body) {
  if is_literal(pat) {
    body
  } else {
    // 符号绑定 t；_ 不绑定（两者都恒真，_ 只是不占名）
    if str.sym_to_str(pat) == "_" {
      body
    } else {
      cons('let, cons(cons(pat, cons(t, nil)), cons(body, nil)))
    }
  }
}

// 字面量 = 非符号的原子（int / true / false / nil）。符号恒作绑定名。
fn is_literal(pat) {
  if symbol?(pat) {
    false
  } else {
    if pair?(pat) { false } else { true }
  }
}

// match 的内部临时变量名。编译器内部产生，用户无从引用；固定名即可——
// 嵌套 match 会生成同名 let，但外层 _m 只出现在判定式和模式绑定的初值
// 里，都在嵌套 match 的 body 之外，不会被内层遮蔽。
fn gensym() { str.to_sym("_m") }




// if：三分支各自编译，包成复合指令 IIf，flatten 阶段回填跳转偏移
// if 的两个分支互斥：else 必须用 cond 之后的 env（c1），不能继承 then
// 编译后的 c2——then 里的 let/match 绑定（如 gensym 的 _m）会遮蔽外层
// 同名槽，让后续 else 分支 LOAD 到内层槽位（嵌套 match 在先臂时，后臂
// 全部读错值）。ns/defs/fvs 等计数器仍取 c2 的：槽区按最宽分支预留
//（RESERVE 用最终 bns），计数器单调，两分支从同一 ns 起点各自推进。
fn compile_if(args, g, c, tail) {
  match compile_expr(at(args, 0), g, c, false) {
    CompRes(cc, c1) ->
      match compile_expr(at(args, 1), g, c1, tail) {
        CompRes(tc, c2) ->
          match c1 {
            Ctx(env1, _, _, _, _, _, cenv1) ->
              match c2 {
                Ctx(_, ns2, nf2, defs2, fvs2, lams2, _) -> {
                  let celse = Ctx(env1, ns2, nf2, defs2, fvs2, lams2, cenv1)
                  match compile_expr(at(args, 2), g, celse, tail) {
                    CompRes(fc, c3) -> CompRes(cons(IIf(cc, tc, fc), nil), c3)
                  }
                }
              }
          }
      }
  }
}

// begin：表达式顺序拼接；值入 acc 即死，无需栈流量；末位继承 tail
fn compile_begin(forms, g, c, tail) {
  if pair?(forms) {
    if null?(cdr(forms)) {
      compile_expr(car(forms), g, c, tail)
    } else {
      match compile_expr(car(forms), g, c, false) {
        CompRes(hc, c1) ->
          match compile_begin(cdr(forms), g, c1, tail) {
            CompRes(tc, c2) -> CompRes(cat(hc, tc), c2)
          }
      }
    }
  } else {
    CompRes(cons(IConst(0), nil), c)
  }
}

// (let (name val) body)：val → IStore 槽（分配一槽），body 在扩展 env 里编
fn compile_let(x, g, c, tail) {
  let binding = at(x, 1)
  let name = at(binding, 0)
  match compile_expr(at(binding, 1), g, c, false) {
    CompRes(vc, c1) ->
      match c1 {
        Ctx(env, ns, nf, defs, fvs, lams, cenv) -> {
          let code1 = cat(vc, cons(IStore(ns), nil))
          match compile_expr(at(x, 2), g,
            Ctx(cons(Bind(name, ns), env), ns + 1, nf, defs, fvs, lams, cenv), tail) {
            CompRes(bc, c2) -> CompRes(cat(code1, bc), c2)
          }
        }
      }
  }
}

// (lambda (p...) body)：体内递归出新 FnRec；父侧发自由变量取值 + CLOS。
// 自由变量按体内首遇序编号，父侧按同序取值，闭包 free[i] 与 ILoadF i 对齐。
// fnid 由调用方给定；next_fnid 是体编译后的计数器值：
//   内层 lambda = fnid + 1（占号）；def = next_fnid（不占号，collect id 唯一来源）
fn compile_lambda(x, g, c) {
  match c {
    // fnid = -1：匿名 lambda 的号在 body 编完后取（后序分配）。fnid 与
    // flatten 落位（rev(lams) = 后序）必须同序，先序分配会让两层以上嵌套
    // 的 MCLOS 指到兄弟的 FnRec（curry/嵌套捕获互换 body）。
    Ctx(_, _, nf, _, _, _, _) -> compile_lambda_id(x, g, c, -1, nf)
  }
}

fn compile_lambda_id(x, g, c, fnid, next_fnid) {
  let params = at(x, 1)
  match c {
        Ctx(env, ns, nf, defs, fvs, lams, cenv) -> {
      // 参数是帧局部的：内层 env 只含自己的参数，父层变量一律走 fvs 捕获。
      // fvs 传 []：ILoadF 索引是「本层闭包 free[]」的槽位，必须每层从 0
      // 重新登记 —— 继承外层列表会让内层命中外层的 Bind，发出外层编号的
      // LOADF，执行时索引到内层 free[] 越界（三层嵌套必炸）。
      // 外层编号由底部 emit_free_loads(bfvs, env, fvs) 的 pfvs 级联维护。
      let env2 = param_bindings(params, 1)
      match compile_expr(at(x, 2), g,
                        // body 的 cenv = 所在处 env + 所在处 cenv：外层函数 env 链（含直接
        // 外层的参数/let），供 compile_ref 做 lexical 影子判定。def 在顶层
        // 所以为空链（def 闭包必须封闭的拦截语义不变）。
        Ctx(env2, len(params) + 1, next_fnid, defs, [], lams,
          cat(env, cenv)), true) {
        CompRes(bc, bctx) ->
          match bctx {
            Ctx(_, bns, bnf, _, bfvs, blams, _) -> {
              // 函数体首指令：把 sp 从 base+nargs+1 抬过整个局部变量区，
              // 之后 PUSH / 被调帧才落在 base+nargs+1+nlocals 之上。
              // ns 单调递增，每个 let 一个槽，所以 nlocals = bns - (nargs+1)。
              let nlocals = bns - len(params) - 1
              let body_code = cat(cons(IReserve(nlocals), nil),
                                  cat(bc, cons(IRet, nil)))
              // 后序：fnid<0（匿名）= body 消耗后的计数器 bnf；def（fnid≥0，
              // collect 预分配）原样带回，其 IClos 随 body code 一起被丢弃。
              let myfnid = if fnid < 0 { bnf } else { fnid }
              // 返回的计数器：匿名要给自己占掉 bnf，下一个兄弟从 bnf+1 起
              let nfin = if fnid < 0 { bnf + 1 } else { bnf }
              let fnrec = FnRec(0, len(params), body_code) // 0 = 匿名
              match emit_free_loads(bfvs, env, fvs) {
                FreeRes(fc, pfvs) ->
                  CompRes(cat(fc, cons(IClos(myfnid, len(bfvs)), nil)),
                                        Ctx(env, ns, nfin, defs, pfvs, cons(fnrec, blams), cenv))
              }
            }
          }
      }
    }
  }
}

fn param_bindings(params, slot) {
  if pair?(params) {
    cons(Bind(car(params), slot), param_bindings(cdr(params), slot + 1))
  } else {
    []
  }
}

// 父侧按首遇序发 ILoadF；pfvs = 本层已登记的 Bind(name, idx) 列表
// 自由值加载，末值留 acc（同 CALL 协议：MAKE_CLOSURE 会先 flush acc 作
// 最后一个自由值，再从栈上收前 n-1 个）。除末值外每个 LOAD/LOADF 后必须
// IPUSH，否则 MAKE_CLOSURE 从栈上读到的是残留垃圾。
fn emit_free_loads(fvs, env, pfvs) {
  if pair?(fvs) {
    match car(fvs) {
      Bind(name, _) -> {
        let slot = assoc_find(name, env)
        let more = pair?(cdr(fvs))
        if slot >= 0 {
          match emit_free_loads(cdr(fvs), env, pfvs) {
            FreeRes(rc, np) ->
              if more {
                FreeRes(cat(cons(ILoad(slot), cons(IPush, nil)), rc), np)
              } else {
                FreeRes(cons(ILoad(slot), nil), np)
              }
          }
        } else {
          let i2 = len(pfvs)
          // pfvs 必须 append（登记序 = ILoadF 索引序）：头插会让列表顺序与
          // 索引镜像——parent 侧按列表序为本闭包发射 loads，free[] 槽位就与
          // 本层 ILoadF 索引对不上。2 个自由变量即触发（1 个无序可言；
          // 交换律运算还会掩盖——a+b == b+a）。与 compile_ref 的 fvs append 同理。
          match emit_free_loads(cdr(fvs), env,
            list.append(pfvs, cons(Bind(name, i2), nil))) {
            FreeRes(rc, np) ->
              if more {
                FreeRes(cat(cons(ILoadF(i2), cons(IPush, nil)), rc), np)
              } else {
                FreeRes(cons(ILoadF(i2), nil), np)
              }
          }
        }
      }
    }
  } else {
    FreeRes([], pfvs)
  }
}

fn compile_call(f, args, g, c, tail) {
  if symbol?(f) {
    // (!= a b) → (if (= a b) false true)：lispvm 无 NE opcode，编译期
    // desugar 不加 VM 指令（分层原则）。复用 = 的语义，两边一致地对/错。
    if f == '!= {
      let eq_form = cons('=, args)
      let rew = cons('if, cons(eq_form, cons(false, cons(true, nil))))
            compile_expr(rew, g, c, tail)
    } else {
      let b = binop_num(f)
      if b >= 0 {
        compile_binop(b, args, g, c)
      } else {
        let u = unop_num(f)
        if u >= 0 {
          compile_unop(u, args, g, c)
        } else {
          compile_general(f, args, g, c, tail)
        }
      }
    }
  } else {
    // ((f a) b) 形：被调方本身是表达式，走一般调用
    compile_general(f, args, g, c, tail)
  }
}

// 二元原语：l → IPUSH；r 在 acc；IOP
fn compile_binop(op, args, g, c) {
  match compile_expr(at(args, 0), g, c, false) {
    CompRes(lc, c1) ->
      match compile_expr(at(args, 1), g, c1, false) {
        CompRes(rc, c2) ->
          CompRes(cat(cat(lc, cons(IPush, nil)), cat(rc, cons(IOp(op), nil))), c2)
      }
  }
}

// 一元原语：x 在 acc；IOP
fn compile_unop(op, args, g, c) {
  match compile_expr(at(args, 0), g, c, false) {
    CompRes(xc, c1) -> CompRes(cat(xc, cons(IOp(op), nil)), c1)
  }
}

// 一般调用协议（与 lispvm CALL n 对齐）：
//   f 入栈；a1..a(n-1) 逐个 IPUSH；末参留在 acc；CALL n = 参数数 + 1
//   （CALL 内 flush acc 作末参 → 栈恰好 [f, a1..an]，base 指向 f）
fn call_ins(tail, n) {
  if tail {
    ITCall(n)
  } else {
    ICall(n)
  }
}

fn compile_general(f, args, g, c, tail) {
  // op_builtin 派发：已知内建（actor 原语）在编译期固化为整数 id，
  // 参数协议与 CALL 一致（前 n-1 参压栈、末参留 acc）但不发 fn 槽 ——
  // 运行期 O(1) 整数跳转，零按名查找，CALL 只服务 VM 自己的函数。
  if symbol?(f) {
    let bid = builtin_id(f)
        if bid >= 0 {
      if pair?(args) {
        match compile_args_butlast(args, g, c) {
          CompRes(ac, c1) ->
            // ac 自带每个 butlast 参的收尾 IPush（与 CALL 协议一致），
            // 这里只补 BUILTIN 本身 —— 末参照旧留 acc
            CompRes(cat(ac, cons(IBuiltin(bid, len(args)), nil)), c1)
        }
      } else {
        CompRes(cons(IBuiltin(bid, 0), nil), c)
      }
    } else {
      compile_general_named(f, args, g, c, tail)
    }
  } else {
    compile_general_named(f, args, g, c, tail)
  }
}

fn compile_general_named(f, args, g, c, tail) {
  let n = len(args) + 1
  // 调用头解析序：env → def 表 → 模块 cfunc → 自由变量捕获。
  // 「带点」的名字（str.concat）只能是模块 cfunc，按名全局调用（IGlob）；
  // 裸名若不是已知 cfunc，就是运行期值（柯里化实参、HOF 的 fn 参数）——
  // 必须走 fvs 捕获，落到 entry 也补不到就编译期 Fail（拼错的调用名在前端拦，
  // 不再静默 miss 成 nil）。裸 cfunc 白名单见 lib_cfunc_head。
  let hres = if symbol?(f) {
    match c {
      Ctx(env, _, _, _, _, _, _) ->
        if assoc_find(f, env) < 0 && assoc_find(f, g) < 0 && lib_cfunc_head(f) {
          CompRes(cons(IGlob(f), nil), c)
        } else {
          compile_expr(f, g, c, false)
        }
    }
  } else {
    compile_expr(f, g, c, false)
  }
  match hres {
    CompRes(fc, c1) ->
      if pair?(args) {
        match compile_args_butlast(args, g, c1) {
          CompRes(ac, c2) ->
            CompRes(cat(cat(cat(fc, cons(IPush, nil)), ac),
              cons(call_ins(tail, n), nil)), c2)
        }
      } else {
        // 0 参：f 留在 acc，CALL n 里 flush 即 fn 槽
        CompRes(cat(fc, cons(call_ins(tail, n), nil)), c1)
      }
  }
}

// 除末参外：逐个 compile + IPUSH；末参只 compile（留 acc）
fn compile_args_butlast(args, g, c) {
  if pair?(cdr(args)) {
    match compile_expr(car(args), g, c, false) {
      CompRes(hc, c1) ->
        match compile_args_butlast(cdr(args), g, c1) {
          CompRes(tc, c2) -> CompRes(cat(cat(hc, cons(IPush, nil)), tc), c2)
        }
    }
  } else {
    compile_expr(car(args), g, c, false)
  }
}

// ---------- quote：仅原子（symbol/int/bool/nil）→ 符号常量 ----------
// 设计取向：'a 只用于生成符号。quoted list '(a b c) 不支持——链表在
// lisp 层用 (cons ...) 显式构造（对齐 TA 的 [ ] 字面量哲学：
// reader 属于宿主，不在内核编译器里长出第二套数据字面量）。
// pair 混入会走 IConst 原子路径，驱动侧 const_words 主动拒绝。
fn quote_code(e) {
  cons(IConst(e), nil)
}

// ---------- 顶层：def 收集为全局函数 ----------
// 重名编译期拒绝：prelude def 与用户 fn/pub fn 降到同一个 'def 形式，
// 这里是唯一注册点——重名放行会产出两个同名全局 slot，调用解析命中其一，
// 轻则链接期 duplicate global，重则静默调错（#235）。
fn collect_globals(forms, next_id, acc) {
  if pair?(forms) {
    let form = car(forms)
    if pair?(form) {
      if at(form, 0) == 'def {
        let name = at(form, 1)
        if assoc_find(name, acc) == -1 {
          collect_globals(cdr(forms), next_id + 1,
            cons(Bind(name, next_id), acc))
        } else {
          DupGlobal(str.concat("duplicate global: ", str.sym_to_str(name)))
        }
      } else {
        collect_globals(cdr(forms), next_id, acc)
      }
    } else {
      collect_globals(cdr(forms), next_id, acc)
    }
  } else {
    Globals(acc, next_id)
  }
}

fn compile_forms(forms, g, c) {
  if pair?(forms) {
    let form = car(forms)
    if pair?(form) {
      if at(form, 0) == 'def {
        // def 是声明：fnid 用 collect 分配的 id；FnRec 进 defs 池。
        // def 闭包必须封闭（顶层函数无闭包环境）：自己的 fvs 非空 = 引用了
        // 未定义名，编译期拦截（链到 entry 也补不到，运行期才是 LOADF 炸弹）
                let fnid = assoc_find(at(form, 1), g)
        match c {
          Ctx(env, ns, nf, defs, fvs, lams, cenv) ->
            match compile_lambda_id(at(form, 2), g, c, fnid, nf) {
              CompRes(_, Ctx(_, _, nfin, _, dfvs, rlams, _)) ->
                match car(rlams) {
                  // def 的名字穿进 FnRec：.bc 的 f 记录携带名字供链接器解析；
                  // dfvs 并入 entry fvs —— compile() 统一拦截未定义名。
                  // lambda 计数器必须用返回的 nfin 续传：丢弃它会让下一个
                  // def 的内层匿名 lambda 从同一起点分配 fnid，两个带内层
                  // lambda 的 def 必然撞号（use-basic 的 ret/bind 内层共享
                  // fn#5，flatten 后一个覆盖另一个 —— "call on non-function"）
                  FnRec(_, n, cd) ->
                    compile_forms(cdr(forms), g,
                      Ctx(env, ns, nfin, cons(FnRec(at(form, 1), n, cd), defs),
                                                cat(fvs, dfvs), cdr(rlams), cenv))
                }
            }
        }
      } else {
       match compile_expr(form, g, c, false) {
          CompRes(fc, c1) ->
            match compile_forms(cdr(forms), g, c1) {
              CompRes(rc, c2) -> CompRes(cat(fc, rc), c2)
            }
        }
      }
    } else {
      match compile_expr(form, g, c, false) {
        CompRes(fc, c1) ->
          match compile_forms(cdr(forms), g, c1) {
            CompRes(rc, c2) -> CompRes(cat(fc, rc), c2)
          }
      }
    }
  } else {
    CompRes([], c)
  }
}

// 全局调用的名字解析在 VM 运行期：GLOBAL 存符号，CALL 期先查本单元 def、
// 再查宿主 cfunc（Erlang 式按名调用）。编译器不再维护 VM 原生表副本
//（旧 (extern ...) 机制必然漂移，已删）——代价是名字错误从编译期挪到
// 运行期 miss（求值为 nil）。只有「非调用位置的裸名」仍走自由变量捕获、
// entry 层 Fail（拼错的变量引用还是编译期拦）。
fn member(x , xs) {
  if pair?(xs) {
    if car(xs) == x { true } else { member(x , cdr(xs)) }
  } else {
    false
  }
}

// compile(prog) -> Out(fns, consts) | Fail(msg)
//（变体名用 Fail：Err 已被 lib/result.ta 的 Result 占用，TA 变体名全局共享）
// fns[i] = FnBC(nargs, maxd, words)（i == fnid，fns[0] 为 entry）
pub fn compile(prog) {
  match collect_globals(prog , 1, []) {
    DupGlobal(msg) -> Fail(msg)
    Globals(g0, nid) -> {
      // entry 的 next_slot 从 1 起：槽 0 是帧的 fn 槽（见 param_bindings
      // 从 1 开始编参数）。从 0 起会让顶层 let 存进槽 0、覆盖调用已压入的
      // 函数指针，后续 CALL 读到非函数值 —— "call on non-function"。
      match compile_forms(prog , g0, Ctx([], 1, nid, [], [], [], [])) {
        CompRes(code, ctx) ->
          match ctx {
            Ctx(_, ens, _, defs, fvs, lams, _) -> {
              if pair?(fvs) {
                // 编译期未定义拦截：entry 的 fvs = 全部无法解析的名字
                //（顶层直接引用 + def/匿名 lambda 捕获链的漏出）。
                // 调用位置的未绑定名已在 compile_general 发 IGlob，不会落到这里。
                // 安全理念：名字错误在前端暴露，不留给运行期
                Fail(undefined_msg(fvs))
              } else {
                // 各池最新在前：rev 后 def 记录 = fnid 1..k、lambda 记录 = fnid k+1..
                // entry（fnid 0）排记录 0
                // entry 同理：顶层 let 也占槽（ns 从 1 起，槽 0 是 fn 槽）
                let nlocals = ens - 1
                let fns = cons(FnRec(0, 0,
                  cat(cons(IReserve(nlocals), nil), cat(code, cons(IRet, nil)))),
                  cat(rev(defs), rev(lams)))
                match flatten_fns(fns, []) {
                  FlatRes(fnws, pool) -> Out(depth_fns(fnws, []), pool)
                }
              }
            }
          }
        }
      }
    }
  }

// Bind(name, _) 列表 → "undefined: a, b"
fn undefined_msg(fvs) {
  str.concat("undefined: " , undef_loop(fvs))
}

fn undef_loop(fvs) {
  if pair?(fvs) {
    match car(fvs) {
      Bind(name, _) ->
        if pair?(cdr(fvs)) {
          str.concat(str.concat(str.sym_to_str(name) , ", ") ,
            undef_loop(cdr(fvs)))
        } else {
          str.sym_to_str(name)
        }
    }
  } else {
    ""
  }
}

// ---------- fuse：融合 pass ----------
// ILoad/IConst/IGlob 后紧跟 IPush（实参传递形态，热路径大头）→ 单条
 // 融合指令，少一半取指。递归进 IIf 三分支；在 flatten 前跑，flat2 与
 // depth 各有对应 case（深度 +1，同 IPush）。
fn is_ipush(ins) {
  match ins {
    IPush -> 1
    _ -> 0
  }
}

fn fuse(code) {
  if pair?(code) {
    match car(code) {
      IIf(c, tb, eb) ->
        cons(IIf(fuse(c), fuse(tb), fuse(eb)) , fuse(cdr(code)))
      ILoad(s) ->
        if pair?(cdr(code)) {
          if is_ipush(car(cdr(code))) == 1 {
            cons(ILoadP(s) , fuse(cdr(cdr(code))))
          } else {
            cons(ILoad(s) , fuse(cdr(code)))
          }
        } else {
          cons(ILoad(s) , fuse(cdr(code)))
        }
      IConst(a) ->
        if pair?(cdr(code)) {
          if is_ipush(car(cdr(code))) == 1 {
            cons(IConstP(a) , fuse(cdr(cdr(code))))
          } else {
            cons(IConst(a) , fuse(cdr(code)))
          }
        } else {
          cons(IConst(a) , fuse(cdr(code)))
        }
      IGlob(x) ->
        if pair?(cdr(code)) {
          if is_ipush(car(cdr(code))) == 1 {
            cons(IGlobP(x) , fuse(cdr(cdr(code))))
          } else {
            cons(IGlob(x) , fuse(cdr(code)))
          }
        } else {
          cons(IGlob(x) , fuse(cdr(code)))
        }
      _ -> cons(car(code) , fuse(cdr(code)))
    }
  } else {
    nil
  }
}

// ---------- flatten：Ins 树 → int 词流 ----------
// 编码知识全部在这张 match 里：变体 → (OP_*, 词数)。
fn flat2(instrs, ws, pool) {
  if pair?(instrs) {
    match car(instrs) {
      IReserve(n) -> flat2(cdr(instrs), emit2(ws, OP_RESERVE, n), pool)
      IConst(atom) -> {
        // 常量池 == 去重；命中返回下标，未命中追加尾部
        match pool_index(atom, pool, 0) {
          -1 -> flat2(cdr(instrs), emit2(ws, OP_CONST, len(pool)),
            cat(pool, cons(atom, nil)))
          idx -> flat2(cdr(instrs), emit2(ws, OP_CONST, idx), pool)
        }
      }
      IIf(cond, tb, eb) -> {
        // cond; JIF t f; then; JUMP end; else —— 三处回填（fn 内绝对词偏移）
        // t = then 起点；f = else 起点（JUMP 之后）；JUMP 目标 = end
        match flat2(cond, ws, pool) {
          FlatRes(wa, pa) -> {
            let ji = len(wa)
            let wb = emit3(wa, OP_JIF, 0, 0)
            match flat2(tb, wb, pa) {
              FlatRes(wt, pb) -> {
                let t_off = len(wb)
                let wc = emit2(wt, OP_JUMP, 0)
                let jp = len(wc) - 1
                let f_off = jp + 1
                match flat2(eb, wc, pb) {
                  FlatRes(we, pe) -> {
                    let end = len(we)
                    flat2(cdr(instrs),
                      set_w(set_w(set_w(we, ji + 1, t_off), ji + 2, f_off), jp, end),
                      pe)
                  }
                }
              }
            }
          }
        }
      }
      IOp(op) -> flat2(cdr(instrs), emit1(ws, op), pool)
      IPush -> flat2(cdr(instrs), emit1(ws, OP_PUSH), pool)
      IRet -> flat2(cdr(instrs), emit1(ws, OP_RET), pool)
      ILoad(s) -> flat2(cdr(instrs), emit2(ws, OP_LOAD, s), pool)
      ILoadP(s) -> flat2(cdr(instrs), emit2(ws, OP_LOADP, s), pool)
      IConstP(atom) -> {
        match pool_index(atom, pool, 0) {
          -1 -> flat2(cdr(instrs), emit2(ws, OP_CONSTP, len(pool)),
            cat(pool, cons(atom, nil)))
          idx -> flat2(cdr(instrs), emit2(ws, OP_CONSTP, idx), pool)
        }
      }
      IGlobP(sym) ->
      // GLOBALP 操作数重定位同 GLOBAL（link_unit 同一分支处理）
      match pool_index(sym, pool, 0) {
          -1 -> flat2(cdr(instrs), emit2(ws, OP_GLOBP, len(pool)),
            cat(pool, cons(sym, nil)))
          idx -> flat2(cdr(instrs), emit2(ws, OP_GLOBP, idx), pool)
      }
      IStore(s) -> flat2(cdr(instrs), emit2(ws, OP_STORE, s), pool)
      ILoadF(i) -> flat2(cdr(instrs), emit2(ws, OP_LOADF, i), pool)
                        IGlob(sym) ->
      // GLOBAL 操作数 = 常量池符号下标（去重共享 quote 条目）；loader 重定位
      match pool_index(sym, pool, 0) {
          -1 -> flat2(cdr(instrs), emit2(ws, OP_GLOB, len(pool)),
            cat(pool, cons(sym, nil)))
          idx -> flat2(cdr(instrs), emit2(ws, OP_GLOB, idx), pool)
      }
      ICall(n) -> flat2(cdr(instrs), emit2(ws, OP_CALL, n), pool)
      ITCall(n) -> flat2(cdr(instrs), emit2(ws, OP_TCALL, n), pool)
      IBuiltin(id, n) -> flat2(cdr(instrs), emit3(ws, OP_BUILTIN, id, n), pool)
      IClos(fid, nfv) -> flat2(cdr(instrs), emit3(ws, OP_CLOS, fid, nfv), pool)
    }
  } else {
    FlatRes(ws, pool)
  }
}

fn flatten_fns(fns, pool) {
  if pair?(fns) {
    match car(fns) {
      FnRec(name, nargs, code) -> {
        // def 名主动入池（.bc 的 nameidx / link_unit 按名解析依赖它）。
        // 只靠调用点入池的话，定义了但文件内无调用的顶层函数名字不会出现在
        // 池里，nameidx 会是 -1，按名解析就找不到它。
                let p0 = if symbol?(name) { pool_add(name, pool) } else { pool }
        // fuse 在 flatten 前跑：flat2 与 depth 吃同一棵融合后 Ins 树
        let fc = fuse(code)
        match flat2(fc, [], p0) {
          FlatRes(ws, p1) ->
            match flatten_fns(cdr(fns), p1) {
              FlatRes(acc, p2) ->
                                // maxd 必须在 flatten **之前**算：flatten 后的词流已经认不出
                // 指令边界了（旧实现就是这么坏的）。d0 = 1 + nargs，函数体首指令
                // IReserve(nlocals) 自己把 d 抬到局部变量区之上。
                match depth(fc, nargs + 1, nargs + 1) {
                  DP(_, mx) -> FlatRes(cons(FnW(name, nargs, mx, ws), acc), p2)
                }
            }
        }
      }
    }
  } else {
    FlatRes([], pool)
  }
}

// 已在池则原样返回，否则追加尾部（不动已有下标）
fn pool_add(name, pool) {
  if pool_index(name, pool, 0) >= 0 {
    pool
  } else {
    cat(pool, cons(name, nil))
  }
}

fn emit1(ws, a) { cat(ws, cons(a, nil)) }
fn emit2(ws, a, b) { cat(ws, cons(a, cons(b, nil))) }
fn emit3(ws, a, b, c) { cat(ws, cons(a, cons(b, cons(c, nil)))) }

// 词流第 pos 位改值（回填跳转目标）——尾递归：前缀逆序累积，命中后回卷重建
fn set_w(ws, pos, v) {
  sw_loop(ws, pos, v, [], 0)
}

fn sw_loop(ws, pos, v, pre, k) {
  if pair?(ws) {
    if k == pos {
      rebuild(pre, cons(v, cdr(ws)))
    } else {
      sw_loop(cdr(ws), pos, v, cons(car(ws), pre), k + 1)
    }
  } else {
    ws
  }
}

fn rebuild(pre, rest) {
  if pair?(pre) {
    rebuild(cdr(pre), cons(car(pre), rest))
  } else {
    rest
  }
}

// 常量池查找：命中返回下标，未命中 -1
fn pool_index(atom, pool, k) {
  if pair?(pool) {
    if car(pool) == atom {
      k
    } else {
      pool_index(atom , cdr(pool) , k + 1)
    }
  } else {
    -1
  }
}

// ---------- depthpass：在 **Ins 树**上模拟栈深 ----------
//
// 旧实现是坏的：depth_i 拿 Ins 变体（IPush/IStore/ICall）去匹配 flatten 之后的
// 词流（一堆 int），永远匹配不上，全部落到 `_` 分支不改深度 → maxd 恒等于
// nargs+1，溢出检查形同虚设。现在改成在 flatten 之前、对 Ins 树做。
//
// 帧布局（与 lispvm.c 一致）：
//   base+0             = fn 指针
//   base+1..base+nargs = 实参
//   base+nargs+1 起    = 局部变量（编译器用 IReserve 垫出，push 区在其上）
//   d0 = 1 + nargs + nlocals，push 从这里往上长
//
// 栈深变化：PUSH +1；二元原语弹 1 → -1；一元原语 0；
// CALL n 把 acc 刷栈后基址 = sp-n，返回时 sp 落回该基址 → d+1-n；
// MAKE_CLOSURE 刷最后一个自由值再弹掉 nfv 个 → d+1-nfv。
fn bigger(a, b) { if a > b { a } else { b } }

// 二元原语弹一个操作数（l = pop 与 acc 配对）
fn binop_p(op) { (op >= 5 && op <= 14) || op == 17 }

// 返回 DP(d_end, m_max)：分支编译完后的栈深 + 全程峰值
fn depth(code, d, m) {
  if pair?(code) {
    match car(code) {
      IReserve(n) -> depth(cdr(code), d + n, bigger(d + n, m))
      IPush -> depth(cdr(code), d + 1, bigger(d + 1, m))
      // 融合指令：x + PUSH，净深 +1 同 IPush
      ILoadP(_) -> depth(cdr(code), d + 1, bigger(d + 1, m))
      IConstP(_) -> depth(cdr(code), d + 1, bigger(d + 1, m))
      IGlobP(_) -> depth(cdr(code), d + 1, bigger(d + 1, m))
      IOp(op) -> if binop_p(op) { depth(cdr(code), d - 1, m) }
                 else { depth(cdr(code), d, m) }
      ICall(n) -> depth(cdr(code), d + 1 - n, bigger(d + 1 - n, m))
      ITCall(n) -> depth(cdr(code), d + 1 - n, bigger(d + 1 - n, m))
      // BUILTIN：前 n-1 参压栈后瞬间弹回 —— 峰值 d+(n-1)，净深不变
      IBuiltin(_, n) -> depth(cdr(code), d, bigger(d + n - 1, m))
      IClos(_, nfv) -> depth(cdr(code), d + 1 - nfv, bigger(d + 1 - nfv, m))
      IIf(c, tb, eb) -> match depth(c, d, m) {
        DP(dc, mc) -> match depth(tb, dc, mc) {
          DP(dt, mt) -> match depth(eb, dt, mt) {
            DP(de, me) -> depth(cdr(code), de, me)
          }
        }
      }
      _ -> depth(cdr(code), d, m)
    }
  } else {
    DP(d, m)
  }
}

fn depth_fns(fnws, acc) {
  if pair?(fnws) {
    match car(fnws) {
      FnW(name, nargs, maxd, ws) ->
        depth_fns(cdr(fnws), cons(FnBC(name, nargs, maxd, ws), acc))
    }
    } else {
    rev(acc)
  }
}

