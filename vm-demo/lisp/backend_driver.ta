// backend_driver.ta — lisp 后端 CLI 驱动：src.ta -> out.bc。
//
// `tinyactor --vm=lisp run x.ta` 的编译半程：tavm 跑本驱动（标准 bootstrap
// 编译产物 boot/backend_driver.tabc），把用户源码经 lisp 管线编成 .bc，
// 再由 lispvm 执行。重建产物：make boot-backend-driver。
//
// 管线与 corpus1 的差异有三点：输入来自 argv 而非 corpus.one；失败时打印
// 阶段名并 os.exit(1)（CLI 语义，不是扫描器的 <status> 行）；模块解析与
// typecheck 复用 bootstrap driver 的原生机制（resolve_imports 命名空间化 +
// typecheck_cached），不再吃展开后的单命名空间文本——展开文本当单程序
// typecheck 会因命名空间丢失误报（issue #256）。
//
// 仍不收敛的构造（README「语料覆盖」）会让本驱动挂死，由宿主超时兜底。

import compile
import driver
import file
import list
import lower-ast
import main
import os
import parser
import sexp
import str
import tokenizer
import typecheck

// 失败走 stderr（与 run_lisp 的约定一致）：log.ta 同款 /dev/stderr 写入，
// 不新增 C 层 builtin。
fn die(stage) {
  file.write("/dev/stderr", str.concat("lisp-backend: ", str.concat(stage, "\n")))
  os.exit(1)
}

fn main() {
  let src = vm.get_arg(0)
  let out = vm.get_arg(1)
  let text = file.read(src)
  if null?(text) {
    die("cannot read source file")
  }
  let toks = tokenizer.tokenize(text)
  if int?(toks) {
    die("tokenize")
  }
  let ast = parser.parse(toks)
  if int?(ast) {
    die("parse")
  }
  // 模块解析（命名空间化，对齐 native 构建）+ 按模块语义的 typecheck
  let rr = driver.resolve_imports(ast, driver.dirname(src), 1, 0)
  let rerr = cdr(cdr(rr))
  if null?(rerr) == false {
    die(str.concat("module: ", rerr))
  }
    let forms = car(rr)
  // sig cache：argv[2] 传 cache_dir（run_lisp 传项目级 .build/modules），
  // 缺省/空串关闭。没有 cache 时每次 run 都全量 typecheck 全部依赖模块
  // ——corpus/make test 逐文件调用会被放大成几十分钟（CI 实测）。
  let cache_dir = vm.get_arg(2)
  let cd = if null?(cache_dir) { "" } else { cache_dir }
  // seq = car(cdr(rr))：resolve_imports 返回 (forms . (seq . err))，
  // seq 是 sig cache 的单位序列，包错一层会让 cache 永远空转
  let tc = driver.typecheck_cached(forms, car(cdr(rr)), cd, 0)
  if typecheck.count_errors(tc) > 0 {
    typecheck.report_errors(tc)
    die("typecheck")
  }
  let low = lower-ast.lower_program(forms)
  if int?(low) {
    die("lower")
  }
  // lib_src 是文本，AST 管线里 parse 回 forms 再前置（同旧 prelude 语义）
  match compile.compile(list.append(sexp.parse(main.lib_src()) , low)) {
    Fail(msg) -> die(str.concat("reject: " , msg))
    Out(fns, consts) -> main.write_bc(out , fns , consts)
  }
}