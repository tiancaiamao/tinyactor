// backend_driver.ta — lisp 后端 CLI 驱动：src.ta -> out.bc；外加 fmt 子命令
// （路线图 7b-3 fmt 再宿主：tinyactor fmt 的执行体，与旧链入口 build.ta
// 同款 dispatch）。
//
// `tinyactor --vm=lisp run x.ta` 的编译半程：tavm 跑本驱动（标准 bootstrap
// 编译产物 boot/backend_driver.tabc），把用户源码经 lisp 管线编成 .bc，
// 再由 lispvm 执行。重建产物：make boot-backend-driver。
//
// 管线与 corpus1 的差异有三点：输入来自 argv 而非 corpus.one；失败时打印
// 阶段名并 os.exit(1)（CLI 语义，不是扫描器的 <status> 行）；模块解析与
// typecheck 复用 bootstrap driver 的原生机制（resolve_imports 命名空间化 +
// typecheck_cached），不再吃展开后的单命名空间文本——展开文本当单程序
// typecheck 会因命名空间丢失误报（issue #256）。
//
// 仍不收敛的构造（README「语料覆盖」）会让本驱动挂死，由宿主超时兜底。

import compile
import driver
import file
import fmt
import list
import lower-ast
import main
import os
import sexp
import str
import typecheck

// 失败走 stderr（与 run_lisp 的约定一致）：log.ta 同款 /dev/stderr 写入，
// 不新增 C 层 builtin。
fn die(stage) {
  file.write("/dev/stderr", str.concat("lisp-backend: ", str.concat(stage, "\n")))
  os.exit(1)
}

// ---------- fmt 子命令（旧链 build.ta 的 fmt 分支原样移植） ----------
// 参数布局与旧链一致：get_arg(0)="fmt"、get_arg(1)=("--check"|path)、
// get_arg(2)=path（--check 时）——tavm/lispvm 的 argv[0] 都是 .bc 之后第一个
// 实参，索引语义无需适配。
fn fmt_file(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  file.write(path, out)
}

fn fmt_check(path) {
  let src = file.read(path)
  let out = fmt.format(src)
  if out == src {
    print(str.concat("ok: ", path))
  } else {
    print(str.concat("diff: ", path))
  }
}

fn main() {
  if vm.get_arg(0) == "fmt" {
    let arg1 = vm.get_arg(1)
    if arg1 == "--check" {
      fmt_check(vm.get_arg(2))
    } else {
      fmt_file(arg1)
    }
  } else {
    compile_main()
  }
}

// compile_main — src -> out 编译半程（原 main，7b-3 起由上面的 main
// 按 argv[0] dispatch："fmt" 走 fmt 分支，否则编译）。
fn compile_main() {
  let src = vm.get_arg(0)
  let out = vm.get_arg(1)
  let text = file.read(src)
  if null?(text) {
    die("cannot read source file")
  }
  // parse 验证统一走 driver.parse_module_content：check_syntax（tokenizer
  // 级）+ find_parse_error（AST 内嵌 marker 深扫）+ check_toplevel_forms
  // （裸表达式 / import 缺名），错误串带 issue #66 富位置（line/col/near）。
  // 7b-4 实测：lisp 侧自造的 int?(ast) 检查放行了 10 个负例。
  let pr = driver.parse_module_content(text, src, 1, 0)
  if null?(cdr(pr)) == false {
    die(cdr(pr))
  }
  let ast = car(pr)
  // 模块解析（命名空间化，对齐 native 构建）+ 按模块语义的 typecheck
  let rr = driver.resolve_imports(ast, driver.dirname(src), 1, 0)
  let rerr = cdr(cdr(rr))
  if null?(rerr) == false {
    die(str.concat("module: ", rerr))
  }
    let forms = car(rr)
  // sig cache：argv[2] 传 cache_dir（run_lisp 传项目级 .build/modules），
  // 缺省/空串关闭。没有 cache 时每次 run 都全量 typecheck 全部依赖模块
  // ——corpus/make test 逐文件调用会被放大成几十分钟（CI 实测）。
  let cache_dir = vm.get_arg(2)
  let cd = if null?(cache_dir) { "" } else { cache_dir }
  // seq = car(cdr(rr))：resolve_imports 返回 (forms . (seq . err))，
  // seq 是 sig cache 的单位序列，包错一层会让 cache 永远空转
  let tc = driver.typecheck_cached(forms, car(cdr(rr)), cd, 0)
  if typecheck.count_errors(tc) > 0 {
    // driver 的富报告（pub，与 tavm 路径同源）：首行 "typecheck: N type
    // error(s) found" + [E00xx] 明细（含 E0005 non-exhaustive——负例
    // expect 的文案只在这里出现，typecheck.report_errors 没有）。
    driver.report_type_errors(tc, text)
    die("typecheck")
  }
  // 诊断留痕（#275 linux CI 负例漏拒排查）：只在"所有拒绝检查都通过"的
  // 半程落点打印，die() 路径不会先输出它，故不影响负例的 head -1 断言。
  print(str.concat("[dbg7b4] count=", str.from_int(typecheck.count_errors(tc))))
  print(str.concat("[dbg7b4] tcnil=", if null?(tc) { "1" } else { "0" }))
  print(str.concat("[dbg7b4] cd=", cd))
  let low = lower-ast.lower_program(forms)
  if int?(low) {
    die("lower")
  }
  // lib_src 是文本，AST 管线里 parse 回 forms 再前置（同旧 prelude 语义）
  match compile.compile(list.append(sexp.parse(main.lib_src()) , low)) {
    Fail(msg) -> die(str.concat("reject: " , msg))
    Out(fns, consts) -> main.write_bc(out , fns , consts)
  }
}