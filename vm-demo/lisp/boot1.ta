// boot1.ta — lisp 管线自举入口：编译 vm-demo/lisp/boot/driver-all.ta（
// expand_imports.py 展开 lib/bootstrap 的产物）为 lispvm 字节码。
// 用法: tinyactor run vm-demo/lisp/boot1.taimport file
import list
import lower-ast
import main
import parser
import str
import sexp
import tokenizer

fn stem(path) {
  // 取 basename 去掉 .ta： "a/b/c.ta" -> "c"
  stem_at(path, str.length(path) - 1)
}

fn stem_at(path, i) {
  if i < 0 { path }
  else {
    if str.char_at(path, i) == '/' { str.substr(path, i + 1, str.length(path) - i - 1) }
    else { stem_at(path, i - 1) }
  }
}

fn main() {
  let text = file.read("vm-demo/lisp/boot/driver-all.ta")
  if null?(text) {
    print("boot1: no-read\n")
  } else {
    let toks = tokenizer.tokenize(text)
    if int?(toks) {
      print("boot1: tokenize\n")
    } else {
      let ast = parser.parse(toks)
      if int?(ast) {
        print("boot1: parse\n")
      } else {
        let low = lower-ast.lower_program(ast)
        if int?(low) {
          print("boot1: lower\n")
        } else {
          match compile.compile(list.append(sexp.parse(main.lib_src()) , low)) {
            Fail(msg) -> print(str.concat("boot1: reject: " , str.concat(msg , "\n")))
            Out(fns , consts) -> {
              main.write_bc(str.concat("vm-demo/lisp/boot/" , str.concat(stem("vm-demo/lisp/boot/driver-all.ta") , ".bc")) , fns , consts)
              print("boot1: OK\n")
            }
          }
        }
      }
    }
  }
}