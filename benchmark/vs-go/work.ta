// benchmark/vs-go/work.ta — the benchmark's own workload module (work.c).
//
//   run(seed, total, chunk) -> Int   `total` passes as total/chunk step() calls
//
// This is the only place the workload's shape is decided, and it is the same
// shape on both servers (server.go is the identical Go translation):
//
//   * total = the request's own size, so the client chooses how heavy each
//     request is and the server just runs it.
//   * chunk = how much work ONE native call does. Small enough, and the actor
//     gives its worker up between calls — the VM charges a reduction on each
//     call's control transfer, so a chunked burn crosses the budget every
//     ~500 iterations and light requests keep being served. Big enough (one
//     call for everything) and it is a black box until it returns.
//   * seed+i per chunk, so every chunk is independent and the whole is a
//     function of the range: nothing carries between calls, and the caller is
//     free to pick any chunk it likes.

// Note the positional external form (types, not names): it is what the other
// multi-argument modules use (file.rename, demo.pair, math.pow). The named
// form `external fn f(x : Int, y : Int)` currently misparses at call sites
// like `acc + work.step(i, n)` — see issue #390.
external fn work.step(Int, Int) -> Int

pub fn run(seed : Int, total : Int, chunk : Int) -> Int {
  if chunk < 1 {
    0 - 1
  } else {
    run_from(seed, 0, total, chunk, 0)
  }
}

fn run_from(seed : Int, i : Int, total : Int, chunk : Int, acc : Int) -> Int {
  if i < total {
    let n = if i + chunk > total { total - i } else { chunk }
    run_from(seed, i + n, total, chunk, acc + work.step(seed + i, n))
  } else {
    acc
  }
}