// The benchmark's workload module (work.c).
//
//   run(seed, total, chunk) -> Int   `total` passes as total/chunk step() calls
//
// Each chunk gets seed+i, so chunks are independent and the caller is free to
// pick any chunk it likes. Small chunk = the actor hands its worker back
// between calls (the VM charges a reduction on each call's control transfer),
// so a heavy request keeps light requests being served.

// Positional form, not names: the named form misparses at call sites — #390.
external fn work.step(Int, Int) -> Int

pub fn run(seed : Int, total : Int, chunk : Int) -> Int {
  if chunk < 1 {
    0 - 1
  } else {
    run_from(seed, 0, total, chunk, 0)
  }
}

fn run_from(seed : Int, i : Int, total : Int, chunk : Int, acc : Int) -> Int {
  if i < total {
    let n = if i + chunk > total { total - i } else { chunk }
    run_from(seed, i + n, total, chunk, acc + work.step(seed + i, n))
  } else {
    acc
  }
}