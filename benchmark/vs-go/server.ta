// The TinyActor side of the benchmark: a document digest service.
//   tinyactor run server.ta 8099
//
//   POST /light     ->  {"bytes":65536,"sha256":"<hex>"}
//   POST /heavy     ->  {"bytes":16777216,"sha256":"<hex>"}
//   POST /delay1ms  ->  {"delay_ms":1}
//
// The service has three endpoints and no parameters — the workload is
// part of the protocol, so both sides do exactly the same work. The
// client picks the endpoint (bench.go's mix), never the size.
//
// The digest is over a synthetic document — the 64-byte seed below,
// repeated — hashed in 64KB blocks by lib/sha256.ta. That module is
// OpenSSL's SHA-256 under the hood; from here it is just a TA import.
//
// The block size is the point: the actor hands its worker back between
// blocks, so a heavy request does not block the light ones for its whole
// length. server.go is the same service running the same kernel.
//
// /delay1ms is the latency-sensitive endpoint — the one tiancaiamao/sched
// is about. It sleeps for a millisecond and answers; everything the client
// sees above that millisecond is the scheduler's wake-up latency, and it is
// what a CPU-dense request in flight does to it.

import http
import json
import sha256
import dict
import time

// The seed of the synthetic document. 64 bytes, so a block is a whole
// number of seeds and every block boundary is seed-aligned.
const SEED = "tinyactor-benchmark-payload-seed-v1-0123456789abcdefghijklmnopxy"

// The document is hashed this many bytes per native call.
const BLOCK = 65536

// The two payload sizes of the protocol. The client picks the endpoint,
// not the size — the sizes are part of the service, so both sides hash
// the same bytes.
const LIGHT_BYTES = 65536
const HEAVY_BYTES = 16777216

// doc_block: the 64KB block of the document — the seed repeated 1024
// times, grown by doubling so the copy cost is O(block).
fn doc_block() -> String {
  repeat(SEED, 10)
}

fn repeat(s : String, k : Int) -> String {
  if k <= 0 {
    s
  } else {
    repeat(str.concat(s, s), k - 1)
  }
}

fn headers() {
  dict.insert(dict.str_new(), "Content-Type", "application/json")
}

// digest_bytes: the SHA-256 of the first n bytes of the document, hashed
// in BLOCK-byte chunks (one native call per chunk).
fn digest_bytes(block : String, n : Int) -> String {
  match sha256.new() {
    None -> ""
    Some(h) -> {
      let h2 = hash_loop(h, block, 0, n)
      match sha256.final(h2) {
        None -> ""
        Some(d) -> d
      }
    }
  }
}

// hash_loop: the state after hashing n bytes of block, one BLOCK-byte
// slice per call. The state is threaded through the recursion — it is a
// value the actor owns, not a handle into a global table — and the VM
// charges a reduction per call, so a long digest hands the worker back
// between blocks.
fn hash_loop(h : Hasher, block : String, done : Int, n : Int) -> Hasher {
  if done >= n {
    h
  } else {
    let left = n - done
    let take = if left < BLOCK { left } else { BLOCK }
    let h2 = match sha256.update_at(h, block, 0, take) {
      None -> h
      Some(x) -> x
    }
    hash_loop(h2, block, done + take, n)
  }
}

// reply: the response body — the digest and the size that produced it.
fn reply(digest : String, n : Int) -> String {
  let fields = dict.insert(dict.insert(dict.str_new(), "bytes", JInt(n)),
    "sha256", JStr(digest))
  json.write(JObj(fields))
}

// handle_delay: the latency-sensitive endpoint. It sleeps for a
// millisecond — the actor parks on the poller's deadline, no worker is
// blocked — and answers. What the client measures above the millisecond is
// the scheduler: how long the actor waited to be woken up and run again.
fn handle_delay(req) {
  time.sleep(1)
  MkResp(200, headers(), "{\"delay_ms\":1}")
}

// handle_light: hash the first 64KB. The digest is computed per request —
// memoizing it would make the endpoint free and the comparison a lie.
fn handle_light(req, block : String) {
  MkResp(200, headers(), reply(digest_bytes(block, LIGHT_BYTES), LIGHT_BYTES))
}

// handle_heavy: hash the first 16MB, in the same 64KB blocks.
fn handle_heavy(req, block : String) {
  MkResp(200, headers(), reply(digest_bytes(block, HEAVY_BYTES), HEAVY_BYTES))
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let block = doc_block()
  let routes = dict.insert(dict.insert(dict.insert(dict.str_new(), "/light",
    fn(req) { handle_light(req, block) }),
    "/heavy", fn(req) { handle_heavy(req, block) }),
    "/delay1ms", fn(req) { handle_delay(req) })
  match http.listen_routes(routes, port) {
    Err(_) -> print("listening failed")
    Ok(lst) -> {
      print(str.concat("listening on ", str.from_int(port)))
      http.serve_loop(routes, lst)
    }
  }
}