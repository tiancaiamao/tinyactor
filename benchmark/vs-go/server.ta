// benchmark/vs-go/server.ta — minimal HTTP JSON service (TinyActor side).
//
// One catch-all route returning a fixed JSON document, served by the TA
// http layer (lib/http.ta): listen_routes + serve_loop, one handler actor
// per connection, no keep-alive. The Go counterpart is server.go and the
// same client (serve_bench.go) load-tests both — see run.sh /
// `make benchmark-vs-go`.
//
// Usage: tavm -q server.tabc <port>

import http
import dict
import str

// The one response both languages serve — a small JSON document.
fn body() {
  "{\"message\":\"hello\",\"ok\":true}"
}

fn handler(_req) {
  MkResp(
  200,
  dict.insert(dict.str_new(), "Content-Type", "application/json"),
  body()
  )
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let routes = dict.insert(dict.str_new(), "*", handler)
  match http.listen_routes(routes, port) {
    Err(_) -> print("listen failed")
    Ok(lst) -> {
      print(str.concat("listening on ", str.from_int(port)))
      http.serve_loop(routes, lst)
    }
  }
}
