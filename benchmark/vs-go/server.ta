// The TinyActor side of the benchmark. Usage: tavm -q server.tabc <port>
//
//   /work/<n> -> run `n` passes of work.c, `chunk` passes per native call
//   *         -> a small fixed JSON document (byte-for-byte what server.go
//                serves on / and /light)
//
// server.go is the Go counterpart: same routes, same chunk, same kernel.

import http
import "bench.vs-go:lib/work" as work
import dict
import str

// Matches server.go. 50 passes ≈ 4µs of C, so the actor yields every ~2ms.
fn chunk() {
  50
}

fn max_passes() {
  2000000
}

fn body() {
  "{\"message\":\"hello\",\"ok\":true}"
}

fn headers() {
  dict.insert(dict.str_new(), "Content-Type", "application/json")
}

fn light(_req) {
  MkResp(200, headers(), body())
}

// Out of range is a 400, not a silently smaller request: clamping made
// /work/10000000 report the same time as /work/2000000.
fn work_handler(path : String) {
  let n = str.to_int(str.substr(path, 6, str.length(path) - 6))
  if n > 0 && n <= max_passes() {
    let _ = work.run(n, n, chunk())
    light(path)
  } else {
    MkResp(400, headers(), "{\"error\":\"size out of range\"}")
  }
}

fn root(req) {
  match req {
    MkReq(_, path, _, _, _) ->
      if str.index_of(path, "/work/") == 0 {
        work_handler(path)
      } else {
        light(req)
      }
  }
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let routes = dict.insert(dict.str_new(), "*", root)
  match http.listen_routes(routes, port) {
    Err(_) -> print("listen failed")
    Ok(lst) -> {
      print(str.concat("listening on ", str.from_int(port)))
      http.serve_loop(routes, lst)
    }
  }
}