// benchmark/vs-go/server.ta — mixed-load HTTP service (TinyActor side).
//
//   /light  -> a small fixed JSON document (byte-for-byte what server.go serves)
//   /heavy  -> a CPU-bound request: 10M passes over a 1024-entry uint32 state
//              array, driven from the TA loop compute.burn(..., 50). The hot
//              loop is C (lib/compute.c) and element-parallel, so the C
//              compiler vectorizes it while the identical Go loop in
//              server.go runs scalar — the heavy request is ~4x faster here
//              AND the TA loop around it pays a VM reduction every ~500 chunk
//              calls, so the burn actor yields about every 2 ms and light
//              requests keep being served. That is the axis — see
//              lib/compute.ta.
//   *       -> /light
//
// The Go counterpart is server.go: the same two routes with the same pass
// count, the same chunk, and the same kernel source shape. fair.sh drives both
// with the same client.
//
// Usage: tavm -q server.tabc <port>

import http
import compute
import dict
import str

// Matches server.go's heavyPasses / heavyChunk exactly (same work, both sides).
fn heavy_passes() {
  10000000
}

fn heavy_chunk() {
  50
}

fn json_headers() {
  dict.insert(dict.str_new(), "Content-Type", "application/json")
}

// body is byte-for-byte the document server.go serves.
fn body() {
  "{\"message\":\"hello\",\"ok\":true}"
}

fn light(_req) {
  MkResp(200, json_headers(), body())
}

fn heavy(_req) {
  let _ = compute.burn(heavy_passes(), heavy_chunk())
  MkResp(200, json_headers(), body())
}

fn main() {
  let port = str.to_int(vm.get_arg(0))
  let r1 = dict.insert(dict.str_new(), "/light", light)
  let r2 = dict.insert(r1, "/heavy", heavy)
  let routes = dict.insert(r2, "*", light)
  match http.listen_routes(routes, port) {
    Err(_) -> print("listen failed")
    Ok(lst) -> {
      print(str.concat("listening on ", str.from_int(port)))
      http.serve_loop(routes, lst)
    }
  }
}