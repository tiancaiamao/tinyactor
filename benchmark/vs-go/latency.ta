// latency.ta — the sched case: how late does a sleeping actor wake up while
// CPU-bound actors fill every worker?
//
//   TA_NOISE=8 TA_WINDOW=3000 tinyactor run latency.ta
//
// Protocol (identical in latency.go):
//   * TA_NOISE actors spin on the clock until the window ends
//   * one probe actor loops: stamp -> sleep(1ms) -> stamp, and sends every
//     delay to the main actor
//   * the main actor collects the delays, sorts them, prints percentiles
//
// The requested sleep is 1ms; what the numbers show is 1000us plus the
// scheduler's wake-up delay — the part this case is about.

import time
import list
import os
import strconv

fn cmp_int(a, b) {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

// env_int: TA_NOISE / TA_WINDOW override the defaults; anything else
// (unset, not a number) keeps the default.
fn env_int(name, dflt) {
  match os.getenv(name) {
    None -> dflt
    Some(s) -> {
      match strconv.str_to_int(s, 10) {
        Ok(v) -> v
        Err(_) -> dflt
      }
    }
  }
}

fn noise(end) {
  if vm.time_ms() < end { noise(end) } else { 0 }
}

fn spawn_noise(end, n) {
  if n == 0 {
    0
  } else {
    spawn(fn { noise(end) })
    spawn_noise(end, n - 1)
  }
}

fn probe(end, main_pid) {
  if vm.time_ms() >= end {
    send(main_pid, -1)
  } else {
    let t0 = vm.time_us()
    time.sleep(1)
    let t1 = vm.time_us()
    send(main_pid, t1 - t0)
    probe(end, main_pid)
  }
}

fn collect(acc, n) {
  let s = recv()
  if s < 0 {
    report(acc, n)
  } else {
    collect(cons(s, acc), n + 1)
  }
}

fn report(lst, n) {
  let sorted = list.sort(cmp_int, lst)
  print(str.concat("samples=", str.from_int(n)))
  print(str.concat("p50_us=", str.from_int(list.nth(sorted, n / 2))))
  print(str.concat("p90_us=", str.from_int(list.nth(sorted, (n * 9) / 10))))
  print(str.concat("p99_us=", str.from_int(list.nth(sorted, (n * 99) / 100))))
  print(str.concat("max_us=", str.from_int(list.nth(sorted, n - 1))))
}

fn main() {
  let noise_workers = env_int("TA_NOISE", 8)
  let window = env_int("TA_WINDOW", 3000)
  let me = self()
  let end = vm.time_ms() + window
  spawn_noise(end, noise_workers)
  spawn(fn { probe(end, me) })
  collect(nil, 0)
}