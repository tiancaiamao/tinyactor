// Benchmark: Ackermann function A(3, 9)
// Purpose: Deeply nested non-tail recursion and integer arithmetic
// Category: core/recursion
// Input: ack(3, 9) = 4093
// Note: ported from cora/test/benchmark/ack.cora, which uses (ack 3 13)
// (~2^29 calls). A(3, 9) keeps the run ~0.7s for CI while still stressing
// call/return throughput.

fn ack(m, n) {
  if m == 0 {
    n + 1
  } else if n == 0 {
    ack(m - 1, 1)
  } else {
    ack(m - 1, ack(m, n - 1))
  }
}

fn main() {
  print(ack(3, 9))
}