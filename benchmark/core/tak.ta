// Benchmark: Takeuchi (Tak) function tak(26, 20, 10)
// Purpose: Branch-heavy recursion with three nested calls per level
// Category: core/recursion
// Input: tak(26, 20, 10) = 11
// Note: ported from cora/test/benchmark/tak.cora, which uses tak(18, 12, 6)
// (~10ms, below the harness noise floor). 26/20/10 gives a ~0.7s signal.

fn tak(x, y, z) {
  if y >= x {
    z
  } else {
    tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y))
  }
}

fn main() {
  print(tak(26, 20, 10))
}