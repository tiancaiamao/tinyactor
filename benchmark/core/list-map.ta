// Benchmark: List operations (map, filter, reduce)
// Purpose: Measure list allocation and transformation performance
// Category: core/list
// Output: 499500

fn range(n, max) {
  if n >= max {
    nil
  } else {
    cons(n, range(n + 1, max))
  }
}

fn map(lst, f) {
  if null?(lst) {
    nil
  } else {
    cons(f(car(lst)), map(cdr(lst), f))
  }
}

fn sum_list(lst) {
  if null?(lst) {
    0
  } else {
    car(lst) + sum_list(cdr(lst))
  }
}

fn main() {
  let lst = range(0, 1000)
  let doubled = map(lst, fn(x) { x * 2 })
  print(sum_list(doubled))
}