// Benchmark: Boehm GC benchmark (tree building)
// Purpose: Measure GC performance under heavy allocation
// Category: gc/allocation
// Ported from: test/gc/gc-gcbench.ta
// Output: 65535

// Tree: a full binary tree node holding its two subtrees. A declared sum type
// (both slots are the same kind of thing, so it is not a list) — `cons` only
// builds homogeneous lists.
type Tree {
  Leaf
  Node(left, right)
}

fn make_tree(depth) {
  if depth == 0 {
    Leaf
  } else {
    Node(make_tree(depth - 1), make_tree(depth - 1))
  }
}

fn count_nodes(tree) {
  match tree {
    Leaf -> 0
    Node(left, right) -> 1 + count_nodes(left) + count_nodes(right)
  }
}

fn main() {
  let tree = make_tree(16)
  let count = count_nodes(tree)
  print(count)
}