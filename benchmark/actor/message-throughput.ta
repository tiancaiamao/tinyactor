// Benchmark: Message passing throughput
// Purpose: Measure actor message send/receive performance
// Category: actor/throughput
// Output: 10000

fn worker(main_pid, count) {
  if count == 0 {
    send(main_pid, 'done)
  } else {
    let msg = recv()
    worker(main_pid, count - 1)
  }
}

// Send messages 0..n-1 to pid. The language has no loop syntax, so the
// original `while i < n { ... }` is expressed as recursion.
fn send_n(pid, i, n) {
  if i < n {
    send(pid, i)
    send_n(pid, i + 1, n)
  } else {
    nil
  }
}

fn main() {
  let main_pid = self()
  let worker_pid = spawn(fn { worker(main_pid, 10000) })

  // Send 10000 messages
  send_n(worker_pid, 0, 10000)

  recv()  // Wait for worker to finish
  print(10000)
}